  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MuscleCuties.Core\MuscleCuties.Core.csproj" />
    <ProjectReference Include="..\..\src\MuscleCuties.UseCases\MuscleCuties.UseCases.csproj" />
    <ProjectReference Include="..\..\src\MuscleCuties.Infrastructure\MuscleCuties.Infrastructure.csproj" />
  </ItemGroup>

</Project>
