{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Issuer": "MuscleCutiesServer",
    "Audience": "MuscleCutiesApp"
  },
  "Storage": {
    "S3": {
      "Region": "us-east-2"
    }
  },
  "Ses": {
    "FromAddress": "MuscleCuties <noreply@musclecuties.app>",
    "Region": "us-east-2",
    "ConfigurationSetName": "musclecuties-email-challenges",
    "EnableRealDelivery": false
  },
  "Lambda": {
    "DatabasePool": {
      "MaxPoolSize": 5,
      "MinPoolSize": 0,
      "RequireSslMode": true,
      "RunMigrationsOnColdStart": false
    }
  }
}
