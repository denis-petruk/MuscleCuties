<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MuscleCuties.Server</RootNamespace>
    <AssemblyName>MuscleCuties.Server</AssemblyName>
    <SourceRevisionId Condition="'$(CI_COMMIT_SHA)' != ''">$(CI_COMMIT_SHA)</SourceRevisionId>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Lambda cold requests must stay inside the 1000 ms diagnostic budget; the linux-arm64
         deployment packages ahead-of-time compiled IL so the first request does not pay JIT. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">true</PublishReadyToRun>
    <AssetTargetFallback>net8.0;net8.0-macos14.0;net8.0-windows10.0.19041;$(AssetTargetFallback)</AssetTargetFallback>
    <NoWarn>$(NoWarn);NU1202;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MuscleCuties.Contracts/MuscleCuties.Contracts.csproj" />
    <ProjectReference Include="../../src/MuscleCuties.Infrastructure.PostgreSql/MuscleCuties.Infrastructure.PostgreSql.csproj" />
    <ProjectReference Include="../../src/MuscleCuties.UseCases/MuscleCuties.UseCases.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />
  </ItemGroup>
</Project>
