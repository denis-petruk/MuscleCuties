<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Profile.ProfilePrivacyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MuscleCuties.UI.Pages.Profile"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:profile="clr-namespace:MuscleCuties.UI.ViewModels.Profile"
    x:DataType="local:ProfilePrivacyPage"
    x:Name="PrivacyRoot"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="{DynamicResource PresentationPageHeaderPadding}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
            <sharedControls:PageHeader
                Title="{loc:LocalizedText Profile_Privacy_Title}"
                Subtitle="{loc:LocalizedText Profile_Privacy_Subtitle}"
                BackCommand="{Binding BackCommand}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{DynamicResource PresentationFormPagePadding}" Spacing="{StaticResource UiSpaceControl}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
                <Border Style="{StaticResource CardPrimary}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Profile_Privacy_DataTitle}"
                                                          IconGlyph="ShieldCheckmark24" />

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Profile_Privacy_StorageLabel}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Label Grid.Row="1" Text="{loc:LocalizedText Profile_Privacy_StorageBody}"
                                   Style="{StaticResource BodyLabel}" />
                        </Grid>

                        <BoxView HeightRequest="{StaticResource UiDimension1}"
                                 Color="{AppThemeBinding Light={StaticResource DividerSubtleLight}, Dark={StaticResource DividerSubtleDark}}" />

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Profile_Privacy_EmailLabel}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Label Grid.Row="1" Text="{loc:LocalizedText Profile_Privacy_EmailBody}"
                                   Style="{StaticResource BodyLabel}" />
                        </Grid>

                        <BoxView HeightRequest="{StaticResource UiDimension1}"
                                 Color="{AppThemeBinding Light={StaticResource DividerSubtleLight}, Dark={StaticResource DividerSubtleDark}}" />

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Profile_Privacy_FoodLabel}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Label Grid.Row="1" Text="{loc:LocalizedText Profile_Privacy_FoodBody}"
                                   Style="{StaticResource BodyLabel}" />
                        </Grid>

                        <BoxView HeightRequest="{StaticResource UiDimension1}"
                                 Color="{AppThemeBinding Light={StaticResource DividerSubtleLight}, Dark={StaticResource DividerSubtleDark}}" />

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Profile_Privacy_HealthLabel}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Label Grid.Row="1" Text="{loc:LocalizedText Profile_Privacy_HealthBody}"
                                   Style="{StaticResource BodyLabel}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardPrimary}" x:DataType="profile:ProfileHealthSyncViewModel" IsVisible="{Binding HealthSync.IsAvailable, Source={x:Reference PrivacyRoot}}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}" BindingContext="{Binding HealthSync, Source={x:Reference PrivacyRoot}}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Profile_HealthSync_Title}"
                                                          IconGlyph="HeartCircle24" />
                        <Label Text="{Binding StatusText}" Style="{StaticResource BodyLabel}" />
                        <Label Text="{Binding ErrorText}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />
                        <Button Text="{loc:LocalizedText Profile_HealthSync_Connect}" Style="{StaticResource ButtonPrimary}"
                                Command="{Binding ConnectCommand}" IsVisible="{Binding IsConnected, Converter={StaticResource InvertedBoolConverter}}" HorizontalOptions="Fill" />
                        <Button Text="{loc:LocalizedText Profile_HealthSync_Refresh}" Style="{StaticResource ButtonSecondary}"
                                Command="{Binding ConnectCommand}" IsVisible="{Binding IsConnected}" HorizontalOptions="Fill" />
                        <Button Text="{loc:LocalizedText Profile_HealthSync_Disconnect}" Style="{StaticResource ButtonSecondary}"
                                Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}" HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardPrimary}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Profile_Privacy_ChoicesTitle}"
                                                          IconGlyph="PersonPill24" />
                        <Label Text="{loc:LocalizedText Profile_Privacy_ChoicesBody}"
                               Style="{StaticResource BodyLabel}" />
                        <Button Text="{loc:LocalizedText Profile_Privacy_ReadPolicy}"
                                Style="{StaticResource ButtonSecondary}"
                                Clicked="OnPrivacyPolicyClicked"
                                HorizontalOptions="Fill"
                                SemanticProperties.Description="{loc:LocalizedText Profile_Privacy_OpenPolicyDescription}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardSecondary}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Profile_Privacy_DisclaimerTitle}"
                                                          IconGlyph="ShieldLock24" />
                        <Label Text="{loc:LocalizedText Profile_Privacy_DisclaimerBody}"
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="{loc:LocalizedText Profile_Privacy_DisclaimerPlanBody}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
