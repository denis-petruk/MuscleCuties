<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Profile.ProfilePrivacyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MuscleCuties.UI.Pages.Profile"
    x:DataType="local:ProfilePrivacyPage"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Thickness x:Key="PrivacyPagePadding">20,12,20,32</Thickness>
        <Thickness x:Key="PrivacyBackPadding">10</Thickness>
        <x:Double x:Key="PrivacySectionSpacing">28</x:Double>
        <x:Double x:Key="PrivacyTextSpacing">8</x:Double>
        <x:Double x:Key="PrivacyItemSpacing">12</x:Double>
        <x:Double x:Key="PrivacyTouchTarget">44</x:Double>
        <x:Double x:Key="PrivacyPageMaximumWidth">640</x:Double>
        <x:Double x:Key="PrivacyBodyFontSize">15</x:Double>
        <x:Double x:Key="PrivacyHeadingFontSize">17</x:Double>
    </ContentPage.Resources>

    <ScrollView>
        <Grid Padding="{StaticResource PrivacyPagePadding}"
              RowSpacing="{StaticResource PrivacySectionSpacing}"
              MaximumWidthRequest="{StaticResource PrivacyPageMaximumWidth}"
              RowDefinitions="Auto,Auto,Auto,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="44,*" ColumnSpacing="8">
                <ImageButton x:Name="BackButton"
                             Source="nav_back.png"
                             BackgroundColor="Transparent"
                             WidthRequest="44"
                             HeightRequest="44"
                             MinimumWidthRequest="44"
                             MinimumHeightRequest="44"
                             Padding="10"
                             Aspect="AspectFit"
                             Clicked="OnBackClicked"
                             SemanticProperties.Description="Back to Profile" />
                <Label x:Name="PageTitle" Grid.Column="1" Text="Privacy"
                       Style="{StaticResource SubHeadline}" VerticalOptions="Center" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="SummaryTitle" Text="Your data, at a glance"
                           Style="{StaticResource SectionTitle}" />
                    <Label x:Name="SummaryBody"
                           Text="Your account and health records are stored in MuscleCuties services."
                           Style="{StaticResource BodyLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="ServicesTitle" Text="Other services"
                           Style="{StaticResource SectionTitle}" />
                    <Label x:Name="EmailBody"
                           Text="Verification emails use our email provider."
                           Style="{StaticResource BodyLabel}" />
                    <BoxView />
                    <Label x:Name="FoodBody"
                           Text="Food search may send generic names to USDA, never your logs."
                           Style="{StaticResource BodyLabel}" />
                    <BoxView />
                    <Label x:Name="HealthBody"
                           Text="Apple Health steps are read only with your permission."
                           Style="{StaticResource BodyLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="ChoiceTitle" Text="Your choices"
                           Style="{StaticResource SectionTitle}" />
                    <Label x:Name="ChoiceBody"
                           Text="You can delete your account and local data from Profile."
                           Style="{StaticResource BodyLabel}" />
                    <Button x:Name="PolicyButton"
                            Text="Read privacy policy"
                            Style="{StaticResource ButtonSecondary}"
                            Clicked="OnPrivacyPolicyClicked"
                            HorizontalOptions="Fill"
                            SemanticProperties.Description="Open the full privacy policy" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
