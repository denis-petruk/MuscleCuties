<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Profile.ProfilePrivacyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MuscleCuties.UI.Pages.Profile"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    x:DataType="local:ProfilePrivacyPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">


    <ScrollView>
        <Grid Padding="{StaticResource PresentationFormPagePadding}"
              RowSpacing="{StaticResource UiSpaceControl}"
              MaximumWidthRequest="{StaticResource UiDimension640}"
              RowDefinitions="Auto,Auto,Auto,Auto">
            <sharedControls:PageHeader
                Grid.Row="0"
                x:Name="HeaderView"
                Title="Privacy"
                Subtitle="Your data and account security"
                BackCommand="{Binding BackCommand}" />

            <Border Grid.Row="1" Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                    <sharedControls:IconSectionHeader x:Name="SummaryTitle" Text="Your data, at a glance"
                                                      IconGlyph="ShieldCheckmark24" />
                    <Label x:Name="SummaryBody"
                           Text="Your account and health records are stored in MuscleCuties services."
                           Style="{StaticResource BodyLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">
                    <sharedControls:IconSectionHeader x:Name="ServicesTitle" Text="Other services"
                                                      IconGlyph="LinkSquare24" />
                    <Label x:Name="EmailBody"
                           Text="Verification emails use our email provider."
                           Style="{StaticResource BodyLabel}" />
                    <BoxView HeightRequest="{StaticResource UiDimension1}" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />
                    <Label x:Name="FoodBody"
                           Text="Food search may send generic names to USDA, never your logs."
                           Style="{StaticResource BodyLabel}" />
                    <BoxView HeightRequest="{StaticResource UiDimension1}" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />
                    <Label x:Name="HealthBody"
                           Text="Apple Health steps are read only with your permission."
                           Style="{StaticResource BodyLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="{StaticResource UiSpacing14}">
                    <sharedControls:IconSectionHeader x:Name="ChoiceTitle" Text="Your choices"
                                                      IconGlyph="PersonPill24" />
                    <Label x:Name="ChoiceBody"
                           Text="You can delete your account and local data from Profile."
                           Style="{StaticResource BodyLabel}" />
                    <Button x:Name="PolicyButton"
                            Text="Read privacy policy"
                            Style="{StaticResource ButtonSecondary}"
                            Clicked="OnPrivacyPolicyClicked"
                            HorizontalOptions="Fill"
                            SemanticProperties.Description="Open the full privacy policy" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
