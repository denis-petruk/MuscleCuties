<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Profile.ProfileWorkoutPreferencesPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:profileControls="clr-namespace:MuscleCuties.UI.Controls.Profile"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:workoutModels="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Profile"
    x:DataType="vm:ProfileWorkoutPreferencesViewModel"
    Shell.NavBarIsVisible="False">


    <Grid>
    <ScrollView>
        <VerticalStackLayout
            Padding="{StaticResource UiInsets20_12_20_32}"
            Spacing="{StaticResource UiSpaceControl}"
            HorizontalOptions="Fill"
            MaximumWidthRequest="{StaticResource UiDimension640}">
            <sharedControls:PageHeader
                Title="{loc:LocalizedText Profile_WorkoutPrefs_ActivityPreferences}"
                BackCommand="{Binding BackCommand, Source={x:Reference Root}}" />

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">
                    <Label Text="{loc:LocalizedText Profile_WorkoutPrefs_AvailableWeekdays}"
                           Style="{StaticResource SectionTitle}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{loc:LocalizedText Profile_WorkoutPrefs_AvailableWeekdaysHint}"
                           Style="{StaticResource MutedLabel}"
                           LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*"
                          ColumnSpacing="{StaticResource UiSpacing2}"
                          BindableLayout.ItemsSource="{Binding AvailableWeekdays}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="workoutModels:WorkoutWeekdayOptionItem">
                                <Border Grid.Column="{Binding CalendarColumn}"
                                        Style="{StaticResource SelectableCard}"
                                        HeightRequest="{StaticResource UiDimension62}"
                                        SemanticProperties.Description="{Binding Label}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileWorkoutPreferencesViewModel}}, Path=ToggleWeekdayCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto"
                                          RowSpacing="{StaticResource UiSpacing2}"
                                          VerticalOptions="Center" HorizontalOptions="Fill">
                                        <Label Text="{Binding ShortLabel}"
                                               Style="{StaticResource CompactStrongLabel}"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="NoWrap" />
                                        <Border Grid.Row="1" Style="{StaticResource WeekdaySelectionIndicator}">
                                            <Path Data="M5 12L10 17L19 7"
                                                  Style="{StaticResource CalendarDayCheckmark}"
                                                  IsVisible="{Binding IsSelected}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </Grid>
                    <Label Text="{Binding SelectedWeekdayCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Profile_WorkoutPrefs_SelectedWeekdaysFormat}" Style="{StaticResource MutedCentered}" />
                </VerticalStackLayout>
            </Border>

            <toolkit:LazyView
                x:Name="PreferenceChoicesLazy"
                x:TypeArguments="profileControls:ProfileWorkoutPreferencesChoices" />

            <Label
                Text="{Binding StatusMessage, Converter={StaticResource LocalizedStringConverter}}"
                Style="{StaticResource AccentLabel}"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Button Style="{StaticResource ButtonSecondary}"
                Text="{loc:LocalizedText Profile_WorkoutPrefs_SaveWorkoutPreferences}"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding CanSave}" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                SemanticProperties.Description="{loc:LocalizedText Profile_WorkoutPrefs_SavingPreferences}" />

        </VerticalStackLayout>
    </ScrollView>
        <Grid
            IsVisible="{Binding IsUpdatingPlan}"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="{StaticResource UiSpaceCompact}">
                <ActivityIndicator
                    IsRunning="{Binding IsUpdatingPlan}"
                    Color="{StaticResource Primary}"
                    SemanticProperties.Description="{loc:LocalizedText Profile_WorkoutPrefs_UpdatingPlan}" />
                <Label
                    Text="{loc:LocalizedText Profile_WorkoutPrefs_UpdatingPlan}"
                    Style="{StaticResource MutedCentered}" />
            </VerticalStackLayout>
        </Grid>
        <sharedControls:PageLoadingOverlay />
    </Grid>
</ContentPage>
