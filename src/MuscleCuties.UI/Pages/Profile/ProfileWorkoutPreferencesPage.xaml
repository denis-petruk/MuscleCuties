<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Profile.ProfileWorkoutPreferencesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:profileControls="clr-namespace:MuscleCuties.UI.Controls.Profile"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:workoutModels="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Profile"
    x:DataType="vm:ProfileWorkoutPreferencesViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <x:Double x:Key="PlanUpdateMessageSpacing">12</x:Double>
    </ContentPage.Resources>

    <Grid>
    <ScrollView>
        <VerticalStackLayout
            Padding="{StaticResource PageContentPadding}"
            Spacing="16"
            HorizontalOptions="Fill"
            MaximumWidthRequest="{StaticResource PageContentMaxWidth}">
            <sharedControls:PageHeader
                Title="{loc:LocalizedText Profile_WorkoutPrefs_ActivityPreferences}"
                BackCommand="{Binding BackCommand}" />

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="{loc:LocalizedText Profile_WorkoutPrefs_AvailableWeekdays}"
                    Style="{StaticResource SectionTitle}"
                    SemanticProperties.HeadingLevel="Level2" />
                <Label Text="{loc:LocalizedText Profile_WorkoutPrefs_AvailableWeekdaysHint}"
                       Style="{StaticResource MutedLabel}"
                       LineBreakMode="WordWrap" />
                <FlexLayout BindableLayout.ItemsSource="{Binding AvailableWeekdays}"
                            Wrap="Wrap"
                            JustifyContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="workoutModels:WorkoutWeekdayOptionItem">
                            <Border
                                Style="{StaticResource SelectableChip}"
                                Margin="{StaticResource WorkoutPlanningDayChoiceMargin}"
                                SemanticProperties.Description="{Binding Label}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileWorkoutPreferencesViewModel}}, Path=ToggleWeekdayCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource ActivitySelectedSurfaceLight}, Dark={StaticResource CardSurfaceDark}}" />
                                        <Setter Property="Stroke"
                                                Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}" />
                                        <Setter Property="Stroke"
                                                Value="{AppThemeBinding Light={StaticResource ActivityUnselectedStrokeLight}, Dark={StaticResource Gray800}}" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label
                                    Text="{Binding Label}"
                                    Style="{StaticResource BodyLabel}"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <Label Text="{Binding SelectedWeekdayCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Profile_WorkoutPrefs_SelectedWeekdaysFormat}"
                       HorizontalTextAlignment="Center" Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

            <toolkit:LazyView
                x:Name="PreferenceChoicesLazy"
                x:TypeArguments="profileControls:ProfileWorkoutPreferencesChoices" />

            <Label
                Text="{Binding StatusMessage, Converter={StaticResource LocalizedStringConverter}}"
                Style="{StaticResource AccentLabel}"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Button
                Text="{loc:LocalizedText Profile_WorkoutPrefs_SaveWorkoutPreferences}"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding CanSave}" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                SemanticProperties.Description="{loc:LocalizedText Profile_WorkoutPrefs_SavingPreferences}" />

        </VerticalStackLayout>
    </ScrollView>
        <Grid
            IsVisible="{Binding IsUpdatingPlan}"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="{StaticResource PlanUpdateMessageSpacing}">
                <ActivityIndicator
                    IsRunning="{Binding IsUpdatingPlan}"
                    Color="{StaticResource Primary}"
                    SemanticProperties.Description="{loc:LocalizedText Profile_WorkoutPrefs_UpdatingPlan}" />
                <Label
                    Text="{loc:LocalizedText Profile_WorkoutPrefs_UpdatingPlan}"
                    Style="{StaticResource MutedLabel}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
