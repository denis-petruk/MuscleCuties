<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Profile.ProfileWorkoutPreferencesPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:profileControls="clr-namespace:MuscleCuties.UI.Controls.Profile"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:workoutModels="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Profile"
    x:DataType="vm:ProfileWorkoutPreferencesViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">


    <Grid RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0" Padding="{DynamicResource PresentationPageHeaderPadding}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
        <sharedControls:PageHeader
            Title="{loc:LocalizedText Profile_WorkoutPrefs_ActivityPreferences}"
            BackCommand="{Binding BackCommand, Source={x:Reference Root}}" />
    </Grid>
    <ScrollView IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" Grid.Row="1">
        <VerticalStackLayout Padding="{DynamicResource PresentationFormPagePadding}" Spacing="{StaticResource UiSpaceContent}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">
                    <Label Text="{loc:LocalizedText Profile_WorkoutPrefs_AvailableWeekdays}"
                           Style="{StaticResource SectionTitle}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{loc:LocalizedText Profile_WorkoutPrefs_AvailableWeekdaysHint}"
                           Style="{StaticResource MutedLabel}"
                           LineBreakMode="WordWrap" />
                    <!-- Seven fixed options read better as one checklist than as a four-plus-three
                         card grid, whose final row left an unused cell and whose cards could not
                         hold a full word at large text. -->
                    <VerticalStackLayout
                        Spacing="{StaticResource UiSpacing10}"
                        BindableLayout.ItemsSource="{Binding AvailableWeekdays}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="workoutModels:WorkoutWeekdayOptionItem">
                                <!-- Onboarding option anatomy: canonical card, option label, radio ring. -->
                                <Border Style="{StaticResource CardSecondary}"
                                        SemanticProperties.Description="{Binding Label}"
                                        SemanticProperties.Hint="{loc:LocalizedText Common_NotSelected}">
                                    
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileWorkoutPreferencesViewModel}}, Path=ToggleWeekdayCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}">
                                        <Label Text="{Binding Label}"
                                               Style="{StaticResource AccentLabel}"
                                               VerticalOptions="Center"
                                               LineBreakMode="WordWrap" />
                                        <Border Grid.Column="1" Style="{StaticResource SelectionRadioRing}" VerticalOptions="Center">
                                            <BoxView WidthRequest="{StaticResource UiDimension8}"
                                                     HeightRequest="{StaticResource UiDimension8}"
                                                     CornerRadius="{StaticResource UiCornerRadius4}"
                                                     Color="{StaticResource ContrastInk}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     IsVisible="{Binding IsSelected}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding SelectedWeekdayCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Profile_WorkoutPrefs_SelectedWeekdaysFormat}" Style="{StaticResource MutedCentered}" />
                </VerticalStackLayout>
            </Border>

            <toolkit:LazyView
                x:Name="PreferenceChoicesLazy"
                x:TypeArguments="profileControls:ProfileWorkoutPreferencesChoices" />
        </VerticalStackLayout>
    </ScrollView>
    <VerticalStackLayout Grid.Row="2" Padding="{DynamicResource PresentationActionFooterPadding}" Spacing="{StaticResource UiSpaceTight}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
        <Label
            Text="{Binding StatusMessage, Converter={StaticResource LocalizedStringConverter}}"
            Style="{StaticResource AccentLabel}"
            LineBreakMode="WordWrap"
            IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />
        <Button Style="{StaticResource ButtonPrimary}"
            Text="{Binding SaveActionText}"
            Command="{Binding SaveCommand}"
            IsEnabled="{Binding CanSave}" />
        <ActivityIndicator
                        Style="{StaticResource StateBusyInline}"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            SemanticProperties.Description="{loc:LocalizedText Profile_WorkoutPrefs_SavingPreferences}" />
    </VerticalStackLayout>
    <sharedControls:PageLoadingOverlay BackCommand="{Binding BackCommand, Source={x:Reference Root}}" Grid.RowSpan="3" />
</Grid>
</ContentPage>
