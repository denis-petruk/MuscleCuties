<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Profile.PhotoJourneyVaultPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:profileModels="clr-namespace:MuscleCuties.UI.Models.UI.Profile"
    xmlns:photoPage="clr-namespace:MuscleCuties.UI.Pages.Profile"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Profile"
    x:DataType="vm:PhotoJourneyVaultViewModel"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
        <!-- Header -->
        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
              VerticalOptions="Center">
            <Border
                Style="{StaticResource HeaderIconButton}"
                HorizontalOptions="Start">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                </Border.GestureRecognizers>
                <mi:MauiIcon
                    Icon="{mi:Fluent ChevronLeft24}" IconSize="20" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    WidthRequest="20"
                    HeightRequest="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalOptions="Center">
                <Label Text="{loc:LocalizedText Profile_PhotoJourney_Title}" Style="{StaticResource SectionTitle}" FontSize="17" />
                <Label Grid.Row="1" Text="{loc:LocalizedText Profile_PhotoJourney_PrivateStoredOnThisDevice}" Style="{StaticResource CaptionLabel}"
                       FontSize="12" />
            </Grid>

            <Button
                Grid.Column="2"
                Text="{Binding PrivacyBlurButtonText, Converter={StaticResource LocalizedStringConverter}}"
                Command="{Binding TogglePrivacyBlurCommand}"
                Style="{StaticResource ButtonSecondary}"
                FontSize="12"
                MinimumHeightRequest="36"
                HeightRequest="36"
                Padding="10,0" />
        </Grid>

        <!-- Body (Virtualized CollectionView, zero ScrollViews) -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Photos}"
            ItemSizingStrategy="MeasureFirstItem"
            SelectionMode="None"
            Margin="20,0,20,24"
            MaximumWidthRequest="{StaticResource PageContentMaxWidth}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="16" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <VerticalStackLayout Spacing="16" Margin="0">
                    <!-- Air-Gap Privacy Card -->
                    <Border Style="{StaticResource CardPrimary}" Padding="16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}">
                        <Grid ColumnDefinitions="36,*" ColumnSpacing="12" VerticalOptions="Center">
                            <mi:MauiIcon
                                Icon="{mi:Fluent ShieldLock24}" IconSize="24" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                WidthRequest="24"
                                HeightRequest="24"
                                VerticalOptions="Center" />
                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2">
                                <Label Text="{loc:LocalizedText Profile_PhotoJourney_PrivacyFirstPhotoVault}" FontSize="15" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Grid.Row="1" Text="{loc:LocalizedText Profile_PhotoJourney_YourPhotosAreStoredLocallyAnd}"
                                       Style="{StaticResource CaptionLabel}" FontSize="12" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Action Button -->
                    <Button
                        Text="{loc:LocalizedText Profile_PhotoJourney_PlusAddProgressPhoto}"
                        Clicked="OnAddPhotoClicked"
                        MinimumHeightRequest="48"
                        HeightRequest="48" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <!-- Empty State -->
                <Border
                    Style="{StaticResource CardPrimary}"
                    Padding="24,36"
                    MinimumHeightRequest="{x:Static photoPage:PhotoJourneyVaultPage.EmptyStateMinimumHeight}"
                    HorizontalOptions="Fill">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12"
                          HorizontalOptions="Center" VerticalOptions="Center">
                        <mi:MauiIcon
                            Grid.Row="0"
                            Icon="{mi:Fluent CameraAdd24}" IconSize="40" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Center" />
                        <Label Grid.Row="1" Text="{loc:LocalizedText Profile_PhotoJourney_NoProgressPhotoYet}"
                               Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" FontSize="15" />
                        <Label Grid.Row="2" Text="{loc:LocalizedText Profile_PhotoJourney_ChoosePhotosToTrackProgressPhotos}"
                               Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" FontSize="13" />
                    </Grid>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="profileModels:PhotoVaultItem">
                    <Border Style="{StaticResource CardPrimary}" Padding="14">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                            <!-- Photo header / meta -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Label
                                    Text="{Binding DateFormatted, Converter={StaticResource LocalizedStringConverter}}"
                                    FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />

                                <Border
                                    Grid.Column="1"
                                    IsVisible="{Binding HasWeight}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,3">
                                    <Label
                                        Text="{Binding WeightFormatted, Converter={StaticResource LocalizedStringConverter}}"
                                        FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                </Border>

                                <Button
                                    Grid.Column="2"
                                    Text="{loc:LocalizedText Common_Delete}"
                                    Command="{Binding DeletePhotoCommand, Source={RelativeSource AncestorType={x:Type vm:PhotoJourneyVaultViewModel}}, x:DataType=vm:PhotoJourneyVaultViewModel}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource ButtonLink}"
                                    TextColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                                    FontSize="12"
                                    HeightRequest="30"
                                    MinimumHeightRequest="30"
                                    Padding="6,0" />
                            </Grid>

                            <!-- Photo Image with Tap-to-Reveal Blur -->
                            <Border
                                Grid.Row="1"
                                HeightRequest="240"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="0"
                                Stroke="Transparent"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding ToggleItemRevealCommand, Source={RelativeSource AncestorType={x:Type vm:PhotoJourneyVaultViewModel}}, x:DataType=vm:PhotoJourneyVaultViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid>
                                    <!-- Revealed Photo Image -->
                                    <Image
                                        Source="{Binding RevealedImagePath}"
                                        Aspect="AspectFill"
                                        IsVisible="{Binding IsImageShown}"
                                        HeightRequest="240"
                                        HorizontalOptions="Fill" />

                                    <!-- Blurred Privacy Overlay -->
                                    <Grid
                                        IsVisible="{Binding IsImageHidden}"
                                        BackgroundColor="{AppThemeBinding Light=#EEFFF8FB, Dark=#EE2B1D24}"
                                        RowDefinitions="Auto,Auto,Auto"
                                        RowSpacing="6"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center">
                                        <mi:MauiIcon
                                            Icon="{mi:Fluent ShieldLock24}" IconSize="32" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            HorizontalOptions="Center" />
                                        <Label
                                            Grid.Row="1"
                                            Text="{loc:LocalizedText Profile_PhotoJourney_PhotoHiddenForPrivacy}"
                                            Style="{StaticResource SectionTitle}"
                                            FontSize="15"
                                            IsVisible="{Binding IsImageAvailable}"
                                            HorizontalTextAlignment="Center" />
                                        <Label Grid.Row="2"
                                               Text="{loc:LocalizedText Profile_PhotoJourney_TapToReveal}"
                                               Style="{StaticResource CaptionLabel}"
                                               FontSize="12"
                                               IsVisible="{Binding IsImageAvailable}"
                                               HorizontalTextAlignment="Center" />
                                        <Label Grid.Row="{x:Static photoPage:PhotoJourneyVaultPage.PhotoUnavailableOverlayRow}"
                                               Text="{loc:LocalizedText Profile_PhotoJourney_PhotoUnavailable}"
                                               Style="{StaticResource CaptionLabel}"
                                               IsVisible="{Binding IsImageAvailable, Converter={StaticResource InvertedBoolConverter}}"
                                               HorizontalTextAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Notes if any -->
                            <Label
                                Grid.Row="2"
                                Text="{Binding Notes}"
                                IsVisible="{Binding HasNotes}"
                                Style="{StaticResource CaptionLabel}"
                                FontSize="13" />
                            <Grid Grid.Row="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonSelectionRow}"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonSelectionColumnSpacing}"
                                  IsVisible="{Binding IsImageAvailable}">
                                <Button Text="{loc:LocalizedText Profile_PhotoJourney_FirstPhoto}"
                                        Command="{Binding SelectFirstComparisonPhotoCommand, Source={RelativeSource AncestorType={x:Type vm:PhotoJourneyVaultViewModel}}, x:DataType=vm:PhotoJourneyVaultViewModel}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource ButtonSecondary}" />
                                <Button Grid.Column="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonSecondColumnIndex}"
                                        Text="{loc:LocalizedText Profile_PhotoJourney_SecondPhoto}"
                                        Command="{Binding SelectSecondComparisonPhotoCommand, Source={RelativeSource AncestorType={x:Type vm:PhotoJourneyVaultViewModel}}, x:DataType=vm:PhotoJourneyVaultViewModel}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource ButtonSecondary}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonOverlayPageRow}"
                IsVisible="{Binding IsComparisonOpen}"
                Style="{StaticResource CardPrimary}"
                Margin="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonOverlayMargin}"
                Padding="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonOverlayPadding}"
                VerticalOptions="Center"
                MaximumWidthRequest="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonOverlayMaximumWidth}">
            <VerticalStackLayout Spacing="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonContentSpacing}">
                <Label Text="{loc:LocalizedText Profile_PhotoJourney_ComparePhotos}"
                       Style="{StaticResource SectionTitle}" />
                <Label Text="{loc:LocalizedText Profile_PhotoJourney_ComparisonInstructions}"
                       Style="{StaticResource CaptionLabel}" />
                <Grid HeightRequest="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonImageHeight}"
                      ColumnSpacing="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonImageColumnSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ComparisonFirstColumn" Width="*" />
                        <ColumnDefinition x:Name="ComparisonSecondColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding ComparisonFirstImagePath}" Aspect="AspectFill" />
                    <Image Grid.Column="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonSecondColumnIndex}"
                           Source="{Binding ComparisonSecondImagePath}" Aspect="AspectFill" />
                </Grid>
                <Slider x:Name="ComparisonSlider" ValueChanged="OnComparisonSliderChanged" />
                <Button Text="{loc:LocalizedText Profile_PhotoJourney_CloseComparison}"
                        Command="{Binding CloseComparisonCommand}" Style="{StaticResource ButtonSecondary}" />
            </VerticalStackLayout>
        </Border>

        <sharedControls:PageLoadingOverlay Grid.RowSpan="2" />
    </Grid>
</ContentPage>
