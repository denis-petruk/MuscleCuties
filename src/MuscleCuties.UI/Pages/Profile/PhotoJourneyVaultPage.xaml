<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Profile.PhotoJourneyVaultPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:profileModels="clr-namespace:MuscleCuties.UI.Models.UI.Profile"
    xmlns:photoPage="clr-namespace:MuscleCuties.UI.Pages.Profile"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Profile"
    x:DataType="vm:PhotoJourneyVaultViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
        <!-- Header -->
        <Grid Grid.Row="0" Padding="{DynamicResource PresentationPageHeaderPadding}" VerticalOptions="Center">
            <sharedControls:PageHeader
                Title="{loc:LocalizedText Profile_PhotoJourney_Title}"
                Subtitle="{loc:LocalizedText Profile_PhotoJourney_PrivateStoredOnThisDevice}"
                BackCommand="{Binding NavigateBackCommand}">
                <sharedControls:PageHeader.ActionContent>
                    <Button
                        Text="{Binding PrivacyBlurButtonText, Converter={StaticResource LocalizedStringConverter}}"
                        Command="{Binding TogglePrivacyBlurCommand}"
                        IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource ButtonSecondary}" />
                </sharedControls:PageHeader.ActionContent>
            </sharedControls:PageHeader>
        </Grid>

        <!-- Body (Virtualized CollectionView, zero ScrollViews) -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Photos}"
            ItemSizingStrategy="MeasureFirstItem"
            SelectionMode="None"
            Margin="{DynamicResource PresentationPageContentPadding}"
            MaximumWidthRequest="{StaticResource UiDimension640}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource UiSpaceControl}" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}" Margin="{StaticResource UiInsets0}">
                    <!-- Air-Gap Privacy Card -->
                    <Border Style="{StaticResource CardPrimary}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                            <mi:MauiIcon
                                Icon="{mi:Fluent ShieldLock24}" IconSize="{StaticResource UiDimension24}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                WidthRequest="{StaticResource UiDimension24}"
                                HeightRequest="{StaticResource UiDimension24}"
                                VerticalOptions="Center" />
                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                <Label Text="{loc:LocalizedText Profile_PhotoJourney_PrivacyFirstPhotoVault}"
                                       Style="{StaticResource BodyStrong}" />
                                <Label Grid.Row="1" Text="{loc:LocalizedText Profile_PhotoJourney_YourPhotosAreStoredLocallyAnd}"
                                       Style="{StaticResource CaptionSmall}"
                                       LineBreakMode="WordWrap" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Action Button -->
                    <Button Style="{StaticResource ButtonSecondary}"
                        Text="{loc:LocalizedText Profile_PhotoJourney_PlusAddProgressPhoto}"
                        Clicked="OnAddPhotoClicked" />

                    <!-- Empty state sits with the action. MAUI centres CollectionView.EmptyView in
                         the remaining viewport, which opened a large gap below the button. -->
                    <VerticalStackLayout
                        IsVisible="{Binding IsEmpty}"
                        Spacing="{StaticResource UiSpaceCompact}"
                        HorizontalOptions="Center">
                        <mi:MauiIcon
                            Icon="{mi:Fluent CameraAdd24}"
                            IconSize="{StaticResource UiDimension40}"
                            IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            WidthRequest="{StaticResource UiDimension40}"
                            HeightRequest="{StaticResource UiDimension40}"
                            HorizontalOptions="Center" />
                        <Label Text="{loc:LocalizedText Profile_PhotoJourney_NoProgressPhotoYet}"
                               Style="{StaticResource SectionTitle}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                        <Label Text="{loc:LocalizedText Profile_PhotoJourney_ChoosePhotosToTrackProgressPhotos}"
                               Style="{StaticResource CaptionCentered}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <!-- The visible empty state is in the header beside the action; this view must stay
                     zero-content so it adds no centred block or gap of its own. -->
                <VerticalStackLayout />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="profileModels:PhotoVaultItem">
                    <Border Style="{StaticResource CardPrimary}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing10}">
                            <!-- Photo header / meta: the localized date and weight badge stack in the
                                 growing column so large text and Russian copy wrap instead of being
                                 squeezed by the Delete action. -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                                <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" VerticalOptions="Center">
                                    <Label
                                        Text="{Binding DateFormatted}"
                                        Style="{StaticResource BodyStrong}"
                                        LineBreakMode="WordWrap"
                                        SemanticProperties.HeadingLevel="Level2" />
                                    <Border
                                        Style="{StaticResource PillBadge}"
                                        IsVisible="{Binding HasWeight}"
                                        Padding="{StaticResource UiInsets8_3}"
                                        HorizontalOptions="Start">
                                        <Label
                                            Text="{Binding WeightFormatted}"
                                            VerticalOptions="Center"
                                            Style="{StaticResource CaptionLabel}" />
                                    </Border>
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="1"
                                    VerticalOptions="Start"
                                    Text="{loc:LocalizedText Common_Delete}"
                                    Command="{Binding DeletePhotoCommand, Source={RelativeSource AncestorType={x:Type vm:PhotoJourneyVaultViewModel}}, x:DataType=vm:PhotoJourneyVaultViewModel}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource ButtonSecondary}"
                                    SemanticProperties.Description="{loc:LocalizedText Common_Delete}" />
                            </Grid>

                            <!-- Photo Image with Tap-to-Reveal Blur -->
                            <Border
                                Grid.Row="1"
                                Style="{StaticResource CardSecondary}"
                                HeightRequest="{StaticResource UiDimension240}"
                                SemanticProperties.Description="{Binding AccessibilityDescription}"
                                SemanticProperties.Hint="{loc:LocalizedText Profile_PhotoJourney_RevealOrHideHint}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding ToggleItemRevealCommand, Source={RelativeSource AncestorType={x:Type vm:PhotoJourneyVaultViewModel}}, x:DataType=vm:PhotoJourneyVaultViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid IsClippedToBounds="True">
                                    <!-- Revealed Photo Image -->
                                    <Image
                                        Source="{Binding RevealedImagePath}"
                                        Aspect="AspectFill"
                                        IsVisible="{Binding IsImageShown}"
                                        HeightRequest="{StaticResource UiDimension240}"
                                        HorizontalOptions="Fill" />

                                    <!-- Privacy cover: the rounded card surface is the only background so
                                         hidden photos never show a rectangular patch inside it. -->
                                    <Grid
                                        IsVisible="{Binding IsImageHidden}"
                                        RowDefinitions="Auto,Auto,Auto"
                                        RowSpacing="{StaticResource UiSpacing6}"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Fill">
                                        <mi:MauiIcon
                                            Icon="{mi:Fluent ShieldLock24}" IconSize="{StaticResource UiDimension32}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            WidthRequest="{StaticResource UiDimension32}"
                                            HeightRequest="{StaticResource UiDimension32}"
                                            HorizontalOptions="Center" />
                                        <Label
                                            Grid.Row="1"
                                            Text="{loc:LocalizedText Profile_PhotoJourney_PhotoHiddenForPrivacy}"
                                            Style="{StaticResource SectionTitle}"
                                            IsVisible="{Binding IsImageAvailable}"
                                            HorizontalTextAlignment="Center" />
                                        <Label Grid.Row="2"
                                               Text="{loc:LocalizedText Profile_PhotoJourney_TapToReveal}"
                                               Style="{StaticResource CaptionSmallCentered}"
                                               IsVisible="{Binding IsImageAvailable}" />
                                        <Label Grid.Row="{x:Static photoPage:PhotoJourneyVaultPage.PhotoUnavailableOverlayRow}"
                                               Text="{loc:LocalizedText Profile_PhotoJourney_PhotoUnavailable}"
                                               Style="{StaticResource CaptionCentered}"
                                               IsVisible="{Binding IsImageAvailable, Converter={StaticResource InvertedBoolConverter}}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Notes if any -->
                            <Label
                                Grid.Row="2"
                                Text="{Binding Notes}"
                                IsVisible="{Binding HasNotes}"
                                Style="{StaticResource CaptionLabel}"
                                LineBreakMode="WordWrap" />
                            <!-- Comparison selection stacks full width: two side-by-side halves
                                 truncated "Use as first/second photo" at narrow widths, large text and RU. -->
                            <VerticalStackLayout Grid.Row="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonSelectionRow}"
                                                 Spacing="{StaticResource UiSpaceTight}"
                                                 IsVisible="{Binding IsImageAvailable}">
                                <Button Text="{loc:LocalizedText Profile_PhotoJourney_FirstPhoto}"
                                        Command="{Binding SelectFirstComparisonPhotoCommand, Source={RelativeSource AncestorType={x:Type vm:PhotoJourneyVaultViewModel}}, x:DataType=vm:PhotoJourneyVaultViewModel}"
                                        CommandParameter="{Binding .}"
                                        LineBreakMode="WordWrap"
                                        Style="{StaticResource ButtonSecondary}" />
                                <Button Text="{loc:LocalizedText Profile_PhotoJourney_SecondPhoto}"
                                        Command="{Binding SelectSecondComparisonPhotoCommand, Source={RelativeSource AncestorType={x:Type vm:PhotoJourneyVaultViewModel}}, x:DataType=vm:PhotoJourneyVaultViewModel}"
                                        CommandParameter="{Binding .}"
                                        LineBreakMode="WordWrap"
                                        Style="{StaticResource ButtonSecondary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonOverlayPageRow}"
                IsVisible="{Binding IsComparisonOpen}"
                Style="{StaticResource CardPrimary}"
                Margin="{StaticResource UiInsets20}"
                VerticalOptions="Center"
                MaximumWidthRequest="{StaticResource UiDimension640}">
            <!-- One scroll owner keeps Close reachable at large text on short screens. -->
            <ScrollView>
                <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">
                    <Label Text="{loc:LocalizedText Profile_PhotoJourney_ComparePhotos}"
                           Style="{StaticResource SectionTitle}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{loc:LocalizedText Profile_PhotoJourney_ComparisonInstructions}"
                           Style="{StaticResource CaptionLabel}"
                           LineBreakMode="WordWrap" />
                    <!-- Each half clips its own AspectFill image, so moving the divider crops rather
                         than stretches, and neither photo can draw over the other at narrow widths. -->
                    <Grid HeightRequest="{StaticResource UiDimension280}"
                          ColumnSpacing="{StaticResource UiSpacing2}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ComparisonFirstColumn" Width="*" />
                            <ColumnDefinition x:Name="ComparisonSecondColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid IsClippedToBounds="True">
                            <Image Source="{Binding ComparisonFirstImagePath}"
                                   Aspect="AspectFill"
                                   SemanticProperties.Description="{loc:LocalizedText Profile_PhotoJourney_FirstComparisonLabel}" />
                        </Grid>
                        <Grid Grid.Column="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonSecondColumnIndex}"
                              IsClippedToBounds="True">
                            <Image Source="{Binding ComparisonSecondImagePath}"
                                   Aspect="AspectFill"
                                   SemanticProperties.Description="{loc:LocalizedText Profile_PhotoJourney_SecondComparisonLabel}" />
                        </Grid>
                    </Grid>
                    <!-- Captions stay pinned to the outer edges rather than following the divider,
                         so they never truncate when one half is narrow. -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource UiSpaceTight}">
                        <Label Text="{loc:LocalizedText Profile_PhotoJourney_FirstComparisonLabel}"
                               Style="{StaticResource CaptionLabel}"
                               LineBreakMode="WordWrap" />
                        <Label Grid.Column="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonSecondColumnIndex}"
                               Text="{loc:LocalizedText Profile_PhotoJourney_SecondComparisonLabel}"
                               Style="{StaticResource CaptionLabel}"
                               HorizontalTextAlignment="End"
                               LineBreakMode="WordWrap" />
                    </Grid>
                    <Slider x:Name="ComparisonSlider"
                            ValueChanged="OnComparisonSliderChanged"
                            SemanticProperties.Description="{loc:LocalizedText Profile_PhotoJourney_ComparisonSliderDescription}" />
                    <Button Text="{loc:LocalizedText Profile_PhotoJourney_CloseComparison}"
                            Command="{Binding CloseComparisonCommand}"
                            LineBreakMode="WordWrap"
                            Style="{StaticResource ButtonSecondary}" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <sharedControls:PageLoadingOverlay Grid.RowSpan="2" />
    </Grid>
</ContentPage>
