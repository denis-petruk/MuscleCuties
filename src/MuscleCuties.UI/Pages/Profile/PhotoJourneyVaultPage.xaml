<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Profile.PhotoJourneyVaultPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:profileModels="clr-namespace:MuscleCuties.UI.Models.UI.Profile"
    xmlns:photoPage="clr-namespace:MuscleCuties.UI.Pages.Profile"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Profile"
    x:DataType="vm:PhotoJourneyVaultViewModel"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
        <!-- Header -->
        <Grid Grid.Row="0" Padding="{StaticResource UiInsets20_36_20_12}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}"
              VerticalOptions="Center">
            <Border
                Style="{StaticResource HeaderIconButton}"
                HorizontalOptions="Start">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                </Border.GestureRecognizers>
                <mi:MauiIcon
                    Icon="{mi:Fluent ChevronLeft24}" IconSize="{StaticResource UiDimension20}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    WidthRequest="{StaticResource UiDimension20}"
                    HeightRequest="{StaticResource UiDimension20}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalOptions="Center">
                <Label Text="{loc:LocalizedText Profile_PhotoJourney_Title}" Style="{StaticResource SectionTitle}" FontSize="{StaticResource UiFontSize17}" />
                <Label Grid.Row="1" Text="{loc:LocalizedText Profile_PhotoJourney_PrivateStoredOnThisDevice}" Style="{StaticResource CaptionSmall}" />
            </Grid>

            <Button
                Grid.Column="2"
                Text="{Binding PrivacyBlurButtonText, Converter={StaticResource LocalizedStringConverter}}"
                Command="{Binding TogglePrivacyBlurCommand}"
                Style="{StaticResource ButtonSecondary}" />
        </Grid>

        <!-- Body (Virtualized CollectionView, zero ScrollViews) -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Photos}"
            ItemSizingStrategy="MeasureFirstItem"
            SelectionMode="None"
            Margin="{StaticResource UiInsets20_0_20_24}"
            MaximumWidthRequest="{StaticResource UiDimension640}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource UiSpaceControl}" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}" Margin="{StaticResource UiInsets0}">
                    <!-- Air-Gap Privacy Card -->
                    <Border Style="{StaticResource CardPrimary}">
                        <Grid ColumnDefinitions="36,*" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                            <mi:MauiIcon
                                Icon="{mi:Fluent ShieldLock24}" IconSize="{StaticResource UiDimension24}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                WidthRequest="{StaticResource UiDimension24}"
                                HeightRequest="{StaticResource UiDimension24}"
                                VerticalOptions="Center" />
                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                <Label Text="{loc:LocalizedText Profile_PhotoJourney_PrivacyFirstPhotoVault}" FontSize="{StaticResource UiFontSize15}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Grid.Row="1" Text="{loc:LocalizedText Profile_PhotoJourney_YourPhotosAreStoredLocallyAnd}"
                                       Style="{StaticResource CaptionSmall}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Action Button -->
                    <Button Style="{StaticResource ButtonSecondary}"
                        Text="{loc:LocalizedText Profile_PhotoJourney_PlusAddProgressPhoto}"
                        Clicked="OnAddPhotoClicked" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <!-- Empty State -->
                <Border
                    Style="{StaticResource CardPrimary}"
                    MinimumHeightRequest="{StaticResource UiDimension220}"
                    HorizontalOptions="Fill">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpaceCompact}"
                          HorizontalOptions="Center" VerticalOptions="Center">
                        <mi:MauiIcon
                            Grid.Row="0"
                            Icon="{mi:Fluent CameraAdd24}" IconSize="{StaticResource UiDimension40}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            WidthRequest="{StaticResource UiDimension40}"
                            HeightRequest="{StaticResource UiDimension40}"
                            HorizontalOptions="Center" />
                        <Label Grid.Row="1" Text="{loc:LocalizedText Profile_PhotoJourney_NoProgressPhotoYet}"
                               Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" FontSize="{StaticResource UiFontSize15}" />
                        <Label Grid.Row="2" Text="{loc:LocalizedText Profile_PhotoJourney_ChoosePhotosToTrackProgressPhotos}"
                               Style="{StaticResource CaptionCentered}" FontSize="{StaticResource UiFontSize13}" />
                    </Grid>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="profileModels:PhotoVaultItem">
                    <Border Style="{StaticResource CardPrimary}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing10}">
                            <!-- Photo header / meta -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceTight}" VerticalOptions="Center">
                                <Label
                                    Text="{Binding DateFormatted, Converter={StaticResource LocalizedStringConverter}}"
                                    FontAttributes="{StaticResource UiFontAttributesBold}" FontSize="{StaticResource UiFontSize15}" VerticalOptions="Center" />

                                <Border
                                    Grid.Column="1"
                                    Style="{StaticResource PillBadge}"
                                    IsVisible="{Binding HasWeight}"
                                    Padding="{StaticResource UiInsets8_3}">
                                    <Label
                                        Text="{Binding WeightFormatted, Converter={StaticResource LocalizedStringConverter}}"
                                        FontSize="{StaticResource UiFontSize12}" FontAttributes="{StaticResource UiFontAttributesBold}" VerticalOptions="Center" />
                                </Border>

                                <Button
                                    Grid.Column="2"
                                    Text="{loc:LocalizedText Common_Delete}"
                                    Command="{Binding DeletePhotoCommand, Source={RelativeSource AncestorType={x:Type vm:PhotoJourneyVaultViewModel}}, x:DataType=vm:PhotoJourneyVaultViewModel}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource ButtonSecondary}"
                                    SemanticProperties.Description="{loc:LocalizedText Common_Delete}" />
                            </Grid>

                            <!-- Photo Image with Tap-to-Reveal Blur -->
                            <Border
                                Grid.Row="1"
                                Style="{StaticResource CardSecondary}"
                                HeightRequest="{StaticResource UiDimension240}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding ToggleItemRevealCommand, Source={RelativeSource AncestorType={x:Type vm:PhotoJourneyVaultViewModel}}, x:DataType=vm:PhotoJourneyVaultViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid>
                                    <!-- Revealed Photo Image -->
                                    <Image
                                        Source="{Binding RevealedImagePath}"
                                        Aspect="AspectFill"
                                        IsVisible="{Binding IsImageShown}"
                                        HeightRequest="{StaticResource UiDimension240}"
                                        HorizontalOptions="Fill" />

                                    <!-- Blurred Privacy Overlay -->
                                    <Grid
                                        IsVisible="{Binding IsImageHidden}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource TranslucentPageSurfaceLight}, Dark={StaticResource TranslucentPageSurfaceDark}}"
                                        RowDefinitions="Auto,Auto,Auto"
                                        RowSpacing="{StaticResource UiSpacing6}"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center">
                                        <mi:MauiIcon
                                            Icon="{mi:Fluent ShieldLock24}" IconSize="{StaticResource UiDimension32}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            WidthRequest="{StaticResource UiDimension32}"
                                            HeightRequest="{StaticResource UiDimension32}"
                                            HorizontalOptions="Center" />
                                        <Label
                                            Grid.Row="1"
                                            Text="{loc:LocalizedText Profile_PhotoJourney_PhotoHiddenForPrivacy}"
                                            Style="{StaticResource SectionTitle}"
                                            FontSize="{StaticResource UiFontSize15}"
                                            IsVisible="{Binding IsImageAvailable}"
                                            HorizontalTextAlignment="Center" />
                                        <Label Grid.Row="2"
                                               Text="{loc:LocalizedText Profile_PhotoJourney_TapToReveal}"
                                               Style="{StaticResource CaptionSmallCentered}"
                                               IsVisible="{Binding IsImageAvailable}" />
                                        <Label Grid.Row="{x:Static photoPage:PhotoJourneyVaultPage.PhotoUnavailableOverlayRow}"
                                               Text="{loc:LocalizedText Profile_PhotoJourney_PhotoUnavailable}"
                                               Style="{StaticResource CaptionCentered}"
                                               IsVisible="{Binding IsImageAvailable, Converter={StaticResource InvertedBoolConverter}}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Notes if any -->
                            <Label
                                Grid.Row="2"
                                Text="{Binding Notes}"
                                IsVisible="{Binding HasNotes}"
                                Style="{StaticResource CaptionLabel}" />
                            <Grid Grid.Row="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonSelectionRow}"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="{StaticResource UiSpaceTight}"
                                  IsVisible="{Binding IsImageAvailable}">
                                <Button Text="{loc:LocalizedText Profile_PhotoJourney_FirstPhoto}"
                                        Command="{Binding SelectFirstComparisonPhotoCommand, Source={RelativeSource AncestorType={x:Type vm:PhotoJourneyVaultViewModel}}, x:DataType=vm:PhotoJourneyVaultViewModel}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource ButtonSecondary}" />
                                <Button Grid.Column="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonSecondColumnIndex}"
                                        Text="{loc:LocalizedText Profile_PhotoJourney_SecondPhoto}"
                                        Command="{Binding SelectSecondComparisonPhotoCommand, Source={RelativeSource AncestorType={x:Type vm:PhotoJourneyVaultViewModel}}, x:DataType=vm:PhotoJourneyVaultViewModel}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource ButtonSecondary}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonOverlayPageRow}"
                IsVisible="{Binding IsComparisonOpen}"
                Style="{StaticResource CardPrimary}"
                Margin="{StaticResource UiInsets20}"
                VerticalOptions="Center"
                MaximumWidthRequest="{StaticResource UiDimension640}">
            <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">
                <Label Text="{loc:LocalizedText Profile_PhotoJourney_ComparePhotos}"
                       Style="{StaticResource SectionTitle}" />
                <Label Text="{loc:LocalizedText Profile_PhotoJourney_ComparisonInstructions}"
                       Style="{StaticResource CaptionLabel}" />
                <Grid HeightRequest="{StaticResource UiDimension280}"
                      ColumnSpacing="{StaticResource UiSpacing2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ComparisonFirstColumn" Width="*" />
                        <ColumnDefinition x:Name="ComparisonSecondColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding ComparisonFirstImagePath}" Aspect="AspectFill" />
                    <Image Grid.Column="{x:Static photoPage:PhotoJourneyVaultPage.ComparisonSecondColumnIndex}"
                           Source="{Binding ComparisonSecondImagePath}" Aspect="AspectFill" />
                </Grid>
                <Slider x:Name="ComparisonSlider" ValueChanged="OnComparisonSliderChanged" />
                <Button Text="{loc:LocalizedText Profile_PhotoJourney_CloseComparison}"
                        Command="{Binding CloseComparisonCommand}" Style="{StaticResource ButtonSecondary}" />
            </VerticalStackLayout>
        </Border>

        <sharedControls:PageLoadingOverlay Grid.RowSpan="2" />
    </Grid>
</ContentPage>
