<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Profile.ProfileFeedbackPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:commonModels="clr-namespace:MuscleCuties.UI.Models.UI.Common"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Profile"
    x:DataType="vm:ProfileFeedbackViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Padding="{DynamicResource PresentationPageHeaderPadding}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
            <sharedControls:PageHeader Title="{loc:LocalizedText Profile_Feedback_Feedback}"
                                       Subtitle="{loc:LocalizedText Profile_Feedback_Subtitle}"
                                       BackCommand="{Binding BackCommand}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{DynamicResource PresentationFormPagePadding}" Spacing="{StaticResource UiSpaceControl}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
                <Border Style="{StaticResource CardPrimary}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Profile_Feedback_YourMessage}"
                                                          IconGlyph="ChatBubblesQuestion24" />

                        <Border Style="{StaticResource EditorContainer}">
                            <Editor Placeholder="{loc:LocalizedText Profile_Feedback_WhatHappenedOrWhatShouldChange}"
                                    Text="{Binding FeedbackText}"
                                    AutoSize="TextChanges"
                                    SemanticProperties.Description="{loc:LocalizedText Profile_Feedback_YourFeedback}" />
                        </Border>

                        <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                            <Label Text="{loc:LocalizedText Profile_Feedback_SuggestedFixOptional}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource EditorContainer}">
                                <Editor Placeholder="{loc:LocalizedText Profile_Feedback_WhatWouldWorkBetter}"
                                        Text="{Binding AdjustmentText}"
                                        AutoSize="TextChanges"
                                        SemanticProperties.Description="{loc:LocalizedText Profile_Feedback_SuggestedChange}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardSecondary}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Profile_Feedback_Details}"
                                                          IconGlyph="ChatSettings24" />

                        <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                                <Label Text="{loc:LocalizedText Profile_Feedback_Topic}"
                                       Style="{StaticResource FormFieldLabel}" />
                                <Border Grid.Row="1" Style="{StaticResource PickerContainer}">
                                    <Picker Title="{loc:LocalizedText Profile_Feedback_Topic}"
                                            ItemsSource="{Binding TopicOptions}"
                                            ItemDisplayBinding="{Binding Label, x:DataType=commonModels:ILabeledOption, Converter={StaticResource LocalizedStringConverter}}"
                                            SelectedItem="{Binding SelectedTopicOption}"
                                            SemanticProperties.Description="{loc:LocalizedText Profile_Feedback_Topic}" />
                                </Border>
                            </Grid>

                            <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                                <Label Text="{loc:LocalizedText Profile_Feedback_Priority}"
                                       Style="{StaticResource FormFieldLabel}" />
                                <Border Grid.Row="1" Style="{StaticResource PickerContainer}">
                                    <Picker Title="{loc:LocalizedText Profile_Feedback_Priority}"
                                            ItemsSource="{Binding PriorityOptions}"
                                            ItemDisplayBinding="{Binding Label, x:DataType=commonModels:ILabeledOption, Converter={StaticResource LocalizedStringConverter}}"
                                            SelectedItem="{Binding SelectedPriorityOption}"
                                            SemanticProperties.Description="{loc:LocalizedText Profile_Feedback_Priority}" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Text="{loc:LocalizedText Profile_Feedback_ScreenOptional}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                <Entry Placeholder="{loc:LocalizedText Profile_Feedback_EGNutrition}"
                                       Text="{Binding ScreenName}"
                                       SemanticProperties.Description="{loc:LocalizedText Profile_Feedback_ScreenOptional}" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="{StaticResource UiDimension1}"
                                 Color="{AppThemeBinding Light={StaticResource DividerSubtleLight}, Dark={StaticResource DividerSubtleDark}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}"
                              MinimumHeightRequest="{StaticResource UiDimension48}">
                            <Label Text="{loc:LocalizedText Profile_Feedback_IncludeReplyEmail}"
                                   Style="{StaticResource CardTitle}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IncludeContactEmail}"
                                    OnColor="{StaticResource Primary}"
                                    ThumbColor="{AppThemeBinding Light={StaticResource ControlThumbLight}, Dark={StaticResource ControlThumbDark}}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="{loc:LocalizedText Profile_Feedback_IncludeContactEmailForAReply}" />
                        </Grid>

                        <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}" IsVisible="{Binding IncludeContactEmail}">
                            <Label Text="{loc:LocalizedText Profile_Feedback_ReplyEmail}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Placeholder="{loc:LocalizedText Profile_Feedback_ReplyEmail}"
                                       Text="{Binding ContactEmail}"
                                       Keyboard="Email"
                                       SemanticProperties.Description="{loc:LocalizedText Profile_Feedback_ReplyEmail}" />
                            </Border>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="{StaticResource UiDimension1}"
                                 Color="{AppThemeBinding Light={StaticResource DividerSubtleLight}, Dark={StaticResource DividerSubtleDark}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}"
                              MinimumHeightRequest="{StaticResource UiDimension48}">
                            <sharedControls:IconSectionHeader Text="{loc:LocalizedText Profile_Feedback_Attachment}"
                                                              IconGlyph="LinkSquare24"
                                                              VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="{loc:LocalizedText Profile_Feedback_AddFile}"
                                    Style="{StaticResource ButtonSecondary}"
                                    Clicked="OnAttachFileClicked" />
                        </Grid>

                        <Grid IsVisible="{Binding HasAttachment}" ColumnDefinitions="*,Auto"
                              ColumnSpacing="{StaticResource UiSpaceCompact}">
                            <Label Text="{Binding AttachmentName}"
                                   Style="{StaticResource MutedLabel}"
                                   LineBreakMode="MiddleTruncation"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="{loc:LocalizedText Profile_Feedback_Remove}"
                                    Style="{StaticResource ButtonSecondary}"
                                    Command="{Binding RemoveAttachmentCommand}" />
                        </Grid>

                        <Label Text="{Binding AttachmentStatus, Converter={StaticResource LocalizedStringConverter}}"
                               Style="{StaticResource CaptionLabel}"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding AttachmentStatus, Converter={StaticResource StringToBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="{DynamicResource PresentationActionFooterPadding}" Spacing="{StaticResource UiSpaceTight}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
            <Label Text="{Binding StatusMessage, Converter={StaticResource LocalizedStringConverter}}"
                   Style="{StaticResource CaptionLabel}"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />
            <Button Style="{StaticResource ButtonPrimary}"
                    Text="{loc:LocalizedText Profile_Feedback_OpenEmailDraft}"
                    Command="{Binding SendFeedbackCommand}"
                    IsEnabled="{Binding IsReadyToSend}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
