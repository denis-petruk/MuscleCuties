<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Profile.ProfilePersonalInfoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:commonModels="clr-namespace:MuscleCuties.UI.Models.UI.Common"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Profile"
    x:DataType="vm:ProfilePersonalInfoViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Padding="{DynamicResource PresentationPageHeaderPadding}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
            <sharedControls:PageHeader
                Title="{loc:LocalizedText Profile_PersonalInfo_PersonalInfo}"
                Subtitle="{loc:LocalizedText Profile_PersonalInfo_Subtitle}"
                BackCommand="{Binding BackCommand}" />
        </Grid>

        <ScrollView x:Name="PersonalInfoScroll" Grid.Row="1">
            <VerticalStackLayout Padding="{DynamicResource PresentationFormPagePadding}" Spacing="{StaticResource UiSpaceControl}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
                <Border Style="{StaticResource CardPrimary}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Profile_PersonalInfo_Account}"
                                                          IconGlyph="PersonPill24" />

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Profile_PersonalInfo_DisplayName}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                <Entry Placeholder="{loc:LocalizedText Profile_PersonalInfo_Name}"
                                       Text="{Binding Name}"
                                       MaxLength="50"
                                       SemanticProperties.Description="{loc:LocalizedText Profile_PersonalInfo_DisplayName}" />
                            </Border>
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Auth_Email}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                <Entry Placeholder="{loc:LocalizedText Auth_EmailAddress}"
                                       Text="{Binding Email}"
                                       Keyboard="Email"
                                       SemanticProperties.Description="{loc:LocalizedText Auth_Email}" />
                            </Border>
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Profile_PersonalInfo_Birthday}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                <DatePicker Date="{Binding BirthDate}"
                                            DateSelected="OnBirthDateSelected"
                                            MinimumDate="{Binding MinBirthDate}"
                                            MaximumDate="{Binding MaxBirthDate}"
                                            Format="d"
                                            SemanticProperties.Description="{loc:LocalizedText Profile_PersonalInfo_Birthday}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardPrimary}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                            <sharedControls:IconSectionHeader Text="{loc:LocalizedText Profile_PersonalInfo_BodyAndCycle}"
                                                              IconGlyph="HeartCircle24" />
                            <Label Grid.Column="1"
                                   Text="{loc:LocalizedText Profile_PersonalInfo_LocalOnly}"
                                   Style="{StaticResource CaptionSmall}"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource UiSpaceCompact}">
                            <Grid Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                                <Label Grid.Row="0" Text="{loc:LocalizedText Common_Height}"
                                       Style="{StaticResource FormFieldLabel}" />
                                <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                    <Entry Placeholder="{Binding HeightUnitLabel}"
                                           Text="{Binding HeightCm}"
                                           Keyboard="Numeric"
                                           SemanticProperties.Description="{loc:LocalizedText Common_Height}" />
                                </Border>
                            </Grid>

                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                                <Label Grid.Row="0" Text="{loc:LocalizedText Common_Weight}"
                                       Style="{StaticResource FormFieldLabel}" />
                                <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                    <Entry Placeholder="{Binding WeightUnitLabel}"
                                           Text="{Binding WeightKg}"
                                           Keyboard="Numeric"
                                           SemanticProperties.Description="{loc:LocalizedText Common_Weight}" />
                                </Border>
                            </Grid>
                        </Grid>

                        <BoxView HeightRequest="{StaticResource UiDimension1}"
                                 Color="{AppThemeBinding Light={StaticResource DividerSubtleLight}, Dark={StaticResource DividerSubtleDark}}" />

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Profile_PersonalInfo_CycleLengthDays}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding CycleLength}"
                                       Placeholder="{loc:LocalizedText Profile_PersonalInfo_CycleLengthPlaceholder}"
                                       Keyboard="Numeric"
                                       SemanticProperties.Description="{loc:LocalizedText Profile_PersonalInfo_CycleLengthDays}" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="{StaticResource UiDimension1}"
                                 Color="{AppThemeBinding Light={StaticResource DividerSubtleLight}, Dark={StaticResource DividerSubtleDark}}" />

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Profile_PersonalInfo_CurrentlyPregnantOrBreastfeeding}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource PickerContainer}">
                                <Picker Title="{loc:LocalizedText Profile_PersonalInfo_PregnancyOrBreastfeeding}"
                                        ItemsSource="{Binding PregnancyOptions}"
                                        ItemDisplayBinding="{Binding Label, x:DataType=commonModels:ILabeledOption}"
                                        SelectedItem="{Binding SelectedPregnancyOption}"
                                        SemanticProperties.Description="{loc:LocalizedText Profile_PersonalInfo_CurrentlyPregnantOrBreastfeeding}" />
                            </Border>
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Profile_PersonalInfo_HormonalContraceptionOrCyclePattern}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource PickerContainer}">
                                <Picker Title="{loc:LocalizedText Profile_PersonalInfo_ContraceptionOrCyclePattern}"
                                        ItemsSource="{Binding ContraceptionOptions}"
                                        ItemDisplayBinding="{Binding Label, x:DataType=commonModels:ILabeledOption}"
                                        SelectedItem="{Binding SelectedContraceptionOption}"
                                        SemanticProperties.Description="{loc:LocalizedText Profile_PersonalInfo_HormonalContraceptionOrCyclePattern}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardPrimary}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">
                        <Label Text="{loc:LocalizedText Profile_Measurement_Title}"
                               Style="{StaticResource SectionTitle}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Button Text="{loc:LocalizedText Profile_Measurement_ViewHistory}"
                                Style="{StaticResource ButtonSecondary}"
                                IsVisible="{Binding IsMeasurementHistoryOpen, Converter={StaticResource InvertedBoolConverter}}"
                                Command="{Binding OpenMeasurementHistoryCommand}" />

                        <VerticalStackLayout IsVisible="{Binding IsMeasurementHistoryOpen}"
                                             Spacing="{StaticResource UiSpaceControl}">
                            <ActivityIndicator IsRunning="{Binding IsMeasurementBusy}"
                                               IsVisible="{Binding IsMeasurementBusy}"
                                               SemanticProperties.Description="{loc:LocalizedText Profile_Measurement_Working}" />

                            <Label Text="{Binding MeasurementStatus}" Style="{StaticResource CaptionSmall}"
                                   IsVisible="{Binding MeasurementStatus, Converter={StaticResource StringToBoolConverter}}"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding MeasurementReference}" Style="{StaticResource CaptionSmall}"
                                   IsVisible="{Binding MeasurementReference, Converter={StaticResource StringToBoolConverter}}"
                                   LineBreakMode="WordWrap" />

                            <VerticalStackLayout IsVisible="{Binding IsMeasurementEditorOpen, Converter={StaticResource InvertedBoolConverter}}"
                                                 IsEnabled="{Binding IsMeasurementBusy, Converter={StaticResource InvertedBoolConverter}}"
                                                 Spacing="{StaticResource UiSpaceCompact}">
                                <Button Text="{loc:LocalizedText Profile_Measurement_Add}"
                                        Style="{StaticResource ButtonPrimary}"
                                        IsEnabled="{Binding CanUseMeasurementHistory}"
                                        IsVisible="{Binding IsMeasurementHistoryLoaded}"
                                        Command="{Binding AddMeasurementCommand}" />
                                <Button Text="{loc:LocalizedText Dashboard_Shared_Retry}"
                                        Style="{StaticResource ButtonSecondary}"
                                        IsVisible="{Binding IsMeasurementHistoryLoaded, Converter={StaticResource InvertedBoolConverter}}"
                                        Command="{Binding RefreshMeasurementHistoryCommand}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="MeasurementEditor"
                                                 IsVisible="{Binding IsMeasurementEditorOpen}"
                                                 Spacing="{StaticResource UiSpaceControl}">
                                <VerticalStackLayout IsEnabled="{Binding CanEditMeasurement}"
                                                     IsVisible="{Binding IsMeasurementDeleteConfirmationOpen, Converter={StaticResource InvertedBoolConverter}}"
                                                     Spacing="{StaticResource UiSpaceControl}">
                                    <VerticalStackLayout Spacing="{StaticResource PresentationFieldSpacing}">
                                        <Label Text="{loc:LocalizedText Profile_Measurement_Site}"
                                               Style="{StaticResource FormFieldLabel}" />
                                        <Border Style="{StaticResource PickerContainer}">
                                            <Picker Title="{loc:LocalizedText Profile_Measurement_Site}"
                                                    ItemsSource="{Binding MeasurementSites}"
                                                    ItemDisplayBinding="{Binding Label, x:DataType=commonModels:ILabeledOption, Converter={StaticResource LocalizedStringConverter}}"
                                                    SelectedItem="{Binding MeasurementSite}"
                                                    SemanticProperties.Description="{loc:LocalizedText Profile_Measurement_Site}" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout IsVisible="{Binding IsMeasurementSideRequired}"
                                                         Spacing="{StaticResource PresentationFieldSpacing}">
                                        <Label Text="{loc:LocalizedText Profile_Measurement_Side}"
                                               Style="{StaticResource FormFieldLabel}" />
                                        <Border Style="{StaticResource PickerContainer}">
                                            <Picker Title="{loc:LocalizedText Profile_Measurement_Side}"
                                                    ItemsSource="{Binding MeasurementSides}"
                                                    ItemDisplayBinding="{Binding Label, x:DataType=commonModels:ILabeledOption, Converter={StaticResource LocalizedStringConverter}}"
                                                    SelectedItem="{Binding MeasurementSide}"
                                                    SemanticProperties.Description="{loc:LocalizedText Profile_Measurement_Side}" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="{StaticResource PresentationFieldSpacing}">
                                        <Label Text="{loc:LocalizedText Profile_Measurement_Date}"
                                               Style="{StaticResource FormFieldLabel}" />
                                        <Border Style="{StaticResource InputContainer}">
                                            <DatePicker Date="{Binding MeasurementDate}"
                                                        MinimumDate="{Binding MinMeasurementDate}"
                                                        MaximumDate="{Binding MaxMeasurementDate}"
                                                        Format="d"
                                                        SemanticProperties.Description="{loc:LocalizedText Profile_Measurement_Date}" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="{StaticResource PresentationFieldSpacing}">
                                        <Label Text="{loc:LocalizedText Profile_Measurement_Unit}"
                                               Style="{StaticResource FormFieldLabel}" />
                                        <Border Style="{StaticResource PickerContainer}">
                                            <Picker Title="{loc:LocalizedText Profile_Measurement_Unit}"
                                                    ItemsSource="{Binding MeasurementUnits}"
                                                    ItemDisplayBinding="{Binding Label, x:DataType=commonModels:ILabeledOption, Converter={StaticResource LocalizedStringConverter}}"
                                                    SelectedItem="{Binding MeasurementUnit}"
                                                    SemanticProperties.Description="{loc:LocalizedText Profile_Measurement_Unit}" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="{StaticResource PresentationFieldSpacing}">
                                        <Label Text="{Binding MeasurementValueLabel}"
                                               Style="{StaticResource FormFieldLabel}" />
                                        <Border Style="{StaticResource InputContainer}">
                                            <Entry Text="{Binding MeasurementValue}" Keyboard="Numeric"
                                                   ReturnType="Done"
                                                   SemanticProperties.Description="{Binding MeasurementValueLabel}" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <Button Text="{loc:LocalizedText Profile_Measurement_Save}"
                                            Style="{StaticResource ButtonPrimary}"
                                            IsEnabled="{Binding CanSaveMeasurement}"
                                            Command="{Binding SaveMeasurementCommand}" />
                                    <Button Text="{loc:LocalizedText Profile_Measurement_Delete}"
                                            Style="{StaticResource ButtonSecondary}"
                                            IsEnabled="{Binding CanSaveMeasurement}"
                                            IsVisible="{Binding IsMeasurementExisting}"
                                            Command="{Binding RequestMeasurementDeleteCommand}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout IsVisible="{Binding IsMeasurementDeleteConfirmationOpen}"
                                                     Spacing="{StaticResource UiSpaceCompact}">
                                    <Label Text="{loc:LocalizedText Profile_Measurement_ConfirmDelete}"
                                           Style="{StaticResource BodyLabel}"
                                           LineBreakMode="WordWrap" />
                                    <Button Text="{loc:LocalizedText Profile_Measurement_Delete}"
                                            Style="{StaticResource ButtonSecondary}"
                                            Command="{Binding DeleteMeasurementCommand}" />
                                    <Button Text="{loc:LocalizedText Common_Cancel}"
                                            Style="{StaticResource ButtonSecondary}"
                                            Command="{Binding CancelMeasurementDeleteCommand}" />
                                </VerticalStackLayout>

                                <Button Text="{loc:LocalizedText Dashboard_Shared_Retry}"
                                        Style="{StaticResource ButtonPrimary}"
                                        IsVisible="{Binding CanRetryMeasurementMutation}"
                                        IsEnabled="{Binding IsMeasurementBusy, Converter={StaticResource InvertedBoolConverter}}"
                                        Command="{Binding RetryMeasurementCommand}" />
                                <Button Text="{loc:LocalizedText Common_Cancel}"
                                        Style="{StaticResource ButtonSecondary}"
                                        IsEnabled="{Binding IsMeasurementBusy, Converter={StaticResource InvertedBoolConverter}}"
                                        IsVisible="{Binding IsMeasurementDeleteConfirmationOpen, Converter={StaticResource InvertedBoolConverter}}"
                                        Command="{Binding CancelMeasurementCommand}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout IsVisible="{Binding IsMeasurementEditorOpen, Converter={StaticResource InvertedBoolConverter}}"
                                                 IsEnabled="{Binding CanUseMeasurementHistory}"
                                                 Spacing="{StaticResource UiSpaceCompact}">
                                <Label Text="{loc:LocalizedText Profile_Measurement_Empty}"
                                       Style="{StaticResource CaptionSmall}"
                                       IsVisible="{Binding ShowEmptyMeasurements}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding VisibleMeasurements}"
                                                     Spacing="{StaticResource UiSpaceCompact}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="commonModels:MeasurementHistoryRow">
                                            <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                                                <BoxView HeightRequest="{StaticResource UiDimension1}"
                                                         Color="{AppThemeBinding Light={StaticResource DividerSubtleLight}, Dark={StaticResource DividerSubtleDark}}" />
                                                <Label Text="{Binding Name}" Style="{StaticResource FormFieldLabel}" />
                                                <Label Text="{Binding Detail}" Style="{StaticResource CaptionSmall}" />
                                                <Button Text="{loc:LocalizedText Common_Edit}"
                                                        Style="{StaticResource ButtonSecondary}"
                                                        HorizontalOptions="Start"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="OnEditMeasurementClicked"
                                                        SemanticProperties.Description="{Binding EditDescription}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Button Text="{loc:LocalizedText Profile_Measurement_ShowMore}"
                                        Style="{StaticResource ButtonSecondary}"
                                        IsVisible="{Binding HasMoreMeasurements}"
                                        Command="{Binding ShowMoreMeasurementsCommand}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardPrimary}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Auth_Password}"
                                                          IconGlyph="ShieldLock24" />

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Profile_PersonalInfo_CurrentPassword}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                <Entry AutomationId="ProfileCurrentPassword"
                                       Placeholder="{loc:LocalizedText Profile_PersonalInfo_EnterCurrentPassword}"
                                       Text="{Binding CurrentPassword}"
                                       IsPassword="True"
                                       ReturnType="Next"
                                       SemanticProperties.Description="{loc:LocalizedText Profile_PersonalInfo_CurrentPassword}" />
                            </Border>
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Auth_NewPassword}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                <Entry AutomationId="ProfileNewPassword"
                                       Placeholder="{loc:LocalizedText Profile_PersonalInfo_CreateNewPassword}"
                                       Text="{Binding NewPassword}"
                                       IsPassword="True"
                                       ReturnType="Next"
                                       SemanticProperties.Description="{loc:LocalizedText Auth_NewPassword}"
                                       SemanticProperties.Hint="{loc:LocalizedText Profile_PersonalInfo_UseAtLeastEightCharactersWith}" />
                            </Border>
                            <Label Grid.Row="2"
                                   Text="{loc:LocalizedText Profile_PersonalInfo_UseAtLeastEightCharactersWith}"
                                   Style="{StaticResource CaptionSmall}"
                                   LineBreakMode="WordWrap" />
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Auth_ConfirmPassword}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                <Entry AutomationId="ProfileConfirmPassword"
                                       Placeholder="{loc:LocalizedText Profile_PersonalInfo_RepeatNewPassword}"
                                       Text="{Binding ConfirmNewPassword}"
                                       IsPassword="True"
                                       ReturnType="Done"
                                       ReturnCommand="{Binding ChangePasswordCommand}"
                                       SemanticProperties.Description="{loc:LocalizedText Auth_ConfirmNewPassword}"
                                       SemanticProperties.Hint="{loc:LocalizedText Profile_PersonalInfo_ReEnterYourNewPasswordThen}" />
                            </Border>
                        </Grid>

                        <Label Text="{Binding PasswordStatusMessage, Converter={StaticResource LocalizedStringConverter}}"
                               Style="{StaticResource CaptionSmall}"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding PasswordStatusMessage, Converter={StaticResource StringToBoolConverter}}"
                               SemanticProperties.Description="{Binding PasswordStatusMessage, Converter={StaticResource LocalizedStringConverter}}" />

                        <Button Text="{loc:LocalizedText Profile_PersonalInfo_ChangePassword}"
                                Style="{StaticResource ButtonSecondary}"
                                Command="{Binding ChangePasswordCommand}"
                                SemanticProperties.Description="{loc:LocalizedText Profile_PersonalInfo_ChangePassword}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="{DynamicResource PresentationActionFooterPadding}" Spacing="{StaticResource UiSpaceTight}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
            <Label Text="{Binding StatusMessage, Converter={StaticResource LocalizedStringConverter}}"
                   Style="{StaticResource CaptionSmall}"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                   SemanticProperties.Description="{Binding StatusMessage, Converter={StaticResource LocalizedStringConverter}}" />
            <Button Style="{StaticResource ButtonPrimary}"
                    Text="{loc:LocalizedText Profile_PersonalInfo_SavePersonalInfo}"
                    Command="{Binding SaveCommand}"
                    SemanticProperties.Description="{loc:LocalizedText Profile_PersonalInfo_SavePersonalInfo}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
