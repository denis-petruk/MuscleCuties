<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Nutrition.NutritionPage"
    x:Name="NutritionRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:nutritionControls="clr-namespace:MuscleCuties.UI.Controls.Nutrition"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.UI.Models.UI.Nutrition"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition"
    x:DataType="vm:NutritionViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <CollectionView
            ItemsSource="{Binding Meals}"
            ItemSizingStrategy="MeasureFirstItem"
            MaximumWidthRequest="{StaticResource UiDimension640}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource UiSpaceCompact}" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Padding="{StaticResource UiInsets20_36_20_12}" Spacing="{StaticResource UiSpaceControl}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource UiSpacing10}" VerticalOptions="Center">
                        <Label Text="{loc:LocalizedText Nutrition_Page_Nutrition}" Style="{StaticResource Headline}"
                               VerticalOptions="Center" />

                        <Border
                            Grid.Column="1"
                            Style="{StaticResource HeaderIconButton}"
                            SemanticProperties.Description="{loc:LocalizedText Nutrition_Page_FoodLogHistory}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToFoodLogCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M19 4H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V6a2 2 0 00-2-2zM16 2v4M8 2v4M3 10h18"
                                Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                StrokeThickness="{StaticResource UiStrokeWidth1_8}"
                                StrokeLineCap="Round"
                                StrokeLineJoin="Round"
                                Aspect="Uniform"
                                WidthRequest="{StaticResource UiDimension18}"
                                HeightRequest="{StaticResource UiDimension18}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Border
                            Grid.Column="2"
                            Style="{StaticResource HeaderIconButton}"
                            SemanticProperties.Description="{loc:LocalizedText Nutrition_Page_AddMeal}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenMealEntryCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M12 5v14M5 12h14"
                                Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                StrokeThickness="{StaticResource UiStrokeWidth2_2}"
                                StrokeLineCap="Round"
                                Aspect="Uniform"
                                WidthRequest="{StaticResource UiDimension18}"
                                HeightRequest="{StaticResource UiDimension18}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <toolkit:LazyView
                        x:Name="PhaseFocusLazy"
                        x:TypeArguments="nutritionControls:NutritionPhaseFocusCard" />
                    <toolkit:LazyView
                        x:Name="BalanceCardLazy"
                        x:TypeArguments="nutritionControls:NutritionBalanceCard" />
                    <Button
                        Text="{loc:LocalizedText Nutrition_LogAMeal}"
                        Command="{Binding OpenMealEntryCommand}"
                        MinimumHeightRequest="{StaticResource UiDimension52}"
                        FontAttributes="{StaticResource UiFontAttributesBold}"
                        Margin="{StaticResource UiInsets0_4}"
                        SemanticProperties.Description="{loc:LocalizedText Nutrition_LogAMeal}"
                        SemanticProperties.Hint="{loc:LocalizedText Nutrition_Page_OpensOptionsToAddFoodGet}" />

                    <sharedControls:IconSectionHeader
                        Text="{loc:LocalizedText Nutrition_Page_Meals}"
                        IconGlyph="BowlChopsticks24"
                        Margin="{StaticResource UiInsets4_6_4_0}" />

                    <Border
                        Style="{StaticResource CardPrimary}"
                        Padding="{StaticResource UiInsets16}"
                        IsVisible="{Binding HasNoMeals}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpacing14}">
                            <Border
                                Style="{StaticResource ModalIconButton}">
                                <Path
                                    Data="M3 2v7c0 1.1.9 2 2 2h2c1.1 0 2-.9 2-2V2M6 2v20M15 2v8h4M19 2v20"
                                    Style="{StaticResource NutritionLineIcon}"
                                    WidthRequest="{StaticResource UiDimension20}"
                                    HeightRequest="{StaticResource UiDimension20}" />
                            </Border>
                            <Label
                                Grid.Column="1"
                                Text="{loc:LocalizedText Nutrition_Page_NoMealsLoggedYet}"
                                Style="{StaticResource CardTitle}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="nutritionModels:MealItem">
                    <Border
                        Style="{StaticResource CardPrimary}"
                        Margin="{StaticResource UiInsets20_0}"
                        Padding="{StaticResource UiInsets14}"
                        SemanticProperties.Description="{Binding Name, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_Page_MealValueTapToViewBreakdown}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding OpenMealBreakdownCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="{StaticResource UiSpaceCompact}" RowSpacing="{StaticResource UiSpaceMicro}" MinimumHeightRequest="{StaticResource UiDimension72}">
                            <HorizontalStackLayout Spacing="{StaticResource UiSpaceTight}">
                                <Label
                                    Text="{Binding MealType, Converter={StaticResource LocalizedStringConverter}}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                                    FontSize="{StaticResource UiFontSize13}"
                                    FontAttributes="{StaticResource UiFontAttributesBold}" />
                                <Label Text="·" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding Time, Converter={StaticResource LocalizedStringConverter}}"
                                       Style="{StaticResource CaptionLabel}" />
                            </HorizontalStackLayout>
                            <Label
                                Grid.Row="1"
                                Text="{Binding Name}"
                                Style="{StaticResource CardTitle}"
                                LineBreakMode="WordWrap" />
                            <Label
                                Grid.Row="2"
                                Text="{Binding MacrosSummaryText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource MutedLabel}"
                                LineBreakMode="WordWrap" />

                            <HorizontalStackLayout Grid.Column="1" Spacing="{StaticResource UiSpaceMicro}" VerticalOptions="Start">
                                <Image
                                    Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                                    Aspect="AspectFit"
                                    WidthRequest="{StaticResource UiDimension16}"
                                    HeightRequest="{StaticResource UiDimension16}"
                                    VerticalOptions="Center" />
                                <Label
                                    Text="{Binding CaloriesText, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource BodyLabel}"
                                    FontAttributes="{StaticResource UiFontAttributesBold}"
                                    HorizontalTextAlignment="End"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="{StaticResource UiDimension24}" BackgroundColor="{StaticResource Transparent}" />
            </CollectionView.Footer>
        </CollectionView>

        <toolkit:LazyView
            x:Name="Breakdown"
            x:TypeArguments="nutritionControls:NutritionBreakdownModal"
            InputTransparent="{Binding IsBreakdownModalVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView
            x:Name="Suggestions"
            x:TypeArguments="nutritionControls:MealSuggestionModal"
            InputTransparent="{Binding IsSuggestionModalVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView
            x:Name="MealDetail"
            x:TypeArguments="nutritionControls:MealDetailModal"
            InputTransparent="{Binding IsMealDetailVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView
            x:Name="MealEditor"
            x:TypeArguments="nutritionControls:MealEditorModal"
            InputTransparent="{Binding IsMealEditorVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView
            x:Name="SaluteOverlay"
            x:TypeArguments="sharedControls:PhaseSaluteOverlay"
            InputTransparent="True" />
        <nutritionControls:MealEntryModal
            IsOpen="{Binding IsMealEntryModalVisible}" />
        <sharedControls:PageLoadingOverlay />
    </Grid>
</ContentPage>
