<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Nutrition.NutritionPage"
    x:Name="NutritionRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:nutritionControls="clr-namespace:MuscleCuties.UI.Controls.Nutrition"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.UI.Models.UI.Nutrition"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition"
    x:DataType="vm:NutritionViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="{DynamicResource PresentationPageHeaderPadding}" VerticalOptions="Center">
            <sharedControls:PageHeader Title="{loc:LocalizedText Nutrition_Page_Nutrition}" ShowBack="False" />
        </Grid>

        <CollectionView
            Grid.Row="1"
            Margin="{DynamicResource PresentationCollectionHorizontalInset}"
            ItemsSource="{Binding Meals}"
            ItemSizingStrategy="MeasureAllItems"
            MaximumWidthRequest="{StaticResource UiDimension640}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource UiSpaceCompact}" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Padding="{DynamicResource PresentationCollectionHeaderPadding}" Spacing="{StaticResource UiSpaceContent}">

                    <toolkit:LazyView
                        x:Name="PhaseFocusLazy"
                        x:TypeArguments="nutritionControls:NutritionPhaseFocusCard" />
                    <toolkit:LazyView
                        x:Name="BalanceCardLazy"
                        x:TypeArguments="nutritionControls:NutritionBalanceCard" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource UiSpaceTight}"
                          Margin="{StaticResource UiInsets0_4}">
                        <Button Style="{StaticResource ButtonPrimary}"
                                Text="{loc:LocalizedText Nutrition_Page_AddMeal}"
                                Command="{Binding OpenMealEntryCommand}"
                                LineBreakMode="WordWrap"
                                SemanticProperties.Description="{loc:LocalizedText Nutrition_Page_AddMeal}"
                                SemanticProperties.Hint="{loc:LocalizedText Nutrition_Page_OpensMealLogger}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource ButtonSecondary}"
                                Text="{loc:LocalizedText Nutrition_PlanMyDay}"
                                Command="{Binding StartDayPlanCommand}"
                                LineBreakMode="WordWrap"
                                SemanticProperties.Description="{loc:LocalizedText Nutrition_PlanMyDay}"
                                SemanticProperties.Hint="{loc:LocalizedText Nutrition_MealEntry_BuildsAFullDayMealPlan}" />
                    </Grid>

                    <Label
                        Text="{Binding PageStatusMessage}"
                        IsVisible="{Binding IsPageStatusVisible}"
                        Style="{StaticResource BodyLabel}"
                        LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}"
                          Margin="{StaticResource UiInsets4_6_4_0}">
                        <sharedControls:IconSectionHeader
                            Text="{loc:LocalizedText Nutrition_Page_Meals}"
                            IconGlyph="BowlChopsticks24"
                            Margin="0" />
                        <Label Grid.Column="1"
                               Text="{loc:LocalizedText Nutrition_FoodLog_DailyFoodLog}"
                               Style="{StaticResource AccentLabel}"
                               MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="End"
                               LineBreakMode="WordWrap"
                               SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_DailyFoodLog}"
                               SemanticProperties.Hint="{loc:LocalizedText Nutrition_Page_OpensDailyFoodLog}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToFoodLogCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Border
                        Style="{StaticResource CardPrimary}"
                        IsVisible="{Binding HasNoMeals}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpacing14}">
                            <Border
                                Style="{StaticResource ModalIconButton}">
                                <Path
                                    Data="M3 2v7c0 1.1.9 2 2 2h2c1.1 0 2-.9 2-2V2M6 2v20M15 2v8h4M19 2v20"
                                    Style="{StaticResource NutritionLineIcon}"
                                    WidthRequest="{StaticResource UiDimension20}"
                                    HeightRequest="{StaticResource UiDimension20}" />
                            </Border>
                            <Label
                                Grid.Column="1"
                                Text="{loc:LocalizedText Nutrition_Page_NoMealsLoggedYet}"
                                Style="{StaticResource StateEmptyTitle}"
                                LineBreakMode="WordWrap"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="nutritionModels:MealItem">
                    <nutritionControls:MealCardView
                        Margin="{DynamicResource PresentationCollectionItemMargin}"
                        Heading="{Binding MealType, Converter={StaticResource LocalizedStringConverter}}"
                        CaloriesText="{Binding CaloriesText, Converter={StaticResource LocalizedStringConverter}}"
                        TargetShareText="{Binding TargetShareText}"
                        MealName="{Binding Name}"
                        IngredientsText="{Binding IngredientsText}"
                        MacrosText="{Binding MacrosSummaryText, Converter={StaticResource LocalizedStringConverter}}"
                        MealTypeIconData="{Binding MealTypeIconData}"
                        SemanticDescription="{Binding Name, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_Page_MealValueTapToViewBreakdown}"
                        EditCommand="{Binding EditMealCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}"
                        EditCommandParameter="{Binding .}"
                        TemplateCommand="{Binding SaveMealAsTemplateCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}"
                        TemplateCommandParameter="{Binding .}"
                        OpenCommand="{Binding OpenMealBreakdownCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}"
                        OpenCommandParameter="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="{StaticResource UiDimension32}" BackgroundColor="{StaticResource Transparent}" />
            </CollectionView.Footer>
        </CollectionView>

        <toolkit:LazyView Grid.RowSpan="2"
            x:Name="Breakdown"
            x:TypeArguments="nutritionControls:NutritionBreakdownModal"
            BindingContext="{Binding Breakdown}"
            IsVisible="{Binding Breakdown.IsVisible}"
            InputTransparent="{Binding Breakdown.IsVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView Grid.RowSpan="2"
            x:Name="Suggestions"
            x:TypeArguments="nutritionControls:MealSuggestionModal"
            IsVisible="{Binding IsSuggestionModalVisible}"
            InputTransparent="{Binding IsSuggestionModalVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView Grid.RowSpan="2"
            x:Name="MealDetail"
            x:TypeArguments="nutritionControls:MealDetailModal"
            IsVisible="{Binding IsMealDetailVisible}"
            InputTransparent="{Binding IsMealDetailVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView Grid.RowSpan="2"
            x:Name="MealEditor"
            x:TypeArguments="nutritionControls:MealEditorModal"
            IsVisible="{Binding IsMealEditorVisible}"
            InputTransparent="{Binding IsMealEditorVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <!-- NM01: the Add meal host exists only while the sheet is requested, so it can never leave an
             uninitialized layer over an interactive page. -->
        <toolkit:LazyView Grid.RowSpan="2"
            x:Name="MealEntry"
            x:TypeArguments="nutritionControls:MealEntryModal"
            IsVisible="{Binding IsMealEntryModalVisible}"
            InputTransparent="{Binding IsMealEntryModalVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView Grid.RowSpan="2"
            x:Name="SaluteOverlay"
            x:TypeArguments="sharedControls:PhaseSaluteOverlay"
            InputTransparent="True" />
        <sharedControls:PageLoadingOverlay Grid.RowSpan="2" />
    </Grid>
</ContentPage>
