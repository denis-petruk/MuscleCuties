<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Nutrition.FoodLogPage"
    x:Name="FoodLogRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:dtos="clr-namespace:MuscleCuties.Core.Models.Nutrition;assembly=MuscleCuties.Core"
    xmlns:nutritionControls="clr-namespace:MuscleCuties.UI.Controls.Nutrition"
    xmlns:recipeDtos="clr-namespace:MuscleCuties.UseCases.Features.Nutrition.Recipes.Contracts;assembly=MuscleCuties.UseCases"
    xmlns:uiModels="clr-namespace:MuscleCuties.UI.Models.UI.Nutrition"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition"
    x:DataType="vm:FoodLogViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Resources>
        <x:Double x:Key="RecipeBuilderSectionSpacing">14</x:Double>
        <x:Double x:Key="RecipeBuilderFieldSpacing">6</x:Double>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">

        <!-- Top Navigation Bar -->
        <Grid
            Grid.Row="0"
            Padding="16,44,16,12"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="10"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

            <Border
                Style="{StaticResource CircleIconButton}"
                SemanticProperties.Description="{loc:LocalizedText Common_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                </Border.GestureRecognizers>
                <Path
                    Data="M15 19l-7-7 7-7"
                    Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    StrokeThickness="2"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Aspect="Uniform"
                    WidthRequest="14"
                    HeightRequest="14"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Label
                Grid.Column="1"
                Text="{loc:LocalizedText Nutrition_FoodLog_DailyFoodLog}"
                Style="{StaticResource SubHeadline}"
                FontSize="20"
                VerticalOptions="Center" />

            <Button
                Grid.Column="2"
                Text="{loc:LocalizedText Common_Today}"
                Command="{Binding JumpToTodayCommand}"
                HeightRequest="36"
                Padding="12,0"
                CornerRadius="18"
                FontSize="13"
                FontAttributes="Bold"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                BorderWidth="1"
                VerticalOptions="Center"
                IsVisible="{Binding IsSelectedDateToday, Converter={StaticResource InvertedBoolConverter}}" />

            <Border
                Grid.Column="3"
                Style="{StaticResource CircleIconButton}"
                SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_OpenDatePicker}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleDatePickerCommand}" />
                </Border.GestureRecognizers>
                <Path
                    Data="M19 4H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V6a2 2 0 00-2-2zM16 2v4M8 2v4M3 10h18"
                    Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Aspect="Uniform"
                    WidthRequest="16"
                    HeightRequest="16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Main Virtualized Scroll Container (CollectionView, zero nested ScrollViews) -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding MealSections}"
            ItemSizingStrategy="MeasureFirstItem"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Spacing="16" Padding="16,8,16,14">

                    <Button Text="{loc:LocalizedText Nutrition_FoodLog_RetryLoadingThisDay}" Command="{Binding RetryLoadCommand}"
                            IsVisible="{Binding IsLoadError}" MinimumHeightRequest="44" />
                    <!-- Horizontal Rolling Date Strip Header -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="8" RowSpacing="8" VerticalOptions="Center">
                        <Border
                            Style="{StaticResource CircleIconButton}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PreviousDayCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M15 19l-7-7 7-7"
                                Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                StrokeThickness="2"
                                Aspect="Uniform"
                                WidthRequest="12"
                                HeightRequest="12"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label Grid.Column="1"
                               Text="{Binding FormattedSelectedDate, Converter={StaticResource LocalizedStringConverter}}"
                               FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />

                        <CollectionView
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            ItemsSource="{Binding DateStripDays}"
                            ItemSizingStrategy="MeasureFirstItem"
                            HeightRequest="68"
                            SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="uiModels:DateStripDayItem">
                                    <Border
                                        WidthRequest="52"
                                        HeightRequest="64"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="1"
                                        Stroke="{Binding IsSelected, Converter={StaticResource BoolToSelectionStrokeConverter}, FallbackValue=Transparent}"
                                        BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToSelectionBgConverter}, FallbackValue=Transparent}"
                                        Padding="4,6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectDateCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2" VerticalOptions="Center"
                                              HorizontalOptions="Center">
                                            <Label
                                                Grid.Row="0"
                                                Text="{Binding DayName, Converter={StaticResource LocalizedStringConverter}}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            <Label
                                                Grid.Row="1"
                                                Text="{Binding DayNumber, Converter={StaticResource LocalizedStringConverter}}"
                                                FontSize="17"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <BoxView
                                                Grid.Row="2"
                                                WidthRequest="4"
                                                HeightRequest="4"
                                                CornerRadius="2"
                                                HorizontalOptions="Center"
                                                Color="{StaticResource Primary}"
                                                IsVisible="{Binding IsToday}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Border
                            Grid.Column="2"
                            Style="{StaticResource CircleIconButton}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NextDayCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M9 5l7 7-7 7"
                                Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                StrokeThickness="2"
                                Aspect="Uniform"
                                WidthRequest="12"
                                HeightRequest="12"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Native Date Picker Trigger (Hidden unless toggled) -->
                    <Border
                        IsVisible="{Binding IsDatePickerOpen}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                        StrokeThickness="1"
                        Padding="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <DatePicker
                                Date="{Binding PickerDate}"
                                Format="d"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <Button
                                Grid.Column="1"
                                Text="{loc:LocalizedText Nutrition_FoodLog_Go}"
                                Command="{Binding DatePickerSelectedCommand}"
                                CommandParameter="{Binding PickerDate}"
                                HeightRequest="36"
                                Padding="14,0"
                                CornerRadius="8"
                                FontSize="13"
                                FontAttributes="Bold" />
                        </Grid>
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource Primary}" HeightRequest="24" />

                    <!-- Selected Day Headline & Macro Vectors Card -->
                    <Border
                        StrokeShape="RoundRectangle 18"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                        StrokeThickness="1"
                        Padding="18,16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                                    <Label
                                        Grid.Row="0"
                                        Text="{Binding FormattedSelectedDate, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource SubHeadline}"
                                        FontSize="18" />
                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding CalorieRemainingText, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource MutedLabel}"
                                        FontSize="13" />
                                </Grid>

                                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label
                                        Text="{Binding TotalCalories, StringFormat='{0:F0}'}"
                                        FontSize="24"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        Text="{Binding TargetCalories, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_Format_TargetCaloriesValueKcal}"
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        VerticalOptions="End"
                                        Margin="0,0,0,3" />
                                </HorizontalStackLayout>
                            </Grid>

                            <!-- Pure Vector Calorie Bar -->
                            <Grid Grid.Row="1" HeightRequest="8">
                                <Border
                                    StrokeShape="RoundRectangle 4"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                    HorizontalOptions="Fill" />
                                <ProgressBar
                                    Progress="{Binding CalorieProgressRatio}"
                                    ProgressColor="{StaticResource Primary}"
                                    HorizontalOptions="Fill" />
                            </Grid>

                            <!-- Macronutrient Split Bars -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="14" Margin="0,4,0,0">
                                <!-- Protein -->
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{loc:LocalizedText Nutrition_Macro_Protein}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding TotalProtein, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_ValueG}"
                                           FontSize="12"
                                           FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                 Progress="{Binding ProteinProgressRatio}"
                                                 ProgressColor="{StaticResource PrimaryDark}" HeightRequest="4" />
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding TargetProtein, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_TargetValueG}"
                                           FontSize="10"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>

                                <!-- Carbs -->
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                                      RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{loc:LocalizedText Nutrition_Macro_Carbs}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding TotalCarbs, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_ValueG}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource WarningAccentLight}, Dark={StaticResource WarningAccentDark}}" />
                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                 Progress="{Binding CarbsProgressRatio}"
                                                 ProgressColor="{AppThemeBinding Light={StaticResource WarningAccentLight}, Dark={StaticResource WarningAccentDark}}"
                                                 HeightRequest="4" />
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding TargetCarbs, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_TargetValueG}"
                                           FontSize="10"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>

                                <!-- Fat -->
                                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                                      RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{loc:LocalizedText Nutrition_Macro_Fat}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding TotalFat, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_ValueG}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                 Progress="{Binding FatProgressRatio}"
                                                 ProgressColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}"
                                                 HeightRequest="4" />
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding TargetFat, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_TargetValueG}"
                                           FontSize="10"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>
                            </Grid>

                            <!-- Water Tracker Row -->
                            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0"
                                  VerticalOptions="Center">
                                <Label Text="{loc:LocalizedText Nutrition_FoodLog_Water}" FontSize="13" FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding WaterIntakeMl, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_ValueMl}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="2" Text="{loc:LocalizedText Nutrition_FoodLog_SubtractWaterTwoFiftyMl}"
                                        Command="{Binding RemoveWaterCommand}"
                                        CommandParameter="{x:Int32 250}" HeightRequest="30" Padding="8,0" FontSize="11"
                                        CornerRadius="6"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Button Grid.Column="3" Text="{loc:LocalizedText Nutrition_FoodLog_AddWaterTwoFiftyMl}"
                                        Command="{Binding AddWaterCommand}"
                                        CommandParameter="{x:Int32 250}" HeightRequest="30" Padding="8,0" FontSize="11"
                                        CornerRadius="6"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}" />
                            </Grid>

                            <!-- Quick Diary Actions Row -->
                            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                <Label
                                    Text="Yesterday's diary"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    VerticalOptions="Center" />
                                <Border
                                    Grid.Column="1"
                                    Padding="10,4"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource Gray900}}"
                                    VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CopyYesterdayDiaryCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="Copy yesterday"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource PrimaryDark}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Meal Section ItemTemplate (Breakfast, Lunch, Dinner, Snacks) -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="uiModels:MealSectionUiGroup">
                    <Border
                        Margin="16,0"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                        StrokeThickness="1"
                        Padding="14,12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <!-- Section Header Row -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                                    <Label
                                        Grid.Row="0"
                                        Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding SummaryText, Converter={StaticResource LocalizedStringConverter}}"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>

                                <Border
                                    Grid.Column="1"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    StrokeShape="RoundRectangle 22"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_AddFoodToMeal}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding OpenAddFoodCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                            CommandParameter="{Binding MealType}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="+" FontSize="18" FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDark}"
                                           HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-2,0,0" />
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource Gray900}}"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasItems}"
                                    SemanticProperties.Description="Save meal as template">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SaveMealAsTemplateCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                            CommandParameter="{Binding MealType}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="★" FontSize="13"
                                           TextColor="{StaticResource PrimaryDark}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <Border
                                    Grid.Column="3"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding ToggleMealSectionCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="{Binding IsExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Border>
                            </Grid>

                            <!-- Items in Meal -->
                            <VerticalStackLayout
                                Grid.Row="1"
                                IsVisible="{Binding IsExpanded}"
                                Spacing="6"
                                Margin="0,4,0,0"
                                BindableLayout.ItemsSource="{Binding Items}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:FoodItemEntryDto">
                                        <Border
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                            StrokeThickness="1"
                                            Padding="10,8"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource InputSurface}, Dark={StaticResource InputSurfaceDark}}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenEditFoodCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                                                <Label
                                                    Text="{Binding Name}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                <Label
                                                    Grid.Row="1"
                                                    Text="{Binding ServingsCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_ValueServ}"
                                                    FontSize="12"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding Calories, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_Format_CaloriesValueKcal}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    HorizontalTextAlignment="End"
                                                    TextColor="{StaticResource PrimaryDark}" />
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Text="{Binding Protein, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_ValueGP}"
                                                    FontSize="11"
                                                    HorizontalTextAlignment="End"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Empty State for Section with Copy Yesterday -->
                            <Grid
                                Grid.Row="2"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8"
                                Margin="4,2"
                                IsVisible="{Binding HasItems, Converter={StaticResource InvertedBoolConverter}}">
                                <Label
                                    Text="{loc:LocalizedText Nutrition_FoodLog_NoFoodsLoggedYetTapTo}"
                                    FontSize="12"
                                    FontAttributes="Italic"
                                    VerticalOptions="Center"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Border
                                    Padding="10,4"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource Gray900}}"
                                    VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding CopyYesterdayMealCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                            CommandParameter="{Binding MealType}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="Copy yesterday"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource PrimaryDark}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Grid HeightRequest="40" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Inline Tap-To-Edit Modal Sheet (Optimistic UI) -->
        <Grid
            Grid.RowSpan="2"
            IsVisible="{Binding IsEditModalVisible}">
            <BoxView BackgroundColor="{StaticResource ModalScrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseEditModalCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                x:Name="EditSheetSurface"
                Style="{StaticResource AppBottomSheetSurface}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer /> <!-- Absorb tap inside dialog -->
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto,*">
                    <Grid Padding="20,18,20,14" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label
                                Text="{Binding IsEditingExisting, Converter={StaticResource BoolToEditTitleConverter}}"
                                Style="{StaticResource ModalTitle}"
                                VerticalOptions="Center" />
                            <Border
                                Grid.Column="1"
                                Style="{StaticResource ModalIconButton}"
                                SemanticProperties.Description="{loc:LocalizedText Common_Close}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseEditModalCommand}" />
                                </Border.GestureRecognizers>
                                <Path Style="{StaticResource ModalCloseIcon}" />
                            </Border>
                    </Grid>

                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Default">
                        <VerticalStackLayout Padding="20,4,20,20" Spacing="12">

                        <!-- Fast logging: local history first, then an explicit catalog lookup. -->
                        <Label Text="{Binding StatusMessage, Converter={StaticResource LocalizedStringConverter}}"
                               IsVisible="{Binding IsStatusVisible}" FontSize="14" />
                        <ActivityIndicator IsRunning="{Binding IsWriting}" IsVisible="{Binding IsWriting}" />
                        <ActivityIndicator IsRunning="{Binding IsLoadingFastLogging}"
                                           IsVisible="{Binding IsLoadingFastLogging}" />
                        <VerticalStackLayout IsVisible="{Binding IsFastLoggingVisible}" Spacing="12"
                                             IsEnabled="{Binding IsWriting, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="{loc:LocalizedText Nutrition_FoodLog_RecentIngredientsThisMeal}" FontSize="13" FontAttributes="Bold" />
                            <Label Text="{loc:LocalizedText Nutrition_FoodLog_NothingLoggedInThisMealOver}"
                                   FontSize="12"
                                   IsVisible="{Binding HasRecentIngredients, Converter={StaticResource InvertedBoolConverter}}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentIngredients}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="uiModels:QuickFoodItemUiModel">
                                        <nutritionControls:QuickFoodItemRow />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label Text="{loc:LocalizedText Nutrition_FoodLog_RecentAcceptedSuggestions}" FontSize="13" FontAttributes="Bold" />
                            <Label Text="{loc:LocalizedText Nutrition_FoodLog_NoEligibleAcceptedSuggestionsInThe}"
                                   FontSize="12"
                                   IsVisible="{Binding HasRecentSuggestions, Converter={StaticResource InvertedBoolConverter}}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentSuggestions}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="uiModels:QuickFoodItemUiModel">
                                        <nutritionControls:QuickFoodItemRow />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Saved Meal Templates Shelf -->
                            <VerticalStackLayout IsVisible="{Binding HasSavedTemplates}" Spacing="6">
                                <Label Text="Saved Meal Templates" FontSize="13" FontAttributes="Bold" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SavedMealTemplates}" Spacing="4">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="recipeDtos:MealTemplateDto">
                                            <Border StrokeShape="RoundRectangle 10"
                                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                                    StrokeThickness="1"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                                    Padding="12,10">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding LogMealTemplateCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                        <Label Text="{Binding ItemCount, StringFormat='{0} items'}" FontSize="12"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                    </VerticalStackLayout>
                                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                        <Label Text="{Binding TotalCalories, StringFormat='{0:F0} kcal'}" FontSize="13" FontAttributes="Bold"
                                                               TextColor="{StaticResource PrimaryDark}" VerticalOptions="Center" />
                                                        <Label Text="+" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Saved Recipes Shelf -->
                            <VerticalStackLayout IsVisible="{Binding HasSavedRecipes}" Spacing="6">
                                <Label Text="Saved Recipes" FontSize="13" FontAttributes="Bold" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SavedRecipes}" Spacing="4">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="recipeDtos:RecipeSummaryDto">
                                            <Border StrokeShape="RoundRectangle 10"
                                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                                    StrokeThickness="1"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                                    Padding="12,10">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding LogRecipeCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                        <Label Text="{Binding PerServingCalories, StringFormat='Per serving • {0:F0} kcal'}" FontSize="12"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="1" Text="+ 1 serving" FontSize="12" FontAttributes="Bold"
                                                           TextColor="{StaticResource PrimaryDark}" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <Label Text="{loc:LocalizedText Nutrition_SearchFoods}" FontSize="13" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry Text="{Binding FoodSearchQuery}" Placeholder="{loc:LocalizedText Nutrition_FoodLog_SearchFoodsOnThisDevice}"
                                       ReturnType="Search" FontSize="14" VerticalOptions="Center" />
                                <Border Grid.Column="1" Padding="12,0" HeightRequest="44"
                                        StrokeShape="RoundRectangle 9"
                                        Stroke="{StaticResource Primary}"
                                        StrokeThickness="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenBarcodeScannerCommand}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="{loc:LocalizedText Nutrition_FoodLog_ManualBarcodeLookup}" FontSize="12"
                                               FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="{loc:LocalizedText Nutrition_FoodLog_SearchDevice}" Command="{Binding SearchFoodCommand}"
                                        FontSize="12"
                                        HeightRequest="44" CornerRadius="9" />
                                <Button Grid.Column="1" Text="{loc:LocalizedText Nutrition_FoodLog_SearchUsda}"
                                        Command="{Binding SearchUsdaCommand}"
                                        FontSize="12" HeightRequest="44" CornerRadius="9"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Grid>
                            <ActivityIndicator IsRunning="{Binding IsSearchingFood}"
                                               IsVisible="{Binding IsSearchingFood}" />
                            <Label
                                Text="{Binding FoodSearchStatus, Converter={StaticResource LocalizedStringConverter}}"
                                FontSize="11" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding FoodSearchResults}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="uiModels:QuickFoodItemUiModel">
                                        <nutritionControls:QuickFoodItemRow />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Multi-Add Floating Action Bar -->
                            <Border IsVisible="{Binding HasSelectedQuickFoods}"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                    Stroke="{StaticResource Primary}"
                                    StrokeThickness="1.5"
                                    Padding="10,8"
                                    Margin="0,4,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <Button Text="{Binding SelectedQuickFoodsSummaryText}"
                                            Command="{Binding BatchLogSelectedFoodsCommand}"
                                            HeightRequest="46" CornerRadius="12"
                                            FontAttributes="Bold" FontSize="13"
                                            BackgroundColor="{StaticResource PrimaryDark}" TextColor="{StaticResource White}" />
                                    <Button Grid.Column="1" Text="{loc:LocalizedText Common_Cancel}"
                                            Command="{Binding ClearQuickFoodSelectionCommand}"
                                            HeightRequest="46" CornerRadius="12"
                                            Style="{StaticResource ButtonSecondary}" Padding="12,0" FontSize="12" />
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="⚡ Quick Add" Command="{Binding OpenQuickAddCaloriesCommand}"
                                        HeightRequest="40" CornerRadius="9"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray800}}"
                                        TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" />
                                <Button Grid.Column="1" Text="{loc:LocalizedText Nutrition_FoodLog_AddFoodManually}" Command="{Binding UseManualFoodCommand}"
                                        HeightRequest="40" CornerRadius="9"
                                        BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource White}" />
                            </Grid>
                            <Button Text="{loc:LocalizedText Nutrition_Recipe_Create}"
                                    Style="{StaticResource ButtonSecondary}" IsVisible="{Binding CanCreateRecipes}"
                                    Command="{Binding OpenRecipeBuilderCommand}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding IsRecipeBuilderVisible}"
                                             IsEnabled="{Binding IsWriting, Converter={StaticResource InvertedBoolConverter}}"
                                             Spacing="{StaticResource RecipeBuilderSectionSpacing}">
                            <Label Text="{loc:LocalizedText Nutrition_Recipe_Title}" Style="{StaticResource SubHeadline}" />
                            <VerticalStackLayout Spacing="{StaticResource RecipeBuilderFieldSpacing}">
                                <Label Text="{loc:LocalizedText Nutrition_Recipe_Name}" />
                                <Entry Text="{Binding RecipeName}" Keyboard="Default"
                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_Recipe_Name}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="{StaticResource RecipeBuilderFieldSpacing}">
                                <Label Text="{loc:LocalizedText Nutrition_Recipe_Servings}" />
                                <Entry Text="{Binding RecipeServingsText}" Keyboard="Numeric"
                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_Recipe_Servings}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="{StaticResource RecipeBuilderFieldSpacing}">
                                <Label Text="{loc:LocalizedText Nutrition_Recipe_CookedWeightOptional}" />
                                <Entry Text="{Binding RecipeCookedWeightText}" Keyboard="Numeric"
                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_Recipe_CookedWeightOptional}" />
                            </VerticalStackLayout>
                            <Label Text="{loc:LocalizedText Nutrition_Recipe_TotalNutrientsHint}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecipeEditorIngredients}"
                                                 Spacing="{StaticResource RecipeBuilderSectionSpacing}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="uiModels:RecipeIngredientEditor">
                                        <VerticalStackLayout Spacing="{StaticResource RecipeBuilderFieldSpacing}">
                                            <VerticalStackLayout Spacing="{StaticResource RecipeBuilderFieldSpacing}">
                                                <Label Text="{loc:LocalizedText Nutrition_Recipe_IngredientName}" />
                                                <Entry Text="{Binding Name}" Keyboard="Default"
                                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_Recipe_IngredientName}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="{StaticResource RecipeBuilderFieldSpacing}">
                                                <Label Text="{loc:LocalizedText Nutrition_Recipe_Grams}" />
                                                <Entry Text="{Binding Grams}" Keyboard="Numeric"
                                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_Recipe_Grams}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="{StaticResource RecipeBuilderFieldSpacing}">
                                                <Label Text="{loc:LocalizedText Nutrition_Recipe_Calories}" />
                                                <Entry Text="{Binding Calories}" Keyboard="Numeric"
                                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_Recipe_Calories}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="{StaticResource RecipeBuilderFieldSpacing}">
                                                <Label Text="{loc:LocalizedText Nutrition_Recipe_Protein}" />
                                                <Entry Text="{Binding Protein}" Keyboard="Numeric"
                                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_Recipe_Protein}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="{StaticResource RecipeBuilderFieldSpacing}">
                                                <Label Text="{loc:LocalizedText Nutrition_Recipe_Carbs}" />
                                                <Entry Text="{Binding Carbs}" Keyboard="Numeric"
                                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_Recipe_Carbs}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="{StaticResource RecipeBuilderFieldSpacing}">
                                                <Label Text="{loc:LocalizedText Nutrition_Recipe_Fats}" />
                                                <Entry Text="{Binding Fats}" Keyboard="Numeric"
                                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_Recipe_Fats}" />
                                            </VerticalStackLayout>
                                            <Button Text="{loc:LocalizedText Nutrition_Recipe_RemoveIngredient}"
                                                    Style="{StaticResource ButtonSecondary}"
                                                    Command="{Binding RemoveRecipeIngredientCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                                    CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Button Text="{loc:LocalizedText Nutrition_Recipe_AddIngredient}"
                                    Style="{StaticResource ButtonSecondary}" Command="{Binding AddRecipeIngredientCommand}" />
                            <Label Text="{Binding RecipeEditorStatus, Converter={StaticResource LocalizedStringConverter}}"
                                   SemanticProperties.Description="{Binding RecipeEditorStatus, Converter={StaticResource LocalizedStringConverter}}" />
                            <Label Text="{Binding RecipePreviewSummary}" IsVisible="{Binding HasRecipePreview}" />
                            <Button Text="{loc:LocalizedText Nutrition_Recipe_Preview}"
                                    Style="{StaticResource ButtonSecondary}" Command="{Binding PreviewRecipeCommand}" />
                            <Button Text="{loc:LocalizedText Nutrition_Recipe_Save}" IsEnabled="{Binding HasRecipePreview}"
                                    Command="{Binding SaveRecipeCommand}" />
                            <Button Text="{loc:LocalizedText Common_Cancel}"
                                    Style="{StaticResource ButtonSecondary}" Command="{Binding CancelRecipeBuilderCommand}" />
                        </VerticalStackLayout>

                        <!-- Quick Add Calories View -->
                        <VerticalStackLayout IsVisible="{Binding IsQuickAddCaloriesVisible}" Spacing="14"
                                             IsEnabled="{Binding IsWriting, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="Quick Calorie &amp; Macro Add" FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="Quickly log calories and macros without searching the database." FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                            <!-- Quick Calories -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Calories (kcal) *" FontSize="12" FontAttributes="Bold" />
                                <Entry Text="{Binding QuickCaloriesValue}" Placeholder="200" Keyboard="Numeric"
                                       HeightRequest="44" FontSize="16" FontAttributes="Bold" />
                            </VerticalStackLayout>

                            <!-- Optional Description -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Description (Optional)" FontSize="12" FontAttributes="Bold" />
                                <Entry Text="{Binding QuickCaloriesName}" Placeholder="Quick Calorie Add" HeightRequest="44" FontSize="14" />
                            </VerticalStackLayout>

                            <!-- Optional Macros Split -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Protein (g)" FontSize="12" FontAttributes="Bold" />
                                    <Entry Text="{Binding QuickProteinValue}" Placeholder="0" Keyboard="Numeric" HeightRequest="44" FontSize="14" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Carbs (g)" FontSize="12" FontAttributes="Bold" />
                                    <Entry Text="{Binding QuickCarbsValue}" Placeholder="0" Keyboard="Numeric" HeightRequest="44" FontSize="14" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Label Text="Fat (g)" FontSize="12" FontAttributes="Bold" />
                                    <Entry Text="{Binding QuickFatValue}" Placeholder="0" Keyboard="Numeric" HeightRequest="44" FontSize="14" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Actions -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                                <Button Text="Cancel" Command="{Binding CancelQuickAddCaloriesCommand}"
                                        HeightRequest="44" CornerRadius="9"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Button Grid.Column="1" Text="Log Calories" Command="{Binding SaveQuickCaloriesCommand}"
                                        HeightRequest="44" CornerRadius="9"
                                        BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource White}" FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Manual local barcode lookup -->
                        <VerticalStackLayout IsVisible="{Binding IsBarcodeScannerVisible}" Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{loc:LocalizedText Nutrition_FoodLog_ManualBarcodeLookup}" FontSize="16" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="✕" Command="{Binding CloseBarcodeScannerCommand}"
                                        HeightRequest="32" WidthRequest="32" Padding="0" CornerRadius="16"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            </Grid>

                            <Label Text="{loc:LocalizedText Nutrition_FoodLog_LocalBarcodeOnly}" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                            <Label Text="{Binding BarcodeScanStatus, Converter={StaticResource LocalizedStringConverter}}"
                                   FontSize="12" HorizontalOptions="Center" TextColor="{StaticResource PrimaryDark}" />

                            <ActivityIndicator IsRunning="{Binding IsProcessingBarcode}" IsVisible="{Binding IsProcessingBarcode}" />

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{loc:LocalizedText Nutrition_FoodLog_EnterBarcode}" FontSize="12" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Entry Text="{Binding BarcodeInputText}" Placeholder="{loc:LocalizedText Nutrition_FoodLog_BarcodeExample}"
                                           SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_EnterBarcode}" Keyboard="Numeric"
                                           HeightRequest="44" FontSize="14" />
                                    <Button Grid.Column="1" Text="{loc:LocalizedText Nutrition_FoodLog_BarcodeLookup}"
                                            SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_BarcodeLookup}"
                                            Command="{Binding LookupBarcodeCommand}"
                                            CommandParameter="{Binding BarcodeInputText}"
                                            HeightRequest="44" CornerRadius="9"
                                            BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource White}" FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding IsManualEditorVisible}" Spacing="12"
                                             IsEnabled="{Binding IsWriting, Converter={StaticResource InvertedBoolConverter}}">

                            <Label Text="{loc:LocalizedText Nutrition_FoodLog_Category}" FontSize="14" />
                            <Picker ItemsSource="{Binding MealCategories}" SelectedItem="{Binding EditingMealType}"
                                    ItemDisplayBinding="{Binding ., Converter={StaticResource LocalizedStringConverter}}" />
                            <VerticalStackLayout IsVisible="{Binding IsGroupedEditor}" Spacing="8">
                                <Label Text="{loc:LocalizedText Nutrition_FoodLog_IngredientsGrams}" FontSize="14" FontAttributes="Bold" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding EditingIngredients}"
                                                     Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="uiModels:HistoryIngredientEditor">
                                            <Grid ColumnDefinitions="*,100" ColumnSpacing="12">
                                                <Label Text="{Binding Name}" VerticalOptions="Center" FontSize="14" />
                                                <Entry Grid.Column="1" Text="{Binding Grams}" Keyboard="Numeric"
                                                       MinimumHeightRequest="44"
                                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_IngredientPortionInGrams}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                            <Grid IsVisible="{Binding IsPlainFoodEditor}"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*"
                                  ColumnSpacing="10" RowSpacing="4">
                                <!-- Food Name -->
                                <Label Grid.Row="0" Grid.ColumnSpan="2" Text="{loc:LocalizedText Nutrition_FoodLog_FoodName}"
                                       FontSize="12" FontAttributes="Bold" />
                                <Entry
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding EditingItemName}"
                                    Placeholder="{loc:LocalizedText Nutrition_FoodLog_EGGreekYogurtZeroPercent}"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_FoodItemName}"
                                    FontSize="14"
                                    HeightRequest="42"
                                    Margin="0,0,0,8" />

                                <!-- Servings & Portion Size -->
                                <Label Grid.Row="2" Grid.Column="0" Text="{loc:LocalizedText Nutrition_FoodLog_Servings}"
                                       FontSize="12" FontAttributes="Bold" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{loc:LocalizedText Nutrition_FoodLog_PortionSizeLabel}"
                                       FontSize="12" FontAttributes="Bold" />
                                <Entry
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Text="{Binding EditingServingsCount}"
                                    Placeholder="1"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_ServingsCount}"
                                    Keyboard="Numeric"
                                    FontSize="14"
                                    HeightRequest="42"
                                    Margin="0,0,0,8" />
                                <Entry
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="{Binding EditingServingSize}"
                                    Placeholder="100"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_PortionSizeDescription}"
                                    Keyboard="Numeric"
                                    FontSize="14"
                                    HeightRequest="42"
                                    Margin="0,0,0,8" />

                                <!-- Calories & Protein -->
                                <Label Grid.Row="4" Grid.Column="0" Text="{loc:LocalizedText Nutrition_Label_CaloriesKcal}"
                                       FontSize="12" FontAttributes="Bold" />
                                <Label Grid.Row="4" Grid.Column="1" Text="{loc:LocalizedText Nutrition_Label_ProteinGrams}"
                                       FontSize="12" FontAttributes="Bold" />
                                <Entry
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Text="{Binding EditingCalories}"
                                    Placeholder="0"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_CaloriesInKilocalories}"
                                    Keyboard="Numeric"
                                    FontSize="14"
                                    HeightRequest="42"
                                    Margin="0,0,0,8" />
                                <Entry
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Text="{Binding EditingProtein}"
                                    Placeholder="0"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_ProteinInGrams}"
                                    Keyboard="Numeric"
                                    FontSize="14"
                                    HeightRequest="42"
                                    Margin="0,0,0,8" />

                                <!-- Carbs & Fat -->
                                <Label Grid.Row="6" Grid.Column="0" Text="{loc:LocalizedText Nutrition_Label_CarbsGrams}"
                                       FontSize="12" FontAttributes="Bold" />
                                <Label Grid.Row="6" Grid.Column="1" Text="{loc:LocalizedText Nutrition_Label_FatGrams}"
                                       FontSize="12" FontAttributes="Bold" />
                                <Entry
                                    Grid.Row="7"
                                    Grid.Column="0"
                                    Text="{Binding EditingCarbs}"
                                    Placeholder="0"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_CarbohydratesInGrams}"
                                    Keyboard="Numeric"
                                    FontSize="14"
                                    HeightRequest="42" />
                                <Entry
                                    Grid.Row="7"
                                    Grid.Column="1"
                                    Text="{Binding EditingFat}"
                                    Placeholder="0"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_FatInGrams}"
                                    Keyboard="Numeric"
                                    FontSize="14"
                                    HeightRequest="42" />
                            </Grid>
                            <!-- Action Buttons -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                                <Button
                                    Text="{loc:LocalizedText Common_Save}"
                                    Command="{Binding SaveFoodItemCommand}"
                                    HeightRequest="44"
                                    CornerRadius="10"
                                    FontAttributes="Bold"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource White}" />

                                <Button
                                    Grid.Column="1"
                                    Text="{loc:LocalizedText Common_Delete}"
                                    Command="{Binding DeleteFoodItemCommand}"
                                    HeightRequest="44"
                                    CornerRadius="10"
                                    FontAttributes="Bold"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                                    TextColor="{StaticResource White}"
                                    IsVisible="{Binding IsEditingExisting}" />

                                <Button
                                    Grid.Column="1"
                                    Text="{loc:LocalizedText Common_Cancel}"
                                    Command="{Binding CloseEditModalCommand}"
                                    HeightRequest="44"
                                    CornerRadius="10"
                                    BackgroundColor="Transparent"
                                    BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                                    BorderWidth="1"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    IsVisible="{Binding IsEditingExisting, Converter={StaticResource InvertedBoolConverter}}" />
                            </Grid>
                        </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.RowSpan="2"
            HorizontalOptions="Center"
            Margin="20,0,20,30"
            IsVisible="{Binding IsStatusVisible}"
            StrokeShape="RoundRectangle 12"
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}"
            Padding="16,10"
            InputTransparent="True">
            <Label
                Text="{Binding StatusMessage, Converter={StaticResource LocalizedStringConverter}}"
                FontSize="13"
                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
        </Border>

    </Grid>
</ContentPage>
