<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Nutrition.FoodLogPage"
    x:Name="FoodLogRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:dtos="clr-namespace:MuscleCuties.Core.Models.Nutrition;assembly=MuscleCuties.Core"
    xmlns:nutritionControls="clr-namespace:MuscleCuties.UI.Controls.Nutrition"
    xmlns:recipeDtos="clr-namespace:MuscleCuties.UseCases.Features.Nutrition.Recipes.Contracts;assembly=MuscleCuties.UseCases"
    xmlns:uiModels="clr-namespace:MuscleCuties.UI.Models.UI.Nutrition"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition"
    x:DataType="vm:FoodLogViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">


    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">

        <!-- Top Navigation Bar -->
        <Grid
            Grid.Row="0"
            Padding="{StaticResource UiInsets20_36_20_12}"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="{StaticResource UiSpacing10}"
            MaximumWidthRequest="{StaticResource UiDimension640}"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

            <Border
                Style="{StaticResource CircleIconButton}"
                SemanticProperties.Description="{loc:LocalizedText Common_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                </Border.GestureRecognizers>
                <Path
                    Data="M15 19l-7-7 7-7"
                    Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    StrokeThickness="{StaticResource UiStrokeWidth2}"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Aspect="Uniform"
                    WidthRequest="{StaticResource UiDimension14}"
                    HeightRequest="{StaticResource UiDimension14}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Label
                Grid.Column="1"
                Text="{loc:LocalizedText Nutrition_FoodLog_DailyFoodLog}"
                Style="{StaticResource SubHeadline}"
                FontSize="{StaticResource UiFontSize20}"
                VerticalOptions="Center" />

            <Button
                Grid.Column="2"
                Style="{StaticResource ButtonSecondary}"
                Text="{loc:LocalizedText Common_Today}"
                Command="{Binding JumpToTodayCommand}"
                VerticalOptions="Center"
                IsVisible="{Binding IsSelectedDateToday, Converter={StaticResource InvertedBoolConverter}}" />

            <Border
                Grid.Column="3"
                Style="{StaticResource CircleIconButton}"
                SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_OpenDatePicker}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleDatePickerCommand}" />
                </Border.GestureRecognizers>
                <Path
                    Data="M19 4H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V6a2 2 0 00-2-2zM16 2v4M8 2v4M3 10h18"
                    Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    StrokeThickness="{StaticResource UiStrokeWidth1_8}"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Aspect="Uniform"
                    WidthRequest="{StaticResource UiDimension16}"
                    HeightRequest="{StaticResource UiDimension16}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Main Virtualized Scroll Container (CollectionView, zero nested ScrollViews) -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding MealSections}"
            ItemSizingStrategy="MeasureFirstItem"
            MaximumWidthRequest="{StaticResource UiDimension640}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource UiSpacing14}" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}" Padding="{StaticResource UiInsets20_8_20_16}">

                    <Button Style="{StaticResource ButtonSecondary}" Text="{loc:LocalizedText Nutrition_FoodLog_RetryLoadingThisDay}" Command="{Binding RetryLoadCommand}"
                            IsVisible="{Binding IsLoadError}" />
                    <!-- Horizontal Rolling Date Strip Header -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="{StaticResource UiSpaceTight}" RowSpacing="{StaticResource UiSpaceTight}" VerticalOptions="Center">
                        <Border
                            Style="{StaticResource CircleIconButton}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PreviousDayCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M15 19l-7-7 7-7"
                                Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                StrokeThickness="{StaticResource UiStrokeWidth2}"
                                Aspect="Uniform"
                                WidthRequest="{StaticResource UiDimension12}"
                                HeightRequest="{StaticResource UiDimension12}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label Grid.Column="1"
                               Text="{Binding FormattedSelectedDate, Converter={StaticResource LocalizedStringConverter}}"
                               FontSize="{StaticResource UiFontSize16}" FontAttributes="{StaticResource UiFontAttributesBold}" HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />

                        <CollectionView
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            ItemsSource="{Binding DateStripDays}"
                            ItemSizingStrategy="MeasureFirstItem"
                            HeightRequest="{StaticResource UiDimension68}"
                            SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="{StaticResource UiSpaceTight}" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="uiModels:DateStripDayItem">
                                    <Border
                                        WidthRequest="{StaticResource UiDimension52}"
                                        HeightRequest="{StaticResource UiDimension64}"
                                        StrokeShape="{StaticResource UiRoundRectangleRadius14}"
                                        StrokeThickness="{StaticResource UiStrokeWidth1}"
                                        Stroke="{Binding IsSelected, Converter={StaticResource BoolToSelectionStrokeConverter}, FallbackValue=Transparent}"
                                        BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToSelectionBgConverter}, FallbackValue=Transparent}"
                                        Padding="{StaticResource UiInsets4_6}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectDateCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing2}" VerticalOptions="Center"
                                              HorizontalOptions="Center">
                                            <Label
                                                Grid.Row="0"
                                                Text="{Binding DayName, Converter={StaticResource LocalizedStringConverter}}"
                                                FontSize="{StaticResource UiFontSize11}"
                                                FontAttributes="{StaticResource UiFontAttributesBold}"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            <Label
                                                Grid.Row="1"
                                                Text="{Binding DayNumber, Converter={StaticResource LocalizedStringConverter}}"
                                                FontSize="{StaticResource UiFontSize17}"
                                                FontAttributes="{StaticResource UiFontAttributesBold}"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <BoxView
                                                Grid.Row="2"
                                                WidthRequest="{StaticResource UiDimension4}"
                                                HeightRequest="{StaticResource UiDimension4}"
                                                CornerRadius="{StaticResource UiCornerRadius2}"
                                                HorizontalOptions="Center"
                                                Color="{StaticResource Primary}"
                                                IsVisible="{Binding IsToday}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Border
                            Grid.Column="2"
                            Style="{StaticResource CircleIconButton}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NextDayCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M9 5l7 7-7 7"
                                Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                StrokeThickness="{StaticResource UiStrokeWidth2}"
                                Aspect="Uniform"
                                WidthRequest="{StaticResource UiDimension12}"
                                HeightRequest="{StaticResource UiDimension12}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Native Date Picker Trigger (Hidden unless toggled) -->
                    <Border
                        IsVisible="{Binding IsDatePickerOpen}"
                        Style="{StaticResource CardPrimary}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}">
                            <Border Style="{StaticResource InputContainer}">
                                <DatePicker
                                    Date="{Binding PickerDate}"
                                    Format="d" />
                            </Border>
                            <Button Style="{StaticResource ButtonSecondary}"
                                Grid.Column="1"
                                Text="{loc:LocalizedText Nutrition_FoodLog_Go}"
                                Command="{Binding DatePickerSelectedCommand}"
                                CommandParameter="{Binding PickerDate}" />
                        </Grid>
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource Primary}" HeightRequest="{StaticResource UiDimension24}" />

                    <!-- Selected Day Headline & Macro Vectors Card -->
                    <Border
                        Style="{StaticResource CardPrimary}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing14}">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                    <Label
                                        Grid.Row="0"
                                        Text="{Binding FormattedSelectedDate, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource SubHeadline}"
                                        FontSize="{StaticResource UiFontSize17}" />
                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding CalorieRemainingText, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource MutedLabel}" />
                                </Grid>

                                <HorizontalStackLayout Grid.Column="1" Spacing="{StaticResource UiSpaceMicro}" VerticalOptions="Center">
                                    <Label
                                        Text="{Binding TotalCalories, StringFormat='{0:F0}'}"
                                        FontSize="{StaticResource UiFontSize24}"
                                        FontAttributes="{StaticResource UiFontAttributesBold}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        Text="{Binding TargetCalories, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_Format_TargetCaloriesValueKcal}"
                                        FontSize="{StaticResource UiFontSize13}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        VerticalOptions="End"
                                        Margin="{StaticResource UiInsets0_0_0_3}" />
                                </HorizontalStackLayout>
                            </Grid>

                            <!-- Pure Vector Calorie Bar -->
                            <Grid Grid.Row="1" HeightRequest="{StaticResource UiDimension8}">
                                <Border
                                    StrokeShape="{StaticResource UiRoundRectangleRadius4}"
                                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                    HorizontalOptions="Fill" />
                                <ProgressBar
                                    Progress="{Binding CalorieProgressRatio}"
                                    ProgressColor="{StaticResource Primary}"
                                    HorizontalOptions="Fill" />
                            </Grid>

                            <!-- Macronutrient Split Bars -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource UiSpacing14}" Margin="{StaticResource UiInsets0_4_0_0}">
                                <!-- Protein -->
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="{StaticResource UiSpaceMicro}">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{loc:LocalizedText Nutrition_Macro_Protein}"
                                           FontSize="{StaticResource UiFontSize12}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding TotalProtein, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_ValueG}"
                                           FontSize="{StaticResource UiFontSize12}"
                                           FontAttributes="{StaticResource UiFontAttributesBold}" TextColor="{StaticResource PrimaryDark}" />
                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                 Progress="{Binding ProteinProgressRatio}"
                                                 ProgressColor="{StaticResource PrimaryDark}" HeightRequest="{StaticResource UiDimension4}" />
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding TargetProtein, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_TargetValueG}"
                                           FontSize="{StaticResource UiFontSize11}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>

                                <!-- Carbs -->
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                                      RowSpacing="{StaticResource UiSpaceMicro}">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{loc:LocalizedText Nutrition_Macro_Carbs}"
                                           FontSize="{StaticResource UiFontSize12}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding TotalCarbs, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_ValueG}"
                                           FontSize="{StaticResource UiFontSize12}"
                                           FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource WarningAccentLight}, Dark={StaticResource WarningAccentDark}}" />
                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                 Progress="{Binding CarbsProgressRatio}"
                                                 ProgressColor="{AppThemeBinding Light={StaticResource WarningAccentLight}, Dark={StaticResource WarningAccentDark}}"
                                                 HeightRequest="{StaticResource UiDimension4}" />
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding TargetCarbs, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_TargetValueG}"
                                           FontSize="{StaticResource UiFontSize11}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>

                                <!-- Fat -->
                                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                                      RowSpacing="{StaticResource UiSpaceMicro}">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{loc:LocalizedText Nutrition_Macro_Fat}"
                                           FontSize="{StaticResource UiFontSize12}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding TotalFat, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_ValueG}"
                                           FontSize="{StaticResource UiFontSize12}"
                                           FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                 Progress="{Binding FatProgressRatio}"
                                                 ProgressColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}"
                                                 HeightRequest="{StaticResource UiDimension4}" />
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding TargetFat, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_TargetValueG}"
                                           FontSize="{StaticResource UiFontSize11}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>
                            </Grid>

                            <!-- Water Tracker Row -->
                            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource UiSpacing10}" Margin="{StaticResource UiInsets0_4_0_0}"
                                  VerticalOptions="Center">
                                <Label Text="{loc:LocalizedText Nutrition_FoodLog_Water}" FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding WaterIntakeMl, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_ValueMl}"
                                       FontSize="{StaticResource UiFontSize13}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource ButtonSecondary}"
                                        Text="{loc:LocalizedText Nutrition_FoodLog_SubtractWaterTwoFiftyMl}"
                                        Command="{Binding RemoveWaterCommand}"
                                        CommandParameter="{x:Int32 250}" />
                                <Button Grid.Column="3"
                                        Style="{StaticResource ButtonSecondary}"
                                        Text="{loc:LocalizedText Nutrition_FoodLog_AddWaterTwoFiftyMl}"
                                        Command="{Binding AddWaterCommand}"
                                        CommandParameter="{x:Int32 250}" />
                            </Grid>

                            <!-- Quick Diary Actions Row -->
                            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="{StaticResource UiInsets0_2_0_0}">
                                <Label
                                    Text="Yesterday's diary"
                                    FontSize="{StaticResource UiFontSize12}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    VerticalOptions="Center" />
                                <Border
                                    Grid.Column="1"
                                    Style="{StaticResource PillBadge}"
                                    VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CopyYesterdayDiaryCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="Copy yesterday"
                                        FontSize="{StaticResource UiFontSize11}"
                                        FontAttributes="{StaticResource UiFontAttributesBold}"
                                        TextColor="{StaticResource PrimaryDark}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Meal Section ItemTemplate (Breakfast, Lunch, Dinner, Snacks) -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="uiModels:MealSectionUiGroup">
                    <Border
                        Style="{StaticResource CardPrimary}"
                        Margin="{StaticResource UiInsets16_0}">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpaceTight}">
                            <!-- Section Header Row -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{StaticResource UiSpacing10}">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                    <Label
                                        Grid.Row="0"
                                        Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                        FontSize="{StaticResource UiFontSize17}"
                                        FontAttributes="{StaticResource UiFontAttributesBold}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding SummaryText, Converter={StaticResource LocalizedStringConverter}}"
                                        FontSize="{StaticResource UiFontSize12}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>

                                <Border
                                    Grid.Column="1"
                                    Style="{StaticResource ModalIconButton}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_AddFoodToMeal}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding OpenAddFoodCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                            CommandParameter="{Binding MealType}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="+" FontSize="{StaticResource UiFontSize18}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{StaticResource PrimaryDark}"
                                           HorizontalOptions="Center" VerticalOptions="Center" Margin="{StaticResource UiInsets0_Minus2_0_0}" />
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    WidthRequest="{StaticResource UiDimension32}"
                                    HeightRequest="{StaticResource UiDimension32}"
                                    StrokeShape="{StaticResource UiRoundRectangleRadius16}"
                                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasItems}"
                                    SemanticProperties.Description="Save meal as template">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SaveMealAsTemplateCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                            CommandParameter="{Binding MealType}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="★" FontSize="{StaticResource UiFontSize13}"
                                           TextColor="{StaticResource PrimaryDark}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <Border
                                    Grid.Column="3"
                                    WidthRequest="{StaticResource UiDimension32}"
                                    HeightRequest="{StaticResource UiDimension32}"
                                    StrokeShape="{StaticResource UiRoundRectangleRadius16}"
                                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                                    BackgroundColor="{StaticResource Transparent}"
                                    VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding ToggleMealSectionCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="{Binding IsExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                        FontSize="{StaticResource UiFontSize17}"
                                        FontAttributes="{StaticResource UiFontAttributesBold}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Border>
                            </Grid>

                            <!-- Items in Meal -->
                            <VerticalStackLayout
                                Grid.Row="1"
                                IsVisible="{Binding IsExpanded}"
                                Spacing="{StaticResource UiSpacing6}"
                                Margin="{StaticResource UiInsets0_4_0_0}"
                                BindableLayout.ItemsSource="{Binding Items}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:FoodItemEntryDto">
                                        <Border
                                            Style="{StaticResource CardAccent}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenEditFoodCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                                <Label
                                                    Text="{Binding Name}"
                                                    FontSize="{StaticResource UiFontSize15}"
                                                    FontAttributes="{StaticResource UiFontAttributesBold}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                <Label
                                                    Grid.Row="1"
                                                    Text="{Binding ServingsCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_ValueServ}"
                                                    FontSize="{StaticResource UiFontSize12}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding Calories, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_Format_CaloriesValueKcal}"
                                                    FontSize="{StaticResource UiFontSize15}"
                                                    FontAttributes="{StaticResource UiFontAttributesBold}"
                                                    HorizontalTextAlignment="End"
                                                    TextColor="{StaticResource PrimaryDark}" />
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Text="{Binding Protein, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_FoodLog_ValueGP}"
                                                    FontSize="{StaticResource UiFontSize11}"
                                                    HorizontalTextAlignment="End"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Empty State for Section with Copy Yesterday -->
                            <Grid
                                Grid.Row="2"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="{StaticResource UiSpaceTight}"
                                Margin="{StaticResource UiInsets4_2}"
                                IsVisible="{Binding HasItems, Converter={StaticResource InvertedBoolConverter}}">
                                <Label
                                    Text="{loc:LocalizedText Nutrition_FoodLog_NoFoodsLoggedYetTapTo}"
                                    FontSize="{StaticResource UiFontSize12}"
                                    FontAttributes="{StaticResource UiFontAttributesItalic}"
                                    VerticalOptions="Center"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Border
                                    Style="{StaticResource PillBadge}"
                                    VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding CopyYesterdayMealCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                            CommandParameter="{Binding MealType}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="Copy yesterday"
                                        FontSize="{StaticResource UiFontSize11}"
                                        FontAttributes="{StaticResource UiFontAttributesBold}"
                                        TextColor="{StaticResource PrimaryDark}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Grid HeightRequest="{StaticResource UiDimension40}" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Inline Tap-To-Edit Modal Sheet (Optimistic UI) -->
        <Grid
            Grid.RowSpan="2"
            IsVisible="{Binding IsEditModalVisible}">
            <BoxView Style="{StaticResource ModalBackdrop}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseEditModalCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                x:Name="EditSheetSurface"
                Style="{StaticResource ModalSurface}" VerticalOptions="End">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer /> <!-- Absorb tap inside dialog -->
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto,*">
                    <Grid Padding="{StaticResource UiInsets20_18_20_14}" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}">
                            <Label
