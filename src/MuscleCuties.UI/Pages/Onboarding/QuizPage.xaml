<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Onboarding.QuizPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:quizModels="clr-namespace:MuscleCuties.UI.Models.UI.Quiz"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Quiz"
    x:DataType="vm:QuizViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False">


    <Grid>
        <!-- Dashboard prep overlay -->
        <Grid
            Padding="{StaticResource UiInsets24}"
            IsVisible="{Binding IsPreparingWorkoutPreferences}"
            ZIndex="10"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="{StaticResource UiSpaceControl}"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Image
                    Grid.Row="0"
                    Source="{AppThemeBinding Light=musclecuties_logo_light_transparent.png, Dark=musclecuties_logo_dark_transparent.png}"
                    Aspect="AspectFit"
                    WidthRequest="{StaticResource UiDimension152}"
                    HeightRequest="{StaticResource UiDimension84}"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{loc:LocalizedText Common_MuscleCutiesLogo}" />
                <ActivityIndicator
                        Style="{StaticResource StateBusyInline}"
                    Grid.Row="1"
                   
                    IsRunning="{Binding IsPreparingWorkoutPreferences}"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{loc:LocalizedText Onboarding_Quiz_PreparingWorkoutPreferencesDescription}" />
                <Label
                    Grid.Row="2"
                    Text="{loc:LocalizedText Onboarding_Quiz_PreparingWorkoutPreferencesText}"
                    Style="{StaticResource MutedCentered}"
                    LineBreakMode="WordWrap" />
            </Grid>
        </Grid>

        <!-- Loading state -->
        <Grid
            Padding="{StaticResource UiInsets24}"
            IsVisible="{Binding IsLoadingVisible}">
            <Grid
                RowDefinitions="Auto,Auto"
                RowSpacing="{StaticResource UiSpacing10}"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <ActivityIndicator
                        Style="{StaticResource StateBusyInline}"
                    Grid.Row="0"
                   
                    IsRunning="{Binding IsLoadingVisible}"
                    SemanticProperties.Description="{loc:LocalizedText Onboarding_Quiz_LoadingQuestions}" />
                <Label
                    Grid.Row="1"
                    Text="{loc:LocalizedText Onboarding_Quiz_GettingQuestionsReady}"
                    Style="{StaticResource MutedCentered}"
                    LineBreakMode="WordWrap" />
            </Grid>
        </Grid>

        <!-- Empty / error state -->
        <Grid
            Padding="{StaticResource UiInsets28}"
            IsVisible="{Binding IsEmptyStateVisible}">
            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="{StaticResource UiSpaceCompact}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="{StaticResource UiDimension400}">
                <Label
                    Grid.Row="0"
                    Text="{Binding QuestionsStateTitle, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource StateEmptyTitle}"
                    LineBreakMode="WordWrap"
                    HorizontalTextAlignment="Center"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Grid.Row="1"
                    Text="{Binding QuestionsStateMessage, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource StateEmptyBody}"
                    LineBreakMode="WordWrap"
                    SemanticProperties.Description="{Binding QuestionsStateMessage, Converter={StaticResource LocalizedStringConverter}}" />
                <Button Style="{StaticResource ButtonPrimary}"
                    Grid.Row="2"
                    Text="{loc:LocalizedText Common_TryAgain}"
                    Command="{Binding RetryLoadQuestionsCommand}"
                    IsVisible="{Binding CanRetryQuestionsLoad}"
                    Margin="{StaticResource UiInsets0_8_0_0}"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{loc:LocalizedText Onboarding_Quiz_RetryLoadingQuestions}"
                    SemanticProperties.Hint="{loc:LocalizedText Onboarding_Quiz_DoubleTapToReloadTheQuiz}" />
                <Button Style="{StaticResource ButtonSecondary}"
                    Grid.Row="3"
                    Text="{loc:LocalizedText Onboarding_Quiz_GoBackToProfile}"
                    Clicked="OnEditProfileClicked"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{loc:LocalizedText Onboarding_Quiz_GoBackToProfile}" />
            </Grid>
        </Grid>

        <!-- Main quiz layout -->
        <Grid
            RowDefinitions="Auto,*,Auto"
            IsVisible="{Binding IsLayoutVisible}">

            <Grid
                Grid.Row="0"
                Padding="{DynamicResource PresentationPageHeaderPadding}"
                MaximumWidthRequest="{StaticResource UiDimension640}"
                HorizontalOptions="Fill">
                <sharedControls:PageHeader
                    Title="{Binding CurrentQuestionText, Converter={StaticResource LocalizedStringConverter}}"
                    ShowBack="False">
                    <sharedControls:PageHeader.EyebrowContent>
                        <VerticalStackLayout
                            Spacing="{StaticResource UiSpaceTight}"
                            Margin="{StaticResource UiInsets0_0_0_12}">
                            <!-- Step indicator + progress bar -->
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceTight}">
                                <FlexLayout Grid.Row="0" Direction="Row" Wrap="Wrap" AlignItems="Center" JustifyContent="SpaceBetween">
                                    <Border Style="{StaticResource PillBadge}" VerticalOptions="Center" Margin="{StaticResource UiInsets0_0_8_0}">
                                        <Label
                                            Text="{loc:LocalizedText Onboarding_Quiz_StepTwoOfTwo}"
                                            Style="{StaticResource EyebrowLabel}"
                                            LineBreakMode="WordWrap"
                                            VerticalOptions="Center"
                                            SemanticProperties.Description="{loc:LocalizedText Onboarding_Quiz_StepTwoOfTwoPersonalizedQuestions}" />
                                    </Border>
                                    <Button
                                            Text="{loc:LocalizedText Onboarding_Quiz_GoBackToProfile}"
                                            Style="{StaticResource ButtonSecondary}"
                                            Clicked="OnEditProfileClicked"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                            IsVisible="{Binding AccountCreatedNeedsLogin, Converter={StaticResource InvertedBoolConverter}}"
                                            SemanticProperties.Description="{loc:LocalizedText Onboarding_Quiz_GoBackToProfile}" />
                                </FlexLayout>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}">
                                    <ProgressBar
                                        Grid.Column="0"
                                        Progress="{Binding ProgressValue}"
                                        ProgressColor="{StaticResource Primary}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}"
                                        HeightRequest="{StaticResource UiDimension6}"
                                        VerticalOptions="Center"
                                        SemanticProperties.Description="{Binding ProgressText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Onboarding_Quiz_QuizProgressValue}" />
                                    <Border Grid.Column="1" Style="{StaticResource PillBadge}" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding ProgressText, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource AccentLabel}"
                                            LineBreakMode="WordWrap"
                                            VerticalOptions="Center"
                                            SemanticProperties.Description="{Binding ProgressText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Onboarding_Quiz_QuestionValue}" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </VerticalStackLayout>
                    </sharedControls:PageHeader.EyebrowContent>
                    <sharedControls:PageHeader.TitleIcon>
                        <Border
                            sharedControls:AccessibilityDecoration.HideAtAccessibilitySize="True"
                            AutomationProperties.IsInAccessibleTree="False"
                            WidthRequest="{StaticResource PresentationDecorativeIconSize}"
                            HeightRequest="{StaticResource PresentationDecorativeIconSize}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeThickness="{StaticResource UiStrokeWidth0}"
                            StrokeShape="{StaticResource UiRoundRectangleRadius12}"
                            VerticalOptions="Start">
                            <Image
                                Source="{Binding CurrentQuestionIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                WidthRequest="{StaticResource UiDimension20}"
                                HeightRequest="{StaticResource UiDimension20}"
                                Aspect="AspectFit"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </sharedControls:PageHeader.TitleIcon>
                </sharedControls:PageHeader>
            </Grid>

            <!-- Standard answer list -->
            <ScrollView
                Grid.Row="1"
                MaximumWidthRequest="{StaticResource UiDimension640}"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsStandardAnswerListVisible}">
                <VerticalStackLayout
                    Padding="{DynamicResource PresentationFormPagePadding}"
                    Spacing="{StaticResource UiSpaceCompact}">
                    <Label
                        Text="{loc:LocalizedText Profile_WorkoutPrefs_AvailableWeekdaysHint}"
                        Style="{StaticResource MutedLabel}"
                        LineBreakMode="WordWrap"
                        IsVisible="{Binding IsCurrentQuestionAvailableWeekdays}" />
                    <Label
                        Text="{loc:LocalizedText Onboarding_Quiz_MultiSelectHint}"
                        Style="{StaticResource MutedLabel}"
                        LineBreakMode="WordWrap"
                        IsVisible="{Binding IsCurrentQuestionDietaryPreference}" />
                    <!-- Gate 60: bodyweight-only and home equipment options are available; honest limitations are disclosed. -->
                    <Label
                        Text="{loc:LocalizedText Workout_Generation_QuizEquipmentNotice}"
                        Style="{StaticResource MutedLabel}"
                        LineBreakMode="WordWrap"
                        IsVisible="{Binding IsCurrentQuestionEquipment}" />
                    <VerticalStackLayout
                        Spacing="{StaticResource UiSpacing10}"
                        BindableLayout.ItemsSource="{Binding CurrentAnswers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="quizModels:SelectableQuizAnswer">
                            <sharedControls:SelectionCell
                                Style="{StaticResource CardSecondary}"
                                AutomationId="{Binding AutomationId}"
                                MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                IsSelected="{Binding IsSelected}"
                                SemanticProperties.Description="{Binding Answer.Text, Converter={StaticResource LocalizedStringConverter}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAnswerTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}">
                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="{StaticResource UiDimension36}"
                                        HeightRequest="{StaticResource UiDimension36}"
                                        StrokeShape="{StaticResource UiRoundRectangleRadius12}"
                                        StrokeThickness="{StaticResource UiStrokeWidth0}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource AccentSurfaceDeepDark}}"
                                        VerticalOptions="Center">
                                        <Image
                                            Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                            WidthRequest="{StaticResource UiDimension18}"
                                            HeightRequest="{StaticResource UiDimension18}"
                                            Aspect="AspectFit"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Answer.Text, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource AccentLabel}"
                                        LineBreakMode="WordWrap"
                                        VerticalOptions="Center" />

                                    <Grid Grid.Column="2" VerticalOptions="Center">
                                        <Border Style="{StaticResource SelectionRadioRing}"
                                                IsVisible="{Binding IsCurrentQuestionMultiAnswer, Source={RelativeSource AncestorType={x:Type vm:QuizViewModel}}, x:DataType=vm:QuizViewModel, Converter={StaticResource InvertedBoolConverter}}">
                                            <BoxView
                                                WidthRequest="{StaticResource UiDimension8}"
                                                HeightRequest="{StaticResource UiDimension8}"
                                                CornerRadius="{StaticResource UiCornerRadius4}"
                                                Color="{StaticResource ContrastInk}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding IsSelected}" />
                                        </Border>
                                        <Border Style="{StaticResource SelectionCheckbox}"
                                                IsVisible="{Binding IsCurrentQuestionMultiAnswer, Source={RelativeSource AncestorType={x:Type vm:QuizViewModel}}, x:DataType=vm:QuizViewModel}">
                                            <Path Data="M5 12L10 17L19 7"
                                                  Style="{StaticResource PlanChoiceCheckmark}"
                                                  IsVisible="{Binding IsSelected}" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </sharedControls:SelectionCell>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" IsVisible="{Binding IsCurrentQuestionGoal}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpaceCompact}"
                              MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}">
                            <CheckBox x:Name="OnboardingGluteFocusCheckBox"
                                      AutomationId="OnboardingGluteFocusCheckBox"
                                      IsChecked="{Binding GluteFocus, Mode=TwoWay}"
                                      VerticalOptions="Center"
                                      SemanticProperties.Description="{loc:LocalizedText Profile_WorkoutPrefs_GluteFocus}" />
                            <Label Grid.Column="1" Text="{loc:LocalizedText Profile_WorkoutPrefs_GluteFocus}"
                                   Style="{StaticResource BodyLabel}" VerticalOptions="Center" LineBreakMode="WordWrap"
                                   AutomationProperties.IsInAccessibleTree="False">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGluteFocusLabelTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <Label Text="{loc:LocalizedText Onboarding_Quiz_GluteFocusHint}"
                               Style="{StaticResource CaptionLabel}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <Label
                        Text="{Binding SelectedWeekdayCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Profile_WorkoutPrefs_SelectedWeekdaysFormat}"
                        Style="{StaticResource MutedCentered}"
                        LineBreakMode="WordWrap"
                        IsVisible="{Binding IsCurrentQuestionAvailableWeekdays}" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- Phase pair sliders -->
            <ScrollView
                Grid.Row="1"
                MaximumWidthRequest="{StaticResource UiDimension640}"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsPhasePairVisible}">
                <Grid Padding="{DynamicResource PresentationFormPagePadding}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpaceCompact}">
                    <Label
                        Grid.Row="0"
                        Text="{Binding CurrentPhasePairHelperText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource MutedLabel}"
                        LineBreakMode="WordWrap"
                        IsVisible="{Binding CurrentPhasePairHelperText, Converter={StaticResource StringToBoolConverter}}" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}">
                        <Label
                            Text="{loc:LocalizedText Onboarding_Quiz_Discomfort}"
                            Style="{StaticResource CardTitle}"
                            LineBreakMode="WordWrap"
                            SemanticProperties.HeadingLevel="Level2" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding PainSliderLabel, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource AccentLabel}"
                            LineBreakMode="WordWrap" />
                    </Grid>
                    <Slider
                        Grid.Row="2"
                        Minimum="1"
                        Maximum="5"
                        Value="{Binding PainSliderValue, Mode=TwoWay}"
                        MinimumTrackColor="{StaticResource Primary}"
                        MaximumTrackColor="{AppThemeBinding Light={StaticResource TrackSubtleLight}, Dark={StaticResource TrackSubtleDark}}"
                        ThumbColor="{StaticResource Primary}"
                        MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                        SemanticProperties.Description="{Binding PainSliderLabel, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Onboarding_Quiz_DiscomfortLevelValue}"
                        SemanticProperties.Hint="{loc:LocalizedText Onboarding_Quiz_OneIsSevereFiveIsNone}" />
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
                        <Label Text="{loc:LocalizedText Onboarding_Quiz_Severe}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" />
                        <Label Grid.Column="2" Text="{loc:LocalizedText Onboarding_Quiz_None}"
                               Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" HorizontalTextAlignment="End" />
                    </Grid>

                    <BoxView
                        Grid.Row="4"
                        HeightRequest="{StaticResource UiDimension1}"
                        Margin="{StaticResource UiInsets0_12_0_0}"
                        Opacity="{StaticResource UiOpacitySubtle}"
                        Color="{AppThemeBinding Light={StaticResource DividerSubtleLight}, Dark={StaticResource DividerSubtleDark}}" />

                    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}">
                        <Label
                            Text="{loc:LocalizedText Onboarding_Quiz_TrainingEnergy}"
                            Style="{StaticResource CardTitle}"
                            LineBreakMode="WordWrap"
                            SemanticProperties.HeadingLevel="Level2" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding EnergySliderLabel, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource AccentLabel}"
                            LineBreakMode="WordWrap" />
                    </Grid>
                    <Slider
                        Grid.Row="6"
                        Minimum="1"
                        Maximum="5"
                        Value="{Binding EnergySliderValue, Mode=TwoWay}"
                        MinimumTrackColor="{StaticResource Primary}"
                        MaximumTrackColor="{AppThemeBinding Light={StaticResource TrackSubtleLight}, Dark={StaticResource TrackSubtleDark}}"
                        ThumbColor="{StaticResource Primary}"
                        MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                        SemanticProperties.Description="{Binding EnergySliderLabel, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Onboarding_Quiz_TrainingEnergyLevelValue}"
                        SemanticProperties.Hint="{loc:LocalizedText Onboarding_Quiz_OneIsVeryLowFiveIs}" />
                    <Grid Grid.Row="7" ColumnDefinitions="Auto,*,Auto">
                        <Label Text="{loc:LocalizedText Onboarding_Quiz_VeryLow}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" />
                        <Label Grid.Column="2" Text="{loc:LocalizedText Onboarding_Quiz_Peak}"
                               Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" HorizontalTextAlignment="End" />
                    </Grid>
                </Grid>
            </ScrollView>

            <!-- Bottom navigation bar -->
            <Grid
                Grid.Row="2"
                Padding="{DynamicResource PresentationActionFooterPadding}"
                MaximumWidthRequest="{StaticResource UiDimension640}"
                HorizontalOptions="Fill"
                RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="{StaticResource UiSpaceCompact}">

                <Label
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource ErrorLabel}"
                    LineBreakMode="WordWrap"
                    IsVisible="{Binding HasError}"
                    Margin="{StaticResource UiInsets0_0_0_10}"
                    SemanticProperties.Description="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}">
                    <Label.Behaviors>
                        <sharedControls:ScreenReaderStatusAnnouncementBehavior />
                    </Label.Behaviors>
                </Label>

                <ActivityIndicator
                        Style="{StaticResource StateBusyInline}"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    HorizontalOptions="Center"
                    Margin="{StaticResource UiInsets0_0_0_10}"
                    SemanticProperties.Description="{loc:LocalizedText Onboarding_Quiz_ProcessingPleaseWait}" />

                <Button Style="{StaticResource ButtonPrimary}"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Text="{loc:LocalizedText Onboarding_Quiz_GoToLogIn}"
                    Command="{Binding GoToLoginCommand}"
                    IsVisible="{Binding AccountCreatedNeedsLogin}"
                    SemanticProperties.Description="{loc:LocalizedText Onboarding_Quiz_AccountSavedGoToLogIn}" />

                <Button
                    Grid.Row="3"
                    Grid.Column="0"
                    Style="{StaticResource ButtonSecondary}"
                    AutomationId="QuizBackButton"
                    Text="{loc:LocalizedText Common_Back}"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding ShowQuizBackButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    SemanticProperties.Description="{loc:LocalizedText Onboarding_Quiz_GoToPreviousQuestion}"
                    SemanticProperties.Hint="{loc:LocalizedText Onboarding_Quiz_DoubleTapToGoBack}" />

                <Button Style="{StaticResource ButtonPrimary}"
                    Grid.Row="3"
                    Grid.Column="1"
                    Text="{Binding NextButtonText, Converter={StaticResource LocalizedStringConverter}}"
                    Clicked="OnNextClicked"
                    AutomationId="QuizNextButton"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    IsVisible="{Binding AccountCreatedNeedsLogin, Converter={StaticResource InvertedBoolConverter}}"
                    SemanticProperties.Description="{Binding NextButtonText, Converter={StaticResource LocalizedStringConverter}}"
                    SemanticProperties.Hint="{loc:LocalizedText Onboarding_Quiz_DoubleTapToAdvanceToThe}" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
