<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Onboarding.ProfileSetupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:workoutControls="clr-namespace:MuscleCuties.UI.Controls.Workout"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Profile"
    x:DataType="vm:ProfileSetupViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <x:Double x:Key="ProfileSectionDividerThickness">1</x:Double>
        <x:Double x:Key="ProfileSectionHeadingSpacing">12</x:Double>
        <x:Double x:Key="ProfileMeasurementCardHeight">48</x:Double>
        <x:Double x:Key="ProfileMeasurementPickerHeight">56</x:Double>
        <x:Double x:Key="ProfileMeasurementSelectedStrokeThickness">1.5</x:Double>
        <Thickness x:Key="ProfileActivityDividerMargin">0,12,0,4</Thickness>
        <Thickness x:Key="ProfileMeasurementChoicePadding">12</Thickness>
        <Thickness x:Key="ProfileMeasurementPickerPadding">14,4</Thickness>
        <RoundRectangle x:Key="ProfileMeasurementCardShape" CornerRadius="14" />
        <Style x:Key="ProfileFieldSurface" TargetType="Border" BasedOn="{StaticResource InputContainer}">
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}" />
            <Setter Property="StrokeThickness" Value="0" />
        </Style>
        <Style x:Key="ProfileMeasurementChoiceSurface" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource ProfileMeasurementChoicePadding}" />
            <Setter Property="MinimumHeightRequest" Value="{StaticResource ProfileMeasurementCardHeight}" />
            <Setter Property="StrokeShape" Value="{StaticResource ProfileMeasurementCardShape}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}" />
            <Setter Property="Stroke"
                    Value="{AppThemeBinding Light={StaticResource ActivityUnselectedStrokeLight}, Dark={StaticResource Gray800}}" />
        </Style>
        <Style x:Key="ProfileMeasurementPickerSurface" TargetType="Border"
               BasedOn="{StaticResource ProfileMeasurementChoiceSurface}">
            <Setter Property="Padding" Value="{StaticResource ProfileMeasurementPickerPadding}" />
            <Setter Property="MinimumHeightRequest" Value="{StaticResource ProfileMeasurementPickerHeight}" />
            <Setter Property="StrokeThickness" Value="{StaticResource ProfileMeasurementSelectedStrokeThickness}" />
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource ActivitySelectedSurfaceLight}, Dark={StaticResource CardSurfaceDark}}" />
            <Setter Property="Stroke"
                    Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="24,24,24,36"
            Spacing="20"
            HorizontalOptions="Fill"
            MaximumWidthRequest="640">

            <!-- Step indicator -->
            <Border
                HorizontalOptions="Start"
                Padding="12,5"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 999"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}">
                <Label
                    Text="{loc:LocalizedText Onboarding_ProfileSetup_StepOneOfTwo}"
                    Style="{StaticResource EyebrowLabel}"
                    VerticalOptions="Center"
                    SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_StepOneOfTwoProfileSetup}" />
            </Border>

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="{loc:LocalizedText Onboarding_ProfileSetup_TellUsAboutYourself}"
                    Style="{StaticResource Headline}"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Text="{loc:LocalizedText Onboarding_ProfileSetup_ThisShapesYourFirstTrainingAnd}"
                    Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <Label
                    Text="{loc:LocalizedText Onboarding_ProfileSetup_PersonalDetails}"
                    Style="{StaticResource SectionTitle}"
                    SemanticProperties.HeadingLevel="Level2" />
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="20">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border
                            WidthRequest="80"
                            HeightRequest="80"
                            StrokeShape="RoundRectangle 40"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeThickness="0"
                            SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_ProfilePhotoOptionalDoubleTapTo}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProfileImageTapped" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Image Source="{Binding ProfileImageSource}" IsVisible="{Binding HasProfileImage}"
                                       Aspect="AspectFill" />
                                <Image
                                    IsVisible="{Binding HasNoProfileImage}"
                                    Source="{AppThemeBinding Light=musclecuties_logo_light_transparent.png, Dark=musclecuties_logo_dark_transparent.png}"
                                    Aspect="AspectFit"
                                    Margin="8" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2" VerticalOptions="Center">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                <Label Text="{loc:LocalizedText Onboarding_ProfileSetup_ProfilePhoto}" Style="{StaticResource CardTitle}" />
                                <Label Grid.Column="1" Text="{loc:LocalizedText Onboarding_ProfileSetup_Optional}"
                                       Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                            </Grid>
                            <Button
                                Grid.Row="1"
                                Text="{loc:LocalizedText Onboarding_ProfileSetup_ChooseFromPhotos}"
                                Style="{StaticResource ButtonLink}"
                                Padding="0"
                                HorizontalOptions="Start"
                                MinimumHeightRequest="44"
                                MinimumWidthRequest="44"
                                Clicked="OnProfileImageButtonClicked"
                                SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_ChooseAProfilePhotoFromPhotos}" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="6">
                        <Label Text="{loc:LocalizedText Profile_PersonalInfo_DisplayName}" Style="{StaticResource FormFieldLabel}" />
                        <Border Grid.Row="1" Style="{StaticResource ProfileFieldSurface}">
                            <Entry
                                AutomationId="ProfileSetupNameEntry"
                                Placeholder="{loc:LocalizedText Onboarding_ProfileSetup_YourName}"
                                Text="{Binding Name}"
                                MaxLength="50"
                                ReturnType="Done"
                                SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_DisplayNameOptional}"
                                SemanticProperties.Hint="{loc:LocalizedText Onboarding_ProfileSetup_ThisFieldIsOptionalEnterA}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="6">
                        <Label Text="{loc:LocalizedText Profile_PersonalInfo_Birthday}" Style="{StaticResource FormFieldLabel}" />
                        <DatePicker
                            Grid.Row="1"
                            AutomationId="ProfileSetupBirthDatePicker"
                            Date="{Binding BirthDate}"
                            DateSelected="OnBirthDateSelected"
                            MinimumDate="{Binding MinBirthDate}"
                            MaximumDate="{Binding MaxBirthDate}"
                            Format="d"
                            MinimumHeightRequest="56"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            SemanticProperties.Description="{loc:LocalizedText Profile_PersonalInfo_Birthday}"
                            SemanticProperties.Hint="{loc:LocalizedText Onboarding_ProfileSetup_SelectYourDateOfBirth}" />
                    </Grid>

                    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource ProfileSectionHeadingSpacing}">
                        <BoxView HeightRequest="{StaticResource ProfileSectionDividerThickness}"
                                 Opacity="0.6"
                                 Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />
                        <Label Grid.Row="1"
                               Text="{loc:LocalizedText Onboarding_ProfileSetup_Measurements}"
                               Style="{StaticResource SectionTitle}"
                               SemanticProperties.HeadingLevel="Level2" />
                    </Grid>

                    <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Text="{loc:LocalizedText Onboarding_ProfileSetup_Units}" Style="{StaticResource FormFieldLabel}" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border
                                Style="{StaticResource ProfileMeasurementChoiceSurface}"
                                SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_ImperialUnits}"
                                SemanticProperties.Hint="{loc:LocalizedText Onboarding_ProfileSetup_DoubleTapToSelectImperialUnits}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectImperialUnitsCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding UseImperialSystem}" Value="True">
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource ActivitySelectedSurfaceLight}, Dark={StaticResource CardSurfaceDark}}" />
                                        <Setter Property="Stroke"
                                                Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
                                        <Setter Property="StrokeThickness" Value="{StaticResource ProfileMeasurementSelectedStrokeThickness}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{loc:LocalizedText Common_Unit_Imperial}" Style="{StaticResource BodyLabel}"
                                       FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            </Border>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource ProfileMeasurementChoiceSurface}"
                                SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_MetricUnits}"
                                SemanticProperties.Hint="{loc:LocalizedText Onboarding_ProfileSetup_DoubleTapToSelectMetricUnits}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectMetricUnitsCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding UseMetricSystem}" Value="True">
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource ActivitySelectedSurfaceLight}, Dark={StaticResource CardSurfaceDark}}" />
                                        <Setter Property="Stroke"
                                                Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
                                        <Setter Property="StrokeThickness" Value="{StaticResource ProfileMeasurementSelectedStrokeThickness}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{loc:LocalizedText Common_Unit_Metric}" Style="{StaticResource BodyLabel}"
                                       FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="5" RowDefinitions="Auto,Auto" RowSpacing="6" IsVisible="{Binding UseMetricSystem}">
                        <Label Text="{loc:LocalizedText Common_Height}" Style="{StaticResource FormFieldLabel}" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Border Style="{StaticResource ProfileMeasurementPickerSurface}">
                                <Picker
                                    AutomationId="ProfileSetupMetricHeightPicker"
                                    Title="{loc:LocalizedText Onboarding_ProfileSetup_SelectHeight}"
                                    ItemsSource="{Binding MetricHeightOptions}"
                                    SelectedItem="{Binding SelectedHeightCm}"
                                    SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_HeightInCentimeters}" />
                            </Border>
                            <Label Grid.Column="1" Text="{loc:LocalizedText Common_Unit_Cm}"
                                   Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="6" RowDefinitions="Auto,Auto" RowSpacing="6"
                          IsVisible="{Binding UseMetricSystem, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="{loc:LocalizedText Common_Height}" Style="{StaticResource FormFieldLabel}" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8">
                            <Border Style="{StaticResource ProfileMeasurementPickerSurface}">
                                <Picker
                                    AutomationId="ProfileSetupFeetPicker"
                                    Title="{loc:LocalizedText Onboarding_ProfileSetup_Feet}"
                                    ItemsSource="{Binding FeetOptions}"
                                    SelectedItem="{Binding SelectedFeet}"
                                    SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_HeightInFeet}" />
                            </Border>
                            <Label Grid.Column="1" Text="{loc:LocalizedText Common_Unit_Ft}"
                                   Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                            <Border Grid.Column="2" Style="{StaticResource ProfileMeasurementPickerSurface}">
                                <Picker
                                    AutomationId="ProfileSetupInchesPicker"
                                    Title="{loc:LocalizedText Onboarding_ProfileSetup_Inches}"
                                    ItemsSource="{Binding InchesOptions}"
                                    SelectedItem="{Binding SelectedInches}"
                                    SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_HeightInInches}" />
                            </Border>
                            <Label Grid.Column="3" Text="{loc:LocalizedText Common_Unit_In}"
                                   Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="7" RowDefinitions="Auto,Auto" RowSpacing="6">
                        <Label Text="{loc:LocalizedText Common_Weight}" Style="{StaticResource FormFieldLabel}" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Border Style="{StaticResource ProfileMeasurementPickerSurface}" IsVisible="{Binding UseMetricSystem}">
                                <Picker
                                    AutomationId="ProfileSetupMetricWeightPicker"
                                    Title="{loc:LocalizedText Onboarding_ProfileSetup_SelectWeight}"
                                    ItemsSource="{Binding MetricWeightOptions}"
                                    SelectedItem="{Binding SelectedWeightKg}"
                                    SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_WeightInKilograms}" />
                            </Border>
                            <Border Style="{StaticResource ProfileMeasurementPickerSurface}"
                                    IsVisible="{Binding UseMetricSystem, Converter={StaticResource InvertedBoolConverter}}">
                                <Picker
                                    AutomationId="ProfileSetupImperialWeightPicker"
                                    Title="{loc:LocalizedText Onboarding_ProfileSetup_SelectWeight}"
                                    ItemsSource="{Binding ImperialWeightOptions}"
                                    SelectedItem="{Binding SelectedWeightLbs}"
                                    SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_WeightInPounds}" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="{Binding WeightUnit, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>

            <Border Style="{StaticResource CardPrimary}" IsVisible="{Binding IsAppleHealthAvailable}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:LocalizedText Onboarding_ProfileSetup_ConnectAppleHealth}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{loc:LocalizedText Onboarding_ProfileSetup_UseSleepStepsActiveEnergyAnd}"
                           Style="{StaticResource CaptionLabel}" />
                    <Button Text="{Binding HealthConnectionText, Converter={StaticResource LocalizedStringConverter}}"
                            Command="{Binding ConnectHealthCommand}"
                            SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_ConnectAppleHealthDuringSetup}" />
                    <Label
                        Text="{Binding HealthConnectionMessage, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource CaptionLabel}"
                        IsVisible="{Binding HealthConnectionMessage, Converter={StaticResource StringToBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="12">
                <BoxView HeightRequest="{StaticResource ProfileSectionDividerThickness}"
                         Margin="{StaticResource ProfileActivityDividerMargin}"
                         Opacity="0.6"
                         Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />
                <Label
                    Text="{loc:LocalizedText Onboarding_ProfileSetup_ChooseYourActivity}"
                    Style="{StaticResource SectionTitle}"
                    SemanticProperties.HeadingLevel="Level2" />
                <Label
                    Text="{loc:LocalizedText Onboarding_ProfileSetup_PickAtLeastOneStrengthActivity}"
                    Style="{StaticResource CaptionLabel}" />
                <workoutControls:WorkoutActivityPreferencePicker
                    ActivityGroups="{Binding GroupedWorkoutActivityOptions}"
                    ToggleActivityCommand="{Binding ToggleWorkoutActivityCommand}" />
            </VerticalStackLayout>

            <Label
                Text="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                Style="{StaticResource ErrorLabel}"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                SemanticProperties.Description="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                SemanticProperties.HeadingLevel="Level3" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_SavingProfilePleaseWait}" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MinimumHeightRequest="44">
                <CheckBox
                    x:Name="WellnessAcknowledgment"
                    AutomationId="WellnessAcknowledgmentCheckBox"
                    VerticalOptions="Center"
                    SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_IUnderstandThisIsWellnessGuidance}" />
                <Label
                    Grid.Column="1"
                    Text="{loc:LocalizedText Onboarding_ProfileSetup_IUnderstandThisAppOffersWellness}"
                    Style="{StaticResource CaptionLabel}"
                    VerticalOptions="Center" />
            </Grid>
            <Label
                x:Name="AcknowledgmentError"
                IsVisible="False"
                Text="{loc:LocalizedText Onboarding_ProfileSetup_PleaseAcknowledgeTheWellnessNoticeTo}"
                Style="{StaticResource ErrorLabel}" />

            <Button
                Text="{loc:LocalizedText Common_Continue}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                Clicked="OnContinueClicked"
                MinimumHeightRequest="52"
                SemanticProperties.Description="{loc:LocalizedText Onboarding_ProfileSetup_ContinueToPersonalizedQuestions}"
                SemanticProperties.Hint="{loc:LocalizedText Onboarding_ProfileSetup_DoubleTapToSaveYourProfile}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
