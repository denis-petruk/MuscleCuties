<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Cycle.CyclePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:cycleControls="clr-namespace:MuscleCuties.UI.Controls.Cycle"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <x:Double x:Key="CycleWellnessNoteFontSize">11</x:Double>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <Grid
                Padding="20,40,20,32"
                RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                RowSpacing="16"
                HorizontalOptions="Fill"
                MaximumWidthRequest="640">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Label
                        Text="{Binding CurrentMonthLabel, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource SubHeadline}" />
                    <Label Grid.Row="1" Text="{loc:LocalizedText Cycle_Page_Title}" Style="{StaticResource MutedLabel}" />

                    <Border
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{loc:LocalizedText Cycle_Page_SettingsAccessibility}"
                        SemanticProperties.Hint="{loc:LocalizedText Cycle_Page_OpenSettingsAccessibility}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCycleSettingsCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Data="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                            Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            StrokeThickness="1.5"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Aspect="Uniform"
                            WidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <toolkit:LazyView x:Name="HeroCardLazy" Grid.Row="1"
                                  x:TypeArguments="cycleControls:CycleHeroCard" />
                <toolkit:LazyView x:Name="CalendarCardLazy" Grid.Row="2"
                                  x:TypeArguments="cycleControls:CycleCalendarCard" />
                <toolkit:LazyView x:Name="PhaseExplorerLazy" Grid.Row="3"
                                  x:TypeArguments="cycleControls:CyclePhaseExplorerCarousel" />
                <Label
                    Grid.Row="4"
                    Text="{loc:LocalizedText Cycle_Page_MedicalDisclaimer}"
                    Style="{StaticResource CaptionLabel}"
                    FontSize="{StaticResource CycleWellnessNoteFontSize}"
                    HorizontalTextAlignment="Center"
                    Margin="0,8,0,0" />
            </Grid>
        </ScrollView>

        <toolkit:LazyView
            x:Name="DatePhaseModal"
            x:TypeArguments="cycleControls:CycleDatePhaseModal"
            InputTransparent="{Binding IsDatePhaseModalVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView
            x:Name="WarningPopup"
            x:TypeArguments="cycleControls:CycleWarningPopup"
            InputTransparent="{Binding IsCycleWarningPopupVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView
            x:Name="QuickLogSheet"
            x:TypeArguments="cycleControls:CycleQuickLogBottomSheet"
            InputTransparent="{Binding IsQuickLogSheetVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView
            x:Name="PhaseSummarySheet"
            x:TypeArguments="cycleControls:CyclePhaseSummarySheet"
            InputTransparent="{Binding IsPhaseSummarySheetVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <sharedControls:PageLoadingOverlay />
    </Grid>
</ContentPage>
