<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Cycle.CyclePhaseDetailPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:cycleModels="clr-namespace:MuscleCuties.UI.Models.UI.Cycle"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CyclePhaseDetailViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
    >

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              Padding="{DynamicResource PresentationPageHeaderPadding}"
              MaximumWidthRequest="{StaticResource UiDimension640}"
              HorizontalOptions="Fill">
            <sharedControls:PageHeader
                Title="{Binding PhaseName, Converter={StaticResource LocalizedStringConverter}}"
                TitleMaxFontSize="{StaticResource PresentationAccessibilitySectionTitleMaxFontSize}"
                Subtitle="{Binding PhaseWindow, Converter={StaticResource LocalizedStringConverter}}"
                BackCommand="{Binding BackCommand}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="{DynamicResource PresentationPageContentPadding}"
                Spacing="{StaticResource UiSpaceControl}"
                HorizontalOptions="Fill"
                MaximumWidthRequest="{StaticResource UiDimension640}">

            <!-- Hero phase card -->
            <Border
                Style="{StaticResource CardPrimary}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing10}">

                    <Label
                        Grid.Row="0"
                        Text="{Binding Headline, Converter={StaticResource LocalizedStringConverter}}"
                        TextColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                        Style="{StaticResource MetricValue}"
                        LineBreakMode="WordWrap"
                        SemanticProperties.HeadingLevel="Level2" />

                    <Label
                        Grid.Row="1"
                        Text="{Binding Hook, Converter={StaticResource LocalizedStringConverter}}"
                        TextColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                        Style="{StaticResource BodyLabel}"
                        sharedControls:CappedTextSize.IsBodyLead="True"
                        LineBreakMode="WordWrap" />

                    <sharedControls:PhaseVisualView
                        Grid.Row="2"
                        IsVisible="{Binding HasPhaseImage}"
                        Source="{Binding PhaseImageSource}"
                        WidthRequest="{StaticResource UiDimension150}"
                        HeightRequest="{StaticResource UiDimension150}"
                        HorizontalOptions="Center"
                        Margin="{StaticResource UiInsets0_4_0_0}" />

                    <Border
                        Grid.Row="3"
                        Style="{StaticResource CardSecondary}">
                        <Label
                            Text="{Binding QuickRule, Converter={StaticResource LocalizedStringConverter}}"
                            TextColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                            Style="{StaticResource BodyStrong}"
                            LineBreakMode="WordWrap" />
                    </Border>
                </Grid>
            </Border>

            <!-- Workouts section -->
            <Label
                Text="{loc:LocalizedText Cycle_PhaseDetail_WorkoutsTab}"
                Style="{StaticResource SectionTitle}"
                LineBreakMode="WordWrap"
                Margin="{StaticResource UiInsets2_8_2_0}"
                SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource CardPrimary}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing10}">
                    <Label
                        Grid.Row="0"
                        Text="{Binding WorkoutLead, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource BodyLabel}"
                        sharedControls:CappedTextSize.IsBodyLead="True"
                        LineBreakMode="WordWrap" />
                    <VerticalStackLayout Grid.Row="1" Spacing="{StaticResource UiSpacing6}" BindableLayout.ItemsSource="{Binding WorkoutPoints}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="cycleModels:CyclePhaseDetailPoint">
                                <Border
                                    Style="{StaticResource PillBadge}"
                                    HorizontalOptions="Fill"
                                    MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                    SemanticProperties.Description="{Binding Title, Converter={StaticResource LocalizedStringConverter}}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpacing6}">
                                        <Image
                                            Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                            WidthRequest="{StaticResource UiDimension16}"
                                            HeightRequest="{StaticResource UiDimension16}"
                                            Aspect="AspectFit"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CardTitle}"
                                            sharedControls:CappedTextSize.IsPhasePill="True"
                                            VerticalOptions="Center"
                                            LineBreakMode="WordWrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- At a glance card -->
            <Border Style="{StaticResource CardPrimary}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceCompact}">
                    <Label
                        Grid.Row="0"
                        Text="{loc:LocalizedText Cycle_PhaseDetail_AtAGlanceTitle}"
                        Style="{StaticResource SectionTitle}"
                        LineBreakMode="WordWrap"
                        SemanticProperties.HeadingLevel="Level2" />

                    <VerticalStackLayout Grid.Row="1" Spacing="{StaticResource UiSpaceControl}">
                        <VerticalStackLayout Spacing="{StaticResource UiSpacing6}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpaceTight}">
                                <Image Source="{Binding TrainingIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                       WidthRequest="{StaticResource UiDimension18}" HeightRequest="{StaticResource UiDimension18}"
                                       Aspect="AspectFit" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{loc:LocalizedText Cycle_PhaseDetail_TrainingSectionTitle}"
                                       Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                            </Grid>
                            <ProgressBar Progress="{Binding TrainingSignal}"
                                         ProgressColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                                         BackgroundColor="{AppThemeBinding Light={StaticResource TrackMutedLight}, Dark={StaticResource TrackMutedDark}}"
                                         SemanticProperties.Description="{Binding TrainingSignalText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_PhaseDetail_TrainingLevelFormat}" />
                            <Label Text="{Binding TrainingSignalText, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="{StaticResource UiSpacing6}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpaceTight}">
                                <Image Source="{Binding NutritionIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                       WidthRequest="{StaticResource UiDimension18}" HeightRequest="{StaticResource UiDimension18}"
                                       Aspect="AspectFit" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{loc:LocalizedText Cycle_PhaseDetail_NutritionSectionTitle}"
                                       Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                            </Grid>
                            <ProgressBar Progress="{Binding NutritionSignal}"
                                         ProgressColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                                         BackgroundColor="{AppThemeBinding Light={StaticResource TrackMutedLight}, Dark={StaticResource TrackMutedDark}}"
                                         SemanticProperties.Description="{Binding NutritionSignalText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_PhaseDetail_NutritionLevelFormat}" />
                            <Label Text="{Binding NutritionSignalText, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="{StaticResource UiSpacing6}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpaceTight}">
                                <Image Source="{Binding RecoveryIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                       WidthRequest="{StaticResource UiDimension18}" HeightRequest="{StaticResource UiDimension18}"
                                       Aspect="AspectFit" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{loc:LocalizedText Cycle_PhaseDetail_RecoverySectionTitle}"
                                       Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                            </Grid>
                            <ProgressBar Progress="{Binding RecoverySignal}"
                                         ProgressColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                                         BackgroundColor="{AppThemeBinding Light={StaticResource TrackMutedLight}, Dark={StaticResource TrackMutedDark}}"
                                         SemanticProperties.Description="{Binding RecoverySignalText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_PhaseDetail_RecoveryLevelFormat}" />
                            <Label Text="{Binding RecoverySignalText, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Why it matters section -->
            <Label
                Text="{loc:LocalizedText Cycle_PhaseDetail_WhyItMattersTitle}"
                Style="{StaticResource SectionTitle}"
                LineBreakMode="WordWrap"
                Margin="{StaticResource UiInsets2_8_2_0}"
                SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource CardPrimary}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing10}">
                    <Label
                        Grid.Row="0"
                        Text="{Binding WhyLead, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource BodyLabel}"
                        sharedControls:CappedTextSize.IsBodyLead="True"
                        LineBreakMode="WordWrap" />
                    <VerticalStackLayout Grid.Row="1" Spacing="{StaticResource UiSpaceTight}" BindableLayout.ItemsSource="{Binding WhyPoints}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="cycleModels:CyclePhaseDetailPoint">
                                <Border
                                    Style="{StaticResource CardSecondary}"
                                    MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                    SemanticProperties.Description="{Binding Title, Converter={StaticResource LocalizedStringConverter}}">
                                    <Grid ColumnDefinitions="22,*" ColumnSpacing="{StaticResource UiSpaceTight}">
                                        <Image
                                            Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                            WidthRequest="{StaticResource UiDimension16}"
                                            HeightRequest="{StaticResource UiDimension16}"
                                            Aspect="AspectFit"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CardTitle}"
                                            LineBreakMode="WordWrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Watch this (warnings) section - expanded by default, prominent styling -->
            <Border
                Style="{StaticResource CardPrimary}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceTight}">
                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="22,*,Auto"
                        ColumnSpacing="{StaticResource UiSpaceTight}"
                        MinimumHeightRequest="{StaticResource UiDimension48}"
                        SemanticProperties.Description="{loc:LocalizedText Cycle_PhaseDetail_WatchOutSectionAccessibility}"
                        SemanticProperties.Hint="{loc:LocalizedText Cycle_PhaseDetail_ExpandWatchOutAccessibility}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleWatchCommand}" />
                        </Grid.GestureRecognizers>
                        <Image
                            Source="{Binding WatchIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}, ConverterParameter=Warning}"
                            WidthRequest="{StaticResource UiDimension20}"
                            HeightRequest="{StaticResource UiDimension20}"
                            Aspect="AspectFit"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{loc:LocalizedText Cycle_PhaseDetail_WatchThisSectionTitle}"
                            Style="{StaticResource CardTitle}"
                            TextColor="{AppThemeBinding Light={StaticResource WarningAccentLight}, Dark={StaticResource WarningAccentDark}}"
                            VerticalOptions="Center"
                            LineBreakMode="WordWrap"
                            SemanticProperties.HeadingLevel="Level2" />
                        <Label
                            Grid.Column="2"
                            Text="{Binding IsWatchExpanded, Converter={StaticResource BoolToChevronConverter}}"
                            TextColor="{AppThemeBinding Light={StaticResource WarningAccentLight}, Dark={StaticResource WarningAccentDark}}"
                            Style="{StaticResource SectionTitle}"
                            SemanticProperties.HeadingLevel="None"
                            VerticalOptions="Center"
                            HorizontalTextAlignment="End" />
                    </Grid>

                    <VerticalStackLayout
                        Grid.Row="1"
                        Spacing="{StaticResource UiSpaceCompact}"
                        Margin="{StaticResource UiInsets0_10_0_0}"
                        IsVisible="{Binding IsWatchExpanded}"
                        BindableLayout.ItemsSource="{Binding WatchPoints}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="cycleModels:CyclePhaseDetailPoint">
                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="{StaticResource UiSpacing10}"
                                    MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                    SemanticProperties.Description="{Binding Title, Converter={StaticResource LocalizedStringConverter}}">
                                    <Image
                                        Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}, ConverterParameter=Warning}"
                                        WidthRequest="{StaticResource UiDimension18}"
                                        HeightRequest="{StaticResource UiDimension18}"
                                        Aspect="AspectFit"
                                        Margin="{StaticResource UiInsets0_4_0_0}"
                                        VerticalOptions="Start" />
                                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing3}">
                                        <Label
                                            Grid.Row="0"
                                            Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CardTitle}"
                                            TextColor="{AppThemeBinding Light={StaticResource WarningAccentLight}, Dark={StaticResource WarningAccentDark}}"
                                            LineBreakMode="WordWrap" />
                                        <Label
                                            Grid.Row="1"
                                            Text="{Binding Text, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource MutedLabel}"
                                            LineBreakMode="WordWrap" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Nutrition section -->
            <Label
                Text="{loc:LocalizedText Cycle_PhaseDetail_NutritionSectionTitle}"
                Style="{StaticResource SectionTitle}"
                LineBreakMode="WordWrap"
                Margin="{StaticResource UiInsets2_8_2_0}"
                SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource CardPrimary}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing10}">
                    <Label
                        Grid.Row="0"
                        Text="{Binding NutritionLead, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource BodyLabel}"
                        sharedControls:CappedTextSize.IsBodyLead="True"
                        LineBreakMode="WordWrap" />
                    <VerticalStackLayout Grid.Row="1" Spacing="{StaticResource UiSpacing6}" BindableLayout.ItemsSource="{Binding NutritionPoints}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="cycleModels:CyclePhaseDetailPoint">
                                <Border
                                    Style="{StaticResource PillBadge}"
                                    HorizontalOptions="Fill"
                                    MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                    SemanticProperties.Description="{Binding Title, Converter={StaticResource LocalizedStringConverter}}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpacing6}">
                                        <Image
                                            Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                            WidthRequest="{StaticResource UiDimension16}"
                                            HeightRequest="{StaticResource UiDimension16}"
                                            Aspect="AspectFit"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CardTitle}"
                                            sharedControls:CappedTextSize.IsPhasePill="True"
                                            VerticalOptions="Center"
                                            LineBreakMode="WordWrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
