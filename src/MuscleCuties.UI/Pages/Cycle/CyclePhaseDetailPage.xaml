<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Cycle.CyclePhaseDetailPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:cycleModels="clr-namespace:MuscleCuties.UI.Models.UI.Cycle"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CyclePhaseDetailViewModel"
    Shell.NavBarIsVisible="False"
    SemanticProperties.Description="{loc:LocalizedText Cycle_PhaseDetail_PageAccessibility}">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,40,20,32"
            Spacing="16"
            HorizontalOptions="Fill"
            MaximumWidthRequest="640">

            <sharedControls:PageHeader
                Title="{Binding PhaseName, Converter={StaticResource LocalizedStringConverter}}"
                Subtitle="{Binding PhaseWindow}"
                BackCommand="{Binding BackCommand}" />

            <!-- Hero phase card -->
            <Border
                Background="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToBrushConverter}}"
                Stroke="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1"
                Padding="22,20"
                SemanticProperties.Description="{Binding PhaseName, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_PhaseDetail_OverviewFormat}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                        <Image
                            Source="{Binding PhaseIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                            WidthRequest="16"
                            HeightRequest="16"
                            Aspect="AspectFit"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding PhaseWindow, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource FormFieldLabel}"
                            FontSize="14"
                            TextColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}" />
                    </Grid>

                    <Label
                        Grid.Row="1"
                        Text="{Binding Headline, Converter={StaticResource LocalizedStringConverter}}"
                        TextColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                        FontSize="25"
                        FontAttributes="Bold"
                        LineBreakMode="WordWrap"
                        SemanticProperties.HeadingLevel="Level1" />

                    <Label
                        Grid.Row="2"
                        Text="{Binding Hook, Converter={StaticResource LocalizedStringConverter}}"
                        TextColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                        FontSize="15"
                        LineBreakMode="WordWrap" />

                    <sharedControls:PhaseVisualView
                        Grid.Row="3"
                        Source="{Binding PhaseImageSource}"
                        WidthRequest="150"
                        HeightRequest="150"
                        HorizontalOptions="Center"
                        Margin="0,4,0,0" />

                    <Border
                        Grid.Row="4"
                        BackgroundColor="{AppThemeBinding Light={StaticResource OverlayLight}, Dark={StaticResource OverlayDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12">
                        <Label
                            Text="{Binding QuickRule, Converter={StaticResource LocalizedStringConverter}}"
                            TextColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                            FontSize="14"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap" />
                    </Border>
                </Grid>
            </Border>

            <!-- Workouts section -->
            <Label
                Text="{loc:LocalizedText Cycle_PhaseDetail_WorkoutsTab}"
                Style="{StaticResource SectionTitle}"
                Margin="2,8,2,0"
                SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource CardPrimary}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Label
                        Grid.Row="0"
                        Text="{Binding WorkoutLead, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource BodyLabel}"
                        LineBreakMode="WordWrap" />
                    <FlexLayout Grid.Row="1" Wrap="Wrap" BindableLayout.ItemsSource="{Binding WorkoutPoints}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="cycleModels:CyclePhaseDetailPoint">
                                <Border
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="10,8"
                                    Margin="0,0,6,6"
                                    MinimumHeightRequest="44"
                                    SemanticProperties.Description="{Binding Title, Converter={StaticResource LocalizedStringConverter}}">
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                        <Image
                                            Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                            WidthRequest="16"
                                            HeightRequest="16"
                                            Aspect="AspectFit"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CardTitle}"
                                            FontSize="14"
                                            VerticalOptions="Center"
                                            LineBreakMode="WordWrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </Grid>
            </Border>

            <!-- At a glance card -->
            <Border Style="{StaticResource CardPrimary}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                    <Label
                        Grid.Row="0"
                        Text="{loc:LocalizedText Cycle_PhaseDetail_AtAGlanceTitle}"
                        Style="{StaticResource SectionTitle}"
                        SemanticProperties.HeadingLevel="Level2" />

                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="24,70,*,60" RowSpacing="10"
                          ColumnSpacing="8">
                        <Image
                            Source="{Binding TrainingIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                            WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{loc:LocalizedText Cycle_PhaseDetail_TrainingSectionTitle}"
                               Style="{StaticResource FormFieldLabel}" VerticalOptions="Center" />
                        <ProgressBar Grid.Column="2" Progress="{Binding TrainingSignal}"
                                     ProgressColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                                     VerticalOptions="Center"
                                     SemanticProperties.Description="{Binding TrainingSignalText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_PhaseDetail_TrainingLevelFormat}" />
                        <Label Grid.Column="3"
                               Text="{Binding TrainingSignalText, Converter={StaticResource LocalizedStringConverter}}"
                               Style="{StaticResource CaptionLabel}" FontSize="14" HorizontalTextAlignment="End"
                               VerticalOptions="Center" />

                        <Image Grid.Row="1"
                               Source="{Binding NutritionIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                               WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{loc:LocalizedText Cycle_PhaseDetail_NutritionSectionTitle}"
                               Style="{StaticResource FormFieldLabel}" VerticalOptions="Center" />
                        <ProgressBar Grid.Row="1" Grid.Column="2" Progress="{Binding NutritionSignal}"
                                     ProgressColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                                     VerticalOptions="Center"
                                     SemanticProperties.Description="{Binding NutritionSignalText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_PhaseDetail_NutritionLevelFormat}" />
                        <Label Grid.Row="1" Grid.Column="3"
                               Text="{Binding NutritionSignalText, Converter={StaticResource LocalizedStringConverter}}"
                               Style="{StaticResource CaptionLabel}" FontSize="14" HorizontalTextAlignment="End"
                               VerticalOptions="Center" />

                        <Image Grid.Row="2"
                               Source="{Binding RecoveryIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                               WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{loc:LocalizedText Cycle_PhaseDetail_RecoverySectionTitle}"
                               Style="{StaticResource FormFieldLabel}" VerticalOptions="Center" />
                        <ProgressBar Grid.Row="2" Grid.Column="2" Progress="{Binding RecoverySignal}"
                                     ProgressColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                                     VerticalOptions="Center"
                                     SemanticProperties.Description="{Binding RecoverySignalText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_PhaseDetail_RecoveryLevelFormat}" />
                        <Label Grid.Row="2" Grid.Column="3"
                               Text="{Binding RecoverySignalText, Converter={StaticResource LocalizedStringConverter}}"
                               Style="{StaticResource CaptionLabel}" FontSize="14" HorizontalTextAlignment="End"
                               VerticalOptions="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Why it matters section -->
            <Label
                Text="{loc:LocalizedText Cycle_PhaseDetail_WhyItMattersTitle}"
                Style="{StaticResource SectionTitle}"
                Margin="2,8,2,0"
                SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource CardPrimary}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Label
                        Grid.Row="0"
                        Text="{Binding WhyLead, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource BodyLabel}"
                        LineBreakMode="WordWrap" />
                    <VerticalStackLayout Grid.Row="1" Spacing="8" BindableLayout.ItemsSource="{Binding WhyPoints}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="cycleModels:CyclePhaseDetailPoint">
                                <Border
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14,12"
                                    MinimumHeightRequest="44"
                                    SemanticProperties.Description="{Binding Title, Converter={StaticResource LocalizedStringConverter}}">
                                    <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
                                        <Image
                                            Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                            WidthRequest="16"
                                            HeightRequest="16"
                                            Aspect="AspectFit"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CardTitle}"
                                            FontSize="14"
                                            LineBreakMode="WordWrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Watch this (warnings) section - expanded by default, prominent styling -->
            <Border
                Style="{StaticResource CardPrimary}"
                BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurfaceLight}, Dark={StaticResource WarningSurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource WarningAccentLight}, Dark={StaticResource WarningAccentDark}}"
                StrokeThickness="1">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="22,*,24"
                        ColumnSpacing="8"
                        MinimumHeightRequest="48"
                        SemanticProperties.Description="{loc:LocalizedText Cycle_PhaseDetail_WatchOutSectionAccessibility}"
                        SemanticProperties.Hint="{loc:LocalizedText Cycle_PhaseDetail_ExpandWatchOutAccessibility}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleWatchCommand}" />
                        </Grid.GestureRecognizers>
                        <Image
                            Source="{Binding WatchIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}, ConverterParameter=Warning}"
                            WidthRequest="20"
                            HeightRequest="20"
                            Aspect="AspectFit"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{loc:LocalizedText Cycle_PhaseDetail_WatchThisSectionTitle}"
                            Style="{StaticResource CardTitle}"
                            FontSize="17"
                            TextColor="{AppThemeBinding Light={StaticResource WarningAccentLight}, Dark={StaticResource WarningAccentDark}}"
                            VerticalOptions="Center"
                            SemanticProperties.HeadingLevel="Level2" />
                        <Label
                            Grid.Column="2"
                            Text="{Binding IsWatchExpanded, Converter={StaticResource BoolToChevronConverter}}"
                            TextColor="{AppThemeBinding Light={StaticResource WarningAccentLight}, Dark={StaticResource WarningAccentDark}}"
                            FontSize="16"
                            VerticalOptions="Center"
                            HorizontalTextAlignment="End" />
                    </Grid>

                    <VerticalStackLayout
                        Grid.Row="1"
                        Spacing="12"
                        Margin="0,10,0,0"
                        IsVisible="{Binding IsWatchExpanded}"
                        BindableLayout.ItemsSource="{Binding WatchPoints}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="cycleModels:CyclePhaseDetailPoint">
                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="10"
                                    MinimumHeightRequest="44"
                                    SemanticProperties.Description="{Binding Title, Converter={StaticResource LocalizedStringConverter}}">
                                    <Image
                                        Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}, ConverterParameter=Warning}"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        Aspect="AspectFit"
                                        Margin="0,4,0,0"
                                        VerticalOptions="Start" />
                                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="3">
                                        <Label
                                            Grid.Row="0"
                                            Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CardTitle}"
                                            FontSize="15"
                                            TextColor="{AppThemeBinding Light={StaticResource WarningAccentLight}, Dark={StaticResource WarningAccentDark}}"
                                            LineBreakMode="WordWrap" />
                                        <Label
                                            Grid.Row="1"
                                            Text="{Binding Text, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource MutedLabel}"
                                            FontSize="14"
                                            LineBreakMode="WordWrap" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Nutrition section -->
            <Label
                Text="{loc:LocalizedText Cycle_PhaseDetail_NutritionSectionTitle}"
                Style="{StaticResource SectionTitle}"
                Margin="2,8,2,0"
                SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource CardPrimary}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Label
                        Grid.Row="0"
                        Text="{Binding NutritionLead, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource BodyLabel}"
                        LineBreakMode="WordWrap" />
                    <FlexLayout Grid.Row="1" Wrap="Wrap" BindableLayout.ItemsSource="{Binding NutritionPoints}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="cycleModels:CyclePhaseDetailPoint">
                                <Border
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="10,8"
                                    Margin="0,0,6,6"
                                    MinimumHeightRequest="44"
                                    SemanticProperties.Description="{Binding Title, Converter={StaticResource LocalizedStringConverter}}">
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                        <Image
                                            Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                            WidthRequest="16"
                                            HeightRequest="16"
                                            Aspect="AspectFit"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CardTitle}"
                                            FontSize="14"
                                            VerticalOptions="Center"
                                            LineBreakMode="WordWrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
