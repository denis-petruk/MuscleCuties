<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Workout.WorkoutHistoryPage"
    x:Name="WorkoutHistoryRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:uiModels="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Workout"
    xmlns:workout="clr-namespace:MuscleCuties.Core.Models.Workout;assembly=MuscleCuties.Infrastructure"
    x:DataType="vm:WorkoutHistoryViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">

        <!-- Top Navigation Bar -->
        <Grid
            Grid.Row="0"
            Padding="{StaticResource UiInsets20_36_20_12}"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="{StaticResource UiSpaceCompact}"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

            <Border
                Style="{StaticResource HeaderIconButton}"
                SemanticProperties.Description="{loc:LocalizedText Workout_History_BackButton}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                </Border.GestureRecognizers>
                <Path
                    Data="M15 19l-7-7 7-7"
                    Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    StrokeThickness="{StaticResource UiStrokeWidth2}"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Aspect="Uniform"
                    WidthRequest="{StaticResource UiDimension14}"
                    HeightRequest="{StaticResource UiDimension14}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Label
                Grid.Column="1"
                Text="{loc:LocalizedText Workout_History_ArchiveTitle}"
                Style="{StaticResource SubHeadline}"
                FontSize="{StaticResource UiFontSize20}"
                VerticalOptions="Center" />

            <Border
                Grid.Column="2"
                Style="{StaticResource HeaderIconButton}"
                SemanticProperties.Description="{loc:LocalizedText Workout_History_RefreshArchiveAccessibility}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LoadHistoryCommand}" />
                </Border.GestureRecognizers>
                <Path
                    Data="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    StrokeThickness="{StaticResource UiStrokeWidth1_8}"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Aspect="Uniform"
                    WidthRequest="{StaticResource UiDimension16}"
                    HeightRequest="{StaticResource UiDimension16}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Chronological Virtualized Sessions Feed (No nested ScrollView) -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Sessions}"
            ItemSizingStrategy="MeasureFirstItem"
            RemainingItemsThreshold="4"
            RemainingItemsThresholdReachedCommand="{Binding LoadNextPageCommand}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource UiSpaceCompact}" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing14}" Padding="{StaticResource UiInsets16_6_16_10}">
                    <!-- Lifetime Stat Badges Card -->
                    <Border
                        Grid.Row="0"
                        Style="{StaticResource CardPrimary}"
                        Padding="{StaticResource UiInsets16_14}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource UiSpaceControl}">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                <Label Grid.Row="0" Text="{loc:LocalizedText Workout_History_CompletedSessionsTitle}" FontSize="{StaticResource UiFontSize13}"
                                       FontAttributes="{StaticResource UiFontAttributesBold}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Row="1"
                                       Text="{Binding TotalSessionsCount, Converter={StaticResource LocalizedStringConverter}}"
                                       FontSize="{StaticResource UiFontSize24}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Grid>

                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                <Label Grid.Row="0" Text="{loc:LocalizedText Workout_History_RecordedSetVolumeHeader}" FontSize="{StaticResource UiFontSize13}"
                                       FontAttributes="{StaticResource UiFontAttributesBold}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Row="1"
                                       Text="{Binding LifetimeVolumeFormatted, Converter={StaticResource LocalizedStringConverter}}"
                                       FontSize="{StaticResource UiFontSize24}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                       TextColor="{StaticResource PrimaryDark}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Monthly Filter Chips -->
                    <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                                Margin="{StaticResource UiInsets0_2_0_0}">
                        <HorizontalStackLayout Spacing="{StaticResource UiSpaceTight}" BindableLayout.ItemsSource="{Binding AvailableMonths}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="uiModels:MonthFilterItem">
                                    <Border
                                        StrokeShape="{StaticResource UiRoundRectangleRadius999}"
                                        StrokeThickness="{StaticResource UiStrokeWidth0}"
                                        Padding="{StaticResource UiInsets14_7}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth0}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectMonthCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutHistoryViewModel}}, x:DataType=vm:WorkoutHistoryViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding DisplayName}" FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}"
                                                             Value="False">
                                                    <Setter Property="TextColor"
                                                            Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Empty State -->
                    <Border
                        Grid.Row="2"
                        IsVisible="{Binding HasNoSessions}"
                        Style="{StaticResource CardPrimary}"
                        Padding="{StaticResource UiInsets24}">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceTight}" HorizontalOptions="Center">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Workout_History_EmptyStateTitle}"
                                   Style="{StaticResource CardTitle}" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="1" Text="{loc:LocalizedText Workout_History_EmptyStateDescription}"
                                   Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" FontSize="{StaticResource UiFontSize13}" />
                        </Grid>
                    </Border>

                    <Label
                        Grid.Row="3"
                        Text="{loc:LocalizedText Workout_History_PastSessionsTitle}"
                        FontSize="{StaticResource UiFontSize13}"
                        FontAttributes="{StaticResource UiFontAttributesBold}"
                        Margin="{StaticResource UiInsets4_4_0_0}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                </Grid>
            </CollectionView.Header>

            <!-- Workout Session Summary Card ItemTemplate -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="workout:WorkoutSessionSummaryDto">
                    <Border
                        Margin="{StaticResource UiInsets16_0}"
                        Style="{StaticResource CardPrimary}"
                        Padding="{StaticResource UiInsets16_14}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding OpenSessionDetailCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutHistoryViewModel}}, x:DataType=vm:WorkoutHistoryViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing10}">
                            <!-- Top: Date and RPE Badge -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label
                                    Text="{Binding StartedAt, StringFormat='{0:ddd, MMM d, yyyy}'}"
                                    FontSize="{StaticResource UiFontSize13}"
                                    FontAttributes="{StaticResource UiFontAttributesBold}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <Border
                                    Grid.Column="1"
                                    IsVisible="{Binding RpeRating, Converter={StaticResource StringToBoolConverter}}"
                                    StrokeShape="{StaticResource UiRoundRectangleRadius999}"
                                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                    Padding="{StaticResource UiInsets8_2}">
                                    <Label
                                        Text="{Binding RpeRating, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_History_RpeFormat}"
                                        FontSize="{StaticResource UiFontSize11}"
                                        FontAttributes="{StaticResource UiFontAttributesBold}"
                                        TextColor="{StaticResource PrimaryDark}" />
                                </Border>
                            </Grid>

                            <!-- Session Name -->
                            <Label
                                Grid.Row="1"
                                Text="{Binding WorkoutName}"
                                FontSize="{StaticResource UiFontSize17}"
                                FontAttributes="{StaticResource UiFontAttributesBold}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Grid.Row="2"
                                   Text="{Binding DetailLabel, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource CaptionLabel}" FontSize="{StaticResource UiFontSize13}" />

                            <!-- Primary Exercises -->
                            <HorizontalStackLayout Grid.Row="3" Spacing="{StaticResource UiSpacing6}"
                                                   BindableLayout.ItemsSource="{Binding PrimaryExercises}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border
                                            Style="{StaticResource PillBadge}"
                                            Padding="{StaticResource UiInsets6_3}">
                                            <Label Text="{Binding .}" FontSize="{StaticResource UiFontSize11}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <!-- Metric Pills Row: Duration, Volume, Sets -->
                            <Grid Grid.Row="4" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource UiSpaceTight}" Margin="{StaticResource UiInsets0_4_0_0}">
                                <Border
                                    Style="{StaticResource WorkoutMetricTile}"
                                    Padding="{StaticResource UiInsets8_6}">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing1}" HorizontalOptions="Center">
                                        <Label Grid.Row="0" Text="{loc:LocalizedText Workout_History_DurationHeader}" FontSize="{StaticResource UiFontSize11}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Label Grid.Row="1"
                                               Text="{Binding DurationLabel, Converter={StaticResource LocalizedStringConverter}}"
                                               FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}" />
                                    </Grid>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Style="{StaticResource WorkoutMetricTile}"
                                    Padding="{StaticResource UiInsets8_6}">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing1}" HorizontalOptions="Center">
                                        <Label Grid.Row="0" Text="{loc:LocalizedText Workout_History_VolumeHeader}" FontSize="{StaticResource UiFontSize11}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Label Grid.Row="1"
                                               Text="{Binding VolumeLabel, Converter={StaticResource LocalizedStringConverter}}"
                                               FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                               TextColor="{StaticResource PrimaryDark}" />
                                    </Grid>
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    Style="{StaticResource WorkoutMetricTile}"
                                    Padding="{StaticResource UiInsets8_6}">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing1}" HorizontalOptions="Center">
                                        <Label Grid.Row="0" Text="{loc:LocalizedText Workout_History_TotalSetsHeader}" FontSize="{StaticResource UiFontSize11}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Label Grid.Row="1"
                                               Text="{Binding SetCountLabel, Converter={StaticResource LocalizedStringConverter}}"
                                               FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpaceTight}" Padding="{StaticResource UiInsets16_12}"
                      HorizontalOptions="Center">
                    <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsLoadingMore}"
                                       IsVisible="{Binding IsLoadingMore}" Color="{StaticResource Primary}"
                                       HeightRequest="{StaticResource UiDimension28}" WidthRequest="{StaticResource UiDimension28}" />
                    <Label Grid.Row="1" Text="{loc:LocalizedText Workout_History_LoadingMore}" FontSize="{StaticResource UiFontSize12}"
                           Style="{StaticResource MutedLabel}" IsVisible="{Binding IsLoadingMore}"
                           HorizontalTextAlignment="Center" />
                    <Label Grid.Row="2" Text="{loc:LocalizedText Workout_History_AllWorkoutsLoaded}" FontSize="{StaticResource UiFontSize12}"
                           Style="{StaticResource MutedLabel}" IsVisible="{Binding IsEndReached}"
                           HorizontalTextAlignment="Center" />
                    <Button Grid.Row="3" Text="{loc:LocalizedText Workout_History_RetryLoadingButton}" Command="{Binding LoadNextPageCommand}"
                            IsVisible="{Binding IsError}" Style="{StaticResource QuietButton}" FontSize="{StaticResource UiFontSize12}" />
                    <Grid Grid.Row="4" HeightRequest="{StaticResource UiDimension20}" />
                </Grid>
            </CollectionView.Footer>
        </CollectionView>

        <!-- Dedicated Session Detail Sheet Modal Overlay -->
        <Grid
            Grid.RowSpan="2"
            IsVisible="{Binding IsDetailSheetVisible}">
            <BoxView BackgroundColor="{StaticResource ModalScrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseSessionDetailCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                x:Name="SheetSurface"
                Style="{StaticResource AppBottomSheetSurface}"
                Padding="{StaticResource UiInsets0}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer /> <!-- Absorb taps inside modal -->
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="{StaticResource UiInsets20_18_20_14}">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                            <Label
                                Grid.Row="0"
                                Text="{Binding SelectedSessionDetail.WorkoutName}"
                                Style="{StaticResource ModalTitle}" />
                            <Label
                                Grid.Row="1"
                                Text="{Binding DetailStartedFormatted, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource MutedLabel}" />
                            <Label Grid.Row="2"
                                   Text="{Binding DetailKindLabel, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource CaptionLabel}" />
                        </Grid>

                        <Button
                            Grid.Column="1"
                            Text="✕"
                            Command="{Binding CloseSessionDetailCommand}"
                            Style="{StaticResource ButtonLink}"
                            HeightRequest="{StaticResource UiDimension36}"
                            WidthRequest="{StaticResource UiDimension36}"
                            Padding="{StaticResource UiInsets0}" />
                    </Grid>

                    <!-- Session content scrolls while the header and save action stay visible. -->
                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Default">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpaceControl}" Padding="{StaticResource UiInsets20_4_20_16}">

                        <!-- Key Metrics Row -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource UiSpacing10}">
                            <Border Style="{StaticResource WorkoutMetricTile}"
                                    Padding="{StaticResource UiInsets10_8}">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}" HorizontalOptions="Center">
                                    <Label Grid.Row="0" Text="{loc:LocalizedText Workout_History_DurationHeader}" FontSize="{StaticResource UiFontSize11}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Grid.Row="1"
                                           Text="{Binding DetailDurationFormatted, Converter={StaticResource LocalizedStringConverter}}"
                                           FontSize="{StaticResource UiFontSize15}" FontAttributes="{StaticResource UiFontAttributesBold}" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource WorkoutMetricTile}"
                                    Padding="{StaticResource UiInsets10_8}">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}" HorizontalOptions="Center">
                                    <Label Grid.Row="0" Text="{loc:LocalizedText Workout_History_VolumeHeader}" FontSize="{StaticResource UiFontSize11}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Grid.Row="1"
                                           Text="{Binding DetailVolumeFormatted, Converter={StaticResource LocalizedStringConverter}}"
                                           FontSize="{StaticResource UiFontSize15}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{StaticResource PrimaryDark}" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource WorkoutMetricTile}"
                                    Padding="{StaticResource UiInsets10_8}">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}" HorizontalOptions="Center">
                                    <Label Grid.Row="0" Text="{loc:LocalizedText Workout_History_RpeHeader}" FontSize="{StaticResource UiFontSize11}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Grid.Row="1"
                                           Text="{Binding DetailRpeFormatted, Converter={StaticResource LocalizedStringConverter}}"
                                           FontSize="{StaticResource UiFontSize15}" FontAttributes="{StaticResource UiFontAttributesBold}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Sets Breakdown Grouped by Exercise -->
                        <Label Grid.Row="1" Text="{loc:LocalizedText Workout_History_BreakdownTitle}"
                               Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource UiSpaceCompact}"
                                             BindableLayout.ItemsSource="{Binding ExerciseGroups}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="uiModels:ExerciseSetsUiGroup">
                                    <Border
                                        Style="{StaticResource CardSecondary}"
                                        Padding="{StaticResource UiInsets14_12}">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing6}">
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding ExerciseName}" FontSize="{StaticResource UiFontSize15}"
                                                       FontAttributes="{StaticResource UiFontAttributesBold}" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding VolumeSummary, Converter={StaticResource LocalizedStringConverter}}"
                                                       FontSize="{StaticResource UiFontSize11}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </Grid>

                                            <!-- Sets Table Header -->
                                            <Grid Grid.Row="1" ColumnDefinitions="32,*,68,54,34" ColumnSpacing="{StaticResource UiSpacing6}"
                                                  Margin="{StaticResource UiInsets0_4_0_0}">
                                                <Label Text="{loc:LocalizedText Workout_History_SetHeader}" FontSize="{StaticResource UiFontSize11}"
                                                       FontAttributes="{StaticResource UiFontAttributesBold}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{loc:LocalizedText Workout_History_TypeHeader}"
                                                       FontSize="{StaticResource UiFontSize11}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       VerticalOptions="Center" />
                                                <Label Grid.Column="2" Text="{loc:LocalizedText Workout_History_KgHeader}"
                                                       FontSize="{StaticResource UiFontSize11}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="3" Text="{loc:LocalizedText Workout_History_RepsHeader}"
                                                       FontSize="{StaticResource UiFontSize11}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="4" Text="{loc:LocalizedText Workout_History_SaveButton}"
                                                       FontSize="{StaticResource UiFontSize11}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                            </Grid>

                                            <!-- Sets Rows with Inline Editing -->
                                            <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource UiSpacing6}"
                                                                 BindableLayout.ItemsSource="{Binding EditableSets}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="uiModels:EditableExerciseSetItem">
                                                        <Grid ColumnDefinitions="32,*,68,54,34" ColumnSpacing="{StaticResource UiSpacing6}"
                                                              Padding="{StaticResource UiInsets0_2}">
                                                            <Label Text="{Binding SetNumber, StringFormat='#{0}'}"
                                                                   FontSize="{StaticResource UiFontSize12}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                                                   VerticalOptions="Center" />
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding IsWarmup, Converter={StaticResource BoolToWarmupTextConverter}}"
                                                                   FontSize="{StaticResource UiFontSize11}"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                                   VerticalOptions="Center" />
                                                            <Border Grid.Column="2" Style="{StaticResource WorkoutMetricInput}">
                                                                <Entry Text="{Binding WeightInput}" Keyboard="Numeric"
                                                                       Placeholder="{loc:LocalizedText Workout_History_KgUnit}"
                                                                       SemanticProperties.Description="{loc:LocalizedText Workout_History_WeightInKgAccessibility}"
                                                                       VerticalOptions="Center" />
                                                            </Border>
                                                            <Border Grid.Column="3" Style="{StaticResource WorkoutMetricInput}">
                                                                <Entry Text="{Binding RepsInput}" Keyboard="Numeric"
                                                                       Placeholder="{loc:LocalizedText Workout_History_RepsUnit}"
                                                                       SemanticProperties.Description="{loc:LocalizedText Workout_History_RepsCompletedAccessibility}"
                                                                       VerticalOptions="Center" />
                                                            </Border>
                                                            <Button Grid.Column="4" Text="✓" HeightRequest="{StaticResource UiDimension36}"
                                                                    WidthRequest="{StaticResource UiDimension36}" Padding="{StaticResource UiInsets0}" CornerRadius="{StaticResource UiCornerRadius14}"
                                                                    FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                                                    Command="{Binding SaveSetEditCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutHistoryViewModel}}, x:DataType=vm:WorkoutHistoryViewModel}"
                                                                    CommandParameter="{Binding .}"
                                                                    SemanticProperties.Description="{loc:LocalizedText Workout_History_SaveSetEditAccessibility}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Retroactive Session Notes & RPE -->
                        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpaceTight}" Margin="{StaticResource UiInsets0_4_0_0}">
                            <Label Grid.Row="0" Text="{loc:LocalizedText Workout_History_NotesAndRpeSectionTitle}"
                                   Style="{StaticResource SectionTitle}" />

                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                <Label Text="{loc:LocalizedText Workout_History_PerceivedExertionTitle}" FontSize="{StaticResource UiFontSize13}" VerticalOptions="Center" />
                                <Border Grid.Column="1" Style="{StaticResource InputContainer}" WidthRequest="{StaticResource UiDimension72}" HeightRequest="{StaticResource UiDimension44}" MinimumHeightRequest="{StaticResource UiDimension44}" Padding="{StaticResource UiInsets8_0}">
                                    <Entry
                                        Text="{Binding EditingRpe}"
                                        Keyboard="Numeric"
                                        Placeholder="{loc:LocalizedText Workout_History_RpeHeader}"
                                        SemanticProperties.Description="{loc:LocalizedText Workout_History_RpeSliderAccessibility}"
                                        VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource EditorContainer}">
                                <Editor
                                    Text="{Binding EditingNotes}"
                                    Placeholder="{loc:LocalizedText Workout_History_NotesPlaceholder}" />
                            </Border>
                        </Grid>
                        </Grid>
                    </ScrollView>

                    <Button
                        Grid.Row="2"
                        Margin="{StaticResource UiInsets20_8_20_20}"
                        Text="{loc:LocalizedText Workout_History_SaveNotesAndRpeButton}"
                        Command="{Binding SaveSessionNotesCommand}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Initial Loading Indicator -->
        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            Color="{StaticResource Primary}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            HeightRequest="{StaticResource UiDimension36}"
            WidthRequest="{StaticResource UiDimension36}" />

        <!-- Status Toast Banner -->
        <Border
            Grid.RowSpan="2"
            HorizontalOptions="Center"
            Margin="{StaticResource UiInsets20_0_20_30}"
            IsVisible="{Binding IsStatusVisible}"
            StrokeShape="{StaticResource UiRoundRectangleRadius12}"
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}"
            Padding="{StaticResource UiInsets16_10}"
            InputTransparent="True">
            <Label
                Text="{Binding StatusMessage, Converter={StaticResource LocalizedStringConverter}}"
                FontSize="{StaticResource UiFontSize13}"
                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
        </Border>

    </Grid>
</ContentPage>
