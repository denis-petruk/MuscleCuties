<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Workout.StrengthPlanGenerationPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Workout"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="vm:StrengthPlanGenerationViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    SizeChanged="OnPageSizeChanged">

    <Grid>
    <Grid RowDefinitions="*,Auto,Auto">
    <Grid Grid.RowSpan="3" RowDefinitions="*,Auto,Auto"
          IsVisible="{Binding IsBeforePreview}">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout
            Padding="{StaticResource UiInsets20_16_20_32}"
            Spacing="{StaticResource UiSpaceControl}"
            HorizontalOptions="Fill"
            MaximumWidthRequest="{StaticResource UiDimension720}">

            <sharedControls:PageHeader
                Title="{loc:LocalizedText Workout_Generation_Title}"
                BackCommand="{Binding BackCommand}" />

            <!-- CARD 1: Plan Setup & Availability -->
            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">

                    <!-- Title & Intro -->
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Workout_Generation_PlanSetupBadge}" IconGlyph="Target24" />
                        <Label Text="{loc:LocalizedText Workout_Generation_Intro}"
                               Style="{StaticResource MutedLabel}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <!-- Saved Availability Tile -->
                    <Border Style="{StaticResource CardAccent}"
                            IsVisible="{Binding HasSavedAvailability}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="{StaticResource UiSpacing10}" VerticalOptions="Center">
                            <Path
                                Data="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"
                                Fill="{StaticResource Primary}"
                                Aspect="Uniform"
                                WidthRequest="{StaticResource UiDimension16}"
                                HeightRequest="{StaticResource UiDimension16}"
                                VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding SavedAvailabilitySummary}"
                                   Style="{StaticResource MutedLabel}"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <!-- Read-only strength choice from onboarding preferences -->
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}"
                                         IsVisible="{Binding HasSavedStrengthActivity}">
                        <Label Text="{loc:LocalizedText Workout_Generation_StrengthPlanType}"
                               Style="{StaticResource FormFieldLabel}" />
                        <Label Text="{Binding SelectedActivity.Label}"
                               Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding SelectedActivity.Description}"
                               Style="{StaticResource MutedLabel}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <!-- High Intensity Notice -->
                    <Border Style="{StaticResource CardAccent}"
                            IsVisible="{Binding IsHighIntensityStrengthSelected}">
                        <Label Text="{loc:LocalizedText Workout_Generation_HighIntensityEvidenceHelp}"
                               Style="{StaticResource MutedLabel}"
                               LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- CARD 2A: HIIT Evidence (Conditional) -->
            <Border IsVisible="{Binding ShouldShowHiitUnderlyingCardioChoice}"
                    IsEnabled="{Binding CanEditInputs}"
                    Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">

                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Workout_Generation_HiitEvidenceTitle}" IconGlyph="Dumbbell24" />
                        <Label Text="{loc:LocalizedText Workout_Generation_HiitEvidenceHelp}"
                                Style="{StaticResource MutedLabel}"
                                LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <!-- Underlying Activity Picker -->
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                        <Label Text="{loc:LocalizedText Workout_Generation_HiitUnderlyingActivityTitle}"
                               Style="{StaticResource FormFieldLabel}" />
                        <Label Text="{loc:LocalizedText Workout_Generation_HiitUnderlyingActivityHelp}"
                               Style="{StaticResource MutedLabel}"
                               LineBreakMode="WordWrap" />
                        <Border Style="{StaticResource PickerContainer}">
                            <Picker ItemsSource="{Binding HiitUnderlyingCardioActivities}"
                                    SelectedItem="{Binding SelectedHiitUnderlyingCardioActivity}"
                                    ItemDisplayBinding="{Binding Label}"
                                    Title="{loc:LocalizedText Workout_Generation_ChooseUnderlyingCardio}"
                                    IsEnabled="{Binding CanEditInputs}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="{loc:LocalizedText Workout_Generation_HiitUnderlyingActivityTitle}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Cardio History Fields -->
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                        <Label Text="{loc:LocalizedText Workout_Generation_HiitCardioHistoryTitle}"
                               Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding HiitEvidenceCapture.UnderlyingCardioExperienceHelp}"
                               Style="{StaticResource MutedLabel}"
                               LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource UiSpaceCompact}">
                            <VerticalStackLayout Spacing="{StaticResource UiSpacing6}">
                                <Label Text="{loc:LocalizedText Workout_Generation_HiitCardioConsistentWeeks}"
                                       Style="{StaticResource FormFieldLabel}" />
                                <Border Style="{StaticResource InputContainer}">
                                    <Entry Text="{Binding HiitEvidenceCapture.UnderlyingCardioConsistentWeeks}"
                                           Keyboard="Numeric"
                                           IsEnabled="{Binding CanEditInputs}"
                                           VerticalOptions="Center"
                                           SemanticProperties.Description="{loc:LocalizedText Workout_Generation_HiitCardioConsistentWeeks}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource UiSpacing6}">
                                <Label Text="{loc:LocalizedText Workout_Generation_HiitCardioAverageSessions}"
                                       Style="{StaticResource FormFieldLabel}" />
                                <Border Style="{StaticResource InputContainer}">
                                    <Entry Text="{Binding HiitEvidenceCapture.UnderlyingCardioAverageSessionsPerWeek}"
                                           Keyboard="Numeric"
                                           IsEnabled="{Binding CanEditInputs}"
                                           VerticalOptions="Center"
                                           SemanticProperties.Description="{loc:LocalizedText Workout_Generation_HiitCardioAverageSessions}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="{StaticResource UiSpacing6}">
                            <Label Text="{loc:LocalizedText Workout_Generation_HiitCardioDaysSinceLastSession}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding HiitEvidenceCapture.UnderlyingCardioDaysSinceLastSession}"
                                       Keyboard="Numeric"
                                       IsEnabled="{Binding CanEditInputs}"
                                       VerticalOptions="Center"
                                       SemanticProperties.Description="{loc:LocalizedText Workout_Generation_HiitCardioDaysSinceLastSession}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Aerobic Session Thresholds -->
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                        <Label Text="{Binding HiitEvidenceCapture.AerobicSessionThresholdHelp}"
                               Style="{StaticResource MutedLabel}"
                               LineBreakMode="WordWrap" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding HiitEvidenceCapture.PreviousFourWeeksAerobicEvidence}"
                                             Spacing="{StaticResource UiSpaceTight}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:HiitAerobicWeekEvidenceCapture">
                                    <Border Style="{StaticResource CardAccent}">
                                        <Grid ColumnDefinitions="*,100" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                            <Label Text="{Binding WeekLabel}"
                                                   Style="{StaticResource FormFieldLabel}"
                                                   VerticalOptions="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource InputContainer}">
                                                <Entry Text="{Binding QualifyingManageableSessionCount}"
                                                       Keyboard="Numeric"
                                                       Placeholder="{loc:LocalizedText Workout_Generation_HiitSessionCountPlaceholder}"
                                                       VerticalOptions="Center"
                                                       SemanticProperties.Description="{Binding SessionCountAccessibilityDescription}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Clearance Confirmation -->
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                        <Label Text="{loc:LocalizedText Workout_Generation_HiitClearanceConfirmation}"
                               Style="{StaticResource FormFieldLabel}"
                               LineBreakMode="WordWrap" />
                        <Border Style="{StaticResource PickerContainer}">
                            <Picker ItemsSource="{Binding HiitEvidenceCapture.ClearanceScreeningChoices}"
                                    SelectedItem="{Binding HiitEvidenceCapture.SelectedClearanceScreeningChoice}"
                                    ItemDisplayBinding="{Binding Label}"
                                    Title="{loc:LocalizedText Workout_Generation_ChooseEvidence}"
                                    IsEnabled="{Binding CanEditInputs}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="{loc:LocalizedText Workout_Generation_HiitClearanceConfirmation}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- CARD 2B: Swimming Evidence (Conditional) -->
            <Border IsVisible="{Binding IsSwimmingSelected}"
                    Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">

                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Workout_Generation_SwimmingEvidenceTitle}" IconGlyph="HeartCircle24" />
                        <Label Text="{loc:LocalizedText Workout_Generation_SwimmingEvidenceHelp}"
                               Style="{StaticResource MutedLabel}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                        <Label Text="{loc:LocalizedText Workout_Generation_SwimmingFacilityAccess}"
                               Style="{StaticResource FormFieldLabel}" />
                        <Border Style="{StaticResource PickerContainer}">
                            <Picker ItemsSource="{Binding EvidenceYesNoChoices}"
                                    SelectedItem="{Binding SelectedSwimmingFacilityAccessChoice}"
                                    ItemDisplayBinding="{Binding Label}"
                                    Title="{loc:LocalizedText Workout_Generation_ChooseEvidence}"
                                    IsEnabled="{Binding CanEditInputs}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="{loc:LocalizedText Workout_Generation_SwimmingFacilityAccess}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                        <Label Text="{loc:LocalizedText Workout_Generation_IndependentSwimming}"
                               Style="{StaticResource FormFieldLabel}" />
                        <Border Style="{StaticResource PickerContainer}">
                            <Picker ItemsSource="{Binding EvidenceYesNoChoices}"
                                    SelectedItem="{Binding SelectedIndependentSwimmingChoice}"
                                    ItemDisplayBinding="{Binding Label}"
                                    Title="{loc:LocalizedText Workout_Generation_ChooseEvidence}"
                                    IsEnabled="{Binding CanEditInputs}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="{loc:LocalizedText Workout_Generation_IndependentSwimming}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding CanChooseSwimmingStyle}" Spacing="{StaticResource UiSpaceTight}">
                        <Label Text="{loc:LocalizedText Workout_Generation_SwimmingStyle}"
                               Style="{StaticResource FormFieldLabel}" />
                        <Border Style="{StaticResource PickerContainer}">
                            <Picker ItemsSource="{Binding SwimmingStyleChoices}"
                                    SelectedItem="{Binding SelectedSwimmingStyleChoice}"
                                    ItemDisplayBinding="{Binding Label}"
                                    Title="{loc:LocalizedText Workout_Generation_ChooseEvidence}"
                                    IsEnabled="{Binding CanEditInputs}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="{loc:LocalizedText Workout_Generation_SwimmingStyle}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- CARD 2C: Rock Climbing Evidence (Conditional) -->
            <Border IsVisible="{Binding IsRockClimbingSelected}"
                    Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">

                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Workout_Generation_ClimbingEvidenceTitle}" IconGlyph="Dumbbell24" />
                        <Label Text="{loc:LocalizedText Workout_Generation_ClimbingEvidenceHelp}"
                               Style="{StaticResource MutedLabel}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                        <Label Text="{loc:LocalizedText Workout_Generation_RopeCompetence}"
                               Style="{StaticResource FormFieldLabel}" />
                        <Border Style="{StaticResource PickerContainer}">
                            <Picker ItemsSource="{Binding EvidenceYesNoChoices}"
                                    SelectedItem="{Binding SelectedRopeClimbingCompetenceChoice}"
                                    ItemDisplayBinding="{Binding Label}"
                                    Title="{loc:LocalizedText Workout_Generation_ChooseEvidence}"
                                    IsEnabled="{Binding CanEditInputs}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="{loc:LocalizedText Workout_Generation_RopeCompetence}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding ShouldAskClimbingInstruction}" Spacing="{StaticResource UiSpaceTight}">
                        <Label Text="{loc:LocalizedText Workout_Generation_ClimbingInstructionAvailable}"
                               Style="{StaticResource FormFieldLabel}" />
                        <Border Style="{StaticResource PickerContainer}">
                            <Picker ItemsSource="{Binding EvidenceYesNoChoices}"
                                    SelectedItem="{Binding SelectedClimbingInstructionChoice}"
                                    ItemDisplayBinding="{Binding Label}"
                                    Title="{loc:LocalizedText Workout_Generation_ChooseEvidence}"
                                    IsEnabled="{Binding CanEditInputs}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="{loc:LocalizedText Workout_Generation_ClimbingInstructionAvailable}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- CARD 2D: Yoga Evidence (Conditional) -->
            <Border IsVisible="{Binding IsYogaSelected}"
                    Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">

                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Workout_Generation_YogaEvidenceTitle}" IconGlyph="HeartCircle24" />
                        <Label Text="{loc:LocalizedText Workout_Generation_YogaEvidenceHelp}"
                               Style="{StaticResource MutedLabel}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                        <Label Text="{loc:LocalizedText Workout_Generation_YogaContentClassification}"
                               Style="{StaticResource FormFieldLabel}" />
                        <Border Style="{StaticResource PickerContainer}">
                            <Picker ItemsSource="{Binding YogaContentChoices}"
                                    SelectedItem="{Binding SelectedYogaContentChoice}"
                                    ItemDisplayBinding="{Binding Label}"
                                    Title="{loc:LocalizedText Workout_Generation_ChooseEvidence}"
                                    IsEnabled="{Binding CanEditInputs}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="{loc:LocalizedText Workout_Generation_YogaContentClassification}" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Recent history and optional input adjustments -->
            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Style="{StaticResource PlanFormSection}">
                    <sharedControls:IconSectionHeader
                        Text="{loc:LocalizedText Workout_Generation_ExperienceTitle}"
                        IconGlyph="Dumbbell24" />
                    <Label Text="{loc:LocalizedText Workout_Generation_ExperienceHelp}"
                           Style="{StaticResource PlanFormHelp}" />
                    <Label Text="{Binding RecentTrainingSummary}"
                           Style="{StaticResource MutedLabel}" />
                    <Label Text="{loc:LocalizedText Workout_Generation_RecentHistoryPeriodsTitle}"
                           Style="{StaticResource FormFieldLabel}" />
                    <HorizontalStackLayout
                        BindableLayout.ItemsSource="{Binding RecentTrainingWeeks}"
                        Spacing="{StaticResource UiSpaceTight}"
                        HorizontalOptions="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StrengthPlanRecentWeekDisplay">
                                <VerticalStackLayout
                                    Style="{StaticResource PlanHistoryWeekCell}"
                                    WidthRequest="{StaticResource UiDimension52}"
                                    SemanticProperties.Description="{Binding AccessibilityDescription}">
                                    <Label Text="{Binding Label}" Style="{StaticResource PlanHistoryWeekLabel}" />
                                    <Label Text="{Binding SessionCount}" Style="{StaticResource PlanHistoryWeekCount}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <Button Text="{Binding TrainingDetailsToggleText}"
                            Command="{Binding ToggleTrainingDetailsCommand}"
                            IsVisible="{Binding IsBeforePreview}"
                            Style="{StaticResource ButtonSecondary}"
                            HorizontalOptions="Start" />

                    <VerticalStackLayout
                        IsVisible="{Binding IsTrainingDetailsExpanded}"
                        Spacing="{StaticResource UiSpaceControl}">
                        <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                            <Label Text="{loc:LocalizedText Workout_Generation_ConsistentWeeks}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding ConsistentWeeks}"
                                       Placeholder="{loc:LocalizedText Workout_Generation_WeeksPlaceholder}"
                                       Keyboard="Numeric"
                                       IsEnabled="{Binding CanEditInputs}"
                                       SemanticProperties.Description="{loc:LocalizedText Workout_Generation_ConsistentWeeks}" />
                            </Border>
                            <Label Text="{loc:LocalizedText Workout_Generation_ConsistentWeeksHelp}"
                                   Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                            <Label Text="{loc:LocalizedText Workout_Generation_AverageSessions}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding AverageSessionsPerWeek}"
                                       Placeholder="{loc:LocalizedText Workout_Generation_SessionsPlaceholder}"
                                       Keyboard="Numeric"
                                       IsEnabled="{Binding CanEditInputs}"
                                       SemanticProperties.Description="{loc:LocalizedText Workout_Generation_AverageSessions}" />
                            </Border>
                            <Label Text="{loc:LocalizedText Workout_Generation_AverageSessionsHelp}"
                                   Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                            <Label Text="{loc:LocalizedText Workout_Generation_DaysSinceLast}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding DaysSinceLastSession}"
                                       Keyboard="Numeric"
                                       IsEnabled="{Binding CanEditInputs}"
                                       SemanticProperties.Description="{loc:LocalizedText Workout_Generation_DaysSinceLast}" />
                            </Border>
                            <Label Text="{loc:LocalizedText Workout_Generation_DaysSinceLastHelp}"
                                   Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource PlanStickyActionDivider}" />

                        <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                            <Label Text="{loc:LocalizedText Workout_Generation_TimingTitle}"
                                   Style="{StaticResource CardTitle}" />
                            <Label Text="{loc:LocalizedText Workout_Generation_TimingHelp}"
                                   Style="{StaticResource PlanFormHelp}" />
                        </VerticalStackLayout>

                        <Grid Style="{StaticResource PlanMetricRows}" RowDefinitions="Auto,Auto">
                            <Label Text="{loc:LocalizedText Workout_Generation_Warmup}"
                                   Style="{StaticResource PlanMetricLabel}" />
                            <Border Grid.Column="1" Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding WarmupMinutes}"
                                       Keyboard="Numeric"
                                       IsEnabled="{Binding CanEditInputs}"
                                       SemanticProperties.Description="{loc:LocalizedText Workout_Generation_Warmup}" />
                            </Border>

                            <Label Grid.Row="1" Text="{loc:LocalizedText Workout_Generation_Cooldown}"
                                   Style="{StaticResource PlanMetricLabel}" />
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding CooldownMinutes}"
                                       Keyboard="Numeric"
                                       IsEnabled="{Binding CanEditInputs}"
                                       SemanticProperties.Description="{loc:LocalizedText Workout_Generation_Cooldown}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Bottom Keep Current Plan Button -->
            <Button Text="{loc:LocalizedText Workout_Generation_KeepCurrentPlan}"
                    Command="{Binding KeepCurrentPlanCommand}"
                    Style="{StaticResource ButtonSecondary}" />
        </VerticalStackLayout>
    </ScrollView>

    <Label Grid.Row="1"
           Text="{Binding StatusMessage, Converter={StaticResource LocalizedStringConverter}}"
           IsVisible="{Binding HasStatusMessage}"
           Style="{StaticResource PlanStatusMessage}"
           LineBreakMode="WordWrap">
        <Label.Behaviors>
            <sharedControls:ScreenReaderStatusAnnouncementBehavior />
        </Label.Behaviors>
    </Label>

    <Border Grid.Row="2"
            IsVisible="{Binding IsBeforePreview}"
            Style="{StaticResource PlanStickyActionSurface}">
        <VerticalStackLayout Style="{StaticResource PlanStickyActionContent}">
            <BoxView Style="{StaticResource PlanStickyActionDivider}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />
            <Button Text="{loc:LocalizedText Workout_Generation_CreatePreview}"
                    Command="{Binding CreateProposalCommand}"
                    IsVisible="{Binding IsTrainNavigationPending, Converter={StaticResource InvertedBoolConverter}}"
                    Style="{StaticResource ButtonPrimary}" />
            <Button Text="{loc:LocalizedText Workout_Generation_OpenTrainAfterApply}"
                    Command="{Binding OpenTrainCommand}"
                    IsVisible="{Binding IsTrainNavigationPending}"
                    Style="{StaticResource ButtonPrimary}" />
        </VerticalStackLayout>
    </Border>

    </Grid>

    <!-- Hide the covered editor from input and accessibility while the preview is open. -->
    <Grid Grid.RowSpan="3"
          IsVisible="{Binding HasPreview}"
          BackgroundColor="{StaticResource ModalScrim}"
          ZIndex="10">
        <Border x:Name="PreviewSheet"
                Style="{StaticResource ModalSurface}" VerticalOptions="End">
            <Grid RowDefinitions="Auto,*,Auto" Style="{StaticResource ModalBody}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                        <sharedControls:IconSectionHeader Text="{loc:LocalizedText Workout_Generation_PreviewTitle}" IconGlyph="Target24" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Style="{StaticResource ModalIconButton}"
                            SemanticProperties.Description="{loc:LocalizedText Common_Close}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClosePreviewCommand}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">
                        <!-- Mixed Schedule Sub-Section -->
                        <VerticalStackLayout IsVisible="{Binding HasMixedSchedule}" Spacing="{StaticResource UiSpacing10}">
                            <Label Text="{loc:LocalizedText Workout_Generation_MixedScheduleTitle}"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="{StaticResource UiFontSize17}"
                                   FontAttributes="{StaticResource UiFontAttributesBold}"
                                   SemanticProperties.HeadingLevel="Level3" />
                            <Label Text="{loc:LocalizedText Workout_Generation_ScheduleEmpty}"
                                   IsVisible="{Binding HasNoMixedActivitySessions}"
                                   Style="{StaticResource MutedLabel}"
                                   LineBreakMode="WordWrap" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MixedActivitySessions}"
                                                 Spacing="{StaticResource UiSpaceTight}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MixedActivitySessionDisplay">
                                        <Border Style="{StaticResource CardSecondary}" SemanticProperties.Description="{Binding Title}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                                                <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                                                    <Label Text="{Binding Day}" Style="{StaticResource CaptionLabel}" />
                                                    <Label Text="{Binding Activity}" Style="{StaticResource BodyStrong}" LineBreakMode="WordWrap" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource AccentLabel}" VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <toolkit:Expander IsVisible="{Binding HasActivityDecisions}" IsExpanded="{Binding HasLimitation, Mode=OneWay}">
  <toolkit:Expander.Header>
    <Grid ColumnDefinitions="*,Auto" Style="{StaticResource DisclosureHeader}">
      <Label Text="{loc:LocalizedText Workout_Generation_ActivityDecisionsTitle}" Style="{StaticResource BodyStrong}" />
      <Label Grid.Column="1" Text="⌄" Style="{StaticResource MutedLabel}" />
    </Grid>
  </toolkit:Expander.Header>
  <toolkit:Expander.Content>
    <!-- Activity Decisions Sub-Section -->
                        <VerticalStackLayout IsVisible="{Binding HasActivityDecisions}" Spacing="{StaticResource UiSpacing10}">

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ActivityDecisions}"
                                                 Spacing="{StaticResource UiSpaceTight}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MixedActivityDecisionDisplay">
                                        <Border Style="{StaticResource CardSecondary}">
                                            <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                                                    <Label Text="{Binding Activity}" Style="{StaticResource BodyStrong}" LineBreakMode="WordWrap" />
                                                    <Label Grid.Column="1" Text="{Binding Frequency}"
                                                           IsVisible="{Binding HasFrequency}" Style="{StaticResource AccentLabel}" />
                                                </Grid>
                                                <Label Text="{Binding Status}" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
                                                <VerticalStackLayout IsVisible="{Binding HasReasons}"
                                                                     BindableLayout.ItemsSource="{Binding Reasons}"
                                                                     Spacing="{StaticResource UiSpacing2}">
                                                    <BindableLayout.ItemTemplate>
                                                         <DataTemplate x:DataType="x:String">
                                                             <Label Text="{Binding .}"
                                                                    Style="{StaticResource MutedLabel}"
                                                                    LineBreakMode="WordWrap" />
                                                         </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>


  </toolkit:Expander.Content>
</toolkit:Expander>
<!-- Scheduling Notes Sub-Section -->
                        <VerticalStackLayout IsVisible="{Binding HasScheduleInputReasons}" Spacing="{StaticResource UiSpacing10}">
                            <Label Text="{loc:LocalizedText Workout_Generation_SchedulingNotesTitle}"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="{StaticResource UiFontSize17}"
                                   FontAttributes="{StaticResource UiFontAttributesBold}"
                                   SemanticProperties.HeadingLevel="Level3" />
                            <Border Style="{StaticResource CardAccent}">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ScheduleInputReasons}"
                                                     Spacing="{StaticResource UiSpacing6}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding .}"
                                                   Style="{StaticResource MutedLabel}"
                                                   LineBreakMode="WordWrap" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <toolkit:Expander IsVisible="{Binding HasStrengthPreviewSessions}">
  <toolkit:Expander.Header>
    <Grid ColumnDefinitions="*,Auto" Style="{StaticResource DisclosureHeader}">
      <Label Text="{loc:LocalizedText Workout_Generation_StrengthDetailsTitle}" Style="{StaticResource BodyStrong}" />
      <Label Grid.Column="1" Text="⌄" Style="{StaticResource MutedLabel}" />
    </Grid>
  </toolkit:Expander.Header>
  <toolkit:Expander.Content>
    <!-- Strength Preview Sessions Sub-Section -->
                        <VerticalStackLayout IsVisible="{Binding HasStrengthPreviewSessions}" Spacing="{StaticResource UiSpaceCompact}">

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding StrengthPreviewSessions}"
                                                 Spacing="{StaticResource UiSpacing10}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StrengthPlanSessionDisplay">
                                        <Border Style="{StaticResource CardAccent}">
                                            <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                                                <VerticalStackLayout Spacing="{StaticResource UiSpacing2}">
                                                    <Label Text="{Binding Title}"
                                                           Style="{StaticResource FormFieldLabel}" />
                                                    <Label Text="{Binding Duration}"
                                                           Style="{StaticResource MutedLabel}" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Slots}" Spacing="{StaticResource UiSpacing6}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:StrengthPlanSlotDisplay">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" Padding="{StaticResource UiInsets0_4}">
                                                                <VerticalStackLayout Spacing="{StaticResource UiSpacing2}">
                                                                    <Label Text="{Binding Name}"
                                                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                                    <Label Text="{Binding Details}"
                                                                           Style="{StaticResource MutedLabel}" />
                                                                </VerticalStackLayout>
                                                                <Label Grid.Column="1"
                                                                       Text="{loc:LocalizedText Workout_Generation_Required}"
                                                                       IsVisible="{Binding IsRequired}"
                                                                       Style="{StaticResource CaptionStrong}"
                                                                       TextColor="{StaticResource Primary}"
                                                                       VerticalOptions="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>


  </toolkit:Expander.Content>
</toolkit:Expander>
<!-- High Intensity Confirmation Candidates Sub-Section -->
                        <VerticalStackLayout IsVisible="{Binding HasHighIntensityCandidates}"
                                             IsEnabled="{Binding CanAnswerHighIntensityCandidates}"
                                             Spacing="{StaticResource UiSpaceCompact}">
                            <Label Text="{loc:LocalizedText Workout_Generation_HighIntensityConfirmationTitle}"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="{StaticResource UiFontSize17}"
                                   FontAttributes="{StaticResource UiFontAttributesBold}"
                                   SemanticProperties.HeadingLevel="Level3" />
                            <Label Text="{loc:LocalizedText Workout_Generation_HighIntensityConfirmationHelp}"
                                   Style="{StaticResource MutedLabel}"
                                   LineBreakMode="WordWrap" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding HighIntensityCandidates}"
                                                 Spacing="{StaticResource UiSpacing10}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StrengthPlanHighIntensityCandidateDisplay">
                                        <Border Style="{StaticResource CardAccent}">
                                            <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                                                <Label Text="{Binding Name}"
                                                       Style="{StaticResource FormFieldLabel}" />
                                                <Label Text="{Binding Assignments}"
                                                       Style="{StaticResource MutedLabel}"
                                                       LineBreakMode="WordWrap" />

                                                <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                                                    <Label Text="{loc:LocalizedText Workout_Generation_FamiliarityQuestion}"
                                                           Style="{StaticResource FormFieldLabel}" />
                                                    <Border Style="{StaticResource PickerContainer}">
                                                        <Picker ItemsSource="{Binding AnswerChoices}"
                                                                SelectedItem="{Binding FamiliarityChoice}"
                                                                ItemDisplayBinding="{Binding Label}"
                                                                Title="{loc:LocalizedText Workout_Generation_ChooseEvidence}"
                                                                VerticalOptions="Center"
                                                                SemanticProperties.Description="{loc:LocalizedText Workout_Generation_FamiliarityQuestion}" />
                                                    </Border>
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                                                    <Label Text="{loc:LocalizedText Workout_Generation_ManageableLoadQuestion}"
                                                           Style="{StaticResource FormFieldLabel}" />
                                                    <Border Style="{StaticResource PickerContainer}">
                                                        <Picker ItemsSource="{Binding AnswerChoices}"
                                                                SelectedItem="{Binding ManageableLoadChoice}"
                                                                ItemDisplayBinding="{Binding Label}"
                                                                Title="{loc:LocalizedText Workout_Generation_ChooseEvidence}"
                                                                VerticalOptions="Center"
                                                                SemanticProperties.Description="{loc:LocalizedText Workout_Generation_ManageableLoadQuestion}" />
                                                    </Border>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Button Text="{loc:LocalizedText Workout_Generation_ConfirmHighIntensityExercises}"
                                    Command="{Binding ConfirmHighIntensityExercisesCommand}"
                                    IsEnabled="{Binding CanSubmitHighIntensityConfirmations}"
                                    Style="{StaticResource ButtonPrimary}" />
                        </VerticalStackLayout>

                        <!-- Limitations Sub-Section -->
                        <VerticalStackLayout IsVisible="{Binding HasLimitation}" Spacing="{StaticResource UiSpacing10}">
                            <Label Text="{loc:LocalizedText Workout_Generation_LimitationsTitle}"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="{StaticResource UiFontSize17}"
                                   FontAttributes="{StaticResource UiFontAttributesBold}"
                                   SemanticProperties.HeadingLevel="Level3" />
                            <Border Style="{StaticResource CardAccent}">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PreviewLimitations}" Spacing="{StaticResource UiSpaceMicro}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding .}"
                                                   Style="{StaticResource MutedLabel}"
                                                   LineBreakMode="WordWrap" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        </VerticalStackLayout>
                </ScrollView>
                <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource UiSpaceTight}">
                    <BoxView Style="{StaticResource PlanStickyActionDivider}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Center" />
                    <Label Text="{Binding StatusMessage, Converter={StaticResource LocalizedStringConverter}}"
                           IsVisible="{Binding HasStatusMessage}"
                           Style="{StaticResource MutedLabel}"
                           LineBreakMode="WordWrap">
                        <Label.Behaviors>
                            <sharedControls:ScreenReaderStatusAnnouncementBehavior />
                        </Label.Behaviors>
                    </Label>
                    <Button Text="{loc:LocalizedText Workout_Generation_EditDetails}"
                            Command="{Binding EditDetailsCommand}"
                            IsVisible="{Binding HasLimitation}"
                            Style="{StaticResource ButtonSecondary}" />
                    <Button Text="{loc:LocalizedText Workout_Generation_ApplyPlan}"
                            Command="{Binding AcceptProposalCommand}"
                            IsVisible="{Binding HasFeasiblePreview}"
                            Style="{StaticResource ButtonPrimary}" />
                    <Button Text="{loc:LocalizedText Workout_Generation_OpenTrainAfterApply}"
                            Command="{Binding OpenTrainCommand}"
                            IsVisible="{Binding IsTrainNavigationPending}"
                            Style="{StaticResource ButtonPrimary}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
    </Grid>
    <sharedControls:PageLoadingOverlay BackCommand="{Binding BackCommand}" />
    </Grid>
</ContentPage>
