<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Workout"
             xmlns:models="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
             xmlns:workoutControls="clr-namespace:MuscleCuties.UI.Controls.Workout"
             x:Class="MuscleCuties.UI.Pages.Workout.WorkoutSessionPage"
             x:Name="Root" x:DataType="vm:WorkoutSessionViewModel"
             Title="{loc:LocalizedText Workout_Session_HeaderTitle}" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
             SafeAreaEdges="All"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <ContentPage.Resources>
        <Style x:Key="SessionCard" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="12,14" />
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}" />
        </Style>
        <Style x:Key="SessionAccent" TargetType="Border" BasedOn="{StaticResource SessionCard}">
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource AccentSurfaceDark}}" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{StaticResource UiRadiusControl}" />
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
            <Setter Property="MinimumHeightRequest" Value="48" />
            <Setter Property="MinimumWidthRequest" Value="48" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ContentPage.Resources>
    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20,8,20,16" RowSpacing="12"
              IsEnabled="{Binding CanInteract}">
            <!-- Header row: back + day title -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                  IsVisible="{Binding IsDayOverview, Converter={StaticResource InvertedBoolConverter}}">
                <Button Text="{loc:LocalizedText Workout_Session_BackButton}" Command="{Binding BackCommand}"
                        Style="{StaticResource QuietButton}"
                        SemanticProperties.Hint="{loc:LocalizedText Workout_Session_NavigateBackAccessibility}" />
                <Label Grid.Column="1" Text="{Binding DayTitle, Converter={StaticResource LocalizedStringConverter}}"
                       Style="{StaticResource CaptionLabel}"
                       VerticalOptions="Center" HorizontalTextAlignment="End"
                       SemanticProperties.HeadingLevel="Level1" />
            </Grid>

            <!-- Validation and load feedback -->
            <Border Grid.Row="2" Style="{StaticResource SessionAccent}" IsVisible="{Binding HasError}"
                    SemanticProperties.Description="{loc:LocalizedText Workout_Session_ErrorMessageAccessibility}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Label Text="{Binding ErrorText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource BodyLabel}" />
                    <Button Grid.Row="1" Text="{loc:LocalizedText Workout_Session_TryAgainButton}" Command="{Binding RetryLoadCommand}"
                            IsVisible="{Binding IsDayOverview}" MinimumHeightRequest="48"
                            SemanticProperties.Hint="{loc:LocalizedText Workout_Session_RetryLoadingAccessibility}" />
                </Grid>
            </Border>

            <!-- Milestone feedback -->
            <Border Grid.Row="1" Style="{StaticResource SessionAccent}" IsVisible="{Binding HasCelebration}"
                    SemanticProperties.Description="{loc:LocalizedText Workout_Session_CelebrationTitle}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding CelebrationText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{loc:LocalizedText Workout_Session_OkButton}"
                            Command="{Binding DismissCelebrationCommand}"
                            Style="{StaticResource QuietButton}"
                            SemanticProperties.Hint="{loc:LocalizedText Workout_Session_DismissCelebrationAccessibility}" />
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <!-- ========== Day overview ========== -->
                <Grid IsVisible="{Binding IsDayOverview}" Margin="-20,-8,-20,-16">
                    <BoxView BackgroundColor="{StaticResource ModalScrim}" />
                    <Border Style="{StaticResource AppBottomSheetSurface}" VerticalOptions="Fill">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" Padding="20,20,20,24">
                        <Label Text="{loc:LocalizedText Workout_Session_ActivitiesTitle}"
                               Style="{StaticResource ModalTitle}" SemanticProperties.HeadingLevel="Level1" />
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="{loc:LocalizedText Workout_Session_NoActivitiesPlanned}"
                                   Style="{StaticResource BodyLabel}" IsVisible="{Binding HasNoActivities}" />
                            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding ActivityCards}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkoutActivitySectionItem">
                                        <Border Style="{StaticResource SessionCard}"
                                                SemanticProperties.Description="{Binding Title, Converter={StaticResource LocalizedStringConverter}}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding SelectActivityCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutSessionViewModel}}, x:DataType=vm:WorkoutSessionViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="5,*,Auto,16" ColumnSpacing="12"
                                                  MinimumHeightRequest="56">
                                                <BoxView Color="{Binding ActivityBackground}" CornerRadius="2"
                                                         HeightRequest="-1" VerticalOptions="Fill" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="4"
                                                                     VerticalOptions="Center">
                                                    <Label
                                                        Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                                        Style="{StaticResource BodyLabel}" FontSize="15"
                                                        FontAttributes="Bold" />
                                                    <Label
                                                        Text="{Binding SummaryText, Converter={StaticResource LocalizedStringConverter}}"
                                                        Style="{StaticResource CaptionLabel}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2"
                                                       Text="{Binding MetricText, Converter={StaticResource LocalizedStringConverter}}"
                                                       Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                                                <Path Grid.Column="3" Data="M1 1 L6 6 L1 11"
                                                      Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                      StrokeThickness="1.5" Aspect="Uniform" WidthRequest="6"
                                                      HeightRequest="12" VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                    <Button Grid.Row="2" Text="{loc:LocalizedText Workout_Session_FinishSessionButton}"
                            Command="{Binding FinishSessionCommand}"
                            MinimumHeightRequest="52"
                            SemanticProperties.Hint="{loc:LocalizedText Workout_Session_EndSessionAccessibility}" />
                    </Grid>
                    </Border>
                </Grid>

                <!-- ========== Activity intro ========== -->
                <Grid RowDefinitions="*,Auto" RowSpacing="16" IsVisible="{Binding IsActivityIntro}">
                    <ScrollView>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="20" Padding="0,16,0,8">
                            <Label
                                Text="{Binding SelectedActivity.Title, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource SectionTitle}" FontSize="22"
                                HorizontalTextAlignment="Center"
                                SemanticProperties.HeadingLevel="Level2" />
                            <Label Grid.Row="1"
                                   Text="{Binding SelectedActivity.MetricText, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="2"
                                   Text="{Binding ActivityIntroIntensity, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Session_IntensityFormat}"
                                   Style="{StaticResource BodyLabel}" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Row="3" Spacing="14"
                                                 BindableLayout.ItemsSource="{Binding ExercisePreviewNames}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label Text="{Binding .}" Style="{StaticResource BodyLabel}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Border Grid.Row="4" Style="{StaticResource SessionAccent}">
                                <Label
                                    Text="{Binding CyclePhaseNote, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource BodyLabel}" />
                            </Border>
                        </Grid>
                    </ScrollView>
                    <Button Grid.Row="1" Text="{loc:LocalizedText Workout_Session_StartButton}"
                            Command="{Binding StartActivityCommand}"
                            IsEnabled="{Binding SelectedActivity.HasExercises}"
                            CornerRadius="{StaticResource UiRadiusControl}" MinimumHeightRequest="52"
                            SemanticProperties.Hint="{loc:LocalizedText Workout_Session_BeginActivityAccessibility}" />
                </Grid>

                <!-- ========== One exercise at a time ========== -->
                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12" IsVisible="{Binding IsExerciseFlow}">
                    <!-- Progress bar and navigation dots -->
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="{Binding ExercisePositionText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                SemanticProperties.HeadingLevel="Level2"
                                SemanticProperties.Description="{Binding ExercisePositionText, Converter={StaticResource LocalizedStringConverter}}" />
                            <Button Grid.Column="1" Text="{loc:LocalizedText Workout_Session_PreviousExerciseButton}"
                                    Command="{Binding PreviousExerciseCommand}"
                                    Style="{StaticResource QuietButton}"
                                    SemanticProperties.Hint="{loc:LocalizedText Workout_Session_GoToPrevExerciseAccessibility}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding CurrentExerciseIndex}" Value="0">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ExerciseProgress}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionExerciseProgress">
                                        <!-- Small dots sit inside full-size touch targets. -->
                                        <Grid WidthRequest="48" HeightRequest="48"
                                              SemanticProperties.Description="{Binding AccessibilityText, Converter={StaticResource LocalizedStringConverter}}">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding JumpToExerciseCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutSessionViewModel}}, x:DataType=vm:WorkoutSessionViewModel}"
                                                    CommandParameter="{Binding Index}" />
                                            </Grid.GestureRecognizers>
                                            <Border WidthRequest="10" HeightRequest="10" StrokeShape="RoundRectangle 5"
                                                    StrokeThickness="0" HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor"
                                                                Value="{StaticResource Primary}" />
                                                        <Setter Property="Opacity" Value="0.3" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsLogged}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor"
                                                                Value="{StaticResource Primary}" />
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSkipped}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                                        <Setter Property="Stroke"
                                                                Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                        <Setter Property="StrokeThickness" Value="1" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- Exercise detail + logging inputs -->
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="16" Padding="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <mi:MauiIcon Icon="{mi:Fluent Dumbbell24}" IconSize="24"
                                             IconColor="{StaticResource Primary}" WidthRequest="28" HeightRequest="28"
                                             VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding CurrentExercise.Name}"
                                       Style="{StaticResource SectionTitle}" FontSize="22"
                                       SemanticProperties.HeadingLevel="Level3"
                                       SemanticProperties.Description="{Binding CurrentExercise.Name}" />
                            </Grid>
                            <Border StrokeShape="RoundRectangle 14" StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource ActivityUnselectedStrokeLight}, Dark={StaticResource Gray800}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}"
                                    HeightRequest="156">
                                <Grid>
                                    <mi:MauiIcon Icon="{mi:Fluent Dumbbell24}" IconSize="48"
                                                 IconColor="{StaticResource Primary}" WidthRequest="52" HeightRequest="52"
                                                 HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <Label
                                Text="{Binding CurrentExercise.TargetText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource BodyLabel}"
                                SemanticProperties.Description="{Binding CurrentExercise.TargetText, Converter={StaticResource LocalizedStringConverter}}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalOptions="Start">
                                <Path Data="M2 4 L8 10 L14 4" Stroke="{StaticResource Primary}"
                                      StrokeThickness="2" WidthRequest="16" HeightRequest="16"
                                      VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="{Binding TipsButtonText, Converter={StaticResource LocalizedStringConverter}}"
                                        Command="{Binding ToggleTipsCommand}" Style="{StaticResource QuietButton}"
                                        SemanticProperties.Hint="{loc:LocalizedText Workout_Session_ToggleTipsAccessibility}" />
                            </Grid>
                            <Border Style="{StaticResource SessionAccent}" IsVisible="{Binding IsTipsExpanded}">
                                <VerticalStackLayout Spacing="12">
                                    <Label
                                        Text="{Binding CurrentExercise.WhyText, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource BodyLabel}" />
                                    <Label Text="{Binding CurrentExercise.CuesText}" Style="{StaticResource BodyLabel}" />
                                    <Label Text="{Binding CurrentExercise.QuickTipsText}"
                                           IsVisible="{Binding CurrentExercise.HasQuickTips}"
                                           Style="{StaticResource BodyLabel}" />
                                </VerticalStackLayout>
                            </Border>
                            <Label
                                Text="{Binding CurrentExercise.PreviousText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Session_PreviousWeightFormat}"
                                Style="{StaticResource BodyLabel}"
                                SemanticProperties.Description="{Binding CurrentExercise.PreviousText, Converter={StaticResource LocalizedStringConverter}}" />
                            <Label
                                Text="{Binding CurrentExercise.RecommendationText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource CaptionLabel}"
                                SemanticProperties.Description="{Binding CurrentExercise.RecommendationText, Converter={StaticResource LocalizedStringConverter}}" />
                            <VerticalStackLayout BindingContext="{Binding CurrentExercise}"
                                                 x:DataType="models:WorkoutExerciseItem" Spacing="12">
                                <Border Style="{StaticResource SessionAccent}">
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{loc:LocalizedText Workout_Readiness_OptionalExercise}" Style="{StaticResource BodyLabel}"
                                                   VerticalOptions="Center" />
                                            <Switch IsToggled="{Binding IsOptional, Mode=TwoWay}"
                                                    IsEnabled="{Binding CanMarkOptional}"
                                                    Toggled="OnOptionalExerciseToggled" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsOptional}">
                                            <Label Text="{loc:LocalizedText Workout_Readiness_OptionalSets}" Style="{StaticResource BodyLabel}"
                                                   VerticalOptions="Center" />
                                            <Stepper Minimum="0" Maximum="{Binding MaxOptionalSets}"
                                                     Increment="1" Value="{Binding OptionalSets, Mode=TwoWay}"
                                                     IsEnabled="{Binding CanMarkOptional}"
                                                     ValueChanged="OnOptionalSetsChanged" />
                                            <Label Text="{Binding OptionalSets}" Style="{StaticResource BodyLabel}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{loc:LocalizedText Workout_Readiness_OneRequiredSetHint}"
                                               Style="{StaticResource CaptionLabel}" IsVisible="{Binding IsOptional}" />
                                    </VerticalStackLayout>
                                </Border>
                                <!-- Strength inputs -->
                                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" RowDefinitions="Auto, Auto"
                                      RowSpacing="4" IsVisible="{Binding UsesStrengthMetrics}">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{loc:LocalizedText Workout_Session_SetsHeader}"
                                           Style="{StaticResource CaptionLabel}" />
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource WorkoutMetricInput}">
                                        <Entry SemanticProperties.Description="{loc:LocalizedText Workout_Session_SetsCompletedAccessibility}"
                                               Text="{Binding LoggedSetsText, Mode=TwoWay}"
                                               Keyboard="Numeric" FontSize="15" Placeholder="0"
                                               ReturnType="Next" />
                                    </Border>

                                    <Label Grid.Row="0" Grid.Column="1" Text="{loc:LocalizedText Workout_Session_RepsHeader}"
                                           Style="{StaticResource CaptionLabel}" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource WorkoutMetricInput}">
                                        <Entry SemanticProperties.Description="{loc:LocalizedText Workout_Session_RepsPerSetAccessibility}"
                                               Text="{Binding LoggedRepsText, Mode=TwoWay}"
                                               Keyboard="Numeric" FontSize="15" Placeholder="0"
                                               ReturnType="Next" />
                                    </Border>

                                    <Label Grid.Row="0" Grid.Column="2" Text="{loc:LocalizedText Workout_Session_KgUnit}"
                                           Style="{StaticResource CaptionLabel}" IsVisible="{Binding UsesWeight}" />
                                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource WorkoutMetricInput}"
                                            IsVisible="{Binding UsesWeight}">
                                        <Entry SemanticProperties.Description="{loc:LocalizedText Workout_Session_WeightInKgAccessibility}"
                                               Text="{Binding LoggedWeightText, Mode=TwoWay}"
                                               Placeholder="0" Keyboard="Numeric" FontSize="15"
                                               ReturnType="Done" />
                                    </Border>
                                </Grid>

                                <!-- Duration input -->
                                <VerticalStackLayout Spacing="4" IsVisible="{Binding UsesDurationOnlyMetric}">
                                    <Label
                                        Text="{Binding DurationLabel, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource CaptionLabel}" />
                                    <Border Style="{StaticResource WorkoutMetricInput}">
                                        <Entry SemanticProperties.Description="{loc:LocalizedText Workout_Session_DurationInMinutesAccessibility}"
                                               Text="{Binding LoggedDurationMinutesText, Mode=TwoWay}"
                                               Keyboard="Numeric" FontSize="15" Placeholder="0"
                                               ReturnType="Done" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Cardio inputs -->
                                <Grid
                                    RowDefinitions="Auto, Auto, Auto, Auto"
                                    ColumnDefinitions="*, *"
                                    RowSpacing="6"
                                    ColumnSpacing="8"
                                    IsVisible="{Binding UsesCardioMetricGrid}">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4"
                                                         IsVisible="{Binding UsesDurationMetric}">
                                        <Label
                                            Text="{Binding DurationLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}" />
                                        <Border Style="{StaticResource WorkoutMetricInput}">
                                            <Entry SemanticProperties.Description="{loc:LocalizedText Workout_Session_DurationInMinutesAccessibility}"
                                                   Text="{Binding LoggedDurationMinutesText, Mode=TwoWay}"
                                                   Keyboard="Numeric" FontSize="15" Placeholder="0"
                                                   ReturnType="Next" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4"
                                                         IsVisible="{Binding UsesDistanceMetric}">
                                        <Label
                                            Text="{Binding DistanceLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}" />
                                        <Border Style="{StaticResource WorkoutMetricInput}">
                                            <Entry
                                                SemanticProperties.Description="{Binding DistanceLabel, Converter={StaticResource LocalizedStringConverter}}"
                                                Text="{Binding LoggedDistanceKmText, Mode=TwoWay}"
                                                Keyboard="Numeric" FontSize="15" Placeholder="0"
                                                ReturnType="Next" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4"
                                                         IsVisible="{Binding UsesPaceMetric}">
                                        <Label
                                            Text="{Binding PaceLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}" />
                                        <Border Style="{StaticResource WorkoutMetricInput}">
                                            <Entry
                                                SemanticProperties.Description="{Binding PaceLabel, Converter={StaticResource LocalizedStringConverter}}"
                                                Text="{Binding LoggedPaceText, Mode=TwoWay}"
                                                Placeholder="6:30" FontSize="15"
                                                ReturnType="Next" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4"
                                                         IsVisible="{Binding UsesHeartRateMetric}">
                                        <Label
                                            Text="{Binding HeartRateLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}" />
                                        <Border Style="{StaticResource WorkoutMetricInput}">
                                            <Entry SemanticProperties.Description="{loc:LocalizedText Workout_Session_HeartRateAccessibility}"
                                                   Text="{Binding LoggedHeartRateText, Mode=TwoWay}"
                                                   Keyboard="Numeric" FontSize="15" Placeholder="0"
                                                   ReturnType="Next" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4"
                                                         IsVisible="{Binding UsesPowerMetric}">
                                        <Label
                                            Text="{Binding PowerLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}" />
                                        <Border Style="{StaticResource WorkoutMetricInput}">
                                            <Entry SemanticProperties.Description="{loc:LocalizedText Workout_Session_WattsAccessibility}"
                                                   Text="{Binding LoggedPowerWattsText, Mode=TwoWay}"
                                                   Keyboard="Numeric" FontSize="15" Placeholder="0"
                                                   ReturnType="Next" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4"
                                                         IsVisible="{Binding UsesCadenceMetric}">
                                        <Label
                                            Text="{Binding CadenceLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}" />
                                        <Border Style="{StaticResource WorkoutMetricInput}">
                                            <Entry SemanticProperties.Description="{loc:LocalizedText Workout_Session_CadenceAccessibility}"
                                                   Text="{Binding LoggedCadenceRpmText, Mode=TwoWay}"
                                                   Keyboard="Numeric" FontSize="15" Placeholder="0"
                                                   ReturnType="Next" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4"
                                                         IsVisible="{Binding UsesEffortMetric}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <Label
                                                Text="{Binding EffortLabel, Converter={StaticResource LocalizedStringConverter}}"
                                                Style="{StaticResource CaptionLabel}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding EffortDisplayText, Converter={StaticResource LocalizedStringConverter}}"
                                                   Style="{StaticResource BodyLabel}"
                                                   FontAttributes="Bold" />
                                        </Grid>
                                        <Slider Minimum="1" Maximum="10"
                                                Value="{Binding EffortSliderValue, Mode=TwoWay}"
                                                DragCompleted="OnEffortDragCompleted"
                                                MinimumTrackColor="{StaticResource Primary}"
                                                MaximumTrackColor="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                                                ThumbColor="{StaticResource Primary}"
                                                SemanticProperties.Description="{loc:LocalizedText Workout_Session_EffortRatingAccessibility}"
                                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_AdjustWholeNumberAccessibility}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{loc:LocalizedText Workout_Session_RpeLightLabel}"
                                                   Style="{StaticResource CaptionLabel}" />
                                            <Label Grid.Column="1" Text="{loc:LocalizedText Workout_Session_RpeVeryHardLabel}"
                                                   Style="{StaticResource CaptionLabel}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>


                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <VerticalStackLayout Grid.Row="2" Spacing="6">
                        <Button Text="{loc:LocalizedText Workout_Session_Start60SecRestAccessibility}" Command="{Binding StartRestTimerCommand}"
                                IsVisible="{Binding IsRestTimerVisible, Converter={StaticResource InvertedBoolConverter}}"
                                Style="{StaticResource ButtonSecondary}">
                            <Button.CommandParameter>
                                <x:Int32>60</x:Int32>
                            </Button.CommandParameter>
                        </Button>
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsRestTimerVisible}">
                            <Label
                                Text="{Binding RestTimerDisplay, Converter={StaticResource LocalizedStringConverter}}"
                                HorizontalTextAlignment="Center"
                                SemanticProperties.Description="{loc:LocalizedText Workout_Session_RestTimerCountdownAccessibility}" />
                            <ProgressBar Progress="{Binding RestTimerProgress}" />
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Button Text="{loc:LocalizedText Workout_Session_PauseButton}"
                                        Command="{Binding PauseRestTimerCommand}"
                                        IsVisible="{Binding IsRestTimerRunning}" Style="{StaticResource QuietButton}" />
                                <Button Text="{loc:LocalizedText Workout_Session_ResumeButton}"
                                        Command="{Binding ResumeRestTimerCommand}"
                                        IsVisible="{Binding IsRestTimerRunning, Converter={StaticResource InvertedBoolConverter}}"
                                        Style="{StaticResource QuietButton}" />
                                <Button Text="{loc:LocalizedText Workout_Session_Plus30SecButton}"
                                        Command="{Binding AddRestTimerSecondsCommand}"
                                        Style="{StaticResource QuietButton}">
                                    <Button.CommandParameter>
                                        <x:Int32>30</x:Int32>
                                    </Button.CommandParameter>
                                </Button>
                                <Button Text="{loc:LocalizedText Workout_Session_DoneButton}" Command="{Binding StopRestTimerCommand}"
                                        Style="{StaticResource QuietButton}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Bottom action bar: Swap / Skip / Next -->
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Button Text="{loc:LocalizedText Workout_Session_SwapButton}" Command="{Binding OpenSwapPanelCommand}"
                                Style="{StaticResource ButtonSecondary}"
                                IsVisible="{Binding CurrentExercise.UsesStrengthMetrics}"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_SwapExerciseAccessibility}" />
                        <Button Grid.Column="1" Text="{loc:LocalizedText Workout_Session_SkipButton}"
                                Command="{Binding SkipExerciseCommand}" Style="{StaticResource QuietButton}"
                                HorizontalOptions="Center"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_SkipExerciseAccessibility}" />
                        <Button Grid.Column="2" Text="{loc:LocalizedText Workout_Session_NextExerciseButton}"
                                Command="{Binding NextExerciseCommand}" MinimumHeightRequest="52" Padding="20,8"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_SaveAndNextAccessibility}" />
                    </Grid>
                </Grid>

                <!-- ========== Activity summary ========== -->
                <Grid RowDefinitions="*,Auto" RowSpacing="16" IsVisible="{Binding IsActivitySummary}">
                    <ScrollView>
                        <VerticalStackLayout Spacing="24" Padding="0,24">
                            <Border x:Name="CompletionBadge" WidthRequest="64" HeightRequest="64"
                                    StrokeShape="RoundRectangle 32" StrokeThickness="0"
                                    BackgroundColor="{StaticResource Primary}" HorizontalOptions="Center">
                                <Path Data="M2 12 L8 18 L22 3" Stroke="White" StrokeThickness="3"
                                      StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                                      HeightRequest="32" WidthRequest="32" HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      SemanticProperties.Description="{loc:LocalizedText Workout_Session_CheckmarkAccessibility}" />
                            </Border>
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="{Binding SummaryTitle, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource SectionTitle}" FontSize="24"
                                    HorizontalTextAlignment="Center"
                                    SemanticProperties.HeadingLevel="Level2" />
                                <Label
                                    Text="{Binding SelectedActivity.Title, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource BodyLabel}" HorizontalTextAlignment="Center" />
                                <Label
                                    Text="{Binding SummaryStatusText, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center"
                                    SemanticProperties.Description="{Binding SummaryStatusText, Converter={StaticResource LocalizedStringConverter}}" />
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border Style="{StaticResource SessionAccent}"
                                        SemanticProperties.Description="{Binding SummaryTotalVolume, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Session_TotalVolumeFormat}">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                        <Label
                                            Text="{Binding SummaryTotalVolume, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                                        <Label Grid.Row="1" Text="{loc:LocalizedText Workout_Session_VolumeHeader}"
                                               Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SessionAccent}"
                                        SemanticProperties.Description="{Binding SummaryPrCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Session_WeightPrsFormat}">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                        <Label
                                            Text="{Binding SummaryPrCount, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                                        <Label Grid.Row="1" Text="{loc:LocalizedText Workout_Session_WeightPrsTitle}"
                                               Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SessionAccent}"
                                        SemanticProperties.Description="{Binding SummaryDuration, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Session_TimeFormat}">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                        <Label
                                            Text="{Binding SummaryDuration, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                                        <Label Grid.Row="1" Text="{loc:LocalizedText Workout_Session_TimeLabel}"
                                               Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </ScrollView>
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Button Text="{loc:LocalizedText Workout_Session_ContinueButton}" Command="{Binding FinishActivityCommand}"
                                MinimumHeightRequest="52"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_ReturnToActivitiesAccessibility}" />
                        <Button Grid.Row="1" Text="{loc:LocalizedText Workout_Session_FinishSessionButton}"
                                Command="{Binding FinishSessionCommand}" Style="{StaticResource QuietButton}"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_EndSessionAccessibility}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <toolkit:LazyView
            x:Name="SwapPanelLazy"
            x:TypeArguments="workoutControls:WorkoutSwapPanel"
            InputTransparent="{Binding IsSwapPanelVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#40000000"
              SemanticProperties.Description="{loc:LocalizedText Workout_Session_LoadingOverlayAccessibility}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" WidthRequest="48"
                               HeightRequest="48"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               SemanticProperties.Description="{loc:LocalizedText Workout_Session_SavingLoadingAccessibility}" />
        </Grid>
    </Grid>
</ContentPage>
