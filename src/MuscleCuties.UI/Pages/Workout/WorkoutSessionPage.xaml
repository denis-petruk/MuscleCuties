<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Workout"
             xmlns:models="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
             xmlns:workoutControls="clr-namespace:MuscleCuties.UI.Controls.Workout"
             xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
             x:Class="MuscleCuties.UI.Pages.Workout.WorkoutSessionPage"
             x:Name="Root" x:DataType="vm:WorkoutSessionViewModel"
             Title="{loc:LocalizedText Workout_Session_HeaderTitle}" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
             SafeAreaEdges="All"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="{DynamicResource PresentationPageContentPadding}" RowSpacing="{StaticResource UiSpaceCompact}"
              IsEnabled="{Binding CanInteract}">
            <!-- Header row: back + day title -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpaceTight}">
                <Button Text="{loc:LocalizedText Workout_Session_BackButton}" Command="{Binding BackCommand}"
                        Style="{StaticResource ButtonSecondary}"
                        SemanticProperties.Hint="{loc:LocalizedText Workout_Session_NavigateBackAccessibility}" />
                <Label LineBreakMode="WordWrap" Grid.Column="1" Text="{Binding DayTitle, Converter={StaticResource LocalizedStringConverter}}"
                       Style="{StaticResource CaptionLabel}"
                       VerticalOptions="Center" HorizontalTextAlignment="End"
                       SemanticProperties.HeadingLevel="Level1" />
            </Grid>

            <!-- Validation and load feedback -->
            <Border Grid.Row="2" Style="{StaticResource CardSecondary}" IsVisible="{Binding HasError}"
                    SemanticProperties.Description="{loc:LocalizedText Workout_Session_ErrorMessageAccessibility}">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpaceTight}">
                    <Label LineBreakMode="WordWrap" Text="{Binding ErrorText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource BodyLabel}" />
                    <Label LineBreakMode="WordWrap" Grid.Row="1" Text="{Binding ErrorReference}"
                           Style="{StaticResource CaptionLabel}"
                           IsVisible="{Binding HasErrorReference}"
                           SemanticProperties.Description="{loc:LocalizedText Workout_Session_ErrorReferenceAccessibility}" />
                    <Button Style="{StaticResource ButtonSecondary}" Grid.Row="2" Text="{loc:LocalizedText Workout_Session_TryAgainButton}" Command="{Binding RetryLoadCommand}"
                            SemanticProperties.Hint="{loc:LocalizedText Workout_Session_RetryLoadingAccessibility}" />
                </Grid>
            </Border>

            <!-- Milestone feedback -->
            <Border Grid.Row="1" Style="{StaticResource CardSecondary}" IsVisible="{Binding HasCelebration}"
                    SemanticProperties.Description="{loc:LocalizedText Workout_Session_CelebrationTitle}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                    <Label LineBreakMode="WordWrap" Text="{Binding CelebrationText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{loc:LocalizedText Workout_Session_OkButton}"
                            Command="{Binding DismissCelebrationCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            SemanticProperties.Hint="{loc:LocalizedText Workout_Session_DismissCelebrationAccessibility}" />
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <!-- ========== Activity intro ========== -->
                <Grid RowDefinitions="*,Auto" RowSpacing="{StaticResource UiSpaceControl}" IsVisible="{Binding IsActivityIntro}">
                    <ScrollView>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing20}" Padding="{StaticResource UiInsets0_16_0_8}">
                            <Label LineBreakMode="WordWrap"
                                Text="{Binding SelectedActivity.Title, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource SectionTitle}"
                                HorizontalTextAlignment="Center"
                                SemanticProperties.HeadingLevel="Level2" />
                            <Label LineBreakMode="WordWrap" Grid.Row="1"
                                   Text="{Binding SelectedActivity.MetricText, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource CaptionCentered}" />
                            <Label LineBreakMode="WordWrap" Grid.Row="2"
                                   Text="{Binding ActivityIntroIntensity, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Session_IntensityFormat}"
                                   IsVisible="{Binding HasNoActivityPrescription}"
                                   Style="{StaticResource BodyCentered}" />
                            <Label Grid.Row="3" Text="{Binding ActivityPrescriptionText}" Style="{StaticResource BodyCentered}" LineBreakMode="WordWrap" />
                            <VerticalStackLayout Grid.Row="4" Spacing="{StaticResource UiSpaceCompact}"
                                                 BindableLayout.ItemsSource="{Binding ExercisePreviewNames}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label LineBreakMode="WordWrap" Text="{Binding .}" Style="{StaticResource BodyLabel}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Border Grid.Row="5" Style="{StaticResource CardSecondary}">
                                <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                                    <Label LineBreakMode="WordWrap"
                                           Text="{Binding DoseAdjustmentNote}"
                                           IsVisible="{Binding HasDoseAdjustmentNote}"
                                           Style="{StaticResource BodyLabel}" />
                                    <Label LineBreakMode="WordWrap"
                                           Text="{loc:LocalizedText Workout_Session_NoActivitiesPlanned}"
                                           IsVisible="{Binding HasNoActivities}"
                                           Style="{StaticResource BodyLabel}" />
                                    <Label LineBreakMode="WordWrap"
                                        Text="{Binding CyclePhaseNote, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource BodyLabel}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </ScrollView>
                    <VerticalStackLayout Grid.Row="1" Spacing="{StaticResource UiSpaceTight}">
                        <Button Style="{StaticResource ButtonPrimary}" Text="{loc:LocalizedText Workout_Session_StartButton}"
                                Command="{Binding StartActivityCommand}" IsEnabled="{Binding CanStartActivity}" IsVisible="{Binding IsTimedActivityRunning, Converter={StaticResource InvertedBoolConverter}}"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_BeginActivityAccessibility}" />
                        <Button Style="{StaticResource ButtonSecondary}" Text="{loc:LocalizedText Workout_Session_AbandonActivity}"
                                Command="{Binding AbandonPlannedSessionCommand}" IsVisible="{Binding CanAbandonPlannedSession}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- ========== Timed activity: visible running state ========== -->
                <Grid RowDefinitions="*,Auto" RowSpacing="{StaticResource UiSpaceControl}" IsVisible="{Binding IsTimedActivityScreen}">
                    <ScrollView>
                        <VerticalStackLayout Spacing="{StaticResource UiSpaceContent}" Padding="{StaticResource UiInsets0_24}">
                            <Label LineBreakMode="WordWrap"
                                   Text="{Binding SelectedActivity.Title, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource SectionTitle}"
                                   HorizontalTextAlignment="Center"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <Label LineBreakMode="WordWrap"
                                   Text="{Binding TimedActivityPhaseKey, Converter={StaticResource LocalizedStringConverter}}"
                                   IsVisible="{Binding HasTimedActivityPhase}"
                                   Style="{StaticResource BodyCentered}"
                                   SemanticProperties.HeadingLevel="Level3" />
                            <Border Style="{StaticResource CardSecondary}">
                                <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}" HorizontalOptions="Fill">
                                    <Label Text="{Binding TimedActivityElapsedText}"
                                           Style="{StaticResource WorkoutNumber}"
                                           HorizontalTextAlignment="Center"
                                           SemanticProperties.Description="{loc:LocalizedText Workout_Session_TimedElapsedAccessibility}" />
                                    <Label LineBreakMode="WordWrap"
                                           Text="{Binding TimedActivityElapsedText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Session_TimedElapsedFormat}"
                                           Style="{StaticResource CaptionCentered}" />
                                    <Label LineBreakMode="WordWrap"
                                           Text="{Binding TimedActivityRemainingText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Session_TimedRemainingFormat}"
                                           IsVisible="{Binding HasTimedActivityCountdown}"
                                           Style="{StaticResource BodyCentered}" />
                                    <ProgressBar Progress="{Binding TimedActivityProgressValue}"
                                                 IsVisible="{Binding HasTimedActivityCountdown}"
                                                 SemanticProperties.Description="{loc:LocalizedText Workout_Session_TimedProgressAccessibility}" />
                                </VerticalStackLayout>
                            </Border>
                            <Label LineBreakMode="WordWrap"
                                   Text="{loc:LocalizedText Workout_Session_TimedNoPhases}"
                                   IsVisible="{Binding HasTimedActivityPhase, Converter={StaticResource InvertedBoolConverter}}"
                                   Style="{StaticResource MutedLabel}"
                                   HorizontalTextAlignment="Center" />
                            <Label LineBreakMode="WordWrap" Text="{Binding ActivityPrescriptionText}"
                                   Style="{StaticResource BodyCentered}" />
                        </VerticalStackLayout>
                    </ScrollView>
                    <VerticalStackLayout Grid.Row="1" Spacing="{StaticResource UiSpaceTight}">
                        <Button Style="{StaticResource ButtonPrimary}" Text="{loc:LocalizedText Workout_Session_FinishTimedActivity}"
                                Command="{Binding FinishTimedActivityCommand}"
                                IsEnabled="{Binding CanInteract}"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_FinishTimedActivityAccessibility}" />
                        <Button Style="{StaticResource ButtonSecondary}" Text="{loc:LocalizedText Workout_Session_PauseButton}"
                                Command="{Binding PauseTimedActivityCommand}"
                                IsVisible="{Binding IsTimedActivityPaused, Converter={StaticResource InvertedBoolConverter}}" />
                        <Button Style="{StaticResource ButtonSecondary}" Text="{loc:LocalizedText Workout_Session_ResumeButton}"
                                Command="{Binding ResumeTimedActivityCommand}"
                                IsVisible="{Binding IsTimedActivityPaused}" />
                        <Button Style="{StaticResource ButtonSecondary}" Text="{loc:LocalizedText Workout_Session_AbandonActivity}"
                                Command="{Binding AbandonPlannedSessionCommand}" IsVisible="{Binding CanAbandonPlannedSession}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- ========== One exercise at a time ========== -->
                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="{StaticResource UiSpaceCompact}" IsVisible="{Binding IsExerciseFlow}">
                    <!-- Progress bar and navigation dots -->
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label LineBreakMode="WordWrap"
                                Text="{Binding ExercisePositionText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                SemanticProperties.HeadingLevel="Level2"
                                SemanticProperties.Description="{Binding ExercisePositionText, Converter={StaticResource LocalizedStringConverter}}" />
                            <Button Grid.Column="1" Text="{loc:LocalizedText Workout_Session_PreviousExerciseButton}"
                                    Command="{Binding PreviousExerciseCommand}"
                                    Style="{StaticResource ButtonSecondary}"
                                    SemanticProperties.Hint="{loc:LocalizedText Workout_Session_GoToPrevExerciseAccessibility}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding CurrentExerciseIndex}" Value="0">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ExerciseProgress}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionExerciseProgress">
                                        <!-- Small dots sit inside full-size touch targets. -->
                                        <Grid WidthRequest="{StaticResource UiDimension48}" HeightRequest="{StaticResource UiDimension48}"
                                              SemanticProperties.Description="{Binding AccessibilityText, Converter={StaticResource LocalizedStringConverter}}">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding JumpToExerciseCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutSessionViewModel}}, x:DataType=vm:WorkoutSessionViewModel}"
                                                    CommandParameter="{Binding Index}" />
                                            </Grid.GestureRecognizers>
                                            <Border WidthRequest="{StaticResource UiDimension10}" HeightRequest="{StaticResource UiDimension10}" StrokeShape="{StaticResource UiRoundRectangleRadius5}"
                                                    StrokeThickness="{StaticResource UiStrokeWidth0}" HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor"
                                                                Value="{StaticResource Primary}" />
                                                        <Setter Property="Opacity" Value="0.3" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsLogged}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor"
                                                                Value="{StaticResource Primary}" />
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSkipped}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Transparent}" />
                                                        <Setter Property="Stroke"
                                                                Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                        <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth1}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- Exercise detail + logging inputs -->
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}" Padding="{StaticResource UiInsets0_0_0_12}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}">
                                <mi:MauiIcon Icon="{mi:Fluent Dumbbell24}" IconSize="{StaticResource UiDimension24}"
                                             IconColor="{StaticResource Primary}" WidthRequest="{StaticResource UiDimension28}" HeightRequest="{StaticResource UiDimension28}"
                                             VerticalOptions="Center" />
                                <Label LineBreakMode="WordWrap" Grid.Column="1" Text="{Binding CurrentExercise.Name}"
                                       Style="{StaticResource SectionTitle}"
                                       SemanticProperties.HeadingLevel="Level3"
                                       SemanticProperties.Description="{Binding CurrentExercise.Name}" />
                                <Button Grid.Column="2" Text="{loc:LocalizedText Workout_Session_NoteButton}"
                                        Command="{Binding OpenMovementNoteCommand}"
                                        Style="{StaticResource ButtonSecondary}"
                                        VerticalOptions="Center"
                                        SemanticProperties.Hint="{loc:LocalizedText Workout_Session_NoteEditorTitle}" />
                            </Grid>
                            <Label LineBreakMode="WordWrap"
                                Text="{Binding CurrentExercise.TargetText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource BodyLabel}"
                                SemanticProperties.Description="{Binding CurrentExercise.TargetText, Converter={StaticResource LocalizedStringConverter}}" />
                            <Label LineBreakMode="WordWrap"
                                Text="{Binding CurrentExercise.PreviousText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Session_PreviousWeightFormat}"
                                Style="{StaticResource BodyLabel}"
                                SemanticProperties.Description="{Binding CurrentExercise.PreviousText, Converter={StaticResource LocalizedStringConverter}}" />
                            <Label LineBreakMode="WordWrap"
                                Text="{Binding CurrentExercise.RecommendationText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource MutedLabel}"
                                SemanticProperties.Description="{Binding CurrentExercise.RecommendationText, Converter={StaticResource LocalizedStringConverter}}" />
                            <VerticalStackLayout BindingContext="{Binding CurrentExercise}"
                                                 x:DataType="models:WorkoutExerciseItem" Spacing="{StaticResource UiSpaceCompact}">
                                <!-- Strength inputs -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource UiSpaceTight}" RowDefinitions="Auto, Auto"
                                      RowSpacing="{StaticResource UiSpaceMicro}" IsVisible="{Binding UsesStrengthMetrics}">
                                    <Label LineBreakMode="WordWrap" Grid.Row="0" Grid.Column="0" Text="{loc:LocalizedText Workout_Session_SetsHeader}"
                                           Style="{StaticResource CaptionLabel}" />
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource InputContainer}">
                                        <Entry Style="{StaticResource WorkoutNumberEntry}" SemanticProperties.Description="{loc:LocalizedText Workout_Session_SetsCompletedAccessibility}"
                                               Text="{Binding LoggedSetsText, Mode=TwoWay}"
                                               Keyboard="Numeric" Placeholder="{loc:LocalizedText Common_Placeholder_Zero}"
                                               ReturnType="Next" />
                                    </Border>

                                    <Label LineBreakMode="WordWrap" Grid.Row="0" Grid.Column="1" Text="{loc:LocalizedText Workout_Session_RepsHeader}"
                                           Style="{StaticResource CaptionLabel}" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InputContainer}">
                                        <Entry Style="{StaticResource WorkoutNumberEntry}" SemanticProperties.Description="{loc:LocalizedText Workout_Session_RepsPerSetAccessibility}"
                                               Text="{Binding LoggedRepsText, Mode=TwoWay}"
                                               Keyboard="Numeric" Placeholder="{loc:LocalizedText Common_Placeholder_Zero}"
                                               ReturnType="Next" />
                                    </Border>

                                    <Label LineBreakMode="WordWrap" Grid.Row="0" Grid.Column="2" Text="{loc:LocalizedText Workout_Session_KgUnit}"
                                           Style="{StaticResource CaptionLabel}" IsVisible="{Binding UsesWeight}" />
                                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource InputContainer}"
                                            IsVisible="{Binding UsesWeight}">
                                        <Entry Style="{StaticResource WorkoutNumberEntry}" SemanticProperties.Description="{loc:LocalizedText Workout_Session_WeightInKgAccessibility}"
                                               Text="{Binding LoggedWeightText, Mode=TwoWay}"
                                               Placeholder="{loc:LocalizedText Common_Placeholder_Zero}" Keyboard="Numeric"
                                               ReturnType="Done" />
                                    </Border>
                                </Grid>

                                <!-- Duration input -->
                                <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" IsVisible="{Binding UsesDurationOnlyMetric}">
                                    <Label LineBreakMode="WordWrap"
                                        Text="{Binding DurationLabel, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource CaptionLabel}" />
                                    <Border Style="{StaticResource InputContainer}">
                                        <Entry Style="{StaticResource WorkoutNumberEntry}" SemanticProperties.Description="{loc:LocalizedText Workout_Session_DurationInMinutesAccessibility}"
                                               Text="{Binding LoggedDurationMinutesText, Mode=TwoWay}"
                                               Keyboard="Numeric" Placeholder="{loc:LocalizedText Common_Placeholder_Zero}"
                                               ReturnType="Done" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Cardio inputs -->
                                <Grid
                                    RowDefinitions="Auto, Auto, Auto, Auto"
                                    ColumnDefinitions="*,*"
                                    RowSpacing="{StaticResource UiSpaceTight}"
                                    ColumnSpacing="{StaticResource UiSpaceTight}"
                                    IsVisible="{Binding UsesCardioMetricGrid}">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="{StaticResource UiSpaceMicro}"
                                                         IsVisible="{Binding UsesDurationMetric}">
                                        <Label LineBreakMode="WordWrap"
                                            Text="{Binding DurationLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}" />
                                        <Border Style="{StaticResource InputContainer}">
                                            <Entry Style="{StaticResource WorkoutNumberEntry}" SemanticProperties.Description="{loc:LocalizedText Workout_Session_DurationInMinutesAccessibility}"
                                                   Text="{Binding LoggedDurationMinutesText, Mode=TwoWay}"
                                                   Keyboard="Numeric" Placeholder="{loc:LocalizedText Common_Placeholder_Zero}"
                                                   ReturnType="Next" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="{StaticResource UiSpaceMicro}"
                                                         IsVisible="{Binding UsesDistanceMetric}">
                                        <Label LineBreakMode="WordWrap"
                                            Text="{Binding DistanceLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}" />
                                        <Border Style="{StaticResource InputContainer}">
                                            <Entry Style="{StaticResource WorkoutNumberEntry}"
                                                SemanticProperties.Description="{Binding DistanceLabel, Converter={StaticResource LocalizedStringConverter}}"
                                                Text="{Binding LoggedDistanceKmText, Mode=TwoWay}"
                                                Keyboard="Numeric" Placeholder="{loc:LocalizedText Common_Placeholder_Zero}"
                                                ReturnType="Next" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="{StaticResource UiSpaceMicro}"
                                                         IsVisible="{Binding UsesPaceMetric}">
                                        <Label LineBreakMode="WordWrap"
                                            Text="{Binding PaceLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}" />
                                        <Border Style="{StaticResource InputContainer}">
                                            <Entry
                                                SemanticProperties.Description="{Binding PaceLabel, Converter={StaticResource LocalizedStringConverter}}"
                                                Text="{Binding LoggedPaceText, Mode=TwoWay}"
                                                Placeholder="{loc:LocalizedText Common_Placeholder_TimeExample}"
                                                ReturnType="Next" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="{StaticResource UiSpaceMicro}"
                                                         IsVisible="{Binding UsesHeartRateMetric}">
                                        <Label LineBreakMode="WordWrap"
                                            Text="{Binding HeartRateLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}" />
                                        <Border Style="{StaticResource InputContainer}">
                                            <Entry Style="{StaticResource WorkoutNumberEntry}" SemanticProperties.Description="{loc:LocalizedText Workout_Session_HeartRateAccessibility}"
                                                   Text="{Binding LoggedHeartRateText, Mode=TwoWay}"
                                                   Keyboard="Numeric" Placeholder="{loc:LocalizedText Common_Placeholder_Zero}"
                                                   ReturnType="Next" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="{StaticResource UiSpaceMicro}"
                                                         IsVisible="{Binding UsesPowerMetric}">
                                        <Label LineBreakMode="WordWrap"
                                            Text="{Binding PowerLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}" />
                                        <Border Style="{StaticResource InputContainer}">
                                            <Entry Style="{StaticResource WorkoutNumberEntry}" SemanticProperties.Description="{loc:LocalizedText Workout_Session_WattsAccessibility}"
                                                   Text="{Binding LoggedPowerWattsText, Mode=TwoWay}"
                                                   Keyboard="Numeric" Placeholder="{loc:LocalizedText Common_Placeholder_Zero}"
                                                   ReturnType="Next" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="{StaticResource UiSpaceMicro}"
                                                         IsVisible="{Binding UsesCadenceMetric}">
                                        <Label LineBreakMode="WordWrap"
                                            Text="{Binding CadenceLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}" />
                                        <Border Style="{StaticResource InputContainer}">
                                            <Entry Style="{StaticResource WorkoutNumberEntry}" SemanticProperties.Description="{loc:LocalizedText Workout_Session_CadenceAccessibility}"
                                                   Text="{Binding LoggedCadenceRpmText, Mode=TwoWay}"
                                                   Keyboard="Numeric" Placeholder="{loc:LocalizedText Common_Placeholder_Zero}"
                                                   ReturnType="Next" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="{StaticResource UiSpaceMicro}"
                                                         IsVisible="{Binding UsesEffortMetric}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}">
                                            <Label LineBreakMode="WordWrap"
                                                Text="{Binding EffortLabel, Converter={StaticResource LocalizedStringConverter}}"
                                                Style="{StaticResource CaptionLabel}" />
                                            <Label LineBreakMode="WordWrap" Grid.Column="1"
                                                   Text="{Binding EffortDisplayText, Converter={StaticResource LocalizedStringConverter}}"
                                                   Style="{StaticResource BodyStrong}" />
                                        </Grid>
                                        <Slider Minimum="1" Maximum="10"
                                                Value="{Binding EffortSliderValue, Mode=TwoWay}"
                                                DragCompleted="OnEffortDragCompleted"
                                                MinimumTrackColor="{StaticResource Primary}"
                                                MaximumTrackColor="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                                                ThumbColor="{StaticResource Primary}"
                                                SemanticProperties.Description="{loc:LocalizedText Workout_Session_EffortRatingAccessibility}"
                                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_AdjustWholeNumberAccessibility}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Session_RpeLightLabel}"
                                                   Style="{StaticResource CaptionLabel}" />
                                            <Label LineBreakMode="WordWrap" Grid.Column="1" Text="{loc:LocalizedText Workout_Session_RpeVeryHardLabel}"
                                                   Style="{StaticResource CaptionLabel}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>

                                <Border Style="{StaticResource CardSecondary}">
                                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}">
                                            <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Readiness_OptionalExercise}"
                                                   Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                                            <Switch Grid.Column="1" IsToggled="{Binding IsOptional, Mode=TwoWay}"
                                                    IsEnabled="{Binding CanMarkOptional}"
                                                    OnColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource ActionSurfaceDark}}"
                                                    ThumbColor="{StaticResource ControlThumbLight}"
                                                    Toggled="OnOptionalExerciseToggled" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceTight}"
                                              IsVisible="{Binding IsOptional}">
                                            <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Readiness_OptionalSets}"
                                                   Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                                            <Stepper Grid.Column="1" Minimum="0" Maximum="{Binding MaxOptionalSets}"
                                                     Increment="1" Value="{Binding OptionalSets, Mode=TwoWay}"
                                                     IsEnabled="{Binding CanMarkOptional}"
                                                     ValueChanged="OnOptionalSetsChanged" />
                                            <Label Grid.Column="2" Text="{Binding OptionalSets}" Style="{StaticResource BodyLabel}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                        <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Readiness_OneRequiredSetHint}"
                                               Style="{StaticResource CaptionLabel}" IsVisible="{Binding IsOptional}" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpaceTight}" HorizontalOptions="Start">
                                <Path Data="M2 4 L8 10 L14 4" Stroke="{StaticResource Primary}"
                                      StrokeThickness="{StaticResource UiStrokeWidth2}" WidthRequest="{StaticResource UiDimension16}" HeightRequest="{StaticResource UiDimension16}"
                                      VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="{Binding TipsButtonText, Converter={StaticResource LocalizedStringConverter}}"
                                        Command="{Binding ToggleTipsCommand}" Style="{StaticResource ButtonSecondary}"
                                        SemanticProperties.Hint="{loc:LocalizedText Workout_Session_ToggleTipsAccessibility}" />
                            </Grid>
                            <Border Style="{StaticResource CardSecondary}" IsVisible="{Binding IsTipsExpanded}">
                                <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">
                                    <Label LineBreakMode="WordWrap"
                                        Text="{Binding CurrentExercise.WhyText, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource BodyLabel}" />
                                    <Label LineBreakMode="WordWrap" Text="{Binding CurrentExercise.CuesText}" Style="{StaticResource BodyLabel}" />
                                    <Label LineBreakMode="WordWrap" Text="{Binding CurrentExercise.QuickTipsText}"
                                           IsVisible="{Binding CurrentExercise.HasQuickTips}"
                                           Style="{StaticResource BodyLabel}" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </ScrollView>

                    <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource UiSpaceTight}">
                        <Button Text="{loc:LocalizedText Workout_Session_Start60SecRestAccessibility}" Command="{Binding StartRestTimerCommand}"
                                IsVisible="{Binding IsRestTimerVisible, Converter={StaticResource InvertedBoolConverter}}"
                                Style="{StaticResource ButtonSecondary}">
                            <Button.CommandParameter>
                                <x:Int32>60</x:Int32>
                            </Button.CommandParameter>
                        </Button>
                        <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}" IsVisible="{Binding IsRestTimerVisible}">
                            <Label LineBreakMode="WordWrap"
                                Text="{Binding RestTimerDisplay, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource WorkoutNumber}"
                                HorizontalTextAlignment="Center"
                                SemanticProperties.Description="{loc:LocalizedText Workout_Session_RestTimerCountdownAccessibility}" />
                            <ProgressBar Progress="{Binding RestTimerProgress}" />
                            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Center" AlignItems="Start">
                                <Button Text="{loc:LocalizedText Workout_Session_PauseButton}"
                                        Command="{Binding PauseRestTimerCommand}"
                                        IsVisible="{Binding IsRestTimerRunning}" Style="{StaticResource ButtonSecondary}" />
                                <Button Text="{loc:LocalizedText Workout_Session_ResumeButton}"
                                        Command="{Binding ResumeRestTimerCommand}"
                                        IsVisible="{Binding IsRestTimerRunning, Converter={StaticResource InvertedBoolConverter}}"
                                        Style="{StaticResource ButtonSecondary}" />
                                <Button Text="{loc:LocalizedText Workout_Session_Plus30SecButton}"
                                        Command="{Binding AddRestTimerSecondsCommand}"
                                        Style="{StaticResource ButtonSecondary}">
                                    <Button.CommandParameter>
                                        <x:Int32>30</x:Int32>
                                    </Button.CommandParameter>
                                </Button>
                                <Button Text="{loc:LocalizedText Workout_Session_DoneButton}" Command="{Binding StopRestTimerCommand}"
                                        Style="{StaticResource ButtonSecondary}" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Bottom action bar: Swap / Notes / Skip / Next -->
                    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource UiSpaceTight}" RowSpacing="{StaticResource UiSpaceTight}">
                        <Button Text="{loc:LocalizedText Workout_Session_SwapButton}" Command="{Binding OpenSwapPanelCommand}"
                                Style="{StaticResource ButtonSecondary}"
                                IsVisible="{Binding CurrentExercise.UsesStrengthMetrics}"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_SwapExerciseAccessibility}" />
                        <Button Grid.Column="1" Text="{loc:LocalizedText Workout_Session_NoteButton}" Command="{Binding OpenMovementNoteCommand}"
                                Style="{StaticResource ButtonSecondary}"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_NoteEditorTitle}" />
                        <Button Grid.Column="2" Text="{loc:LocalizedText Workout_Session_SkipButton}"
                                Command="{Binding SkipExerciseCommand}" Style="{StaticResource ButtonSecondary}"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_SkipExerciseAccessibility}" />
                        <Button Style="{StaticResource ButtonPrimary}" Grid.Row="1" Grid.ColumnSpan="3" Text="{loc:LocalizedText Workout_Session_NextExerciseButton}"
                                Command="{Binding NextExerciseCommand}"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_SaveAndNextAccessibility}" />
                    </Grid>
                </Grid>

                <!-- ========== Activity summary ========== -->
                <Grid RowDefinitions="*,Auto" RowSpacing="{StaticResource UiSpaceControl}" IsVisible="{Binding IsActivitySummary}">
                    <ScrollView>
                        <VerticalStackLayout Spacing="{StaticResource UiSpaceContent}" Padding="{StaticResource UiInsets0_24}">
                            <Border x:Name="CompletionBadge" WidthRequest="{StaticResource UiDimension64}" HeightRequest="{StaticResource UiDimension64}"
                                    StrokeShape="{StaticResource UiRoundRectangleRadius32}" StrokeThickness="{StaticResource UiStrokeWidth0}"
                                    BackgroundColor="{StaticResource Primary}" HorizontalOptions="Center">
                                <Path Data="M2 12 L8 18 L22 3" Stroke="{StaticResource ContrastInk}" StrokeThickness="{StaticResource UiStrokeWidth3}"
                                      StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                                      HeightRequest="{StaticResource UiDimension32}" WidthRequest="{StaticResource UiDimension32}" HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      SemanticProperties.Description="{loc:LocalizedText Workout_Session_CheckmarkAccessibility}" />
                            </Border>
                            <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                                <Label LineBreakMode="WordWrap"
                                    Text="{Binding SummaryTitle, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource SectionTitle}"
                                    HorizontalTextAlignment="Center"
                                    SemanticProperties.HeadingLevel="Level2" />
                                <Label LineBreakMode="WordWrap"
                                    Text="{Binding SelectedActivity.Title, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource BodyCentered}" />
                                <Label LineBreakMode="WordWrap"
                                    Text="{Binding SummaryStatusText, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource CaptionCentered}"
                                    SemanticProperties.Description="{Binding SummaryStatusText, Converter={StaticResource LocalizedStringConverter}}" />
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource UiSpaceTight}">
                                <Border Style="{StaticResource CardSecondary}" IsVisible="{Binding ShowStrengthSummaryMetrics}"
                                        SemanticProperties.Description="{Binding SummaryTotalVolume, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Session_TotalVolumeFormat}">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceMicro}">
                                        <Label LineBreakMode="WordWrap"
                                            Text="{Binding SummaryTotalVolume, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource WorkoutMetricValue}" />
                                        <Label LineBreakMode="WordWrap" Grid.Row="1" Text="{loc:LocalizedText Workout_Session_VolumeHeader}"
                                               Style="{StaticResource WorkoutMetricLabel}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardSecondary}" IsVisible="{Binding ShowStrengthSummaryMetrics}"
                                        SemanticProperties.Description="{Binding SummaryPrCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Session_WeightPrsFormat}">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceMicro}">
                                        <Label LineBreakMode="WordWrap"
                                            Text="{Binding SummaryPrCount, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource WorkoutMetricValue}" />
                                        <Label LineBreakMode="WordWrap" Grid.Row="1" Text="{loc:LocalizedText Workout_Session_WeightPrsTitle}"
                                               Style="{StaticResource WorkoutMetricLabel}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardSecondary}"
                                        SemanticProperties.Description="{Binding SummaryDuration, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Session_TimeFormat}">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceMicro}">
                                        <Label LineBreakMode="WordWrap"
                                            Text="{Binding SummaryDuration, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource WorkoutMetricValue}" />
                                        <Label LineBreakMode="WordWrap" Grid.Row="1" Text="{loc:LocalizedText Workout_Session_TimeLabel}"
                                               Style="{StaticResource WorkoutMetricLabel}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </ScrollView>
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceTight}">
                        <Button Style="{StaticResource ButtonPrimary}" Text="{loc:LocalizedText Workout_Session_ContinueButton}" Command="{Binding FinishActivityCommand}"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_ReturnToActivitiesAccessibility}" />
                        <Button Grid.Row="1" Text="{loc:LocalizedText Workout_Session_FinishSessionButton}"
                                Command="{Binding CompleteSessionCommand}" Style="{StaticResource ButtonSecondary}"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Session_EndSessionAccessibility}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <toolkit:LazyView
            x:Name="SwapPanelLazy"
            x:TypeArguments="workoutControls:WorkoutSwapPanel"
            InputTransparent="{Binding IsSwapPanelVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="{StaticResource WorkoutBusyScrim}"
              SemanticProperties.Description="{loc:LocalizedText Workout_Session_LoadingOverlayAccessibility}">
            <ActivityIndicator
                        Style="{StaticResource StateBusyInline}" IsRunning="{Binding IsBusy}" WidthRequest="{StaticResource UiDimension48}"
                               HeightRequest="{StaticResource UiDimension48}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               SemanticProperties.Description="{loc:LocalizedText Workout_Session_SavingLoadingAccessibility}" />
        </Grid>

        <!-- Abandon confirmation: keeps the active state unless the user confirms -->
        <sharedControls:AnimatedModalView Grid.RowSpan="2"
                                          ZIndex="35"
                                          IsVisible="{Binding IsAbandonConfirmationVisible}">
            <Grid>
                <BoxView BackgroundColor="{StaticResource ModalScrim}">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelAbandonPlannedSessionCommand}" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <Border Style="{StaticResource ModalSurface}"
                        Padding="{DynamicResource PresentationModalPagePadding}"
                        MaximumHeightRequest="{StaticResource ModalSheetMaximumHeight}"
                        VerticalOptions="End">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">
                        <Label LineBreakMode="WordWrap"
                               Text="{loc:LocalizedText Workout_Session_AbandonConfirmTitle}"
                               Style="{StaticResource SectionTitle}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label LineBreakMode="WordWrap"
                               Text="{loc:LocalizedText Workout_Session_AbandonConfirmBody}"
                               Style="{StaticResource BodyLabel}" />
                        <Button Style="{StaticResource ButtonPrimary}"
                                Text="{loc:LocalizedText Workout_Session_AbandonConfirmAction}"
                                Command="{Binding ConfirmAbandonPlannedSessionCommand}" />
                        <Button Style="{StaticResource ButtonSecondary}"
                                Text="{loc:LocalizedText Workout_Session_AbandonCancel}"
                                Command="{Binding CancelAbandonPlannedSessionCommand}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </sharedControls:AnimatedModalView>

        <!-- Movement Note Editor Modal -->
        <sharedControls:AnimatedModalView Grid.RowSpan="2"
                                          ZIndex="30"
                                          IsVisible="{Binding IsMovementNoteOpen}">
            <Grid>
                <BoxView BackgroundColor="{StaticResource ModalScrim}">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseMovementNoteCommand}" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <Border Style="{StaticResource ModalSurface}"
                        Padding="{DynamicResource PresentationModalPagePadding}"
                        MaximumHeightRequest="{StaticResource ModalSheetMaximumHeight}"
                        VerticalOptions="End">
                    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="{StaticResource UiSpaceCompact}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                            <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Session_NoteEditorTitle}"
                                   Style="{StaticResource ModalTitle}"
                                   SemanticProperties.HeadingLevel="Level1" />
                            <Button Grid.Column="1" Text="{loc:LocalizedText Common_Close}"
                                    Command="{Binding CloseMovementNoteCommand}"
                                    Style="{StaticResource ButtonSecondary}" />
                        </Grid>

                        <Label Grid.Row="1" LineBreakMode="WordWrap" Text="{Binding CurrentExercise.Name}"
                               Style="{StaticResource BodyStrong}" />

                        <Border Grid.Row="2" Style="{StaticResource InputContainer}" HeightRequest="{StaticResource UiDimension120}">
                            <Editor Text="{Binding MovementNoteText, Mode=TwoWay}"
                                    Placeholder="{loc:LocalizedText Workout_Session_NotePlaceholder}"
                                    MaxLength="2000"
                                    AutoSize="Disabled"
                                    VerticalOptions="Fill" />
                        </Border>

                        <VerticalStackLayout Grid.Row="3" Spacing="{StaticResource UiSpaceMicro}">
                            <Label LineBreakMode="WordWrap"
                                   Text="{Binding MovementNoteErrorText, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource ErrorLabel}"
                                   IsVisible="{Binding HasMovementNoteError}" />
                            <Label LineBreakMode="WordWrap"
                                   Text="{Binding MovementNoteStatusText, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource AccentLabel}"
                                   IsVisible="{Binding HasMovementNoteStatus}" />
                        </VerticalStackLayout>

                        <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpaceTight}">
                            <Button Text="{loc:LocalizedText Workout_Session_ClearNoteButton}"
                                    Command="{Binding ClearMovementNoteCommand}"
                                    IsEnabled="{Binding IsMovementNoteBusy, Converter={StaticResource InvertedBoolConverter}}"
                                    Style="{StaticResource ButtonSecondary}" />
                            <Button Grid.Column="1" Text="{loc:LocalizedText Workout_Session_SaveNoteButton}"
                                    Command="{Binding SaveMovementNoteCommand}"
                                    IsEnabled="{Binding IsMovementNoteBusy, Converter={StaticResource InvertedBoolConverter}}"
                                    Style="{StaticResource ButtonPrimary}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </sharedControls:AnimatedModalView>
    </Grid>
</ContentPage>
