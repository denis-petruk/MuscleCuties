<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Workout.PhaseAdjustmentReviewPageV010"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Workout"
    x:DataType="vm:PhaseAdjustmentReviewViewModelV010"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="{StaticResource PresentationPageContentPadding}"
            Spacing="{StaticResource UiSpaceContent}"
            HorizontalOptions="Fill"
            MaximumWidthRequest="{StaticResource UiDimension640}">
            <sharedControls:PageHeader
                Title="{loc:LocalizedText Workout_PhaseAdjustment_Title}"
                BackCommand="{Binding BackCommand}" />

            <Label Text="{loc:LocalizedText Workout_PhaseAdjustment_Intro}"
                   Style="{StaticResource MutedLabel}"
                   LineBreakMode="WordWrap" />

            <Border Style="{StaticResource CardPrimary}">
                <Label Text="{Binding StatusMessage}"
                       Style="{StaticResource BodyLabel}"
                       LineBreakMode="WordWrap">
                    <Label.Behaviors>
                        <sharedControls:ScreenReaderStatusAnnouncementBehavior />
                    </Label.Behaviors>
                </Label>
            </Border>

            <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}"
                                 IsVisible="{Binding HasFieldChanges}">
                <Label Text="{loc:LocalizedText Workout_PhaseAdjustment_ChangesTitle}"
                       Style="{StaticResource SectionTitle}"
                       SemanticProperties.HeadingLevel="Level2" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding FieldChanges}"
                                     Spacing="{StaticResource UiSpaceCompact}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Style="{StaticResource CardSecondary}">
                                <Label Text="{Binding .}"
                                       Style="{StaticResource BodyLabel}"
                                       LineBreakMode="WordWrap" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}"
                                 IsVisible="{Binding HasSessionChoices}">
                <Label Text="{loc:LocalizedText Workout_PhaseAdjustment_ChoicesTitle}"
                       Style="{StaticResource SectionTitle}"
                       SemanticProperties.HeadingLevel="Level2" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SessionChoices}"
                                     Spacing="{StaticResource UiSpaceCompact}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhaseAdjustmentSessionChoiceRowV010">
                            <Border Style="{StaticResource CardSecondary}">
                                <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">
                                    <Label Text="{Binding Title}"
                                           Style="{StaticResource BodyStrong}" />
                                    <Border Style="{StaticResource PickerContainer}">
                                        <Picker ItemsSource="{Binding Options}"
                                                SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                ItemDisplayBinding="{Binding Label}"
                                                Title="{loc:LocalizedText Workout_PhaseAdjustment_SelectOption}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               SemanticProperties.Description="{loc:LocalizedText Workout_PhaseAdjustment_Loading}" />

            <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}"
                                 IsVisible="{Binding HasProposal}">
                <Button Text="{loc:LocalizedText Workout_PhaseAdjustment_Apply}"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding ApplyChangesCommand}" />
                <Button Text="{loc:LocalizedText Workout_PhaseAdjustment_KeepPlan}"
                        Style="{StaticResource ButtonSecondary}"
                        Command="{Binding KeepPlanCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
