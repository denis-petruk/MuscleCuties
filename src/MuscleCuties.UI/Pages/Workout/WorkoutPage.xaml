<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Workout.WorkoutPage"
    x:Name="WorkoutRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Workout"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:workoutControls="clr-namespace:MuscleCuties.UI.Controls.Workout"
    xmlns:injuryControls="clr-namespace:MuscleCuties.UI.Controls.Injury"
    xmlns:workoutModels="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
    x:DataType="vm:WorkoutViewModel"
    Shell.NavBarIsVisible="False">


    <Grid RowDefinitions="Auto,*">
        <!-- Top Sticky Header -->
        <Grid Padding="{DynamicResource PresentationPageHeaderPadding}"
              HorizontalOptions="Fill"
              MaximumWidthRequest="{StaticResource UiDimension640}">
            <sharedControls:PageHeader
                Title="{Binding WeekTitle, Converter={StaticResource LocalizedStringConverter}}"
                ShowBack="False">
                <sharedControls:PageHeader.StatusContent>
                    <Border
                        Style="{StaticResource PillBadge}"
                        IsVisible="{Binding HasKnownCyclePhase}">
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                            <BoxView WidthRequest="{StaticResource UiDimension7}" HeightRequest="{StaticResource UiDimension7}" CornerRadius="{StaticResource UiCornerRadius4}"
                                     Color="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                                     VerticalOptions="Center" />
                            <Label Style="{StaticResource MutedLabel}" Grid.Column="1"
                                   Text="{Binding CurrentPhaseName, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Page_PhaseFormat}"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>
                </sharedControls:PageHeader.StatusContent>
                <sharedControls:PageHeader.ActionContent>
                    <Border
                        Style="{StaticResource HeaderIconButton}"
                        SemanticProperties.Description="{loc:LocalizedText Workout_Page_OpenInjuryLogAccessibility}"
                        SemanticProperties.Hint="{Binding InjuryBannerSummary, Converter={StaticResource LocalizedStringConverter}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenInjuryModalCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <mi:MauiIcon Icon="{mi:Fluent HeartPulse32}" IconSize="{StaticResource UiDimension22}"
                                         IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                         WidthRequest="{StaticResource UiDimension22}" HeightRequest="{StaticResource UiDimension22}" HorizontalOptions="Center"
                                         VerticalOptions="Center" />
                            <BoxView WidthRequest="{StaticResource UiDimension8}" HeightRequest="{StaticResource UiDimension8}" CornerRadius="{StaticResource UiCornerRadius4}" Margin="{StaticResource UiInsets0_6_6_0}"
                                     Color="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                                     HorizontalOptions="End" VerticalOptions="Start"
                                     IsVisible="{Binding HasActiveInjuries}"
                                     InputTransparent="True" />
                        </Grid>
                    </Border>
                </sharedControls:PageHeader.ActionContent>
            </sharedControls:PageHeader>
        </Grid>

        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
        <CollectionView ItemsSource="{Binding Workouts}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout
                    Padding="{DynamicResource PresentationPageContentPadding}"
                    Spacing="{StaticResource UiSpaceControl}"
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="{StaticResource UiDimension640}">

                    <Button Text="{loc:LocalizedText Workout_History_ArchiveTitle}"
                            Command="{Binding OpenHistoryCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            SemanticProperties.Hint="{loc:LocalizedText Workout_History_CompletedSessionsTitle}" />

                    <Border Style="{StaticResource CardSecondary}" IsVisible="{Binding HasStrengthStyleOffer}">
                        <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                            <Label Text="{loc:LocalizedText Workout_StyleOffer_Title}" Style="{StaticResource BodyStrong}" LineBreakMode="WordWrap" />
                            <Label Text="{loc:LocalizedText Workout_StyleOffer_Explanation}" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding StyleOfferMessage}" IsVisible="{Binding HasStyleOfferMessage}" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
                            <Button Text="{loc:LocalizedText Workout_StyleOffer_Explore}" Command="{Binding ExploreStrengthStyleCommand}" Style="{StaticResource ButtonPrimary}" />
                            <Button Text="{loc:LocalizedText Workout_StyleOffer_Keep}" Command="{Binding DismissStrengthStyleCommand}" Style="{StaticResource ButtonSecondary}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource CardSecondary}" IsVisible="{Binding HasInProgressWorkout}">
                        <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                            <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Overview_InProgressTitle}" Style="{StaticResource BodyStrong}" />
                            <Label Text="{loc:LocalizedText Workout_Overview_InProgressExplanation}" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding InProgressWorkout.Title}" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
                            <Button Text="{loc:LocalizedText Workout_Overview_ResumeWorkout}" Command="{Binding ResumeInProgressWorkoutCommand}" Style="{StaticResource ButtonPrimary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardSecondary}"
                            IsVisible="{Binding HasActiveInjuries}"
                            SemanticProperties.Description="{loc:LocalizedText Workout_Page_InjuryAdjustmentsActive}"
                            SemanticProperties.Hint="{Binding InjuryBannerSummary, Converter={StaticResource LocalizedStringConverter}}">
                        <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                                <Label
                                    Text="{Binding InjuryBannerSummary, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource BodyCompact}" LineBreakMode="WordWrap"
                                    VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="{loc:LocalizedText Workout_Page_DetailsButton}"
                                        Style="{StaticResource ButtonSecondary}"
                                        Command="{Binding ToggleInjuryBannerCommand}"
                                        VerticalOptions="Center" HorizontalOptions="End"
                                        SemanticProperties.Hint="{loc:LocalizedText Workout_Page_ToggleInjuryAdjustmentsAccessibility}" />
                                <Button Grid.Column="2" Text="{loc:LocalizedText Workout_Page_LogButton}"
                                        Style="{StaticResource ButtonSecondary}"
                                        Command="{Binding NavigateToInjuryLogCommand}"
                                        VerticalOptions="Center" HorizontalOptions="End"
                                        SemanticProperties.Hint="{loc:LocalizedText Workout_Page_OpenInjuryLogAccessibility}" />
                            </Grid>

                            <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}" IsVisible="{Binding IsInjuryBannerExpanded}">
                                <!-- Blocked exercises -->
                                <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" IsVisible="{Binding HasBlockedExercises}">
                                    <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Page_BlockedExercisesTitle}"
                                           Style="{StaticResource MutedLabel}" />
                                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}"
                                                         BindableLayout.ItemsSource="{Binding BlockedExerciseNames}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label LineBreakMode="WordWrap" Text="{Binding .}"
                                                       Style="{StaticResource MutedLabel}" Margin="{StaticResource UiInsets8_0_0_0}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Rehab recommendations -->
                                <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" IsVisible="{Binding HasRehabExercises}">
                                    <Label LineBreakMode="WordWrap" Style="{StaticResource MutedLabel}" Text="{loc:LocalizedText Workout_Page_RehabRecommendationsTitle}"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}" />
                                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}"
                                                         BindableLayout.ItemsSource="{Binding RehabExerciseNames}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label LineBreakMode="WordWrap" Text="{Binding .}"
                                                       Style="{StaticResource AccentLabel}" Margin="{StaticResource UiInsets8_0_0_0}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Blocked cardio -->
                                <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" IsVisible="{Binding HasBlockedCardio}">
                                    <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Page_BlockedActivitiesTitle}"
                                           Style="{StaticResource MutedLabel}" />
                                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}"
                                                         BindableLayout.ItemsSource="{Binding BlockedCardioNames}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label LineBreakMode="WordWrap" Text="{Binding .}"
                                                       Style="{StaticResource MutedLabel}" Margin="{StaticResource UiInsets8_0_0_0}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <toolkit:LazyView
                        x:Name="FeaturedWorkoutLazy"
                        x:TypeArguments="workoutControls:WorkoutFeaturedSection" />

                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" Margin="{StaticResource UiInsets0_6_0_0}">
                        <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Page_ActivityScheduleTitle}" Style="{StaticResource SectionTitle}" />
                        <Label LineBreakMode="WordWrap"
                            Text="{Binding PlanSummaryText, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>

                    <!-- A chip keeps its natural width and the row scrolls: four equal columns broke
                         "Неделя 1" inside the word once the reader asked for larger text. -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="{StaticResource UiSpaceTight}"
                                               BindableLayout.ItemsSource="{Binding Weeks}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="workoutModels:FilterChipItem">
                                <!-- Equal star columns plus one spacing token: every chip measures the
                                     same, and both edges land on the page inset, so the row reads as a
                                     single block whatever the label length or which chip is selected. -->
                                <Border Style="{StaticResource ChoiceCell}"
                                        SemanticProperties.Description="{Binding Label, Converter={StaticResource LocalizedStringConverter}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectWeekChipCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Style="{StaticResource ChoiceCellLabel}"
                                           Text="{Binding Label, Converter={StaticResource LocalizedStringConverter}}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Seven days fit one row only without per-card chrome: a card inset leaves
                         too little width for the workout tag, so the type is carried by the dot and
                         by the session list below, and the day navigates on tap. -->
                    <Border Style="{StaticResource CardPrimary}">
                        <!-- Seven cells cannot share one line at accessibility sizes without breaking a
                             date, so the strip keeps each day at its own width and scrolls sideways. -->
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="{StaticResource UiSpacing2}"
                                                   BindableLayout.ItemsSource="{Binding ScheduleDays}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="workoutModels:ScheduleDayItem">
                                    <VerticalStackLayout Spacing="{StaticResource UiSpacing2}"
                                                         Padding="{StaticResource UiInsets4}"
                                                         MinimumWidthRequest="{StaticResource PresentationMinimumTouchSize}"
                                                         MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                                         SemanticProperties.Description="{Binding WorkoutTitle, Converter={StaticResource LocalizedStringConverter}}">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectScheduleDayCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="{Binding DayLabel, Converter={StaticResource LocalizedStringConverter}}"
                                               Style="{StaticResource CaptionSmallStrong}"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap" />
                                        <Label Text="{Binding Date, StringFormat='{0:dd MMM}'}"
                                               Style="{StaticResource CaptionLabel}"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap" />
                                        <!-- Compact chips wrap instead of clipping: a day can carry
                                             several sessions, and the column must stay readable at narrow
                                             widths and large text sizes. -->
                                        <FlexLayout BindableLayout.ItemsSource="{Binding Sessions}"
                                                    Direction="Row"
                                                    Wrap="Wrap"
                                                    JustifyContent="Center"
                                                    AlignItems="Center"
                                                    HorizontalOptions="Fill"
                                                    IsClippedToBounds="False">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="workoutModels:ScheduleSessionChip">
                                                    <BoxView WidthRequest="{StaticResource UiDimension6}"
                                                             HeightRequest="{StaticResource UiDimension6}"
                                                             Margin="{StaticResource UiInsets2}"
                                                             CornerRadius="{StaticResource UiCornerRadius3}"
                                                             Color="{Binding AccentColor}"
                                                             InputTransparent="True"
                                                             VerticalOptions="Center" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </Border>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="{StaticResource UiSpaceTight}"
                                               BindableLayout.ItemsSource="{Binding Filters}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="workoutModels:FilterChipItem">
                                <!-- Equal star columns plus one spacing token: every chip measures the
                                     same, and both edges land on the page inset, so the row reads as a
                                     single block whatever the label length or which chip is selected. -->
                                <Border Style="{StaticResource ChoiceCell}"
                                        SemanticProperties.Description="{Binding Label, Converter={StaticResource LocalizedStringConverter}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectFilterCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Style="{StaticResource ChoiceCellLabel}"
                                           Text="{Binding Label, Converter={StaticResource LocalizedStringConverter}}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <ActivityIndicator
                        Style="{StaticResource StateBusyPage}"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                       
                        SemanticProperties.Description="{loc:LocalizedText Workout_Page_LoadingWorkouts}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Border
                    Style="{StaticResource CardPrimary}"
                    Margin="{StaticResource UiInsets20_0_20_32}"
                    MaximumWidthRequest="{StaticResource UiDimension640}"
                    IsVisible="{Binding HasNoWorkouts}"
                    VerticalOptions="Start">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                        <Label LineBreakMode="WordWrap"
                            Text="{Binding EmptyWorkoutsTitle, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource StateEmptyTitle}" />
                        <Label LineBreakMode="WordWrap"
                            Text="{Binding EmptyWorkoutsSubtitle, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource StateEmptyBody}" />

                        <Button Style="{StaticResource ButtonSecondary}"
                            Text="{Binding EmptyWorkoutsButtonText, Converter={StaticResource LocalizedStringConverter}}"
                            Command="{Binding EmptyWorkoutsActionCommand}"
                            IsVisible="{Binding EmptyWorkoutsButtonVisible}" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="workoutModels:WorkoutItem">
                    <VerticalStackLayout Margin="{StaticResource UiInsets20_0_20_12}"
                                         MaximumWidthRequest="{StaticResource UiDimension640}"
                                         Spacing="{StaticResource UiSpaceMicro}">
                        <workoutControls:WorkoutActivityCard
                            OpenCommand="{Binding OpenWorkoutCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                            ToggleOptionalCommand="{Binding ToggleSessionOptionalCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                            ToggleEasierAlternativeCommand="{Binding ToggleEasierAlternativeCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                            CommandParameter="{Binding .}" />
                        <Button Text="{loc:LocalizedText Workout_Overview_RescheduleButton}"
                                Command="{Binding StartRescheduleCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                                CommandParameter="{Binding .}"
                                IsVisible="{Binding CanReschedule}"
                                Style="{StaticResource ButtonSecondary}"
                                HorizontalOptions="End"
                                Margin="{StaticResource UiInsets0_0_0_4}"
                                SemanticProperties.Hint="{loc:LocalizedText Workout_Reschedule_ButtonHint}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>

        <!-- Generate Plan Prompt Overlay (shown prominently covering workout cards/blocks when no plan exists) -->
        <Grid Grid.Row="1"
              IsVisible="{Binding ShowNoPlanPrompt}"
              BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
              Padding="{DynamicResource PresentationPageContentPadding}"
              ZIndex="5">
            <Border Style="{StaticResource CardPrimary}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="{StaticResource UiDimension640}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">
                    <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Generation_PromptNoPlanTitle}"
                           Style="{StaticResource CardTitle}"
                           HorizontalTextAlignment="Center" />
                    <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Generation_PromptNoPlanSubtitle}"
                           Style="{StaticResource MutedLabel}"
                           HorizontalTextAlignment="Center" />
                    <Button Style="{StaticResource ButtonPrimary}"
                            Text="{loc:LocalizedText Workout_Generation_PromptGeneratePlanButton}"
                            AutomationId="WorkoutGeneratePlanButton" Command="{Binding GeneratePlanCommand}"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <sharedControls:PageLoadingOverlay
            Grid.RowSpan="{StaticResource WorkoutOverlayRowSpan}"
            ZIndex="15"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}" />
        <toolkit:LazyView
            x:Name="InjuryModalLazy"
            Grid.RowSpan="{StaticResource WorkoutOverlayRowSpan}"
            ZIndex="20"
            x:TypeArguments="injuryControls:InjuryLogModal"
            InputTransparent="{Binding IsInjuryModalVisible, Converter={StaticResource InvertedBoolConverter}}" />

        <sharedControls:AnimatedModalView x:Name="SessionActivitiesOverlay" Grid.RowSpan="{StaticResource WorkoutOverlayRowSpan}"
              ZIndex="10"
              x:DataType="vm:WorkoutSessionViewModel"
              BindingContext="{x:Null}">
            <Grid>
            <BoxView BackgroundColor="{StaticResource ModalScrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseSessionActivitiesClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border Style="{StaticResource ModalSurface}"
                    MaximumHeightRequest="{StaticResource ModalSheetMaximumHeight}" VerticalOptions="End">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource UiSpacing0}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}"
                          Padding="{DynamicResource PresentationModalHeaderPadding}">
                        <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Session_ActivitiesTitle}" Style="{StaticResource ModalTitle}"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Border Grid.Column="1" Style="{StaticResource ModalIconButton}"
                                SemanticProperties.Description="{loc:LocalizedText Common_Close}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseSessionActivitiesClicked" />
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource ModalCloseIcon}" />
                        </Border>
                    </Grid>
                    <BoxView Grid.Row="1" Style="{StaticResource ModalDivider}" />
                    <Grid Grid.Row="2" Padding="{DynamicResource PresentationModalPagePadding}">
                        <ActivityIndicator
                        Style="{StaticResource StateBusyInline}" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                        <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}"
                                             IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                            <Label LineBreakMode="WordWrap" Text="{Binding ErrorText, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource BodyLabel}"
                                   IsVisible="{Binding HasError}" />
                            <Button Text="{loc:LocalizedText Workout_Session_TryAgainButton}"
                                    Command="{Binding RetryLoadCommand}"
                                    Style="{StaticResource ButtonSecondary}"
                                    IsVisible="{Binding HasError}" />
                            <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Session_NoActivitiesAvailable}"
                                   Style="{StaticResource BodyLabel}"
                                   IsVisible="{Binding HasNoActivities}" />
                            <ScrollView MaximumHeightRequest="{StaticResource ModalSheetBodyMaximumHeight}"
                                        IsVisible="{Binding HasActivityChoices}">
                                <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}"
                                                     BindableLayout.ItemsSource="{Binding ActivityCards}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="workoutModels:WorkoutActivitySectionItem">
                                            <Border Style="{StaticResource CardPrimary}"
                                                    MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                                    SemanticProperties.Description="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                                    SemanticProperties.Hint="{loc:LocalizedText Workout_Session_BeginActivityAccessibility}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnSessionActivitySelected" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}">
                                                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                                                        <Label LineBreakMode="WordWrap" Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                                               Style="{StaticResource CardTitle}" />
                                                        <Label LineBreakMode="WordWrap" Text="{Binding SummaryText, Converter={StaticResource LocalizedStringConverter}}"
                                                               Style="{StaticResource MutedLabel}" />
                                                    </VerticalStackLayout>
                                                    <Label LineBreakMode="WordWrap" Grid.Column="1" Text="{Binding MetricText}"
                                                           Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                                    <Path Grid.Column="2" Data="M1 1 L6 6 L1 11"
                                                          Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                          StrokeThickness="{StaticResource UiStrokeWidth1_5}" Aspect="Uniform" WidthRequest="{StaticResource UiDimension6}"
                                                          HeightRequest="{StaticResource UiDimension12}" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </ScrollView>
                        </VerticalStackLayout>
                    </Grid>
                    <Label LineBreakMode="WordWrap" Grid.Row="3" Text="{loc:LocalizedText Workout_Session_ChooseActivityToStart}"
                           Style="{StaticResource MutedLabel}"
                           Padding="{DynamicResource PresentationActionFooterPadding}"
                           IsVisible="{Binding HasActivityChoices}" />
                </Grid>
            </Border>
            </Grid>
        </sharedControls:AnimatedModalView>

        <!-- Reschedule Workout Modal -->
        <sharedControls:AnimatedModalView Grid.RowSpan="{StaticResource WorkoutOverlayRowSpan}"
                                          ZIndex="12"
                                          IsOpen="{Binding IsRescheduleModalVisible}">
            <Grid>
                <BoxView BackgroundColor="{StaticResource ModalScrim}">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseRescheduleModalCommand}" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <Border Style="{StaticResource ModalSurface}"
                        MaximumHeightRequest="{StaticResource ModalSheetMaximumHeight}"
                        VerticalOptions="End">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource UiSpacing0}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}"
                              Padding="{DynamicResource PresentationModalHeaderPadding}">
                            <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Reschedule_Title}"
                                   Style="{StaticResource ModalTitle}"
                                   SemanticProperties.HeadingLevel="Level1" />
                            <Border Grid.Column="1" Style="{StaticResource ModalIconButton}"
                                    SemanticProperties.Description="{loc:LocalizedText Common_Close}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseRescheduleModalCommand}" />
                                </Border.GestureRecognizers>
                                <Path Style="{StaticResource ModalCloseIcon}" />
                            </Border>
                        </Grid>

                        <BoxView Grid.Row="1" Style="{StaticResource ModalDivider}" />

                        <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource UiSpaceTight}"
                                             Padding="{DynamicResource PresentationModalPagePadding}">
                            <Label LineBreakMode="WordWrap" Text="{Binding ReschedulingWorkoutTitle}"
                                   Style="{StaticResource BodyStrong}" />
                            <Label LineBreakMode="WordWrap"
                                   Text="{Binding RescheduleStatusMessage, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource ErrorLabel}"
                                   IsVisible="{Binding HasRescheduleStatusMessage}" />

                            <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Reschedule_ChooseDatePrompt}"
                                   Style="{StaticResource MutedLabel}"
                                   IsVisible="{Binding HasAvailableRescheduleDates}" />

                            <ScrollView MaximumHeightRequest="{StaticResource ModalSheetBodyMaximumHeight}"
                                        IsVisible="{Binding HasAvailableRescheduleDates}">
                                <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}"
                                                     BindableLayout.ItemsSource="{Binding AvailableRescheduleDates}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="workoutModels:RescheduleDateOption">
                                            <Border Style="{StaticResource CardPrimary}"
                                                    MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding SelectRescheduleDateCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                                                    <Label LineBreakMode="WordWrap" Text="{Binding DisplayText}"
                                                           Style="{StaticResource BodyStrong}" VerticalOptions="Center" />
                                                    <BoxView Grid.Column="1"
                                                             WidthRequest="{StaticResource UiDimension12}"
                                                             HeightRequest="{StaticResource UiDimension12}"
                                                             CornerRadius="{StaticResource UiCornerRadius6}"
                                                             Color="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                                                             IsVisible="{Binding IsSelected}"
                                                             VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </ScrollView>
                        </VerticalStackLayout>

                        <Button Grid.Row="3"
                                Style="{StaticResource ButtonPrimary}"
                                Margin="{DynamicResource PresentationActionFooterPadding}"
                                Text="{loc:LocalizedText Workout_Reschedule_ConfirmButton}"
                                Command="{Binding ConfirmRescheduleCommand}"
                                IsEnabled="{Binding CanConfirmReschedule}"
                                IsVisible="{Binding HasAvailableRescheduleDates}" />
                    </Grid>
                </Border>
            </Grid>
        </sharedControls:AnimatedModalView>
    </Grid>

</ContentPage>

