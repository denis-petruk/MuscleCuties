<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Workout.WorkoutPage"
    x:Name="WorkoutRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Workout"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:workoutControls="clr-namespace:MuscleCuties.UI.Controls.Workout"
    xmlns:injuryControls="clr-namespace:MuscleCuties.UI.Controls.Injury"
    xmlns:workoutModels="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
    x:DataType="vm:WorkoutViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="{Binding IsTabBarVisible}">


    <Grid RowDefinitions="Auto,*">
        <!-- Top Sticky Header -->
        <Grid Padding="{StaticResource PresentationPageHeaderPadding}"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="{StaticResource UiSpaceControl}"
              HorizontalOptions="Fill"
              MaximumWidthRequest="{StaticResource UiDimension640}">
            <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource UiSpaceTight}" VerticalOptions="Center">
                <Label
                    Text="{Binding WeekTitle, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource Headline}"
                    LineBreakMode="WordWrap" />
                <Border
                    Style="{StaticResource PillBadge}"
                    IsVisible="{Binding HasKnownCyclePhase}">
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource UiSpacing7}">
                        <BoxView WidthRequest="{StaticResource UiDimension7}" HeightRequest="{StaticResource UiDimension7}" CornerRadius="{StaticResource UiCornerRadius4}"
                                 Color="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding CurrentPhaseName, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Page_PhaseFormat}"
                               FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                               LineBreakMode="WordWrap" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Border
                Grid.Column="1"
                Style="{StaticResource HeaderIconButton}"
                SemanticProperties.Description="{loc:LocalizedText Workout_Page_OpenInjuryLogAccessibility}"
                SemanticProperties.Hint="{Binding InjuryBannerSummary, Converter={StaticResource LocalizedStringConverter}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenInjuryModalCommand}" />
                </Border.GestureRecognizers>
                <Grid>
                    <mi:MauiIcon Icon="{mi:Fluent HeartPulse32}" IconSize="{StaticResource UiDimension22}"
                                 IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                 WidthRequest="{StaticResource UiDimension22}" HeightRequest="{StaticResource UiDimension22}" HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                    <BoxView WidthRequest="{StaticResource UiDimension8}" HeightRequest="{StaticResource UiDimension8}" CornerRadius="{StaticResource UiCornerRadius4}" Margin="{StaticResource UiInsets0_6_6_0}"
                             Color="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                             HorizontalOptions="End" VerticalOptions="Start"
                             IsVisible="{Binding HasActiveInjuries}"
                             InputTransparent="True" />
                </Grid>
            </Border>
        </Grid>

        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
        <CollectionView ItemsSource="{Binding Workouts}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout
                    Padding="{StaticResource PresentationPageContentPadding}"
                    Spacing="{StaticResource UiSpaceControl}"
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="{StaticResource UiDimension640}">

                    <Border Style="{StaticResource CardAccent}" IsVisible="{Binding HasInProgressWorkout}">
                        <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                            <Label Text="{loc:LocalizedText Workout_Overview_InProgressTitle}" Style="{StaticResource BodyStrong}" />
                            <Label Text="{loc:LocalizedText Workout_Overview_InProgressExplanation}" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding InProgressWorkout.Title}" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
                            <Button Text="{loc:LocalizedText Workout_Overview_ResumeWorkout}" Command="{Binding ResumeInProgressWorkoutCommand}" Style="{StaticResource ButtonPrimary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardAccent}"
                            IsVisible="{Binding HasActiveInjuries}"
                            SemanticProperties.Description="{loc:LocalizedText Workout_Page_InjuryAdjustmentsActive}"
                            SemanticProperties.Hint="{Binding InjuryBannerSummary, Converter={StaticResource LocalizedStringConverter}}">
                        <VerticalStackLayout Spacing="{StaticResource UiSpacing6}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                                <Label
                                    Text="{Binding InjuryBannerSummary, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource BodyCompact}" LineBreakMode="WordWrap"
                                    VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="{loc:LocalizedText Workout_Page_DetailsButton}"
                                        Style="{StaticResource ButtonSecondary}"
                                        Command="{Binding ToggleInjuryBannerCommand}"
                                        VerticalOptions="Center" HorizontalOptions="End"
                                        SemanticProperties.Hint="{loc:LocalizedText Workout_Page_ToggleInjuryAdjustmentsAccessibility}" />
                                <Button Grid.Column="2" Text="{loc:LocalizedText Workout_Page_LogButton}"
                                        Style="{StaticResource ButtonSecondary}"
                                        Command="{Binding NavigateToInjuryLogCommand}"
                                        VerticalOptions="Center" HorizontalOptions="End"
                                        SemanticProperties.Hint="{loc:LocalizedText Workout_Page_OpenInjuryLogAccessibility}" />
                            </Grid>

                            <VerticalStackLayout Spacing="{StaticResource UiSpacing6}" IsVisible="{Binding IsInjuryBannerExpanded}">
                                <!-- Blocked exercises -->
                                <VerticalStackLayout Spacing="{StaticResource UiSpacing2}" IsVisible="{Binding HasBlockedExercises}">
                                    <Label Text="{loc:LocalizedText Workout_Page_BlockedExercisesTitle}" FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           Style="{StaticResource MutedLabel}" />
                                    <VerticalStackLayout Spacing="{StaticResource UiSpacing1}"
                                                         BindableLayout.ItemsSource="{Binding BlockedExerciseNames}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label Text="{Binding .}" FontSize="{StaticResource UiFontSize13}"
                                                       Style="{StaticResource MutedLabel}" Margin="{StaticResource UiInsets8_0_0_0}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Rehab recommendations -->
                                <VerticalStackLayout Spacing="{StaticResource UiSpacing2}" IsVisible="{Binding HasRehabExercises}">
                                    <Label Text="{loc:LocalizedText Workout_Page_RehabRecommendationsTitle}" FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}" />
                                    <VerticalStackLayout Spacing="{StaticResource UiSpacing1}"
                                                         BindableLayout.ItemsSource="{Binding RehabExerciseNames}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label Text="{Binding .}" FontSize="{StaticResource UiFontSize13}"
                                                       Style="{StaticResource AccentLabel}" Margin="{StaticResource UiInsets8_0_0_0}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Blocked cardio -->
                                <VerticalStackLayout Spacing="{StaticResource UiSpacing2}" IsVisible="{Binding HasBlockedCardio}">
                                    <Label Text="{loc:LocalizedText Workout_Page_BlockedActivitiesTitle}" FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           Style="{StaticResource MutedLabel}" />
                                    <VerticalStackLayout Spacing="{StaticResource UiSpacing1}"
                                                         BindableLayout.ItemsSource="{Binding BlockedCardioNames}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label Text="{Binding .}" FontSize="{StaticResource UiFontSize13}"
                                                       Style="{StaticResource MutedLabel}" Margin="{StaticResource UiInsets8_0_0_0}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <toolkit:LazyView
                        x:Name="FeaturedWorkoutLazy"
                        x:TypeArguments="workoutControls:WorkoutFeaturedSection" />

                    <VerticalStackLayout Spacing="{StaticResource UiSpacing2}" Margin="{StaticResource UiInsets0_6_0_0}">
                        <Label Text="{loc:LocalizedText Workout_Page_ActivityScheduleTitle}" Style="{StaticResource SectionTitle}" />
                        <Label
                            Text="{Binding PlanSummaryText, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource UiSpaceTight}">
                        <Button Text="{loc:LocalizedText Workout_Page_Week1}" Command="{Binding SelectWeekCommand}"
                                Style="{StaticResource ButtonSecondary}">
                            <Button.CommandParameter>
                                <x:Int32>0</x:Int32>
                            </Button.CommandParameter>
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedWeekIndex}" Value="0">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SecondaryDarkText}}" />
                                    <Setter Property="BorderWidth" Value="{StaticResource UiStrokeWidth0}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="{loc:LocalizedText Workout_Page_Week2}" Command="{Binding SelectWeekCommand}"
                                Grid.Column="1"
                                Style="{StaticResource ButtonSecondary}">
                            <Button.CommandParameter>
                                <x:Int32>1</x:Int32>
                            </Button.CommandParameter>
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedWeekIndex}" Value="1">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SecondaryDarkText}}" />
                                    <Setter Property="BorderWidth" Value="{StaticResource UiStrokeWidth0}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="{loc:LocalizedText Workout_Page_Week3}" Command="{Binding SelectWeekCommand}"
                                Grid.Column="2"
                                Style="{StaticResource ButtonSecondary}">
                            <Button.CommandParameter>
                                <x:Int32>2</x:Int32>
                            </Button.CommandParameter>
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedWeekIndex}" Value="2">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SecondaryDarkText}}" />
                                    <Setter Property="BorderWidth" Value="{StaticResource UiStrokeWidth0}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="{loc:LocalizedText Workout_Page_Week4}" Command="{Binding SelectWeekCommand}"
                                Grid.Column="3"
                                Style="{StaticResource ButtonSecondary}">
                            <Button.CommandParameter>
                                <x:Int32>3</x:Int32>
                            </Button.CommandParameter>
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedWeekIndex}" Value="3">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SecondaryDarkText}}" />
                                    <Setter Property="BorderWidth" Value="{StaticResource UiStrokeWidth0}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="{StaticResource UiSpaceTight}" BindableLayout.ItemsSource="{Binding ScheduleDays}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="workoutModels:ScheduleDayItem">
                                    <Border Style="{StaticResource CardAccent}"
                                            BackgroundColor="{Binding AccentColor}"
                                            MinimumWidthRequest="{StaticResource UiDimension72}"
                                            MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                            SemanticProperties.Description="{Binding WorkoutTitle, Converter={StaticResource LocalizedStringConverter}}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectScheduleDayCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="{StaticResource UiSpacing2}">
                                            <Label
                                                Text="{Binding DayLabel, Converter={StaticResource LocalizedStringConverter}}"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{Binding AccentTextColor}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                                LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Date, StringFormat='{0:dd MMM}'}"
                                                   HorizontalTextAlignment="Center"
                                                   TextColor="{Binding AccentTextColor}"
                                                   LineBreakMode="WordWrap" />
                                            <Label
                                                Text="{Binding WorkoutTag, Converter={StaticResource LocalizedStringConverter}}"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{Binding AccentTextColor}" FontSize="{StaticResource UiFontSize11}"
                                                LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <FlexLayout
                        Direction="Row"
                        Wrap="NoWrap"
                        AlignItems="Stretch"
                        BindableLayout.ItemsSource="{Binding Filters}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="workoutModels:FilterChipItem">
                                <Border
                                    Style="{StaticResource SelectableCard}"
                                    FlexLayout.Basis="25%"
                                    Margin="{StaticResource UiInsets2_0}"
                                    SemanticProperties.Description="{Binding Label, Converter={StaticResource LocalizedStringConverter}}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="SemanticProperties.Hint" Value="Selected filter" />


                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}"
                                                     Value="False">
                                            <Setter Property="SemanticProperties.Hint" Value="Not selected" />


                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectFilterCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="{Binding Label, Converter={StaticResource LocalizedStringConverter}}"
                                        FontSize="{StaticResource UiFontSize13}"
                                        FontAttributes="{StaticResource UiFontAttributesBold}"
                                        HorizontalTextAlignment="Center"
                                        VerticalOptions="Center"
                                        LineBreakMode="WordWrap">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SecondaryDarkText}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}"
                                                         Value="False">
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Margin="{StaticResource UiInsets0_24}"
                        SemanticProperties.Description="{loc:LocalizedText Workout_Page_LoadingWorkouts}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Border
                    Style="{StaticResource CardPrimary}"
                    Margin="{StaticResource UiInsets20_0_20_32}"
                    MaximumWidthRequest="{StaticResource UiDimension640}"
                    IsVisible="{Binding HasNoWorkouts}"
                    VerticalOptions="Start">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                        <Label
                            Text="{Binding EmptyWorkoutsTitle, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource CardTitle}"
                            FontSize="{StaticResource UiFontSize17}" />
                        <Label
                            Text="{Binding EmptyWorkoutsSubtitle, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource MutedLabel}" />

                        <Button Style="{StaticResource ButtonSecondary}"
                            Text="{Binding EmptyWorkoutsButtonText, Converter={StaticResource LocalizedStringConverter}}"
                            Command="{Binding EmptyWorkoutsActionCommand}"
                            IsVisible="{Binding EmptyWorkoutsButtonVisible}" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="workoutModels:WorkoutItem">
                    <workoutControls:WorkoutActivityCard
                        Margin="{StaticResource UiInsets20_0_20_12}"
                        MaximumWidthRequest="{StaticResource UiDimension640}"
                        OpenCommand="{Binding OpenWorkoutCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                        ToggleOptionalCommand="{Binding ToggleSessionOptionalCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                        ToggleEasierAlternativeCommand="{Binding ToggleEasierAlternativeCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                        CommandParameter="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>

        <!-- Generate Plan Prompt Overlay (shown prominently covering workout cards/blocks when no plan exists) -->
        <Grid Grid.Row="1"
              IsVisible="{Binding ShowNoPlanPrompt}"
              BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
              Padding="{StaticResource PresentationPageContentPadding}"
              ZIndex="5">
            <Border Style="{StaticResource CardPrimary}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="{StaticResource UiDimension640}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">
                    <Label Text="{loc:LocalizedText Workout_Generation_PromptNoPlanTitle}"
                           Style="{StaticResource CardTitle}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{loc:LocalizedText Workout_Generation_PromptNoPlanSubtitle}"
                           Style="{StaticResource MutedLabel}"
                           HorizontalTextAlignment="Center" />
                    <Button Style="{StaticResource ButtonPrimary}"
                            Text="{loc:LocalizedText Workout_Generation_PromptGeneratePlanButton}"
                            Command="{Binding GeneratePlanCommand}"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <sharedControls:PageLoadingOverlay
            Grid.RowSpan="{StaticResource WorkoutOverlayRowSpan}"
            ZIndex="15"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}" />
        <toolkit:LazyView
            x:Name="InjuryModalLazy"
            Grid.RowSpan="{StaticResource WorkoutOverlayRowSpan}"
            ZIndex="20"
            x:TypeArguments="injuryControls:InjuryLogModal"
            InputTransparent="{Binding IsInjuryModalVisible, Converter={StaticResource InvertedBoolConverter}}" />

        <Grid x:Name="SessionActivitiesOverlay" Grid.RowSpan="{StaticResource WorkoutOverlayRowSpan}"
              IsVisible="False" ZIndex="10"
              BindingContext="{x:Null}">
            <BoxView BackgroundColor="{StaticResource ModalScrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseSessionActivitiesClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border Style="{StaticResource ModalSurface}"
                    Padding="{StaticResource PresentationModalPagePadding}"
                    MaximumHeightRequest="{StaticResource UiDimension520}" VerticalOptions="End">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing14}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                        <Label Text="{loc:LocalizedText Workout_Session_ActivitiesTitle}" Style="{StaticResource ModalTitle}"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Button Grid.Column="1" Text="{loc:LocalizedText Common_Close}"
                                Clicked="OnCloseSessionActivitiesClicked"
                                Style="{StaticResource ButtonSecondary}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                        <VerticalStackLayout Spacing="{StaticResource UiSpacing10}"
                                             IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="{Binding ErrorText, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource BodyLabel}"
                                   IsVisible="{Binding HasError}" />
                            <Button Text="{loc:LocalizedText Workout_Session_TryAgainButton}"
                                    Command="{Binding RetryLoadCommand}"
                                    Style="{StaticResource ButtonSecondary}"
                                    IsVisible="{Binding HasError}" />
                            <Label Text="{loc:LocalizedText Workout_Session_NoActivitiesAvailable}"
                                   Style="{StaticResource BodyLabel}"
                                   IsVisible="{Binding HasNoActivities}" />
                            <ScrollView MaximumHeightRequest="{StaticResource UiDimension360}"
                                        IsVisible="{Binding HasActivityChoices}">
                                <VerticalStackLayout Spacing="{StaticResource UiSpacing10}"
                                                     BindableLayout.ItemsSource="{Binding ActivityCards}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="workoutModels:WorkoutActivitySectionItem">
                                            <Border Style="{StaticResource CardPrimary}"
                                                    MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                                    SemanticProperties.Description="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                                    SemanticProperties.Hint="{loc:LocalizedText Workout_Session_BeginActivityAccessibility}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnSessionActivitySelected" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}">
                                                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                                                        <Label Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                                               Style="{StaticResource CardTitle}" />
                                                        <Label Text="{Binding SummaryText, Converter={StaticResource LocalizedStringConverter}}"
                                                               Style="{StaticResource MutedLabel}" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="1" Text="{Binding MetricText}"
                                                           Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                                    <Path Grid.Column="2" Data="M1 1 L6 6 L1 11"
                                                          Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                          StrokeThickness="{StaticResource UiStrokeWidth1_5}" Aspect="Uniform" WidthRequest="{StaticResource UiDimension6}"
                                                          HeightRequest="{StaticResource UiDimension12}" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </ScrollView>
                        </VerticalStackLayout>
                    </Grid>
                    <Label Grid.Row="2" Text="{loc:LocalizedText Workout_Session_ChooseActivityToStart}"
                           Style="{StaticResource MutedLabel}"
                           IsVisible="{Binding HasActivityChoices}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
