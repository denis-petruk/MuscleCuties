<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Startup.AppStartupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:local="clr-namespace:MuscleCuties.UI.Pages.Startup"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    x:DataType="local:AppStartupPage"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False">

    <Grid
        x:Name="StartupRoot"
        RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="{DynamicResource PresentationAuthPagePadding}" Spacing="{StaticResource UiSpaceControl}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill" VerticalOptions="Center">
            <Image
                x:Name="StartupLogo"
                Source="{AppThemeBinding Light=musclecuties_logo_light_transparent.png, Dark=musclecuties_logo_dark_transparent.png}"
                Aspect="AspectFit"
                WidthRequest="{StaticResource UiDimension220}"
                HeightRequest="{StaticResource UiDimension124}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{StaticResource Transparent}"
                SemanticProperties.Description="{loc:LocalizedText Dashboard_Startup_LogoA11y}" />
            <ActivityIndicator
                Style="{StaticResource StateBusyPage}"
                x:Name="StartupActivityIndicator"
                IsRunning="True"
                HorizontalOptions="Center"
                SemanticProperties.Description="{loc:LocalizedText Dashboard_Startup_LoadingApplicationA11y}" />
            <Label
                x:Name="StartupStatusLabel"
                AutomationId="StartupStatusLabel"
                Text="{loc:LocalizedText Dashboard_Startup_GettingReady}"
                Style="{StaticResource MutedCentered}"
                LineBreakMode="WordWrap">
                <Label.Behaviors>
                    <sharedControls:ScreenReaderStatusAnnouncementBehavior />
                </Label.Behaviors>
            </Label>
            <Label
                x:Name="StartupErrorLabel"
                AutomationId="StartupErrorLabel"
                IsVisible="False"
                Text="{loc:LocalizedText Dashboard_Startup_UnlockFailedTitle}"
                Style="{StaticResource SectionTitle}"
                LineBreakMode="WordWrap"
                HorizontalTextAlignment="Center"
                SemanticProperties.HeadingLevel="Level1">
                <Label.Behaviors>
                    <sharedControls:ScreenReaderStatusAnnouncementBehavior />
                </Label.Behaviors>
            </Label>
            <Label
                x:Name="StartupRecoveryLabel"
                IsVisible="False"
                Text="{loc:LocalizedText Dashboard_Startup_UnlockFailedMessage}"
                Style="{StaticResource MutedCentered}"
                LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
    <VerticalStackLayout
        x:Name="StartupErrorFooter"
        IsVisible="False"
        Grid.Row="1"
        Padding="{DynamicResource PresentationActionFooterPadding}"
        Spacing="{StaticResource UiSpaceTight}"
        MaximumWidthRequest="{StaticResource PageContentMaxWidth}"
        HorizontalOptions="Fill">
        <Button Style="{StaticResource ButtonPrimary}"
            x:Name="RetryButton"
            AutomationId="StartupRetryButton"
            IsVisible="False"
            Text="{loc:LocalizedText Dashboard_Shared_Retry}"
            Clicked="OnRetryClicked"
            SemanticProperties.Description="{loc:LocalizedText Dashboard_Shared_Retry}" />
        <Button
            x:Name="ResetButton"
            AutomationId="StartupResetButton"
            IsVisible="False"
            Text="{loc:LocalizedText Startup_ResetLocalData}"
            Clicked="OnResetClicked"
            Style="{StaticResource ButtonSecondary}"
            SemanticProperties.Description="{loc:LocalizedText Startup_ResetLocalData}"
            SemanticProperties.Hint="{loc:LocalizedText Startup_ResetLocalDataHint}" />
    </VerticalStackLayout>
</Grid>
</ContentPage>
