<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Auth.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Auth"
    x:DataType="vm:RegisterViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">


    <Grid RowDefinitions="Auto,*">
    <VerticalStackLayout Grid.Row="0" Padding="{DynamicResource PresentationPageHeaderPadding}" Spacing="{StaticResource UiSpaceTight}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
        <Label
           
            Text="{loc:LocalizedText Auth_Register_CreateYourAccount}"
            Style="{StaticResource PageTitle}"
            LineBreakMode="WordWrap"
           
            SemanticProperties.HeadingLevel="Level1" />
        <Label
           
            Text="{loc:LocalizedText Auth_Register_OneProfileShapedAroundYou}"
            Style="{StaticResource MutedLabel}"
            LineBreakMode="WordWrap"
            />
    </VerticalStackLayout>
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="{DynamicResource PresentationAuthPagePadding}" Spacing="{StaticResource PresentationFormSpacing}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
            <Grid
               
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                RowSpacing="{StaticResource PresentationFormSpacing}">
                <Grid Grid.Row="0" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                    <Label Text="{loc:LocalizedText Auth_Email}" Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                    <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="RegisterEmail"
                            AutomationId="RegisterEmail"
                            Placeholder="{loc:LocalizedText Auth_Register_NameExampleCom}"
                            Text="{Binding Email}"
                            Keyboard="Email"
                            ReturnType="Next"
                            Completed="OnEmailCompleted"
                            SemanticProperties.Description="{loc:LocalizedText Auth_EmailAddress}"
                            SemanticProperties.Hint="{loc:LocalizedText Auth_Register_EnterYourEmailThenPressNext}" />
                    </Border>
                </Grid>
            
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                    <Label Text="{loc:LocalizedText Auth_Register_UsernameLabel}" Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                    <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="RegisterUsername"
                            AutomationId="RegisterUsername"
                            Placeholder="{loc:LocalizedText Auth_Register_UsernamePlaceholder}"
                            Text="{Binding Username}"
                            Keyboard="Plain"
                            ReturnType="Next"
                            Completed="OnUsernameCompleted"
                            SemanticProperties.Description="{loc:LocalizedText Auth_Register_UsernameLabel}"
                            SemanticProperties.Hint="{loc:LocalizedText Auth_Register_EnterYourUniqueUsernameThenPress}" />
                    </Border>
                </Grid>
            
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                    <Label Text="{loc:LocalizedText Auth_Password}" Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                    <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="RegisterPassword"
                            AutomationId="RegisterPassword"
                            Placeholder="{loc:LocalizedText Auth_Register_CreatePassword}"
                            Text="{Binding Password}"
                            IsPassword="True"
                            ReturnType="Next"
                            Completed="OnPasswordCompleted"
                            SemanticProperties.Description="{loc:LocalizedText Auth_Register_CreatePassword}"
                            SemanticProperties.Hint="{loc:LocalizedText Auth_Register_UseAtLeastEightCharactersWith}" />
                    </Border>
                </Grid>
            
                <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                    <Label Text="{loc:LocalizedText Auth_ConfirmPassword}" Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                    <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="RegisterConfirmPassword"
                            AutomationId="RegisterConfirmPassword"
                            Placeholder="{loc:LocalizedText Auth_Register_RepeatPassword}"
                            Text="{Binding ConfirmPassword}"
                            IsPassword="True"
                            ReturnType="Done"
                            ReturnCommand="{Binding RegisterCommand}"
                            SemanticProperties.Description="{loc:LocalizedText Auth_ConfirmPassword}"
                            SemanticProperties.Hint="{loc:LocalizedText Auth_Register_ReEnterYourPasswordThenPress}" />
                    </Border>
                </Grid>
            
                <Label
                    Grid.Row="4"
                    Text="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource ErrorLabel}"
                    LineBreakMode="WordWrap"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                    SemanticProperties.Description="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                    SemanticProperties.HeadingLevel="Level3" />
            
                <!-- One acknowledgment group: the checkbox carries the accessible name and state, and
                     the wrapped label toggles it so the whole copy is a tap target. The policy stays
                     a separate, full action beneath it. -->
                <VerticalStackLayout Grid.Row="5" Spacing="{StaticResource UiSpaceTight}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="{StaticResource UiSpaceTight}">
                        <CheckBox x:Name="PrivacyConsentCheckBox"
                                  AutomationId="PrivacyConsentCheckBox"
                                  IsChecked="{Binding HasAcceptedPrivacyNotice}"
                                  Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource ActionSurfaceDark}}"
                                  HorizontalOptions="Start"
                                  VerticalOptions="Start"
                                  MinimumWidthRequest="{StaticResource PresentationMinimumTouchSize}"
                                  MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                  SemanticProperties.Description="{loc:LocalizedText Auth_Register_PrivacyConsent}" />
                        <Label Grid.Column="1"
                               Text="{loc:LocalizedText Auth_Register_PrivacyConsent}"
                               Style="{StaticResource CaptionLabel}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyConsentLabelTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Button
                        Text="{loc:LocalizedText Profile_Privacy_Policy}"
                        Style="{StaticResource ButtonSecondary}"
                        HorizontalOptions="Start"
                        LineBreakMode="WordWrap"
                        Command="{Binding GoToPrivacyPolicyCommand}"
                        SemanticProperties.Description="{loc:LocalizedText Profile_Privacy_Policy}" />
                </VerticalStackLayout>
            
            </Grid>

            <!-- Actions live in the same scroll flow directly after the acknowledgment, so the
                 keyboard and large text never pin a footer over the fields, consent or validation. -->
            <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                <Button Style="{StaticResource ButtonPrimary}"
                    Text="{loc:LocalizedText Auth_CreateAccount}"
                    AutomationId="RegisterButton" Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    LineBreakMode="WordWrap"
                    SemanticProperties.Description="{loc:LocalizedText Auth_Register_CreateYourAccount}" />
                <ActivityIndicator
                    Style="{StaticResource StateBusyInline}"
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    SemanticProperties.Description="{loc:LocalizedText Auth_Register_CreatingAccountPleaseWait}" />
                <Button
                    Style="{StaticResource ButtonSecondary}"
                    Text="{loc:LocalizedText Auth_SignInWithApple}"
                    Command="{Binding SignInWithAppleCommand}"
                    IsVisible="{Binding IsAppleSignInAvailable}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    LineBreakMode="WordWrap"
                    SemanticProperties.Description="{loc:LocalizedText Auth_SignInWithApple}" />
                <Grid
                    ColumnDefinitions="Auto,Auto"
                    ColumnSpacing="{StaticResource UiSpaceMicro}"
                    HorizontalOptions="Center"
                    MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                    MinimumWidthRequest="{StaticResource PresentationMinimumTouchSize}"
                    SemanticProperties.Description="{loc:LocalizedText Auth_Register_ReturnToLogin}"
                    SemanticProperties.Hint="{loc:LocalizedText Auth_Register_DoubleTapToGoBackTo}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="{loc:LocalizedText Auth_Register_AlreadyHaveAnAccount}" Style="{StaticResource MutedLabel}"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{loc:LocalizedText Auth_LogIn}" Style="{StaticResource AccentLabel}"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</Grid>
</ContentPage>
