<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Auth.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Auth"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0" Padding="{DynamicResource PresentationPageHeaderPadding}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
        <sharedControls:PageHeader
            Title="{loc:LocalizedText Auth_Login_WelcomeBack}"
            Subtitle="{loc:LocalizedText Auth_Login_YourPlanIsReadyWhenYou}"
            ShowBack="False" />
    </Grid>
    <!-- The form and its actions share one scrolling surface: with the keyboard up, Sign in and
         Create account stay reachable instead of sitting behind the keyboard. -->
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="{DynamicResource PresentationAuthPagePadding}" Spacing="{StaticResource PresentationFormSpacing}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
            <Label

                Text="{Binding InfoMessage, Converter={StaticResource LocalizedStringConverter}}"
                Style="{StaticResource AccentLabel}"
                LineBreakMode="WordWrap"
                IsVisible="{Binding InfoMessage, Converter={StaticResource StringToBoolConverter}}"
                Margin="{StaticResource UiInsets0_0_0_16}"
                SemanticProperties.Description="{Binding InfoMessage, Converter={StaticResource LocalizedStringConverter}}" />

            <VerticalStackLayout Spacing="{StaticResource PresentationFormSpacing}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                    <Label Text="{loc:LocalizedText Auth_EmailOrUsername}" Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                    <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="LoginEmail"
                            AutomationId="LoginEmail"
                            Placeholder="{loc:LocalizedText Auth_Register_NameExampleCom}"
                            Text="{Binding Email}"
                            Keyboard="Email"
                            ReturnType="Next"
                            Completed="OnEmailCompleted"
                            SemanticProperties.Description="{loc:LocalizedText Auth_Login_EmailAddressOrUsername}"
                            SemanticProperties.Hint="{loc:LocalizedText Auth_Login_EnterYourEmailOrUsernameThen}" />
                    </Border>
                </Grid>
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                    <Label Text="{loc:LocalizedText Auth_Password}" Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                    <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                            <Entry
                                x:Name="LoginPassword"
                                AutomationId="LoginPassword"
                                Placeholder="{loc:LocalizedText Auth_Password}"
                                Text="{Binding Password}"
                                IsPassword="True"
                                ReturnType="Done"
                                ReturnCommand="{Binding LoginCommand}"
                                SemanticProperties.Description="{loc:LocalizedText Auth_Password}"
                                SemanticProperties.Hint="{loc:LocalizedText Auth_Login_EnterYourPasswordThenPressDone}" />
                            <Label
                                x:Name="LoginPasswordReveal"
                                Grid.Column="1"
                                Text="{loc:LocalizedText Auth_ShowPassword}"
                                Style="{StaticResource AccentLabel}"
                                HorizontalTextAlignment="End"
                                VerticalTextAlignment="Center"
                                MinimumWidthRequest="{StaticResource PresentationMinimumTouchSize}"
                                MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                SemanticProperties.Description="{loc:LocalizedText Auth_ShowPassword}"
                                SemanticProperties.Hint="{loc:LocalizedText Auth_TogglePasswordVisibilityHint}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleLoginPassword" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                    <Label
                        Grid.Row="2"
                        Text="{loc:LocalizedText Auth_Login_ForgotPasswordLink}"
                        Style="{StaticResource AccentLabel}"
                        HorizontalOptions="End"
                        VerticalTextAlignment="Center"
                        MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                        LineBreakMode="WordWrap"
                        Margin="{StaticResource UiInsets0_4_0_0}"
                        SemanticProperties.Description="{loc:LocalizedText Auth_Login_ForgotPasswordDescription}"
                        SemanticProperties.Hint="{loc:LocalizedText Auth_Login_DoubleTapToOpenPasswordRecovery}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToRecoveryCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <Label

                    Text="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource ErrorLabel}"
                    LineBreakMode="WordWrap"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                    SemanticProperties.Description="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                    SemanticProperties.HeadingLevel="Level3" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}" Margin="{StaticResource UiInsets0_16_0_0}">
                <Button Style="{StaticResource ButtonPrimary}"

                    Text="{loc:LocalizedText Auth_LogIn}"
                    AutomationId="LoginButton" Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    SemanticProperties.Description="{loc:LocalizedText Auth_Login_LogInToYourAccount}" />
                <ActivityIndicator
                                Style="{StaticResource StateBusyInline}"

                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{loc:LocalizedText Auth_Login_SigningInPleaseWait}" />
                <Button
                    AutomationId="LoginAppleButton"
                    Style="{StaticResource ButtonApple}"
                    Text="{loc:LocalizedText Auth_SignInWithApple}"
                    ImageSource="icon_apple.png"
                    Command="{Binding SignInWithAppleCommand}"
                    IsVisible="{Binding IsAppleSignInAvailable}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    SemanticProperties.Description="{loc:LocalizedText Auth_SignInWithApple}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    <FlexLayout
        Grid.Row="2"
        AutomationId="LoginCreateAccountRow"
        Direction="Row"
        Wrap="Wrap"
        JustifyContent="Center"
        AlignItems="Center"
        Padding="{DynamicResource PresentationActionFooterPadding}"
        MaximumWidthRequest="{StaticResource PageContentMaxWidth}"
        HorizontalOptions="Fill"
        MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
        SemanticProperties.Description="{loc:LocalizedText Auth_Login_CreateAnAccount}"
        SemanticProperties.Hint="{loc:LocalizedText Auth_Login_DoubleTapToGoToThe}">
        <FlexLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
        </FlexLayout.GestureRecognizers>
        <Label Text="{loc:LocalizedText Auth_Login_NewToMusclecuties}" Style="{StaticResource MutedLabel}"
               LineBreakMode="WordWrap"
               VerticalOptions="Center" />
        <Label Text="{loc:LocalizedText Auth_CreateAccount}" Style="{StaticResource AccentLabel}"
               LineBreakMode="WordWrap"
               VerticalOptions="Center"
               Margin="{StaticResource UiInsets6_0_0_0}" />
    </FlexLayout>
</Grid>
</ContentPage>
