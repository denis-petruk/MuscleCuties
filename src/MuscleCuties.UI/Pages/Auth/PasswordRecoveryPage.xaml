<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Auth.PasswordRecoveryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Auth"
    x:DataType="vm:PasswordRecoveryViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*">
    <VerticalStackLayout Grid.Row="0" Padding="{DynamicResource PresentationPageHeaderPadding}" Spacing="{StaticResource UiSpaceTight}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
        <Label
           
            Text="{loc:LocalizedText Auth_PasswordRecovery_ResetYourPassword}"
            Style="{StaticResource PageTitle}"
            LineBreakMode="WordWrap"
           
            SemanticProperties.HeadingLevel="Level1" />
    </VerticalStackLayout>
    <ScrollView x:Name="RecoveryScroll" Grid.Row="1">
        <VerticalStackLayout Padding="{DynamicResource PresentationAuthPagePadding}" Spacing="{StaticResource PresentationFormSpacing}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource PresentationFormSpacing}" IsVisible="{Binding IsStep1}">
                <Label
                    Grid.Row="0"
                    Text="{loc:LocalizedText Auth_PasswordRecovery_EnterYourRegisteredEmailAddressOr}"
                    Style="{StaticResource MutedLabel}"
                    LineBreakMode="WordWrap"
                    Margin="{StaticResource UiInsets0_0_0_12}" />
            
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                    <Label Text="{loc:LocalizedText Auth_EmailOrUsername}" Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                    <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="RecoveryIdentifierEntry"
                            AutomationId="RecoveryIdentifierEntry"
                            Placeholder="{loc:LocalizedText Auth_EmailOrUsernamePlaceholder}"
                            Text="{Binding EmailOrUsername}"
                            Keyboard="Email"
                            ReturnType="Send"
                            ReturnCommand="{Binding StartRecoveryCommand}"
                            SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_EmailOrUsernameForPasswordRecovery}"
                            SemanticProperties.Hint="{loc:LocalizedText Auth_PasswordRecovery_EnterYourEmailOrUsernameAnd}" />
                    </Border>
                </Grid>
            
                
            </Grid>

            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing0}" IsVisible="{Binding IsStep2}">
                <Label
                    Grid.Row="0"
                    Text="{loc:LocalizedText Auth_PasswordRecovery_EnterTheSixDigitRecoveryCode}"
                    Style="{StaticResource MutedLabel}"
                    LineBreakMode="WordWrap"
                    Margin="{StaticResource UiInsets0_0_0_4}" />
                <Label
                    Grid.Row="1"
                    Text="{Binding MaskedEmail}"
                    Style="{StaticResource AccentLabel}"
                    LineBreakMode="WordWrap"
                    Margin="{StaticResource UiInsets0_0_0_24}" />
            
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource PresentationFormSpacing}">
                    <Grid Grid.Row="0" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                        <Label Text="{loc:LocalizedText Auth_PasswordRecovery_SixDigitRecoveryCodeLabel}" Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                        <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                            <Entry
                                x:Name="RecoveryOtpEntry"
                                AutomationId="RecoveryOtpEntry"
                                Placeholder="{loc:LocalizedText Common_Placeholder_SixDigitCode}"
                                Text="{Binding OtpCode}"
                                Keyboard="Numeric"
                                MaxLength="{StaticResource AuthCodeLength}"
                                ReturnType="Done"
                                ReturnCommand="{Binding VerifyCodeCommand}"
                                SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_SixDigitRecoveryCodeDescription}"
                                SemanticProperties.Hint="{loc:LocalizedText Auth_Otp_EnterTheSixDigitVerificationCode}" />
                        </Border>
                    </Grid>
            
                    <Label
                        Grid.Row="1"
                        Text="{Binding InfoMessage, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource AccentLabel}"
                        LineBreakMode="WordWrap"
                        IsVisible="{Binding InfoMessage, Converter={StaticResource StringToBoolConverter}}"
                        SemanticProperties.Description="{Binding InfoMessage, Converter={StaticResource LocalizedStringConverter}}" />
            
                    <Label
                        Grid.Row="2"
                        Text="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ErrorLabel}"
                        LineBreakMode="WordWrap"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                        SemanticProperties.Description="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                        SemanticProperties.HeadingLevel="Level3" />
            
                    
            
                    <ActivityIndicator
                        Style="{StaticResource StateBusyInline}"
                        Grid.Row="4"
                        HorizontalOptions="Center"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_ProcessingRecoveryPleaseWait}" />
            
                    <Grid
                        Grid.Row="5"
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="{StaticResource UiSpaceCompact}"
                        Margin="{StaticResource UiInsets0_12_0_0}">
                        <Button
                            Text="{loc:LocalizedText Auth_PasswordRecovery_ResendCode}"
                            Command="{Binding ResendCodeCommand}"
                            IsEnabled="{Binding CanResend}"
                            Style="{StaticResource ButtonSecondary}"
                            SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_ResendRecoveryCode}" />
                        <Button
                            Grid.Column="1"
                            Text="{loc:LocalizedText Auth_PasswordRecovery_ChangeAccount}"
                            Command="{Binding GoBackCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_GoBackToChangeAccount}" />
                        <Label
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="{StaticResource UiInsets0_8_0_0}"
                            Text="{Binding ResendButtonText, Converter={StaticResource LocalizedStringConverter}}"
                            IsVisible="{Binding CanResend, Converter={StaticResource InvertedBoolConverter}}"
                            Style="{StaticResource MutedLabel}"
                            LineBreakMode="WordWrap"
                            SemanticProperties.Description="{Binding ResendButtonText, Converter={StaticResource LocalizedStringConverter}}" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource PresentationFormSpacing}" IsVisible="{Binding IsStep3}">
                <Label
                    Grid.Row="0"
                    Text="{loc:LocalizedText Auth_PasswordRecovery_ChooseAStrongNewPasswordWith}"
                    Style="{StaticResource MutedLabel}"
                    LineBreakMode="WordWrap"
                    Margin="{StaticResource UiInsets0_0_0_12}" />
            
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                    <Label Text="{loc:LocalizedText Auth_PasswordRecovery_NewPassword}" Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                    <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="NewPasswordEntry"
                            AutomationId="NewPasswordEntry"
                            Placeholder="{loc:LocalizedText Auth_PasswordMaskPlaceholder}"
                            IsPassword="True"
                            Text="{Binding NewPassword}"
                            ReturnType="Next"
                            Completed="OnNewPasswordCompleted"
                            SemanticProperties.Description="{loc:LocalizedText Auth_NewPassword}"
                            SemanticProperties.Hint="{loc:LocalizedText Auth_Register_UseAtLeastEightCharactersWith}" />
                    </Border>
                </Grid>
            
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                    <Label Text="{loc:LocalizedText Auth_PasswordRecovery_ConfirmNewPassword}" Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                    <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="ConfirmPasswordEntry"
                            AutomationId="ConfirmPasswordEntry"
                            Placeholder="{loc:LocalizedText Auth_PasswordMaskPlaceholder}"
                            IsPassword="True"
                            Text="{Binding ConfirmPassword}"
                            ReturnType="Done"
                            ReturnCommand="{Binding ResetPasswordCommand}"
                            SemanticProperties.Description="{loc:LocalizedText Auth_ConfirmNewPassword}"
                            SemanticProperties.Hint="{loc:LocalizedText Auth_Register_ReEnterYourPasswordThenPress}" />
                    </Border>
                </Grid>
            
                
            </Grid>

            <!-- Identifier and password steps report status here; the code step keeps its own
                 inline status beside the code entry. -->
            <VerticalStackLayout Spacing="{StaticResource PresentationFormSpacing}"
                                 IsVisible="{Binding IsStep2, Converter={StaticResource InvertedBoolConverter}}">
                <Label
                    Text="{Binding InfoMessage, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource AccentLabel}"
                    LineBreakMode="WordWrap"
                    IsVisible="{Binding InfoMessage, Converter={StaticResource StringToBoolConverter}}"
                    SemanticProperties.Description="{Binding InfoMessage, Converter={StaticResource LocalizedStringConverter}}" />
                <Label
                    Text="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource ErrorLabel}"
                    LineBreakMode="WordWrap"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                    SemanticProperties.Description="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                    SemanticProperties.HeadingLevel="Level3" />
                <ActivityIndicator
                    Style="{StaticResource StateBusyInline}"
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_ProcessingRecoveryPleaseWait}" />
            </VerticalStackLayout>

            <!-- Step actions follow the step content in the same scroll flow. Back to Log In sits
                 directly beneath the step's primary action at the same full width. -->
            <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
                <Button Style="{StaticResource ButtonPrimary}"
                    Text="{loc:LocalizedText Auth_PasswordRecovery_SendRecoveryCode}"
                    Command="{Binding StartRecoveryCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    LineBreakMode="WordWrap"
                    SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_SendPasswordRecoveryCode}" IsVisible="{Binding IsStep1}" />
                <Button Style="{StaticResource ButtonPrimary}"
                    Text="{loc:LocalizedText Auth_VerifyCode}"
                    Command="{Binding VerifyCodeCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    LineBreakMode="WordWrap"
                    SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_VerifyRecoveryCode}" IsVisible="{Binding IsStep2}" />
                <Button Style="{StaticResource ButtonPrimary}"
                    Text="{loc:LocalizedText Auth_PasswordRecovery_UpdatePassword}"
                    Command="{Binding ResetPasswordCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    LineBreakMode="WordWrap"
                    SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_UpdatePasswordSecurely}" IsVisible="{Binding IsStep3}" />
                <Button
                    Style="{StaticResource ButtonSecondary}"
                    Text="{loc:LocalizedText Auth_PasswordRecovery_BackToLogIn}"
                    Command="{Binding GoBackCommand}"
                    IsVisible="{Binding IsStep2, Converter={StaticResource InvertedBoolConverter}}"
                    LineBreakMode="WordWrap"
                    SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_ReturnToLoginScreen}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</Grid>
</ContentPage>
