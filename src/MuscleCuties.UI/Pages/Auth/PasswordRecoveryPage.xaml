<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Auth.PasswordRecoveryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Auth"
    x:DataType="vm:PasswordRecoveryViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid
            Padding="{StaticResource UiInsets24_36_24_32}"
            HorizontalOptions="Fill"
            MaximumWidthRequest="{StaticResource UiDimension520}"
            RowSpacing="{StaticResource UiSpacing0}"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

            <sharedControls:ThemeAwareBrandLogoImage
                Grid.Row="0"
                WidthRequest="{StaticResource UiDimension132}"
                HeightRequest="{StaticResource UiDimension72}"
                HorizontalOptions="Center"
                Aspect="AspectFit"
                SemanticProperties.Description="{loc:LocalizedText Common_MuscleCutiesLogo}" />

            <Label
                Grid.Row="1"
                Text="{loc:LocalizedText Auth_PasswordRecovery_ResetYourPassword}"
                Style="{StaticResource Headline}"
                Margin="{StaticResource UiInsets0_20_0_8}"
                SemanticProperties.HeadingLevel="Level1" />

            <!-- Step 1: Identifier Entry (Flattened Grid) -->
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing18}" IsVisible="{Binding IsStep1}">
                <Label
                    Grid.Row="0"
                    Text="{loc:LocalizedText Auth_PasswordRecovery_EnterYourRegisteredEmailAddressOr}"
                    Style="{StaticResource MutedLabel}"
                    Margin="{StaticResource UiInsets0_0_0_12}" />

                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing6}">
                    <Label Text="{loc:LocalizedText Auth_EmailOrUsername}" Style="{StaticResource FormFieldLabel}" />
                    <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="RecoveryIdentifierEntry"
                            AutomationId="RecoveryIdentifierEntry"
                            Placeholder="{loc:LocalizedText Auth_EmailOrUsernamePlaceholder}"
                            Text="{Binding EmailOrUsername}"
                            Keyboard="Email"
                            ReturnType="Send"
                            ReturnCommand="{Binding StartRecoveryCommand}"
                            SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_EmailOrUsernameForPasswordRecovery}"
                            SemanticProperties.Hint="{loc:LocalizedText Auth_PasswordRecovery_EnterYourEmailOrUsernameAnd}" />
                    </Border>
                </Grid>

                <Button Style="{StaticResource ButtonPrimary}"
                    Grid.Row="2"
                    Text="{loc:LocalizedText Auth_PasswordRecovery_SendRecoveryCode}"
                    Command="{Binding StartRecoveryCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_SendPasswordRecoveryCode}" />
            </Grid>

            <!-- Step 2 follows the account-confirmation layout. -->
            <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing0}" IsVisible="{Binding IsStep2}">
                <Label
                    Grid.Row="0"
                    Text="{loc:LocalizedText Auth_PasswordRecovery_EnterTheSixDigitRecoveryCode}"
                    Style="{StaticResource MutedLabel}"
                    Margin="{StaticResource UiInsets0_0_0_4}" />
                <Label
                    Grid.Row="1"
                    Text="{Binding MaskedEmail}"
                    Style="{StaticResource AccentLabel}"
                    FontAttributes="{StaticResource UiFontAttributesBold}"
                    Margin="{StaticResource UiInsets0_0_0_24}" />

                <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing18}">
                    <Grid Grid.Row="0" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing6}">
                        <Label Text="{loc:LocalizedText Auth_PasswordRecovery_SixDigitRecoveryCodeLabel}" Style="{StaticResource FormFieldLabel}" />
                        <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                            <Entry
                                x:Name="RecoveryOtpEntry"
                                AutomationId="RecoveryOtpEntry"
                                Placeholder="123456"
                                Text="{Binding OtpCode}"
                                Keyboard="Numeric"
                                MaxLength="{StaticResource AuthCodeLength}"
                                ReturnType="Done"
                                ReturnCommand="{Binding VerifyCodeCommand}"
                                SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_SixDigitRecoveryCodeDescription}" />
                        </Border>
                    </Grid>

                    <Label
                        Grid.Row="1"
                        Text="{Binding InfoMessage, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource AccentLabel}"
                        IsVisible="{Binding InfoMessage, Converter={StaticResource StringToBoolConverter}}"
                        SemanticProperties.Description="{Binding InfoMessage, Converter={StaticResource LocalizedStringConverter}}" />

                    <Label
                        Grid.Row="2"
                        Text="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ErrorLabel}"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                        SemanticProperties.Description="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                        SemanticProperties.HeadingLevel="Level3" />

                    <Button Style="{StaticResource ButtonPrimary}"
                        Grid.Row="3"
                        Text="{loc:LocalizedText Auth_VerifyCode}"
                        Command="{Binding VerifyCodeCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_VerifyRecoveryCode}" />

                    <ActivityIndicator
                        Grid.Row="4"
                        HorizontalOptions="Center"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_ProcessingRecoveryPleaseWait}" />

                    <Grid
                        Grid.Row="5"
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="{StaticResource UiSpaceCompact}"
                        Margin="{StaticResource UiInsets0_12_0_0}">
                        <Button
                            Text="{loc:LocalizedText Auth_PasswordRecovery_ResendCode}"
                            Command="{Binding ResendCodeCommand}"
                            IsEnabled="{Binding CanResend}"
                            Style="{StaticResource ButtonSecondary}"
                            SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_ResendRecoveryCode}" />
                        <Button
                            Grid.Column="1"
                            Text="{loc:LocalizedText Auth_PasswordRecovery_ChangeAccount}"
                            Command="{Binding GoBackCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_GoBackToChangeAccount}" />
                        <Label
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="{StaticResource UiInsets0_8_0_0}"
                            Text="{Binding ResendButtonText, Converter={StaticResource LocalizedStringConverter}}"
                            IsVisible="{Binding CanResend, Converter={StaticResource InvertedBoolConverter}}"
                            Style="{StaticResource MutedLabel}"
                            SemanticProperties.Description="{Binding ResendButtonText, Converter={StaticResource LocalizedStringConverter}}" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- Step 3: New Password Input (Flattened Grid) -->
            <Grid Grid.Row="4" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing18}" IsVisible="{Binding IsStep3}">
                <Label
                    Grid.Row="0"
                    Text="{loc:LocalizedText Auth_PasswordRecovery_ChooseAStrongNewPasswordWith}"
                    Style="{StaticResource MutedLabel}"
                    Margin="{StaticResource UiInsets0_0_0_12}" />

                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing6}">
                    <Label Text="{loc:LocalizedText Auth_PasswordRecovery_NewPassword}" Style="{StaticResource FormFieldLabel}" />
                    <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="NewPasswordEntry"
                            AutomationId="NewPasswordEntry"
                            Placeholder="••••••••"
                            IsPassword="True"
                            Text="{Binding NewPassword}"
                            ReturnType="Next"
                            SemanticProperties.Description="{loc:LocalizedText Auth_NewPassword}" />
                    </Border>
                </Grid>

                <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing6}">
                    <Label Text="{loc:LocalizedText Auth_PasswordRecovery_ConfirmNewPassword}" Style="{StaticResource FormFieldLabel}" />
                    <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="ConfirmPasswordEntry"
                            AutomationId="ConfirmPasswordEntry"
                            Placeholder="••••••••"
                            IsPassword="True"
                            Text="{Binding ConfirmPassword}"
                            ReturnType="Done"
                            ReturnCommand="{Binding ResetPasswordCommand}"
                            SemanticProperties.Description="{loc:LocalizedText Auth_ConfirmNewPassword}" />
                    </Border>
                </Grid>

                <Button Style="{StaticResource ButtonPrimary}"
                    Grid.Row="3"
                    Text="{loc:LocalizedText Auth_PasswordRecovery_UpdatePassword}"
                    Command="{Binding ResetPasswordCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_UpdatePasswordSecurely}" />
            </Grid>

            <Grid Grid.Row="5" RowDefinitions="Auto,Auto,Auto,Auto" IsVisible="{Binding IsStep2, Converter={StaticResource InvertedBoolConverter}}">
                <Label
                    Grid.Row="0"
                    Text="{Binding InfoMessage, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource AccentLabel}"
                    Margin="{StaticResource UiInsets0_16_0_0}"
                    IsVisible="{Binding InfoMessage, Converter={StaticResource StringToBoolConverter}}"
                    SemanticProperties.Description="{Binding InfoMessage, Converter={StaticResource LocalizedStringConverter}}" />

                <Label
                    Grid.Row="1"
                    Text="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource ErrorLabel}"
                    Margin="{StaticResource UiInsets0_16_0_0}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                    SemanticProperties.Description="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                    SemanticProperties.HeadingLevel="Level3" />

                <ActivityIndicator
                    Grid.Row="2"
                    Margin="{StaticResource UiInsets0_16_0_0}"
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_ProcessingRecoveryPleaseWait}" />

                <Button
                    Grid.Row="3"
                    Style="{StaticResource ButtonSecondary}"
                    Text="{loc:LocalizedText Auth_PasswordRecovery_BackToLogIn}"
                    Command="{Binding GoBackCommand}"
                    Margin="{StaticResource UiInsets0_24_0_0}"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{loc:LocalizedText Auth_PasswordRecovery_ReturnToLoginScreen}" />
            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>
