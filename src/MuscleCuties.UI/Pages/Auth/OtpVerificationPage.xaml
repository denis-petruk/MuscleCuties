<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Auth.OtpVerificationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Auth"
    x:DataType="vm:OtpVerificationViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*,Auto">
    <VerticalStackLayout Grid.Row="0" Padding="{DynamicResource PresentationPageHeaderPadding}" Spacing="{StaticResource UiSpaceTight}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
        <Label
           
            Text="{loc:LocalizedText Auth_Otp_VerifyYourEmail}"
            Style="{StaticResource PageTitle}"
            LineBreakMode="WordWrap"
           
            SemanticProperties.HeadingLevel="Level1" />
        <Label
           
            Text="{loc:LocalizedText Auth_Otp_WeSentASixDigitConfirmation}"
            Style="{StaticResource MutedLabel}"
            LineBreakMode="WordWrap"
            />
    </VerticalStackLayout>
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="{DynamicResource PresentationAuthPagePadding}" Spacing="{StaticResource PresentationFormSpacing}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
            <Label
               
                Text="{Binding Email}"
                Style="{StaticResource AccentLabel}"
                LineBreakMode="WordWrap"
                Margin="{StaticResource UiInsets0_0_0_24}" />

            <VerticalStackLayout Spacing="{StaticResource PresentationFormSpacing}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource PresentationFieldSpacing}">
                    <Label Text="{loc:LocalizedText Auth_Otp_SixDigitVerificationCodeLabel}" Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />
                    <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="OtpEntry"
                            AutomationId="OtpEntry"
                            Placeholder="{loc:LocalizedText Common_Placeholder_SixDigitCode}"
                            Text="{Binding OtpCode}"
                            Keyboard="Numeric"
                            MaxLength="{StaticResource AuthCodeLength}"
                            ReturnType="Done"
                            ReturnCommand="{Binding VerifyCommand}"
                            SemanticProperties.Description="{loc:LocalizedText Auth_Otp_SixDigitVerificationCodeDescription}"
                            SemanticProperties.Hint="{loc:LocalizedText Auth_Otp_EnterTheSixDigitVerificationCode}" />
                    </Border>
                </Grid>
                <Label
                   
                    Text="{Binding InfoMessage, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource AccentLabel}"
                    LineBreakMode="WordWrap"
                    IsVisible="{Binding InfoMessage, Converter={StaticResource StringToBoolConverter}}"
                    SemanticProperties.Description="{Binding InfoMessage, Converter={StaticResource LocalizedStringConverter}}" />
                <Label
                   
                    Text="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource ErrorLabel}"
                    LineBreakMode="WordWrap"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                    SemanticProperties.Description="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                    SemanticProperties.HeadingLevel="Level3" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    <VerticalStackLayout Grid.Row="2" Padding="{DynamicResource PresentationActionFooterPadding}" Spacing="{StaticResource UiSpaceTight}" MaximumWidthRequest="{StaticResource PageContentMaxWidth}" HorizontalOptions="Fill">
        <Button Style="{StaticResource ButtonPrimary}"
           
            Text="{loc:LocalizedText Auth_VerifyCode}"
            AutomationId="OtpVerifyButton" Command="{Binding VerifyCommand}"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
            SemanticProperties.Description="{loc:LocalizedText Auth_Otp_VerifyConfirmationCode}" />
        <ActivityIndicator
                        Style="{StaticResource StateBusyInline}"
           
            HorizontalOptions="Center"
            IsRunning="{Binding IsVerifying}"
            IsVisible="{Binding IsVerifying}"
            SemanticProperties.Description="{loc:LocalizedText Auth_Otp_VerifyingCodePleaseWait}" />
        <Grid
           
            ColumnDefinitions="*,*"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="{StaticResource UiSpaceCompact}"
            Margin="{StaticResource UiInsets0_12_0_0}">
            <Button
                Text="{loc:LocalizedText Auth_Otp_ResendCode}"
                AutomationId="OtpResendButton" Command="{Binding ResendCodeCommand}"
                IsEnabled="{Binding CanResend}"
                Style="{StaticResource ButtonSecondary}"
                SemanticProperties.Description="{loc:LocalizedText Auth_Otp_ResendVerificationCode}" />
            <Button
                Grid.Column="1"
                Text="{loc:LocalizedText Auth_Otp_ChangeEmail}"
                Command="{Binding GoBackCommand}"
                Style="{StaticResource ButtonSecondary}"
                SemanticProperties.Description="{loc:LocalizedText Auth_Otp_GoBackToChangeEmailAddress}" />
            <Label
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="{StaticResource UiInsets0_16_0_0}"
                Text="{Binding ResendButtonText, Converter={StaticResource LocalizedStringConverter}}"
                IsVisible="{Binding CanResend, Converter={StaticResource InvertedBoolConverter}}"
                Style="{StaticResource MutedLabel}"
                LineBreakMode="WordWrap"
                SemanticProperties.Description="{Binding ResendButtonText, Converter={StaticResource LocalizedStringConverter}}" />
        </Grid>
    </VerticalStackLayout>
</Grid>
</ContentPage>
