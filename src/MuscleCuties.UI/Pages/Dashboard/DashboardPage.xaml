<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Dashboard.DashboardPage"
    x:Name="DashboardRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:dashboardControls="clr-namespace:MuscleCuties.UI.Controls.Dashboard"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:injuryControls="clr-namespace:MuscleCuties.UI.Controls.Injury"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Dashboard"
    x:DataType="vm:DashboardViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">


    <Grid RowDefinitions="Auto,*">
        <Grid Padding="{DynamicResource PresentationPageHeaderPadding}" MaximumWidthRequest="{StaticResource UiDimension640}"
              HorizontalOptions="Fill">
            <sharedControls:PageHeader
                Title="{Binding Greetings, Converter={StaticResource LocalizedStringConverter}}"
                Subtitle="{Binding DashboardPhaseHeaderText, Converter={StaticResource LocalizedStringConverter}}"
                ShowBack="False">
                <sharedControls:PageHeader.ActionContent>
                    <Border Style="{StaticResource HeaderIconButton}"
                            HorizontalOptions="End"
                            SemanticProperties.Description="{loc:LocalizedText Dashboard_Page_OpenInjuryLogA11y}">
                        <Grid>
                            <mi:MauiIcon Icon="{mi:Fluent HeartPulse32}" IconSize="{StaticResource UiDimension22}"
                                         IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                         WidthRequest="{StaticResource UiDimension22}" HeightRequest="{StaticResource UiDimension22}"
                                         HorizontalOptions="Center" VerticalOptions="Center"
                                         InputTransparent="True"
                                         AutomationProperties.IsInAccessibleTree="False" />
                            <BoxView WidthRequest="{StaticResource UiDimension8}" HeightRequest="{StaticResource UiDimension8}" CornerRadius="{StaticResource UiCornerRadius4}" Margin="{StaticResource UiInsets0_6_6_0}"
                                     Color="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                                     HorizontalOptions="End" VerticalOptions="Start"
                                     InputTransparent="True"
                                     AutomationProperties.IsInAccessibleTree="False"
                                     IsVisible="{Binding HasActiveInjuries}" />
                            <sharedControls:CardTapTarget Command="{Binding OpenInjuryModalCommand}"
                                                          SemanticProperties.Description="{Binding InjuryButtonAccessibilityText}" />
                        </Grid>
                    </Border>
                </sharedControls:PageHeader.ActionContent>
            </sharedControls:PageHeader>
        </Grid>

        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{StaticResource Primary}">
            <ScrollView>
                <Grid
                    Padding="{DynamicResource PresentationPageContentPadding}"
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="{StaticResource UiDimension640}"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="{StaticResource UiSpaceContent}">

                    <!-- The next useful action leads Today. -->
                    <toolkit:LazyView
                        x:Name="WorkoutCardLazy"
                        Grid.Row="0"
                        x:TypeArguments="dashboardControls:DashboardWorkoutCard" />

                    <toolkit:LazyView
                        x:Name="ReadinessLazy"
                        Grid.Row="1"
                        x:TypeArguments="dashboardControls:ReadinessRecoveryCard" />

                    <toolkit:LazyView
                        x:Name="NutritionLazy"
                        Grid.Row="2"
                        x:TypeArguments="dashboardControls:DashboardNutritionCard" />

                    <toolkit:LazyView
                        x:Name="PhaseCardLazy"
                        Grid.Row="3"
                        x:TypeArguments="dashboardControls:DashboardPhaseCard" />

                    <toolkit:LazyView
                        x:Name="TargetsLazy"
                        Grid.Row="4"
                        x:TypeArguments="dashboardControls:DashboardTargetsCard" />

            <Border Grid.Row="5"
                    Style="{StaticResource CardSecondary}"
                    HorizontalOptions="Fill">
                <sharedControls:AdaptiveRow Columns="3" ColumnSpacing="{StaticResource UiSpaceTight}" RowSpacing="{StaticResource UiSpaceTight}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource UiSpacing6}" HorizontalOptions="Center">
                            <Image Source="{AppThemeBinding Light=icon_muscle.png, Dark=icon_muscle_dark.png}"
                                   Aspect="AspectFit"
                                   WidthRequest="{StaticResource UiDimension20}"
                                   HeightRequest="{StaticResource UiDimension20}"
                                   VerticalOptions="Center"
                                   AutomationProperties.IsInAccessibleTree="False" />
                            <Label Grid.Column="1"
                                   Text="{Binding WorkoutStreakDays, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource MetricValue}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{loc:LocalizedText Dashboard_Page_WorkoutStreak}"
                               Style="{StaticResource CaptionCentered}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource UiSpacing6}" HorizontalOptions="Center">
                            <Image Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                                   Aspect="AspectFit"
                                   WidthRequest="{StaticResource UiDimension20}"
                                   HeightRequest="{StaticResource UiDimension20}"
                                   VerticalOptions="Center"
                                   AutomationProperties.IsInAccessibleTree="False" />
                            <Label Grid.Column="1"
                                   Text="{Binding NutritionStreakDays, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource MetricValue}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{loc:LocalizedText Dashboard_Page_FoodLogStreak}"
                               Style="{StaticResource CaptionCentered}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource UiSpacing6}" HorizontalOptions="Center">
                            <Image Source="{AppThemeBinding Light=tab_cycle.png, Dark=tab_cycle_dark.png}"
                                   Aspect="AspectFit"
                                   WidthRequest="{StaticResource UiDimension20}"
                                   HeightRequest="{StaticResource UiDimension20}"
                                   VerticalOptions="Center"
                                   AutomationProperties.IsInAccessibleTree="False" />
                            <Label Grid.Column="1"
                                   Text="{Binding CycleCount, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource MetricValue}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{loc:LocalizedText Dashboard_Page_CyclesLogged}"
                               Style="{StaticResource CaptionCentered}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </sharedControls:AdaptiveRow>
            </Border>

                    <toolkit:LazyView
                        x:Name="TrendCardLazy"
                        Grid.Row="6"
                        x:TypeArguments="dashboardControls:DashboardTrendCard" />

                    <!-- Progress Photo Check-In -->
                    <Border Grid.Row="7"
                            Style="{StaticResource CardPrimary}">
                        <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                <Border
                                    sharedControls:AccessibilityDecoration.HideAtAccessibilitySize="True"
                                    AutomationProperties.IsInAccessibleTree="False"
                                    Style="{StaticResource DecorativeIconSurface}" VerticalOptions="Center">
                                    <Path Data="M3 7h4l2-3h6l2 3h4v13H3z M12 10a4 4 0 1 0 0 8a4 4 0 0 0 0-8z"
                                          Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                          StrokeThickness="{StaticResource UiStrokeWidth1_7}" StrokeLineCap="Round" StrokeLineJoin="Round"
                                          Fill="{StaticResource Transparent}" Aspect="Uniform" WidthRequest="{StaticResource UiDimension21}" HeightRequest="{StaticResource UiDimension21}"
                                          HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource UiSpacing2}" VerticalOptions="Center">
                                    <Label Text="{loc:LocalizedText Dashboard_Page_ProgressPhotoTitle}" Style="{StaticResource CardTitle}" LineBreakMode="WordWrap" />
                                    <Label
                                        Text="{Binding PhotoCheckInText, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource CaptionSmall}"
                                        LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                            <Button Text="{Binding PhotoButtonText, Converter={StaticResource LocalizedStringConverter}}"
                                    Command="{Binding OpenPhotoVaultCommand}"
                                    Style="{StaticResource ButtonSecondary}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_Page_OpenPhotoVaultA11y}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </ScrollView>
        </RefreshView>

        <sharedControls:PageLoadingOverlay
            Grid.RowSpan="2"
            MessageText="{Binding LoadErrorMessage}"
            RetryCommand="{Binding RetryLoadCommand}" />
        <toolkit:LazyView
            x:Name="InjuryModalLazy"
            Grid.RowSpan="2"
            x:TypeArguments="injuryControls:InjuryLogModal"
            InputTransparent="{Binding IsInjuryModalVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView
            x:Name="CheckInModalLazy"
            Grid.RowSpan="2"
            x:TypeArguments="dashboardControls:DailyCheckInModal"
            InputTransparent="{Binding IsCheckInModalVisible, Converter={StaticResource InvertedBoolConverter}}" />
    </Grid>
</ContentPage>
