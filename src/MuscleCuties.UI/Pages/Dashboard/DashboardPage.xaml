<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Dashboard.DashboardPage"
    x:Name="DashboardRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:dashboardControls="clr-namespace:MuscleCuties.UI.Controls.Dashboard"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:injuryControls="clr-namespace:MuscleCuties.UI.Controls.Injury"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Dashboard"
    x:DataType="vm:DashboardViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="{Binding IsInjuryModalVisible, Converter={StaticResource InvertedBoolConverter}}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">


    <Grid RowDefinitions="Auto,*">
        <Grid Padding="{StaticResource PresentationPageHeaderPadding}" MaximumWidthRequest="{StaticResource UiDimension640}"
              RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceCompact}" HorizontalOptions="Fill">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}">
                <VerticalStackLayout Spacing="{StaticResource UiSpacing2}">
                    <Label Text="{Binding Greetings, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource SubHeadline}"
                           LineBreakMode="WordWrap" />
                    <Label
                        Text="{Binding DashboardPhaseHeaderText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" Style="{StaticResource HeaderIconButton}"
                        SemanticProperties.Description="{loc:LocalizedText Dashboard_Page_OpenInjuryLogA11y}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenInjuryModalCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Path Data="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9 M13.7 21a2 2 0 0 1-3.4 0"
                              Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                              StrokeThickness="{StaticResource UiStrokeWidth1_75}" StrokeLineCap="Round" StrokeLineJoin="Round"
                              Aspect="Uniform" WidthRequest="{StaticResource UiDimension18}" HeightRequest="{StaticResource UiDimension18}"
                              HorizontalOptions="Center" VerticalOptions="Center" />
                        <BoxView WidthRequest="{StaticResource UiDimension8}" HeightRequest="{StaticResource UiDimension8}" CornerRadius="{StaticResource UiCornerRadius4}" Margin="{StaticResource UiInsets0_6_6_0}"
                                 Color="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 IsVisible="{Binding HasActiveInjuries}" />
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="1"
                    Style="{StaticResource CardPrimary}"
                    HorizontalOptions="Fill"
                    SemanticProperties.Description="{loc:LocalizedText Dashboard_Page_StreaksA11y}">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="{StaticResource UiSpaceTight}"
                      RowSpacing="{StaticResource UiSpaceTight}">
                    <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,Auto"
                          ColumnSpacing="{StaticResource UiSpacing6}"
                          HorizontalOptions="Center">
                        <Image Source="{AppThemeBinding Light=icon_muscle.png, Dark=icon_muscle_dark.png}"
                               Aspect="AspectFit"
                               WidthRequest="{StaticResource UiDimension20}"
                               HeightRequest="{StaticResource UiDimension20}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding WorkoutStreakDays, Converter={StaticResource LocalizedStringConverter}}"
                               FontSize="{StaticResource UiFontSize22}" FontAttributes="{StaticResource UiFontAttributesBold}"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                    <Label Grid.Row="1" Grid.Column="0"
                           Text="{loc:LocalizedText Dashboard_Page_WorkoutStreak}"
                           Style="{StaticResource CaptionCentered}"
                           VerticalOptions="Start" LineBreakMode="WordWrap" />

                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,Auto"
                          ColumnSpacing="{StaticResource UiSpacing6}"
                          HorizontalOptions="Center">
                        <Image Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                               Aspect="AspectFit"
                               WidthRequest="{StaticResource UiDimension20}"
                               HeightRequest="{StaticResource UiDimension20}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding NutritionStreakDays, Converter={StaticResource LocalizedStringConverter}}"
                               FontSize="{StaticResource UiFontSize22}" FontAttributes="{StaticResource UiFontAttributesBold}"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{loc:LocalizedText Dashboard_Page_FoodLogStreak}"
                           Style="{StaticResource CaptionCentered}"
                           VerticalOptions="Start" LineBreakMode="WordWrap" />

                    <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="Auto,Auto"
                          ColumnSpacing="{StaticResource UiSpacing6}"
                          HorizontalOptions="Center">
                        <Image Source="{AppThemeBinding Light=tab_cycle.png, Dark=tab_cycle_dark.png}"
                               Aspect="AspectFit"
                               WidthRequest="{StaticResource UiDimension20}"
                               HeightRequest="{StaticResource UiDimension20}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding CycleCount, Converter={StaticResource LocalizedStringConverter}}"
                               FontSize="{StaticResource UiFontSize22}" FontAttributes="{StaticResource UiFontAttributesBold}"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                    <Label Grid.Row="1" Grid.Column="2"
                           Text="{loc:LocalizedText Dashboard_Page_CyclesLogged}"
                           Style="{StaticResource CaptionCentered}"
                           VerticalOptions="Start" LineBreakMode="WordWrap" />
                </Grid>
            </Border>
        </Grid>
        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{StaticResource Primary}">
            <ScrollView>
                <Grid
                    Padding="{StaticResource PresentationPageContentPadding}"
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="{StaticResource UiDimension640}"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="{StaticResource UiSpaceControl}">

                    <toolkit:LazyView
                        x:Name="TrendCardLazy"
                        Grid.Row="5"
                        x:TypeArguments="dashboardControls:DashboardTrendCard" />

                    <!-- Cycle context -->
                    <toolkit:LazyView
                        x:Name="PhaseCardLazy"
                        Grid.Row="0"
                        x:TypeArguments="dashboardControls:DashboardPhaseCard" />

                    <!-- Today's primary action -->
                    <toolkit:LazyView
                        x:Name="WorkoutCardLazy"
                        Grid.Row="1"
                        x:TypeArguments="dashboardControls:DashboardWorkoutCard" />

                    <!-- Readiness and recovery -->
                    <toolkit:LazyView
                        x:Name="ReadinessLazy"
                        Grid.Row="2"
                        x:TypeArguments="dashboardControls:ReadinessRecoveryCard" />

                    <!-- Food progress -->
                    <toolkit:LazyView
                        x:Name="NutritionLazy"
                        Grid.Row="3"
                        x:TypeArguments="dashboardControls:DashboardNutritionCard" />

                    <!-- Daily targets -->
                    <toolkit:LazyView
                        x:Name="TargetsLazy"
                        Grid.Row="4"
                        x:TypeArguments="dashboardControls:DashboardTargetsCard" />

                    <!-- Progress Photo Check-In -->
                    <Border Grid.Row="6"
                            Style="{StaticResource CardPrimary}"
                            SemanticProperties.Description="{loc:LocalizedText Dashboard_Page_PhotoCheckInA11y}">
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                            <Border
                                Style="{StaticResource DecorativeIconSurface}" VerticalOptions="Center">
                                <Path Data="M3 7h4l2-3h6l2 3h4v13H3z M12 10a4 4 0 1 0 0 8a4 4 0 0 0 0-8z"
                                      Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                      StrokeThickness="{StaticResource UiStrokeWidth1_7}" StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Fill="{StaticResource Transparent}" Aspect="Uniform" WidthRequest="{StaticResource UiDimension21}" HeightRequest="{StaticResource UiDimension21}"
                                      HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource UiSpacing2}" VerticalOptions="Center">
                                <Label Text="{loc:LocalizedText Dashboard_Page_ProgressPhotoTitle}" Style="{StaticResource CardTitle}" LineBreakMode="WordWrap" />
                                <Label
                                    Text="{Binding PhotoCheckInText, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource CaptionSmall}"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="{Binding PhotoButtonText, Converter={StaticResource LocalizedStringConverter}}"
                                    Command="{Binding OpenPhotoVaultCommand}"
                                    Style="{StaticResource ButtonSecondary}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_Page_OpenPhotoVaultA11y}" />
                        </Grid>
                    </Border>
                </Grid>
            </ScrollView>
        </RefreshView>

        <sharedControls:PageLoadingOverlay Grid.RowSpan="2" />
        <toolkit:LazyView
            x:Name="InjuryModalLazy"
            Grid.RowSpan="2"
            x:TypeArguments="injuryControls:InjuryLogModal"
            InputTransparent="{Binding IsInjuryModalVisible, Converter={StaticResource InvertedBoolConverter}}" />
    </Grid>
</ContentPage>
