<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.UI.Pages.Dashboard.DailyCheckInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Dashboard"
    x:DataType="vm:DailyCheckInViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">

    <ContentPage.Resources>
        <x:Double x:Key="CheckInSectionLabelSize">11</x:Double>
        <x:Double x:Key="CheckInTitleSize">22</x:Double>
        <x:Double x:Key="CheckInSectionSpacing">26</x:Double>
        <x:Double x:Key="CheckInActionHeight">52</x:Double>
        <Thickness x:Key="CheckInBodyPadding">20,28,20,24</Thickness>
        <Style x:Key="CheckInSection" TargetType="Border">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="CheckInSectionTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="{StaticResource CheckInSectionLabelSize}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
        </Style>
        <Style x:Key="CheckInChoice" TargetType="Button">
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
            <Setter Property="BorderColor"
                    Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*, Auto">

        <!-- Check-in -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="{StaticResource CheckInBodyPadding}"
                Spacing="{StaticResource CheckInSectionSpacing}"
                HorizontalOptions="Fill"
                MaximumWidthRequest="640">

                <!-- Header -->
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                    <Label
                        Grid.Row="0"
                        Text="{loc:LocalizedText Dashboard_CheckIn_PageTitle}"
                        Style="{StaticResource SubHeadline}"
                        FontSize="{StaticResource CheckInTitleSize}" />
                    <Label
                        Grid.Row="1"
                        Text="{loc:LocalizedText Dashboard_CheckIn_Subtitle}"
                        Style="{StaticResource MutedLabel}" />
                    <BoxView
                        Grid.Row="2"
                        HeightRequest="1"
                        Margin="0,16,0,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}" />
                    <Label
                        Grid.Row="3"
                        Text="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ErrorLabel}"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
                </Grid>

                <!-- Sleep -->
                <Border Style="{StaticResource CheckInSection}">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <Label
                                Grid.Column="0"
                                Text="{loc:LocalizedText Dashboard_CheckIn_SleepSectionTitle}"
                                Style="{StaticResource CheckInSectionTitle}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding SleepDisplay, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource AccentLabel}"
                                FontSize="18"
                                VerticalOptions="Center" />
                        </Grid>
                        <Slider
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="14"
                            Value="{Binding SleepHours}"
                            MinimumTrackColor="{StaticResource Primary}"
                            MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                            ThumbColor="{StaticResource Primary}"
                            SemanticProperties.Description="{Binding SleepDisplay, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Dashboard_CheckIn_SleepA11yFormat}"
                            SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_SleepSliderHint}" />
                        <Grid Grid.Row="2" ColumnDefinitions="*, *">
                            <Label
                                Grid.Column="0"
                                Text="{loc:LocalizedText Dashboard_CheckIn_SleepMinLabel}"
                                Style="{StaticResource CaptionLabel}"
                                HorizontalOptions="Start" />
                            <Label
                                Grid.Column="1"
                                Text="{loc:LocalizedText Dashboard_CheckIn_SleepMaxLabel}"
                                Style="{StaticResource CaptionLabel}"
                                HorizontalOptions="End" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Energy -->
                <Border Style="{StaticResource CheckInSection}">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{loc:LocalizedText Dashboard_CheckIn_EnergySectionTitle}" Style="{StaticResource CheckInSectionTitle}" />
                            <Label Grid.Column="1"
                                   Text="{Binding EnergyDisplay, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource AccentLabel}" FontSize="18" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                            <Button x:Name="EnergyChip1" Style="{StaticResource CheckInChoice}" Grid.Column="0"
                                    Text="1"
                                    CommandParameter="1" Clicked="OnEnergyClicked"
                                    MinimumHeightRequest="48" Padding="0" FontSize="16" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Energy1A11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_Energy1Hint}" />
                            <Button x:Name="EnergyChip2" Style="{StaticResource CheckInChoice}" Grid.Column="1"
                                    Text="2"
                                    CommandParameter="2" Clicked="OnEnergyClicked"
                                    MinimumHeightRequest="48" Padding="0" FontSize="16" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Energy2A11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_Energy2Hint}" />
                            <Button x:Name="EnergyChip3" Style="{StaticResource CheckInChoice}" Grid.Column="2"
                                    Text="3"
                                    CommandParameter="3" Clicked="OnEnergyClicked"
                                    MinimumHeightRequest="48" Padding="0" FontSize="16" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Energy3A11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_Energy3Hint}" />
                            <Button x:Name="EnergyChip4" Style="{StaticResource CheckInChoice}" Grid.Column="3"
                                    Text="4"
                                    CommandParameter="4" Clicked="OnEnergyClicked"
                                    MinimumHeightRequest="48" Padding="0" FontSize="16" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Energy4A11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_Energy4Hint}" />
                            <Button x:Name="EnergyChip5" Style="{StaticResource CheckInChoice}" Grid.Column="4"
                                    Text="5"
                                    CommandParameter="5" Clicked="OnEnergyClicked"
                                    MinimumHeightRequest="48" Padding="0" FontSize="16" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Energy5A11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_Energy5Hint}" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="*,*">
                            <Label Text="{loc:LocalizedText Dashboard_CheckIn_EnergyVeryLowLabel}" Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1" Text="{loc:LocalizedText Dashboard_CheckIn_EnergyVeryHighLabel}"
                                   Style="{StaticResource CaptionLabel}"
                                   HorizontalTextAlignment="End" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Pain -->
                <Border Style="{StaticResource CheckInSection}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{loc:LocalizedText Dashboard_CheckIn_PainSectionTitle}" Style="{StaticResource CheckInSectionTitle}" />
                            <Label Grid.Column="1"
                                   Text="{Binding PainDisplay, Converter={StaticResource LocalizedStringConverter}}"
                                   Style="{StaticResource AccentLabel}" FontSize="18" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8"
                              RowSpacing="8">
                            <Button x:Name="PainChip0" Style="{StaticResource CheckInChoice}" Grid.Row="0"
                                    Grid.Column="0" Text="{loc:LocalizedText Dashboard_CheckIn_PainNone}"
                                    CommandParameter="0" Clicked="OnPainClicked"
                                    MinimumHeightRequest="48" Padding="4,0" FontSize="14" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_PainNoneA11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_PainNoneHint}" />
                            <Button x:Name="PainChip1" Style="{StaticResource CheckInChoice}" Grid.Row="0"
                                    Grid.Column="1" Text="{loc:LocalizedText Dashboard_CheckIn_PainMild}"
                                    CommandParameter="1" Clicked="OnPainClicked"
                                    MinimumHeightRequest="48" Padding="4,0" FontSize="14" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_PainMildA11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_PainMildHint}" />
                            <Button x:Name="PainChip2" Style="{StaticResource CheckInChoice}" Grid.Row="1"
                                    Grid.Column="0" Text="{loc:LocalizedText Dashboard_CheckIn_PainModerate}"
                                    CommandParameter="2" Clicked="OnPainClicked"
                                    MinimumHeightRequest="48" Padding="4,0" FontSize="14" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_PainModerateA11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_PainModerateHint}" />
                            <Button x:Name="PainChip3" Style="{StaticResource CheckInChoice}" Grid.Row="1"
                                    Grid.Column="1" Text="{loc:LocalizedText Dashboard_CheckIn_PainSevere}"
                                    CommandParameter="3" Clicked="OnPainClicked"
                                    MinimumHeightRequest="48" Padding="4,0" FontSize="14" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_PainSevereA11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_PainSevereHint}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Bloating -->
                <Border Style="{StaticResource CheckInSection}">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center"
                          MinimumHeightRequest="{StaticResource CheckInActionHeight}">
                        <Label
                            Grid.Column="0"
                            Text="{loc:LocalizedText Dashboard_CheckIn_BloatingSectionTitle}"
                            Style="{StaticResource CheckInSectionTitle}"
                            VerticalOptions="Center" />
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding HasBloating}"
                            OnColor="{StaticResource Primary}"
                            ThumbColor="{StaticResource White}"
                            VerticalOptions="Center"
                            SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_BloatingA11y}"
                            SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_BloatingHint}" />
                    </Grid>
                </Border>

                <!-- Body weight -->
                <Border Style="{StaticResource CheckInSection}">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <Label Text="{loc:LocalizedText Dashboard_CheckIn_BodyWeightSectionTitle}" Style="{StaticResource CheckInSectionTitle}" />
                            <Label Grid.Column="1" Text="{loc:LocalizedText Dashboard_CheckIn_PrivateBadge}"
                                   Style="{StaticResource CaptionLabel}"
                                   VerticalOptions="Center"
                                   SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_PrivateBadgeA11y}" />
                        </Grid>
                        <Label Grid.Row="1" Text="{loc:LocalizedText Dashboard_CheckIn_StorageNotice}"
                               Style="{StaticResource CaptionLabel}" />
                        <Border Grid.Row="2" Style="{StaticResource InputContainer}">
                            <Entry
                                x:Name="WeightEntry"
                                Placeholder="{loc:LocalizedText Dashboard_CheckIn_WeightPlaceholderKg}"
                                Text="{Binding BodyWeight}"
                                Keyboard="Numeric"
                                ReturnType="Done"
                                ReturnCommand="{Binding SubmitCommand}"
                                SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_WeightA11y}"
                                SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_WeightHint}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Result -->
                <Border
                    Style="{StaticResource CardPrimary}"
                    IsVisible="{Binding IsCompleted}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" HorizontalOptions="Center">
                        <Label
                            Grid.Row="0"
                            Text="{loc:LocalizedText Dashboard_CheckIn_SuccessMessage}"
                            Style="{StaticResource SectionTitle}"
                            HorizontalOptions="Center" />
                        <Label
                            Grid.Row="1"
                            Text="{Binding ReadinessScoreText, Converter={StaticResource LocalizedStringConverter}}"
                            IsVisible="{Binding HasApprovedScorePolicy}"
                            FontFamily="Inter"
                            FontSize="52"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Grid.Row="2"
                            Text="{Binding ReadinessTierText, Converter={StaticResource LocalizedStringConverter}}"
                            IsVisible="{Binding HasApprovedScorePolicy}"
                            Style="{StaticResource SectionTitle}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Grid.Row="3"
                            Text="{Binding SessionSummaryText, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource MutedLabel}"
                            IsVisible="{Binding HasSessionSummary}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Actions -->
        <Grid
            Grid.Row="1"
            RowDefinitions="Auto,Auto,Auto"
            Padding="20,12,20,36"
            IsVisible="{Binding IsCompleted, Converter={StaticResource InvertedBoolConverter}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">
            <BoxView HeightRequest="1" Margin="0,0,0,12"
                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}" />
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
                <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_SavingA11y}" />
                <Button Grid.Row="1" Text="{loc:LocalizedText Dashboard_CheckIn_SubmitButton}" Command="{Binding SubmitCommand}"
                        HeightRequest="{StaticResource CheckInActionHeight}"
                        SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_SubmitHint}" />
            </Grid>
            <Button
                Grid.Row="2"
                Text="{loc:LocalizedText Dashboard_CheckIn_SkipButton}"
                Style="{StaticResource ButtonLink}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                Command="{Binding SkipCommand}"
                SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_SkipHint}" />
        </Grid>

    </Grid>

</ContentPage>
