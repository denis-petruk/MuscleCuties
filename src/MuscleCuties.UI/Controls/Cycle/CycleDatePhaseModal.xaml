<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Cycle.CycleDatePhaseModal"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:cycleModels="clr-namespace:MuscleCuties.UI.Models.UI.Cycle"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel"
    IsOpen="{Binding IsDatePhaseModalVisible}">

    <Grid>
        <BoxView BackgroundColor="{StaticResource ModalScrim}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseDatePhaseModalCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border
            x:Name="SheetSurface"
            Style="{StaticResource AppBottomSheetSurface}">

            <Grid RowDefinitions="Auto, *, Auto">
                <!-- Header: flattened from 3-deep Grid nesting into single Grid -->
                <Grid
                    Grid.Row="0"
                    RowDefinitions="Auto, Auto, Auto"
                    ColumnDefinitions="*, Auto"
                    ColumnSpacing="12"
                    RowSpacing="6"
                    Padding="20,18,20,12">

                    <Label
                        Text="{Binding SelectedCalendarDateText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource SubHeadline}"
                        FontSize="24" />

                    <Label
                        Grid.Row="1"
                        Text="{Binding SelectedCalendarPhaseText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource MutedLabel}" />

                    <Border
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        VerticalOptions="Start"
                        SemanticProperties.Description="{loc:LocalizedText Cycle_DatePhaseModal_CloseAccessibility}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseDatePhaseModalCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Data="M6 6L18 18M18 6L6 18"
                            Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            StrokeThickness="2.2"
                            StrokeLineCap="Round"
                            Aspect="Uniform"
                            WidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <BoxView
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        HeightRequest="1"
                        Margin="0,6,0,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        Opacity="0.7" />
                </Grid>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="20,0,20,16" Spacing="12">
                        <Label
                            Text="{Binding PhaseEditStatusText, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource ErrorLabel}"
                            IsVisible="{Binding HasPhaseEditStatus}" />

                        <Border
                            IsVisible="{Binding HasPhaseJumpWarning}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="16,14">
                            <VerticalStackLayout Spacing="10">
                                <Label
                                    Text="{Binding PhaseJumpWarningTitle, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource CardTitle}" />
                                <Label
                                    Text="{Binding PhaseJumpWarningText, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout
                            Spacing="12"
                            BindableLayout.ItemsSource="{Binding PhaseEditOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="cycleModels:CyclePhaseOptionItem">
                                <Border
                                    BackgroundColor="{Binding BackgroundColor}"
                                    StrokeShape="RoundRectangle 14"
                                    Stroke="{Binding TextColor}"
                                    StrokeThickness="0"
                                    Padding="16,14"
                                    MinimumHeightRequest="60"
                                    SemanticProperties.Description="{Binding Name, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_DatePhaseModal_SelectPhaseFormat}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectPhaseOptionCommand, Source={RelativeSource AncestorType={x:Type vm:CycleViewModel}}, x:DataType=vm:CycleViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding IsSelected}"
                                            Value="True">
                                            <Setter Property="StrokeThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *, Auto"
                                          ColumnSpacing="12" RowSpacing="3">
                                        <sharedControls:PhaseVisualView
                                            Grid.RowSpan="2"
                                            Source="{Binding IconSource}"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Name, Converter={StaticResource LocalizedStringConverter}}"
                                            TextColor="{Binding TextColor}"
                                            FontSize="15"
                                            FontAttributes="Bold" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding Description, Converter={StaticResource LocalizedStringConverter}}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            FontSize="13"
                                            LineBreakMode="WordWrap" />

                                        <Border
                                            Grid.Column="2"
                                            Grid.RowSpan="2"
                                            WidthRequest="26"
                                            HeightRequest="26"
                                            StrokeShape="RoundRectangle 13"
                                            Stroke="{Binding TextColor}"
                                            StrokeThickness="1.4"
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger
                                                    TargetType="Border"
                                                    Binding="{Binding IsSelected}"
                                                    Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label
                                                Text="{loc:LocalizedText Cycle_DatePhaseModal_Checkmark}"
                                                TextColor="{StaticResource White}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding IsSelected}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

                <Grid
                    Grid.Row="2"
                    Padding="20,12,20,20">
                    <Grid
                        IsVisible="{Binding HasPhaseJumpWarning}"
                        ColumnDefinitions="*, *"
                        ColumnSpacing="10">
                        <Button
                            Text="{loc:LocalizedText Cycle_DatePhaseModal_UseNextPhaseButton}"
                            Command="{Binding UseSuggestedPhaseCommand}"
                            IsVisible="{Binding HasSuggestedPhase}"
                            HeightRequest="48"
                            FontSize="14" />
                        <Button
                            Grid.Column="1"
                            Text="{loc:LocalizedText Cycle_DatePhaseModal_ForgotShift}"
                            Command="{Binding ReviewEarlierPhaseRecordsCommand}"
                            HeightRequest="48"
                            FontSize="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </Grid>

                    <Button
                        Text="{loc:LocalizedText Cycle_DatePhaseModal_SaveButton}"
                        Command="{Binding SaveDatePhaseCommand}"
                        HeightRequest="52"
                        IsVisible="{Binding HasPhaseJumpWarning, Converter={StaticResource InvertedBoolConverter}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
