<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Cycle.CycleDatePhaseModal"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:cycleModels="clr-namespace:MuscleCuties.UI.Models.UI.Cycle"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel"
    IsOpen="{Binding IsDatePhaseModalVisible}">

    <Grid>
        <BoxView BackgroundColor="{StaticResource ModalScrim}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseDatePhaseModalCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border
            x:Name="SheetSurface"
            Style="{StaticResource AppBottomSheetSurface}">

            <Grid RowDefinitions="Auto, *, Auto">
                <!-- Header: flattened from 3-deep Grid nesting into single Grid -->
                <Grid
                    Grid.Row="0"
                    RowDefinitions="Auto, Auto, Auto"
                    ColumnDefinitions="*, Auto"
                    ColumnSpacing="{StaticResource UiSpaceCompact}"
                    RowSpacing="{StaticResource UiSpacing6}"
                    Padding="{StaticResource UiInsets20_18_20_12}">

                    <Label
                        Text="{Binding SelectedCalendarDateText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ModalTitle}"
                        FontSize="{StaticResource UiFontSize20}" />

                    <Label
                        Grid.Row="1"
                        Text="{Binding SelectedCalendarPhaseText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource MutedLabel}" />

                    <Border
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        Style="{StaticResource ModalIconButton}"
                        SemanticProperties.Description="{loc:LocalizedText Cycle_DatePhaseModal_CloseAccessibility}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseDatePhaseModalCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Style="{StaticResource ModalCloseIcon}"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension14}"
                            HeightRequest="{StaticResource UiDimension14}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <BoxView
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        HeightRequest="{StaticResource UiDimension1}"
                        Margin="{StaticResource UiInsets0_6_0_0}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        Opacity="{StaticResource UiOpacityBackdrop}" />
                </Grid>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="{StaticResource UiInsets20_0_20_16}" Spacing="{StaticResource UiSpaceCompact}">
                        <Label
                            Text="{Binding PhaseEditStatusText, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource ErrorLabel}"
                            IsVisible="{Binding HasPhaseEditStatus}" />

                        <Border
                            IsVisible="{Binding HasPhaseJumpWarning}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurfaceLight}, Dark={StaticResource WarningSurfaceDark}}"
                            StrokeShape="{StaticResource UiRoundRectangleRadius14}"
                            StrokeThickness="{StaticResource UiStrokeWidth0}"
                            Padding="{StaticResource UiInsets16_14}">
                            <VerticalStackLayout Spacing="{StaticResource UiSpacing10}">
                                <Label
                                    Text="{Binding PhaseJumpWarningTitle, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource CardTitle}" />
                                <Label
                                    Text="{Binding PhaseJumpWarningText, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout
                            Spacing="{StaticResource UiSpaceCompact}"
                            BindableLayout.ItemsSource="{Binding PhaseEditOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="cycleModels:CyclePhaseOptionItem">
                                <Border
                                    BackgroundColor="{Binding BackgroundColor}"
                                    StrokeShape="{StaticResource UiRoundRectangleRadius14}"
                                    Stroke="{Binding TextColor}"
                                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                                    Padding="{StaticResource UiInsets16_14}"
                                    MinimumHeightRequest="{StaticResource UiDimension60}"
                                    SemanticProperties.Description="{Binding Name, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_DatePhaseModal_SelectPhaseFormat}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectPhaseOptionCommand, Source={RelativeSource AncestorType={x:Type vm:CycleViewModel}}, x:DataType=vm:CycleViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding IsSelected}"
                                            Value="True">
                                            <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth1_5}" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *, Auto"
                                          ColumnSpacing="{StaticResource UiSpaceCompact}" RowSpacing="{StaticResource UiSpacing3}">
                                        <sharedControls:PhaseVisualView
                                            Grid.RowSpan="2"
                                            Source="{Binding IconSource}"
                                            WidthRequest="{StaticResource UiDimension34}"
                                            HeightRequest="{StaticResource UiDimension34}"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Name, Converter={StaticResource LocalizedStringConverter}}"
                                            TextColor="{Binding TextColor}"
                                            FontSize="{StaticResource UiFontSize15}"
                                            FontAttributes="{StaticResource UiFontAttributesBold}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding Description, Converter={StaticResource LocalizedStringConverter}}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            FontSize="{StaticResource UiFontSize13}"
                                            LineBreakMode="WordWrap" />

                                        <Border
                                            Grid.Column="2"
                                            Grid.RowSpan="2"
                                            WidthRequest="{StaticResource UiDimension26}"
                                            HeightRequest="{StaticResource UiDimension26}"
                                            StrokeShape="{StaticResource UiRoundRectangleRadius13}"
                                            Stroke="{Binding TextColor}"
                                            StrokeThickness="{StaticResource UiStrokeWidth1_4}"
                                            BackgroundColor="{StaticResource Transparent}"
                                            VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger
                                                    TargetType="Border"
                                                    Binding="{Binding IsSelected}"
                                                    Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label
                                                Text="{loc:LocalizedText Cycle_DatePhaseModal_Checkmark}"
                                                TextColor="{StaticResource White}"
                                                FontSize="{StaticResource UiFontSize13}"
                                                FontAttributes="{StaticResource UiFontAttributesBold}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding IsSelected}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

                <Grid
                    Grid.Row="2"
                    Padding="{StaticResource UiInsets20_12_20_20}">
                    <Grid
                        IsVisible="{Binding HasPhaseJumpWarning}"
                        ColumnDefinitions="*, *"
                        ColumnSpacing="{StaticResource UiSpacing10}">
                        <Button
                            Text="{loc:LocalizedText Cycle_DatePhaseModal_UseNextPhaseButton}"
                            Command="{Binding UseSuggestedPhaseCommand}"
                            IsVisible="{Binding HasSuggestedPhase}" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource ButtonSecondary}"
                            Text="{loc:LocalizedText Cycle_DatePhaseModal_ForgotShift}"
                            Command="{Binding ReviewEarlierPhaseRecordsCommand}" />
                    </Grid>

                    <Button
                        Text="{loc:LocalizedText Cycle_DatePhaseModal_SaveButton}"
                        Command="{Binding SaveDatePhaseCommand}"
                        IsVisible="{Binding HasPhaseJumpWarning, Converter={StaticResource InvertedBoolConverter}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
