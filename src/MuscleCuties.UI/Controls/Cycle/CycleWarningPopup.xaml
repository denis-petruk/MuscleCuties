<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Cycle.CycleWarningPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel"
    IsOpen="{Binding IsCycleWarningPopupVisible}"
    ZIndex="3">

    <Grid
        BackgroundColor="{StaticResource ModalScrim}">
        <Border
            x:Name="SheetSurface"
            Style="{StaticResource AppBottomSheetSurface}"
            VerticalOptions="End">
            <Grid RowDefinitions="Auto, *, Auto" RowSpacing="0">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Padding="18,16,18,12">
                    <Border
                        WidthRequest="34"
                        HeightRequest="34"
                        StrokeShape="RoundRectangle 17"
                        BackgroundColor="{StaticResource Secondary}"
                        StrokeThickness="0"
                        VerticalOptions="Start">
                        <Label
                            Text="!"
                            TextColor="{StaticResource Primary}"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        Grid.Column="1"
                        Text="{Binding CycleWarningTitle, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ModalTitle}"
                        VerticalOptions="Center"
                        LineBreakMode="WordWrap" />

                    <Border
                        Grid.Column="2"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        VerticalOptions="Start"
                        SemanticProperties.Description="{loc:LocalizedText Cycle_WarningPopup_DismissAccessibility}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseCycleWarningPopupCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Data="M6 6L18 18M18 6L6 18"
                            Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            StrokeThickness="2"
                            StrokeLineCap="Round"
                            Aspect="Uniform"
                            WidthRequest="16"
                            HeightRequest="16"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <ScrollView Grid.Row="1">
                    <Label
                        Text="{Binding CycleWarningText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource MutedLabel}"
                        Padding="18,0,18,12"
                        LineBreakMode="WordWrap" />
                </ScrollView>

                <VerticalStackLayout
                    Grid.Row="2"
                    Padding="18,0,18,16"
                    Spacing="10">
                    <VerticalStackLayout
                        Spacing="10"
                        IsVisible="{Binding HasCycleWarningSuggestedPhase}">
                        <Button
                            Text="{Binding CycleWarningSuggestedActionText, Converter={StaticResource LocalizedStringConverter}}"
                            Command="{Binding UseCycleWarningSuggestedPhaseCommand}"
                            MinimumHeightRequest="52"
                            FontSize="14" />
                        <Button
                            Text="{loc:LocalizedText Cycle_WarningPopup_ForgotShiftTitle}"
                            Command="{Binding ReviewEarlierPhaseRecordsCommand}"
                            MinimumHeightRequest="52"
                            FontSize="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>

                    <Button
                        Text="{loc:LocalizedText Cycle_WarningPopup_GotItButton}"
                        Command="{Binding CloseCycleWarningPopupCommand}"
                        MinimumHeightRequest="52"
                        IsVisible="{Binding HasCycleWarningSuggestedPhase, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
