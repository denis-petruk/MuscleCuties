<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Cycle.CycleWarningPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel"
    IsOpen="{Binding IsCycleWarningPopupVisible}"
    ZIndex="3">

    <Grid
        BackgroundColor="{StaticResource ModalScrim}">
        <Border
            x:Name="SheetSurface"
            Style="{StaticResource ModalSurface}"
            VerticalOptions="End">
            <Grid RowDefinitions="Auto, *, Auto" RowSpacing="{StaticResource UiSpacing0}">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" Padding="{StaticResource UiInsets18_16_18_12}">
                    <Border
                        WidthRequest="{StaticResource UiDimension34}"
                        HeightRequest="{StaticResource UiDimension34}"
                        StrokeShape="{StaticResource UiRoundRectangleRadius17}"
                        BackgroundColor="{StaticResource Secondary}"
                        StrokeThickness="{StaticResource UiStrokeWidth0}"
                        VerticalOptions="Start">
                        <Label
                            Text="!"
                            TextColor="{StaticResource Primary}"
                            FontSize="{StaticResource UiFontSize17}"
                            FontAttributes="{StaticResource UiFontAttributesBold}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        Grid.Column="1"
                        Text="{Binding CycleWarningTitle, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ModalTitle}"
                        VerticalOptions="Center"
                        LineBreakMode="WordWrap" />

                    <Border
                        Grid.Column="2"
                        Style="{StaticResource ModalIconButton}"
                        SemanticProperties.Description="{loc:LocalizedText Cycle_WarningPopup_DismissAccessibility}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseCycleWarningPopupCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Style="{StaticResource ModalCloseIcon}"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension14}"
                            HeightRequest="{StaticResource UiDimension14}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <ScrollView Grid.Row="1">
                    <Label
                        Text="{Binding CycleWarningText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource MutedLabel}"
                        Padding="{StaticResource UiInsets18_0_18_12}"
                        LineBreakMode="WordWrap" />
                </ScrollView>

                <VerticalStackLayout
                    Grid.Row="2"
                    Padding="{StaticResource UiInsets18_0_18_16}"
                    Spacing="{StaticResource UiSpacing10}">
                    <VerticalStackLayout
                        Spacing="{StaticResource UiSpacing10}"
                        IsVisible="{Binding HasCycleWarningSuggestedPhase}">
                        <Button Style="{StaticResource ButtonSecondary}"
                            Text="{Binding CycleWarningSuggestedActionText, Converter={StaticResource LocalizedStringConverter}}"
                            Command="{Binding UseCycleWarningSuggestedPhaseCommand}" />
                        <Button
                            Style="{StaticResource ButtonSecondary}"
                            Text="{loc:LocalizedText Cycle_WarningPopup_ForgotShiftTitle}"
                            Command="{Binding ReviewEarlierPhaseRecordsCommand}" />
                    </VerticalStackLayout>

                    <Button Style="{StaticResource ButtonSecondary}"
                        Text="{loc:LocalizedText Cycle_WarningPopup_GotItButton}"
                        Command="{Binding CloseCycleWarningPopupCommand}"
                        IsVisible="{Binding HasCycleWarningSuggestedPhase, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
