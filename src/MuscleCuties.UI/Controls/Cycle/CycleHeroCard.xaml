<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Cycle.CycleHeroCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:cycleControls="clr-namespace:MuscleCuties.UI.Controls.Cycle"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel"
    SemanticProperties.Description="{loc:LocalizedText Cycle_Hero_CardAccessibility}">


    <Border Style="{StaticResource CardPrimary}">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="{StaticResource UiSpaceCompact}">

            <!-- Top Row: Section header -->
            <Grid>
                <HorizontalStackLayout Spacing="{StaticResource UiSpacing6}" VerticalOptions="Center">
                    <Path
                        Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16z"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="{StaticResource UiStrokeWidth1_5}"
                        Aspect="Uniform"
                        WidthRequest="{StaticResource UiDimension14}"
                        HeightRequest="{StaticResource UiDimension14}"
                        VerticalOptions="Center" />
                    <Label
                        Text="{loc:LocalizedText Cycle_Hero_HeaderTitle}"
                        Style="{StaticResource CaptionStrong}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                        VerticalOptions="Center"
                        LineBreakMode="WordWrap"
                        SemanticProperties.HeadingLevel="Level2" />
                </HorizontalStackLayout>

            </Grid>

            <!-- Middle Row: Phase title and artwork -->
            <!-- Wrapping row: at accessibility text sizes the phase name needs the full width, so the
                 artwork drops below it instead of squeezing the label until it breaks mid-word. -->
            <FlexLayout Grid.Row="1" Direction="Row" Wrap="Wrap" AlignItems="Center" JustifyContent="SpaceBetween">
                <VerticalStackLayout FlexLayout.Grow="1" FlexLayout.Basis="Auto"
                                     Spacing="{StaticResource UiSpacing6}" VerticalOptions="Center">
                    <Label
                        Text="{Binding PhaseLabel, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_Hero_PhaseFormat}"
                        Style="{StaticResource SectionTitle}"

                        LineBreakMode="WordWrap" />
                    <Label
                        Text="{Binding CycleDaySummary, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource CaptionStrong}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Vector artwork container -->
                <Border
                    WidthRequest="{StaticResource UiDimension80}"
                    HeightRequest="{StaticResource UiDimension80}"
                    Margin="{StaticResource UiInsets12_0_0_0}"
                    StrokeShape="{StaticResource UiRoundRectangleRadius24}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource AccentSurfaceDark}}"
                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                    <Grid HorizontalOptions="Center" VerticalOptions="Center">
                        <!-- Vector Artwork Path -->
                        <Path
                            Data="{Binding PhaseVectorArtworkData, Converter={StaticResource StringToGeometryConverter}}"
                            Stroke="{StaticResource Primary}"
                            Fill="{AppThemeBinding Light={StaticResource PrimaryLightOverlay}, Dark={StaticResource LightInkOverlay}}"
                            StrokeThickness="{StaticResource UiStrokeWidth2}"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension40}"
                            HeightRequest="{StaticResource UiDimension40}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </FlexLayout>

            <!-- Bottom Row: Quick-log action button -->
            <Button
                Grid.Row="2"
                Style="{StaticResource ButtonPrimary}"
                Text="{loc:LocalizedText Cycle_Hero_LogActionAccessibility}"
                Command="{Binding OpenQuickLogCommand}"
                SemanticProperties.Description="{loc:LocalizedText Cycle_Hero_LogActionAccessibility}" />

            <cycleControls:CycleDailyTipsCard Grid.Row="3" />
        </Grid>
    </Border>
</ContentView>
