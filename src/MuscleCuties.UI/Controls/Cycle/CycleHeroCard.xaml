<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Cycle.CycleHeroCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:cycleControls="clr-namespace:MuscleCuties.UI.Controls.Cycle"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel"
    SemanticProperties.Description="{loc:LocalizedText Cycle_Hero_CardAccessibility}">


    <Border Style="{StaticResource CardPrimary}">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="{StaticResource UiSpaceCompact}">

            <!-- Top Row: Section header -->
            <Grid>
                <HorizontalStackLayout Spacing="{StaticResource UiSpacing6}" VerticalOptions="Center">
                    <Path
                        Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16z"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="{StaticResource UiStrokeWidth1_5}"
                        Aspect="Uniform"
                        WidthRequest="{StaticResource UiDimension14}"
                        HeightRequest="{StaticResource UiDimension14}"
                        VerticalOptions="Center" />
                    <Label
                        Text="{loc:LocalizedText Cycle_Hero_HeaderTitle}"
                        Style="{StaticResource CaptionStrong}"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center"
                        LineBreakMode="WordWrap"
                        SemanticProperties.HeadingLevel="Level2" />
                </HorizontalStackLayout>

            </Grid>

            <!-- Middle Row: Phase title and artwork -->
            <Grid Grid.Row="1" ColumnDefinitions="*, 80" ColumnSpacing="{StaticResource UiSpacing14}" RowSpacing="{StaticResource UiSpacing6}">
                <VerticalStackLayout Spacing="{StaticResource UiSpacing6}" VerticalOptions="Center">
                    <Label
                        Text="{Binding PhaseLabel, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_Hero_PhaseFormat}"
                        Style="{StaticResource SectionTitle}"
                        FontSize="{StaticResource UiFontSize24}"
                        FontAttributes="{StaticResource UiFontAttributesBold}"
                        LineBreakMode="WordWrap" />
                    <Label
                        Text="{Binding CycleDaySummary, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource CaptionStrong}"
                        TextColor="{StaticResource Primary}"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Vector artwork container -->
                <Border
                    Grid.Column="1"
                    WidthRequest="{StaticResource UiDimension80}"
                    HeightRequest="{StaticResource UiDimension80}"
                    StrokeShape="{StaticResource UiRoundRectangleRadius24}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource AccentSurfaceDark}}"
                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                    <Grid HorizontalOptions="Center" VerticalOptions="Center">
                        <!-- Vector Artwork Path -->
                        <Path
                            Data="{Binding PhaseVectorArtworkData, Converter={StaticResource StringToGeometryConverter}}"
                            Stroke="{StaticResource Primary}"
                            Fill="{AppThemeBinding Light={StaticResource PrimaryLightOverlay}, Dark={StaticResource LightInkOverlay}}"
                            StrokeThickness="{StaticResource UiStrokeWidth2}"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension40}"
                            HeightRequest="{StaticResource UiDimension40}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Row: Quick-log action button -->
            <Border
                Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                StrokeShape="{StaticResource UiRoundRectangleRadius12}"
                StrokeThickness="{StaticResource UiStrokeWidth0}"
                Padding="{StaticResource UiInsets12_10}"
                MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                SemanticProperties.Description="{loc:LocalizedText Cycle_Hero_LogActionAccessibility}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenQuickLogCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="{StaticResource UiSpacing10}" VerticalOptions="Center">
                    <Border
                        WidthRequest="{StaticResource UiDimension28}"
                        HeightRequest="{StaticResource UiDimension28}"
                        StrokeShape="{StaticResource UiRoundRectangleRadius14}"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="{StaticResource UiStrokeWidth0}"
                        VerticalOptions="Center">
                        <Path
                            Data="M12 5v14M5 12h14"
                            Stroke="{StaticResource White}"
                            StrokeThickness="{StaticResource UiStrokeWidth2}"
                            StrokeLineCap="Round"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension14}"
                            HeightRequest="{StaticResource UiDimension14}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <Label
                        Grid.Column="1"
                        Text="{loc:LocalizedText Cycle_Hero_LogActionAccessibility}"
                        FontSize="{StaticResource UiFontSize13}"
                        FontAttributes="{StaticResource UiFontAttributesBold}"
                        VerticalOptions="Center"
                        LineBreakMode="WordWrap" />
                    <Path
                        Grid.Column="2"
                        Data="M9 18l6-6-6-6"
                        Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                        StrokeThickness="{StaticResource UiStrokeWidth2}"
                        StrokeLineCap="Round"
                        StrokeLineJoin="Round"
                        Aspect="Uniform"
                        WidthRequest="{StaticResource UiDimension12}"
                        HeightRequest="{StaticResource UiDimension12}"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <cycleControls:CycleDailyTipsCard Grid.Row="3" />
        </Grid>
    </Border>
</ContentView>
