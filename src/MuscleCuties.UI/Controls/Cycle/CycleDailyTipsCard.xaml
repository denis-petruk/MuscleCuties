<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Cycle.CycleDailyTipsCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel"
    SemanticProperties.Description="{loc:LocalizedText Cycle_DailyTips_CardAccessibility}">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="14">

            <!-- Row 0: Section header -->
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Path
                    Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                    Stroke="{StaticResource Primary}"
                    Fill="{StaticResource Primary}"
                    StrokeThickness="1"
                    Aspect="Uniform"
                    WidthRequest="14"
                    HeightRequest="14"
                    VerticalOptions="Center" />
                <Label
                    Text="{loc:LocalizedText Cycle_DailyTips_CheerGuidanceTitle}"
                    Style="{StaticResource CaptionLabel}"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center"
                    SemanticProperties.HeadingLevel="Level2" />
            </HorizontalStackLayout>

            <!-- Row 1: Daily Cheer Quote Box -->
            <Border
                Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource AccentSurfaceDark}}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0"
                Padding="16,14">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                    <Path Data="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"
                          Stroke="{StaticResource Primary}" StrokeThickness="1.5" StrokeLineJoin="Round"
                          Fill="Transparent" Aspect="Uniform" WidthRequest="20" HeightRequest="20"
                          VerticalOptions="Start" />
                    <Label
                        Grid.Column="1"
                        Text="{Binding DailyCheerText, Converter={StaticResource LocalizedStringConverter}}"
                        FontSize="15"
                        FontAttributes="Italic"
                        LineBreakMode="WordWrap"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Row 2: Training Micro-Tip -->
            <Border
                Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0"
                Padding="14,12">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                    <Border
                        WidthRequest="34"
                        HeightRequest="34"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        StrokeThickness="0"
                        VerticalOptions="Start">
                        <Path
                            Data="M6 5v14M18 5v14M2 9v6M22 9v6M6 12h12"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="2"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Aspect="Uniform"
                            WidthRequest="16"
                            HeightRequest="16"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label
                            Text="{loc:LocalizedText Cycle_DailyTips_TrainingFocusTitle}"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Text="{Binding DailyTrainingTipText, Converter={StaticResource LocalizedStringConverter}}"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Row 3: Nutrition Micro-Tip -->
            <Border
                Grid.Row="3"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0"
                Padding="14,12">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                    <Border
                        WidthRequest="34"
                        HeightRequest="34"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        StrokeThickness="0"
                        VerticalOptions="Start">
                        <Path
                            Data="M12 21a9 9 0 0 0 9-9c0-4.97-4.03-9-9-9S3 7.03 3 12a9 9 0 0 0 9 9zm0-15v6l4 2"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="2"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Aspect="Uniform"
                            WidthRequest="16"
                            HeightRequest="16"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label
                            Text="{loc:LocalizedText Cycle_DailyTips_NutritionFocusTitle}"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Text="{Binding DailyNutritionTipText, Converter={StaticResource LocalizedStringConverter}}"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

    </Grid>
</ContentView>
