<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Cycle.CycleDailyTipsCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel"
    SemanticProperties.Description="{loc:LocalizedText Cycle_DailyTips_CardAccessibility}">


    <Grid RowDefinitions="Auto, Auto" RowSpacing="{StaticResource UiSpaceTight}">

            <!-- Row 0: Training Micro-Tip -->
            <Border
                Grid.Row="0"
                Style="{StaticResource CardAccent}">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                    <Border
                        WidthRequest="{StaticResource UiDimension34}"
                        HeightRequest="{StaticResource UiDimension34}"
                        StrokeShape="{StaticResource UiRoundRectangleRadius10}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        StrokeThickness="{StaticResource UiStrokeWidth0}"
                        VerticalOptions="Start">
                        <Path
                            Data="M6 5v14M18 5v14M2 9v6M22 9v6M6 12h12"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="{StaticResource UiStrokeWidth2}"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension16}"
                            HeightRequest="{StaticResource UiDimension16}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource UiSpacing3}" VerticalOptions="Center">
                        <Label
                            Text="{loc:LocalizedText Cycle_DailyTips_TrainingFocusTitle}"
                            FontSize="{StaticResource UiFontSize11}"
                            FontAttributes="{StaticResource UiFontAttributesBold}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Text="{Binding DailyTrainingTipText, Converter={StaticResource LocalizedStringConverter}}"
                            FontSize="{StaticResource UiFontSize13}"
                            LineBreakMode="WordWrap"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Row 1: Nutrition Micro-Tip -->
            <Border
                Grid.Row="1"
                Style="{StaticResource CardAccent}">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                    <Border
                        WidthRequest="{StaticResource UiDimension34}"
                        HeightRequest="{StaticResource UiDimension34}"
                        StrokeShape="{StaticResource UiRoundRectangleRadius10}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        StrokeThickness="{StaticResource UiStrokeWidth0}"
                        VerticalOptions="Start">
                        <Path
                            Data="M12 21a9 9 0 0 0 9-9c0-4.97-4.03-9-9-9S3 7.03 3 12a9 9 0 0 0 9 9zm0-15v6l4 2"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="{StaticResource UiStrokeWidth2}"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension16}"
                            HeightRequest="{StaticResource UiDimension16}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource UiSpacing3}" VerticalOptions="Center">
                        <Label
                            Text="{loc:LocalizedText Cycle_DailyTips_NutritionFocusTitle}"
                            FontSize="{StaticResource UiFontSize11}"
                            FontAttributes="{StaticResource UiFontAttributesBold}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Text="{Binding DailyNutritionTipText, Converter={StaticResource LocalizedStringConverter}}"
                            FontSize="{StaticResource UiFontSize13}"
                            LineBreakMode="WordWrap"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

    </Grid>
</ContentView>
