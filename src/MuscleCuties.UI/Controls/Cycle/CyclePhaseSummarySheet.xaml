<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Cycle.CyclePhaseSummarySheet"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel"
    IsOpen="{Binding IsPhaseSummarySheetVisible}">

    <Grid BackgroundColor="{StaticResource ModalScrim}">
        <BoxView BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ClosePhaseSummarySheetCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border
            x:Name="SheetSurface"
            Style="{StaticResource AppBottomSheetSurface}"
            Padding="0">
            <Grid RowDefinitions="Auto, *, Auto">

                <!-- Header (Flattened Grid) -->
                <Grid RowDefinitions="Auto, Auto, Auto">
                    <!-- Drag handle -->
                    <BoxView
                        Grid.Row="0"
                        WidthRequest="40"
                        HeightRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                        HorizontalOptions="Center"
                        Margin="0,10,0,10" />

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="Auto, *, Auto"
                        ColumnSpacing="12"
                        Padding="20,0,20,12"
                        VerticalOptions="Center">

                        <Image
                            Source="{Binding SelectedPhaseSummary.IconSource}"
                            WidthRequest="38"
                            HeightRequest="38"
                            Aspect="AspectFit"
                            VerticalOptions="Center" />

                        <Grid Grid.Column="1" RowDefinitions="Auto, Auto" RowSpacing="2" VerticalOptions="Center">
                            <Label
                                Grid.Row="0"
                                Text="{Binding SelectedPhaseSummary.Name, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource ModalTitle}"
                                FontSize="20" />
                            <Label
                                Grid.Row="1"
                                Text="{Binding SelectedPhaseSummary.Window, Converter={StaticResource LocalizedStringConverter}}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{Binding SelectedPhaseSummary.AccentColor}" />
                        </Grid>

                        <Border
                            Grid.Column="2"
                            Style="{StaticResource ModalIconButton}"
                            SemanticProperties.Description="{loc:LocalizedText Cycle_PhaseSummary_CloseAccessibility}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClosePhaseSummarySheetCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Style="{StaticResource ModalCloseIcon}"
                                Aspect="Uniform"
                                WidthRequest="14"
                                HeightRequest="14"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <BoxView
                        Grid.Row="2"
                        HeightRequest="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        Opacity="0.7" />
                </Grid>

                <!-- Scrollable Body (Flattened Grid) -->
                <ScrollView Grid.Row="1">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16" Padding="20,16,20,16">

                        <!-- Tagline Banner -->
                        <Border
                            Grid.Row="0"
                            BackgroundColor="{Binding SelectedPhaseSummary.BackgroundColor}"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            Padding="16,12">
                            <Label
                                Text="{Binding SelectedPhaseSummary.Tagline, Converter={StaticResource LocalizedStringConverter}}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{Binding SelectedPhaseSummary.TextColor}"
                                HorizontalOptions="Center" />
                        </Border>

                        <!-- Hormonal Profile -->
                        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                <Path Grid.Column="0" Data="M8 3h8 M10 3v7l-5 9a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3 M7 16h10"
                                      Stroke="{StaticResource Primary}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{loc:LocalizedText Cycle_PhaseSummary_HormonalProfileTitle}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <Label
                                Grid.Row="1"
                                Text="{Binding SelectedPhaseSummary.HormonalSummary, Converter={StaticResource LocalizedStringConverter}}"
                                FontSize="13"
                                LineBreakMode="WordWrap"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </Grid>

                        <!-- Training Strategy -->
                        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                <Path Grid.Column="0" Data="M2 9v6 M5 7v10 M8 11h8 M16 11h-8 M19 7v10 M22 9v6"
                                      Stroke="{StaticResource Primary}" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{loc:LocalizedText Cycle_PhaseSummary_TrainingStrategyTitle}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <Label
                                Grid.Row="1"
                                Text="{Binding SelectedPhaseSummary.TrainingFocus, Converter={StaticResource LocalizedStringConverter}}"
                                FontSize="13"
                                LineBreakMode="WordWrap"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </Grid>

                        <!-- Nutrition Strategy -->
                        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                <Path Grid.Column="0" Data="M12 3c4 0 7 5 7 10s-3 8-7 8-7-3-7-8 3-10 7-10z M12 12a3 3 0 1 0 0 6a3 3 0 0 0 0-6z"
                                      Stroke="{StaticResource Primary}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{loc:LocalizedText Cycle_PhaseSummary_NutritionStrategyTitle}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <Label
                                Grid.Row="1"
                                Text="{Binding SelectedPhaseSummary.NutritionFocus, Converter={StaticResource LocalizedStringConverter}}"
                                FontSize="13"
                                LineBreakMode="WordWrap"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </Grid>

                        <!-- Recovery & Self-Care -->
                        <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                <Path Grid.Column="0" Data="M20 15a8 8 0 0 1-11-11A8 8 0 1 0 20 15z"
                                      Stroke="{StaticResource Primary}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{loc:LocalizedText Cycle_PhaseSummary_RecoveryTitle}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <Label
                                Grid.Row="1"
                                Text="{Binding SelectedPhaseSummary.RecoveryFocus, Converter={StaticResource LocalizedStringConverter}}"
                                FontSize="13"
                                LineBreakMode="WordWrap"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </Grid>

                        <!-- Golden Quick Rule -->
                        <Border
                            Grid.Row="5"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Padding="14,10">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Path Data="M9 18h6 M10 21h4 M9 15a7 7 0 1 1 6 0l-1 3h-4z"
                                      Stroke="{StaticResource Primary}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Start" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding SelectedPhaseSummary.QuickRule, Converter={StaticResource LocalizedStringConverter}}"
                                    FontSize="13"
                                    FontAttributes="Italic"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            </Grid>
                        </Border>

                    </Grid>
                </ScrollView>

                <!-- Footer Actions -->
                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="*, Auto"
                    ColumnSpacing="12"
                    Padding="20,12,20,24">
                    <Button
                        Text="{loc:LocalizedText Cycle_PhaseSummary_ExploreFullGuideButton}"
                        Command="{Binding OpenFullPhaseGuideCommand}"
                        IsVisible="{Binding IsPhaseGuideAvailable}"
                        MinimumHeightRequest="52"
                        HeightRequest="52"
                        FontSize="15"
                        FontAttributes="Bold" />
                    <Label Text="{loc:LocalizedText Cycle_PhaseSummary_GuidePendingReview}"
                           IsVisible="{Binding IsPhaseGuideAvailable, Converter={StaticResource InvertedBoolConverter}}"
                           Style="{StaticResource CaptionLabel}"
                           VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Text="{loc:LocalizedText Cycle_PhaseSummary_CloseButton}"
                        Command="{Binding ClosePhaseSummarySheetCommand}"
                        MinimumHeightRequest="52"
                        HeightRequest="52"
                        WidthRequest="90"
                        FontSize="15"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
