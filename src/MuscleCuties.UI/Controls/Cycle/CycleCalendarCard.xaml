<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Cycle.CycleCalendarCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:cycleControls="clr-namespace:MuscleCuties.UI.Controls.Cycle"
    xmlns:cycleModels="clr-namespace:MuscleCuties.UI.Models.UI.Cycle"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel">


    <Border
        Style="{StaticResource CardPrimary}">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
              RowSpacing="{StaticResource UiSpaceCompact}">

            <!-- Row 0: Day summary + period countdown. The countdown is long Russian text, so the row
                 wraps: the day summary keeps its line instead of being squeezed into three. -->
            <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center" JustifyContent="SpaceBetween">
                <Label
                    Text="{Binding CycleDaySummary, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource SectionTitle}"
                    VerticalOptions="Center"
                    LineBreakMode="WordWrap"
                    SemanticProperties.HeadingLevel="Level2" />
                <Label
                    Text="{Binding PeriodCountdownText, Converter={StaticResource LocalizedStringConverter}}"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                    Style="{StaticResource MutedLabel}"
                    VerticalOptions="Center"
                    IsVisible="{Binding HasActiveCycle}"
                    LineBreakMode="WordWrap"
                    SemanticProperties.Description="{Binding PeriodCountdownText, Converter={StaticResource LocalizedStringConverter}}" />
            </FlexLayout>

            <!-- Row 1: Phase icon on neutral BG + Phase label & log info + action button -->
            <!-- Wrapping row: the phase name keeps its own line instead of being squeezed between the
                 icon and the action button until the word breaks. -->
            <FlexLayout Grid.Row="1" Direction="Row" Wrap="Wrap" AlignItems="Center" JustifyContent="SpaceBetween">
                <!-- Neutral BG Container for Cycle SVG -->
                <Border
                    WidthRequest="{StaticResource UiDimension40}"
                    HeightRequest="{StaticResource UiDimension40}"
                    StrokeShape="{StaticResource UiRoundRectangleRadius20}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource AccentSurfaceDeepDark}}"
                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                    Padding="{StaticResource UiInsets6}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                    <Image
                        Source="{Binding CurrentPhaseIconSource}"
                        Aspect="AspectFit"
                        WidthRequest="{StaticResource UiDimension26}"
                        HeightRequest="{StaticResource UiDimension26}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <!-- Phase Label & Last Logged Text -->
                <VerticalStackLayout FlexLayout.Grow="1" FlexLayout.Basis="Auto"
                                     Margin="{StaticResource UiInsets0_0_8_0}"
                                     Spacing="{StaticResource UiSpacing2}" VerticalOptions="Center">
                    <Label
                        Text="{Binding PhaseLabel, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource SectionTitle}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center"
                        LineBreakMode="WordWrap"
                        SemanticProperties.Description="{Binding PhaseLabel, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_Calendar_CurrentPhaseFormat}" />
                    <Label
                        Text="{Binding LastPhaseLogText, Converter={StaticResource LocalizedStringConverter}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                        Style="{StaticResource MutedLabel}"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Action Button -->
                <Button Style="{StaticResource ButtonSecondary}"
                    Margin="{StaticResource UiInsets0_8_0_0}"
                    Text="{Binding PhaseLogActionText, Converter={StaticResource LocalizedStringConverter}}"
                    Command="{Binding AdvancePhaseCommand}"
                    VerticalOptions="Center"
                    SemanticProperties.Description="{Binding PhaseLogActionText, Converter={StaticResource LocalizedStringConverter}}" />
            </FlexLayout>

            <!-- Row 2: Prediction summary badge -->
            <Label
                Grid.Row="2"
                Text="{Binding PredictionSummary, Converter={StaticResource LocalizedStringConverter}}"
                Style="{StaticResource CaptionLabel}"
                FontAttributes="{StaticResource UiFontAttributesItalic}"
                IsVisible="{Binding HasActiveCycle}"
                LineBreakMode="WordWrap"
                SemanticProperties.Description="{Binding PredictionSummary, Converter={StaticResource LocalizedStringConverter}}" />

            <!-- Row 3: Calendar edit hint -->
            <Label
                Grid.Row="3"
                Text="{Binding CalendarEditHintText, Converter={StaticResource LocalizedStringConverter}}"
                Style="{StaticResource MutedLabel}"
                LineBreakMode="WordWrap"
                IsVisible="{Binding HasCalendarEditHint}" />

            <!-- Row 4: Scrollable month -->
            <ScrollView
                x:Name="MonthStripScrollView"
                Grid.Row="4"
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Default"
                Margin="{StaticResource UiInsets0_0_0_8}"
                SemanticProperties.Description="{loc:LocalizedText Cycle_Calendar_WeeklyStripAccessibility}">
                <HorizontalStackLayout
                x:Name="MonthStripDaysLayout"
                Spacing="{StaticResource UiSpacing6}"
                BindableLayout.ItemsSource="{Binding CalendarStripDays}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="cycleModels:CycleDayItem">
                        <!-- A minimum, not a fixed width: at the largest text sizes "13" is wider than
                             the cell and broke into two lines. The strip scrolls, so the cell grows. -->
                        <Border
                            MinimumWidthRequest="{StaticResource UiDimension56}"
                            MinimumHeightRequest="{StaticResource UiDimension60}"
                            StrokeShape="{StaticResource UiRoundRectangleRadius12}"
                            BackgroundColor="{Binding BackgroundColor}"
                            Stroke="{Binding StrokeColor}"
                            StrokeThickness="{Binding StrokeThickness}"
                            Padding="{StaticResource UiInsets8_6}"
                            SemanticProperties.Description="{Binding AccessibilityDescription, Converter={StaticResource LocalizedStringConverter}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectCalendarDayCommand, Source={RelativeSource AncestorType={x:Type vm:CycleViewModel}}, x:DataType=vm:CycleViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="{StaticResource UiSpacing2}" HorizontalOptions="Center"
                                  VerticalOptions="Center">
                                <Label
                                    Text="{Binding DayOfWeekShort, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource CaptionLabel}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    HorizontalOptions="Center" />
                                <Label
                                    Grid.Row="1"
                                    Text="{Binding DisplayDayLabel, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource BodyStrong}"
                                    TextColor="{Binding TextColor}"
                                    HorizontalOptions="Center" />
                                <Ellipse
                                    Grid.Row="2"
                                    WidthRequest="{StaticResource UiDimension6}"
                                    HeightRequest="{StaticResource UiDimension6}"
                                    Fill="{Binding PhaseMarkerColor}"
                                    HorizontalOptions="Center"
                                    Margin="{StaticResource UiInsets0_2_0_0}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Grid Grid.Row="5" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="{StaticResource UiSpacing10}" VerticalOptions="Center"
                  Margin="{StaticResource UiInsets0_0_0_8}">
                <Border
                    Style="{StaticResource HeaderIconButton}"
                    VerticalOptions="Center"
                    SemanticProperties.Description="{loc:LocalizedText Cycle_Calendar_PrevMonthAccessibility}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PreviousMonthCommand}" />
                    </Border.GestureRecognizers>
                    <Path
                        Data="M15 18l-6-6 6-6"
                        Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        StrokeThickness="{StaticResource UiStrokeWidth2}"
                        StrokeLineCap="Round"
                        StrokeLineJoin="Round"
                        Aspect="Uniform"
                        WidthRequest="{StaticResource UiDimension12}"
                        HeightRequest="{StaticResource UiDimension12}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Label
                    Grid.Column="1"
                    Text="{Binding CurrentMonthLabel, Converter={StaticResource LocalizedStringConverter}}"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Center"
                    Style="{StaticResource SectionTitle}"
                    LineBreakMode="WordWrap" />

                <Border
                    Grid.Column="2"
                    MinimumWidthRequest="{StaticResource PresentationMinimumTouchSize}"
                    MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                    Padding="{StaticResource UiInsets10_4}"
                    StrokeShape="{StaticResource UiRoundRectangleRadius12}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource AccentSurfaceDark}}"
                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsViewingCurrentMonth, Converter={StaticResource InvertedBoolConverter}}"
                    SemanticProperties.Description="{loc:LocalizedText Cycle_Calendar_ReturnCurrentMonthAccessibility}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ReturnToTodayCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="{loc:LocalizedText Cycle_Calendar_TodayAccessibility}"
                        Style="{StaticResource CaptionLabel}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        LineBreakMode="WordWrap" />
                </Border>

                <Border
                    Grid.Column="3"
                    Style="{StaticResource HeaderIconButton}"
                    VerticalOptions="Center"
                    SemanticProperties.Description="{loc:LocalizedText Cycle_Calendar_NextMonthAccessibility}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NextMonthCommand}" />
                    </Border.GestureRecognizers>
                    <Path
                        Data="M9 18l6-6-6-6"
                        Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        StrokeThickness="{StaticResource UiStrokeWidth2}"
                        StrokeLineCap="Round"
                        StrokeLineJoin="Round"
                        Aspect="Uniform"
                        WidthRequest="{StaticResource UiDimension12}"
                        HeightRequest="{StaticResource UiDimension12}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
            </Grid>

            <Label
                Grid.Row="6"
                Text="{Binding CalendarNavigationStatusText, Converter={StaticResource LocalizedStringConverter}}"
                Style="{StaticResource CaptionLabel}"
                LineBreakMode="WordWrap"
                IsVisible="{Binding HasCalendarNavigationStatus}" />

            <!-- Expand / Collapse Month Grid. A real button carries the automation identity, so the
                 control can be tapped by id at accessibility sizes, where its label wraps. -->
            <Button
                Grid.Row="7"
                AutomationId="CycleMonthToggle"
                Style="{StaticResource ButtonSecondary}"
                Text="{Binding MonthExpandButtonText, Converter={StaticResource LocalizedStringConverter}}"
                Command="{Binding ToggleMonthGridExpandedCommand}"
                SemanticProperties.Description="{Binding MonthExpandButtonText, Converter={StaticResource LocalizedStringConverter}}" />

            <!-- Expandable Month Grid & Legend -->
            <VerticalStackLayout
                Grid.Row="8"
                Spacing="{StaticResource UiSpaceCompact}"
                IsVisible="{Binding IsMonthGridExpanded}">

                <cycleControls:CycleMonthGrid
                    ItemsSource="{Binding CalendarDays}"
                    IsExpanded="{Binding IsMonthGridExpanded}"
                    DaySelectedCommand="{Binding SelectCalendarDayCommand}" />

                <!-- Each legend entry is its own row: in one wrapping row a swatch could separate
                     from its label once the text grew, which left a lone dot on the card. -->
                <VerticalStackLayout
                    Spacing="{StaticResource UiSpaceMicro}"
                    SemanticProperties.Description="{loc:LocalizedText Cycle_Calendar_LegendAccessibility}">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpaceTight}">
                        <Border
                            WidthRequest="{StaticResource UiDimension14}"
                            HeightRequest="{StaticResource UiDimension14}"
                            StrokeShape="{StaticResource UiRoundRectangleRadius4}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CyclePhaseDefaultLight}, Dark={StaticResource CyclePhaseDefaultDark}}"
                            StrokeThickness="{StaticResource UiStrokeWidth0}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{loc:LocalizedText Cycle_Calendar_RecordedObservationLegend}"
                            Style="{StaticResource CaptionLabel}"
                            VerticalOptions="Center"
                            LineBreakMode="WordWrap" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpaceTight}">
                        <Border
                            WidthRequest="{StaticResource UiDimension14}"
                            HeightRequest="{StaticResource UiDimension14}"
                            StrokeShape="{StaticResource UiRoundRectangleRadius4}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CyclePhaseDefaultLight}, Dark={StaticResource CyclePhaseDefaultDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            StrokeThickness="{StaticResource UiStrokeWidth1}"
                            Opacity="{StaticResource UiOpacityEstimatedDay}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{loc:LocalizedText Cycle_Calendar_PredictedEstimatedLegend}"
                            Style="{StaticResource CaptionLabel}"
                            FontAttributes="{StaticResource UiFontAttributesItalic}"
                            VerticalOptions="Center"
                            LineBreakMode="WordWrap" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </Grid>
    </Border>
</ContentView>
