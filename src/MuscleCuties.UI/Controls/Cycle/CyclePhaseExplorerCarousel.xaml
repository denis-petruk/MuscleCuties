<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Cycle.CyclePhaseExplorerCarousel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:cycleModels="clr-namespace:MuscleCuties.UI.Models.UI.Cycle"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel"
    SemanticProperties.Description="{loc:LocalizedText Cycle_PhaseExplorer_CarouselAccessibility}">

    <ContentView.Resources>
        <Thickness x:Key="CyclePhaseExplorerPadding">20</Thickness>
        <x:Double x:Key="CyclePhaseRowSpacing">10</x:Double>
        <x:Double x:Key="CyclePhaseRowMinimumHeight">76</x:Double>
    </ContentView.Resources>

    <Border Style="{StaticResource CardPrimary}" Padding="{StaticResource CyclePhaseExplorerPadding}"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
            StrokeThickness="1">
    <Grid RowDefinitions="Auto, Auto" RowSpacing="12">

        <!-- Header -->
        <Grid ColumnDefinitions="*, Auto" Margin="2,0">
            <VerticalStackLayout Spacing="2">
                <Label
                    Text="{loc:LocalizedText Cycle_PhaseExplorer_SectionTitle}"
                    Style="{StaticResource SectionTitle}"
                    FontSize="18"
                    FontAttributes="Bold" />
                <Label
                    Text="{loc:LocalizedText Cycle_PhaseExplorer_Subtitle}"
                    Style="{StaticResource MutedLabel}"
                    FontSize="13" />
            </VerticalStackLayout>
        </Grid>

        <!-- Four phase rows -->
            <VerticalStackLayout
                Grid.Row="1"
                Spacing="{StaticResource CyclePhaseRowSpacing}"
                BindableLayout.ItemsSource="{Binding PhaseExplorerPills}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="cycleModels:PhaseExplorerPillItem">
                        <Border
                            MinimumHeightRequest="{StaticResource CyclePhaseRowMinimumHeight}"
                            HorizontalOptions="Fill"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{Binding BackgroundColor}"
                            Stroke="{Binding AccentColor}"
                            StrokeThickness="1.5"
                            Padding="14,10"
                            SemanticProperties.Description="{Binding Name, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_PhaseExplorer_ExplorePhaseFormat}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectPhaseExplorerPillCommand, Source={RelativeSource AncestorType={x:Type vm:CycleViewModel}}, x:DataType=vm:CycleViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                                <Image
                                    Source="{Binding IconSource}"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    Aspect="AspectFit"
                                    VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label
                                            Text="{Binding Name, Converter={StaticResource LocalizedStringConverter}}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{Binding TextColor}" />
                                        <Border
                                            Grid.Column="1"
                                            IsVisible="{Binding IsActivePhase}"
                                            BackgroundColor="{Binding AccentColor}"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="0"
                                            Padding="4,1">
                                            <Label
                                                Text="{loc:LocalizedText Cycle_PhaseExplorer_NowBadge}"
                                                FontSize="9"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource White}" />
                                        </Border>
                                    </Grid>
                                    <Label
                                        Text="{Binding Window, Converter={StaticResource LocalizedStringConverter}}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{Binding AccentColor}" />
                                    <Label
                                        Text="{Binding Tagline, Converter={StaticResource LocalizedStringConverter}}"
                                        FontSize="11"
                                        LineBreakMode="WordWrap"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

    </Grid>
    </Border>
</ContentView>
