<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Cycle.CyclePhaseExplorerCarousel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:cycleModels="clr-namespace:MuscleCuties.UI.Models.UI.Cycle"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel"
    SemanticProperties.Description="{loc:LocalizedText Cycle_PhaseExplorer_CarouselAccessibility}">


    <Border Style="{StaticResource CardPrimary}">
    <Grid RowDefinitions="Auto, Auto" RowSpacing="{StaticResource UiSpacing10}">

        <!-- Header -->
        <Grid ColumnDefinitions="*, Auto" Margin="{StaticResource UiInsets2_0}">
            <Label
                Text="{loc:LocalizedText Cycle_PhaseExplorer_SectionTitle}"
                Style="{StaticResource SectionTitle}"
                LineBreakMode="WordWrap"
                SemanticProperties.HeadingLevel="Level2" />
        </Grid>

        <!-- Four phase rows -->
            <VerticalStackLayout
                Grid.Row="1"
                Spacing="{StaticResource UiSpacing6}"
                BindableLayout.ItemsSource="{Binding PhaseExplorerPills}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="cycleModels:PhaseExplorerPillItem">
                        <Border
                            MinimumHeightRequest="{StaticResource UiDimension52}"
                            HorizontalOptions="Fill"
                            StrokeShape="{StaticResource UiRoundRectangleRadius16}"
                            BackgroundColor="{Binding BackgroundColor}"
                            Stroke="{Binding AccentColor}"
                            StrokeThickness="{StaticResource UiStrokeWidth0}"
                            Padding="{StaticResource UiInsets12_8}"
                            SemanticProperties.Description="{Binding Name, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_PhaseExplorer_ExplorePhaseFormat}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectPhaseExplorerPillCommand, Source={RelativeSource AncestorType={x:Type vm:CycleViewModel}}, x:DataType=vm:CycleViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                <Image
                                    Source="{Binding IconSource}"
                                    WidthRequest="{StaticResource UiDimension28}"
                                    HeightRequest="{StaticResource UiDimension28}"
                                    Aspect="AspectFit"
                                    VerticalOptions="Center" />

                                <Grid Grid.Column="1" ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Name, Converter={StaticResource LocalizedStringConverter}}"
                                            FontSize="{StaticResource UiFontSize15}"
                                            FontAttributes="{StaticResource UiFontAttributesBold}"
                                            TextColor="{Binding TextColor}"
                                            LineBreakMode="WordWrap" />
                                        <Border
                                            Grid.Column="1"
                                            IsVisible="{Binding IsActivePhase}"
                                            BackgroundColor="{Binding AccentColor}"
                                            StrokeShape="{StaticResource UiRoundRectangleRadius6}"
                                            StrokeThickness="{StaticResource UiStrokeWidth0}"
                                            Padding="{StaticResource UiInsets4_1}">
                                            <Label
                                                Text="{loc:LocalizedText Cycle_PhaseExplorer_NowBadge}"
                                                FontSize="{StaticResource UiFontSize11}"
                                                FontAttributes="{StaticResource UiFontAttributesBold}"
                                                TextColor="{StaticResource White}"
                                                LineBreakMode="WordWrap" />
                                        </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

    </Grid>
    </Border>
</ContentView>
