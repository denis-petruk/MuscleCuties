<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Cycle.CycleQuickLogBottomSheet"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:cycleModels="clr-namespace:MuscleCuties.UI.Models.UI.Cycle"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Cycle"
    x:DataType="vm:CycleViewModel"
    IsOpen="{Binding IsQuickLogSheetVisible}">

    <Grid BackgroundColor="{StaticResource ModalScrim}">
        <BoxView Style="{StaticResource ModalDismissTarget}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseQuickLogSheetCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border
            x:Name="SheetSurface"
            Style="{StaticResource ModalSurface}" VerticalOptions="End">
            <Grid RowDefinitions="Auto, *, Auto">

                <!-- Header (Flattened Grid) -->
                <Grid RowDefinitions="Auto, Auto, Auto">
                    <BoxView
                        Grid.Row="0"
                        WidthRequest="{StaticResource UiDimension40}"
                        HeightRequest="{StaticResource UiDimension4}"
                        CornerRadius="{StaticResource UiCornerRadius2}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                        HorizontalOptions="Center"
                        Margin="{StaticResource UiInsets0_10_0_10}" />

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="*, Auto"
                        Padding="{StaticResource UiInsets20_0_20_12}"
                        VerticalOptions="Center">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                            <Label
                                Grid.Row="0"
                                Text="{loc:LocalizedText Cycle_QuickLog_HeaderTitle}"
                                Style="{StaticResource ModalTitle}"
                                FontSize="{StaticResource UiFontSize20}" />
                            <Label
                                Grid.Row="1"
                                Text="{Binding QuickLogDateText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource MutedLabel}" />
                        </Grid>

                        <Border
                            Grid.Column="1"
                            Style="{StaticResource ModalIconButton}"
                            SemanticProperties.Description="{loc:LocalizedText Cycle_QuickLog_CloseAccessibility}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseQuickLogSheetCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Style="{StaticResource ModalCloseIcon}"
                                Aspect="Uniform"
                                WidthRequest="{StaticResource UiDimension14}"
                                HeightRequest="{StaticResource UiDimension14}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <BoxView
                        Grid.Row="2"
                        HeightRequest="{StaticResource UiDimension1}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        Opacity="{StaticResource UiOpacityBackdrop}" />
                </Grid>

                <!-- Scrollable Form Body -->
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="{StaticResource UiInsets20_16_20_16}" Spacing="{StaticResource UiSpacing20}">

                        <!-- SECTION 1: Period Status (Flattened Grid) -->
                        <Label
                            Text="{loc:LocalizedText Cycle_QuickLog_LoadingSavedEntry}"
                            Style="{StaticResource CaptionLabel}"
                            IsVisible="{Binding IsQuickLogLoading}" />
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceTight}">
                            <Label
                                Grid.Row="0"
                                Text="{loc:LocalizedText Cycle_QuickLog_PeriodStatusSectionTitle}"
                                FontSize="{StaticResource UiFontSize11}"
                                FontAttributes="{StaticResource UiFontAttributesBold}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                            <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="{StaticResource UiSpaceCompact}">
                                <!-- Period Started Toggle -->
                                <Border
                                    StrokeShape="{StaticResource UiRoundRectangleRadius14}"
                                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                                    HeightRequest="{StaticResource UiDimension48}"
                                    Padding="{StaticResource UiInsets12_0}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                    SemanticProperties.Description="{loc:LocalizedText Cycle_QuickLog_TogglePeriodStartedAccessibility}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePeriodStartedCommand}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding IsPeriodStarted}"
                                            Value="True">
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource ChoiceSelectedSurfaceLight}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                            <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth1_5}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <HorizontalStackLayout Spacing="{StaticResource UiSpaceTight}" HorizontalOptions="Center"
                                                           VerticalOptions="Center">
                                        <Path
                                            Data="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"
                                            Stroke="{StaticResource Primary}"
                                            Fill="{StaticResource Primary}"
                                            StrokeThickness="{StaticResource UiStrokeWidth1}"
                                            Aspect="Uniform"
                                            WidthRequest="{StaticResource UiDimension14}"
                                            HeightRequest="{StaticResource UiDimension14}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Text="{loc:LocalizedText Cycle_QuickLog_PeriodStarted}"
                                            FontSize="{StaticResource UiFontSize13}"
                                            FontAttributes="{StaticResource UiFontAttributesBold}"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsPeriodStarted}"
                                                    Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Period Ended Toggle -->
                                <Border
                                    Grid.Column="1"
                                    StrokeShape="{StaticResource UiRoundRectangleRadius14}"
                                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                                    HeightRequest="{StaticResource UiDimension48}"
                                    Padding="{StaticResource UiInsets12_0}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                    SemanticProperties.Description="{loc:LocalizedText Cycle_QuickLog_TogglePeriodEndedAccessibility}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePeriodEndedCommand}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding IsPeriodEnded}"
                                            Value="True">
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource ChoiceSelectedSurfaceLight}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                            <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth1_5}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <HorizontalStackLayout Spacing="{StaticResource UiSpaceTight}" HorizontalOptions="Center"
                                                           VerticalOptions="Center">
                                        <Path
                                            Data="M5 13l4 4L19 7"
                                            Stroke="{StaticResource Primary}"
                                            StrokeThickness="{StaticResource UiStrokeWidth2}"
                                            StrokeLineCap="Round"
                                            StrokeLineJoin="Round"
                                            Aspect="Uniform"
                                            WidthRequest="{StaticResource UiDimension14}"
                                            HeightRequest="{StaticResource UiDimension14}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Text="{loc:LocalizedText Cycle_QuickLog_PeriodEnded}"
                                            FontSize="{StaticResource UiFontSize13}"
                                            FontAttributes="{StaticResource UiFontAttributesBold}"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsPeriodEnded}"
                                                    Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- SECTION 2: Flow Intensity (Flattened Grid) -->
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceTight}">
                            <Label
                                Grid.Row="0"
                                Text="{loc:LocalizedText Cycle_QuickLog_FlowIntensitySectionTitle}"
                                FontSize="{StaticResource UiFontSize11}"
                                FontAttributes="{StaticResource UiFontAttributesBold}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                            <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *" ColumnSpacing="{StaticResource UiSpaceTight}"
                                  BindableLayout.ItemsSource="{Binding FlowOptions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="cycleModels:FlowOptionItem">
                                        <Border Style="{StaticResource SelectableCard}"
                                            HeightRequest="{StaticResource UiDimension52}"
                                            SemanticProperties.Description="{Binding Name, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_QuickLog_FlowIntensityFormat}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding SelectFlowCommand, Source={RelativeSource AncestorType={x:Type vm:CycleViewModel}}, x:DataType=vm:CycleViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>

                                            </Border.Triggers>
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}" HorizontalOptions="Center"
                                                  VerticalOptions="Center">
                                                <Label
                                                    Grid.Row="0"
                                                    Text="{Binding Name, Converter={StaticResource LocalizedStringConverter}}"
                                                    FontSize="{StaticResource UiFontSize13}"
                                                    FontAttributes="{StaticResource UiFontAttributesBold}"
                                                    HorizontalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            TargetType="Label"
                                                            Binding="{Binding IsSelected}"
                                                            Value="True">
                                                            <Setter Property="TextColor"
                                                                    Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Path
                                                    Grid.Row="1"
                                                    Data="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"
                                                    Fill="{StaticResource Primary}"
                                                    Aspect="Uniform"
                                                    WidthRequest="{StaticResource UiDimension8}"
                                                    HeightRequest="{StaticResource UiDimension8}"
                                                    HorizontalOptions="Center"
                                                    IsVisible="{Binding IsSelected}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </Grid>
                        </Grid>

                        <!-- SECTION 3: Symptoms (Flattened Grid) -->
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceTight}">
                            <Label
                                Grid.Row="0"
                                Text="{loc:LocalizedText Cycle_QuickLog_SymptomsSectionTitle}"
                                FontSize="{StaticResource UiFontSize11}"
                                FontAttributes="{StaticResource UiFontAttributesBold}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                            <FlexLayout
                                Grid.Row="1"
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="SpaceBetween"
                                BindableLayout.ItemsSource="{Binding SymptomOptions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="cycleModels:SymptomOptionItem">
                                        <Border Style="{StaticResource SelectableCard}"
                                            FlexLayout.Basis="48%"
                                            Margin="{StaticResource UiInsets0_0_0_10}"
                                            HeightRequest="{StaticResource UiDimension50}"
                                            SemanticProperties.Description="{Binding Name, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Cycle_QuickLog_SymptomFormat}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding ToggleSymptomCommand, Source={RelativeSource AncestorType={x:Type vm:CycleViewModel}}, x:DataType=vm:CycleViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>

                                            </Border.Triggers>
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="{StaticResource UiSpacing10}"
                                                  VerticalOptions="Center">
                                                <Path
                                                    Data="{Binding IconData, Converter={StaticResource StringToGeometryConverter}}"
                                                    Stroke="{StaticResource Primary}"
                                                    StrokeThickness="{StaticResource UiStrokeWidth1_8}"
                                                    Aspect="Uniform"
                                                    WidthRequest="{StaticResource UiDimension16}"
                                                    HeightRequest="{StaticResource UiDimension16}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding Name, Converter={StaticResource LocalizedStringConverter}}"
                                                    FontSize="{StaticResource UiFontSize13}"
                                                    FontAttributes="{StaticResource UiFontAttributesBold}"
                                                    VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            TargetType="Label"
                                                            Binding="{Binding IsSelected}"
                                                            Value="True">
                                                            <Setter Property="TextColor"
                                                                    Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Path
                                                    Grid.Column="2"
                                                    Data="M5 13l4 4L19 7"
                                                    Stroke="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}"
                                                    StrokeThickness="{StaticResource UiStrokeWidth2}"
                                                    StrokeLineCap="Round"
                                                    StrokeLineJoin="Round"
                                                    Aspect="Uniform"
                                                    WidthRequest="{StaticResource UiDimension14}"
                                                    HeightRequest="{StaticResource UiDimension14}"
                                                    IsVisible="{Binding IsSelected}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </Grid>

                        <!-- Validation Error / Status message -->
                        <Label
                            Text="{Binding QuickLogStatusText, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource ErrorLabel}"
                            IsVisible="{Binding QuickLogStatusText, Converter={StaticResource StringToBoolConverter}}" />

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Footer Save Action -->
                <Grid
                    Grid.Row="2"
                    Padding="{StaticResource UiInsets20_12_20_24}">
                    <Button Style="{StaticResource ButtonPrimary}"
                        Text="{loc:LocalizedText Cycle_QuickLog_SaveButton}"
                        Command="{Binding SaveQuickLogCommand}" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
