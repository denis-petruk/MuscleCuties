<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Injury.InjuryLogModal"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:injuryControls="clr-namespace:MuscleCuties.UI.Controls.Injury"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Workout"
    x:DataType="vm:InjuryLogViewModel">
    <Grid>
        <BoxView Style="{StaticResource ModalBackdrop}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding CloseCommand, Source={x:Reference Root}, x:DataType=injuryControls:InjuryLogModal}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="SheetSurface" Style="{StaticResource ModalSurface}" VerticalOptions="End"
                MaximumHeightRequest="{StaticResource ModalSheetMaximumHeight}">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceTight}" Padding="{DynamicResource PresentationModalHeaderPadding}">
                    <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Injury_LogTitle}" Style="{StaticResource ModalTitle}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{loc:LocalizedText Common_Add}"
                            Command="{Binding ToggleAddFormCommand}"
                            IsVisible="{Binding ShowAddForm, Converter={StaticResource InvertedBoolConverter}}"
                            Style="{StaticResource ButtonSecondary}"
                            SemanticProperties.Description="{loc:LocalizedText Injury_AddAnInjury}" />
                    <Border Grid.Column="2" Style="{StaticResource ModalIconButton}"
                            SemanticProperties.Description="{loc:LocalizedText Injury_Modal_CloseInjuryLog}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding CloseCommand, Source={x:Reference Root}, x:DataType=injuryControls:InjuryLogModal}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>
                <BoxView Grid.Row="1" Style="{StaticResource ModalDivider}" />
                <injuryControls:InjuryLogContent Grid.Row="2" />
                <!-- Form actions stay on the sheet edge instead of riding the end of a long scroll. -->
                <Grid Grid.Row="3"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="{StaticResource UiSpaceTight}"
                      Padding="{DynamicResource PresentationModalPagePadding}"
                      IsVisible="{Binding ShowAddForm}">
                    <Button Text="{loc:LocalizedText Common_Cancel}"
                            Command="{Binding CancelEditCommand}"
                            Style="{StaticResource ButtonSecondary}" />
                    <Button Grid.Column="1"
                            Text="{loc:LocalizedText Injury_LogContent_SaveInjury}"
                            Command="{Binding SaveInjuryCommand}"
                            Style="{StaticResource ButtonPrimary}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
