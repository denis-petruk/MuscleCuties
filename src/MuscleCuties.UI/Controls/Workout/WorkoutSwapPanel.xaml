<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
             xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
             xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Workout"
             xmlns:models="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
             x:Class="MuscleCuties.UI.Controls.Workout.WorkoutSwapPanel"
             x:Name="SwapRoot"
             x:DataType="vm:WorkoutSessionViewModel"
             IsOpen="{Binding IsSwapPanelVisible}">
    <Grid BackgroundColor="{StaticResource ModalScrim}">
        <Grid BackgroundColor="{StaticResource Transparent}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseSwapPanelCommand}" />
            </Grid.GestureRecognizers>
        </Grid>
        <Border x:Name="SheetSurface" Style="{StaticResource ModalSurface}" MaximumHeightRequest="{StaticResource ModalSheetMaximumHeight}"
                VerticalOptions="End">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing0}" IsEnabled="{Binding CanInteract}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}"
                      Padding="{DynamicResource PresentationModalHeaderPadding}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                        <Label LineBreakMode="WordWrap" Text="{loc:LocalizedText Workout_Swap_Title}" Style="{StaticResource ModalTitle}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label LineBreakMode="WordWrap"
                            Text="{Binding SwapTargetName, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Swap_ReplaceFormat}"
                            Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Style="{StaticResource ModalIconButton}" IsVisible="{Binding CanDismissSwap}"
                            SemanticProperties.Description="{loc:LocalizedText Workout_Swap_CloseButton}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseSwapPanelCommand}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>
                <BoxView Grid.Row="1" Style="{StaticResource ModalDivider}" />
                <!-- Auto rows, not a star row: a star row inside a bottom-anchored sheet stretches the
                     panel to the full sheet ceiling even when the candidate list is empty. -->
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpaceCompact}"
                      Padding="{DynamicResource PresentationModalPagePadding}">
                <ActivityIndicator
                        Style="{StaticResource StateBusyInline}" IsVisible="{Binding IsSwapLoading}" IsRunning="{Binding IsSwapLoading}"
                                   />
                <VerticalStackLayout Grid.Row="1" Spacing="{StaticResource UiSpaceTight}">
                    <Label LineBreakMode="WordWrap" Text="{Binding SwapErrorText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasSwapError}" />
                    <Label LineBreakMode="WordWrap" Text="{Binding SwapEmptyTextKey, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource BodyLabel}" IsVisible="{Binding ShowNoSwapCandidates}" />
                </VerticalStackLayout>
                <CollectionView Grid.Row="2" ItemsSource="{Binding SwapCandidates}"
                                MaximumHeightRequest="{StaticResource ModalSheetBodyMaximumHeight}"
                                IsVisible="{Binding HasSwapCandidates}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ExerciseSwapOption">
                            <Border Style="{StaticResource CardSecondary}"
                                    Margin="{StaticResource UiInsets0_0_0_8}"
                                    SemanticProperties.Description="{Binding Name}">
                                <!-- Selected semantics come from the shared CardSecondary style. -->
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectSwapCandidateCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutSessionViewModel}}, x:DataType=vm:WorkoutSessionViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                                        <Label Text="{Binding Name}" Style="{StaticResource BodyStrong}" LineBreakMode="WordWrap" />
                                        <Label
                                            Text="{Binding MuscleMatch, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}"
                                            LineBreakMode="WordWrap" />
                                        <Label
                                            Text="{Binding PrimaryMuscles, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}"
                                            LineBreakMode="WordWrap" />
                                        <Label
                                            Text="{Binding Equipment, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}"
                                            LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Label LineBreakMode="WordWrap" Grid.Column="1" Text="{loc:LocalizedText Workout_Swap_SelectedBadge}"
                                           IsVisible="{Binding IsSelected}" Style="{StaticResource AccentLabel}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </Grid>
                <VerticalStackLayout Grid.Row="3" Spacing="{StaticResource UiSpaceMicro}"
                                     Padding="{DynamicResource PresentationActionFooterPadding}">
                    <Button Style="{StaticResource ButtonPrimary}" Text="{Binding SwapConfirmText, Converter={StaticResource LocalizedStringConverter}}"
                            Command="{Binding ConfirmSwapCommand}" IsVisible="{Binding HasSwapCandidates}" />
                    <Button Text="{loc:LocalizedText Workout_Swap_LeaveSessionButton}" Command="{Binding FinishSessionCommand}"
                            IsVisible="{Binding SwapNeedsReload}"
                            Style="{StaticResource ButtonSecondary}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
