<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
             xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Workout"
             xmlns:models="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
             x:Class="MuscleCuties.UI.Controls.Workout.WorkoutSwapPanel"
             x:Name="SwapRoot"
             x:DataType="vm:WorkoutSessionViewModel">
    <Grid BackgroundColor="{StaticResource ModalScrim}">
        <Grid BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseSwapPanelCommand}" />
            </Grid.GestureRecognizers>
        </Grid>
        <Border x:Name="SheetSurface" Style="{StaticResource AppBottomSheetSurface}"
                Padding="20,18,20,24">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14" IsEnabled="{Binding CanInteract}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:LocalizedText Workout_Swap_Title}" Style="{StaticResource SectionTitle}" />
                        <Label
                            Text="{Binding SwapTargetName, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Swap_ReplaceFormat}"
                            Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="{loc:LocalizedText Workout_Swap_CloseButton}"
                            Command="{Binding CloseSwapPanelCommand}" IsVisible="{Binding CanDismissSwap}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            MinimumHeightRequest="48" Padding="12,8" FontSize="14" />
                </Grid>
                <ActivityIndicator Grid.Row="1" IsVisible="{Binding IsSwapLoading}" IsRunning="{Binding IsSwapLoading}"
                                   Color="{StaticResource Primary}" />
                <VerticalStackLayout Grid.Row="2" Spacing="8">
                    <Label Text="{Binding SwapErrorText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasSwapError}" />
                    <Label Text="{loc:LocalizedText Workout_Swap_NoAlternativesAvailable}"
                           Style="{StaticResource BodyLabel}" IsVisible="{Binding ShowNoSwapCandidates}" />
                </VerticalStackLayout>
                <CollectionView Grid.Row="3" ItemsSource="{Binding SwapCandidates}"
                                IsVisible="{Binding HasSwapCandidates}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ExerciseSwapOption">
                            <Border StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                    Margin="0,0,0,8"
                                    Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                                    SemanticProperties.Description="{Binding Name}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="SemanticProperties.Hint"
                                                Value="Selected swap option, double-tap to confirm" />
                                        <Setter Property="Stroke"
                                                Value="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource AccentSurfaceDark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="SemanticProperties.Hint"
                                                Value="Not selected, double-tap to select" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectSwapCandidateCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutSessionViewModel}}, x:DataType=vm:WorkoutSessionViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Name}" Style="{StaticResource BodyLabel}"
                                               FontAttributes="Bold" />
                                        <Label
                                            Text="{Binding MuscleMatch, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}" />
                                        <Label
                                            Text="{Binding PrimaryMuscles, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Label
                                            Text="{Binding Equipment, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{loc:LocalizedText Workout_Swap_SelectedBadge}"
                                           IsVisible="{Binding IsSelected}" Style="{StaticResource AccentLabel}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <VerticalStackLayout Grid.Row="4" Spacing="4">
                    <Button Text="{Binding SwapConfirmText, Converter={StaticResource LocalizedStringConverter}}"
                            Command="{Binding ConfirmSwapCommand}" IsVisible="{Binding HasSwapCandidates}"
                            MinimumHeightRequest="52" />
                    <Button Text="{loc:LocalizedText Workout_Swap_LeaveSessionButton}" Command="{Binding FinishSessionCommand}"
                            IsVisible="{Binding SwapNeedsReload}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            MinimumHeightRequest="48" Padding="12,8" FontSize="14" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentView>
