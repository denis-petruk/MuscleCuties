<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Workout.FeaturedWorkoutCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:workoutControls="clr-namespace:MuscleCuties.UI.Controls.Workout"
    xmlns:workoutModels="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
    x:DataType="workoutControls:FeaturedWorkoutCard">


    <Border
        Style="{StaticResource CardPrimary}">
        <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">

            <!-- Header Row: Icon Tile, Title/Badge, and Status Pill -->
            <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                <!-- Icon Tile -->
                <Border
                    WidthRequest="{StaticResource UiDimension42}"
                    HeightRequest="{StaticResource UiDimension42}"
                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                    StrokeShape="{StaticResource UiRoundRectangleRadius12}"
                    VerticalOptions="Center">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsRestDay, Source={x:Reference Root}}" Value="True">
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource RestDaySurfaceLight}, Dark={StaticResource RestDaySurfaceDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsRestDay, Source={x:Reference Root}}" Value="False">
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource AccentSurfaceDark}}" />
                        </DataTrigger>
                    </Border.Triggers>

                    <Grid HorizontalOptions="Center" VerticalOptions="Center">
                        <!-- Rest Day: Soothing Crescent Moon -->
                        <Path
                            Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                            Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension18}"
                            HeightRequest="{StaticResource UiDimension18}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            IsVisible="{Binding IsRestDay, Source={x:Reference Root}}" />

                        <!-- Workout Day: Dumbbell Icon -->
                        <Path
                            Data="M6.5 6.5h11M6.5 17.5h11M6.5 6.5v11M17.5 6.5v11M3 9.5h3.5v5H3zM17.5 9.5H21v5h-3.5z"
                            Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}"
                            StrokeThickness="{StaticResource UiStrokeWidth1_8}"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension18}"
                            HeightRequest="{StaticResource UiDimension18}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            IsVisible="{Binding IsRestDay, Source={x:Reference Root}, Converter={StaticResource InvertedBoolConverter}}" />
                    </Grid>
                </Border>

                <!-- Titles: Badge + Main Name -->
                <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource UiSpacing2}" VerticalOptions="Center">
                    <Label
                        Text="{Binding BadgeText, Source={x:Reference Root}}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                        FontSize="{StaticResource UiFontSize13}"
                        FontAttributes="{StaticResource UiFontAttributesBold}"
                        VerticalOptions="Center" />
                    <Label
                        Text="{Binding WorkoutTitle, Source={x:Reference Root}}"
                        Style="{StaticResource SectionTitle}"
                        FontSize="{StaticResource UiFontSize18}"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Status Pill on the Right -->
                <Border
                    Grid.Column="2"
                    StrokeShape="{StaticResource UiRoundRectangleRadius999}"
                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                    Padding="{StaticResource UiInsets10_4}"
                    VerticalOptions="Center">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsRestDay, Source={x:Reference Root}}" Value="True">
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource RestStatusBadgeSurfaceLight}, Dark={StaticResource RestStatusBadgeSurfaceDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsRestDay, Source={x:Reference Root}}" Value="False">
                            <Setter Property="BackgroundColor"
                                    Value="{Binding AccentColor, Source={x:Reference Root}}" />
                        </DataTrigger>
                    </Border.Triggers>

                    <Label
                        FontSize="{StaticResource UiFontSize11}"
                        FontAttributes="{StaticResource UiFontAttributesBold}"
                        VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsRestDay, Source={x:Reference Root}}" Value="True">
                                <Setter Property="Text" Value="REST DAY" />
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsRestDay, Source={x:Reference Root}}" Value="False">
                                <Setter Property="Text" Value="{Binding PrimaryActivityTitle, Source={x:Reference Root}}" />
                                <Setter Property="TextColor"
                                        Value="{Binding AccentTextColor, Source={x:Reference Root}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </Grid>

            <!-- Multiple Activity Chips (if more than 1 activity on workout days) -->
            <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start"
                        IsVisible="{Binding HasMultipleActivities, Source={x:Reference Root}}">
                <Border
                    StrokeShape="{StaticResource UiRoundRectangleRadius999}"
                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                    Padding="{StaticResource UiInsets10_4}"
                    Margin="{StaticResource UiInsets0_0_6_6}"
                    BackgroundColor="{Binding PrimaryActivityBackground, Source={x:Reference Root}}">
                    <Label
                        Text="{Binding PrimaryActivityTitle, Source={x:Reference Root}}"
                        TextColor="{Binding PrimaryActivityTextColor, Source={x:Reference Root}}"
                        FontSize="{StaticResource UiFontSize12}"
                        FontAttributes="{StaticResource UiFontAttributesBold}" />
                </Border>
                <Border
                    StrokeShape="{StaticResource UiRoundRectangleRadius999}"
                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                    Padding="{StaticResource UiInsets10_4}"
                    Margin="{StaticResource UiInsets0_0_6_6}"
                    BackgroundColor="{Binding SecondaryActivityBackground, Source={x:Reference Root}}">
                    <Label
                        Text="{Binding SecondaryActivityTitle, Source={x:Reference Root}}"
                        TextColor="{Binding SecondaryActivityTextColor, Source={x:Reference Root}}"
                        FontSize="{StaticResource UiFontSize12}"
                        FontAttributes="{StaticResource UiFontAttributesBold}" />
                </Border>
            </FlexLayout>

            <!-- Subtitle -->
            <Label
                Text="{Binding Subtitle, Source={x:Reference Root}}"
                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                FontSize="{StaticResource UiFontSize14}"
                LineBreakMode="WordWrap" />

            <!-- Rest Day Recovery Guidance & Focus Pillars -->
            <Border
                IsVisible="{Binding IsRestDay, Source={x:Reference Root}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                StrokeThickness="{StaticResource UiStrokeWidth1}"
                StrokeShape="{StaticResource UiRoundRectangleRadius12}"
                Padding="{StaticResource UiInsets14_12}">
                <VerticalStackLayout Spacing="{StaticResource UiSpacing10}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpacing10}" VerticalOptions="Center">
                        <Path
                            Data="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4L2 9.4h7.6z"
                            Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension14}"
                            HeightRequest="{StaticResource UiDimension14}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="Muscles rebuild &amp; glycogen restores during rest. Take time to recharge, hydrate, and stretch."
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            FontSize="{StaticResource UiFontSize12}"
                            LineBreakMode="WordWrap"
                            VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource UiSpacing6}">
                        <Border
                            StrokeShape="{StaticResource UiRoundRectangleRadius999}"
                            StrokeThickness="{StaticResource UiStrokeWidth0}"
                            Padding="{StaticResource UiInsets10_4}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource RestDaySurfaceLight}, Dark={StaticResource RestDaySurfaceDark}}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpacing5}" VerticalOptions="Center">
                                <Path
                                    Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                                    Fill="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                                    Aspect="Uniform"
                                    WidthRequest="{StaticResource UiDimension11}"
                                    HeightRequest="{StaticResource UiDimension11}"
                                    VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="7-9h Sleep" FontSize="{StaticResource UiFontSize11}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="1"
                            StrokeShape="{StaticResource UiRoundRectangleRadius999}"
                            StrokeThickness="{StaticResource UiStrokeWidth0}"
                            Padding="{StaticResource UiInsets10_4}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource RecoverySurfaceLight}, Dark={StaticResource RecoverySurfaceDark}}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpacing5}" VerticalOptions="Center">
                                <Path
                                    Data="M12 2C10 5 5 10 5 14a7 7 0 0 0 14 0C19 10 14 5 12 2z"
                                    Fill="{AppThemeBinding Light={StaticResource RecoveryTextLight}, Dark={StaticResource RecoveryTextDark}}"
                                    Aspect="Uniform"
                                    WidthRequest="{StaticResource UiDimension11}"
                                    HeightRequest="{StaticResource UiDimension11}"
                                    VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Hydration" FontSize="{StaticResource UiFontSize11}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                       TextColor="{AppThemeBinding Light={StaticResource RecoveryTextLight}, Dark={StaticResource RecoveryTextDark}}"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Structured 3-column Visual Metric Tiles (Training Days) -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource UiSpaceTight}"
                  IsVisible="{Binding IsRestDay, Source={x:Reference Root}, Converter={StaticResource InvertedBoolConverter}}">
                <!-- Tile 1: Duration -->
                <Border
                    Style="{StaticResource CardAccent}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpacing3}" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                            <Path
                                Data="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 5v5l3.5 2"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="{StaticResource UiStrokeWidth1_5}"
                                Aspect="Uniform"
                                WidthRequest="{StaticResource UiDimension12}"
                                HeightRequest="{StaticResource UiDimension12}"
                                VerticalOptions="Center" />
                            <Label
                                Text="Duration"
                                Style="{StaticResource CaptionTinyStrong}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label
                            Text="{Binding DurationText, Source={x:Reference Root}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            FontSize="{StaticResource UiFontSize13}"
                            FontAttributes="{StaticResource UiFontAttributesBold}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Tile 2: Exercises -->
                <Border
                    Grid.Column="1"
                    Style="{StaticResource CardAccent}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpacing3}" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                            <Path
                                Data="M4 6h16M4 12h16M4 18h16"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="{StaticResource UiStrokeWidth1_5}"
                                Aspect="Uniform"
                                WidthRequest="{StaticResource UiDimension12}"
                                HeightRequest="{StaticResource UiDimension12}"
                                VerticalOptions="Center" />
                            <Label
                                Text="Exercises"
                                Style="{StaticResource CaptionTinyStrong}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label
                            Text="{Binding ExercisesCount, Source={x:Reference Root}, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Featured_ExercisesCountFormat}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            FontSize="{StaticResource UiFontSize13}"
                            FontAttributes="{StaticResource UiFontAttributesBold}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Tile 3: Intensity -->
                <Border
                    Grid.Column="2"
                    Style="{StaticResource CardAccent}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpacing3}" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                            <Path
                                Data="M13 2L3 14h9l-1 8 10-12h-9l1-8z"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="{StaticResource UiStrokeWidth1_5}"
                                Aspect="Uniform"
                                WidthRequest="{StaticResource UiDimension12}"
                                HeightRequest="{StaticResource UiDimension12}"
                                VerticalOptions="Center" />
                            <Label
                                Text="Intensity"
                                Style="{StaticResource CaptionTinyStrong}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label
                            Text="{Binding Intensity, Source={x:Reference Root}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            FontSize="{StaticResource UiFontSize13}"
                            FontAttributes="{StaticResource UiFontAttributesBold}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Expandable Exercise Preview Toggle -->
            <Border
                StrokeShape="{StaticResource UiRoundRectangleRadius8}"
                StrokeThickness="{StaticResource UiStrokeWidth1}"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource CardSurfaceDark}}"
                Padding="{StaticResource UiInsets12_8}"
                Margin="{StaticResource UiInsets0_2_0_2}"
                MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                IsVisible="{Binding HasExercisePreviews, Source={x:Reference Root}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TogglePreviewCommand, Source={x:Reference Root}}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="{StaticResource UiSpacing6}" VerticalOptions="Center">
                        <Label Text="{loc:LocalizedText Workout_Featured_PreviewTitle}" FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding ExercisePreviewsCountText, Source={x:Reference Root}}" FontSize="{StaticResource UiFontSize12}"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1" Text="{Binding PreviewChevron, Source={x:Reference Root}}"
                           FontSize="{StaticResource UiFontSize12}" FontAttributes="{StaticResource UiFontAttributesBold}"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Expandable Exercise Preview Items List (Flattened Grid) -->
            <Grid
                RowSpacing="{StaticResource UiSpaceTight}"
                Margin="{StaticResource UiInsets0_2_0_4}"
                IsVisible="{Binding IsPreviewExpanded, Source={x:Reference Root}}"
                BindableLayout.ItemsSource="{Binding ExercisePreviews, Source={x:Reference Root}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="workoutModels:ExercisePreviewItem">
                        <Border
                            StrokeShape="{StaticResource UiRoundRectangleRadius10}"
                            StrokeThickness="{StaticResource UiStrokeWidth1}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            Padding="{StaticResource UiInsets12_10}">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpaceMicro}">
                                <!-- Exercise Name + Sets/Reps Badge -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" FontSize="{StaticResource UiFontSize14}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           LineBreakMode="WordWrap"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="1" StrokeShape="{StaticResource UiRoundRectangleRadius6}" StrokeThickness="{StaticResource UiStrokeWidth0}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray800}}"
                                            Padding="{StaticResource UiInsets8_2}">
                                        <Label
                                            Text="{Binding SetsReps, Converter={StaticResource LocalizedStringConverter}}"
                                            FontSize="{StaticResource UiFontSize12}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                            TextColor="{StaticResource PrimaryDark}" />
                                    </Border>
                                </Grid>

                                <!-- Target Muscle Groups -->
                                <Label Grid.Row="1"
                                       Text="{Binding MuscleGroups, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Featured_TargetFormat}"
                                       FontSize="{StaticResource UiFontSize12}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       LineBreakMode="WordWrap" />

                                <!-- Tempo Guidance -->
                                <HorizontalStackLayout Grid.Row="2" Spacing="{StaticResource UiSpacing6}"
                                                       IsVisible="{Binding Tempo, Converter={StaticResource StringToBoolConverter}}">
                                    <Label Text="{loc:LocalizedText Workout_Featured_TempoLabel}" FontSize="{StaticResource UiFontSize11}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{StaticResource PrimaryDark}" />
                                    <Label Text="{Binding Tempo, Converter={StaticResource LocalizedStringConverter}}"
                                           FontSize="{StaticResource UiFontSize11}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </HorizontalStackLayout>

                                <!-- Movement Notes -->
                                <Label Grid.Row="3" Text="{Binding MovementNotes}" FontSize="{StaticResource UiFontSize11}"
                                       FontAttributes="{StaticResource UiFontAttributesItalic}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       LineBreakMode="WordWrap"
                                       IsVisible="{Binding MovementNotes, Converter={StaticResource StringToBoolConverter}}" />

                                <!-- Warm-up notes -->
                                <Border
                                    Grid.Row="4"
                                    StrokeShape="{StaticResource UiRoundRectangleRadius6}"
                                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurfaceLight}, Dark={StaticResource WarningSurfaceDark}}"
                                    Padding="{StaticResource UiInsets8_4}"
                                    Margin="{StaticResource UiInsets0_2_0_0}"
                                    IsVisible="{Binding WarmUpNote, Converter={StaticResource StringToBoolConverter}}">
                                    <Label
                                        Text="{Binding WarmUpNote, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Featured_WarmupFormat}"
                                        FontSize="{StaticResource UiFontSize11}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        LineBreakMode="WordWrap" />
                                </Border>

                                <!-- Unavailable Guidance Honest State -->
                                <Border
                                    Grid.Row="5"
                                    StrokeShape="{StaticResource UiRoundRectangleRadius6}"
                                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource CardSurfaceDark}}"
                                    Padding="{StaticResource UiInsets8_4}"
                                    Margin="{StaticResource UiInsets0_2_0_0}"
                                    IsVisible="{Binding UnavailableGuidanceText, Converter={StaticResource StringToBoolConverter}}">
                                    <Label
                                        Text="{Binding UnavailableGuidanceText, Converter={StaticResource LocalizedStringConverter}}"
                                        FontSize="{StaticResource UiFontSize11}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        LineBreakMode="WordWrap" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </Grid>

            <Button Style="{StaticResource ButtonPrimary}"
                    Text="{Binding ActionText, Source={x:Reference Root}}"
                    ImageSource="{Binding ActionIcon, Source={x:Reference Root}}"
                    ContentLayout="Left,8"
                    Command="{Binding StartCommand, Source={x:Reference Root}}"
                    IsVisible="{Binding IsActionVisible, Source={x:Reference Root}}" />

        </VerticalStackLayout>
    </Border>
</ContentView>
