<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Workout.WorkoutActivityCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:workoutControls="clr-namespace:MuscleCuties.UI.Controls.Workout"
    xmlns:workoutModels="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    x:DataType="workoutModels:WorkoutItem">

    <Border
        Style="{StaticResource CardPrimary}"
        Padding="{StaticResource UiInsets14}"
        Margin="{StaticResource UiInsets0_0_0_10}"
        SemanticProperties.Description="{Binding Title, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Activity_OpenWorkoutFormat}"
        SemanticProperties.Hint="{Binding SessionProgressText, Converter={StaticResource LocalizedStringConverter}}">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                <Setter Property="Stroke" Value="{Binding ActivityTextColor}" />
                <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth1_5}" />
            </DataTrigger>
        </Border.Triggers>
        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding OpenCommand, Source={x:Reference Root}, x:DataType=workoutControls:WorkoutActivityCard}"
                CommandParameter="{Binding CommandParameter, Source={x:Reference Root}, x:DataType=workoutControls:WorkoutActivityCard}" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" RowSpacing="{StaticResource UiSpacing6}">

            <Border
                Grid.Column="0"
                WidthRequest="{StaticResource UiDimension44}"
                HeightRequest="{StaticResource UiDimension44}"
                StrokeShape="{StaticResource UiRoundRectangleRadius12}"
                BackgroundColor="{Binding ActivityBackground}"
                StrokeThickness="{StaticResource UiStrokeWidth0}"
                VerticalOptions="Center">
                <Label
                    Text="{Binding DayLabel, Converter={StaticResource LocalizedStringConverter}}"
                    TextColor="{Binding ActivityTextColor}"
                    FontSize="{StaticResource UiFontSize14}"
                    FontAttributes="{StaticResource UiFontAttributesBold}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    SemanticProperties.Description="{Binding DayLabel, Converter={StaticResource LocalizedStringConverter}}" />
            </Border>

            <Label
                Grid.Column="1"
                Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                Style="{StaticResource CardTitle}"
                FontSize="{StaticResource UiFontSize16}"
                LineBreakMode="WordWrap"
                VerticalOptions="Center" />

            <Border
                Grid.Column="2"
                StrokeThickness="{StaticResource UiStrokeWidth0}"
                StrokeShape="{StaticResource UiRoundRectangleRadius999}"
                Padding="{StaticResource UiInsets10_6}"
                VerticalOptions="Center">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource ActionSurfaceDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="False">
                        <Setter Property="BackgroundColor" Value="{Binding ActivityBackground}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label
                    Text="{Binding SessionProgressText, Converter={StaticResource LocalizedStringConverter}}"
                    FontSize="{StaticResource UiFontSize14}"
                    FontAttributes="{StaticResource UiFontAttributesBold}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource TextPrimary}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="False">
                            <Setter Property="TextColor" Value="{Binding ActivityTextColor}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>

            <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                    Text="{Binding OptionalStatusText, Converter={StaticResource LocalizedStringConverter}}"
                    Command="{Binding ToggleOptionalCommand, Source={x:Reference Root}, x:DataType=workoutControls:WorkoutActivityCard}"
                    CommandParameter="{Binding CommandParameter, Source={x:Reference Root}, x:DataType=workoutControls:WorkoutActivityCard}"
                    IsEnabled="{Binding CanMarkOptional}"
                    IsVisible="{Binding CanMarkOptional}"
                    Style="{StaticResource ButtonSecondary}"
                    FontSize="{StaticResource UiFontSize13}"
                    HorizontalOptions="Start" Padding="{StaticResource UiInsets10_2}" MinimumHeightRequest="{StaticResource UiDimension32}" HeightRequest="{StaticResource UiDimension32}"
                    SemanticProperties.Hint="{loc:LocalizedText Workout_Readiness_OptionalSessionHint}" />
            <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                    Text="{Binding EasierAlternativeStatusText, Converter={StaticResource LocalizedStringConverter}}"
                    Command="{Binding ToggleEasierAlternativeCommand, Source={x:Reference Root}, x:DataType=workoutControls:WorkoutActivityCard}"
                    CommandParameter="{Binding CommandParameter, Source={x:Reference Root}, x:DataType=workoutControls:WorkoutActivityCard}"
                    IsEnabled="{Binding CanMarkEasierAlternative}"
                    IsVisible="{Binding IsOptional}"
                    Style="{StaticResource ButtonSecondary}"
                    FontSize="{StaticResource UiFontSize13}"
                    HorizontalOptions="Start" Padding="{StaticResource UiInsets10_2}" MinimumHeightRequest="{StaticResource UiDimension32}" HeightRequest="{StaticResource UiDimension32}"
                    SemanticProperties.Hint="{loc:LocalizedText Workout_Readiness_EasierAlternativeHint}" />
        </Grid>
    </Border>
</ContentView>
