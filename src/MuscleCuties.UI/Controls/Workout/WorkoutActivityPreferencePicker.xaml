<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Workout.WorkoutActivityPreferencePicker"
    x:Name="PreferencePickerRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:controls="clr-namespace:MuscleCuties.UI.Controls.Workout"
    xmlns:workoutModels="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
    x:DataType="controls:WorkoutActivityPreferencePicker">

    <VerticalStackLayout
        Spacing="{StaticResource UiSpaceContent}"
        BindableLayout.ItemsSource="{Binding ActivityGroups, Source={x:Reference PreferencePickerRoot}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="workoutModels:WorkoutActivityGroupSection">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceCompact}">
                    <Grid Grid.Row="0" ColumnDefinitions="24,*" ColumnSpacing="{StaticResource UiSpaceTight}" Margin="{StaticResource UiInsets2_4_2_0}">
                        <Image
                            Source="{Binding GroupIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                            WidthRequest="{StaticResource UiDimension20}"
                            HeightRequest="{StaticResource UiDimension20}"
                            Aspect="AspectFit"
                            VerticalOptions="Center"
                            InputTransparent="True" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding GroupTitle, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource FormFieldLabel}"
                            FontSize="{StaticResource UiFontSize16}"
                            VerticalOptions="Center"
                            SemanticProperties.HeadingLevel="Level3" />
                    </Grid>

                    <VerticalStackLayout
                        Grid.Row="1"
                        Spacing="{StaticResource UiSpacing10}"
                        BindableLayout.ItemsSource="{Binding Items}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="workoutModels:WorkoutActivityOptionItem">
                                <VerticalStackLayout Spacing="{StaticResource UiSpacing6}">
                                <Border
                                    Style="{StaticResource SelectableCard}"
                                    MinimumHeightRequest="{StaticResource UiDimension62}"
                                    HorizontalOptions="Fill"
                                    Margin="{StaticResource UiInsets0}"
                                    SemanticProperties.Description="{Binding Title, Converter={StaticResource LocalizedStringConverter}}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="SemanticProperties.Hint"
                                                    Value="{loc:LocalizedText Workout_ActivityPreference_SelectedHint}" />
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource ActivitySelectedSurfaceLight}, Dark={StaticResource CardSurfaceDark}}" />
                                            <Setter Property="Stroke"
                                                    Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
                                            <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth1_5}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="SemanticProperties.Hint"
                                                    Value="{loc:LocalizedText Workout_ActivityPreference_UnselectedHint}" />
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}" />
                                            <Setter Property="Stroke"
                                                    Value="{AppThemeBinding Light={StaticResource ActivityUnselectedStrokeLight}, Dark={StaticResource Gray800}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PreferencePickerRoot}, Path=ToggleActivityCommand, x:DataType=controls:WorkoutActivityPreferencePicker}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="40,*,24" ColumnSpacing="{StaticResource UiSpaceCompact}">
                                        <Border
                                            Grid.Column="0"
                                            WidthRequest="{StaticResource UiDimension40}"
                                            HeightRequest="{StaticResource UiDimension40}"
                                            StrokeThickness="{StaticResource UiStrokeWidth0}"
                                            StrokeShape="{StaticResource UiRoundRectangleRadius12}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource InputSurfaceDark}}"
                                            VerticalOptions="Center"
                                            InputTransparent="True">
                                            <Image
                                                Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                                WidthRequest="{StaticResource UiDimension22}"
                                                HeightRequest="{StaticResource UiDimension22}"
                                                Aspect="AspectFit"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing3}"
                                              VerticalOptions="Center">
                                            <Label
                                                Grid.Row="0"
                                                Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                                Style="{StaticResource BodyLabel}"
                                                FontAttributes="{StaticResource UiFontAttributesBold}"
                                                LineBreakMode="WordWrap" />

                                            <Label
                                                Grid.Row="1"
                                                Text="{Binding Subtitle, Converter={StaticResource LocalizedStringConverter}}"
                                                Style="{StaticResource MutedLabel}"
                                                FontSize="{StaticResource UiFontSize14}"
                                                TextColor="{AppThemeBinding Light={StaticResource DeepMauve}, Dark={StaticResource ActivityDescriptionDark}}"
                                                LineBreakMode="WordWrap">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="TextColor"
                                                                Value="{AppThemeBinding Light={StaticResource ActivitySelectedSubtitleLight}, Dark={StaticResource ActivityDescriptionDark}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>

                                        <Border
                                            Grid.Column="2"
                                            WidthRequest="{StaticResource UiDimension24}" HeightRequest="{StaticResource UiDimension24}"
                                            StrokeShape="{StaticResource UiEllipseShape}"
                                            StrokeThickness="{StaticResource UiStrokeWidth1_5}"
                                            VerticalOptions="Center"
                                            BackgroundColor="{StaticResource Transparent}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor"
                                                            Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
                                                    <Setter Property="Stroke"
                                                            Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}"
                                                             Value="False">
                                                    <Setter Property="Stroke"
                                                            Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray500}}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Path Data="M5 12L10 17L19 7" Stroke="{StaticResource White}" StrokeThickness="{StaticResource UiStrokeWidth2_5}"
                                                  StrokeLineCap="Round" StrokeLineJoin="Round"
                                                  WidthRequest="{StaticResource UiDimension16}" HeightRequest="{StaticResource UiDimension16}" Aspect="Uniform"
                                                  HorizontalOptions="Center" VerticalOptions="Center"
                                                  IsVisible="{Binding IsSelected}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border
                                    Style="{StaticResource PickerContainer}"
                                    IsVisible="{Binding ShowSessionDurationPicker}"
                                    Margin="{StaticResource UiInsets2_0}">
                                    <Picker
                                        ItemsSource="{Binding SessionDurationOptions}"
                                        SelectedItem="{Binding SessionDurationMinutes, Mode=TwoWay}"
                                        ItemDisplayBinding="{Binding ., Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Generation_MixedSessionDurationFormat}"
                                        Title="{loc:LocalizedText Profile_WorkoutPrefs_SessionLength}"
                                        VerticalOptions="Center"
                                        SemanticProperties.Description="{loc:LocalizedText Profile_WorkoutPrefs_SessionLength}" />
                                </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
