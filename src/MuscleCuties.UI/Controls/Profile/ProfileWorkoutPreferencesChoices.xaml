<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Profile.ProfileWorkoutPreferencesChoices"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:commonModels="clr-namespace:MuscleCuties.UI.Models.UI.Common"
    xmlns:workoutModels="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Profile"
    xmlns:workoutControls="clr-namespace:MuscleCuties.UI.Controls.Workout"
    x:DataType="vm:ProfileWorkoutPreferencesViewModel">


    <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">
        <VerticalStackLayout Spacing="{StaticResource UiSpacing5}">
            <Label Text="{loc:LocalizedText Profile_WorkoutPrefs_AvailableEquipment}"
                   Style="{StaticResource FormFieldLabel}" />
            <Border Style="{StaticResource PickerContainer}">
                <Picker
                    Title="{loc:LocalizedText Profile_WorkoutPrefs_ChooseEquipment}"
                    ItemsSource="{Binding EquipmentOptions}"
                    ItemDisplayBinding="{Binding Label, Converter={StaticResource LocalizedStringConverter}, x:DataType=commonModels:ILabeledOption}"
                    SelectedItem="{Binding SelectedEquipmentOption, Mode=TwoWay}" />
            </Border>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="{StaticResource UiSpacing5}">
            <Label Text="{loc:LocalizedText Profile_WorkoutPrefs_SessionLength}"
                   Style="{StaticResource FormFieldLabel}" />
            <Border Style="{StaticResource PickerContainer}">
                <Picker
                    Title="{loc:LocalizedText Profile_WorkoutPrefs_SessionLength}"
                    ItemsSource="{Binding SessionDurationOptions}"
                    ItemDisplayBinding="{Binding ., Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Workout_Generation_MixedSessionDurationFormat}"
                    SelectedItem="{Binding SelectedSessionDurationMinutes, Mode=TwoWay}" />
            </Border>
        </VerticalStackLayout>

         <workoutControls:WorkoutActivityPreferencePicker
             ActivityGroups="{Binding GroupedWorkoutActivityOptions}"
             ToggleActivityCommand="{Binding ToggleWorkoutActivityCommand}" />

         <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}">
             <Label Text="{loc:LocalizedText Profile_WorkoutPrefs_ExerciseExclusions}"
                    Style="{StaticResource SectionTitle}"
                    SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource InputContainer}"
                    HeightRequest="{StaticResource UiDimension44}"
                    MinimumHeightRequest="{StaticResource UiDimension44}">
                <Entry Placeholder="{loc:LocalizedText Profile_WorkoutPrefs_SearchExercises}"
                       Text="{Binding ExerciseExclusionSearchText, Mode=TwoWay}"
                       ReturnType="Search" VerticalOptions="Center" />
            </Border>
            <FlexLayout BindableLayout.ItemsSource="{Binding SelectedExerciseExclusions}"
                        Wrap="Wrap" JustifyContent="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="workoutModels:WorkoutExerciseExclusionOptionItem">
                        <Border Style="{StaticResource SelectableChip}" Margin="{StaticResource UiInsets0_0_8_8}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource ActivitySelectedSurfaceLight}, Dark={StaticResource CardSurfaceDark}}"
                                Stroke="{StaticResource Primary}"
                                SemanticProperties.Description="{Binding Name}"
                                SemanticProperties.Hint="{loc:LocalizedText Profile_WorkoutPrefs_RemoveAvoidedExercise}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="{StaticResource UiSpaceTight}">
                                <Label Text="{Binding Name}" Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                                <Path Data="M6 6L18 18M18 6L6 18" Stroke="{StaticResource Primary}"
                                      StrokeThickness="{StaticResource UiStrokeWidth2}"
                                      WidthRequest="{StaticResource UiDimension14}"
                                      HeightRequest="{StaticResource UiDimension14}"
                                      VerticalOptions="Center" InputTransparent="True" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
            <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}" IsVisible="{Binding HasExerciseExclusionQuery}"
                                 BindableLayout.ItemsSource="{Binding FilteredExerciseExclusionOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="workoutModels:WorkoutExerciseExclusionOptionItem">
                        <Border
                            Style="{StaticResource SelectableCard}"
                            Padding="{StaticResource UiInsets14_12}"
                            SemanticProperties.Description="{Binding Name}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource ActivitySelectedSurfaceLight}, Dark={StaticResource CardSurfaceDark}}" />
                                    <Setter Property="Stroke"
                                            Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
                                    <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth1_5}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}" />
                                    <Setter Property="Stroke"
                                            Value="{AppThemeBinding Light={StaticResource ActivityUnselectedStrokeLight}, Dark={StaticResource Gray800}}" />
                                    <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth1}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                <Label
                                    Text="{Binding Name}"
                                    Style="{StaticResource BodyLabel}"
                                    FontAttributes="{StaticResource UiFontAttributesBold}"
                                    VerticalOptions="Center" />
                                <Path Grid.Column="1" Data="M12 5V19M5 12H19"
                                      Stroke="{StaticResource Primary}"
                                      StrokeThickness="{StaticResource UiStrokeWidth2}"
                                      WidthRequest="{StaticResource UiDimension18}"
                                      HeightRequest="{StaticResource UiDimension18}" VerticalOptions="Center"
                                      InputTransparent="True" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
