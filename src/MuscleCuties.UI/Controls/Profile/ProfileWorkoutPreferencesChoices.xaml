<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Profile.ProfileWorkoutPreferencesChoices"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:commonModels="clr-namespace:MuscleCuties.UI.Models.UI.Common"
    xmlns:workoutModels="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Profile"
    xmlns:workoutControls="clr-namespace:MuscleCuties.UI.Controls.Workout"
    x:DataType="vm:ProfileWorkoutPreferencesViewModel">

    <VerticalStackLayout Spacing="16">
        <VerticalStackLayout Spacing="5">
            <Label Text="{loc:LocalizedText Profile_WorkoutPrefs_AvailableEquipment}"
                   Style="{StaticResource FormFieldLabel}" />
            <Border Style="{StaticResource InputContainer}">
                <Picker
                    Title="{loc:LocalizedText Profile_WorkoutPrefs_ChooseEquipment}"
                    ItemsSource="{Binding EquipmentOptions}"
                    ItemDisplayBinding="{Binding Label, Converter={StaticResource LocalizedStringConverter}, x:DataType=commonModels:ILabeledOption}"
                    SelectedItem="{Binding SelectedEquipmentOption, Mode=TwoWay}" />
            </Border>
        </VerticalStackLayout>

        <Label Text="{loc:LocalizedText Profile_WorkoutPrefs_ActivitySessionLengthHint}"
               Style="{StaticResource MutedLabel}"
               LineBreakMode="WordWrap" />

        <workoutControls:WorkoutActivityPreferencePicker
            ActivityGroups="{Binding GroupedWorkoutActivityOptions}"
            ToggleActivityCommand="{Binding ToggleWorkoutActivityCommand}" />

        <VerticalStackLayout Spacing="8">
            <Label Text="{loc:LocalizedText Profile_WorkoutPrefs_ExerciseExclusions}"
                   Style="{StaticResource SectionTitle}"
                   SemanticProperties.HeadingLevel="Level2" />
            <Label Text="{loc:LocalizedText Profile_WorkoutPrefs_ExerciseExclusionsHint}"
                   Style="{StaticResource MutedLabel}"
                   LineBreakMode="WordWrap" />
            <Border Style="{StaticResource InputContainer}">
                <SearchBar Placeholder="{loc:LocalizedText Profile_WorkoutPrefs_SearchExercises}"
                           Text="{Binding ExerciseExclusionSearchText, Mode=TwoWay}" />
            </Border>
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding FilteredExerciseExclusionOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="workoutModels:WorkoutExerciseExclusionOptionItem">
                        <Border
                            Style="{StaticResource SelectableCard}"
                            Padding="14,12"
                            SemanticProperties.Description="{Binding Name}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource ActivitySelectedSurfaceLight}, Dark={StaticResource CardSurfaceDark}}" />
                                    <Setter Property="Stroke"
                                            Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}" />
                                    <Setter Property="Stroke"
                                            Value="{AppThemeBinding Light={StaticResource ActivityUnselectedStrokeLight}, Dark={StaticResource Gray800}}" />
                                    <Setter Property="StrokeThickness" Value="1" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*,24" ColumnSpacing="12" VerticalOptions="Center">
                                <Label
                                    Text="{Binding Name}"
                                    Style="{StaticResource BodyLabel}"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />
                                <Border
                                    Grid.Column="1"
                                    WidthRequest="24" HeightRequest="24"
                                    StrokeShape="Ellipse"
                                    StrokeThickness="1.5"
                                    VerticalOptions="Center"
                                    BackgroundColor="Transparent"
                                    InputTransparent="True">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
                                            <Setter Property="Stroke"
                                                    Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="Stroke"
                                                    Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray500}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Path
                                        Data="M5 12L10 17L19 7"
                                        Stroke="White"
                                        StrokeThickness="2.5"
                                        StrokeLineCap="Round"
                                        StrokeLineJoin="Round"
                                        WidthRequest="16"
                                        HeightRequest="16"
                                        Aspect="Uniform"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding IsSelected}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
