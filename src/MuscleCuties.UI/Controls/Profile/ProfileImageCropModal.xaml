<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Profile.ProfileImageCropModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:local="clr-namespace:MuscleCuties.UI.Controls.Profile"
    x:DataType="local:ProfileImageCropModal"
    IsVisible="False">

    <Grid BackgroundColor="{StaticResource ModalScrim}">
        <Border
            x:Name="SheetSurface"
            Style="{StaticResource AppBottomSheetSurface}"
            Padding="{StaticResource UiInsets0}"
            HorizontalOptions="Fill">

            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource UiSpacing0}">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}" Padding="{StaticResource UiInsets16_12}">
                    <Label
                        Text="{loc:LocalizedText Profile_ImageCrop_CropPhoto}"
                        Style="{StaticResource ModalTitle}"
                        VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource ModalIconButton}"
                        SemanticProperties.Description="{loc:LocalizedText Profile_ImageCrop_CancelCrop}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelTapped" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>

                <BoxView Grid.Row="1" Style="{StaticResource ModalDivider}" Margin="{StaticResource UiInsets20_0}" />

                <ScrollView
                    Grid.Row="2"
                    Orientation="Vertical">
                    <VerticalStackLayout Padding="{StaticResource UiInsets20_16_20_0}" Spacing="{StaticResource UiSpacing10}">
                        <Border
                            x:Name="CropViewport"
                            WidthRequest="{StaticResource UiDimension260}"
                            HeightRequest="{StaticResource UiDimension260}"
                            StrokeShape="{StaticResource UiRoundRectangleRadius130}"
                            StrokeThickness="{StaticResource UiStrokeWidth0}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                            HorizontalOptions="Center">
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                                    <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                                </Grid.GestureRecognizers>
                                <Image
                                    x:Name="CropImage"
                                    Aspect="AspectFill"
                                    WidthRequest="{StaticResource UiDimension260}"
                                    HeightRequest="{StaticResource UiDimension260}" />
                            </Grid>
                        </Border>

                        <Label
                            Text="{loc:LocalizedText Profile_ImageCrop_PinchToZoomLabel}"
                            Style="{StaticResource CaptionLabel}"
                            HorizontalTextAlignment="Center"
                            SemanticProperties.Description="{loc:LocalizedText Profile_ImageCrop_PinchToZoomDescription}" />
                    </VerticalStackLayout>
                </ScrollView>

                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource UiSpaceCompact}" Padding="{StaticResource UiInsets20_16_20_20}">
                    <Button
                        Grid.Column="0"
                        Style="{StaticResource ButtonSecondary}"
                        Text="{loc:LocalizedText Common_Cancel}"
                        Clicked="OnCancelTapped" />
                    <Button
                        Grid.Column="1"
                        Text="{loc:LocalizedText Profile_ImageCrop_UsePhoto}"
                        Clicked="OnUsePhotoTapped" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</ContentView>
