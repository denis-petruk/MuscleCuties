<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Profile.ProfileImageCropModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:local="clr-namespace:MuscleCuties.UI.Controls.Profile"
    x:DataType="local:ProfileImageCropModal"
    IsVisible="False">

    <Grid BackgroundColor="{StaticResource ModalScrim}">
        <Border
            x:Name="SheetSurface"
            Style="{StaticResource AppBottomSheetSurface}"
            Padding="0"
            HorizontalOptions="Fill">

            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,12">
                    <Label
                        Text="{loc:LocalizedText Profile_ImageCrop_CropPhoto}"
                        Style="{StaticResource ModalTitle}"
                        VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource ModalIconButton}"
                        SemanticProperties.Description="{loc:LocalizedText Profile_ImageCrop_CancelCrop}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelTapped" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>

                <BoxView Grid.Row="1" Style="{StaticResource ModalDivider}" Margin="20,0" />

                <ScrollView
                    Grid.Row="2"
                    Orientation="Vertical">
                    <VerticalStackLayout Padding="20,16,20,0" Spacing="10">
                        <Border
                            x:Name="CropViewport"
                            WidthRequest="260"
                            HeightRequest="260"
                            StrokeShape="RoundRectangle 130"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                            HorizontalOptions="Center">
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                                    <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                                </Grid.GestureRecognizers>
                                <Image
                                    x:Name="CropImage"
                                    Aspect="AspectFill"
                                    WidthRequest="260"
                                    HeightRequest="260" />
                            </Grid>
                        </Border>

                        <Label
                            Text="{loc:LocalizedText Profile_ImageCrop_PinchToZoomLabel}"
                            Style="{StaticResource CaptionLabel}"
                            HorizontalTextAlignment="Center"
                            SemanticProperties.Description="{loc:LocalizedText Profile_ImageCrop_PinchToZoomDescription}" />
                    </VerticalStackLayout>
                </ScrollView>

                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="20,16,20,20">
                    <Button
                        Grid.Column="0"
                        Text="{loc:LocalizedText Common_Cancel}"
                        Clicked="OnCancelTapped"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        MinimumHeightRequest="52"
                        CornerRadius="18" />
                    <Button
                        Grid.Column="1"
                        Text="{loc:LocalizedText Profile_ImageCrop_UsePhoto}"
                        Clicked="OnUsePhotoTapped"
                        MinimumHeightRequest="52"
                        CornerRadius="18" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</ContentView>
