<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Profile.ProfileImageCropModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:local="clr-namespace:MuscleCuties.UI.Controls.Profile"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    x:DataType="local:ProfileImageCropModal">

    <Grid BackgroundColor="{StaticResource ModalScrim}">
        <Border
            x:Name="SheetSurface"
            Style="{StaticResource ModalSurface}" MaximumHeightRequest="{StaticResource ModalSheetMaximumHeight}"
            HorizontalOptions="Fill" VerticalOptions="End">

            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource UiSpacing0}">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}" Padding="{DynamicResource PresentationModalHeaderPadding}">
                    <Label
                        Text="{loc:LocalizedText Profile_ImageCrop_CropPhoto}"
                        Style="{StaticResource ModalTitle}"
                        VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource ModalIconButton}"
                        SemanticProperties.Description="{loc:LocalizedText Profile_ImageCrop_CancelCrop}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelTapped" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>

                <BoxView Grid.Row="1" Style="{StaticResource ModalDivider}" />

                <ScrollView
                    Grid.Row="2"
                    Orientation="Vertical">
                    <VerticalStackLayout Padding="{DynamicResource PresentationModalPagePadding}" Spacing="{StaticResource UiSpacing10}">
                        <Border
                            x:Name="CropViewport"
                            WidthRequest="{StaticResource UiDimension260}"
                            HeightRequest="{StaticResource UiDimension260}"
                            StrokeShape="{StaticResource UiRoundRectangleRadius130}"
                            StrokeThickness="{StaticResource UiStrokeWidth0}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSunkenDark}}"
                            HorizontalOptions="Center">
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                                    <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                                </Grid.GestureRecognizers>
                                <Image
                                    x:Name="CropImage"
                                    Aspect="AspectFill"
                                    WidthRequest="{StaticResource UiDimension260}"
                                    HeightRequest="{StaticResource UiDimension260}" />
                            </Grid>
                        </Border>

                        <Label
                            Text="{loc:LocalizedText Profile_ImageCrop_PinchToZoomLabel}"
                            Style="{StaticResource CaptionCentered}"
                            LineBreakMode="WordWrap"
                            SemanticProperties.Description="{loc:LocalizedText Profile_ImageCrop_PinchToZoomDescription}" />
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Two buttons share the footer at the standard sizes and stack at accessibility sizes,
                     where "Использовать фото" no longer fits half the sheet. -->
                <sharedControls:AdaptiveRow Grid.Row="3" Columns="2"
                                            ColumnSpacing="{StaticResource UiSpaceCompact}"
                                            RowSpacing="{StaticResource UiSpaceCompact}"
                                            Padding="{DynamicResource PresentationActionFooterPadding}">
                    <Button
                        Style="{StaticResource ButtonSecondary}"
                        Text="{loc:LocalizedText Common_Cancel}"
                        Clicked="OnCancelTapped" />
                    <Button
                        Style="{StaticResource ButtonPrimary}"
                        Text="{loc:LocalizedText Profile_ImageCrop_UsePhoto}"
                        Clicked="OnUsePhotoTapped" />
                </sharedControls:AdaptiveRow>

            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
