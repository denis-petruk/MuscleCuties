<?xml version="1.0" encoding="utf-8"?>
<ContentView
    x:Class="MuscleCuties.UI.Controls.Profile.ProfileDetailsContent"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Profile"
    x:DataType="vm:ProfileViewModel">
    <VerticalStackLayout Spacing="{StaticResource UiSpacing0}">
                <!-- Private Photo Journey Vault Entry -->
                <Label Text="{loc:LocalizedText Profile_Details_PrivateVault}" Style="{StaticResource CaptionLabel}"
                       FontAttributes="{StaticResource UiFontAttributesBold}" Margin="{StaticResource UiInsets24_16_24_6}" />
                <Border
                    Style="{StaticResource CardPrimary}"
                    Margin="{StaticResource UiInsets20_0_20_16}"
                    Padding="{StaticResource UiInsets16}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenVaultCommand}" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceCompact}">
                        <!-- Top Row: Icon + Title + Count Pill -->
                        <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                            <mi:MauiIcon
                                Icon="{mi:Fluent CameraAdd24}" IconSize="{StaticResource UiDimension22}"
                                IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                WidthRequest="{StaticResource UiDimension22}"
                                HeightRequest="{StaticResource UiDimension22}"
                                VerticalOptions="Center" />
                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}" VerticalOptions="Center">
                                <Label Text="{loc:LocalizedText Profile_PhotoJourney_Title}" FontSize="{StaticResource UiFontSize15}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Grid.Row="1" Text="{loc:LocalizedText Profile_Details_StoredLocallyOnThisDevice}"
                                       Style="{StaticResource CaptionLabel}" FontSize="{StaticResource UiFontSize12}" />
                            </Grid>
                            <Border
                                Grid.Column="2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                StrokeThickness="{StaticResource UiStrokeWidth0}"
                                StrokeShape="{StaticResource UiRoundRectangleRadius8}"
                                Padding="{StaticResource UiInsets8_4}">
                                <Label
                                    Text="{Binding VaultPhotoCountText, Converter={StaticResource LocalizedStringConverter}}"
                                    FontSize="{StaticResource UiFontSize12}" FontAttributes="{StaticResource UiFontAttributesBold}" />
                            </Border>
                        </Grid>

                        <!-- Tap-to-Reveal Privacy Blur Preview Box -->
                        <Border
                            Grid.Row="1"
                            HeightRequest="{StaticResource UiDimension110}"
                            StrokeShape="{StaticResource UiRoundRectangleRadius14}"
                            StrokeThickness="{StaticResource UiStrokeWidth0}"
                            Stroke="{StaticResource Transparent}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputSurface}, Dark={StaticResource InputSurfaceDark}}">
                            <Grid>
                                <!-- Revealed State -->
                                <Grid IsVisible="{Binding IsVaultRevealed}">
                                    <!-- When photos exist -->
                                    <Grid IsVisible="{Binding HasVaultPhotos}" ColumnDefinitions="110,*"
                                          ColumnSpacing="{StaticResource UiSpaceCompact}">
                                        <Image
                                            Source="{Binding LatestVaultPhotoPath}"
                                            Aspect="AspectFill"
                                            HeightRequest="{StaticResource UiDimension110}"
                                            WidthRequest="{StaticResource UiDimension110}" />
                                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Padding="{StaticResource UiInsets0_10_12_10}"
                                              RowSpacing="{StaticResource UiSpacing2}">
                                            <Label Grid.Row="0" Text="{loc:LocalizedText Profile_Details_LatestProgressPhoto}"
                                                   FontAttributes="{StaticResource UiFontAttributesBold}" FontSize="{StaticResource UiFontSize13}" />
                                            <Label Grid.Row="1" Text="{loc:LocalizedText Profile_Details_TapToOpenFullPhotoJourney}"
                                                   Style="{StaticResource CaptionLabel}" FontSize="{StaticResource UiFontSize12}" />
                                            <Button
                                                Grid.Row="2"
                                                Text="{loc:LocalizedText Profile_Details_HidePreview}"
                                                Command="{Binding ToggleVaultPrivacyCommand}"
                                                Style="{StaticResource ButtonLink}"
                                                FontSize="{StaticResource UiFontSize12}"
                                                HorizontalOptions="Start"
                                                VerticalOptions="End"
                                                HeightRequest="{StaticResource UiDimension28}"
                                                MinimumHeightRequest="{StaticResource UiDimension28}"
                                                Padding="{StaticResource UiInsets0}" />
                                        </Grid>
                                    </Grid>

                                    <!-- When no photos exist yet -->
                                    <Grid
                                        IsVisible="{Binding HasVaultPhotos, Converter={StaticResource InvertedBoolConverter}}"
                                        Padding="{StaticResource UiInsets14}" VerticalOptions="Center" HorizontalOptions="Center"
                                        RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpaceMicro}">
                                        <Label Grid.Row="0" Text="{loc:LocalizedText Profile_Details_NoPhotosStoredYet}"
                                               FontAttributes="{StaticResource UiFontAttributesBold}" FontSize="{StaticResource UiFontSize15}" HorizontalTextAlignment="Center" />
                                        <Label Grid.Row="1" Text="{loc:LocalizedText Profile_Details_TapToOpenVaultAndAdd}"
                                               Style="{StaticResource CaptionLabel}" FontSize="{StaticResource UiFontSize12}"
                                               HorizontalTextAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <!-- Privacy Blur / Hidden State -->
                                <Grid
                                    IsVisible="{Binding IsVaultRevealed, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource TranslucentPageSurfaceLight}, Dark={StaticResource TranslucentPageSurfaceDark}}"
                                    Padding="{StaticResource UiInsets12}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleVaultPrivacyCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                        <mi:MauiIcon
                                            Icon="{mi:Fluent ShieldLock24}" IconSize="{StaticResource UiDimension26}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            WidthRequest="{StaticResource UiDimension26}"
                                            HeightRequest="{StaticResource UiDimension26}"
                                            VerticalOptions="Center" />
                                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}"
                                              VerticalOptions="Center">
                                            <Label Text="{loc:LocalizedText Profile_Details_PreviewHiddenForPrivacy}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                                   FontSize="{StaticResource UiFontSize13}" />
                                            <Label Grid.Row="1" Text="{loc:LocalizedText Profile_Details_TapToRevealPreview}"
                                                   Style="{StaticResource CaptionLabel}" FontSize="{StaticResource UiFontSize12}" />
                                        </Grid>
                                        <Button
                                            Grid.Column="2"
                                            Text="{loc:LocalizedText Profile_Details_Reveal}"
                                            Command="{Binding ToggleVaultPrivacyCommand}"
                                            Style="{StaticResource ButtonSecondary}"
                                            FontSize="{StaticResource UiFontSize12}"
                                            HeightRequest="{StaticResource UiDimension32}"
                                            MinimumHeightRequest="{StaticResource UiDimension32}"
                                            Padding="{StaticResource UiInsets12_0}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Section: HEALTH & TRAINING (Apple Inset Grouped) -->
                <Label Text="{loc:LocalizedText Profile_Details_HealthTraining}" Style="{StaticResource CaptionLabel}"
                       FontAttributes="{StaticResource UiFontAttributesBold}" Margin="{StaticResource UiInsets24_12_24_6}" />
                <Border
                    Style="{StaticResource CardPrimary}"
                    Margin="{StaticResource UiInsets20_0_20_16}"
                    Padding="{StaticResource UiInsets0}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpacing0}">
                        <!-- Apple Health Status Row -->
                        <Border BackgroundColor="{StaticResource Transparent}" StrokeThickness="{StaticResource UiStrokeWidth0}" Padding="{StaticResource UiInsets16_14}"
                                IsVisible="{Binding IsAppleHealthAvailable}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenRouteCommand}"
                                                      CommandParameter="ProfileHealthSyncPage" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="32,*,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                <mi:MauiIcon
                                    Icon="{mi:Fluent HeartPulse32}" IconSize="{StaticResource UiDimension20}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension20}"
                                    HeightRequest="{StaticResource UiDimension20}"
                                    VerticalOptions="Center" />
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                    <Label Text="{loc:LocalizedText Profile_Details_AppleHealth}" FontSize="{StaticResource UiFontSize15}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Grid.Row="1" Text="{loc:LocalizedText Profile_Details_SleepStepsEnergyHeartRate}"
                                           Style="{StaticResource CaptionLabel}" FontSize="{StaticResource UiFontSize12}" />
                                </Grid>
                                <Border
                                    Grid.Column="2"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                                    StrokeShape="{StaticResource UiRoundRectangleRadius8}"
                                    Padding="{StaticResource UiInsets8_3}"
                                    VerticalOptions="Center">
                                    <Label
                                        Text="{Binding HealthStatusText, Converter={StaticResource LocalizedStringConverter}}"
                                        FontSize="{StaticResource UiFontSize12}" FontAttributes="{StaticResource UiFontAttributesBold}" VerticalOptions="Center" />
                                </Border>
                                <mi:MauiIcon
                                    Grid.Column="3"
                                    Icon="{mi:Fluent ChevronRight24}" IconSize="{StaticResource UiDimension16}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension16}"
                                    HeightRequest="{StaticResource UiDimension16}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="{StaticResource UiDimension1}" Margin="{StaticResource UiInsets56_0_0_0}"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />

                        <!-- Workout Availability Row -->
                        <Border BackgroundColor="{StaticResource Transparent}" StrokeThickness="{StaticResource UiStrokeWidth0}" Padding="{StaticResource UiInsets16_14}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenRouteCommand}"
                                                      CommandParameter="ProfileWorkoutPreferencesPage" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="32,*,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                <mi:MauiIcon
                                    Icon="{mi:Fluent Dumbbell24}" IconSize="{StaticResource UiDimension20}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension20}"
                                    HeightRequest="{StaticResource UiDimension20}"
                                    VerticalOptions="Center" />
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                    <Label Text="{loc:LocalizedText Profile_Details_WorkoutAvailability}" FontSize="{StaticResource UiFontSize15}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Grid.Row="1"
                                           Text="{Binding AvailableWeekdaysText, Converter={StaticResource LocalizedStringConverter}}"
                                           Style="{StaticResource CaptionLabel}" FontSize="{StaticResource UiFontSize12}" />
                                </Grid>
                                <mi:MauiIcon
                                    Grid.Column="3"
                                    Icon="{mi:Fluent ChevronRight24}" IconSize="{StaticResource UiDimension16}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension16}"
                                    HeightRequest="{StaticResource UiDimension16}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="{StaticResource UiDimension1}" Margin="{StaticResource UiInsets56_0_0_0}"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />

                        <!-- Nutrition Row -->
                        <Border BackgroundColor="{StaticResource Transparent}" StrokeThickness="{StaticResource UiStrokeWidth0}" Padding="{StaticResource UiInsets16_14}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenRouteCommand}"
                                                      CommandParameter="ProfileNutritionSettingsPage" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="32,*,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                <mi:MauiIcon
                                    Icon="{mi:Fluent Food24}" IconSize="{StaticResource UiDimension20}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension20}"
                                    HeightRequest="{StaticResource UiDimension20}"
                                    VerticalOptions="Center" />
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                    <Label Text="{loc:LocalizedText Profile_Details_Nutrition}" FontSize="{StaticResource UiFontSize15}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Grid.Row="1"
                                           Text="{Binding NutritionPacingText, Converter={StaticResource LocalizedStringConverter}}"
                                           Style="{StaticResource CaptionLabel}" FontSize="{StaticResource UiFontSize12}" />
                                </Grid>
                                <mi:MauiIcon
                                    Grid.Column="3"
                                    Icon="{mi:Fluent ChevronRight24}" IconSize="{StaticResource UiDimension16}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension16}"
                                    HeightRequest="{StaticResource UiDimension16}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="{StaticResource UiDimension1}" Margin="{StaticResource UiInsets56_0_0_0}"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />

                        <!-- Micronutrient targets -->
                        <Border BackgroundColor="{StaticResource Transparent}" StrokeThickness="{StaticResource UiStrokeWidth0}" Padding="{StaticResource UiInsets16_14}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenRouteCommand}"
                                                      CommandParameter="ProfileNutritionSettingsPage" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                <mi:MauiIcon
                                    Icon="{mi:Fluent Food24}" IconSize="{StaticResource UiDimension20}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension20}"
                                    HeightRequest="{StaticResource UiDimension20}"
                                    VerticalOptions="Center" />
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                    <Label Text="{loc:LocalizedText Profile_Details_MicronutrientTargets}" FontSize="{StaticResource UiFontSize15}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Grid.Row="1" Text="{loc:LocalizedText Profile_Details_MicronutrientTargetsDetail}"
                                           Style="{StaticResource CaptionLabel}" FontSize="{StaticResource UiFontSize12}" />
                                </Grid>
                                <mi:MauiIcon
                                    Grid.Column="2"
                                    Icon="{mi:Fluent ChevronRight24}" IconSize="{StaticResource UiDimension16}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension16}"
                                    HeightRequest="{StaticResource UiDimension16}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Section: ACCOUNT & PREFERENCES (Apple Inset Grouped) -->
                <Label Text="{loc:LocalizedText Profile_Details_AccountPreferences}" Style="{StaticResource CaptionLabel}"
                       FontAttributes="{StaticResource UiFontAttributesBold}" Margin="{StaticResource UiInsets24_12_24_6}" />
                <Border
                    Style="{StaticResource CardPrimary}"
                    Margin="{StaticResource UiInsets20_0_20_16}"
                    Padding="{StaticResource UiInsets0}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpacing0}">
                        <!-- Personal Info Row -->
                        <Border BackgroundColor="{StaticResource Transparent}" StrokeThickness="{StaticResource UiStrokeWidth0}" Padding="{StaticResource UiInsets16_14}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenRouteCommand}"
                                                      CommandParameter="ProfilePersonalInfoPage" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                <mi:MauiIcon
                                    Icon="{mi:Fluent PersonPill24}" IconSize="{StaticResource UiDimension20}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension20}"
                                    HeightRequest="{StaticResource UiDimension20}"
                                    VerticalOptions="Center" />
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                    <Label Text="{loc:LocalizedText Profile_Details_PersonalInfo}" FontSize="{StaticResource UiFontSize15}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Grid.Row="1" Text="{loc:LocalizedText Profile_Details_NameEmailPasswordCycleBaselines}"
                                           Style="{StaticResource CaptionLabel}" FontSize="{StaticResource UiFontSize12}" />
                                </Grid>
                                <mi:MauiIcon
                                    Grid.Column="2"
                                    Icon="{mi:Fluent ChevronRight24}" IconSize="{StaticResource UiDimension16}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension16}"
                                    HeightRequest="{StaticResource UiDimension16}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="{StaticResource UiDimension1}" Margin="{StaticResource UiInsets56_0_0_0}"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />

                        <!-- Units & Display Row -->
                        <Border BackgroundColor="{StaticResource Transparent}" StrokeThickness="{StaticResource UiStrokeWidth0}" Padding="{StaticResource UiInsets16_14}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenRouteCommand}"
                                                      CommandParameter="ProfileUnitsDisplayPage" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="32,*,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                <mi:MauiIcon
                                    Icon="{mi:Fluent ChatSettings24}" IconSize="{StaticResource UiDimension20}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension20}"
                                    HeightRequest="{StaticResource UiDimension20}"
                                    VerticalOptions="Center" />
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                    <Label Text="{loc:LocalizedText Profile_Details_UnitsDisplay}" FontSize="{StaticResource UiFontSize15}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Grid.Row="1"
                                           Text="{Binding UnitsDisplayText, Converter={StaticResource LocalizedStringConverter}}"
                                           Style="{StaticResource CaptionLabel}" FontSize="{StaticResource UiFontSize12}" />
                                </Grid>
                                <mi:MauiIcon
                                    Grid.Column="3"
                                    Icon="{mi:Fluent ChevronRight24}" IconSize="{StaticResource UiDimension16}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension16}"
                                    HeightRequest="{StaticResource UiDimension16}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="{StaticResource UiDimension1}" Margin="{StaticResource UiInsets56_0_0_0}"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />

                        <!-- Privacy Policy Row -->
                        <Border BackgroundColor="{StaticResource Transparent}" StrokeThickness="{StaticResource UiStrokeWidth0}" Padding="{StaticResource UiInsets16_14}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenRouteCommand}"
                                                      CommandParameter="ProfilePrivacyPage" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                <mi:MauiIcon
                                    Icon="{mi:Fluent ShieldLock24}" IconSize="{StaticResource UiDimension20}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension20}"
                                    HeightRequest="{StaticResource UiDimension20}"
                                    VerticalOptions="Center" />
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                    <Label Text="{loc:LocalizedText Profile_Privacy_Policy}" FontSize="{StaticResource UiFontSize15}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Grid.Row="1" Text="{loc:LocalizedText Profile_Details_HealthRecordsStayOnThisDevice}"
                                           Style="{StaticResource CaptionLabel}" FontSize="{StaticResource UiFontSize12}" />
                                </Grid>
                                <mi:MauiIcon
                                    Grid.Column="2"
                                    Icon="{mi:Fluent ChevronRight24}" IconSize="{StaticResource UiDimension16}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension16}"
                                    HeightRequest="{StaticResource UiDimension16}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="{StaticResource UiDimension1}" Margin="{StaticResource UiInsets56_0_0_0}"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />

                        <!-- Send Feedback Row -->
                        <Border BackgroundColor="{StaticResource Transparent}" StrokeThickness="{StaticResource UiStrokeWidth0}" Padding="{StaticResource UiInsets16_14}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenRouteCommand}"
                                                      CommandParameter="ProfileFeedbackPage" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                                <mi:MauiIcon
                                    Icon="{mi:Fluent ChatBubblesQuestion24}" IconSize="{StaticResource UiDimension20}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension20}"
                                    HeightRequest="{StaticResource UiDimension20}"
                                    VerticalOptions="Center" />
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}">
                                    <Label Text="{loc:LocalizedText Profile_Details_SendFeedback}" FontSize="{StaticResource UiFontSize15}" FontAttributes="{StaticResource UiFontAttributesBold}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Grid.Row="1" Text="{loc:LocalizedText Profile_Details_ReportAnIssueOrSuggestA}"
                                           Style="{StaticResource CaptionLabel}" FontSize="{StaticResource UiFontSize12}" />
                                </Grid>
                                <mi:MauiIcon
                                    Grid.Column="2"
                                    Icon="{mi:Fluent ChevronRight24}" IconSize="{StaticResource UiDimension16}" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="{StaticResource UiDimension16}"
                                    HeightRequest="{StaticResource UiDimension16}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

    </VerticalStackLayout>
</ContentView>
