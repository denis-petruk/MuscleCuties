<?xml version="1.0" encoding="utf-8"?>

<!-- Body of the daily check-in sheet. Hosted by DailyCheckInModal; the page that used to
     own this markup is retired, so the chip contract lives here beside the chips. -->
<ContentView
    x:Class="MuscleCuties.UI.Controls.Dashboard.DailyCheckInContent"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Dashboard"
    x:DataType="vm:DailyCheckInViewModel">

    <ScrollView>
        <VerticalStackLayout
            Padding="{DynamicResource PresentationModalPagePadding}"
            Spacing="{StaticResource UiSpaceControl}"
            HorizontalOptions="Fill">

            <VerticalStackLayout Spacing="{StaticResource UiSpacing6}">
                <Label
                    Text="{loc:LocalizedText Dashboard_CheckIn_Subtitle}"
                    Style="{StaticResource MutedLabel}" />
                <Label
                    Text="{Binding ErrorMessage, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource ErrorLabel}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
            </VerticalStackLayout>

            <!-- Sleep last night + sleep quality -->
            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="{StaticResource UiSpacing14}">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing6}">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                            <Label
                                Grid.Column="0"
                                Text="{loc:LocalizedText Dashboard_CheckIn_SleepTitle}"
                                Style="{StaticResource FormFieldLabel}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding SleepDisplay, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource MetricValue}"
                                VerticalOptions="Center" />
                        </Grid>
                        <Slider
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="14"
                            Value="{Binding SleepHours}"
                            HorizontalOptions="Fill"
                            MinimumTrackColor="{StaticResource Primary}"
                            MaximumTrackColor="{AppThemeBinding Light={StaticResource TrackMutedLight}, Dark={StaticResource TrackMutedDark}}"
                            ThumbColor="{StaticResource Primary}"
                            SemanticProperties.Description="{Binding SleepDisplay, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Dashboard_CheckIn_SleepA11yFormat}"
                            SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_SleepSliderHint}" />
                        <Grid Grid.Row="2" ColumnDefinitions="*, *">
                            <Label
                                Grid.Column="0"
                                Text="{loc:LocalizedText Dashboard_CheckIn_SleepMinLabel}"
                                Style="{StaticResource CaptionLabel}"
                                HorizontalOptions="Start" />
                            <Label
                                Grid.Column="1"
                                Text="{loc:LocalizedText Dashboard_CheckIn_SleepMaxLabel}"
                                Style="{StaticResource CaptionLabel}"
                                HorizontalOptions="End" />
                        </Grid>
                    </Grid>

                    <BoxView Style="{StaticResource ModalDivider}" />

                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing6}">
                        <Label
                            Grid.Row="0"
                            Text="{loc:LocalizedText Dashboard_CheckIn_PlanningSleepQuality}"
                            Style="{StaticResource FormFieldLabel}"
                            VerticalOptions="Center" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="{StaticResource UiSpacing6}">
                            <Button x:Name="SleepQualityChip1" Style="{StaticResource ButtonSecondary}" Grid.Column="0"
                                    Text="{loc:LocalizedText Common_Scale_1}"
                                    CommandParameter="1" Clicked="OnSleepQualityClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_SleepQuality1A11y}" />
                            <Button x:Name="SleepQualityChip2" Style="{StaticResource ButtonSecondary}" Grid.Column="1"
                                    Text="{loc:LocalizedText Common_Scale_2}"
                                    CommandParameter="2" Clicked="OnSleepQualityClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_SleepQuality2A11y}" />
                            <Button x:Name="SleepQualityChip3" Style="{StaticResource ButtonSecondary}" Grid.Column="2"
                                    Text="{loc:LocalizedText Common_Scale_3}"
                                    CommandParameter="3" Clicked="OnSleepQualityClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_SleepQuality3A11y}" />
                            <Button x:Name="SleepQualityChip4" Style="{StaticResource ButtonSecondary}" Grid.Column="3"
                                    Text="{loc:LocalizedText Common_Scale_4}"
                                    CommandParameter="4" Clicked="OnSleepQualityClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_SleepQuality4A11y}" />
                            <Button x:Name="SleepQualityChip5" Style="{StaticResource ButtonSecondary}" Grid.Column="4"
                                    Text="{loc:LocalizedText Common_Scale_5}"
                                    CommandParameter="5" Clicked="OnSleepQualityClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_SleepQuality5A11y}" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="*,*">
                            <Label Text="{loc:LocalizedText Dashboard_CheckIn_EnergyVeryLowLabel}"
                                   Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1" Text="{loc:LocalizedText Dashboard_CheckIn_EnergyVeryHighLabel}"
                                   Style="{StaticResource CaptionLabel}"
                                   HorizontalTextAlignment="End" />
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Energy, soreness, pain, bloating: each starts unanswered and needs an explicit choice -->
            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="{StaticResource UiSpacing14}">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing6}">
                        <Label Grid.Row="0"
                               Text="{loc:LocalizedText Dashboard_CheckIn_EnergyTitle}"
                               Style="{StaticResource FormFieldLabel}"
                               VerticalOptions="Center" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="{StaticResource UiSpacing6}">
                            <Button x:Name="EnergyChip1" Style="{StaticResource ButtonSecondary}" Grid.Column="0"
                                    Text="{loc:LocalizedText Common_Scale_1}"
                                    CommandParameter="1" Clicked="OnEnergyClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Energy1A11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_Energy1Hint}" />
                            <Button x:Name="EnergyChip2" Style="{StaticResource ButtonSecondary}" Grid.Column="1"
                                    Text="{loc:LocalizedText Common_Scale_2}"
                                    CommandParameter="2" Clicked="OnEnergyClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Energy2A11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_Energy2Hint}" />
                            <Button x:Name="EnergyChip3" Style="{StaticResource ButtonSecondary}" Grid.Column="2"
                                    Text="{loc:LocalizedText Common_Scale_3}"
                                    CommandParameter="3" Clicked="OnEnergyClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Energy3A11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_Energy3Hint}" />
                            <Button x:Name="EnergyChip4" Style="{StaticResource ButtonSecondary}" Grid.Column="3"
                                    Text="{loc:LocalizedText Common_Scale_4}"
                                    CommandParameter="4" Clicked="OnEnergyClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Energy4A11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_Energy4Hint}" />
                            <Button x:Name="EnergyChip5" Style="{StaticResource ButtonSecondary}" Grid.Column="4"
                                    Text="{loc:LocalizedText Common_Scale_5}"
                                    CommandParameter="5" Clicked="OnEnergyClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Energy5A11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_Energy5Hint}" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="*,*">
                            <Label Text="{loc:LocalizedText Dashboard_CheckIn_EnergyVeryLowLabel}"
                                   Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1" Text="{loc:LocalizedText Dashboard_CheckIn_EnergyVeryHighLabel}"
                                   Style="{StaticResource CaptionLabel}"
                                   HorizontalTextAlignment="End" />
                        </Grid>
                    </Grid>

                    <BoxView Style="{StaticResource ModalDivider}" />

                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing6}">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                            <Label
                                Grid.Column="0"
                                Text="{loc:LocalizedText Dashboard_CheckIn_PlanningSoreness}"
                                Style="{StaticResource FormFieldLabel}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding PlanningSorenessDisplay, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource MetricValue}"
                                VerticalOptions="Center" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="{StaticResource UiSpacing6}">
                            <Button x:Name="SorenessChip1" Style="{StaticResource ButtonSecondary}" Grid.Column="0"
                                    Text="{loc:LocalizedText Common_Scale_1}"
                                    CommandParameter="1" Clicked="OnSorenessClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Soreness1A11y}" />
                            <Button x:Name="SorenessChip2" Style="{StaticResource ButtonSecondary}" Grid.Column="1"
                                    Text="{loc:LocalizedText Common_Scale_2}"
                                    CommandParameter="2" Clicked="OnSorenessClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Soreness2A11y}" />
                            <Button x:Name="SorenessChip3" Style="{StaticResource ButtonSecondary}" Grid.Column="2"
                                    Text="{loc:LocalizedText Common_Scale_3}"
                                    CommandParameter="3" Clicked="OnSorenessClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Soreness3A11y}" />
                            <Button x:Name="SorenessChip4" Style="{StaticResource ButtonSecondary}" Grid.Column="3"
                                    Text="{loc:LocalizedText Common_Scale_4}"
                                    CommandParameter="4" Clicked="OnSorenessClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Soreness4A11y}" />
                            <Button x:Name="SorenessChip5" Style="{StaticResource ButtonSecondary}" Grid.Column="4"
                                    Text="{loc:LocalizedText Common_Scale_5}"
                                    CommandParameter="5" Clicked="OnSorenessClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_Soreness5A11y}" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="*, *">
                            <Label
                                Grid.Column="0"
                                Text="{loc:LocalizedText Dashboard_CheckIn_PainNone}"
                                Style="{StaticResource CaptionLabel}"
                                HorizontalOptions="Start" />
                            <Label
                                Grid.Column="1"
                                Text="{loc:LocalizedText Dashboard_CheckIn_PainSevere}"
                                Style="{StaticResource CaptionLabel}"
                                HorizontalOptions="End" />
                        </Grid>
                    </Grid>

                    <BoxView Style="{StaticResource ModalDivider}" />

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing6}">
                        <Label Grid.Row="0"
                               Text="{loc:LocalizedText Dashboard_CheckIn_PainTitle}"
                               Style="{StaticResource FormFieldLabel}"
                               VerticalOptions="Center" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource UiSpaceTight}"
                              RowSpacing="{StaticResource UiSpaceTight}">
                            <Button x:Name="PainChip0" Style="{StaticResource ButtonSecondary}" Grid.Row="0"
                                    Grid.Column="0" Text="{loc:LocalizedText Dashboard_CheckIn_PainNone}"
                                    CommandParameter="0" Clicked="OnPainClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_PainNoneA11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_PainNoneHint}" />
                            <Button x:Name="PainChip1" Style="{StaticResource ButtonSecondary}" Grid.Row="0"
                                    Grid.Column="1" Text="{loc:LocalizedText Dashboard_CheckIn_PainMild}"
                                    CommandParameter="1" Clicked="OnPainClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_PainMildA11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_PainMildHint}" />
                            <Button x:Name="PainChip2" Style="{StaticResource ButtonSecondary}" Grid.Row="1"
                                    Grid.Column="0" Text="{loc:LocalizedText Dashboard_CheckIn_PainModerate}"
                                    CommandParameter="2" Clicked="OnPainClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_PainModerateA11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_PainModerateHint}" />
                            <Button x:Name="PainChip3" Style="{StaticResource ButtonSecondary}" Grid.Row="1"
                                    Grid.Column="1" Text="{loc:LocalizedText Dashboard_CheckIn_PainSevere}"
                                    CommandParameter="3" Clicked="OnPainClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_PainSevereA11y}"
                                    SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_PainSevereHint}" />
                        </Grid>
                    </Grid>

                    <BoxView Style="{StaticResource ModalDivider}" />

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label
                            Grid.Column="0"
                            Text="{loc:LocalizedText Dashboard_CheckIn_BloatingTitle}"
                            Style="{StaticResource FormFieldLabel}"
                            VerticalOptions="Center" />
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource UiSpaceTight}"
                              SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_BloatingHint}">
                            <Button x:Name="BloatingNoChip" Style="{StaticResource ButtonSecondary}" Grid.Column="0"
                                    Text="{loc:LocalizedText Dashboard_CheckIn_BloatingNo}"
                                    CommandParameter="0" Clicked="OnBloatingClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_BloatingNoA11y}" />
                            <Button x:Name="BloatingYesChip" Style="{StaticResource ButtonSecondary}" Grid.Column="1"
                                    Text="{loc:LocalizedText Dashboard_CheckIn_BloatingYes}"
                                    CommandParameter="1" Clicked="OnBloatingClicked"
                                    SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_BloatingYesA11y}" />
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Body weight -->
            <Border Style="{StaticResource CardPrimary}">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpaceTight}">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                        <Label Text="{loc:LocalizedText Dashboard_CheckIn_BodyWeightTitle}"
                               Style="{StaticResource FormFieldLabel}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{loc:LocalizedText Dashboard_CheckIn_PrivateBadge}"
                               Style="{StaticResource CaptionLabel}"
                               VerticalOptions="Center"
                               SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_PrivateBadgeA11y}" />
                    </Grid>
                    <Label Grid.Row="1" Text="{loc:LocalizedText Dashboard_CheckIn_StorageNotice}"
                           Style="{StaticResource CaptionLabel}" />
                    <Border Grid.Row="2" Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="WeightEntry"
                            Placeholder="{loc:LocalizedText Dashboard_CheckIn_WeightPlaceholderKg}"
                            Text="{Binding BodyWeight}"
                            Keyboard="Numeric"
                            ReturnType="Done"
                            ReturnCommand="{Binding SubmitCommand}"
                            SemanticProperties.Description="{loc:LocalizedText Dashboard_CheckIn_WeightA11y}"
                            SemanticProperties.Hint="{loc:LocalizedText Dashboard_CheckIn_WeightHint}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Result -->
            <Border
                Style="{StaticResource CardPrimary}"
                IsVisible="{Binding IsCompleted}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpaceTight}" HorizontalOptions="Center">
                    <Label
                        Grid.Row="0"
                        Text="{loc:LocalizedText Dashboard_CheckIn_SuccessMessage}"
                        Style="{StaticResource SectionTitle}"
                        LineBreakMode="WordWrap"
                        HorizontalOptions="Center" />
                    <Label
                        Grid.Row="1"
                        Text="{Binding ReadinessScoreText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource MetricValue}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding IsReadinessScoreDisplayEnabled}" />
                    <Label Grid.Row="1"
                           Text="{loc:LocalizedText Dashboard_Readiness_ReviewPending}"
                           Style="{StaticResource BodyCentered}"
                           LineBreakMode="WordWrap"
                           HorizontalOptions="Center"
                           IsVisible="{Binding IsReadinessScoreDisplayEnabled, Converter={StaticResource InvertedBoolConverter}}" />
                    <Label
                        Grid.Row="2"
                        Text="{Binding ReadinessTierText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource SectionTitle}"
                        LineBreakMode="WordWrap"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding IsReadinessScoreDisplayEnabled}" />
                    <Label
                        Grid.Row="3"
                        Text="{loc:LocalizedText Dashboard_Readiness_ScoreExplanation}"
                        Style="{StaticResource MutedCentered}"
                        LineBreakMode="WordWrap"
                        HorizontalOptions="Center"
                        IsVisible="{Binding IsReadinessScoreDisplayEnabled}" />
                    <Grid Grid.Row="4" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource UiSpacing10}"
                          HorizontalOptions="Fill">
                        <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource UiSpacing2}" HorizontalOptions="Center">
                            <Label Text="{loc:LocalizedText Dashboard_CheckIn_PlanningSleepQuality}"
                                   Style="{StaticResource CaptionCentered}" />
                            <Label Text="{Binding PlanningSleepDisplay}" Style="{StaticResource BodyCentered}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource UiSpacing2}" HorizontalOptions="Center">
                            <Label Text="{loc:LocalizedText Dashboard_CheckIn_EnergyTitle}"
                                   Style="{StaticResource CaptionCentered}" />
                            <Label Text="{Binding EnergyDisplay}" Style="{StaticResource BodyCentered}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="{StaticResource UiSpacing2}" HorizontalOptions="Center">
                            <Label Text="{loc:LocalizedText Dashboard_CheckIn_PlanningSoreness}"
                                   Style="{StaticResource CaptionCentered}" />
                            <Label Text="{Binding PlanningSorenessDisplay}" Style="{StaticResource BodyCentered}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label
                        Grid.Row="5"
                        Text="{Binding SessionSummaryText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource MutedCentered}"
                        LineBreakMode="WordWrap"
                        IsVisible="{Binding HasSessionSummary}"
                        HorizontalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
