<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Dashboard.DashboardNutritionCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:dashboard="clr-namespace:MuscleCuties.UI.Controls.Dashboard"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Dashboard"
    x:DataType="vm:DashboardViewModel">
    <Border Style="{StaticResource CardPrimary}" SemanticProperties.Description="{loc:LocalizedText Dashboard_Nutrition_ProgressA11y}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenNutritionCommand}" />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{loc:LocalizedText Dashboard_Nutrition_Title}" Style="{StaticResource SectionTitle}" FontSize="{StaticResource UiFontSize17}" />
                <Label Grid.Column="1" Text="{loc:LocalizedText Dashboard_Nutrition_ViewAll}" TextColor="{StaticResource Primary}"
                       FontSize="{StaticResource UiFontSize13}" VerticalOptions="Center" />
            </Grid>
            <Grid ColumnDefinitions="76,*" ColumnSpacing="{StaticResource UiSpaceControl}">
                <Grid WidthRequest="{StaticResource UiDimension76}" HeightRequest="{StaticResource UiDimension76}">
                    <dashboard:DashboardProgressRing Progress="{Binding CaloriesProgress}"
                                                     RingColor="{StaticResource Primary}"
                                                     WidthRequest="{StaticResource UiDimension76}" HeightRequest="{StaticResource UiDimension76}" />
                    <Image Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                           WidthRequest="{StaticResource UiDimension26}" HeightRequest="{StaticResource UiDimension26}"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                </Grid>
                <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource UiSpacing3}" VerticalOptions="Center">
                    <Label Text="{loc:LocalizedText Dashboard_Nutrition_Calories}" FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="{Binding CaloriesConsumed, Converter={StaticResource LocalizedStringConverter}}"
                           FontSize="{StaticResource UiFontSize20}" FontAttributes="{StaticResource UiFontAttributesBold}"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding CaloriesGoal, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource UiSpacing6}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                    <Grid WidthRequest="{StaticResource UiDimension60}" HeightRequest="{StaticResource UiDimension60}" HorizontalOptions="Center">
                        <dashboard:DashboardProgressRing Progress="{Binding ProteinProgress}"
                                                         RingColor="{AppThemeBinding Light={StaticResource ProteinLight}, Dark={StaticResource ProteinDark}}"
                                                         WidthRequest="{StaticResource UiDimension60}" HeightRequest="{StaticResource UiDimension60}" />
                        <Path Data="M4 9v6M7 8v8M17 9v6M14 8v8M7 12h7"
                              Style="{StaticResource NutritionLineIcon}"
                              Stroke="{AppThemeBinding Light={StaticResource ProteinLight}, Dark={StaticResource ProteinDark}}"
                              WidthRequest="{StaticResource UiDimension18}"
                              HeightRequest="{StaticResource UiDimension18}"
                              InputTransparent="True" />
                    </Grid>
                    <Label Text="{loc:LocalizedText Dashboard_Nutrition_Protein}" FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ProteinText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource CaptionTinyCentered}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                    <Grid WidthRequest="{StaticResource UiDimension60}" HeightRequest="{StaticResource UiDimension60}" HorizontalOptions="Center">
                        <dashboard:DashboardProgressRing Progress="{Binding CarbsProgress}"
                                                         RingColor="{AppThemeBinding Light={StaticResource CarbsLight}, Dark={StaticResource CarbsDark}}"
                                                         WidthRequest="{StaticResource UiDimension60}" HeightRequest="{StaticResource UiDimension60}" />
                        <Path Data="M9 18V5M9 7C6.5 7 5 5.8 5 4M9 10C6.5 10 5 8.8 5 7M9 13C6.5 13 5 11.8 5 10M9 7c2.5 0 4-1.2 4-3M9 10c2.5 0 4-1.2 4-3M9 13c2.5 0 4-1.2 4-3"
                              Style="{StaticResource NutritionLineIcon}"
                              Stroke="{AppThemeBinding Light={StaticResource CarbsLight}, Dark={StaticResource CarbsDark}}"
                              StrokeThickness="{StaticResource UiStrokeWidth1_5}"
                              WidthRequest="{StaticResource UiDimension18}"
                              HeightRequest="{StaticResource UiDimension18}"
                              InputTransparent="True" />
                    </Grid>
                    <Label Text="{loc:LocalizedText Dashboard_Nutrition_Carbs}" FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding CarbsText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource CaptionTinyCentered}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                    <Grid WidthRequest="{StaticResource UiDimension60}" HeightRequest="{StaticResource UiDimension60}" HorizontalOptions="Center">
                        <dashboard:DashboardProgressRing Progress="{Binding FatsProgress}"
                                                         RingColor="{AppThemeBinding Light={StaticResource FatsLight}, Dark={StaticResource FatsDark}}"
                                                         WidthRequest="{StaticResource UiDimension60}" HeightRequest="{StaticResource UiDimension60}" />
                        <Path Data="M10 3C7 7 5 10 5 13a5 5 0 0 0 10 0c0-3-2-6-5-10z"
                              Style="{StaticResource NutritionLineIcon}"
                              Stroke="{AppThemeBinding Light={StaticResource FatsLight}, Dark={StaticResource FatsDark}}"
                              StrokeThickness="{StaticResource UiStrokeWidth1_6}"
                              WidthRequest="{StaticResource UiDimension18}"
                              HeightRequest="{StaticResource UiDimension18}"
                              InputTransparent="True" />
                    </Grid>
                    <Label Text="{loc:LocalizedText Dashboard_Nutrition_Fat}" FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding FatsText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource CaptionTinyCentered}" />
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
