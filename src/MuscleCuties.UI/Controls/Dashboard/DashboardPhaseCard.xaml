<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Dashboard.DashboardPhaseCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Dashboard"
    x:DataType="vm:DashboardViewModel">


    <Border
        Style="{StaticResource CardPrimary}"
        SemanticProperties.Description="{Binding PhaseCardTitle, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Dashboard_Phase_SemanticCurrentPhase}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenCycleCommand}" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing10}">
            <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="{StaticResource UiSpacing10}">
                <Border WidthRequest="{StaticResource UiDimension36}" HeightRequest="{StaticResource UiDimension36}"
                        BackgroundColor="{Binding PhaseCardBackgroundColor}"
                        StrokeThickness="{StaticResource UiStrokeWidth0}" StrokeShape="{StaticResource UiRoundRectangleRadius12}">
                    <Image
                        Source="{Binding PhaseIconSource}"
                        Aspect="AspectFit"
                        WidthRequest="{StaticResource UiDimension18}"
                        HeightRequest="{StaticResource UiDimension18}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    Grid.Column="1"
                    Text="{Binding PhaseStatusText, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource FormFieldLabel}"
                    FontSize="{StaticResource UiFontSize13}"
                    LineBreakMode="WordWrap"
                    VerticalOptions="Center" />
                <Path Grid.Column="2"
                      Data="M9 18l6-6-6-6"
                      Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                      StrokeThickness="{StaticResource UiStrokeWidth1_8}" StrokeLineCap="Round" StrokeLineJoin="Round"
                      Aspect="Uniform" WidthRequest="{StaticResource UiDimension16}" HeightRequest="{StaticResource UiDimension16}"
                      VerticalOptions="Center" />
            </Grid>

            <Label
                Grid.Row="1"
                Text="{Binding PhaseCardTitle, Converter={StaticResource LocalizedStringConverter}}"
                Style="{StaticResource SectionTitle}"
                FontSize="{StaticResource UiFontSize20}"
                LineBreakMode="WordWrap" />

            <Label
                Grid.Row="2"
                Text="{Binding PhaseShortAdvice, Converter={StaticResource LocalizedStringConverter}}"
                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                FontSize="{StaticResource UiFontSize13}"
                LineBreakMode="WordWrap"
                Margin="{StaticResource UiInsets0_Minus4_0_0}" />

            <Grid
                Grid.Row="3"
                RowDefinitions="Auto, 6"
                ColumnDefinitions="*, *, *, *"
                ColumnSpacing="{StaticResource UiSpaceMicro}"
                RowSpacing="{StaticResource UiSpacing6}">
                <Label
                    Text="{loc:LocalizedText Dashboard_Phase_Menstrual}"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{AppThemeBinding Light={StaticResource CyclePhaseMenstrualTextLight}, Dark={StaticResource CyclePhaseMenstrualTextDark}}"
                    FontSize="{StaticResource UiFontSize12}" />
                <Label
                    Grid.Column="1"
                    Text="{loc:LocalizedText Dashboard_Phase_Follicular}"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{AppThemeBinding Light={StaticResource CyclePhaseFollicularTextLight}, Dark={StaticResource CyclePhaseFollicularTextDark}}"
                    FontSize="{StaticResource UiFontSize12}" />
                <Label
                    Grid.Column="2"
                    Text="{loc:LocalizedText Dashboard_Phase_Ovulatory}"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{AppThemeBinding Light={StaticResource CyclePhaseOvulatoryTextLight}, Dark={StaticResource CyclePhaseOvulatoryTextDark}}"
                    FontSize="{StaticResource UiFontSize12}" />
                <Label
                    Grid.Column="3"
                    Text="{loc:LocalizedText Dashboard_Phase_Luteal}"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{AppThemeBinding Light={StaticResource CyclePhaseLutealTextLight}, Dark={StaticResource CyclePhaseLutealTextDark}}"
                    FontSize="{StaticResource UiFontSize12}"
                    HorizontalTextAlignment="End" />

                <BoxView
                    Grid.Row="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CyclePhaseMenstrualTextLight}, Dark={StaticResource CyclePhaseMenstrualTextDark}}"
                    CornerRadius="{StaticResource UiCornerRadius4}"
                    HeightRequest="{StaticResource UiDimension6}" />
                <BoxView
                    Grid.Row="1"
                    Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CyclePhaseFollicularTextLight}, Dark={StaticResource CyclePhaseFollicularTextDark}}"
                    CornerRadius="{StaticResource UiCornerRadius4}"
                    HeightRequest="{StaticResource UiDimension6}" />
                <BoxView
                    Grid.Row="1"
                    Grid.Column="2"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CyclePhaseOvulatoryTextLight}, Dark={StaticResource CyclePhaseOvulatoryTextDark}}"
                    CornerRadius="{StaticResource UiCornerRadius4}"
                    HeightRequest="{StaticResource UiDimension6}" />
                <BoxView
                    Grid.Row="1"
                    Grid.Column="3"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CyclePhaseLutealTextLight}, Dark={StaticResource CyclePhaseLutealTextDark}}"
                    CornerRadius="{StaticResource UiCornerRadius4}"
                    HeightRequest="{StaticResource UiDimension6}" />
                <Border
                    Grid.Row="1"
                    Grid.Column="{Binding CurrentPhaseColumn}"
                    IsVisible="{Binding HasKnownPhase}"
                    WidthRequest="{StaticResource UiDimension14}"
                    HeightRequest="{StaticResource UiDimension14}"
                    StrokeShape="{StaticResource UiRoundRectangleRadius7}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeThickness="{StaticResource UiStrokeWidth2}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

            <Grid Grid.Row="4" ColumnDefinitions="*, Auto, *, Auto, *" RowDefinitions="Auto, Auto" RowSpacing="{StaticResource UiSpacing2}"
                  Padding="{StaticResource UiInsets0_18_0_0}">
                <BoxView
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="5"
                    HeightRequest="{StaticResource UiDimension1}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                    Opacity="{StaticResource UiOpacitySubtle}"
                    VerticalOptions="Start" />

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="{Binding PhaseTimeLeftValue, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource SectionTitle}"
                    FontSize="{StaticResource UiFontSize17}" />
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="{Binding PhaseTimeLeftLabel, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource CaptionLabel}"
                    FontSize="{StaticResource UiFontSize13}" />

                <BoxView
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    WidthRequest="{StaticResource UiDimension1}"
                    HeightRequest="{StaticResource UiDimension38}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                    Opacity="{StaticResource UiOpacitySubtle}"
                    VerticalOptions="End" />

                <Label
                    Grid.Row="0"
                    Grid.Column="2"
                    Text="{Binding NextPeriodValue, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource SectionTitle}"
                    FontSize="{StaticResource UiFontSize17}"
                    Margin="{StaticResource UiInsets12_0_0_0}" />
                <Label
                    Grid.Row="1"
                    Grid.Column="2"
                    Text="{loc:LocalizedText Dashboard_Phase_NextPeriod}"
                    Style="{StaticResource CaptionLabel}"
                    FontSize="{StaticResource UiFontSize13}"
                    Margin="{StaticResource UiInsets12_0_0_0}" />

                <BoxView
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="3"
                    WidthRequest="{StaticResource UiDimension1}"
                    HeightRequest="{StaticResource UiDimension38}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                    Opacity="{StaticResource UiOpacitySubtle}"
                    VerticalOptions="End" />

                <Label
                    Grid.Row="0"
                    Grid.Column="4"
                    Text="{Binding LoadAdjustmentText, Converter={StaticResource LocalizedStringConverter}}"
                    Style="{StaticResource SectionTitle}"
                    FontSize="{StaticResource UiFontSize17}"
                    Margin="{StaticResource UiInsets12_0_0_0}" />
                <Label
                    Grid.Row="1"
                    Grid.Column="4"
                    Text="{loc:LocalizedText Dashboard_Phase_Load}"
                    Style="{StaticResource CaptionLabel}"
                    FontSize="{StaticResource UiFontSize13}"
                    Margin="{StaticResource UiInsets12_0_0_0}" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
