<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Dashboard.DashboardWorkoutCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Dashboard"
    xmlns:workoutModels="clr-namespace:MuscleCuties.UI.Models.UI.Workout"
    x:DataType="vm:DashboardViewModel">

    <Border
        Style="{StaticResource CardPrimary}"
        SemanticProperties.Description="{Binding WorkoutTitle, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Dashboard_Workout_SemanticTodayPlan}">
        <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">

            <!-- Header Row: Icon Tile, Title/Badge, and Status Pill -->
            <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                <Border
                    WidthRequest="{StaticResource UiDimension42}"
                    HeightRequest="{StaticResource UiDimension42}"
                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                    StrokeShape="{StaticResource UiRoundRectangleRadius12}"
                    VerticalOptions="Center">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsRestDay}" Value="True">
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource RestDaySurfaceLight}, Dark={StaticResource RestDaySurfaceDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsRestDay}" Value="False">
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource AccentSurfaceDark}}" />
                        </DataTrigger>
                    </Border.Triggers>

                    <Grid HorizontalOptions="Center" VerticalOptions="Center">
                        <!-- Rest Day: Soothing Crescent Moon -->
                        <Path
                            Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                            Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension18}"
                            HeightRequest="{StaticResource UiDimension18}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            IsVisible="{Binding IsRestDay}" />

                        <!-- Workout Day: Dumbbell Icon -->
                        <Path
                            Data="M6.5 6.5h11M6.5 17.5h11M6.5 6.5v11M17.5 6.5v11M3 9.5h3.5v5H3zM17.5 9.5H21v5h-3.5z"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="{StaticResource UiStrokeWidth1_8}"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension18}"
                            HeightRequest="{StaticResource UiDimension18}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            IsVisible="{Binding IsRestDay, Converter={StaticResource InvertedBoolConverter}}" />
                    </Grid>
                </Border>

                <!-- Titles: Badge + Main Name -->
                <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource UiSpacing2}" VerticalOptions="Center">
                    <Label
                        Text="{Binding WorkoutBadgeText, Converter={StaticResource LocalizedStringConverter}}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                        Style="{StaticResource MutedLabel}"
                        VerticalOptions="Center" />
                    <Label
                        Text="{Binding WorkoutTitle, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource SectionTitle}"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Pill on the right: REST DAY or TRAINING -->
                <Border
                    Grid.Column="2"
                    StrokeShape="{StaticResource UiRoundRectangleRadius999}"
                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                    Padding="{StaticResource UiInsets10_4}"
                    VerticalOptions="Center">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsRestDay}" Value="True">
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource RestStatusBadgeSurfaceLight}, Dark={StaticResource RestStatusBadgeSurfaceDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsRestDay}" Value="False">
                            <Setter Property="BackgroundColor"
                                    Value="{Binding WorkoutActivityBackground}" />
                        </DataTrigger>
                    </Border.Triggers>

                    <Label
                        Style="{StaticResource CaptionLabel}"
                        VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsRestDay}" Value="True">
                                <Setter Property="Text" Value="REST DAY" />
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsRestDay}" Value="False">
                                <Setter Property="Text" Value="TRAINING" />
                                <Setter Property="TextColor" Value="{Binding WorkoutActivityTextColor}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </Grid>

            <!-- Activity Sections for Workout days -->
            <FlexLayout
                Wrap="Wrap"
                Direction="Row"
                BindableLayout.ItemsSource="{Binding WorkoutActivitySections}"
                IsVisible="{Binding IsRestDay, Converter={StaticResource InvertedBoolConverter}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="workoutModels:WorkoutActivitySection">
                        <Border
                            StrokeShape="{StaticResource UiRoundRectangleRadius999}"
                            StrokeThickness="{StaticResource UiStrokeWidth0}"
                            Padding="{StaticResource UiInsets8_3}"
                            Margin="{StaticResource UiInsets0_0_6_4}"
                            BackgroundColor="{Binding Background}">
                            <Label
                                Text="{Binding Title, Converter={StaticResource LocalizedStringConverter}}"
                                TextColor="{Binding TextColor}"
                                Style="{StaticResource CaptionLabel}"
                                VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- Subtitle -->
            <Label
                Text="{Binding WorkoutSubtitle, Converter={StaticResource LocalizedStringConverter}}"
                Style="{StaticResource MutedLabel}"
                LineBreakMode="WordWrap"
                Margin="{StaticResource UiInsets0_Minus4_0_0}" />

            <!-- Structured 3-column Visual Metric Tiles -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource UiSpaceTight}"
                  IsVisible="{Binding IsRestDay, Converter={StaticResource InvertedBoolConverter}}">
                <!-- Tile 1: Duration -->
                <Grid
                    Padding="{StaticResource UiInsets0_8}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpacing3}" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                            <Path
                                Data="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 5v5l3.5 2"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="{StaticResource UiStrokeWidth1_5}"
                                Aspect="Uniform"
                                WidthRequest="{StaticResource UiDimension12}"
                                HeightRequest="{StaticResource UiDimension12}"
                                VerticalOptions="Center" />
                            <Label
                                Text="{loc:LocalizedText Dashboard_Workout_Duration}"
                                Style="{StaticResource CaptionTinyStrong}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label
                            Text="{Binding WorkoutDurationText, Converter={StaticResource LocalizedStringConverter}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            Style="{StaticResource MutedLabel}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Tile 2: Exercises -->
                <Grid
                    Grid.Column="1"
                    Padding="{StaticResource UiInsets0_8}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpacing3}" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                            <Path
                                Data="M4 6h16M4 12h16M4 18h16"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="{StaticResource UiStrokeWidth1_5}"
                                Aspect="Uniform"
                                WidthRequest="{StaticResource UiDimension12}"
                                HeightRequest="{StaticResource UiDimension12}"
                                VerticalOptions="Center" />
                            <Label
                                Text="{Binding WorkoutCountLabel, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource CaptionTinyStrong}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label
                            Text="{Binding WorkoutCountValue, Converter={StaticResource LocalizedStringConverter}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            Style="{StaticResource MutedLabel}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Tile 3: Intensity -->
                <Grid
                    Grid.Column="2"
                    Padding="{StaticResource UiInsets0_8}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpacing3}" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                            <Path
                                Data="M13 2L3 14h9l-1 8 10-12h-9l1-8z"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="{StaticResource UiStrokeWidth1_5}"
                                Aspect="Uniform"
                                WidthRequest="{StaticResource UiDimension12}"
                                HeightRequest="{StaticResource UiDimension12}"
                                VerticalOptions="Center" />
                            <Label
                                Text="{loc:LocalizedText Dashboard_Workout_Intensity}"
                                Style="{StaticResource CaptionTinyStrong}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label
                            Text="{Binding WorkoutIntensity, Converter={StaticResource LocalizedStringConverter}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            Style="{StaticResource MutedLabel}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <!-- Rest Day Recovery Tip / Guidance (Only on Rest Day) -->
            <Border IsVisible="{Binding IsRestDay}" Style="{StaticResource CardSecondary}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpacing9}" VerticalOptions="Center">
                    <Path
                        Data="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4L2 9.4h7.6z"
                        Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}"
                        Aspect="Uniform"
                        WidthRequest="{StaticResource UiDimension14}"
                        HeightRequest="{StaticResource UiDimension14}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        Text="{loc:LocalizedText Dashboard_Workout_RestGuidance}"
                        Style="{StaticResource CaptionSmall}"
                        LineBreakMode="WordWrap"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Action Button -->
            <Button
                Style="{StaticResource ButtonPrimary}"
                Text="{loc:LocalizedText Dashboard_Workout_StartWorkout}"
                Command="{Binding StartWorkoutCommand}"
                SemanticProperties.Description="{loc:LocalizedText Dashboard_Workout_OpenTodayPlanA11y}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsRestDay}" Value="True">
                        <Setter Property="Text" Value="{loc:LocalizedText Dashboard_Workout_ViewRestDay}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

        </VerticalStackLayout>
    </Border>
</ContentView>
