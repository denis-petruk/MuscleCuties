<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Dashboard.DashboardTargetsCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Dashboard"
    x:DataType="vm:DashboardViewModel">

    <Border Style="{StaticResource CardPrimary}"
            SemanticProperties.Description="{loc:LocalizedText Dashboard_Targets_CardA11y}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource UiSpacing0}">
            <!-- Row 0: section heading -->
            <Label Text="{loc:LocalizedText Dashboard_Targets_Title}" Style="{StaticResource SectionTitle}" FontSize="{StaticResource UiFontSize17}"
                   Margin="{StaticResource UiInsets0_0_0_8}" />

            <!-- Row 1: hydration target row -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="{StaticResource UiSpacing14}" RowDefinitions="Auto, Auto"
                  RowSpacing="{StaticResource UiSpacing2}" Padding="{StaticResource UiInsets0_10}"
                  SemanticProperties.Description="{Binding HydrationConsumed, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Dashboard_Targets_HydrationFormat}">
                <Border
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    WidthRequest="{StaticResource UiDimension44}"
                    HeightRequest="{StaticResource UiDimension44}"
                    StrokeShape="{StaticResource UiRoundRectangleRadius12}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource WaterSurfaceLight}, Dark={StaticResource WaterSurfaceDark}}"
                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                    VerticalOptions="Center">
                    <Path
                        Data="M12 2.5s7 7.5 7 12a7 7 0 1 1-14 0c0-4.5 7-12 7-12z"
                        Fill="{AppThemeBinding Light={StaticResource WaterLight}, Dark={StaticResource WaterDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource WaterLight}, Dark={StaticResource WaterDark}}"
                        StrokeThickness="{StaticResource UiStrokeWidth0_5}"
                        Aspect="Uniform"
                        WidthRequest="{StaticResource UiDimension18}"
                        HeightRequest="{StaticResource UiDimension18}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{loc:LocalizedText Dashboard_Targets_HydrationEstimate}"
                    FontSize="{StaticResource UiFontSize13}"
                    FontAttributes="{StaticResource UiFontAttributesBold}"
                    LineBreakMode="WordWrap"
                    TextColor="{AppThemeBinding Light={StaticResource WaterLight}, Dark={StaticResource WaterDark}}" />
                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    FontSize="{StaticResource UiFontSize17}"
                    FontAttributes="{StaticResource UiFontAttributesBold}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span
                                Text="{Binding HydrationConsumed, Converter={StaticResource LocalizedStringConverter}}" />
                            <Span Text=" " />
                            <Span
                                Text="{Binding HydrationGoal, Converter={StaticResource LocalizedStringConverter}}"
                                FontSize="{StaticResource UiFontSize13}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                FontAttributes="{StaticResource UiFontAttributesNone}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>

            <!-- Row 2: divider -->
            <BoxView Grid.Row="2" HeightRequest="{StaticResource UiDimension1}"
                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                     Opacity="{StaticResource UiOpacitySubtle}" Margin="{StaticResource UiInsets0_4}" />

            <!-- Row 3: sleep target row -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="{StaticResource UiSpacing14}" RowDefinitions="Auto, Auto"
                  RowSpacing="{StaticResource UiSpacing2}" Padding="{StaticResource UiInsets0_10}"
                  SemanticProperties.Description="{Binding SleepGoal, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Dashboard_Targets_SleepFormat}">
                <Border
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    WidthRequest="{StaticResource UiDimension44}"
                    HeightRequest="{StaticResource UiDimension44}"
                    StrokeShape="{StaticResource UiRoundRectangleRadius12}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SleepSurfaceLight}, Dark={StaticResource SleepSurfaceDark}}"
                    StrokeThickness="{StaticResource UiStrokeWidth0}"
                    VerticalOptions="Center">
                    <Path
                        Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                        Fill="{AppThemeBinding Light={StaticResource SleepLight}, Dark={StaticResource SleepDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource SleepLight}, Dark={StaticResource SleepDark}}"
                        StrokeThickness="{StaticResource UiStrokeWidth0_5}"
                        Aspect="Uniform"
                        WidthRequest="{StaticResource UiDimension18}"
                        HeightRequest="{StaticResource UiDimension18}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{loc:LocalizedText Dashboard_Targets_SleepEstimate}"
                    FontSize="{StaticResource UiFontSize13}"
                    FontAttributes="{StaticResource UiFontAttributesBold}"
                    LineBreakMode="WordWrap"
                    TextColor="{AppThemeBinding Light={StaticResource SleepLight}, Dark={StaticResource SleepDark}}" />
                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    FontSize="{StaticResource UiFontSize17}"
                    FontAttributes="{StaticResource UiFontAttributesBold}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding SleepGoal, Converter={StaticResource LocalizedStringConverter}}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>
        </Grid>
    </Border>
</ContentView>
