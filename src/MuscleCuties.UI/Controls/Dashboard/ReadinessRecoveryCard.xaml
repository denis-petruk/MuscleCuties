<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Dashboard.ReadinessRecoveryCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Dashboard"
    x:DataType="{x:Type vm:DashboardViewModel}">

    <Border Style="{StaticResource CardPrimary}">
        <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="{loc:LocalizedText Dashboard_Readiness_Title}"
                           Style="{StaticResource SectionTitle}"
                           FontSize="17" />
                    <Label Text="{loc:LocalizedText Dashboard_Readiness_SelfReportedSubtitle}"
                           Style="{StaticResource CaptionLabel}"
                           FontSize="12" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        IsVisible="{Binding NeedsDailyCheckIn}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999"
                        Padding="10,4"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}">
                    <Label Text="{loc:LocalizedText Dashboard_Readiness_CheckInNeeded}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                </Border>
            </Grid>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding HasTodayReadinessScore}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{loc:LocalizedText Dashboard_Readiness_CheckInScore}"
                               Style="{StaticResource CaptionLabel}"
                               FontSize="12" />
                        <Label Text="{Binding TodayReadinessScoreText, Converter={StaticResource LocalizedStringConverter}}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding TodayReadinessBandText, Converter={StaticResource LocalizedStringConverter}}"
                               FontAttributes="Bold"
                               FontSize="15" />
                        <Label Text="{Binding TodayReadinessGuidanceText, Converter={StaticResource LocalizedStringConverter}}"
                               Style="{StaticResource BodyLabel}"
                               FontSize="13"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8"
                  IsVisible="{Binding HasTodayReadinessRecord}">
                    <Border Style="{StaticResource SurfaceTile}" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{loc:LocalizedText Dashboard_Readiness_RatingSleep}"
                                   Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1" Text="{Binding TodayReadinessSleepQualityText}"
                                   FontAttributes="Bold" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SurfaceTile}" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{loc:LocalizedText Dashboard_Readiness_RatingEnergy}"
                                   Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1" Text="{Binding TodayReadinessEnergyText}"
                                   FontAttributes="Bold" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource SurfaceTile}" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{loc:LocalizedText Dashboard_Readiness_RatingSoreness}"
                                   Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1" Text="{Binding TodayReadinessSorenessText}"
                                   FontAttributes="Bold" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SurfaceTile}" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{loc:LocalizedText Dashboard_Readiness_RatingStress}"
                                   Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1" Text="{Binding TodayReadinessStressText}"
                                   FontAttributes="Bold" />
                        </Grid>
                    </Border>
            </Grid>

            <Label Text="{loc:LocalizedText Dashboard_Readiness_ScoreExplanation}"
                   Style="{StaticResource CaptionLabel}"
                   FontSize="11"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding HasTodayReadinessScore}" />

            <Label Text="{loc:LocalizedText Dashboard_Readiness_NoCurrentCheckIn}"
                   Style="{StaticResource BodyLabel}"
                   FontSize="13"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding NeedsDailyCheckIn}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding TodayReadinessIncomplete}" Value="True">
                        <Setter Property="Text" Value="{loc:LocalizedText Dashboard_CheckIn_IncompleteAllFourRatings}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Label Text="{loc:LocalizedText Dashboard_Readiness_ReviewPending}"
                   Style="{StaticResource BodyLabel}"
                   FontSize="13"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding TodayReadinessReviewPending}" />

            <Button Text="{loc:LocalizedText Dashboard_Readiness_CompleteCheckIn}"
                    Command="{Binding OpenDailyCheckInCommand}"
                    IsVisible="{Binding NeedsDailyCheckIn}"
                    MinimumHeightRequest="46"
                    CornerRadius="{StaticResource UiRadiusControl}" />

            <Button Text="{loc:LocalizedText Dashboard_Readiness_ReviewChanges}"
                    Command="{Binding ReviewReadinessAdjustmentCommand}"
                    IsVisible="{Binding CanReviewReadiness}"
                    IsEnabled="{Binding IsReadinessProposalBusy, Converter={StaticResource InvertedBoolConverter}}"
                    MinimumHeightRequest="46"
                    CornerRadius="{StaticResource UiRadiusControl}" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsReadinessProposalVisible}">
                <ActivityIndicator IsRunning="{Binding IsReadinessProposalBusy}"
                                   IsVisible="{Binding IsReadinessProposalBusy}"
                                   Color="{StaticResource Primary}" />
                <Label Text="{Binding ReadinessProposalSummary}"
                       Style="{StaticResource BodyLabel}"
                       LineBreakMode="WordWrap" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ReadinessProposalChanges}"
                                     Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type x:String}">
                            <Label Text="{Binding .}" Style="{StaticResource BodyLabel}"
                                   LineBreakMode="WordWrap" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                      IsVisible="{Binding HasReadinessProposalActions}">
                    <Button Text="{loc:LocalizedText Dashboard_Readiness_ApplyChanges}"
                            Command="{Binding ApplyReadinessAdjustmentCommand}"
                            IsEnabled="{Binding IsReadinessProposalBusy, Converter={StaticResource InvertedBoolConverter}}"
                            MinimumHeightRequest="46" CornerRadius="{StaticResource UiRadiusControl}" />
                    <Button Grid.Column="1" Text="{loc:LocalizedText Dashboard_Readiness_KeepPlan}"
                            Command="{Binding KeepWorkoutPlanCommand}"
                            IsEnabled="{Binding IsReadinessProposalBusy, Converter={StaticResource InvertedBoolConverter}}"
                            MinimumHeightRequest="46" CornerRadius="{StaticResource UiRadiusControl}" />
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
