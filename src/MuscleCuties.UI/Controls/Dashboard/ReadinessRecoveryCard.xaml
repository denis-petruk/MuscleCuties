<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Dashboard.ReadinessRecoveryCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:dashboard="clr-namespace:MuscleCuties.UI.Controls.Dashboard"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Dashboard"
    x:DataType="{x:Type vm:DashboardViewModel}">

    <Border Style="{StaticResource CardPrimary}">
        <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" VerticalOptions="Center">
                <VerticalStackLayout Spacing="{StaticResource UiSpacing2}" VerticalOptions="Center">
                    <Label Text="{loc:LocalizedText Dashboard_Readiness_Title}"
                           Style="{StaticResource SectionTitle}"
                           />
                    <Label Text="{Binding ReadinessSubtitleText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource CaptionSmall}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        Style="{StaticResource PillBadge}"
                        IsVisible="{Binding NeedsDailyCheckIn}"
                        Padding="{StaticResource UiInsets10_4}"
                        VerticalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource RestStatusBadgeSurfaceLight}, Dark={StaticResource RestStatusBadgeSurfaceDark}}">
                    <Label Text="{loc:LocalizedText Dashboard_Readiness_CheckInNeeded}"
                           Style="{StaticResource CaptionLabel}"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}" />
                </Border>
            </Grid>

            <Border Style="{StaticResource CardSecondary}"
                    IsVisible="{Binding HasTodayReadinessRecord, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}" HorizontalOptions="Center">
                    <Label Text="{loc:LocalizedText Dashboard_Readiness_CheckInPrompt}"
                           Style="{StaticResource BodyStrong}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource UiSpaceCompact}" Padding="{StaticResource UiInsets0_4}"
                  IsVisible="{Binding HasTodayReadinessRecord}">
                <Border Style="{StaticResource CardSecondary}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}" HorizontalOptions="Center">
                        <Grid WidthRequest="{StaticResource UiDimension88}" HeightRequest="{StaticResource UiDimension88}" HorizontalOptions="Center">
                            <dashboard:DashboardProgressRing WidthRequest="{StaticResource UiDimension88}"
                                                             HeightRequest="{StaticResource UiDimension88}"
                                                             Progress="{Binding ReadinessProgress}"
                                                             RingColor="{StaticResource Primary}" />
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="{StaticResource UiSpacing0}">
                                <Label Text="{Binding ReadinessScore}"
                                       Style="{StaticResource MetricValue}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{loc:LocalizedText Dashboard_ReadinessScoreSuffix}"
                                       Style="{StaticResource CaptionTinyCentered}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{loc:LocalizedText Dashboard_Readiness_ReadinessLabel}"
                               Style="{StaticResource BodyStrong}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding ReadinessLabel, Converter={StaticResource LocalizedStringConverter}}"
                               Style="{StaticResource CaptionSmallCentered}"
                               HorizontalOptions="Center"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardSecondary}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceTight}" HorizontalOptions="Center">
                        <Grid WidthRequest="{StaticResource UiDimension88}" HeightRequest="{StaticResource UiDimension88}" HorizontalOptions="Center">
                            <dashboard:DashboardProgressRing WidthRequest="{StaticResource UiDimension88}"
                                                             HeightRequest="{StaticResource UiDimension88}"
                                                             Progress="{Binding RecoveryProgress}"
                                                             RingColor="{StaticResource PrimaryDark}" />
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="{StaticResource UiSpacing0}">
                                <Label Text="{Binding RecoveryScore}"
                                       Style="{StaticResource MetricValue}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{loc:LocalizedText Dashboard_ReadinessScoreSuffix}"
                                       Style="{StaticResource CaptionTinyCentered}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{loc:LocalizedText Dashboard_Readiness_RecoveryLabel}"
                               Style="{StaticResource BodyStrong}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding RecoveryLabel, Converter={StaticResource LocalizedStringConverter}}"
                               Style="{StaticResource CaptionSmallCentered}"
                               HorizontalOptions="Center"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" IsVisible="{Binding HasTodayReadinessScore}">
                <Label Text="{Binding TodayReadinessBandText, Converter={StaticResource LocalizedStringConverter}}"
                       Style="{StaticResource BodyStrong}" />
                <Label Text="{Binding TodayReadinessGuidanceText, Converter={StaticResource LocalizedStringConverter}}"
                       Style="{StaticResource BodyCompact}"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource UiSpaceTight}"
                  IsVisible="{Binding HasTodayReadinessRecord}">
                <Border Style="{StaticResource CardSecondary}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpacing6}">
                        <Label Text="{loc:LocalizedText Dashboard_Readiness_RatingSleep}"
                               Style="{StaticResource CaptionLabel}" />
                        <Label Grid.Column="1" Text="{Binding TodayReadinessSleepQualityText}"
                               FontAttributes="{StaticResource UiFontAttributesBold}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardSecondary}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpacing6}">
                        <Label Text="{loc:LocalizedText Dashboard_Readiness_RatingEnergy}"
                               Style="{StaticResource CaptionLabel}" />
                        <Label Grid.Column="1" Text="{Binding TodayReadinessEnergyText}"
                               FontAttributes="{StaticResource UiFontAttributesBold}" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardSecondary}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpacing6}">
                        <Label Text="{loc:LocalizedText Dashboard_Readiness_RatingSoreness}"
                               Style="{StaticResource CaptionLabel}" />
                        <Label Grid.Column="1" Text="{Binding TodayReadinessSorenessText}"
                               FontAttributes="{StaticResource UiFontAttributesBold}" />
                    </Grid>
                </Border>
            </Grid>

            <Label Text="{loc:LocalizedText Dashboard_Readiness_ScoreExplanation}"
                   Style="{StaticResource CaptionTiny}"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding HasTodayReadinessScore}" />

            <Label Text="{loc:LocalizedText Dashboard_Readiness_NoCurrentCheckIn}"
                   Style="{StaticResource BodyCompact}"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding NeedsDailyCheckIn}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding TodayReadinessIncomplete}" Value="True">
                        <Setter Property="Text" Value="{loc:LocalizedText Dashboard_CheckIn_IncompleteAllFourRatings}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Label Text="{loc:LocalizedText Dashboard_Readiness_ReviewPending}"
                   Style="{StaticResource BodyCompact}"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding TodayReadinessReviewPending}" />

            <Button Style="{StaticResource ButtonSecondary}" Text="{loc:LocalizedText Dashboard_Readiness_CompleteCheckIn}"
                    Command="{Binding OpenDailyCheckInCommand}"
                    IsVisible="{Binding NeedsDailyCheckIn}" />

        </VerticalStackLayout>
    </Border>
</ContentView>
