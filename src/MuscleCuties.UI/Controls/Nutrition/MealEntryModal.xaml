<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Nutrition.MealEntryModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition"
    xmlns:nutritionEnums="clr-namespace:MuscleCuties.Core.Models.Enums.Nutrition;assembly=MuscleCuties.Core"
    xmlns:uiModels="clr-namespace:MuscleCuties.UI.Models.UI.Nutrition"
    x:DataType="vm:NutritionViewModel"
    IsOpen="{Binding IsMealEntryModalVisible}"
    Padding="{StaticResource UiInsets0}">

    <Grid>
        <BoxView Style="{StaticResource ModalBackdrop}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMealEntryCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border
            x:Name="SheetSurface"
            Style="{StaticResource ModalSurface}" MaximumHeightRequest="{StaticResource ModalSheetMaximumHeight}" VerticalOptions="End">

            <Grid RowDefinitions="Auto, *">
                <Grid
                    Padding="{DynamicResource PresentationModalHeaderPadding}"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="{StaticResource UiSpaceCompact}">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}">
                        <Label
                            Text="{loc:LocalizedText Nutrition_MealEntry_Title}"
                            Style="{StaticResource ModalTitle}" />
                        <Label
                            Text="{loc:LocalizedText Nutrition_MealEntry_Subtitle}"
                            Style="{StaticResource ModalSubtitle}" />
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource ModalIconButton}"
                        VerticalOptions="Start"
                        SemanticProperties.Description="{loc:LocalizedText Common_Close}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseMealEntryCommand}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>

                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Default">
                    <VerticalStackLayout Spacing="{StaticResource UiSpacing14}" Padding="{DynamicResource PresentationModalPagePadding}">

                        <Label
                            Text="{loc:LocalizedText Nutrition_MealEntry_MealTypeChangeIfNeeded}"
                            Style="{StaticResource SectionTitle}"
                            LineBreakMode="WordWrap" />

                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="{StaticResource UiSpacing10}"
                            RowSpacing="{StaticResource UiSpacing10}">

                            <Border Style="{StaticResource CardSecondary}" MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEntry_BreakfastMealType}"
                                    SemanticProperties.Hint="{loc:LocalizedText Common_NotSelected}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsEntryBreakfastSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedSurfaceLight}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                        <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth2}" />
                                        <Setter Property="SemanticProperties.Hint" Value="{loc:LocalizedText Common_Selected}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectEntryMealTypeCommand}"
                                        CommandParameter="{x:Static nutritionEnums:MealType.Breakfast}" />
                                </Border.GestureRecognizers>
                                <Label Text="{loc:LocalizedText Nutrition_MealType_Breakfast}"
                                       Style="{StaticResource BodyStrong}" LineBreakMode="WordWrap"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardSecondary}"
                                    MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEntry_LunchMealType}"
                                    SemanticProperties.Hint="{loc:LocalizedText Common_NotSelected}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsEntryLunchSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedSurfaceLight}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                        <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth2}" />
                                        <Setter Property="SemanticProperties.Hint" Value="{loc:LocalizedText Common_Selected}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectEntryMealTypeCommand}"
                                        CommandParameter="{x:Static nutritionEnums:MealType.Lunch}" />
                                </Border.GestureRecognizers>
                                <Label Text="{loc:LocalizedText Nutrition_MealType_Lunch}"
                                       Style="{StaticResource BodyStrong}" LineBreakMode="WordWrap"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource CardSecondary}"
                                    MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEntry_DinnerMealType}"
                                    SemanticProperties.Hint="{loc:LocalizedText Common_NotSelected}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsEntryDinnerSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedSurfaceLight}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                        <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth2}" />
                                        <Setter Property="SemanticProperties.Hint" Value="{loc:LocalizedText Common_Selected}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectEntryMealTypeCommand}"
                                        CommandParameter="{x:Static nutritionEnums:MealType.Dinner}" />
                                </Border.GestureRecognizers>
                                <Label Text="{loc:LocalizedText Nutrition_MealType_Dinner}"
                                       Style="{StaticResource BodyStrong}" LineBreakMode="WordWrap"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardSecondary}"
                                    MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEntry_SnackMealType}"
                                    SemanticProperties.Hint="{loc:LocalizedText Common_NotSelected}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsEntrySnackSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedSurfaceLight}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                        <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth2}" />
                                        <Setter Property="SemanticProperties.Hint" Value="{loc:LocalizedText Common_Selected}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectEntryMealTypeCommand}"
                                        CommandParameter="{x:Static nutritionEnums:MealType.Snack}" />
                                </Border.GestureRecognizers>
                                <Label Text="{loc:LocalizedText Nutrition_MealType_Snack}"
                                       Style="{StaticResource BodyStrong}" LineBreakMode="WordWrap"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <Label Text="{loc:LocalizedText Nutrition_MealEditor_Time}"
                               Style="{StaticResource FormFieldLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <TimePicker Time="{Binding EntryMealTime}" Format="t"
                                        SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEditor_MealTime}" />
                        </Border>

                        <Button
                            Style="{StaticResource ButtonPrimary}"
                            Text="{loc:LocalizedText Nutrition_Page_AddMeal}"
                            Command="{Binding StartManualMealCommand}"
                            IsEnabled="{Binding HasEntryMealTypeSelected}"
                            LineBreakMode="WordWrap"
                            Margin="{StaticResource UiInsets0}"
                            SemanticProperties.Description="{loc:LocalizedText Nutrition_Page_AddMeal}"
                            SemanticProperties.Hint="{loc:LocalizedText Nutrition_MealEntry_OpensFoodSearchToLogFoods}" />

                        <Button
                            Text="{loc:LocalizedText Nutrition_MealEntry_SuggestMeal}"
                            Command="{Binding StartSuggestedMealCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            LineBreakMode="WordWrap"
                            Margin="{StaticResource UiInsets0}"
                            SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEntry_SuggestMeal}"
                            SemanticProperties.Hint="{loc:LocalizedText Nutrition_MealEntry_OpensMealSuggestionsTailoredToYour}" />

                        <Button
                            Text="{loc:LocalizedText Nutrition_MealEntry_UseFromTemplate}"
                            Command="{Binding ToggleTemplatePickerCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            LineBreakMode="WordWrap"
                            Margin="{StaticResource UiInsets0}"
                            SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEntry_UseFromTemplate}"
                            SemanticProperties.Hint="{loc:LocalizedText Nutrition_MealEntry_UseFromTemplateHint}" />

                        <VerticalStackLayout
                            IsVisible="{Binding IsTemplatePickerVisible}"
                            Spacing="{StaticResource UiSpaceTight}"
                            IsEnabled="{Binding IsWritingMealEntry, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="{loc:LocalizedText Nutrition_MealEntry_TemplatePickerTitle}"
                                   Style="{StaticResource FormFieldLabel}" LineBreakMode="WordWrap" />

                            <ActivityIndicator
                                Style="{StaticResource StateBusyInline}"
                                IsRunning="{Binding IsLoadingMealTemplates}"
                                IsVisible="{Binding IsLoadingMealTemplates}" />

                            <Label
                                Text="{Binding MealTemplateStatus}"
                                IsVisible="{Binding HasMealTemplateStatus}"
                                Style="{StaticResource MutedLabel}"
                                LineBreakMode="WordWrap" />

                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding MealTemplates}"
                                Spacing="{StaticResource UiSpaceTight}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="uiModels:MealTemplate">
                                        <Border Style="{StaticResource CardSecondary}">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceTight}"
                                                  MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}">
                                                <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" LineBreakMode="WordWrap" />
                                                    <Label Text="{Binding TotalCalories, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_Format_CaloriesValueKcal}"
                                                           Style="{StaticResource MutedLabel}" />
                                                    <Label Text="{Binding ItemCount, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_Template_ItemCountFormat}"
                                                           Style="{StaticResource CaptionLabel}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1"
                                                        Text="{loc:LocalizedText Nutrition_Template_Log}"
                                                        Style="{StaticResource ButtonSecondary}"
                                                        Command="{Binding LogMealTemplateCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}"
                                                        CommandParameter="{Binding .}"
                                                        VerticalOptions="Center"
                                                        SemanticProperties.Description="{Binding Name}"
                                                        SemanticProperties.Hint="{loc:LocalizedText Nutrition_MealEntry_LogTemplateHint}" />
                                                <Border Grid.Column="2"
                                                        Style="{StaticResource ModalIconButton}"
                                                        VerticalOptions="Center"
                                                        SemanticProperties.Description="{loc:LocalizedText Common_Delete}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding DeleteMealTemplateCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Path Data="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 10v6M14 10v6"
                                                          Style="{StaticResource NutritionLineIcon}"
                                                          WidthRequest="{StaticResource UiDimension16}"
                                                          HeightRequest="{StaticResource UiDimension16}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
