<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Nutrition.MealSuggestionModal"
    x:Name="SuggestionRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.UI.Models.UI.Nutrition"
    xmlns:nutritionEnums="clr-namespace:MuscleCuties.Core.Models.Enums.Nutrition;assembly=MuscleCuties.Core"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition"
    x:DataType="vm:NutritionViewModel"
    IsOpen="{Binding IsSuggestionModalVisible}">

    <Grid BackgroundColor="{StaticResource ModalScrim}">
        <BoxView Style="{StaticResource ModalDismissTarget}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseSuggestionModalCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border
            x:Name="SheetSurface"
            Style="{StaticResource ModalSurface}" VerticalOptions="End">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto,Auto"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="{StaticResource UiSpacing10}"
                    RowSpacing="{StaticResource UiSpaceMicro}"
                    Padding="{StaticResource UiInsets20_18_20_12}">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="{Binding SuggestionPageTitle, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ModalTitle}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="{Binding SuggestionTargetText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ModalSubtitle}"
                        IsVisible="{Binding IsDayPlanMode, Converter={StaticResource InvertedBoolConverter}}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="{Binding DayPlanSummaryText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ModalSubtitle}"
                        IsVisible="{Binding IsDayPlanMode}" />

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        Style="{StaticResource ModalIconButton}"
                        VerticalOptions="Start"
                        IsVisible="{Binding ShowSuggestionResults}"
                        SemanticProperties.Description="{loc:LocalizedText Nutrition_MealSuggestion_RefreshMealSuggestions}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RefreshSuggestionsCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Data="M17.65 6.35A7.958 7.958 0 0012 4a8 8 0 00-8 8 8 8 0 008 8 7.985 7.985 0 005.93-2.65l-1.46-1.46A5.98 5.98 0 0112 18a6 6 0 01-6-6 6 6 0 016-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                            Fill="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextPrimaryDark}}"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension18}"
                            HeightRequest="{StaticResource UiDimension18}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Border
                        Grid.Row="0"
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        Style="{StaticResource ModalIconButton}"
                        VerticalOptions="Start"
                        SemanticProperties.Description="{loc:LocalizedText Nutrition_MealSuggestion_CloseSuggestions}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseSuggestionModalCommand}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>

                <BoxView
                    Grid.Row="1"
                    Style="{StaticResource ModalDivider}" />

                <Grid
                    Grid.Row="2"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="{StaticResource UiSpacing10}"
                    IsVisible="{Binding IsLoadingSuggestions}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    SemanticProperties.Description="{loc:LocalizedText Nutrition_MealSuggestion_FindingMealIdeasFromUsdaFoods}">
                    <ActivityIndicator
                        Grid.Row="0"
                        IsRunning="{Binding IsLoadingSuggestions}"
                        Color="{StaticResource Primary}"
                        WidthRequest="{StaticResource UiDimension32}"
                        HeightRequest="{StaticResource UiDimension32}" />
                    <Label Grid.Row="1"
                           Text="{Binding LoadingSuggestionText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource ModalSubtitle}" />
                </Grid>

                <ScrollView
                    Grid.Row="2"
                    IsVisible="{Binding HasMealSuggestionError}">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="{StaticResource UiSpaceCompact}"
                          Padding="{StaticResource UiInsets28_32}">
                        <Path
                            Grid.Row="0"
                            Data="M3 2v7c0 1.1.9 2 2 2h2c1.1 0 2-.9 2-2V2M6 2v20M15 2v8h4M19 2v20"
                            Style="{StaticResource NutritionLineIcon}"
                            Stroke="{StaticResource Primary}"
                            WidthRequest="{StaticResource UiDimension32}"
                            HeightRequest="{StaticResource UiDimension32}"
                            HorizontalOptions="Center" />
                        <Label
                            Grid.Row="1"
                            Text="{Binding MealSuggestionError, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource ModalSubtitle}"
                            HorizontalTextAlignment="Center" />
                        <Button
                            Grid.Row="2"
                            Text="{loc:LocalizedText Common_TryAgain}"
                            Command="{Binding RefreshSuggestionsCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            HorizontalOptions="Center"
                            WidthRequest="{StaticResource UiDimension152}" />
                    </Grid>
                </ScrollView>

                <ScrollView
                    Grid.Row="2"
                    IsVisible="{Binding HasNoMealSuggestions}">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="{StaticResource UiSpacing10}"
                          Padding="{StaticResource UiInsets24_32}">
                        <Path
                            Grid.Row="0"
                            Data="M12 21V8M12 11c-3 0-5-2-5-5 3 0 5 2 5 5ZM12 15c3 0 5-2 5-5-3 0-5 2-5 5ZM12 19c-3 0-5-2-5-5 3 0 5 2 5 5"
                            Style="{StaticResource NutritionLineIcon}"
                            Stroke="{StaticResource Primary}"
                            WidthRequest="{StaticResource UiDimension32}"
                            HeightRequest="{StaticResource UiDimension32}"
                            HorizontalOptions="Center" />
                        <Label
                            Grid.Row="1"
                            Text="{loc:LocalizedText Nutrition_MealSuggestion_NoCloseMatchYet}"
                            Style="{StaticResource BodyStrong}"
                            HorizontalTextAlignment="Center"
                            HorizontalOptions="Center" />
                        <Label
                            Grid.Row="2"
                            Text="{loc:LocalizedText Nutrition_MealSuggestion_TryAnotherMealOrRefreshThe}"
                            Style="{StaticResource ModalSubtitle}"
                            HorizontalTextAlignment="Center"
                            HorizontalOptions="Center" />
                    </Grid>
                </ScrollView>

                <CollectionView
                    x:Name="SuggestionCollection"
                    Grid.Row="2"
                    ItemsSource="{Binding MealSuggestions}"
                    ItemSizingStrategy="MeasureAllItems"
                    SelectionMode="None"
                    IsVisible="{Binding HasMealSuggestions}"
                    VerticalScrollBarVisibility="Default"
                    Margin="{StaticResource UiInsets20_12_20_20}"
                    SizeChanged="OnSuggestionsSizeChanged">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            x:Name="SuggestionLayout"
                            Orientation="Vertical"
                            Span="2"
                            HorizontalItemSpacing="{StaticResource UiSpacing10}"
                            VerticalItemSpacing="{StaticResource UiSpacing10}" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="nutritionModels:MealSuggestionItem">
                            <Border Style="{StaticResource CardSecondary}">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*"
                                      ColumnSpacing="{StaticResource UiSpaceTight}" RowSpacing="{StaticResource UiSpaceMicro}">
                                    <Path
                                        Data="{Binding IconPathData, Converter={StaticResource StringToGeometryConverter}}"
                                        Style="{StaticResource NutritionLineIcon}"
                                        WidthRequest="{StaticResource UiDimension18}"
                                        HeightRequest="{StaticResource UiDimension18}"
                                        VerticalOptions="Center" />
                                     <Label
                                        Grid.Column="1"
                                        Text="{Binding ConceptName, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource CardTitle}"
                                        FontSize="{StaticResource UiFontSize17}"
                                        LineBreakMode="WordWrap" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding ConceptDescription, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource MutedLabel}"
                                        LineBreakMode="WordWrap" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding ComponentSummary, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource MutedLabel}"
                                        LineBreakMode="WordWrap" />

                                    <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto"
                                          ColumnSpacing="{StaticResource UiSpacing6}">
                                        <Border
                                            StrokeShape="{StaticResource UiRoundRectangleRadius999}"
                                            StrokeThickness="{StaticResource UiStrokeWidth0}"
                                            Padding="{StaticResource UiInsets8_3}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}">
                                            <Label
                                                Text="{Binding StyleLabel, Converter={StaticResource LocalizedStringConverter}}"
                                                Style="{StaticResource CaptionStrong}"
                                                TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                                                FontSize="{StaticResource UiFontSize13}" />
                                        </Border>
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding CaloriesText, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionStrong}"
                                            FontSize="{StaticResource UiFontSize13}"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <Label
                                        Grid.Row="4"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding MacrosText, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
                                    <Button
                                        Grid.Row="5"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource ButtonPrimary}"
                                        Text="{loc:LocalizedText Nutrition_MealSuggestion_ViewMeal}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, Path=OpenMealDetailCommand, x:DataType=vm:NutritionViewModel}"
                                        CommandParameter="{Binding .}"
                                        Margin="{StaticResource UiInsets0_4_0_0}"
                                        SemanticProperties.Description="{loc:LocalizedText Nutrition_MealSuggestion_ViewMealDetails}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <ScrollView
                    Grid.Row="2"
                    IsVisible="{Binding HasNoDayPlanMeals}">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="{StaticResource UiSpacing10}"
                          Padding="{StaticResource UiInsets24_32}">
                        <Label
                            Grid.Row="0"
                            Text="{loc:LocalizedText Nutrition_MealSuggestion_NoMealsLeftToPlan}"
                            Style="{StaticResource BodyStrong}"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Grid.Row="1"
                            Text="{loc:LocalizedText Nutrition_MealSuggestion_YourLoggedMealsHaveUsedToday}"
                            Style="{StaticResource ModalSubtitle}"
                            HorizontalTextAlignment="Center" />
                    </Grid>
                </ScrollView>

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding DayPlanMeals}"
                    ItemSizingStrategy="MeasureAllItems"
                    SelectionMode="None"
                    IsVisible="{Binding ShowDayPlanMeals}"
                    VerticalScrollBarVisibility="Default"
                    Margin="{StaticResource UiInsets20_12_20_20}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource UiSpacing10}" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="nutritionModels:DayMealPlanItem">
                            <Border Style="{StaticResource CardSecondary}">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="{StaticResource UiSpaceTight}" RowSpacing="{StaticResource UiSpacing5}">
                                    <Path
                                        Data="{Binding MealTypeIconPathData, Converter={StaticResource StringToGeometryConverter}}"
                                        Style="{StaticResource NutritionLineIcon}"
                                        Stroke="{StaticResource Primary}"
                                        WidthRequest="{StaticResource UiDimension18}"
                                        HeightRequest="{StaticResource UiDimension18}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding MealTypeLabel, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource FormFieldLabel}"
                                        FontSize="{StaticResource UiFontSize13}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding TargetSummaryText, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource CaptionStrong}"
                                        HorizontalTextAlignment="End"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.ColumnSpan="3"
                                        Text="{Binding MealTitle, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource CardTitle}"
                                        FontSize="{StaticResource UiFontSize17}"
                                        LineBreakMode="WordWrap" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        Text="{Binding MealSummaryText, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource MutedLabel}"
                                        LineBreakMode="WordWrap" />
                                    <Label
                                        Grid.Row="3"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding MacrosText, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource MutedLabel}"
                                        IsVisible="{Binding HasSuggestion}" />
                                    <Grid
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        ColumnDefinitions="Auto,Auto"
                                        ColumnSpacing="{StaticResource UiSpaceTight}"
                                        VerticalOptions="End"
                                        HorizontalOptions="End">
                                        <Button
                                            Style="{StaticResource ButtonPrimary}"
                                            Text="{loc:LocalizedText Nutrition_MealSuggestion_UseMeal}"
                                            Command="{Binding UsePlannedMealCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding HasSuggestion}"
                                            SemanticProperties.Description="{Binding MealTitle, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_MealSuggestion_UseValue}"
                                            SemanticProperties.Hint="{loc:LocalizedText Nutrition_MealSuggestion_LogsThisSuggestedMealForToday}" />
                                        <Border
                                            Grid.Column="1"
                                            Style="{StaticResource ModalIconButton}"
                                            IsEnabled="{Binding CanRefresh}"
                                            IsVisible="{Binding CanRefresh}"
                                            SemanticProperties.Description="{Binding MealTypeLabel, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_MealSuggestion_FindAnotherValueIdea}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding RefreshDayMealCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Path
                                                Data="M17.65 6.35A7.958 7.958 0 0012 4a8 8 0 00-8 8 8 8 0 008 8 7.985 7.985 0 005.93-2.65l-1.46-1.46A5.98 5.98 0 0112 18a6 6 0 01-6-6 6 6 0 016-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                                Fill="{StaticResource Primary}"
                                                Aspect="Uniform"
                                                WidthRequest="{StaticResource UiDimension17}"
                                                HeightRequest="{StaticResource UiDimension17}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
