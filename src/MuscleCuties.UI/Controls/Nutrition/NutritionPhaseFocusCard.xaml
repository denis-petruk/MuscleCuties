<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Nutrition.NutritionPhaseFocusCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition"
    x:DataType="vm:NutritionViewModel">

    <Border
        Background="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToBrushConverter}}"
        Stroke="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
        StrokeShape="{StaticResource UiRoundRectangleRadius16}"
        StrokeThickness="{StaticResource UiStrokeWidth1}"
        Padding="{StaticResource UiInsets18_14}">
        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="{StaticResource UiSpacing3}" ColumnSpacing="{StaticResource UiSpaceCompact}">
            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="{StaticResource UiSpacing6}" VerticalOptions="Center">
                <BoxView
                    WidthRequest="{StaticResource UiDimension6}"
                    HeightRequest="{StaticResource UiDimension6}"
                    CornerRadius="{StaticResource UiCornerRadius3}"
                    BackgroundColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                    VerticalOptions="Center" />
                <Label
                    Text="{Binding PhaseFocusBadgeText, Converter={StaticResource LocalizedStringConverter}}"
                    TextColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                    FontSize="{StaticResource UiFontSize12}"
                    FontAttributes="{StaticResource UiFontAttributesBold}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border
                Grid.Row="0"
                Grid.Column="1"
                Grid.RowSpan="3"
                WidthRequest="{StaticResource UiDimension36}"
                HeightRequest="{StaticResource UiDimension36}"
                StrokeShape="{StaticResource UiRoundRectangleRadius18}"
                BackgroundColor="{StaticResource WhiteOverlaySubtle}"
                Stroke="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                StrokeThickness="{StaticResource UiStrokeWidth1}"
                VerticalOptions="Center"
                SemanticProperties.Description="{loc:LocalizedText Nutrition_PhaseFocus_CurrentCyclePhaseIcon}">
                <Image
                    Source="{Binding CurrentPhaseIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                    WidthRequest="{StaticResource UiDimension16}"
                    HeightRequest="{StaticResource UiDimension16}"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Label
                Grid.Row="1"
                Grid.Column="0"
                Text="{Binding PhaseFocusTitle, Converter={StaticResource LocalizedStringConverter}}"
                TextColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                FontSize="{StaticResource UiFontSize18}"
                FontAttributes="{StaticResource UiFontAttributesBold}"
                LineBreakMode="WordWrap" />
            <Label
                Grid.Row="2"
                Grid.Column="0"
                Text="{Binding PhaseFocusCopy, Converter={StaticResource LocalizedStringConverter}}"
                TextColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                FontSize="{StaticResource UiFontSize13}"
                LineBreakMode="WordWrap" />
        </Grid>
    </Border>
</ContentView>
