<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Nutrition.QuickFoodItemRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:uiModels="clr-namespace:MuscleCuties.UI.Models.UI.Nutrition;assembly=MuscleCuties.UI"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition;assembly=MuscleCuties.UI"
    x:DataType="uiModels:QuickFoodItemUiModel">

    <Border
        StrokeShape="{StaticResource UiRoundRectangleRadius10}"
        Padding="{StaticResource UiInsets10_8}"
        MinimumHeightRequest="{StaticResource UiDimension44}"
        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
        StrokeThickness="{StaticResource UiStrokeWidth1}">

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource UiSpacing10}" RowSpacing="{StaticResource UiSpacing6}">
            <!-- Multi-Select Checkbox -->
            <Border Style="{StaticResource SelectionCheckbox}" Grid.RowSpan="2" Grid.Column="0"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding ToggleQuickFoodSelectionCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                        CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Path Data="M3 7L6 10L13 3"
                      Stroke="{StaticResource White}" StrokeThickness="{StaticResource UiStrokeWidth2}"
                      HorizontalOptions="Center" VerticalOptions="Center"
                      IsVisible="{Binding IsSelected}" />
            </Border>

            <!-- Name and details -->
            <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}" VerticalOptions="Center">
                <Label Grid.Row="0" Text="{Binding Name}" FontSize="{StaticResource UiFontSize13}" FontAttributes="{StaticResource UiFontAttributesBold}"
                       LineBreakMode="TailTruncation" />
                <Label Grid.Row="1" Text="{Binding Detail, Converter={StaticResource LocalizedStringConverter}}"
                       FontSize="{StaticResource UiFontSize11}" LineBreakMode="TailTruncation" />
            </Grid>
            <Label Grid.Row="0" Grid.Column="2"
                   Text="{Binding Calories, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_Format_CaloriesValueKcal}"
                   FontSize="{StaticResource UiFontSize12}" VerticalOptions="Center" />
            <Button Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource ButtonSecondary}"
                    Text="{loc:LocalizedText Common_Edit}"
                    Command="{Binding SelectQuickFoodCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                    CommandParameter="{Binding .}" />
            <Button Style="{StaticResource ButtonSecondary}" Grid.Row="1" Grid.Column="3"
                    Text="{loc:LocalizedText Nutrition_QuickFood_Log}"
                    Command="{Binding QuickLogFoodCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                    CommandParameter="{Binding .}"
                    VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
