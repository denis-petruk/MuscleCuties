<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Nutrition.QuickFoodItemRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:uiModels="clr-namespace:MuscleCuties.UI.Models.UI.Nutrition;assembly=MuscleCuties.UI"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition;assembly=MuscleCuties.UI"
    x:DataType="uiModels:QuickFoodItemUiModel">

    <Border
        StrokeShape="RoundRectangle 10"
        Padding="10,8"
        MinimumHeightRequest="44"
        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
        StrokeThickness="1">

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
            <!-- Multi-Select Checkbox -->
            <Border Grid.RowSpan="2" Grid.Column="0"
                    WidthRequest="28" HeightRequest="28"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1.5"
                    Stroke="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding ToggleQuickFoodSelectionCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                        CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}" />
                        <Setter Property="Stroke" Value="{StaticResource PrimaryDark}" />
                    </DataTrigger>
                </Border.Triggers>
                <Path Data="M3 7L6 10L13 3"
                      Stroke="White" StrokeThickness="2"
                      HorizontalOptions="Center" VerticalOptions="Center"
                      IsVisible="{Binding IsSelected}" />
            </Border>

            <!-- Name and details -->
            <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2" VerticalOptions="Center">
                <Label Grid.Row="0" Text="{Binding Name}" FontSize="13" FontAttributes="Bold"
                       LineBreakMode="TailTruncation" />
                <Label Grid.Row="1" Text="{Binding Detail, Converter={StaticResource LocalizedStringConverter}}"
                       FontSize="11" LineBreakMode="TailTruncation" />
            </Grid>
            <Label Grid.Row="0" Grid.Column="2"
                   Text="{Binding Calories, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_Format_CaloriesValueKcal}"
                   FontSize="12" VerticalOptions="Center" />
            <Button Grid.Row="1" Grid.Column="2" Text="{loc:LocalizedText Common_Edit}"
                    Command="{Binding SelectQuickFoodCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                    CommandParameter="{Binding .}" MinimumHeightRequest="44" Padding="8,0" />
            <Button Grid.Row="1" Grid.Column="3"
                    Text="{loc:LocalizedText Nutrition_QuickFood_Log}"
                    Command="{Binding QuickLogFoodCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                    CommandParameter="{Binding .}"
                    MinimumHeightRequest="44"
                    Padding="8,0"
                    CornerRadius="6"
                    FontSize="11"
                    FontAttributes="Bold"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                    VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
