<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Nutrition.NutritionBreakdownModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:controls="clr-namespace:MuscleCuties.UI.Controls"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.UI.Models.UI.Nutrition"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition"
    x:DataType="vm:NutritionViewModel"
    IsOpen="{Binding IsBreakdownModalVisible}">

    <Grid Padding="0">
        <BoxView BackgroundColor="{StaticResource ModalScrim}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMicronutrientsModalCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border
            x:Name="SheetSurface"
            Style="{StaticResource AppBottomSheetSurface}"
            HorizontalOptions="Fill"
            VerticalOptions="End">

            <Grid RowDefinitions="Auto, Auto, *">
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*, Auto"
                    RowDefinitions="Auto, Auto"
                    ColumnSpacing="12"
                    RowSpacing="6"
                    Padding="20,18,20,12">
                    <Label
                        Grid.Row="0" Grid.Column="0"
                        Text="{Binding SelectedBreakdownTitle, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ModalTitle}" />
                    <Label
                        Grid.Row="1" Grid.Column="0"
                        Text="{Binding SelectedBreakdownNutrientSummaryText, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ModalSubtitle}" />
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        Style="{StaticResource ModalIconButton}"
                        VerticalOptions="Start"
                        SemanticProperties.Description="{loc:LocalizedText Nutrition_Breakdown_CloseNutritionBreakdown}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseMicronutrientsModalCommand}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>

                <BoxView
                    Grid.Row="1"
                    Style="{StaticResource ModalDivider}"
                    Margin="20,0,20,14" />

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding SelectedBreakdownMicronutrients}"
                    ItemSizingStrategy="MeasureAllItems"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Always"
                    Margin="20,0,20,20"
                    VerticalOptions="Fill">
                    <CollectionView.Header>
                        <VerticalStackLayout>
                            <Grid
                                ColumnDefinitions="104, *"
                                ColumnSpacing="16"
                                Padding="0,0,0,16">

                                <controls:MacroPieChart
                                    Grid.Column="0"
                                    ProteinValue="{Binding SelectedBreakdownProteinCalories}"
                                    CarbsValue="{Binding SelectedBreakdownCarbsCalories}"
                                    FatsValue="{Binding SelectedBreakdownFatsCalories}"
                                    ProteinColor="{AppThemeBinding Light={StaticResource ProteinLight}, Dark={StaticResource ProteinDark}}"
                                    CarbsColor="{AppThemeBinding Light={StaticResource CarbsLight}, Dark={StaticResource CarbsDark}}"
                                    FatsColor="{AppThemeBinding Light={StaticResource FatsLight}, Dark={StaticResource FatsDark}}"
                                    TrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                    InnerColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                    InnerStrokeColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                    WidthRequest="104" HeightRequest="104"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_Breakdown_MacroDistributionNumericValuesAreListed}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                                <Grid
                                    Grid.Column="1"
                                    RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                                    ColumnDefinitions="Auto, *"
                                    RowSpacing="10"
                                    VerticalOptions="Center">
                                    <Image
                                        Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        Aspect="AspectFit"
                                        VerticalOptions="Center"
                                        Margin="0,0,7,0" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding SelectedBreakdownCaloriesText, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource AccentLabel}"
                                        FontSize="20"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding SelectedBreakdownMacrosText, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource CaptionLabel}" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding SelectedBreakdownFiberText, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource CaptionLabel}" />

                                    <Border
                                        Grid.Row="3"
                                        Grid.ColumnSpan="2"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                        Padding="10,8"
                                        MinimumHeightRequest="44"
                                        HorizontalOptions="Start"
                                        IsVisible="{Binding CanEditSelectedBreakdown}"
                                        SemanticProperties.Description="{loc:LocalizedText Nutrition_Breakdown_EditMeal}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding EditSelectedBreakdownMealCommand}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="6">
                                            <mi:MauiIcon
                                                Icon="{mi:Fluent EditSettings24}" IconSize="14" IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                WidthRequest="14"
                                                HeightRequest="14"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Text="{loc:LocalizedText Nutrition_Breakdown_EditMeal}"
                                                Style="{StaticResource CaptionLabel}"
                                                FontAttributes="Bold"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Row="4"
                                        Grid.ColumnSpan="2"
                                        Spacing="7"
                                        BindableLayout.ItemsSource="{Binding SelectedBreakdownMacroItems}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="nutritionModels:MacroBreakdownItem">
                                                <Grid ColumnDefinitions="22, Auto, *, Auto" ColumnSpacing="8">
                                                    <Path
                                                        Data="{Binding IconPathData, Converter={StaticResource StringToGeometryConverter}}"
                                                        Style="{StaticResource NutritionLineIcon}"
                                                        Stroke="{Binding Color}"
                                                        WidthRequest="15"
                                                        HeightRequest="15"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Name}"
                                                        Style="{StaticResource CaptionLabel}"
                                                        VerticalOptions="Center" />
                                                    <ProgressBar
                                                        Grid.Column="2"
                                                        Progress="{Binding Progress}"
                                                        ProgressColor="{Binding Color}"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                                                        HeightRequest="5"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="3"
                                                        Text="{Binding AmountText, Converter={StaticResource LocalizedStringConverter}}"
                                                        Style="{StaticResource MutedLabel}"
                                                        FontSize="14"
                                                        HorizontalTextAlignment="End" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Padding="0,2,0,10" ColumnSpacing="12">
                                <Label
                                    Text="{loc:LocalizedText Nutrition_Breakdown_Micronutrients}"
                                    Style="{StaticResource SectionTitle}"
                                    FontSize="16"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{loc:LocalizedText Nutrition_Breakdown_DailyTargets}"
                                    Style="{StaticResource CaptionLabel}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="nutritionModels:DailyMicronutrientItem">
                            <Border
                                Style="{StaticResource ModalListItem}"
                                Padding="16,14"
                                Margin="0,0,0,8">

                                <Grid
                                    RowDefinitions="Auto, Auto, 10, Auto"
                                    ColumnDefinitions="34, *, Auto"
                                    ColumnSpacing="10">
                                    <Border
                                        Grid.RowSpan="4"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        StrokeShape="RoundRectangle 17"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                        VerticalOptions="Center">
                                        <Path
                                            Data="{Binding IconPathData, Converter={StaticResource StringToGeometryConverter}}"
                                            Style="{StaticResource NutritionLineIcon}"
                                            Stroke="{StaticResource Primary}"
                                            WidthRequest="17"
                                            HeightRequest="17"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Group, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource EyebrowLabel}"
                                        FontSize="12"
                                        CharacterSpacing="1.1"
                                        Margin="0,0,0,2" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding Name}"
                                        Style="{StaticResource CardTitle}"
                                        FontSize="15"
                                        LineBreakMode="WordWrap" />

                                    <HorizontalStackLayout
                                        Grid.RowSpan="2"
                                        Grid.Column="2"
                                        Spacing="3"
                                        VerticalOptions="Center">
                                        <Label
                                            Text="{Binding AmountText, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource AccentLabel}"
                                            FontSize="14" />
                                        <Label
                                            Text="{Binding GoalText, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <ProgressBar
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Progress="{Binding Progress}"
                                        ProgressColor="{StaticResource Primary}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                                        HeightRequest="6"
                                        VerticalOptions="Center">
                                        <ProgressBar.Triggers>
                                            <DataTrigger
                                                TargetType="ProgressBar"
                                                Binding="{Binding IsGoalHit}"
                                                Value="True">
                                                <Setter
                                                    Property="ProgressColor"
                                                    Value="{AppThemeBinding Light={StaticResource ReadinessHighLight}, Dark={StaticResource ReadinessHighDark}}" />
                                            </DataTrigger>
                                        </ProgressBar.Triggers>
                                    </ProgressBar>

                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Text="{Binding ProgressText, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource CaptionLabel}"
                                        MinimumWidthRequest="56"
                                        HorizontalTextAlignment="End"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
