<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Nutrition.NutritionBalanceCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition"
    x:DataType="vm:NutritionViewModel">

    <Border Style="{StaticResource CardPrimary}">
        <!-- One column. The header used to share a row with the "Микроэлементы" button in an Auto
             column; at accessibility sizes that button is wider than the card, which collapsed the
             text column to a sliver and made the card grow into an empty wall. -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="{StaticResource UiSpacing14}">

            <!-- Row 0: Section header + Micros button, wrapping when the button needs its own line -->
            <FlexLayout Grid.Row="0" Direction="Row" Wrap="Wrap" AlignItems="Center">
            <Grid
                ColumnDefinitions="24,*"
                ColumnSpacing="{StaticResource UiSpaceTight}"
                VerticalOptions="Center">
                <Path
                    Data="M3 11h18c0 5-4 9-9 9s-9-4-9-9ZM7 11c0-3 2-5 5-5s5 2 5 5M12 3v3"
                    Style="{StaticResource NutritionLineIcon}"
                    Stroke="{StaticResource Primary}"
                    WidthRequest="{StaticResource UiDimension18}"
                    HeightRequest="{StaticResource UiDimension18}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="{loc:LocalizedText Nutrition_Balance_TodaySBalance}"
                    Style="{StaticResource SectionTitle}"
                    LineBreakMode="WordWrap"
                    VerticalOptions="Center" />
            </Grid>
            <Button
                    Style="{StaticResource ButtonSecondary}"
                    Text="{loc:LocalizedText Nutrition_Balance_Micros}"
                    Command="{Binding OpenMicronutrientsModalCommand}"
                    SemanticProperties.Description="{loc:LocalizedText Nutrition_Balance_ViewMicronutrientTargets}" />
            </FlexLayout>

            <!-- Row 2: Calorie icon + value + goal (In-line) -->
            <Grid
                Grid.Row="1"
                ColumnDefinitions="Auto, *"
                ColumnSpacing="{StaticResource UiSpacing10}"
                VerticalOptions="Center">
                <Image
                    Grid.Column="0"
                    Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                    Aspect="AspectFit"
                    WidthRequest="{StaticResource UiDimension22}"
                    HeightRequest="{StaticResource UiDimension22}"
                    VerticalOptions="Center" />
                <!-- The number is the card's headline; the goal is a caption under it, so the two
                     no longer read as one inline run-on string. -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="{StaticResource UiSpacing2}"
                    VerticalOptions="Center">
                    <Label
                        Text="{Binding ConsumedCalories, StringFormat='{0:F0}'}"
                        Style="{StaticResource MetricValue}" />
                    <Label
                        Text="{Binding TargetCalories, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_Format_TargetCaloriesValueKcal}"
                        Style="{StaticResource CaptionLabel}" />
                    <Label
                        Text="{Binding ActivityAdjustmentText, StringFormat='{0} activity'}"
                        IsVisible="{Binding HasActivityAdjustment}"
                        Style="{StaticResource CaptionLabel}"
                        TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Row 4: Progress bar -->
            <ProgressBar
                Grid.Row="2"
                Progress="{Binding CaloriesProgress}"
                ProgressColor="{StaticResource Primary}"
                BackgroundColor="{AppThemeBinding Light={StaticResource TrackMutedLight}, Dark={StaticResource TrackMutedDark}}"
                HeightRequest="{StaticResource UiDimension8}" />

            <!-- Row 6: Macro grid -->
            <sharedControls:MacroProgressGrid
                Grid.Row="3"
                ProteinText="{Binding ProteinText}"
                ProteinProgress="{Binding ProteinProgress}"
                CarbsText="{Binding CarbsText}"
                CarbsProgress="{Binding CarbsProgress}"
                FatsText="{Binding FatsText}"
                FatsProgress="{Binding FatsProgress}" />
        </Grid>
    </Border>
</ContentView>
