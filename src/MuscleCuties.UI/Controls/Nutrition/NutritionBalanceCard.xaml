<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Nutrition.NutritionBalanceCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:dashboard="clr-namespace:MuscleCuties.UI.Controls.Dashboard"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition"
    x:DataType="vm:NutritionViewModel">

    <Border Style="{StaticResource CardPrimary}">
        <!-- Unified radial balance card: shares the ring language of Today and Daily Food Log,
             with a full-width Micronutrients disclosure row rather than an orphan trailing button. -->
        <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="{StaticResource UiSpaceTight}"
                  VerticalOptions="Center">
                <Path Data="M3 11h18c0 5-4 9-9 9s-9-4-9-9ZM7 11c0-3 2-5 5-5s5 2 5 5M12 3v3"
                      Style="{StaticResource NutritionLineIcon}"
                      Stroke="{StaticResource Primary}"
                      WidthRequest="{StaticResource UiDimension18}"
                      HeightRequest="{StaticResource UiDimension18}"
                      VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{loc:LocalizedText Nutrition_Balance_TodaySBalance}"
                       Style="{StaticResource SectionTitle}"
                       SemanticProperties.HeadingLevel="Level2"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Calorie ring + headline -->
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="{StaticResource UiSpaceControl}">
                <Grid WidthRequest="{StaticResource UiDimension76}"
                      HeightRequest="{StaticResource UiDimension76}"
                      VerticalOptions="Center">
                    <dashboard:DashboardProgressRing Progress="{Binding CaloriesProgress}"
                                                     RingColor="{StaticResource Primary}"
                                                     WidthRequest="{StaticResource UiDimension76}"
                                                     HeightRequest="{StaticResource UiDimension76}" />
                    <Image Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                           WidthRequest="{StaticResource UiDimension26}"
                           HeightRequest="{StaticResource UiDimension26}"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                </Grid>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="{StaticResource UiSpacing2}"
                                     VerticalOptions="Center">
                    <Label Text="{loc:LocalizedText Dashboard_Nutrition_Calories}"
                           Style="{StaticResource CaptionLabel}"
                           LineBreakMode="WordWrap" />
                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                        <Label Text="{Binding ConsumedCaloriesText}"
                               Style="{StaticResource MetricValue}"
                               Margin="{StaticResource UiInsets0_0_8_0}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding TargetCalories, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_Format_TargetCaloriesValueKcal}"
                               Style="{StaticResource MutedLabel}"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap" />
                    </FlexLayout>
                    <Label Text="{Binding RemainingCaloriesText}"
                           Style="{StaticResource CaptionLabel}"
                           LineBreakMode="WordWrap" />
                    <Label Text="{Binding ActivityAdjustmentText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_Balance_ActivityFormat}"
                           IsVisible="{Binding HasActivityAdjustment}"
                           Style="{StaticResource CaptionLabel}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Grid>

            <!-- Macro rings (adapts to stacked rows at accessibility text sizes) -->
            <sharedControls:AdaptiveRow Columns="3" ColumnSpacing="{StaticResource UiSpacing6}">
                <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                    <Grid WidthRequest="{StaticResource UiDimension60}"
                          HeightRequest="{StaticResource UiDimension60}"
                          HorizontalOptions="Center">
                        <dashboard:DashboardProgressRing Progress="{Binding ProteinProgress}"
                                                         RingColor="{AppThemeBinding Light={StaticResource ProteinLight}, Dark={StaticResource ProteinDark}}"
                                                         WidthRequest="{StaticResource UiDimension60}"
                                                         HeightRequest="{StaticResource UiDimension60}" />
                        <Path Data="M4 9v6M7 8v8M17 9v6M14 8v8M7 12h7"
                              Style="{StaticResource NutritionLineIcon}"
                              Stroke="{AppThemeBinding Light={StaticResource ProteinLight}, Dark={StaticResource ProteinDark}}"
                              WidthRequest="{StaticResource UiDimension18}"
                              HeightRequest="{StaticResource UiDimension18}"
                              InputTransparent="True" />
                    </Grid>
                    <Label Text="{loc:LocalizedText Dashboard_Nutrition_Protein}"
                           Style="{StaticResource MutedLabel}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                    <Label Text="{Binding ProteinText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource CaptionLabel}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                    <Grid WidthRequest="{StaticResource UiDimension60}"
                          HeightRequest="{StaticResource UiDimension60}"
                          HorizontalOptions="Center">
                        <dashboard:DashboardProgressRing Progress="{Binding CarbsProgress}"
                                                         RingColor="{AppThemeBinding Light={StaticResource CarbsLight}, Dark={StaticResource CarbsDark}}"
                                                         WidthRequest="{StaticResource UiDimension60}"
                                                         HeightRequest="{StaticResource UiDimension60}" />
                        <Path Data="M9 18V5M9 7C6.5 7 5 5.8 5 4M9 10C6.5 10 5 8.8 5 7M9 13C6.5 13 5 11.8 5 10M9 7c2.5 0 4-1.2 4-3M9 10c2.5 0 4-1.2 4-3M9 13c2.5 0 4-1.2 4-3"
                              Style="{StaticResource NutritionLineIcon}"
                              Stroke="{AppThemeBinding Light={StaticResource CarbsLight}, Dark={StaticResource CarbsDark}}"
                              StrokeThickness="{StaticResource UiStrokeWidth1_5}"
                              WidthRequest="{StaticResource UiDimension18}"
                              HeightRequest="{StaticResource UiDimension18}"
                              InputTransparent="True" />
                    </Grid>
                    <Label Text="{loc:LocalizedText Dashboard_Nutrition_Carbs}"
                           Style="{StaticResource MutedLabel}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                    <Label Text="{Binding CarbsText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource CaptionLabel}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="{StaticResource UiSpaceMicro}" HorizontalOptions="Center">
                    <Grid WidthRequest="{StaticResource UiDimension60}"
                          HeightRequest="{StaticResource UiDimension60}"
                          HorizontalOptions="Center">
                        <dashboard:DashboardProgressRing Progress="{Binding FatsProgress}"
                                                         RingColor="{AppThemeBinding Light={StaticResource FatsLight}, Dark={StaticResource FatsDark}}"
                                                         WidthRequest="{StaticResource UiDimension60}"
                                                         HeightRequest="{StaticResource UiDimension60}" />
                        <Path Data="M10 3C7 7 5 10 5 13a5 5 0 0 0 10 0c0-3-2-6-5-10z"
                              Style="{StaticResource NutritionLineIcon}"
                              Stroke="{AppThemeBinding Light={StaticResource FatsLight}, Dark={StaticResource FatsDark}}"
                              StrokeThickness="{StaticResource UiStrokeWidth1_6}"
                              WidthRequest="{StaticResource UiDimension18}"
                              HeightRequest="{StaticResource UiDimension18}"
                              InputTransparent="True" />
                    </Grid>
                    <Label Text="{loc:LocalizedText Dashboard_Nutrition_Fat}"
                           Style="{StaticResource MutedLabel}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                    <Label Text="{Binding FatsText, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource CaptionLabel}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </sharedControls:AdaptiveRow>

            <BoxView HeightRequest="{StaticResource UiDimension1}"
                     Color="{AppThemeBinding Light={StaticResource BorderMutedLight}, Dark={StaticResource BorderMutedDark}}"
                     BackgroundColor="{AppThemeBinding Light={StaticResource BorderMutedLight}, Dark={StaticResource BorderMutedDark}}" />

            <!-- Full-width Micronutrients disclosure row -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource UiSpaceCompact}"
                  MinimumHeightRequest="{StaticResource PresentationMinimumTouchSize}"
                  SemanticProperties.Description="{loc:LocalizedText Nutrition_Balance_ViewMicronutrientTargets}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenMicronutrientsModalCommand}" />
                </Grid.GestureRecognizers>
                <Label Text="{loc:LocalizedText Nutrition_Balance_Micros}"
                       Style="{StaticResource BodyStrong}"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Center" />
                <mi:MauiIcon Grid.Column="1"
                             Icon="{mi:Fluent ChevronRight24}"
                             IconSize="{StaticResource UiDimension16}"
                             IconColor="{StaticResource Primary}"
                             WidthRequest="{StaticResource UiDimension16}"
                             HeightRequest="{StaticResource UiDimension16}"
                             VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
