<?xml version="1.0" encoding="utf-8"?>

<shared:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Nutrition.MealEditorModal"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:shared="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:models="clr-namespace:MuscleCuties.UI.Models.UI.Nutrition"
    xmlns:nutritionEnums="clr-namespace:MuscleCuties.Core.Models.Enums.Nutrition;assembly=MuscleCuties.Core"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition"
    x:DataType="vm:NutritionViewModel"
    IsOpen="{Binding IsMealEditorVisible}">
    <Grid>
        <BoxView Style="{StaticResource ModalBackdrop}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMealEditorCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="SheetSurface" Style="{StaticResource ModalSurface}" MaximumHeightRequest="{StaticResource ModalSheetMaximumHeight}" VerticalOptions="End">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="{StaticResource UiSpacing0}">
                <Grid Padding="{DynamicResource PresentationModalHeaderPadding}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                    <Border Style="{StaticResource ModalIconButton}"
                            IsVisible="{Binding IsFoodFinderVisible}"
                            SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEditor_BackToMeal}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MealEditorBackCommand}" />
                        </Border.GestureRecognizers>
                        <Path Data="M15 4 7 12l8 8" Style="{StaticResource NutritionLineIcon}" WidthRequest="{StaticResource UiDimension20}"
                              HeightRequest="{StaticResource UiDimension20}" />
                    </Border>
                    <Label Grid.Column="1"
                           Text="{Binding MealEditorTitle, Converter={StaticResource LocalizedStringConverter}}"
                           Style="{StaticResource ModalTitle}" VerticalOptions="Center" />
                    <Border Grid.Column="2" Style="{StaticResource ModalIconButton}"
                            SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEditor_CloseMealEditor}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleMealEditorCommand}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>
                <BoxView Grid.Row="1" Style="{StaticResource ModalDivider}" Margin="{StaticResource UiInsets20_0}" />

                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource UiSpaceTight}"
                      Margin="{StaticResource UiInsets20_12_20_20}"
                      IsVisible="{Binding IsFoodSourceTabsVisible}">
                    <Border Grid.Column="0" Style="{StaticResource ChoiceCellCompact}"
                            BindingContext="{Binding SearchFoodSourceTab}"
                            SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodSource_Search}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectSearchFoodSourceCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}" />
                        </Border.GestureRecognizers>
                        <Label Text="{loc:LocalizedText Nutrition_FoodSource_Search}" Style="{StaticResource ChoiceCellLabel}" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ChoiceCellCompact}"
                            BindingContext="{Binding BarcodeFoodSourceTab}"
                            SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodSource_Barcode}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectBarcodeFoodSourceCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}" />
                        </Border.GestureRecognizers>
                        <Label Text="{loc:LocalizedText Nutrition_FoodSource_Barcode}" Style="{StaticResource ChoiceCellLabel}" />
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ChoiceCellCompact}"
                            BindingContext="{Binding CustomFoodSourceTab}"
                            SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodSource_Custom}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectCustomFoodSourceCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}" />
                        </Border.GestureRecognizers>
                        <Label Text="{loc:LocalizedText Nutrition_FoodSource_Custom}" Style="{StaticResource ChoiceCellLabel}" />
                    </Border>
                </Grid>

                <CollectionView Grid.Row="3" IsVisible="{Binding IsFoodFinderCollapsed}" Margin="{StaticResource UiInsets20_0}"
                                ItemsSource="{Binding MealIngredients}"
                                ItemSizingStrategy="MeasureAllItems" SelectionMode="None">
                    <CollectionView.Header>
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*"
                              RowSpacing="{StaticResource UiSpaceCompact}" Padding="{StaticResource UiInsets0_20_0_12}"
                              x:DataType="vm:NutritionViewModel">
                            <Border Style="{StaticResource CardSecondary}">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpacing6}"
                                      RowSpacing="{StaticResource UiSpaceMicro}">
                                    <Image Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                                           WidthRequest="{StaticResource UiDimension24}" HeightRequest="{StaticResource UiDimension24}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding MealDraftCaloriesText, Converter={StaticResource LocalizedStringConverter}}"
                                           Style="{StaticResource SubHeadline}" VerticalOptions="Center" />
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*"
                                          ColumnSpacing="{StaticResource UiSpaceCompact}">
                                        <Label Text="{Binding MealDraftProteinText, StringFormat='P {0}'}"
                                               Style="{StaticResource CaptionStrong}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource ProteinDark}}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding MealDraftCarbsText, StringFormat='C {0}'}"
                                               Style="{StaticResource CaptionStrong}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource CarbsDark}}" />
                                        <Label Grid.Column="2"
                                               Text="{Binding MealDraftFatsText, StringFormat='F {0}'}"
                                               Style="{StaticResource CaptionStrong}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource FatsDark}}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Compact Meal Context Chip Strip (Meal Type, Date, Time) -->
                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource UiSpaceTight}"
                                  IsVisible="{Binding IsMealContextSummaryVisible}"
                                  SemanticProperties.Description="{Binding MealChoiceSummary}"
                                  SemanticProperties.Hint="{loc:LocalizedText Nutrition_MealEditor_ChangeMealContext}">
                                <Border Grid.Column="0" Style="{StaticResource PillBadge}" HorizontalOptions="Fill">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleMealContextCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding SelectedMealTypeText}" Style="{StaticResource CaptionStrong}"
                                           HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PillBadge}" HorizontalOptions="Fill">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleMealContextCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding SelectedMealDateText}" Style="{StaticResource CaptionStrong}"
                                           HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource PillBadge}" HorizontalOptions="Fill">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleMealContextCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding SelectedMealTimeText}" Style="{StaticResource CaptionStrong}"
                                           HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <!-- Expanded Compact Context Editor -->
                            <VerticalStackLayout Grid.Row="1" Spacing="{StaticResource UiSpaceTight}"
                                                 IsVisible="{Binding IsMealContextEditorVisible}">
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource UiSpaceTight}">
                                    <Border Grid.Column="0" Style="{StaticResource ChoiceCellCompact}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsBreakfastSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedSurfaceLight}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                                <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth2}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectMealTypeCommand}"
                                                                  CommandParameter="{x:Static nutritionEnums:MealType.Breakfast}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{loc:LocalizedText Nutrition_MealType_Breakfast}" Style="{StaticResource ChoiceCellLabel}" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource ChoiceCellCompact}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsLunchSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedSurfaceLight}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                                <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth2}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectMealTypeCommand}"
                                                                  CommandParameter="{x:Static nutritionEnums:MealType.Lunch}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{loc:LocalizedText Nutrition_MealType_Lunch}" Style="{StaticResource ChoiceCellLabel}" />
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource ChoiceCellCompact}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsDinnerSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedSurfaceLight}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                                <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth2}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectMealTypeCommand}"
                                                                  CommandParameter="{x:Static nutritionEnums:MealType.Dinner}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{loc:LocalizedText Nutrition_MealType_Dinner}" Style="{StaticResource ChoiceCellLabel}" />
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource ChoiceCellCompact}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSnackSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedSurfaceLight}, Dark={StaticResource ChoiceSelectedSurfaceDark}}" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ChoiceSelectedStrokeLight}, Dark={StaticResource ChoiceSelectedStrokeDark}}" />
                                                <Setter Property="StrokeThickness" Value="{StaticResource UiStrokeWidth2}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectMealTypeCommand}"
                                                                  CommandParameter="{x:Static nutritionEnums:MealType.Snack}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{loc:LocalizedText Nutrition_MealType_Snack}" Style="{StaticResource ChoiceCellLabel}" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                                    <Border Style="{StaticResource InputContainer}">
                                        <TimePicker Time="{Binding SelectedMealTime}" Format="t"
                                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEditor_MealTime}" />
                                    </Border>
                                    <Button Grid.Column="1" Text="{loc:LocalizedText Common_Done}"
                                            Command="{Binding ToggleMealContextCommand}"
                                            Style="{StaticResource ButtonSecondary}" />
                                </Grid>
                            </VerticalStackLayout>

                            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource UiSpaceTight}">
                                <Button Text="{loc:LocalizedText Nutrition_AddFood}"
                                        Command="{Binding OpenFoodFinderCommand}"
                                        Style="{StaticResource ButtonSecondary}"
                                        LineBreakMode="WordWrap" />
                                <Button Grid.Column="1" Text="{loc:LocalizedText Nutrition_MealEntry_GetASuggestion}"
                                        Command="{Binding StartSuggestedMealCommand}"
                                        Style="{StaticResource ButtonSecondary}"
                                        LineBreakMode="WordWrap"
                                        SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEntry_GetAMealSuggestion}"
                                        SemanticProperties.Hint="{loc:LocalizedText Nutrition_MealEntry_OpensMealSuggestionsTailoredToYour}" />
                            </Grid>
                        </Grid>
                    </CollectionView.Header>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="{StaticResource UiSpaceCompact}"
                                             Padding="{StaticResource UiInsets0_16}"
                                             x:DataType="vm:NutritionViewModel">
                            <Label Text="{loc:LocalizedText Nutrition_MealEditor_AddAFoodToBuildThis}"
                                   Style="{StaticResource StateEmptyBody}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MealIngredientItem">
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" Padding="{StaticResource UiInsets0_12_0_0}"
                                  ColumnSpacing="{StaticResource UiSpaceTight}" RowSpacing="{StaticResource UiSpaceMicro}">
                                <Label Text="{Binding Name}" Style="{StaticResource CardTitle}"
                                       LineBreakMode="WordWrap" />
                                <Label Grid.Row="1"
                                       Text="{Binding AmountSummary, Converter={StaticResource LocalizedStringConverter}}"
                                       Style="{StaticResource MutedMedium}" LineBreakMode="WordWrap" />
                                <Button Grid.Column="1" Grid.RowSpan="2" Text="{loc:LocalizedText Common_Edit}"
                                        Style="{StaticResource ButtonSecondary}"
                                        Command="{Binding EditIngredientCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}"
                                        CommandParameter="{Binding .}"
                                        SemanticProperties.Description="{Binding Name, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_MealEditor_EditValuePortion}" />
                                <Border Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource ModalIconButton}"
                                        VerticalOptions="Center"
                                        SemanticProperties.Description="{Binding Name, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_MealEditor_RemoveValue}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding RemoveIngredientCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Path InputTransparent="True" Style="{StaticResource ModalCloseIcon}" WidthRequest="{StaticResource UiDimension14}" HeightRequest="{StaticResource UiDimension14}" />
                                </Border>
                                <BoxView Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource ModalDivider}"
                                         Margin="{StaticResource UiInsets0_8_0_0}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*" Margin="{StaticResource UiInsets20_16_20_0}" RowSpacing="{StaticResource UiSpaceTight}"
                      IsVisible="{Binding IsIngredientSearchVisible}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                        <Border Style="{StaticResource PickerContainer}">
                            <Entry x:Name="SearchEntry" Text="{Binding SearchQuery}"
                                   Placeholder="{loc:LocalizedText Nutrition_MealEditor_FoodName}" ReturnType="Search"
                                   ReturnCommand="{Binding SearchFoodCommand}" Completed="OnSearchSubmitted"
                                   SemanticProperties.Description="{loc:LocalizedText Nutrition_SearchFoods}" />
                        </Border>
                        <Button Grid.Column="1"
                                Style="{StaticResource ButtonPrimary}"
                                Text="{loc:LocalizedText Nutrition_MealEditor_Search}"
                                Command="{Binding SearchFoodCommand}" Clicked="OnSearchSubmitted" />
                    </Grid>
                    <CollectionView Grid.Row="2" ItemsSource="{Binding FoodSearchResults}"
                                    ItemSizingStrategy="MeasureAllItems"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Spacing="{StaticResource UiSpaceMicro}"
                                                 Margin="{StaticResource UiInsets0_16}">
                                <Label Text="{loc:LocalizedText Nutrition_MealEditor_SearchToAddFood}"
                                       Style="{StaticResource MutedCentered}" LineBreakMode="WordWrap"
                                       IsVisible="{Binding IsFoodSearchIdle}" />
                                <Label Text="{loc:LocalizedText Nutrition_MealEditor_NoMatchYetTryAnotherName}"
                                       Style="{StaticResource MutedCentered}" LineBreakMode="WordWrap"
                                       IsVisible="{Binding IsFoodSearchIdle, Converter={StaticResource InvertedBoolConverter}}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:FoodSearchResultItem">
                                <Grid Padding="{StaticResource UiInsets0_12}" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                                      RowSpacing="{StaticResource UiSpaceMicro}" ColumnSpacing="{StaticResource UiSpaceTight}"
                                      SemanticProperties.Description="{Binding Name, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=Nutrition_MealEditor_ChooseValue}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectFoodResultCommand, Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, x:DataType=vm:NutritionViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding Name}" Style="{StaticResource CardTitle}"
                                           LineBreakMode="WordWrap" />
                                    <Label Grid.Row="1"
                                           Text="{Binding SourceSummary, Converter={StaticResource LocalizedStringConverter}}"
                                           Style="{StaticResource MutedMedium}" LineBreakMode="WordWrap" />
                                    <Label Grid.Row="2"
                                           Text="{Binding NutritionSummary, Converter={StaticResource LocalizedStringConverter}}"
                                           Style="{StaticResource MutedMedium}" LineBreakMode="WordWrap" />
                                    <Path Grid.Column="1" Grid.RowSpan="3" Data="M8 4l8 8-8 8"
                                          Style="{StaticResource NutritionLineIcon}" WidthRequest="{StaticResource UiDimension16}"
                                          HeightRequest="{StaticResource UiDimension16}" Margin="{StaticResource UiInsets12}" VerticalOptions="Center" />
                                    <BoxView Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource ModalDivider}"
                                             Margin="{StaticResource UiInsets0_8_0_0}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.Footer>
                            <Button
                                Text="{Binding BrowseMoreFoodsButtonText, Converter={StaticResource LocalizedStringConverter}}"
                                Command="{Binding BrowseMoreFoodsCommand}" Style="{StaticResource ButtonSecondary}"
                                x:DataType="vm:NutritionViewModel"
                                IsVisible="{Binding ShowBrowseMoreFoods}" />
                        </CollectionView.Footer>
                    </CollectionView>
                    <ActivityIndicator
                        Style="{StaticResource StateBusyInline}" Grid.Row="2" IsVisible="{Binding IsSearchingFood}"
                                       IsRunning="{Binding IsSearchingFood}"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEditor_SearchingFoods}" />
                </Grid>

                <ScrollView Grid.Row="3" Style="{StaticResource ModalSheetBody}" IsVisible="{Binding IsSelectedFoodEditorVisible}">
                    <VerticalStackLayout Padding="{DynamicResource PresentationModalPagePadding}" Spacing="{StaticResource UiSpaceControl}">
                        <Label Text="{Binding SelectedFoodText}" Style="{StaticResource CardTitle}"
                               LineBreakMode="WordWrap" />
                        <Label
                            Text="{Binding SelectedFoodSourceText, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource MutedMedium}"
                            LineBreakMode="WordWrap" IsVisible="{Binding HasSelectedFoodSource}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" RowSpacing="{StaticResource UiSpaceMicro}">
                            <Label Text="{loc:LocalizedText Nutrition_MealEditor_Amount}" Style="{StaticResource FormFieldLabel}" />
                            <Label Grid.Column="1" Text="{loc:LocalizedText Nutrition_MealEditor_Unit}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding FoodGrams}" Keyboard="Numeric"
                                       Placeholder="{loc:LocalizedText Nutrition_MealEditor_Amount}"
                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEditor_IngredientAmount}" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PickerContainer}">
                                <Picker Title="{loc:LocalizedText Nutrition_MealEditor_ServingUnit}" ItemsSource="{Binding ServingOptions}"
                                        SelectedItem="{Binding SelectedServingOption}" />
                            </Border>
                        </Grid>
                        <Label
                            Text="{Binding SelectedFoodAmountText, Converter={StaticResource LocalizedStringConverter}}"
                            Style="{StaticResource BodyLabel}"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView Grid.Row="3" Style="{StaticResource ModalSheetBody}" IsVisible="{Binding IsBarcodeSourceVisible}">
                    <VerticalStackLayout Padding="{DynamicResource PresentationModalPagePadding}" Spacing="{StaticResource UiSpaceControl}">
                        <Label Text="{loc:LocalizedText Nutrition_FoodLog_ManualBarcodeLookup}"
                               Style="{StaticResource SectionTitle}" LineBreakMode="WordWrap" />
                        <Label Text="{loc:LocalizedText Nutrition_FoodLog_CatalogBarcodeLookup}"
                               Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
                        <Label Text="{Binding BarcodeScanStatus, Converter={StaticResource LocalizedStringConverter}}"
                               Style="{StaticResource AccentLabel}" LineBreakMode="WordWrap" />
                        <ActivityIndicator Style="{StaticResource StateBusyInline}"
                                           IsRunning="{Binding IsProcessingBarcode}"
                                           IsVisible="{Binding IsProcessingBarcode}" />
                        <Button Text="{loc:LocalizedText Nutrition_Barcode_ScanWithCamera}"
                                Command="{Binding ScanBarcodeWithCameraCommand}"
                                Style="{StaticResource ButtonPrimary}"
                                IsEnabled="{Binding IsProcessingBarcode, Converter={StaticResource InvertedBoolConverter}}"
                                SemanticProperties.Description="{loc:LocalizedText Nutrition_Barcode_ScanWithCameraDescription}" />
                        <Label Text="{loc:LocalizedText Nutrition_FoodLog_EnterBarcode}" Style="{StaticResource FormFieldLabel}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding BarcodeInputText}"
                                       Placeholder="{loc:LocalizedText Nutrition_FoodLog_BarcodeExample}"
                                       Keyboard="Numeric"
                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_EnterBarcode}" />
                            </Border>
                            <Button Grid.Column="1" Text="{loc:LocalizedText Nutrition_FoodLog_BarcodeLookup}"
                                    Command="{Binding LookupBarcodeCommand}"
                                    CommandParameter="{Binding BarcodeInputText}"
                                    Style="{StaticResource ButtonSecondary}"
                                    IsEnabled="{Binding IsProcessingBarcode, Converter={StaticResource InvertedBoolConverter}}"
                                    SemanticProperties.Description="{loc:LocalizedText Nutrition_FoodLog_BarcodeLookup}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView Grid.Row="3" Style="{StaticResource ModalSheetBody}" IsVisible="{Binding IsCustomFoodPanelVisible}">
                    <VerticalStackLayout Padding="{DynamicResource PresentationModalPagePadding}" Spacing="{StaticResource UiSpaceCompact}">
                        <Label Text="{loc:LocalizedText Nutrition_CustomFood_General}" Style="{StaticResource SectionTitle}" />
                        <Label Text="{loc:LocalizedText Nutrition_MealEditor_FoodName}" Style="{StaticResource FormFieldLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding CustomFoodName}" Placeholder="{loc:LocalizedText Nutrition_MealEditor_FoodName}" />
                        </Border>
                        <Label Text="{loc:LocalizedText Nutrition_CustomFood_CompanySource}" Style="{StaticResource FormFieldLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding CustomFoodCompanySource}"
                                   Placeholder="{loc:LocalizedText Nutrition_CustomFood_Optional}" />
                        </Border>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" RowSpacing="{StaticResource UiSpaceMicro}">
                            <Label Text="{loc:LocalizedText Nutrition_MealEditor_ServingSize}" Style="{StaticResource FormFieldLabel}" />
                            <Label Grid.Column="1" Text="{loc:LocalizedText Nutrition_MealEditor_Unit}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding CustomFoodServingAmount}" Keyboard="Numeric" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PickerContainer}">
                                <Picker Title="{loc:LocalizedText Nutrition_MealEditor_ServingUnit}"
                                        ItemsSource="{Binding CustomFoodServingUnits}"
                                        SelectedItem="{Binding SelectedCustomFoodServingUnit}"
                                        ItemDisplayBinding="{Binding ., Converter={StaticResource LocalizedStringConverter}}" />
                            </Border>
                        </Grid>
                        <Label Text="{loc:LocalizedText Nutrition_CustomFood_Macros}" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}"
                              RowSpacing="{StaticResource UiSpaceTight}">
                            <Label Text="{loc:LocalizedText Nutrition_Label_CaloriesKcal}" Style="{StaticResource FormFieldLabel}" />
                            <Label Grid.Column="1" Text="{loc:LocalizedText Nutrition_Label_ProteinGrams}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding CustomFoodCalories}" Keyboard="Numeric" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding CustomFoodProtein}" Keyboard="Numeric" />
                            </Border>
                            <Label Grid.Row="2" Text="{loc:LocalizedText Nutrition_Label_CarbsGrams}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{loc:LocalizedText Nutrition_Label_FatGrams}"
                                   Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="3" Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding CustomFoodCarbs}" Keyboard="Numeric" />
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding CustomFoodFats}" Keyboard="Numeric" />
                            </Border>
                        </Grid>
                        <Label Text="{loc:LocalizedText Nutrition_CustomFood_Micronutrients}" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="{StaticResource UiSpaceCompact}" RowSpacing="{StaticResource UiSpaceTight}">
                            <Label Text="{loc:LocalizedText Nutrition_CustomFood_Iron}" Style="{StaticResource FormFieldLabel}" />
                            <Label Grid.Column="1" Text="{loc:LocalizedText Nutrition_CustomFood_VitaminB12}" Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="1" Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding CustomFoodIron}" Keyboard="Numeric" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding CustomFoodVitaminB12}" Keyboard="Numeric" />
                            </Border>
                            <Label Grid.Row="2" Text="{loc:LocalizedText Nutrition_CustomFood_VitaminD}" Style="{StaticResource FormFieldLabel}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{loc:LocalizedText Nutrition_CustomFood_Calcium}" Style="{StaticResource FormFieldLabel}" />
                            <Border Grid.Row="3" Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding CustomFoodVitaminD}" Keyboard="Numeric" />
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding CustomFoodCalcium}" Keyboard="Numeric" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout Grid.Row="4" Padding="{DynamicResource PresentationActionFooterPadding}" Spacing="{StaticResource UiSpaceTight}">
                    <Label Text="{Binding AddFoodMessage, Converter={StaticResource LocalizedStringConverter}}"
                           IsVisible="{Binding HasAddFoodMessage}" Style="{StaticResource BodyMedium}" LineBreakMode="WordWrap" />
                    <ActivityIndicator
                        Style="{StaticResource StateBusyInline}" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                      
                                       SemanticProperties.Description="{loc:LocalizedText Nutrition_MealEditor_SavingMealChanges}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource UiSpacing10}" IsVisible="{Binding IsFoodFinderCollapsed}">
                        <Button Style="{StaticResource ButtonSecondary}"
                                Text="{loc:LocalizedText Common_Cancel}"
                                Command="{Binding ToggleMealEditorCommand}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource ButtonPrimary}"
                                Text="{Binding LogMealButtonText, Converter={StaticResource LocalizedStringConverter}}"
                                Command="{Binding LogMealCommand}" />
                    </Grid>
                    <Button Style="{StaticResource ButtonPrimary}"
                            Text="{Binding IngredientActionText, Converter={StaticResource LocalizedStringConverter}}"
                            Command="{Binding AddIngredientCommand}" IsVisible="{Binding IsSelectedFoodEditorVisible}" />
                    <Button Style="{StaticResource ButtonPrimary}"
                            Text="{loc:LocalizedText Nutrition_MealEditor_SaveCustomFood}" Command="{Binding CreateCustomFoodCommand}"
                            IsVisible="{Binding IsCustomFoodPanelVisible}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</shared:AnimatedModalView>
