<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Nutrition.MealDetailModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.UI.Models.UI.Nutrition"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition"
    x:DataType="vm:NutritionViewModel"
    IsOpen="{Binding IsMealDetailVisible}">

    <Grid BackgroundColor="{StaticResource ModalScrim}">
        <BoxView BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMealDetailCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="SheetSurface" Style="{StaticResource AppBottomSheetSurface}">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

                <!-- Header: flattened from Grid+VerticalStackLayout into single Grid -->
                <Grid
                    Padding="20,18,20,12"
                    RowDefinitions="Auto,Auto"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="12"
                    RowSpacing="2">
                    <Border
                        Grid.RowSpan="2"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource AccentSurfaceDark}}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                        <Path
                            Data="{Binding SelectedMealDetail.IconPathData, Converter={StaticResource StringToGeometryConverter}}"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="1.5"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Aspect="Uniform"
                            WidthRequest="20"
                            HeightRequest="20"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        Grid.Column="1"
                        Text="{Binding SelectedMealDetail.ConceptName, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ModalTitle}"
                        LineBreakMode="WordWrap" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding SelectedMealDetail.ConceptDescription, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ModalSubtitle}"
                        LineBreakMode="WordWrap" />

                    <Border
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        Style="{StaticResource ModalIconButton}"
                        VerticalOptions="Start"
                        SemanticProperties.Description="{loc:LocalizedText Nutrition_MealDetail_CloseMealDetail}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseMealDetailCommand}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>

                <BoxView Grid.Row="1" Style="{StaticResource ModalDivider}" />

                <!-- Scrollable content -->
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout Spacing="16" Padding="20,16,20,20">

                        <!-- Macro summary card: flattened from Grid+HorizontalStackLayouts into single Grid -->
                        <Border
                            Style="{StaticResource ModalAccentPanel}"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="6"
                                  RowSpacing="8">
                                <Image
                                    Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                                    Aspect="AspectFit"
                                    WidthRequest="16"
                                    HeightRequest="16"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding DetailCaloriesText, Converter={StaticResource LocalizedStringConverter}}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding DetailMacrosText, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource MutedLabel}"
                                    FontSize="14" LineBreakMode="WordWrap" />

                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <Border
                                        StrokeShape="RoundRectangle 999"
                                        StrokeThickness="0"
                                        Padding="8,3"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}">
                                        <Label
                                            Text="{Binding SelectedMealDetail.StyleLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionLabel}"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                                            FontAttributes="Bold"
                                            FontSize="13" />
                                    </Border>
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding SelectedMealDetail.StyleDescription, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource MutedLabel}"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Daily fit: flattened from VerticalStackLayout into Grid -->
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                            <Label
                                Text="{Binding MealFillPercentText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource MutedLabel}"
                                FontAttributes="Bold"
                                FontSize="14" />
                            <Label
                                Grid.Row="1"
                                Text="{Binding DailyProgressText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource MutedLabel}"
                                FontSize="14" />
                            <Label
                                Grid.Row="2"
                                Text="{Binding DailyMacroRemainingText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource MutedLabel}"
                                FontSize="14" />
                        </Grid>

                        <!-- Ingredients by group -->
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                            <Label
                                Grid.Row="0"
                                Text="{loc:LocalizedText Nutrition_MealDetail_Ingredients}"
                                Style="{StaticResource SectionTitle}"
                                FontSize="17" />

                            <VerticalStackLayout
                                Grid.Row="1"
                                BindableLayout.ItemsSource="{Binding SelectedMealDetail.ComponentGroups}"
                                Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="nutritionModels:MealSuggestionComponentGroup">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="8" RowSpacing="4">
                                            <Image
                                                Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}, ConverterParameter=Accent}"
                                                WidthRequest="16"
                                                HeightRequest="16"
                                                Aspect="AspectFit"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Label, Converter={StaticResource LocalizedStringConverter}}"
                                                Style="{StaticResource CardTitle}"
                                                FontSize="15"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding TotalText, Converter={StaticResource LocalizedStringConverter}}"
                                                Style="{StaticResource MutedLabel}"
                                                FontSize="14"
                                                VerticalOptions="Center" />

                                            <VerticalStackLayout
                                                Grid.Row="1"
                                                Grid.ColumnSpan="3"
                                                BindableLayout.ItemsSource="{Binding Items}"
                                                Spacing="2"
                                                Padding="24,0,0,0">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate
                                                        x:DataType="nutritionModels:MealSuggestionComponentItem">
                                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="2" Padding="0,2">
                                                            <Label
                                                                Text="{Binding Name}"
                                                                Style="{StaticResource BodyLabel}"
                                                                FontSize="15"
                                                                LineBreakMode="WordWrap"
                                                                VerticalOptions="Center" />
                                                            <Label
                                                                Grid.Row="1"
                                                                Text="{Binding DetailText, Converter={StaticResource LocalizedStringConverter}}"
                                                                Style="{StaticResource MutedLabel}"
                                                                FontSize="14"
                                                                VerticalOptions="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Spice blends -->
                        <Grid
                            RowDefinitions="Auto,Auto"
                            RowSpacing="6"
                            IsVisible="{Binding DetailHasSpiceBlends}">
                            <Label
                                Grid.Row="0"
                                Text="{loc:LocalizedText Nutrition_MealDetail_Seasoning}"
                                Style="{StaticResource SectionTitle}"
                                FontSize="17" />
                            <VerticalStackLayout
                                Grid.Row="1"
                                BindableLayout.ItemsSource="{Binding SelectedMealDetail.SpiceBlends}"
                                Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="nutritionModels:SpiceBlendDetail">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                              RowSpacing="1" Padding="0,2">
                                            <Border
                                                Grid.RowSpan="2"
                                                StrokeShape="RoundRectangle 999"
                                                StrokeThickness="0"
                                                Padding="6,2"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding IsRecommended}">
                                                <Label
                                                    Text="{loc:LocalizedText Nutrition_MealDetail_RecommendedBadge}"
                                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                                                    FontSize="13"
                                                    FontAttributes="Bold" />
                                            </Border>
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Name}"
                                                Style="{StaticResource CardTitle}"
                                                FontSize="15" LineBreakMode="WordWrap" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="{Binding Description}"
                                                Style="{StaticResource MutedLabel}"
                                                FontSize="14"
                                                LineBreakMode="WordWrap" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Directions -->
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Label
                                Grid.Row="0"
                                Text="{loc:LocalizedText Nutrition_MealDetail_HowToPrepare}"
                                Style="{StaticResource SectionTitle}"
                                FontSize="17" />
                            <Label
                                Grid.Row="1"
                                Text="{Binding DetailDirectionsText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource BodyLabel}"
                                FontSize="15"
                                LineHeight="1.5" />
                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Action buttons -->
                <Grid Grid.Row="3" Padding="20,8,20,16" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button
                        Text="{loc:LocalizedText Common_Back}"
                        Command="{Binding CloseMealDetailCommand}"
                        Style="{StaticResource ButtonSecondary}"
                        MinimumHeightRequest="48" />
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource ButtonPrimary}"
                        Text="{loc:LocalizedText Nutrition_MealDetail_UseThisMeal}"
                        Command="{Binding AcceptSuggestionCommand}"
                        CommandParameter="{Binding SelectedMealDetail}"
                        MinimumHeightRequest="48"
                        FontAttributes="Bold" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
