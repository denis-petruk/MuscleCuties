<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.UI.Controls.Nutrition.MealDetailModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MuscleCuties.UI.Services.Localization"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.UI.Models.UI.Nutrition"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.UI.ViewModels.Nutrition"
    x:DataType="vm:NutritionViewModel"
    IsOpen="{Binding IsMealDetailVisible}">

    <Grid BackgroundColor="{StaticResource ModalScrim}">
        <BoxView BackgroundColor="{StaticResource Transparent}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMealDetailCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="SheetSurface" Style="{StaticResource ModalSurface}" VerticalOptions="End">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource UiSpacing0}">

                <!-- Header: flattened from Grid+VerticalStackLayout into single Grid -->
                <Grid
                    Padding="{StaticResource UiInsets20_18_20_12}"
                    RowDefinitions="Auto,Auto"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="{StaticResource UiSpaceCompact}"
                    RowSpacing="{StaticResource UiSpacing2}">
                    <Border
                        Grid.RowSpan="2"
                        WidthRequest="{StaticResource UiDimension42}"
                        HeightRequest="{StaticResource UiDimension42}"
                        StrokeShape="{StaticResource UiRoundRectangleRadius12}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource AccentSurfaceDark}}"
                        StrokeThickness="{StaticResource UiStrokeWidth0}"
                        VerticalOptions="Center">
                        <Path
                            Data="{Binding SelectedMealDetail.IconPathData, Converter={StaticResource StringToGeometryConverter}}"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="{StaticResource UiStrokeWidth1_5}"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Aspect="Uniform"
                            WidthRequest="{StaticResource UiDimension20}"
                            HeightRequest="{StaticResource UiDimension20}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        Grid.Column="1"
                        Text="{Binding SelectedMealDetail.ConceptName, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ModalTitle}"
                        LineBreakMode="WordWrap" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding SelectedMealDetail.ConceptDescription, Converter={StaticResource LocalizedStringConverter}}"
                        Style="{StaticResource ModalSubtitle}"
                        LineBreakMode="WordWrap" />

                    <Border
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        Style="{StaticResource ModalIconButton}"
                        VerticalOptions="Start"
                        SemanticProperties.Description="{loc:LocalizedText Nutrition_MealDetail_CloseMealDetail}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseMealDetailCommand}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>

                <BoxView Grid.Row="1" Style="{StaticResource ModalDivider}" />

                <!-- Scrollable content -->
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout Spacing="{StaticResource UiSpaceControl}" Padding="{StaticResource UiInsets20_16_20_20}">

                        <!-- Macro summary card: flattened from Grid+HorizontalStackLayouts into single Grid -->
                        <Border
                            Style="{StaticResource CardAccent}">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpacing6}"
                                  RowSpacing="{StaticResource UiSpaceTight}">
                                <Image
                                    Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                                    Aspect="AspectFit"
                                    WidthRequest="{StaticResource UiDimension16}"
                                    HeightRequest="{StaticResource UiDimension16}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding DetailCaloriesText, Converter={StaticResource LocalizedStringConverter}}"
                                    FontSize="{StaticResource UiFontSize18}"
                                    FontAttributes="{StaticResource UiFontAttributesBold}"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding DetailMacrosText, Converter={StaticResource LocalizedStringConverter}}"
                                    Style="{StaticResource MutedMedium}" LineBreakMode="WordWrap" />

                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource UiSpaceTight}">
                                    <Border
                                        StrokeShape="{StaticResource UiRoundRectangleRadius999}"
                                        StrokeThickness="{StaticResource UiStrokeWidth0}"
                                        Padding="{StaticResource UiInsets8_3}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}">
                                        <Label
                                            Text="{Binding SelectedMealDetail.StyleLabel, Converter={StaticResource LocalizedStringConverter}}"
                                            Style="{StaticResource CaptionStrong}"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                                            FontSize="{StaticResource UiFontSize13}" />
                                    </Border>
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding SelectedMealDetail.StyleDescription, Converter={StaticResource LocalizedStringConverter}}"
                                        Style="{StaticResource MutedMedium}"
                                        LineBreakMode="WordWrap"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Daily fit: flattened from VerticalStackLayout into Grid -->
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource UiSpaceMicro}">
                            <Label
                                Text="{Binding MealFillPercentText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource MutedLabel}"
                                FontAttributes="{StaticResource UiFontAttributesBold}"
                                FontSize="{StaticResource UiFontSize14}" />
                            <Label
                                Grid.Row="1"
                                Text="{Binding DailyProgressText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource MutedMedium}" />
                            <Label
                                Grid.Row="2"
                                Text="{Binding DailyMacroRemainingText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource MutedMedium}" />
                        </Grid>

                        <!-- Ingredients by group -->
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing10}">
                            <Label
                                Grid.Row="0"
                                Text="{loc:LocalizedText Nutrition_MealDetail_Ingredients}"
                                Style="{StaticResource SectionTitle}"
                                FontSize="{StaticResource UiFontSize17}" />

                            <VerticalStackLayout
                                Grid.Row="1"
                                BindableLayout.ItemsSource="{Binding SelectedMealDetail.ComponentGroups}"
                                Spacing="{StaticResource UiSpaceTight}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="nutritionModels:MealSuggestionComponentGroup">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="{StaticResource UiSpaceTight}" RowSpacing="{StaticResource UiSpaceMicro}">
                                            <Image
                                                Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}, ConverterParameter=Accent}"
                                                WidthRequest="{StaticResource UiDimension16}"
                                                HeightRequest="{StaticResource UiDimension16}"
                                                Aspect="AspectFit"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Label, Converter={StaticResource LocalizedStringConverter}}"
                                                Style="{StaticResource CardTitle}"
                                                FontSize="{StaticResource UiFontSize15}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding TotalText, Converter={StaticResource LocalizedStringConverter}}"
                                                Style="{StaticResource MutedMedium}"
                                                VerticalOptions="Center" />

                                            <VerticalStackLayout
                                                Grid.Row="1"
                                                Grid.ColumnSpan="3"
                                                BindableLayout.ItemsSource="{Binding Items}"
                                                Spacing="{StaticResource UiSpacing2}"
                                                Padding="{StaticResource UiInsets24_0_0_0}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate
                                                        x:DataType="nutritionModels:MealSuggestionComponentItem">
                                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing2}" Padding="{StaticResource UiInsets0_2}">
                                                            <Label
                                                                Text="{Binding Name}"
                                                                Style="{StaticResource BodyLabel}"
                                                                FontSize="{StaticResource UiFontSize15}"
                                                                LineBreakMode="WordWrap"
                                                                VerticalOptions="Center" />
                                                            <Label
                                                                Grid.Row="1"
                                                                Text="{Binding DetailText, Converter={StaticResource LocalizedStringConverter}}"
                                                                Style="{StaticResource MutedMedium}"
                                                                VerticalOptions="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Spice blends -->
                        <Grid
                            RowDefinitions="Auto,Auto"
                            RowSpacing="{StaticResource UiSpacing6}"
                            IsVisible="{Binding DetailHasSpiceBlends}">
                            <Label
                                Grid.Row="0"
                                Text="{loc:LocalizedText Nutrition_MealDetail_Seasoning}"
                                Style="{StaticResource SectionTitle}"
                                FontSize="{StaticResource UiFontSize17}" />
                            <VerticalStackLayout
                                Grid.Row="1"
                                BindableLayout.ItemsSource="{Binding SelectedMealDetail.SpiceBlends}"
                                Spacing="{StaticResource UiSpaceMicro}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="nutritionModels:SpiceBlendDetail">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource UiSpaceTight}"
                                              RowSpacing="{StaticResource UiSpacing1}" Padding="{StaticResource UiInsets0_2}">
                                            <Border
                                                Grid.RowSpan="2"
                                                StrokeShape="{StaticResource UiRoundRectangleRadius999}"
                                                StrokeThickness="{StaticResource UiStrokeWidth0}"
                                                Padding="{StaticResource UiInsets6_2}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding IsRecommended}">
                                                <Label
                                                    Text="{loc:LocalizedText Nutrition_MealDetail_RecommendedBadge}"
                                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                                                    FontSize="{StaticResource UiFontSize13}"
                                                    FontAttributes="{StaticResource UiFontAttributesBold}" />
                                            </Border>
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Name}"
                                                Style="{StaticResource CardTitle}"
                                                FontSize="{StaticResource UiFontSize15}" LineBreakMode="WordWrap" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="{Binding Description}"
                                                Style="{StaticResource MutedMedium}"
                                                LineBreakMode="WordWrap" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Directions -->
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource UiSpacing6}">
                            <Label
                                Grid.Row="0"
                                Text="{loc:LocalizedText Nutrition_MealDetail_HowToPrepare}"
                                Style="{StaticResource SectionTitle}"
                                FontSize="{StaticResource UiFontSize17}" />
                            <Label
                                Grid.Row="1"
                                Text="{Binding DetailDirectionsText, Converter={StaticResource LocalizedStringConverter}}"
                                Style="{StaticResource BodyLabel}"
                                FontSize="{StaticResource UiFontSize15}"
                                LineHeight="{StaticResource UiLineHeightLongForm}" />
                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Action buttons -->
                <Grid Grid.Row="3" Padding="{StaticResource UiInsets20_8_20_16}" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource UiSpacing10}">
                    <Button
                        Text="{loc:LocalizedText Common_Back}"
                        Command="{Binding CloseMealDetailCommand}"
                        Style="{StaticResource ButtonSecondary}" />
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource ButtonPrimary}"
                        Text="{loc:LocalizedText Nutrition_MealDetail_UseThisMeal}"
                        Command="{Binding AcceptSuggestionCommand}"
                        CommandParameter="{Binding SelectedMealDetail}" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
