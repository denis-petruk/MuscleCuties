<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Shared.PhaseSaluteOverlay"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:DataType="sharedControls:PhaseSaluteOverlay"
    HorizontalOptions="Fill"
    VerticalOptions="Fill"
    InputTransparent="True"
    IsVisible="False"
    ZIndex="100">

    <Grid
        x:Name="OverlayLayer"
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        Opacity="{StaticResource UiOpacityHidden}">
        <BoxView
            x:Name="LeftSparkTop"
            WidthRequest="{StaticResource UiDimension12}"
            HeightRequest="{StaticResource UiDimension12}"
            CornerRadius="{StaticResource UiCornerRadius6}"
            BackgroundColor="{StaticResource Primary}"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            Margin="{StaticResource UiInsets22_Minus108_0_0}" />

        <BoxView
            x:Name="LeftSparkBottom"
            WidthRequest="{StaticResource UiDimension9}"
            HeightRequest="{StaticResource UiDimension9}"
            CornerRadius="{StaticResource UiCornerRadius5}"
            BackgroundColor="{StaticResource SecondaryDarkText}"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            Margin="{StaticResource UiInsets60_118_0_0}" />

        <BoxView
            x:Name="RightSparkTop"
            WidthRequest="{StaticResource UiDimension10}"
            HeightRequest="{StaticResource UiDimension10}"
            CornerRadius="{StaticResource UiCornerRadius5}"
            BackgroundColor="{StaticResource Primary}"
            HorizontalOptions="End"
            VerticalOptions="Center"
            Margin="{StaticResource UiInsets0_Minus120_54_0}" />

        <BoxView
            x:Name="RightSparkBottom"
            WidthRequest="{StaticResource UiDimension13}"
            HeightRequest="{StaticResource UiDimension13}"
            CornerRadius="{StaticResource UiCornerRadius7}"
            BackgroundColor="{StaticResource SecondaryDarkText}"
            HorizontalOptions="End"
            VerticalOptions="Center"
            Margin="{StaticResource UiInsets0_104_24_0}" />

        <sharedControls:PhaseVisualView
            x:Name="LeftBurst"
            Source="{Binding IconSource, Source={x:Reference Root}}"
            WidthRequest="{StaticResource UiDimension118}"
            HeightRequest="{StaticResource UiDimension118}"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            Margin="{StaticResource UiInsetsMinus34_0_0_0}" />

        <sharedControls:PhaseVisualView
            x:Name="RightBurst"
            Source="{Binding IconSource, Source={x:Reference Root}}"
            WidthRequest="{StaticResource UiDimension118}"
            HeightRequest="{StaticResource UiDimension118}"
            Rotation="{StaticResource UiMotionRotationCelebrationSpark}"
            HorizontalOptions="End"
            VerticalOptions="Center"
            Margin="{StaticResource UiInsets0_0_Minus34_0}" />
    </Grid>
</ContentView>
