<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.UI.Controls.Shared.IconSectionHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.UI.Controls.Shared"
    x:DataType="sharedControls:IconSectionHeader">
    <Grid ColumnDefinitions="24,*" ColumnSpacing="10" MinimumHeightRequest="32">
        <Image
            Source="{Binding IconGlyph, Source={x:Reference Root}, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
            WidthRequest="20"
            HeightRequest="20"
            Aspect="AspectFit"
            VerticalOptions="Center" />
        <Label
            Grid.Column="1"
            Text="{Binding Text, Source={x:Reference Root}}"
            Style="{StaticResource SectionTitle}"
            VerticalOptions="Center" />
    </Grid>
</ContentView>
