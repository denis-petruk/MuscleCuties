<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Owner rule (2026-11-01): iOS only. Android is never targeted, on any host OS. -->
        <TargetFrameworks>net10.0-ios</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>MuscleCuties.UI</RootNamespace>
        <AssemblyName>MuscleCuties.UI</AssemblyName>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>

        <!-- CR01: Button.LayoutButton dereferenced a null platform button on iOS when a page
             popped during layout. The null guard first ships in 10.0.90 (10.0.60 lacks it; see
             dotnet/maui tags 10.0.60 vs 10.0.90, src/Controls/src/Core/Button/Button.iOS.cs).
             CommunityToolkit.Maui 13.0.0 requires Microsoft.Maui.Controls >= 10.0.10. -->
        <MauiVersion>10.0.90</MauiVersion>

        <ApplicationTitle>MuscleCuties</ApplicationTitle>
        <ApplicationId>com.musclecuties.app</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>3</ApplicationVersion>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
        <AnalysisLevel>latest-recommended</AnalysisLevel>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">18.0</SupportedOSPlatformVersion>
        <EnableAppleSignInEntitlements>true</EnableAppleSignInEntitlements>
        <!-- Health synchronization is active for TestFlight delivery: HealthKit entitlement enabled,
             AppleHealthDataProvider compiled on iOS, HealthSyncService active. -->
        <!-- SourceGen XAML inflation. Keep the Shell TabBar navigation check in the owner
             device pass. -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
        <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    </PropertyGroup>

    <PropertyGroup Condition="'$(AppTargetEnvironment)' == 'Beta' or '$(AppTargetEnvironment)' == 'beta'">
        <DefineConstants>$(DefineConstants);APP_ENV_BETA</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Platforms/**/*.cs" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <Compile Include="Platforms/iOS/**/*.cs" />
    </ItemGroup>

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(EnableAppleSignInEntitlements)' == 'true'">
        <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    </PropertyGroup>

    <!-- iOS Release: AOT compile assemblies, with an interpreter available for dynamic
         reflection stubs created by framework code. Keep partial trimming for EF Core. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <RunAOTCompilation>true</RunAOTCompilation>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <MtouchInterpreter>-all</MtouchInterpreter>
        <AotCompileMaxDegreeOfParallelism>2</AotCompileMaxDegreeOfParallelism>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <BuildIpa>false</BuildIpa>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and ('$(RuntimeIdentifier)' == 'iossimulator-arm64' or '$(RuntimeIdentifier)' == 'iossimulator-x64')">
        <CodesignKey>-</CodesignKey>
        <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    </PropertyGroup>

    <!-- USDA FoodData Central key for local Debug simulator runs (docs/FDC_API_SETUP.md).
         Source order: FDC_API_KEY in the build environment, then the gitignored repo-root .env.
         The key is passed to the launched simulator process as an environment variable only;
         it is never compiled into the app, and Release builds ignore it. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <McEnvFile Condition="'$(McEnvFile)' == ''">$(MSBuildThisFileDirectory)../../.env</McEnvFile>
        <_McEnvText Condition="Exists('$(McEnvFile)')">$([System.IO.File]::ReadAllText('$(McEnvFile)'))</_McEnvText>
        <_McFdcApiKey>$(FDC_API_KEY)</_McFdcApiKey>
        <_McFdcApiKey Condition="'$(_McFdcApiKey)' == '' and '$(_McEnvText)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_McEnvText), `(?m)^[ \t]*FDC_API_KEY[ \t]*=[ \t]*["']?([A-Za-z0-9]+)`).Groups.get_Item(1).Value)</_McFdcApiKey>
    </PropertyGroup>
    <ItemGroup Condition="'$(_McFdcApiKey)' != ''">
        <MlaunchEnvironmentVariables Include="FDC_API_KEY=$(_McFdcApiKey)"/>
    </ItemGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#FFF8FB" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'"/>
        <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#FFF8FB" BaseSize="320,180" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'"/>
        <MauiImage Include="Resources\Images\*"/>
        <MauiImage Update="Resources\Images\musclecuties_logo_light.png" Resize="True" BaseSize="360,200"/>
        <MauiImage Update="Resources\Images\musclecuties_logo_dark.png" Resize="True" BaseSize="360,200"/>
        <MauiImage Update="Resources\Images\musclecuties_logo_light_transparent.png" Resize="True" BaseSize="360,200"/>
        <MauiImage Update="Resources\Images\musclecuties_logo_dark_transparent.png" Resize="True" BaseSize="360,200"/>
        <MauiImage Update="Resources\Images\icon_fire.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\icon_fire_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\icon_muscle.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\icon_muscle_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\phase_menstrual.svg" Resize="True" BaseSize="96,96"/>
        <MauiImage Update="Resources\Images\phase_follicular.svg" Resize="True" BaseSize="96,96"/>
        <MauiImage Update="Resources\Images\phase_ovulatory.svg" Resize="True" BaseSize="96,96"/>
        <MauiImage Update="Resources\Images\phase_luteal.svg" Resize="True" BaseSize="96,96"/>
        <MauiImage Update="Resources\Images\tab_today.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_today_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_cycle.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_cycle_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_train.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_train_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_nutrition.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_nutrition_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_you.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_you_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\nav_back.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\feedback_note.svg" Resize="True" BaseSize="64,64"/>
        <MauiImage Update="Resources\Images\privacy_device.svg" Resize="True" BaseSize="64,64"/>
        <MauiFont Include="Resources\Fonts\*.ttf"/>
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <ImageAsset Include="Assets.xcassets\**\*.*"/>
        <BundleResource Include="Platforms/iOS/en.lproj/InfoPlist.strings" LogicalName="en.lproj/InfoPlist.strings"/>
        <BundleResource Include="Platforms/iOS/ru.lproj/InfoPlist.strings" LogicalName="ru.lproj/InfoPlist.strings"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Globalization"/>
        <Using Include="Microsoft.Extensions.DependencyInjection"/>
        <Using Include="Microsoft.Maui"/>
        <Using Include="Microsoft.Maui.ApplicationModel"/>
        <Using Include="Microsoft.Maui.Controls"/>
        <Using Include="Microsoft.Maui.Controls.Xaml"/>
        <Using Include="Microsoft.Maui.Dispatching"/>
        <Using Include="Microsoft.Maui.Hosting"/>
        <Using Include="Microsoft.Maui.Graphics"/>
        <Using Include="Microsoft.Maui.Storage"/>
        <Using Include="Microsoft.Maui.Media"/>
        <Using Include="Microsoft.Maui.Accessibility"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AathifMahir.Maui.MauiIcons.Fluent" Version="6.0.0"/>
        <PackageReference Include="CommunityToolkit.Maui" Version="13.0.0"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0"/>
        <PackageReference Include="SkiaSharp.Extended.UI.Maui" Version="3.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../MuscleCuties.Contracts/MuscleCuties.Contracts.csproj"/>
        <ProjectReference Include="../MuscleCuties.UseCases/MuscleCuties.UseCases.csproj"/>
        <ProjectReference Include="../MuscleCuties.Core/MuscleCuties.Core.csproj"/>
        <ProjectReference Include="../MuscleCuties.Infrastructure/MuscleCuties.Infrastructure.csproj"/>
    </ItemGroup>

    <!-- Check the resolved closure, including transitive packages, before compiling iOS. -->
    <Target Name="RejectIosSqliteDependencies" AfterTargets="ResolvePackageAssets"
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <ItemGroup>
            <IosForbiddenDatabasePackage Include="@(PackageDependencies)"
                Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '(?i)sqlite|sqlcipher'))" />
        </ItemGroup>
        <Error Condition="'@(IosForbiddenDatabasePackage)' != ''"
               Text="iOS production cannot include SQLite dependencies: @(IosForbiddenDatabasePackage). Use first-party cloud stores and encrypted snapshots." />
    </Target>

</Project>