<?xml version="1.0" encoding="UTF-8"?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource PageBackground},
                                        Dark={StaticResource PageBackgroundDark}}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color"
                Value="{AppThemeBinding Light={StaticResource Primary},
                                        Dark={StaticResource White}}" />
    </Style>

    <Style x:Key="BrandLogoImage" TargetType="sharedControls:ThemeAwareBrandLogoImage">
        <Setter Property="Aspect" Value="AspectFit" />
        <Setter Property="WidthRequest" Value="188" />
        <Setter Property="HeightRequest" Value="104" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource Gray400},
                                                            Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardSurface},
                                        Dark={StaticResource CardSurfaceDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Gray300},
                                        Dark={StaticResource Gray600}}" />
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style TargetType="Shadow">
        <Setter Property="Radius" Value="16" />
        <Setter Property="Opacity" Value="0.08" />
        <Setter Property="Brush" Value="{StaticResource ShadowBrush}" />
        <Setter Property="Offset" Value="0,4" />
    </Style>

    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource DeepMauve},
                                        Dark={StaticResource White}}" />
    </Style>

    <Style x:Key="SubHeadline" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="EyebrowLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Primary},
                                        Dark={StaticResource SecondaryDarkText}}" />
    </Style>

    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="MutedLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondary},
                                        Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondary},
                                        Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style x:Key="FormFieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="AccentLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Primary},
                                        Dark={StaticResource SecondaryDarkText}}" />
    </Style>

    <Style x:Key="ErrorLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource ErrorLight},
                                        Dark={StaticResource ErrorDark}}" />
    </Style>

    <Style x:Key="CardPrimary" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardSurface},
                                        Dark={StaticResource CardSurfaceDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource ShadowBrush}" Offset="0,3" Radius="12" Opacity="0.07" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardSecondary" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardSurface},
                                        Dark={StaticResource CardSurfaceDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource ShadowBrush}" Offset="0,2" Radius="10" Opacity="0.05" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModalSurface" TargetType="Border" BasedOn="{StaticResource CardPrimary}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MaximumWidthRequest" Value="560" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource InputStroke},
                                        Dark={StaticResource InputStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="22" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource ShadowBrush}" Offset="0,8" Radius="24" Opacity="0.14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModalTitle" TargetType="Label" BasedOn="{StaticResource SubHeadline}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="ModalSubtitle" TargetType="Label" BasedOn="{StaticResource MutedLabel}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="ModalIconButton" TargetType="Border">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentSurface},
                                        Dark={StaticResource Gray900}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="22" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModalCloseIcon" TargetType="Path">
        <Setter Property="Data" Value="M6 6L18 18M18 6L6 18" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource TextSecondary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="StrokeThickness" Value="2.2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="WidthRequest" Value="18" />
        <Setter Property="HeightRequest" Value="18" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="NutritionLineIcon" TargetType="Path">
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource TextSecondary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="ModalDivider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Margin" Value="20,0" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Gray200},
                                        Dark={StaticResource Gray800}}" />
    </Style>

    <Style x:Key="ModalListItem" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardSurface},
                                        Dark={StaticResource CardSurfaceDark}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource InputStroke},
                                        Dark={StaticResource InputStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModalAccentPanel" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentSurface},
                                        Dark={StaticResource Gray900}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModalFooter" TargetType="Border">
        <Setter Property="Padding" Value="20,12,20,18" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardSurface},
                                        Dark={StaticResource CardSurfaceDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormSection" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardSurface},
                                        Dark={StaticResource CardSurfaceDark}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource InputStroke},
                                        Dark={StaticResource InputStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkoutMetricTile" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentSurface},
                                        Dark={StaticResource Gray900}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="8,10" />
    </Style>

    <Style x:Key="WorkoutMetricValue" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="WorkoutMetricLabel" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondary},
                                        Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="WorkoutPill" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentSurface},
                                        Dark={StaticResource Gray900}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="999" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="WorkoutPillText" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>


    <Style x:Key="WorkoutInfoTile" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardSurface},
                                        Dark={StaticResource CardSurfaceDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style x:Key="WorkoutInfoValue" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}" />
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource Gray300},
                                                            Dark={StaticResource Gray600}}" />
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource Gray500},
                                                            Dark={StaticResource Gray400}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ButtonLink" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Primary},
                                        Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style x:Key="ButtonSecondary" TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardSurface},
                                        Dark={StaticResource CardSurfaceDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="BorderColor"
                Value="{AppThemeBinding Light={StaticResource InputStroke},
                                        Dark={StaticResource InputStrokeDark}}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>


    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondary},
                                        Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark={StaticResource TextPrimaryDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource Gray400},
                                                            Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="InputContainer" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource InputSurface},
                                        Dark={StaticResource InputSurfaceDark}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource InputStroke},
                                        Dark={StaticResource InputStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkoutMetricInput" TargetType="Border" BasedOn="{StaticResource InputContainer}">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="TitleColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondary},
                                        Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondary},
                                        Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="96" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>


    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource PageBackground},
                                        Dark={StaticResource PageBackgroundDark}}" />
        <Setter Property="Shell.ForegroundColor"
                Value="{AppThemeBinding Light={StaticResource Primary},
                                        Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="Shell.TitleColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="Shell.DisabledColor"
                Value="{AppThemeBinding Light={StaticResource Gray400},
                                        Dark={StaticResource Gray600}}" />
        <Setter Property="Shell.UnselectedColor"
                Value="{AppThemeBinding Light={StaticResource Gray500},
                                        Dark={StaticResource Gray500}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardSurface},
                                        Dark={StaticResource CardSurfaceDark}}" />
        <Setter Property="Shell.TabBarForegroundColor"
                Value="{AppThemeBinding Light={StaticResource Primary},
                                        Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="Shell.TabBarTitleColor"
                Value="{AppThemeBinding Light={StaticResource Primary},
                                        Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="Shell.TabBarUnselectedColor"
                Value="{AppThemeBinding Light={StaticResource Gray500},
                                        Dark={StaticResource Gray500}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor"
                Value="{AppThemeBinding Light={StaticResource PageBackground},
                                        Dark={StaticResource PageBackgroundDark}}" />
        <Setter Property="BarTextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="IconImageSource" Value="{x:Null}" />
    </Style>

</ResourceDictionary>
