<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Shared.PageHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    x:DataType="sharedControls:PageHeader">

    <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
        <Border
            WidthRequest="44"
            HeightRequest="44"
            StrokeShape="RoundRectangle 14"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
            Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
            StrokeThickness="1"
            SemanticProperties.Description="Go back">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding BackCommand, Source={x:Reference Root}}" />
            </Border.GestureRecognizers>
            <Image
                Source="{Binding Source='ChevronLeft24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                WidthRequest="20"
                HeightRequest="20"
                Aspect="AspectFit"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
            <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource SubHeadline}" />
            <Label
                Text="{Binding Subtitle, Source={x:Reference Root}}"
                Style="{StaticResource CaptionLabel}"
                IsVisible="{Binding HasSubtitle, Source={x:Reference Root}}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>

