<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MuscleCuties.App.Controls.Shared.MacroProgressGrid"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
        <VerticalStackLayout Grid.Column="0" Spacing="4">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                <Path
                    Data="M4 9v6M7 8v8M17 9v6M14 8v8M7 12h7"
                    Stroke="{AppThemeBinding Light={StaticResource ProteinLight}, Dark={StaticResource ProteinDark}}"
                    StrokeThickness="1.7"
                    StrokeLineCap="Round"
                    Aspect="Uniform"
                    WidthRequest="16"
                    HeightRequest="16"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="Protein"
                    Style="{StaticResource CaptionLabel}" />
            </Grid>
            <Label
                Text="{Binding ProteinText, Source={x:Reference Root}}"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource ProteinLight}, Dark={StaticResource ProteinDark}}" />
            <ProgressBar
                Progress="{Binding ProteinProgress, Source={x:Reference Root}}"
                ProgressColor="{AppThemeBinding Light={StaticResource ProteinLight}, Dark={StaticResource ProteinDark}}"
                BackgroundColor="{StaticResource Gray300}"
                HeightRequest="5" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Column="1" Spacing="4">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                <Path
                    Data="M9 18V5M9 7C6.5 7 5 5.8 5 4M9 10C6.5 10 5 8.8 5 7M9 13C6.5 13 5 11.8 5 10M9 7c2.5 0 4-1.2 4-3M9 10c2.5 0 4-1.2 4-3M9 13c2.5 0 4-1.2 4-3"
                    Stroke="{AppThemeBinding Light={StaticResource CarbsLight}, Dark={StaticResource CarbsDark}}"
                    StrokeThickness="1.5"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Aspect="Uniform"
                    WidthRequest="16"
                    HeightRequest="16"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="Carbs"
                    Style="{StaticResource CaptionLabel}" />
            </Grid>
            <Label
                Text="{Binding CarbsText, Source={x:Reference Root}}"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource CarbsLight}, Dark={StaticResource CarbsDark}}" />
            <ProgressBar
                Progress="{Binding CarbsProgress, Source={x:Reference Root}}"
                ProgressColor="{AppThemeBinding Light={StaticResource CarbsLight}, Dark={StaticResource CarbsDark}}"
                BackgroundColor="{StaticResource Gray300}"
                HeightRequest="5" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Column="2" Spacing="4">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                <Path
                    Data="M10 3C7 7 5 10 5 13a5 5 0 0 0 10 0c0-3-2-6-5-10z"
                    Stroke="{AppThemeBinding Light={StaticResource FatsLight}, Dark={StaticResource FatsDark}}"
                    StrokeThickness="1.6"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Aspect="Uniform"
                    WidthRequest="16"
                    HeightRequest="16"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="Fats"
                    Style="{StaticResource CaptionLabel}" />
            </Grid>
            <Label
                Text="{Binding FatsText, Source={x:Reference Root}}"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource FatsLight}, Dark={StaticResource FatsDark}}" />
            <ProgressBar
                Progress="{Binding FatsProgress, Source={x:Reference Root}}"
                ProgressColor="{AppThemeBinding Light={StaticResource FatsLight}, Dark={StaticResource FatsDark}}"
                BackgroundColor="{StaticResource Gray300}"
                HeightRequest="5" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
