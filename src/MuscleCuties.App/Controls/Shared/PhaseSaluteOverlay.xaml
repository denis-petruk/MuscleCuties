<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MuscleCuties.App.Controls.Shared.PhaseSaluteOverlay"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HorizontalOptions="Fill"
    VerticalOptions="Fill"
    InputTransparent="True"
    IsVisible="False"
    ZIndex="100">

    <Grid
        x:Name="OverlayLayer"
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        Opacity="0">
        <BoxView
            x:Name="LeftSparkTop"
            WidthRequest="12"
            HeightRequest="12"
            CornerRadius="6"
            BackgroundColor="{StaticResource Primary}"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            Margin="22,-108,0,0" />

        <BoxView
            x:Name="LeftSparkBottom"
            WidthRequest="9"
            HeightRequest="9"
            CornerRadius="5"
            BackgroundColor="{StaticResource SecondaryDarkText}"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            Margin="60,118,0,0" />

        <BoxView
            x:Name="RightSparkTop"
            WidthRequest="10"
            HeightRequest="10"
            CornerRadius="5"
            BackgroundColor="{StaticResource Primary}"
            HorizontalOptions="End"
            VerticalOptions="Center"
            Margin="0,-120,54,0" />

        <BoxView
            x:Name="RightSparkBottom"
            WidthRequest="13"
            HeightRequest="13"
            CornerRadius="7"
            BackgroundColor="{StaticResource SecondaryDarkText}"
            HorizontalOptions="End"
            VerticalOptions="Center"
            Margin="0,104,24,0" />

        <sharedControls:PhaseVisualView
            x:Name="LeftBurst"
            Source="{Binding IconSource, Source={x:Reference Root}}"
            WidthRequest="118"
            HeightRequest="118"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            Margin="-34,0,0,0" />

        <sharedControls:PhaseVisualView
            x:Name="RightBurst"
            Source="{Binding IconSource, Source={x:Reference Root}}"
            WidthRequest="118"
            HeightRequest="118"
            Rotation="18"
            HorizontalOptions="End"
            VerticalOptions="Center"
            Margin="0,0,-34,0" />
    </Grid>
</ContentView>
