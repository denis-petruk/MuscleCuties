<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Workout.FeaturedWorkoutCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:workoutControls="clr-namespace:MuscleCuties.App.Controls.Workout"
    x:DataType="workoutControls:FeaturedWorkoutCard">

    <Border Style="{StaticResource CardPrimary}">
        <VerticalStackLayout Spacing="12">

            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding BadgeText, Source={x:Reference Root}}"
                       TextColor="{Binding AccentTextColor, Source={x:Reference Root}}"
                       FontSize="14" FontAttributes="Bold" />

                <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start">
                    <Border
                        StrokeShape="RoundRectangle 999"
                        StrokeThickness="0"
                        Padding="10,5"
                        Margin="0,0,6,6"
                        BackgroundColor="{Binding AccentColor, Source={x:Reference Root}}"
                        IsVisible="{Binding HasSingleActivity, Source={x:Reference Root}}"
                        SemanticProperties.Description="{Binding PrimaryActivityTitle, Source={x:Reference Root}}">
                        <Label
                            Text="{Binding PrimaryActivityTitle, Source={x:Reference Root}}"
                            TextColor="{Binding AccentTextColor, Source={x:Reference Root}}"
                            FontSize="14"
                            FontAttributes="Bold" />
                    </Border>

                    <Border
                        StrokeShape="RoundRectangle 999"
                        StrokeThickness="0"
                        Padding="10,5"
                        Margin="0,0,6,6"
                        BackgroundColor="{Binding PrimaryActivityBackground, Source={x:Reference Root}}"
                        IsVisible="{Binding HasMultipleActivities, Source={x:Reference Root}}"
                        SemanticProperties.Description="{Binding PrimaryActivityTitle, Source={x:Reference Root}}">
                        <Label
                            Text="{Binding PrimaryActivityTitle, Source={x:Reference Root}}"
                            TextColor="{Binding PrimaryActivityTextColor, Source={x:Reference Root}}"
                            FontSize="14"
                            FontAttributes="Bold" />
                    </Border>

                    <Border
                        StrokeShape="RoundRectangle 999"
                        StrokeThickness="0"
                        Padding="10,5"
                        Margin="0,0,6,6"
                        BackgroundColor="{Binding SecondaryActivityBackground, Source={x:Reference Root}}"
                        IsVisible="{Binding HasMultipleActivities, Source={x:Reference Root}}"
                        SemanticProperties.Description="{Binding SecondaryActivityTitle, Source={x:Reference Root}}">
                        <Label
                            Text="{Binding SecondaryActivityTitle, Source={x:Reference Root}}"
                            TextColor="{Binding SecondaryActivityTextColor, Source={x:Reference Root}}"
                            FontSize="14"
                            FontAttributes="Bold" />
                    </Border>
                </FlexLayout>
            </VerticalStackLayout>

            <!-- Title + subtitle -->
            <Label
                Text="{Binding WorkoutTitle, Source={x:Reference Root}}"
                Style="{StaticResource SectionTitle}"
                FontSize="20"
                LineBreakMode="WordWrap" />

            <Label
                Text="{Binding Subtitle, Source={x:Reference Root}}"
                Style="{StaticResource MutedLabel}"
                FontSize="14"
                LineBreakMode="WordWrap" />

            <FlexLayout Direction="Row" Wrap="Wrap" Margin="0,2,0,0">
                <Label Text="{Binding DurationText, Source={x:Reference Root}}"
                       Style="{StaticResource MutedLabel}" FontSize="14" FontAttributes="Bold"
                       Margin="0,0,14,6" />
                <Label Text="{Binding ExercisesCount, Source={x:Reference Root}, StringFormat='{0} exercises'}"
                       Style="{StaticResource MutedLabel}" FontSize="14" FontAttributes="Bold"
                       Margin="0,0,14,6" />
                <Label Text="{Binding Intensity, Source={x:Reference Root}}"
                       Style="{StaticResource MutedLabel}" FontSize="14" FontAttributes="Bold"
                       Margin="0,0,14,6" />
            </FlexLayout>

            <Button Text="{Binding ActionText, Source={x:Reference Root}}"
                    Command="{Binding StartCommand, Source={x:Reference Root}}"
                    MinimumHeightRequest="52" />

        </VerticalStackLayout>
    </Border>
</ContentView>
