<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MuscleCuties.App.Controls.Workout.FeaturedWorkoutCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border Style="{StaticResource CardPrimary}">
        <VerticalStackLayout Spacing="12">
            <Border
                HeightRequest="4"
                BackgroundColor="{Binding AccentColor, Source={x:Reference Root}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 2" />

            <HorizontalStackLayout Spacing="6">
                <BoxView
                    WidthRequest="6"
                    HeightRequest="6"
                    CornerRadius="3"
                    BackgroundColor="{Binding AccentTextColor, Source={x:Reference Root}}"
                    VerticalOptions="Center" />
                <Label
                    Text="{Binding BadgeText, Source={x:Reference Root}}"
                    TextColor="{Binding AccentTextColor, Source={x:Reference Root}}"
                    FontSize="11"
                    FontAttributes="Bold"
                    CharacterSpacing="1.0"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label
                    Text="{Binding WorkoutTitle, Source={x:Reference Root}}"
                    Style="{StaticResource SectionTitle}"
                    FontSize="22"
                    LineBreakMode="WordWrap" />
                <Label
                    Text="{Binding Subtitle, Source={x:Reference Root}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    FontSize="13"
                    LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" Margin="0,2,0,0">
                <Border Style="{StaticResource WorkoutMetricTile}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                        <Label
                            Text="{Binding DurationText, Source={x:Reference Root}}"
                            Style="{StaticResource WorkoutMetricValue}" />
                        <Label Text="DURATION" Style="{StaticResource WorkoutMetricLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource WorkoutMetricTile}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                        <Label
                            Text="{Binding ExercisesCount, Source={x:Reference Root}}"
                            Style="{StaticResource WorkoutMetricValue}" />
                        <Label Text="EXERCISES" Style="{StaticResource WorkoutMetricLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource WorkoutMetricTile}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                        <Label
                            Text="{Binding Intensity, Source={x:Reference Root}}"
                            Style="{StaticResource WorkoutMetricValue}" />
                        <Label Text="INTENSITY" Style="{StaticResource WorkoutMetricLabel}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border
                BackgroundColor="{Binding AccentTextColor, Source={x:Reference Root}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 15"
                HeightRequest="56"
                Margin="0,2,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding StartCommand, Source={x:Reference Root}}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout
                    Spacing="10"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Grid
                        WidthRequest="18"
                        HeightRequest="18"
                        VerticalOptions="Center">
                        <Path
                            Data="M8 5v14l11-7z"
                            Fill="{StaticResource White}"
                            Aspect="Uniform"
                            WidthRequest="17"
                            HeightRequest="17"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Path.Triggers>
                                <DataTrigger
                                    TargetType="Path"
                                    Binding="{Binding ActionText, Source={x:Reference Root}}"
                                    Value="Edit workout">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Path.Triggers>
                        </Path>

                        <Grid IsVisible="False">
                            <Grid.Triggers>
                                <DataTrigger
                                    TargetType="Grid"
                                    Binding="{Binding ActionText, Source={x:Reference Root}}"
                                    Value="Edit workout">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <Path
                                Data="M4 20h4L18.5 9.5l-4-4L4 16v4z"
                                Fill="{StaticResource White}"
                                Aspect="Uniform"
                                WidthRequest="18"
                                HeightRequest="18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                    <Label
                        Text="{Binding ActionText, Source={x:Reference Root}}"
                        TextColor="{StaticResource White}"
                        FontSize="16"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
    </Border>
</ContentView>
