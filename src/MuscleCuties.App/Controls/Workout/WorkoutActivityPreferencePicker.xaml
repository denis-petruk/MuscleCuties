<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Workout.WorkoutActivityPreferencePicker"
    x:Name="PreferencePickerRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MuscleCuties.App.Controls.Workout"
    xmlns:workoutModels="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core"
    x:DataType="controls:WorkoutActivityPreferencePicker">

    <VerticalStackLayout
        Spacing="20"
        BindableLayout.ItemsSource="{Binding ActivityGroups, Source={x:Reference PreferencePickerRoot}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="workoutModels:WorkoutActivityGroupSection">
                <VerticalStackLayout Spacing="10">
                    <Grid
                        ColumnDefinitions="20,*"
                        ColumnSpacing="8"
                        Margin="2,0">
                        <Image
                            Source="{Binding GroupIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                            WidthRequest="15"
                            HeightRequest="15"
                            Aspect="AspectFit"
                            VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding GroupTitle}" Style="{StaticResource FormFieldLabel}" />
                    </Grid>

                    <VerticalStackLayout
                        Spacing="10"
                        BindableLayout.ItemsSource="{Binding Items}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="workoutModels:WorkoutActivityOptionItem">
                                <Border
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="1"
                                    Padding="14,12"
                                    MinimumHeightRequest="72"
                                    HorizontalOptions="Fill"
                                    Margin="0,0,0,2"
                                    SemanticProperties.Description="{Binding Title}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource CardSurfaceDark}}" />
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}" />
                                            <Setter Property="Stroke"
                                                    Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PreferencePickerRoot}, Path=ToggleActivityCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
                                        <Border
                                            Grid.Column="0"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}"
                                                             Value="False">
                                                    <Setter Property="BackgroundColor"
                                                            Value="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource InputSurfaceDark}}" />
                                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Image
                                                Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                                WidthRequest="17"
                                                HeightRequest="17"
                                                Aspect="AspectFit"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding Title}"
                                                Style="{StaticResource BodyLabel}"
                                                FontAttributes="Bold"
                                                LineBreakMode="WordWrap">
                                            </Label>

                                            <Label
                                                Text="{Binding Subtitle}"
                                                Style="{StaticResource MutedLabel}"
                                                FontSize="13"
                                                LineBreakMode="WordWrap">
                                            </Label>
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="2"
                                            Stroke="{StaticResource Primary}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 999"
                                            Padding="8,3"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsRequired}"
                                            BackgroundColor="Transparent">
                                            <Label
                                                Text="Required"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Primary}"
                                                HorizontalTextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
