<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Workout.WorkoutActivityPreferencePicker"
    x:Name="PreferencePickerRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MuscleCuties.App.Controls.Workout"
    xmlns:workoutModels="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core"
    x:DataType="controls:WorkoutActivityPreferencePicker">

    <VerticalStackLayout
        Spacing="22"
        BindableLayout.ItemsSource="{Binding ActivityGroups, Source={x:Reference PreferencePickerRoot}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="workoutModels:WorkoutActivityGroupSection">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="2" Margin="2,4,2,0">
                        <Label
                            Text="{Binding GroupTitle}"
                            Style="{StaticResource FormFieldLabel}"
                            FontSize="16"
                            SemanticProperties.HeadingLevel="Level3" />
                        <Label
                            Text="{Binding GroupDescription}"
                            FontSize="14"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            SemanticProperties.Description="{Binding GroupDescription}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Spacing="10"
                        BindableLayout.ItemsSource="{Binding Items}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="workoutModels:WorkoutActivityOptionItem">
                                <Border
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="1"
                                    Padding="14,10"
                                    MinimumHeightRequest="62"
                                    HorizontalOptions="Fill"
                                    Margin="0"
                                    SemanticProperties.Description="{Binding Title}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="SemanticProperties.Hint" Value="Selected activity, double-tap to deselect" />
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource ActivitySelectedSurfaceLight}, Dark={StaticResource CardSurfaceDark}}" />
                                            <Setter Property="Stroke"
                                                    Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
                                            <Setter Property="StrokeThickness" Value="1.5" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="SemanticProperties.Hint" Value="Not selected, double-tap to select" />
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}" />
                                            <Setter Property="Stroke"
                                                    Value="{AppThemeBinding Light={StaticResource ActivityUnselectedStrokeLight}, Dark={StaticResource Gray800}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PreferencePickerRoot}, Path=ToggleActivityCommand, x:DataType=controls:WorkoutActivityPreferencePicker}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="*,24" ColumnSpacing="16">
                                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding Title}"
                                                Style="{StaticResource BodyLabel}"
                                                FontAttributes="Bold"
                                                LineBreakMode="WordWrap" />

                                            <Label
                                                Text="{Binding Subtitle}"
                                                Style="{StaticResource MutedLabel}"
                                                FontSize="14"
                                                TextColor="{AppThemeBinding Light={StaticResource DeepMauve}, Dark={StaticResource ActivityDescriptionDark}}"
                                                LineBreakMode="WordWrap">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor"
                                                                Value="{AppThemeBinding Light={StaticResource ActivitySelectedSubtitleLight}, Dark={StaticResource ActivityDescriptionDark}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="1"
                                            WidthRequest="24" HeightRequest="24"
                                            StrokeShape="Ellipse"
                                            StrokeThickness="1.5"
                                            VerticalOptions="Center"
                                            BackgroundColor="Transparent">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor"
                                                            Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
                                                    <Setter Property="Stroke"
                                                            Value="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="Stroke"
                                                            Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray500}}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Path Data="M5 12L10 17L19 7" Stroke="White" StrokeThickness="2.5"
                                                  StrokeLineCap="Round" StrokeLineJoin="Round"
                                                  WidthRequest="16" HeightRequest="16" Aspect="Uniform"
                                                  HorizontalOptions="Center" VerticalOptions="Center"
                                                  IsVisible="{Binding IsSelected}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
