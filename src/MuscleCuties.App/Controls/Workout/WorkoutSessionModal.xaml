<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Workout.WorkoutSessionModal"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Workout;assembly=MuscleCuties.Core"
    xmlns:workoutControls="clr-namespace:MuscleCuties.App.Controls.Workout"
    xmlns:workoutModels="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core"
    x:DataType="vm:WorkoutViewModel"
    BackgroundColor="{StaticResource ModalScrim}"
    Padding="20,56,20,34">

    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CloseWorkoutModalCommand}" />
        </Grid.GestureRecognizers>
        <Border
            Style="{StaticResource CardPrimary}"
            Padding="0"
            MaximumHeightRequest="720"
            VerticalOptions="Center">

            <Grid RowDefinitions="Auto, *, Auto">
                <Grid
                    Grid.Row="0"
                    Padding="20,18,20,12"
                    RowDefinitions="Auto, Auto, Auto"
                    RowSpacing="0"
                    ColumnDefinitions="*, Auto"
                    ColumnSpacing="12">

                    <Label
                        Grid.Row="0" Grid.Column="0"
                        Text="{Binding SelectedWorkoutTitle}"
                        Style="{StaticResource SubHeadline}"
                        FontSize="24"
                        LineBreakMode="WordWrap"
                        Margin="0,0,0,6" />

                    <Label
                        Grid.Row="1" Grid.Column="0"
                        Text="{Binding SelectedWorkoutSummaryText}"
                        Style="{StaticResource MutedLabel}"
                        Margin="0,0,0,12" />

                    <Border
                        Grid.Column="1" Grid.RowSpan="2"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        VerticalOptions="Start"
                        SemanticProperties.Description="Close workout">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseWorkoutModalCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Data="M6 6L18 18M18 6L6 18"
                            Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            StrokeThickness="2.2"
                            StrokeLineCap="Round"
                            Aspect="Uniform"
                            WidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <BoxView Grid.Row="2" Grid.ColumnSpan="2" />
                </Grid>

                <Grid Grid.Row="1">
                    <ActivityIndicator
                        IsRunning="{Binding IsWorkoutDetailLoading}"
                        IsVisible="{Binding IsWorkoutDetailLoading}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Loading workout details" />

                    <ScrollView IsVisible="{Binding HasSelectedWorkoutActivities}">
                        <VerticalStackLayout
                            Padding="20,0,20,16"
                            Spacing="14"
                            BindableLayout.ItemsSource="{Binding SelectedWorkoutActivitySections}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="workoutModels:WorkoutActivitySectionItem">
                                    <Border
                                        BackgroundColor="{Binding ActivityBackground}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 22"
                                        Padding="12">
                                        <VerticalStackLayout Spacing="12">
                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="4">
                                                <Label
                                                    Grid.Row="0" Grid.Column="0"
                                                    Text="{Binding OrderText}"
                                                    TextColor="{Binding ActivityTextColor}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    Opacity="0.86" />
                                                <Label
                                                    Grid.Row="1" Grid.Column="0"
                                                    Text="{Binding Title}"
                                                    TextColor="{Binding ActivityTextColor}"
                                                    FontSize="18"
                                                    FontAttributes="Bold"
                                                    LineBreakMode="WordWrap" />
                                                <Label
                                                    Grid.Row="2" Grid.Column="0"
                                                    Text="{Binding Subtitle}"
                                                    TextColor="{Binding ActivityTextColor}"
                                                    FontSize="12"
                                                    Opacity="0.82"
                                                    LineBreakMode="WordWrap" />
                                                <Label
                                                    Grid.Row="3" Grid.Column="0"
                                                    Text="{Binding MetricText}"
                                                    TextColor="{Binding ActivityTextColor}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    Opacity="0.92" />
                                                <Label
                                                    Grid.Row="4" Grid.Column="0"
                                                    Text="{Binding SummaryText}"
                                                    TextColor="{Binding ActivityTextColor}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    Opacity="0.9" />

                                                <Border
                                                    Grid.Column="1" Grid.RowSpan="5"
                                                    BackgroundColor="{Binding ActivityTextColor}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 14"
                                                    Padding="12,10"
                                                    MinimumHeightRequest="44"
                                                    VerticalOptions="Start"
                                                    SemanticProperties.Description="{Binding LogButtonText}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.LogWorkoutActivityCommand, Source={x:Reference Root}}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label
                                                        Text="{Binding LogButtonText}"
                                                        TextColor="{StaticResource White}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        HorizontalTextAlignment="Center" />
                                                </Border>
                                            </Grid>

                                            <VerticalStackLayout
                                                Spacing="10"
                                                BindableLayout.ItemsSource="{Binding Exercises}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="workoutModels:WorkoutExerciseItem">
                                                        <workoutControls:WorkoutExerciseCard
                                                            OpenDetailCommand="{Binding BindingContext.OpenExerciseDetailCommand, Source={x:Reference Root}}"
                                                            LogExerciseCommand="{Binding BindingContext.LogWorkoutExerciseCommand, Source={x:Reference Root}}"
                                                            CommandParameter="{Binding .}" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <Border
                        IsVisible="{Binding ShowWorkoutRestDayState}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="18"
                        Margin="20"
                        VerticalOptions="Center">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Rest day"
                                Style="{StaticResource FormFieldLabel}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Living happy life"
                                Style="{StaticResource SectionTitle}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="No exercises today. Log it when you truly rested, recovered, and kept the promise."
                                Style="{StaticResource MutedLabel}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        IsVisible="{Binding HasWorkoutModalError}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="16"
                        Margin="20"
                        VerticalOptions="Center">
                        <Label
                            Text="{Binding WorkoutModalErrorText}"
                            Style="{StaticResource ErrorLabel}"
                            HorizontalTextAlignment="Center" />
                    </Border>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Padding="20,0,20,20"
                    RowDefinitions="Auto, Auto"
                    RowSpacing="10">
                    <Label
                        Grid.Row="0"
                        Text="{Binding WorkoutModalStatusText}"
                        Style="{StaticResource AccentLabel}"
                        IsVisible="{Binding HasWorkoutModalStatus}"
                        HorizontalTextAlignment="Center" />

                    <Button
                        Grid.Row="1"
                        IsVisible="{Binding ShowWorkoutFooterAction}"
                        Text="{Binding WorkoutLogButtonText}"
                        Command="{Binding SaveWorkoutSessionCommand}"
                        MinimumHeightRequest="52" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</ContentView>
