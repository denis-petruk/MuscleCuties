<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.App.Controls.Workout.WorkoutSessionModal"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Workout;assembly=MuscleCuties.Core"
    xmlns:workoutControls="clr-namespace:MuscleCuties.App.Controls.Workout"
    xmlns:workoutModels="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core"
    x:DataType="vm:WorkoutViewModel"
    BackgroundColor="{StaticResource ModalScrim}"
    Padding="12,44,12,20">

    <Grid>
        <BoxView BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseWorkoutModalCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border
            Style="{StaticResource ModalSurface}"
            MaximumHeightRequest="760"
            VerticalOptions="Fill">

            <Grid RowDefinitions="Auto, *, Auto">
                <Grid
                    Grid.Row="0"
                    Padding="20,18,20,12"
                    RowDefinitions="Auto, Auto, Auto"
                    RowSpacing="0"
                    ColumnDefinitions="*, Auto"
                    ColumnSpacing="12">

                    <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="9" Margin="0,0,0,6">
                        <mi:MauiIcon
                            Icon="{mi:Fluent Dumbbell24}" IconSize="22"
                            IconColor="{AppThemeBinding Light={StaticResource TextAccent}, Dark={StaticResource SecondaryDarkText}}"
                            WidthRequest="22"
                            HeightRequest="22"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding SelectedWorkoutTitle}"
                            Style="{StaticResource ModalTitle}" />
                    </Grid>

                    <Label
                        Grid.Row="1" Grid.Column="0"
                        Text="{Binding SelectedWorkoutSummaryText}"
                        Style="{StaticResource ModalSubtitle}"
                        Margin="0,0,0,12" />

                    <Border
                        Grid.Column="1" Grid.RowSpan="2"
                        Style="{StaticResource ModalIconButton}"
                        VerticalOptions="Start"
                        SemanticProperties.Description="Close workout">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseWorkoutModalCommand}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>

                    <BoxView Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource ModalDivider}" Margin="0" />
                </Grid>

                <Grid Grid.Row="1">
                    <ActivityIndicator
                        IsRunning="{Binding IsWorkoutDetailLoading}"
                        IsVisible="{Binding IsWorkoutDetailLoading}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Loading workout details" />

                    <CollectionView
                        IsVisible="{Binding HasSelectedWorkoutActivities}"
                        ItemsSource="{Binding SelectedWorkoutActivitySections}"
                        IsGrouped="True"
                        SelectionMode="None">
                        <CollectionView.GroupHeaderTemplate>
                            <DataTemplate x:DataType="workoutModels:WorkoutActivitySectionItem">
                                <Border
                                    BackgroundColor="{Binding ActivityBackground}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14"
                                    Margin="20,14,20,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                                        <Border
                                            Grid.RowSpan="2"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            StrokeShape="RoundRectangle 20"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">
                                            <Image
                                                Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding OrderText}"
                                            TextColor="{Binding ActivityTextColor}"
                                            FontSize="10"
                                            FontAttributes="Bold" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding Title}"
                                            TextColor="{Binding ActivityTextColor}"
                                            FontSize="17"
                                            FontAttributes="Bold" />
                                        <Button
                                            Grid.Column="2"
                                            Grid.RowSpan="2"
                                            Text="{Binding LogButtonText}"
                                            Command="{Binding BindingContext.LogWorkoutActivityCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{Binding ActivityTextColor}"
                                            TextColor="{StaticResource White}"
                                            FontSize="12"
                                            MinimumHeightRequest="44"
                                            Padding="12,0"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Row="2"
                                            Grid.ColumnSpan="3"
                                            Text="{Binding Subtitle}"
                                            TextColor="{Binding ActivityTextColor}"
                                            FontSize="12"
                                            LineBreakMode="WordWrap"
                                            Margin="0,8,0,0" />
                                        <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="3" Spacing="6" Margin="0,3,0,0">
                                            <Label Text="{Binding MetricText}" TextColor="{Binding ActivityTextColor}" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="·" TextColor="{Binding ActivityTextColor}" FontSize="11" />
                                            <Label Text="{Binding SummaryText}" TextColor="{Binding ActivityTextColor}" FontSize="11" FontAttributes="Bold" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.GroupHeaderTemplate>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="workoutModels:WorkoutExerciseItem">
                                <workoutControls:WorkoutExerciseCard
                                    Margin="20,0,20,10"
                                    OpenDetailCommand="{Binding BindingContext.OpenExerciseDetailCommand, Source={x:Reference Root}}"
                                    LogExerciseCommand="{Binding BindingContext.LogWorkoutExerciseCommand, Source={x:Reference Root}}"
                                    SwapExerciseCommand="{Binding BindingContext.OpenSwapPanelCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.Footer>
                            <BoxView HeightRequest="16" Color="Transparent" />
                        </CollectionView.Footer>
                    </CollectionView>

                    <Border
                        IsVisible="{Binding ShowWorkoutRestDayState}"
                        Style="{StaticResource ModalAccentPanel}"
                        Padding="18"
                        Margin="20"
                        VerticalOptions="Center">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Rest day"
                                Style="{StaticResource FormFieldLabel}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Living happy life"
                                Style="{StaticResource SectionTitle}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="No exercises today. Log it when you truly rested, recovered, and kept the promise."
                                Style="{StaticResource MutedLabel}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        IsVisible="{Binding HasWorkoutModalError}"
                        Style="{StaticResource ModalAccentPanel}"
                        Padding="16"
                        Margin="20"
                        VerticalOptions="Center">
                        <Label
                            Text="{Binding WorkoutModalErrorText}"
                            Style="{StaticResource ErrorLabel}"
                            HorizontalTextAlignment="Center" />
                    </Border>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Padding="20,10,20,18"
                    RowDefinitions="Auto, Auto"
                    RowSpacing="10">
                    <Label
                        Grid.Row="0"
                        Text="{Binding WorkoutModalStatusText}"
                        Style="{StaticResource AccentLabel}"
                        IsVisible="{Binding HasWorkoutModalStatus}"
                        HorizontalTextAlignment="Center" />

                    <Button
                        Grid.Row="1"
                        IsVisible="{Binding ShowWorkoutFooterAction}"
                        Text="{Binding WorkoutLogButtonText}"
                        Command="{Binding SaveWorkoutSessionCommand}"
                        MinimumHeightRequest="52" />
                </Grid>
            </Grid>
        </Border>

        <!-- Exercise Swap Panel -->
        <Border
            IsVisible="{Binding IsSwapPanelVisible}"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
            StrokeShape="RoundRectangle 20,20,0,0"
            StrokeThickness="0"
            VerticalOptions="End"
            Padding="20,18,20,24"
            InputTransparent="False">
            <VerticalStackLayout Spacing="14">
                <!-- Header -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label
                            Text="Swap exercise"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label
                            Text="{Binding SwapTargetName, StringFormat='Replace {0} with:'}"
                            FontSize="13"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource ModalIconButton}"
                        VerticalOptions="Start"
                        SemanticProperties.Description="Close swap panel">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseSwapPanelCommand}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>

                <!-- Loading -->
                <ActivityIndicator
                    IsRunning="{Binding IsSwapLoading}"
                    IsVisible="{Binding IsSwapLoading}"
                    HeightRequest="40"
                    VerticalOptions="Center" />

                <!-- Candidate list -->
                <CollectionView
                    ItemsSource="{Binding SwapCandidates}"
                    IsVisible="{Binding HasSwapCandidates}"
                    MaximumHeightRequest="260"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="workoutModels:ExerciseSwapOption">
                            <Border
                                Padding="12,10"
                                Margin="0,0,0,6"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1.5"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                InputTransparent="False">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F0EDFF, Dark=#2A2540}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelectSwapCandidateCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label
                                                Text="{Binding MuscleMatch}"
                                                FontSize="11"
                                                TextColor="{StaticResource Primary}" />
                                            <Label
                                                Text="·"
                                                FontSize="11"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            <Label
                                                Text="{Binding Equipment}"
                                                FontSize="11"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Border
                                        Grid.Column="1"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        StrokeShape="RoundRectangle 11"
                                        StrokeThickness="1.5"
                                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#555}"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Path
                                            Data="M5 12l3 3 7-7"
                                            Stroke="{StaticResource White}"
                                            StrokeThickness="2"
                                            StrokeLineCap="Round"
                                            StrokeLineJoin="Round"
                                            Aspect="Uniform"
                                            WidthRequest="12"
                                            HeightRequest="12"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsSelected}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Confirm button -->
                <Button
                    Text="Confirm swap"
                    Command="{Binding ConfirmSwapCommand}"
                    IsVisible="{Binding HasSwapCandidates}"
                    MinimumHeightRequest="50" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
