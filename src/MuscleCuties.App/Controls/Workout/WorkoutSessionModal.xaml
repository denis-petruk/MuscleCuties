<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MuscleCuties.App.Controls.Workout.WorkoutSessionModal"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Workout;assembly=MuscleCuties.Core"
    xmlns:workoutControls="clr-namespace:MuscleCuties.App.Controls.Workout"
    xmlns:workoutModels="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core"
    x:DataType="vm:WorkoutViewModel"
    BackgroundColor="#802B1D24"
    Padding="20,56,20,34">

    <Grid>
        <Border
            Style="{StaticResource CardPrimary}"
            Padding="0"
            MaximumHeightRequest="720"
            VerticalOptions="Center">

        <Grid RowDefinitions="Auto, *, Auto">
            <VerticalStackLayout
                Grid.Row="0"
                Padding="20,18,20,12"
                Spacing="12">

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Border
                            BackgroundColor="{StaticResource Secondary}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            Padding="12,4"
                            HorizontalOptions="Start">
                            <Label
                                Text="{Binding SelectedWorkoutSubtitle}"
                                Style="{StaticResource EyebrowLabel}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </Border>

                        <Label
                            Text="{Binding SelectedWorkoutTitle}"
                            Style="{StaticResource SubHeadline}"
                            FontSize="24"
                            LineBreakMode="WordWrap" />

                        <Label
                            Text="{Binding SelectedWorkoutSummaryText}"
                            Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeShape="RoundRectangle 21"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        VerticalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseWorkoutModalCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Data="M6 6L18 18M18 6L6 18"
                            Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            StrokeThickness="2.2"
                            StrokeLineCap="Round"
                            Aspect="Uniform"
                            WidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <BoxView />
            </VerticalStackLayout>

            <Grid Grid.Row="1">
                <ActivityIndicator
                    IsRunning="{Binding IsWorkoutDetailLoading}"
                    IsVisible="{Binding IsWorkoutDetailLoading}"
                    VerticalOptions="Center" />

                <ScrollView IsVisible="{Binding HasSelectedWorkoutExercises}">
                    <VerticalStackLayout
                        Padding="20,0,20,16"
                        Spacing="12"
                        BindableLayout.ItemsSource="{Binding SelectedWorkoutExercises}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="workoutModels:WorkoutExerciseItem">
                                <workoutControls:WorkoutExerciseCard
                                    OpenDetailCommand="{Binding BindingContext.OpenExerciseDetailCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <Border
                    IsVisible="{Binding ShowWorkoutRestDayState}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="18"
                    Margin="20"
                    VerticalOptions="Center">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="PURE REST DAY"
                            Style="{StaticResource EyebrowLabel}"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Living happy life"
                            Style="{StaticResource SectionTitle}"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="No exercises today. Log it when you truly rested, recovered, and kept the promise."
                            Style="{StaticResource MutedLabel}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    IsVisible="{Binding HasWorkoutModalError}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="16"
                    Margin="20"
                    VerticalOptions="Center">
                    <Label
                        Text="{Binding WorkoutModalErrorText}"
                        Style="{StaticResource ErrorLabel}"
                        HorizontalTextAlignment="Center" />
                </Border>
            </Grid>

            <VerticalStackLayout
                Grid.Row="2"
                Padding="20,0,20,20"
                Spacing="10">
                <Label
                    Text="{Binding WorkoutModalStatusText}"
                    Style="{StaticResource AccentLabel}"
                    IsVisible="{Binding HasWorkoutModalStatus}"
                    HorizontalTextAlignment="Center" />

                <Button
                    Text="{Binding WorkoutLogButtonText}"
                    Command="{Binding SaveWorkoutSessionCommand}"
                    HeightRequest="52"
                    CornerRadius="18" />
            </VerticalStackLayout>
        </Grid>
        </Border>

    <Grid
        IsVisible="{Binding IsExerciseDetailModalVisible}"
        BackgroundColor="#662B1D24"
        Padding="0"
        ZIndex="5">
        <Border
            Style="{StaticResource CardPrimary}"
            Padding="0"
            MaximumHeightRequest="560"
            VerticalOptions="Center">
            <Grid RowDefinitions="Auto, *, Auto">
                <VerticalStackLayout
                    Grid.Row="0"
                    Padding="20,18,20,12"
                    Spacing="12">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Border
                                BackgroundColor="{StaticResource Secondary}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                Padding="12,4"
                                HorizontalOptions="Start">
                                <Label
                                    Text="TECHNIQUE"
                                    Style="{StaticResource EyebrowLabel}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Border>

                            <Label
                                Text="{Binding SelectedExerciseName}"
                                Style="{StaticResource SubHeadline}"
                                FontSize="22"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            WidthRequest="42"
                            HeightRequest="42"
                            StrokeShape="RoundRectangle 21"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                            StrokeThickness="0"
                            VerticalOptions="Start">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseExerciseDetailCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M6 6L18 18M18 6L6 18"
                                Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                StrokeThickness="2.2"
                                StrokeLineCap="Round"
                                Aspect="Uniform"
                                WidthRequest="18"
                                HeightRequest="18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <BoxView />
                </VerticalStackLayout>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="20,0,20,16" Spacing="12">
                        <Border Style="{StaticResource WorkoutInfoTile}">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="VIDEO" Style="{StaticResource EyebrowLabel}" FontSize="9" />
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                    <Border
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        StrokeShape="RoundRectangle 21"
                                        BackgroundColor="{StaticResource Primary}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                        <Path
                                            Data="M8 5v14l11-7z"
                                            Fill="{StaticResource White}"
                                            Aspect="Uniform"
                                            WidthRequest="17"
                                            HeightRequest="17"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding SelectedExerciseVideoText}"
                                            Style="{StaticResource WorkoutInfoValue}" />
                                        <Label
                                            Text="{Binding SelectedExerciseVideoUrl}"
                                            Style="{StaticResource CaptionLabel}"
                                            LineBreakMode="TailTruncation"
                                            IsVisible="{Binding HasSelectedExerciseVideo}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource WorkoutInfoTile}">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="TARGET" Style="{StaticResource EyebrowLabel}" FontSize="9" />
                                <Label
                                    Text="{Binding SelectedExerciseTargetText}"
                                    Style="{StaticResource WorkoutInfoValue}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource WorkoutInfoTile}">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="CUES" Style="{StaticResource EyebrowLabel}" FontSize="9" />
                                <Label
                                    Text="{Binding SelectedExerciseTechniqueNotes}"
                                    Style="{StaticResource BodyLabel}"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource WorkoutInfoTile}">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="LAST LOG" Style="{StaticResource EyebrowLabel}" FontSize="9" />
                                <Label
                                    Text="{Binding SelectedExercisePreviousText}"
                                    Style="{StaticResource WorkoutInfoValue}"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource WorkoutInfoTile}">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="TODAY" Style="{StaticResource EyebrowLabel}" FontSize="9" />
                                <Label
                                    Text="{Binding SelectedExerciseRecommendationText}"
                                    TextColor="{StaticResource Primary}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <Grid Grid.Row="2" Padding="20,0,20,20">
                    <Button
                        Text="Done"
                        Command="{Binding CloseExerciseDetailCommand}"
                        HeightRequest="48"
                        CornerRadius="16" />
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</ContentView>
