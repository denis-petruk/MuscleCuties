<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Workout.WorkoutActivityCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:workoutModels="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core"
    x:DataType="workoutModels:WorkoutItem">

    <Border
        Style="{StaticResource CardPrimary}"
        Padding="14"
        Margin="0,0,0,10"
        SemanticProperties.Description="{Binding Title, StringFormat='Open workout: {0}'}">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                <Setter Property="Stroke" Value="{Binding ActivityTextColor}" />
                <Setter Property="StrokeThickness" Value="1.5" />
            </DataTrigger>
        </Border.Triggers>
        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding OpenCommand, Source={x:Reference Root}}"
                CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">

            <Border
                Grid.Column="0"
                WidthRequest="44"
                HeightRequest="44"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{Binding ActivityBackground}"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Label
                    Text="{Binding DayLabel}"
                    TextColor="{Binding ActivityTextColor}"
                    FontSize="11"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Label
                Grid.Column="1"
                Text="{Binding Title}"
                Style="{StaticResource CardTitle}"
                FontSize="15"
                LineBreakMode="TailTruncation"
                VerticalOptions="Center" />

            <Border
                Grid.Column="2"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 999"
                Padding="10,6"
                VerticalOptions="Center">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="False">
                        <Setter Property="BackgroundColor" Value="{Binding ActivityBackground}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label
                    Text="{Binding SessionProgressText}"
                    FontSize="11"
                    FontAttributes="Bold">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="False">
                            <Setter Property="TextColor" Value="{Binding ActivityTextColor}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </Grid>
    </Border>
</ContentView>
