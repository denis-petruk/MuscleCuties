<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Workout.StrengthTrainingStylePicker"
    x:Name="StrengthStyleRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MuscleCuties.App.Controls.Workout"
    xmlns:workoutModels="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core"
    x:DataType="controls:StrengthTrainingStylePicker">

    <VerticalStackLayout
        Spacing="10"
        BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference StrengthStyleRoot}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="workoutModels:StrengthTrainingStyleOptionItem">
                <Border
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1"
                    Padding="16,14"
                    MinimumHeightRequest="72"
                    HorizontalOptions="Fill"
                    SemanticProperties.Description="{Binding Title}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource CardSurfaceDark}}" />
                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}" />
                            <Setter Property="Stroke"
                                    Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference StrengthStyleRoot}, Path=SelectStyleCommand}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="*,22" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{Binding Title}"
                            Style="{StaticResource BodyLabel}"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap" />

                        <Label
                            Text="{Binding Subtitle}"
                            Style="{StaticResource MutedLabel}"
                            FontSize="13"
                            LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            WidthRequest="22"
                            HeightRequest="22"
                            StrokeShape="RoundRectangle 11"
                            VerticalOptions="Center">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <BoxView
                                WidthRequest="8"
                                HeightRequest="8"
                                CornerRadius="4"
                                Color="{StaticResource White}"
                                IsVisible="{Binding IsSelected}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
