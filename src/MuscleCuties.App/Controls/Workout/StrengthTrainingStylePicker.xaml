<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MuscleCuties.App.Controls.Workout.StrengthTrainingStylePicker"
    x:Name="StrengthStyleRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:workoutModels="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core">

    <VerticalStackLayout
        Spacing="8"
        BindableLayout.ItemsSource="{Binding StrengthTrainingStyleOptions}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="workoutModels:StrengthTrainingStyleOptionItem">
                <Border
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1"
                    Padding="14"
                    HorizontalOptions="Fill">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}" />
                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference StrengthStyleRoot}, Path=BindingContext.SelectStrengthTrainingStyleCommand}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{Binding Title}"
                            FontSize="14"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <Label
                            Text="{Binding Subtitle}"
                            FontSize="12"
                            LineBreakMode="WordWrap">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                    <Setter Property="Opacity" Value="0.9" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
