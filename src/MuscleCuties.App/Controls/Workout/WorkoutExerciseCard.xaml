<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Workout.WorkoutExerciseCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:workoutModels="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core"
    x:DataType="workoutModels:WorkoutExerciseItem">

    <Border Style="{StaticResource WorkoutExerciseCard}">
        <Grid ColumnDefinitions="5, *" ColumnSpacing="10">
            <BoxView
                Grid.Column="0"
                BackgroundColor="{Binding ActivityTextColor}"
                CornerRadius="2.5"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                IsVisible="{Binding IsLogged}" />

            <VerticalStackLayout Grid.Column="1" Spacing="10">

                <!-- Header -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <HorizontalStackLayout Spacing="6">
                            <Border
                                BackgroundColor="{Binding ActivityBackground}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999"
                                Padding="8,3"
                                VerticalOptions="Center">
                                <Label
                                    Text="{Binding ActivityTitle}"
                                    TextColor="{Binding ActivityTextColor}"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation" />
                            </Border>

                            <Border
                                BackgroundColor="{Binding ActivityTextColor}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999"
                                Padding="8,3"
                                IsVisible="{Binding IsLogged}"
                                VerticalOptions="Center">
                                <Label
                                    Text="Done"
                                    TextColor="{StaticResource White}"
                                    FontSize="9"
                                    FontAttributes="Bold" />
                            </Border>
                        </HorizontalStackLayout>

                        <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="15" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource WorkoutPill}"
                        MinimumHeightRequest="44"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{Binding DetailsButtonText}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding OpenDetailCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding DetailsButtonText}" Style="{StaticResource WorkoutPillText}" />
                    </Border>
                </Grid>

                <!-- Summary -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                    <Border Style="{StaticResource WorkoutInfoTile}" Padding="8,6">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="TARGET" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                            <Label
                                Text="{Binding TargetText}"
                                Style="{StaticResource WorkoutInfoValue}"
                                FontSize="12"
                                LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource WorkoutInfoTile}" Padding="8,6">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="5">
                            <Path
                                Data="M4 14l5-5 4 4 7-8M15 5h5v5"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="1.5"
                                StrokeLineCap="Round"
                                StrokeLineJoin="Round"
                                Aspect="Uniform"
                                WidthRequest="13"
                                HeightRequest="13"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding RecommendationText}"
                                TextColor="{StaticResource Primary}"
                                FontSize="11"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Details -->
                <Border
                    Style="{StaticResource WorkoutInfoTile}"
                    IsVisible="{Binding IsExpanded}"
                    Padding="10,8">
                    <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="WHY" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                            <Label
                                Text="{Binding WhyText}"
                                Style="{StaticResource CaptionLabel}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Opacity="0.15"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                        <VerticalStackLayout Spacing="3">
                            <Label Text="HOW" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                            <Label
                                Text="{Binding CuesText}"
                                Style="{StaticResource CaptionLabel}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3" IsVisible="{Binding HasQuickTips}">
                            <BoxView HeightRequest="1" Opacity="0.15"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Text="TIPS" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                            <Label
                                Text="{Binding QuickTipsText}"
                                Style="{StaticResource CaptionLabel}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Grid
                            ColumnDefinitions="Auto, *"
                            ColumnSpacing="8"
                            IsVisible="{Binding HasVideo}">
                            <BoxView HeightRequest="1" Opacity="0.15" Grid.ColumnSpan="2"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <Grid
                            ColumnDefinitions="Auto, *"
                            ColumnSpacing="8"
                            IsVisible="{Binding HasVideo}">
                            <Border
                                WidthRequest="32"
                                HeightRequest="32"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{StaticResource Primary}"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Path
                                    Data="M8 5v14l11-7z"
                                    Fill="{StaticResource White}"
                                    Aspect="Uniform"
                                    WidthRequest="13"
                                    HeightRequest="13"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="VIDEO" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                                <Label
                                    Text="{Binding VideoUrl}"
                                    Style="{StaticResource CaptionLabel}"
                                    LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Opacity="0.15"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                        <VerticalStackLayout Spacing="1">
                            <Label Text="PREVIOUS" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                            <Label
                                Text="{Binding PreviousText}"
                                Style="{StaticResource WorkoutInfoValue}"
                                FontSize="12"
                                LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Strength inputs -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" IsVisible="{Binding UsesStrengthMetrics}">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="SETS" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                        <Entry
                            Text="{Binding LoggedSetsText, Mode=TwoWay}"
                            Keyboard="Numeric"
                            MinimumHeightRequest="44"
                            HeightRequest="44"
                            FontSize="14" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="REPS" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                        <Entry
                            Text="{Binding LoggedRepsText, Mode=TwoWay}"
                            Keyboard="Numeric"
                            MinimumHeightRequest="44"
                            HeightRequest="44"
                            FontSize="14" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" Spacing="4" IsVisible="{Binding UsesWeight}">
                        <Label Text="KG" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                        <Entry
                            Text="{Binding LoggedWeightText, Mode=TwoWay}"
                            Placeholder="0"
                            Keyboard="Numeric"
                            MinimumHeightRequest="44"
                            HeightRequest="44"
                            FontSize="14" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Duration input -->
                <VerticalStackLayout Spacing="4" IsVisible="{Binding UsesDurationOnlyMetric}">
                    <Label Text="{Binding DurationLabel}" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                    <Entry
                        Text="{Binding LoggedDurationMinutesText, Mode=TwoWay}"
                        Keyboard="Numeric"
                        HeightRequest="40"
                        FontSize="14" />
                </VerticalStackLayout>

                <!-- Cardio inputs -->
                <Grid
                    RowDefinitions="Auto, Auto, Auto, Auto"
                    ColumnDefinitions="*, *"
                    RowSpacing="6"
                    ColumnSpacing="8"
                    IsVisible="{Binding UsesCardioMetricGrid}">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4"
                                         IsVisible="{Binding UsesDurationMetric}">
                        <Label Text="{Binding DurationLabel}" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                        <Entry
                            Text="{Binding LoggedDurationMinutesText, Mode=TwoWay}"
                            Keyboard="Numeric"
                            MinimumHeightRequest="44"
                            HeightRequest="44"
                            FontSize="14" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4"
                                         IsVisible="{Binding UsesDistanceMetric}">
                        <Label Text="{Binding DistanceLabel}" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                        <Entry
                            Text="{Binding LoggedDistanceKmText, Mode=TwoWay}"
                            Keyboard="Numeric"
                            MinimumHeightRequest="44"
                            HeightRequest="44"
                            FontSize="14" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4" IsVisible="{Binding UsesPaceMetric}">
                        <Label Text="{Binding PaceLabel}" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                        <Entry
                            Text="{Binding LoggedPaceText, Mode=TwoWay}"
                            Placeholder="6:30"
                            MinimumHeightRequest="44"
                            HeightRequest="44"
                            FontSize="14" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4"
                                         IsVisible="{Binding UsesHeartRateMetric}">
                        <Label Text="{Binding HeartRateLabel}" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                        <Entry
                            Text="{Binding LoggedHeartRateText, Mode=TwoWay}"
                            Keyboard="Numeric"
                            MinimumHeightRequest="44"
                            HeightRequest="44"
                            FontSize="14" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4" IsVisible="{Binding UsesPowerMetric}">
                        <Label Text="{Binding PowerLabel}" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                        <Entry
                            Text="{Binding LoggedPowerWattsText, Mode=TwoWay}"
                            Keyboard="Numeric"
                            MinimumHeightRequest="44"
                            HeightRequest="44"
                            FontSize="14" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4"
                                         IsVisible="{Binding UsesCadenceMetric}">
                        <Label Text="{Binding CadenceLabel}" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                        <Entry
                            Text="{Binding LoggedCadenceRpmText, Mode=TwoWay}"
                            Keyboard="Numeric"
                            MinimumHeightRequest="44"
                            HeightRequest="44"
                            FontSize="14" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4"
                                         IsVisible="{Binding UsesEffortMetric}">
                        <Label Text="{Binding EffortLabel}" Style="{StaticResource EyebrowLabel}" FontSize="8" />
                        <Entry
                            Text="{Binding LoggedEffortText, Mode=TwoWay}"
                            Keyboard="Numeric"
                            MinimumHeightRequest="44"
                            HeightRequest="44"
                            FontSize="14" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Log actions -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <Label
                        Text="{Binding LogStatusText}"
                        Style="{StaticResource CaptionLabel}"
                        FontSize="11"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        BackgroundColor="{Binding ActivityTextColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,8"
                        MinimumHeightRequest="44"
                        SemanticProperties.Description="{Binding LogButtonText}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding LogExerciseCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="{Binding LogButtonText}"
                            TextColor="{StaticResource White}"
                            FontSize="12"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
