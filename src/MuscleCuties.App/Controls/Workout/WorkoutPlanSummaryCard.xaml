<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MuscleCuties.App.Controls.Workout.WorkoutPlanSummaryCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border Style="{StaticResource CardPrimary}">
        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="14">

            <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                <Label
                    Text="ACTIVE PLAN"
                    Style="{StaticResource EyebrowLabel}"
                    CharacterSpacing="1.2" />
                <Label
                    Text="{Binding PlanTitle, Source={x:Reference Root}}"
                    Style="{StaticResource SectionTitle}"
                    FontSize="21" />
                <Label
                    Text="{Binding SummaryText, Source={x:Reference Root}}"
                    Style="{StaticResource MutedLabel}"
                    FontSize="13" />
            </VerticalStackLayout>

            <Border
                Grid.Column="1"
                WidthRequest="54"
                HeightRequest="54"
                StrokeShape="RoundRectangle 18"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Path
                    Data="M7 13h10M9 9v8M15 9v8M4 11v4M20 11v4"
                    Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}"
                    StrokeThickness="2.1"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Aspect="Uniform"
                    WidthRequest="24"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </Grid>
    </Border>
</ContentView>
