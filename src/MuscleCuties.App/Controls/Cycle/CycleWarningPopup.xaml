<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MuscleCuties.App.Controls.Cycle.CycleWarningPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Cycle;assembly=MuscleCuties.Core"
    x:DataType="vm:CycleViewModel"
    IsVisible="{Binding IsCycleWarningPopupVisible}"
    ZIndex="3">

    <Grid
        BackgroundColor="#332B1D24"
        Padding="20,0,20,34">
        <Border
            Style="{StaticResource CardPrimary}"
            Padding="18,16"
            MaximumWidthRequest="420"
            VerticalOptions="End">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                    <Border
                        WidthRequest="34"
                        HeightRequest="34"
                        StrokeShape="RoundRectangle 17"
                        BackgroundColor="{StaticResource Secondary}"
                        StrokeThickness="0"
                        VerticalOptions="Start">
                        <Label
                            Text="!"
                            TextColor="{StaticResource Primary}"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label
                            Text="{Binding CycleWarningTitle}"
                            Style="{StaticResource CardTitle}"
                            LineBreakMode="WordWrap" />
                        <Label
                            Text="{Binding CycleWarningText}"
                            Style="{StaticResource MutedLabel}"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="2"
                        WidthRequest="34"
                        HeightRequest="34"
                        StrokeShape="RoundRectangle 17"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        VerticalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseCycleWarningPopupCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Data="M6 6L18 18M18 6L6 18"
                            Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            StrokeThickness="2"
                            StrokeLineCap="Round"
                            Aspect="Uniform"
                            WidthRequest="16"
                            HeightRequest="16"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Grid
                    ColumnDefinitions="*, *"
                    ColumnSpacing="10"
                    IsVisible="{Binding HasCycleWarningSuggestedPhase}">
                    <Button
                        Text="{Binding CycleWarningSuggestedActionText}"
                        Command="{Binding UseCycleWarningSuggestedPhaseCommand}"
                        HeightRequest="46"
                        FontSize="13" />
                    <Button
                        Grid.Column="1"
                        Text="Forgot to log shift"
                        Command="{Binding ReviewEarlierPhaseRecordsCommand}"
                        HeightRequest="46"
                        FontSize="13"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </Grid>

                <Button
                    Text="Got it"
                    Command="{Binding CloseCycleWarningPopupCommand}"
                    HeightRequest="46"
                    IsVisible="{Binding HasCycleWarningSuggestedPhase, Converter={StaticResource InvertedBoolConverter}}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
