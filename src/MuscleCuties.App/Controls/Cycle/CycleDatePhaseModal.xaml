<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MuscleCuties.App.Controls.Cycle.CycleDatePhaseModal"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cycleModels="clr-namespace:MuscleCuties.Core.Models.UI.Cycle;assembly=MuscleCuties.Core"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Cycle;assembly=MuscleCuties.Core"
    x:DataType="vm:CycleViewModel"
    IsVisible="{Binding IsDatePhaseModalVisible}">

    <Grid
        BackgroundColor="#802B1D24"
        Padding="20,56,20,36">
        <Border
            Style="{StaticResource CardPrimary}"
            Padding="0"
            Margin="0"
            MaximumHeightRequest="720"
            VerticalOptions="Center">

            <Grid RowDefinitions="Auto, *, Auto">
                <VerticalStackLayout
                    Grid.Row="0"
                    Padding="20,18,20,12"
                    Spacing="12">

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Border
                                BackgroundColor="{StaticResource Secondary}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                Padding="12,4"
                                HorizontalOptions="Start">
                                <Label
                                    Text="CYCLE DATE"
                                    Style="{StaticResource EyebrowLabel}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Border>

                            <Label
                                Text="{Binding SelectedCalendarDateText}"
                                Style="{StaticResource SubHeadline}"
                                FontSize="24" />

                            <Label
                                Text="{Binding SelectedCalendarPhaseText}"
                                Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            WidthRequest="42"
                            HeightRequest="42"
                            StrokeShape="RoundRectangle 21"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                            StrokeThickness="0"
                            VerticalOptions="Start">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseDatePhaseModalCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M6 6L18 18M18 6L6 18"
                                Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                StrokeThickness="2.2"
                                StrokeLineCap="Round"
                                Aspect="Uniform"
                                WidthRequest="18"
                                HeightRequest="18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        Opacity="0.7" />
                </VerticalStackLayout>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout
                        Padding="20,0,20,16"
                        Spacing="12"
                        BindableLayout.ItemsSource="{Binding PhaseEditOptions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="cycleModels:CyclePhaseOptionItem">
                                <Border
                                    BackgroundColor="{Binding BackgroundColor}"
                                    StrokeShape="RoundRectangle 18"
                                    Stroke="{Binding TextColor}"
                                    StrokeThickness="0"
                                    Padding="16,14">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.SelectPhaseOptionCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding IsSelected}"
                                            Value="True">
                                            <Setter Property="StrokeThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="3">
                                            <Label
                                                Text="{Binding Name}"
                                                TextColor="{Binding TextColor}"
                                                FontSize="15"
                                                FontAttributes="Bold" />
                                            <Label
                                                Text="{Binding Description}"
                                                TextColor="{Binding TextColor}"
                                                FontSize="12"
                                                Opacity="0.75" />
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="1"
                                            WidthRequest="26"
                                            HeightRequest="26"
                                            StrokeShape="RoundRectangle 13"
                                            Stroke="{Binding TextColor}"
                                            StrokeThickness="1.4"
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger
                                                    TargetType="Border"
                                                    Binding="{Binding IsSelected}"
                                                    Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label
                                                Text="✓"
                                                TextColor="{StaticResource White}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding IsSelected}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout
                    Grid.Row="2"
                    Padding="20,0,20,20"
                    Spacing="12">
                    <Label
                        Text="{Binding PhaseEditStatusText}"
                        Style="{StaticResource ErrorLabel}"
                        IsVisible="{Binding HasPhaseEditStatus}" />

                    <Border
                        IsVisible="{Binding HasPhaseJumpWarning}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                        Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16,14">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                Text="{Binding PhaseJumpWarningTitle}"
                                Style="{StaticResource CardTitle}" />
                            <Label
                                Text="{Binding PhaseJumpWarningText}"
                                Style="{StaticResource MutedLabel}" />
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <Button
                                    Text="Use next phase"
                                    Command="{Binding UseSuggestedPhaseCommand}"
                                    IsVisible="{Binding HasSuggestedPhase}"
                                    HeightRequest="48"
                                    FontSize="13" />
                                <Button
                                    Grid.Column="1"
                                    Text="Forgot to log shift"
                                    Command="{Binding ReviewEarlierPhaseRecordsCommand}"
                                    HeightRequest="48"
                                    FontSize="13"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Button
                        Text="Save phase"
                        Command="{Binding SaveDatePhaseCommand}"
                        HeightRequest="52"
                        IsVisible="{Binding HasPhaseJumpWarning, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentView>
