<?xml version="1.0" encoding="utf-8"?>
<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.App.Controls.Injury.InjuryLogModal"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:injuryControls="clr-namespace:MuscleCuties.App.Controls.Injury"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    x:DataType="vm:InjuryLogViewModel">
    <Grid Padding="16,32,16,24">
        <BoxView BackgroundColor="{StaticResource ModalScrim}" Margin="-16,-32,-16,-24">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCommand, Source={x:Reference Root}}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border Style="{StaticResource ModalSurface}" MaximumHeightRequest="700" VerticalOptions="Fill">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="20,16,16,12">
                    <Label Text="Injury log" Style="{StaticResource ModalTitle}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Add" Command="{Binding ToggleAddFormCommand}"
                        Style="{StaticResource ButtonLink}" MinimumWidthRequest="48" MinimumHeightRequest="48"
                        SemanticProperties.Description="Add an injury" />
                    <Border Grid.Column="2" Style="{StaticResource ModalIconButton}"
                        WidthRequest="48" HeightRequest="48" SemanticProperties.Description="Close injury log">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseCommand, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>
                <BoxView Grid.Row="1" Style="{StaticResource ModalDivider}" />
                <injuryControls:InjuryLogContent Grid.Row="2" />
            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
