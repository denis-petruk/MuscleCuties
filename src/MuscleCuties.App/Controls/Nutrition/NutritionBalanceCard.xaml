<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MuscleCuties.App.Controls.Nutrition.NutritionBalanceCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Nutrition;assembly=MuscleCuties.Core"
    x:DataType="vm:NutritionViewModel">

    <Border Style="{StaticResource CardPrimary}">
        <VerticalStackLayout Spacing="14">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <sharedControls:IconSectionHeader
                    Text="TODAY'S BALANCE"
                    IconGlyph="BowlSalad24"
                    VerticalOptions="Center" />
                <Border
                    Grid.Column="1"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                    Padding="10,7"
                    HeightRequest="36"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenMicronutrientsModalCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Image
                            Source="{Binding Source='Molecule24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                            WidthRequest="14"
                            HeightRequest="14"
                            Aspect="AspectFit"
                            VerticalOptions="Center" />
                        <Label
                            Text="Micros"
                            Style="{StaticResource CaptionLabel}"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                    <sharedControls:FitnessIconView
                        Icon="Fire"
                        IconColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}"
                        WidthRequest="20"
                        HeightRequest="20"
                        VerticalOptions="Center" />
                    <Label
                        Text="{Binding CaloriesConsumed}"
                        Style="{StaticResource AccentLabel}"
                        FontSize="26"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label
                    Grid.Column="1"
                    Text="{Binding CaloriesGoal}"
                    Style="{StaticResource CaptionLabel}"
                    VerticalOptions="Center" />
            </Grid>

            <ProgressBar
                Progress="{Binding CaloriesProgress}"
                ProgressColor="{StaticResource Primary}"
                BackgroundColor="{StaticResource Gray300}"
                HeightRequest="8" />

            <sharedControls:MacroProgressGrid
                ProteinText="{Binding ProteinText}"
                ProteinProgress="{Binding ProteinProgress}"
                CarbsText="{Binding CarbsText}"
                CarbsProgress="{Binding CarbsProgress}"
                FatsText="{Binding FatsText}"
                FatsProgress="{Binding FatsProgress}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
