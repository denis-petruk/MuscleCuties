<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MuscleCuties.App.Controls.Nutrition.MealsList"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.Core.Models.UI.Nutrition;assembly=MuscleCuties.Core"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Nutrition;assembly=MuscleCuties.Core"
    x:DataType="vm:NutritionViewModel">

    <VerticalStackLayout Spacing="14">
        <sharedControls:IconSectionHeader
            Text="MEALS"
            IconGlyph="BowlChopsticks24"
            Margin="4,6,4,0" />

        <Border
            Style="{StaticResource CardPrimary}"
            Padding="16"
            IsVisible="{Binding HasNoMeals}">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                <Border
                    Grid.Column="0"
                    WidthRequest="42"
                    HeightRequest="42"
                    StrokeShape="RoundRectangle 21"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Image
                        Source="{Binding Source='Food24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                        WidthRequest="20"
                        HeightRequest="20"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label
                        Text="No meals logged yet"
                        Style="{StaticResource CardTitle}"
                        FontSize="15" />
                    <Label
                        Text="Breakfast, lunch, dinner, snack"
                        Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>

                <Button
                    Grid.Column="2"
                    Text="Log Meal"
                    Command="{Binding OpenAddFoodPanelCommand}"
                    WidthRequest="124"
                    HeightRequest="48"
                    CornerRadius="16"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <Border
            Style="{StaticResource CardPrimary}"
            Padding="4"
            IsVisible="{Binding HasMeals}">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Meals}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="nutritionModels:MealItem">
                        <VerticalStackLayout>
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenMealBreakdownCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" Padding="12,14">
                                <Border
                                    Grid.Column="0"
                                    WidthRequest="52"
                                    HeightRequest="44"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource AccentSurface}"
                                    StrokeThickness="0">
                                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image
                                            Source="{Binding Source='CalendarClock24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                            WidthRequest="13"
                                            HeightRequest="13"
                                            Aspect="AspectFit"
                                            HorizontalOptions="Center" />
                                        <Label
                                            Text="{Binding Time}"
                                            TextColor="{StaticResource Primary}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        Text="{Binding MealType}"
                                        TextColor="{StaticResource Primary}"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        CharacterSpacing="1.0" />
                                    <Label
                                        Text="{Binding Name}"
                                        Style="{StaticResource CardTitle}"
                                        FontSize="15" />
                                    <Label
                                        Text="{Binding MacrosSummaryText}"
                                        Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Spacing="2"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End">
                                    <HorizontalStackLayout Spacing="4" HorizontalOptions="End">
                                        <sharedControls:FitnessIconView
                                            Icon="Fire"
                                            IconColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}"
                                            WidthRequest="13"
                                            HeightRequest="13"
                                            VerticalOptions="Center" />
                                        <Label
                                            Text="{Binding CaloriesText}"
                                            Style="{StaticResource CaptionLabel}"
                                            HorizontalTextAlignment="End"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Image
                                        Source="{Binding Source='ChevronRight24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                        WidthRequest="16"
                                        HeightRequest="16"
                                        Aspect="AspectFit"
                                        HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView Margin="16,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
