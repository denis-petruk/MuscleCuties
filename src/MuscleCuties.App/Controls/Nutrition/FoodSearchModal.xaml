<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Nutrition.FoodSearchModal"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.Core.Models.UI.Nutrition;assembly=MuscleCuties.Core"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Nutrition;assembly=MuscleCuties.Core"
    x:DataType="vm:NutritionViewModel"
    IsVisible="{Binding HasFoodSearchResults}">

    <Grid
        BackgroundColor="{StaticResource ModalScrim}"
        Padding="20,56,20,36">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding DismissFoodSearchResultsCommand}" />
        </Grid.GestureRecognizers>
        <Border
            Style="{StaticResource CardPrimary}"
            Padding="0"
            Margin="0"
            MaximumHeightRequest="640"
            MaximumWidthRequest="560"
            HorizontalOptions="Fill"
            VerticalOptions="Center">

            <Grid RowDefinitions="Auto, Auto, *, Auto">
                <!-- Row 0: Title + close button -->
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*, Auto"
                    ColumnSpacing="12"
                    Padding="20,18,20,12">
                    <Label
                        Text="Choose food"
                        Style="{StaticResource SubHeadline}"
                        FontSize="24"
                        VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        VerticalOptions="Start"
                        SemanticProperties.Description="Close food search">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DismissFoodSearchResultsCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Data="M6 6L18 18M18 6L6 18"
                            Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            StrokeThickness="2.2"
                            StrokeLineCap="Round"
                            Aspect="Uniform"
                            WidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Row 1: Divider -->
                <BoxView
                    Grid.Row="1"
                    Margin="20,0,20,14"
                    HeightRequest="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding FoodSearchResults}"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Default"
                    Margin="20,0,20,8">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="nutritionModels:FoodSearchResultItem">
                            <Border
                                StrokeShape="RoundRectangle 14"
                                Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                                StrokeThickness="1"
                                Padding="16,14"
                                Margin="0,0,0,10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelectFoodResultCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="34, *, Auto" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="5">
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.RowSpan="3"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        StrokeShape="RoundRectangle 17"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                        VerticalOptions="Center">
                                        <Image
                                            Source="{Binding Source='Food24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                            WidthRequest="17"
                                            HeightRequest="17"
                                            Aspect="AspectFit"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <Label
                                        Grid.Row="0" Grid.Column="1"
                                        Text="{Binding Name}"
                                        Style="{StaticResource AccentLabel}"
                                        FontSize="15" />
                                    <Label
                                        Grid.Row="1" Grid.Column="1"
                                        Text="{Binding SourceSummary}"
                                        Style="{StaticResource CaptionLabel}" />
                                    <Border
                                        Grid.Row="2" Grid.Column="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="12,7"
                                        Margin="0,4,0,0"
                                        HorizontalOptions="Fill">
                                        <Label
                                            Text="{Binding NutritionSummary}"
                                            Style="{StaticResource CaptionLabel}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    </Border>

                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Grid.RowSpan="3"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        StrokeShape="RoundRectangle 22"
                                        BackgroundColor="{StaticResource Primary}"
                                        Stroke="{StaticResource Primary}"
                                        VerticalOptions="Center"
                                        SemanticProperties.Description="Add food item">
                                        <Path
                                            Data="M12 5v14M5 12h14"
                                            Stroke="{StaticResource White}"
                                            StrokeThickness="2.2"
                                            StrokeLineCap="Round"
                                            Aspect="Uniform"
                                            WidthRequest="16"
                                            HeightRequest="16"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button
                    Grid.Row="3"
                    Text="{Binding BrowseMoreFoodsButtonText}"
                    Command="{Binding BrowseMoreFoodsCommand}"
                    MinimumHeightRequest="52"
                    Margin="20,4,20,20"
                    IsVisible="{Binding ShowBrowseMoreFoods}" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
