<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.App.Controls.Nutrition.FoodSearchModal"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.Core.Models.UI.Nutrition;assembly=MuscleCuties.Core"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Nutrition;assembly=MuscleCuties.Core"
    x:DataType="vm:NutritionViewModel"
    IsOpen="{Binding IsFoodSearchModalVisible}">

    <Grid
        BackgroundColor="{StaticResource ModalScrim}"
        Padding="16,48,16,24">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding DismissFoodSearchResultsCommand}" />
        </Grid.GestureRecognizers>
        <Border
            Style="{StaticResource ModalSurface}"
            MaximumHeightRequest="680">

            <Grid RowDefinitions="Auto, Auto, *, Auto">
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*, Auto"
                    ColumnSpacing="12"
                    Padding="20,18,20,12">
                    <Label
                        Text="Choose food"
                        Style="{StaticResource ModalTitle}"
                        VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource ModalIconButton}"
                        VerticalOptions="Start"
                        SemanticProperties.Description="Close food search">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DismissFoodSearchResultsCommand}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>

                <BoxView
                    Grid.Row="1"
                    Style="{StaticResource ModalDivider}"
                    Margin="20,0,20,14" />

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding FoodSearchResults}"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Default"
                    Margin="20,0,20,8">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="nutritionModels:FoodSearchResultItem">
                            <Border
                                Style="{StaticResource ModalListItem}"
                                Margin="0,0,0,10"
                                SemanticProperties.Description="{Binding Name, StringFormat='Select {0}'}">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelectFoodResultCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="34, *, Auto" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="5">
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.RowSpan="3"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        StrokeShape="RoundRectangle 17"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                        VerticalOptions="Center">
                                        <Path
                                            Data="M3 2v7c0 1.1.9 2 2 2h2c1.1 0 2-.9 2-2V2M6 2v20M15 2v8h4M19 2v20"
                                            Style="{StaticResource NutritionLineIcon}"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <Label
                                        Grid.Row="0" Grid.Column="1"
                                        Text="{Binding Name}"
                                        Style="{StaticResource AccentLabel}"
                                        FontSize="15" />
                                    <Label
                                        Grid.Row="1" Grid.Column="1"
                                        Text="{Binding SourceSummary}"
                                        Style="{StaticResource CaptionLabel}" />
                                    <Border
                                        Grid.Row="2" Grid.Column="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="12,7"
                                        Margin="0,4,0,0"
                                        HorizontalOptions="Fill">
                                        <Label
                                            Text="{Binding NutritionSummary}"
                                            Style="{StaticResource CaptionLabel}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    </Border>

                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Grid.RowSpan="3"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        StrokeShape="RoundRectangle 22"
                                        BackgroundColor="{StaticResource Primary}"
                                        Stroke="{StaticResource Primary}"
                                        VerticalOptions="Center"
                                        SemanticProperties.Description="Add food item">
                                        <Image
                                            Source="{Binding Source='AddCircle24', Converter={StaticResource StringToFluentIconImageSourceConverter}, ConverterParameter=White}"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button
                    Grid.Row="3"
                    Text="{Binding BrowseMoreFoodsButtonText}"
                    Command="{Binding BrowseMoreFoodsCommand}"
                    MinimumHeightRequest="52"
                    Margin="20,4,20,20"
                    IsVisible="{Binding ShowBrowseMoreFoods}" />
            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
