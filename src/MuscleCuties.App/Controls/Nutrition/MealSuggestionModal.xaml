<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Nutrition.MealSuggestionModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.Core.Models.UI.Nutrition;assembly=MuscleCuties.Core"
    xmlns:nutritionEnums="clr-namespace:MuscleCuties.Core.Models.Enums.Nutrition;assembly=MuscleCuties.Core"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Nutrition;assembly=MuscleCuties.Core"
    x:DataType="vm:NutritionViewModel"
    IsVisible="{Binding IsSuggestionModalVisible}">

    <Grid
        BackgroundColor="{StaticResource ModalScrim}"
        Padding="20,56,20,36">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CloseSuggestionModalCommand}" />
        </Grid.GestureRecognizers>
        <Border
            Style="{StaticResource CardPrimary}"
            Padding="0"
            Margin="0"
            MaximumHeightRequest="700"
            MaximumWidthRequest="560"
            HorizontalOptions="Fill"
            VerticalOptions="Center">

            <Grid RowDefinitions="Auto, *">
                <VerticalStackLayout
                    Grid.Row="0"
                    Padding="20,18,20,14"
                    Spacing="12">

                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="SUGGEST A MEAL"
                                Style="{StaticResource EyebrowLabel}"
                                CharacterSpacing="1.2" />
                            <Label
                                Text="Meal ideas"
                                Style="{StaticResource SubHeadline}"
                                FontSize="22" />
                            <Label
                                Text="{Binding SuggestionTargetText}"
                                Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            WidthRequest="44"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            SemanticProperties.Description="Refresh meal suggestions">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RefreshSuggestionsCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M17.65 6.35A7.958 7.958 0 0012 4a8 8 0 00-8 8 8 8 0 008 8 7.985 7.985 0 005.93-2.65l-1.46-1.46A5.98 5.98 0 0112 18a6 6 0 01-6-6 6 6 0 016-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                Fill="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                Aspect="Uniform"
                                WidthRequest="18"
                                HeightRequest="18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Border
                            Grid.Column="2"
                            WidthRequest="44"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            SemanticProperties.Description="Close suggestions">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseSuggestionModalCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M6 6L18 18M18 6L6 18"
                                Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                StrokeThickness="2.2"
                                StrokeLineCap="Round"
                                Aspect="Uniform"
                                WidthRequest="18"
                                HeightRequest="18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />
                </VerticalStackLayout>

                <!-- Meal type picker step -->
                <VerticalStackLayout
                    Grid.Row="1"
                    IsVisible="{Binding IsMealTypePickerVisible}"
                    Spacing="10"
                    Padding="20,12,20,20"
                    VerticalOptions="Center">
                    <Label
                        Text="Pick a meal"
                        Style="{StaticResource BodyLabel}"
                        FontAttributes="Bold"
                        FontSize="15"
                        HorizontalTextAlignment="Center"
                        Margin="0,0,0,6" />

                    <Button
                        Text="Breakfast"
                        Command="{Binding SelectSuggestionMealTypeCommand}"
                        CommandParameter="{x:Static nutritionEnums:MealType.Breakfast}" />
                    <Button
                        Text="Lunch"
                        Command="{Binding SelectSuggestionMealTypeCommand}"
                        CommandParameter="{x:Static nutritionEnums:MealType.Lunch}" />
                    <Button
                        Text="Dinner"
                        Command="{Binding SelectSuggestionMealTypeCommand}"
                        CommandParameter="{x:Static nutritionEnums:MealType.Dinner}" />
                    <Button
                        Text="Snack"
                        Command="{Binding SelectSuggestionMealTypeCommand}"
                        CommandParameter="{x:Static nutritionEnums:MealType.Snack}" />
                </VerticalStackLayout>

                <ActivityIndicator
                    Grid.Row="1"
                    IsRunning="{Binding IsLoadingSuggestions}"
                    IsVisible="{Binding IsLoadingSuggestions}"
                    Color="{StaticResource Primary}"
                    WidthRequest="36"
                    HeightRequest="36"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Loading meal suggestions" />

                <VerticalStackLayout
                    Grid.Row="1"
                    IsVisible="{Binding HasNoMealSuggestions}"
                    Spacing="10"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="24,32">
                    <Image
                        Source="{Binding Source='Food24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                        WidthRequest="36"
                        HeightRequest="36"
                        Aspect="AspectFit"
                        Opacity="0.4"
                        HorizontalOptions="Center" />
                    <Label
                        Text="No suggestions available"
                        Style="{StaticResource BodyLabel}"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Add more foods to your database to get meal ideas."
                        Style="{StaticResource MutedLabel}"
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>

                <CollectionView
                    Grid.Row="1"
                    ItemsSource="{Binding MealSuggestions}"
                    SelectionMode="None"
                    IsVisible="{Binding HasMealSuggestions}"
                    VerticalScrollBarVisibility="Always"
                    Margin="16,4,16,16">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="nutritionModels:MealSuggestionItem">
                            <Border
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                Padding="16,14"
                                Margin="0,0,0,12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource ShadowBrush}" Offset="0,3" Radius="12" Opacity="0.06" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="10">
                                    <Label
                                        Text="{Binding ConceptName}"
                                        Style="{StaticResource AccentLabel}"
                                        FontSize="16"
                                        FontAttributes="Bold" />
                                    <Label
                                        Text="{Binding ConceptDescription}"
                                        Style="{StaticResource CaptionLabel}"
                                        FontSize="12"
                                        MaxLines="2"
                                        LineBreakMode="TailTruncation" />

                                    <HorizontalStackLayout Spacing="8">
                                        <Border
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray800}}"
                                            Padding="8,4">
                                            <Label
                                                Text="{Binding StyleLabel}"
                                                Style="{StaticResource EyebrowLabel}"
                                                FontSize="9"
                                                CharacterSpacing="0.8" />
                                        </Border>
                                        <Label
                                            Text="{Binding StyleDescription}"
                                            Style="{StaticResource CaptionLabel}"
                                            Opacity="0.7"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <VerticalStackLayout
                                        Spacing="8"
                                        BindableLayout.ItemsSource="{Binding Components}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="nutritionModels:MealSuggestionComponentItem">
                                                <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8">
                                                    <Border
                                                        MinimumWidthRequest="62"
                                                        HeightRequest="24"
                                                        StrokeShape="RoundRectangle 7"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                                        Padding="6,0"
                                                        VerticalOptions="Center">
                                                        <Label
                                                            Text="{Binding RoleLabel}"
                                                            Style="{StaticResource EyebrowLabel}"
                                                            FontSize="8"
                                                            HorizontalTextAlignment="Center"
                                                            VerticalTextAlignment="Center"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center" />
                                                    </Border>
                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Name}"
                                                        Style="{StaticResource BodyLabel}"
                                                        FontSize="13"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="2"
                                                        Text="{Binding PortionText}"
                                                        Style="{StaticResource CaptionLabel}"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="3"
                                                        Text="{Binding CaloriesText}"
                                                        Style="{StaticResource CaptionLabel}"
                                                        FontAttributes="Bold"
                                                        Opacity="0.7"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Spacing="4"
                                        IsVisible="{Binding HasSpiceBlends}">
                                        <Label
                                            Text="SUGGESTED SPICE BLENDS"
                                            Style="{StaticResource EyebrowLabel}"
                                            FontSize="8"
                                            CharacterSpacing="0.9" />
                                        <Label
                                            Text="{Binding SpiceBlendSummary}"
                                            Style="{StaticResource CaptionLabel}"
                                            FontSize="11"
                                            Opacity="0.8" />
                                    </VerticalStackLayout>

                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                        Opacity="0.6" />

                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding CaloriesText}"
                                                Style="{StaticResource AccentLabel}"
                                                FontSize="16" />
                                            <Label
                                                Text="{Binding MacrosText}"
                                                Style="{StaticResource CaptionLabel}"
                                                FontSize="12" />
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="1"
                                            StrokeShape="RoundRectangle 16"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource Primary}"
                                            MinimumWidthRequest="88"
                                            MinimumHeightRequest="44"
                                            Padding="18,0"
                                            VerticalOptions="Center"
                                            SemanticProperties.Description="Use this meal suggestion">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, Path=AcceptSuggestionCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label
                                                Text="Use this"
                                                TextColor="{StaticResource White}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentView>
