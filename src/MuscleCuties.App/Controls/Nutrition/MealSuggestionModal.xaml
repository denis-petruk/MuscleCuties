<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Nutrition.MealSuggestionModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.Core.Models.UI.Nutrition;assembly=MuscleCuties.Core"
    xmlns:nutritionEnums="clr-namespace:MuscleCuties.Core.Models.Enums.Nutrition;assembly=MuscleCuties.Core"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Nutrition;assembly=MuscleCuties.Core"
    x:DataType="vm:NutritionViewModel"
    IsVisible="{Binding IsSuggestionModalVisible}">

    <Grid
        BackgroundColor="{StaticResource ModalScrim}"
        Padding="20,56,20,36">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CloseSuggestionModalCommand}" />
        </Grid.GestureRecognizers>
        <Border
            Style="{StaticResource CardPrimary}"
            Padding="0"
            Margin="0"
            MaximumHeightRequest="700"
            MaximumWidthRequest="560"
            HorizontalOptions="Fill"
            VerticalOptions="Center">

            <Grid RowDefinitions="Auto, *">
                <VerticalStackLayout
                    Grid.Row="0"
                    Padding="20,18,20,14"
                    Spacing="12">

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Meal ideas"
                                Style="{StaticResource SubHeadline}"
                                FontSize="22" />
                            <Label
                                Text="{Binding SuggestionTargetText}"
                                Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            WidthRequest="44"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            SemanticProperties.Description="Refresh meal suggestions">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RefreshSuggestionsCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M17.65 6.35A7.958 7.958 0 0012 4a8 8 0 00-8 8 8 8 0 008 8 7.985 7.985 0 005.93-2.65l-1.46-1.46A5.98 5.98 0 0112 18a6 6 0 01-6-6 6 6 0 016-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                Fill="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                Aspect="Uniform"
                                WidthRequest="18"
                                HeightRequest="18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Border
                            Grid.Column="2"
                            WidthRequest="44"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            SemanticProperties.Description="Close suggestions">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseSuggestionModalCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M6 6L18 18M18 6L6 18"
                                Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                StrokeThickness="2.2"
                                StrokeLineCap="Round"
                                Aspect="Uniform"
                                WidthRequest="18"
                                HeightRequest="18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Row="1"
                    IsVisible="{Binding IsMealTypePickerVisible}"
                    Spacing="12"
                    Padding="20,12,20,20"
                    VerticalOptions="Center">
                    <Label
                        Text="Pick a meal"
                        Style="{StaticResource BodyLabel}"
                        FontAttributes="Bold"
                        FontSize="15"
                        HorizontalTextAlignment="Center"
                        Margin="0,0,0,6" />

                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
                        <Button
                            Text="Breakfast"
                            Style="{StaticResource ButtonSecondary}"
                            Command="{Binding SelectSuggestionMealTypeCommand}"
                            CommandParameter="{x:Static nutritionEnums:MealType.Breakfast}" />
                        <Button
                            Grid.Column="1"
                            Text="Lunch"
                            Style="{StaticResource ButtonSecondary}"
                            Command="{Binding SelectSuggestionMealTypeCommand}"
                            CommandParameter="{x:Static nutritionEnums:MealType.Lunch}" />
                        <Button
                            Grid.Row="1"
                            Text="Dinner"
                            Style="{StaticResource ButtonSecondary}"
                            Command="{Binding SelectSuggestionMealTypeCommand}"
                            CommandParameter="{x:Static nutritionEnums:MealType.Dinner}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="Snack"
                            Style="{StaticResource ButtonSecondary}"
                            Command="{Binding SelectSuggestionMealTypeCommand}"
                            CommandParameter="{x:Static nutritionEnums:MealType.Snack}" />
                    </Grid>
                </VerticalStackLayout>

                <ActivityIndicator
                    Grid.Row="1"
                    IsRunning="{Binding IsLoadingSuggestions}"
                    IsVisible="{Binding IsLoadingSuggestions}"
                    Color="{StaticResource Primary}"
                    WidthRequest="36"
                    HeightRequest="36"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Loading meal suggestions" />

                <VerticalStackLayout
                    Grid.Row="1"
                    IsVisible="{Binding HasNoMealSuggestions}"
                    Spacing="10"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="24,32">
                    <Image
                        Source="{Binding Source='Food24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                        WidthRequest="36"
                        HeightRequest="36"
                        Aspect="AspectFit"
                        Opacity="0.4"
                        HorizontalOptions="Center" />
                    <Label
                        Text="No suggestions available"
                        Style="{StaticResource BodyLabel}"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Add more foods to your database to get meal ideas."
                        Style="{StaticResource MutedLabel}"
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>

                <CollectionView
                    x:Name="SuggestionCollection"
                    Grid.Row="1"
                    ItemsSource="{Binding MealSuggestions}"
                    SelectionMode="None"
                    IsVisible="{Binding HasMealSuggestions}"
                    VerticalScrollBarVisibility="Default"
                    Margin="16,4,16,16"
                    SizeChanged="OnSuggestionsSizeChanged">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            x:Name="SuggestionLayout"
                            Orientation="Vertical"
                            Span="2"
                            HorizontalItemSpacing="10"
                            VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="nutritionModels:MealSuggestionItem">
                            <Border
                                StrokeShape="RoundRectangle 14"
                                Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                                StrokeThickness="1"
                                Padding="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">
                                <VerticalStackLayout Spacing="8">
                                    <Label
                                        Text="{Binding ConceptName}"
                                        Style="{StaticResource AccentLabel}"
                                        FontSize="15"
                                        FontAttributes="Bold" />
                                    <Label
                                        Text="{Binding ConceptDescription}"
                                        Style="{StaticResource CaptionLabel}"
                                        FontSize="12"
                                        MaxLines="2"
                                        LineBreakMode="TailTruncation" />

                                    <Label Text="{Binding StyleLabel}" Style="{StaticResource CaptionLabel}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />

                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                        Opacity="0.6" />

                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding CaloriesText}"
                                                Style="{StaticResource AccentLabel}"
                                                FontSize="16" />
                                            <Label
                                                Text="{Binding MacrosText}"
                                                Style="{StaticResource CaptionLabel}"
                                                FontSize="12" />
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Row="1"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource Primary}"
                                            MinimumHeightRequest="44"
                                            Padding="18,0"
                                            VerticalOptions="Center"
                                            SemanticProperties.Description="Use this meal suggestion">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NutritionViewModel}}, Path=AcceptSuggestionCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label
                                                Text="Choose meal"
                                                TextColor="{StaticResource White}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentView>
