<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MuscleCuties.App.Controls.Nutrition.QuickFoodItemRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtos="clr-namespace:MuscleCuties.Core.Models.Nutrition;assembly=MuscleCuties.Core"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Nutrition;assembly=MuscleCuties.Core"
    x:DataType="dtos:QuickFoodItemDto">

    <Border
        StrokeShape="RoundRectangle 10"
        Padding="10,8"
        MinimumHeightRequest="44"
        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
        StrokeThickness="1">

        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
            <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="2" VerticalOptions="Center">
                <Label Grid.Row="0" Text="{Binding Name}" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                <Label Grid.Row="1" Text="{Binding Detail}" FontSize="11" LineBreakMode="TailTruncation" />
            </Grid>
            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Calories, StringFormat='{0:F0} kcal'}" FontSize="12" VerticalOptions="Center" />
            <Button Grid.Row="1" Grid.Column="1" Text="Edit"
                    Command="{Binding SelectQuickFoodCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                    CommandParameter="{Binding .}" MinimumHeightRequest="44" Padding="8,0" />
            <Button Grid.Row="1" Grid.Column="2"
                    Text="Log"
                    Command="{Binding QuickLogFoodCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                    CommandParameter="{Binding .}"
                    MinimumHeightRequest="44"
                    Padding="8,0"
                    CornerRadius="6"
                    FontSize="11"
                    FontAttributes="Bold"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                    VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
