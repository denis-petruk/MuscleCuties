<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Nutrition.NutritionPhaseFocusCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Nutrition;assembly=MuscleCuties.Core"
    x:DataType="vm:NutritionViewModel">

    <Border
        Background="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToBrushConverter}}"
        Stroke="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
        StrokeShape="RoundRectangle 16"
        StrokeThickness="1"
        Padding="22,20"
        MinimumHeightRequest="138">
        <Grid RowDefinitions="Auto, 14, Auto, 5, Auto" ColumnDefinitions="*, Auto" ColumnSpacing="12">
            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8" VerticalOptions="Center">
                <BoxView
                    WidthRequest="7"
                    HeightRequest="7"
                    CornerRadius="3.5"
                    BackgroundColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                    VerticalOptions="Center" />
                <Label
                    Text="{Binding PhaseFocusBadgeText}"
                    TextColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                    FontSize="10"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border
                Grid.Row="0"
                Grid.Column="1"
                Grid.RowSpan="5"
                WidthRequest="42"
                HeightRequest="42"
                StrokeShape="RoundRectangle 21"
                BackgroundColor="{StaticResource WhiteOverlaySubtle}"
                Stroke="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                StrokeThickness="1"
                VerticalOptions="Start"
                SemanticProperties.Description="Current cycle phase icon">
                <Image
                    Source="{Binding CurrentPhaseIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                    WidthRequest="17"
                    HeightRequest="17"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Label
                Grid.Row="2"
                Grid.Column="0"
                Text="{Binding PhaseFocusTitle}"
                TextColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                FontSize="24"
                FontAttributes="Bold"
                LineBreakMode="WordWrap" />
            <Label
                Grid.Row="4"
                Grid.Column="0"
                Text="{Binding PhaseFocusCopy}"
                TextColor="{Binding CurrentPhase, Converter={StaticResource CyclePhaseToTextColorConverter}}"
                FontSize="16"
                FontAttributes="Bold"
                LineBreakMode="WordWrap" />
        </Grid>
    </Border>
</ContentView>
