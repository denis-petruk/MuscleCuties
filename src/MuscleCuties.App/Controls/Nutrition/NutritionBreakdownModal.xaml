<?xml version="1.0" encoding="utf-8"?>

<sharedControls:AnimatedModalView
    x:Class="MuscleCuties.App.Controls.Nutrition.NutritionBreakdownModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MuscleCuties.App.Controls"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.Core.Models.UI.Nutrition;assembly=MuscleCuties.Core"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Nutrition;assembly=MuscleCuties.Core"
    x:DataType="vm:NutritionViewModel"
    IsOpen="{Binding IsBreakdownModalVisible}">

    <Grid
        BackgroundColor="{StaticResource ModalScrim}"
        Padding="16,48,16,24">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CloseMicronutrientsModalCommand}" />
        </Grid.GestureRecognizers>
        <Border
            Style="{StaticResource ModalSurface}"
            MinimumHeightRequest="560"
            MaximumHeightRequest="720"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

            <Grid RowDefinitions="Auto, Auto, Auto, *">
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*, Auto"
                    RowDefinitions="Auto, Auto"
                    ColumnSpacing="12"
                    RowSpacing="6"
                    Padding="20,18,20,12">
                    <Label
                        Grid.Row="0" Grid.Column="0"
                        Text="{Binding SelectedBreakdownTitle}"
                        Style="{StaticResource ModalTitle}" />
                    <Label
                        Grid.Row="1" Grid.Column="0"
                        Text="{Binding SelectedBreakdownNutrientSummaryText}"
                        Style="{StaticResource ModalSubtitle}" />
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        Style="{StaticResource ModalIconButton}"
                        VerticalOptions="Start"
                        SemanticProperties.Description="Close nutrition breakdown">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseMicronutrientsModalCommand}" />
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource ModalCloseIcon}" />
                    </Border>
                </Grid>

                <BoxView
                    Grid.Row="1"
                    Style="{StaticResource ModalDivider}"
                    Margin="20,0,20,14" />

                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="120, *"
                    ColumnSpacing="16"
                    Padding="20,0,20,16">

                    <controls:MacroPieChart
                        Grid.Column="0"
                        ProteinValue="{Binding SelectedBreakdownProteinCalories}"
                        CarbsValue="{Binding SelectedBreakdownCarbsCalories}"
                        FatsValue="{Binding SelectedBreakdownFatsCalories}"
                        ProteinColor="{AppThemeBinding Light={StaticResource ProteinLight}, Dark={StaticResource ProteinDark}}"
                        CarbsColor="{AppThemeBinding Light={StaticResource CarbsLight}, Dark={StaticResource CarbsDark}}"
                        FatsColor="{AppThemeBinding Light={StaticResource FatsLight}, Dark={StaticResource FatsDark}}"
                        TrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        InnerColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        InnerStrokeColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                    <Grid
                        Grid.Column="1"
                        RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                        RowSpacing="10"
                        VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Row="0" Spacing="7">
                            <Image
                                Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                                WidthRequest="20"
                                HeightRequest="20"
                                Aspect="AspectFit"
                                VerticalOptions="Center" />
                            <Label
                                Text="{Binding SelectedBreakdownCaloriesText}"
                                Style="{StaticResource AccentLabel}"
                                FontSize="20"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label
                            Grid.Row="1"
                            Text="{Binding SelectedBreakdownMacrosText}"
                            Style="{StaticResource CaptionLabel}" />
                        <Label
                            Grid.Row="2"
                            Text="{Binding SelectedBreakdownFiberText}"
                            Style="{StaticResource CaptionLabel}" />

                        <Border
                            Grid.Row="3"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                            Padding="10,8"
                            MinimumHeightRequest="44"
                            HorizontalOptions="Start"
                            IsVisible="{Binding CanEditSelectedBreakdown}"
                            SemanticProperties.Description="Edit meal">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditSelectedBreakdownMealCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6">
                                <Image
                                    Source="{Binding Source='EditSettings24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                    WidthRequest="14"
                                    HeightRequest="14"
                                    Aspect="AspectFit"
                                    VerticalOptions="Center" />
                                <Label
                                    Text="Edit meal"
                                    Style="{StaticResource CaptionLabel}"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <VerticalStackLayout
                            Grid.Row="4"
                            Spacing="7"
                            BindableLayout.ItemsSource="{Binding SelectedBreakdownMacroItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="nutritionModels:MacroBreakdownItem">
                                    <Grid ColumnDefinitions="22, 58, *, Auto" ColumnSpacing="8">
                                        <Path
                                            Data="{Binding IconPathData, Converter={StaticResource StringToGeometryConverter}}"
                                            Style="{StaticResource NutritionLineIcon}"
                                            Stroke="{Binding Color}"
                                            WidthRequest="15"
                                            HeightRequest="15"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Name}"
                                            Style="{StaticResource CaptionLabel}"
                                            VerticalOptions="Center" />
                                        <ProgressBar
                                            Grid.Column="2"
                                            Progress="{Binding Progress}"
                                            ProgressColor="{Binding Color}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                                            HeightRequest="5"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="3"
                                            Text="{Binding AmountText}"
                                            Style="{StaticResource CaptionLabel}"
                                            WidthRequest="52"
                                            HorizontalTextAlignment="End" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

                <CollectionView
                    Grid.Row="3"
                    ItemsSource="{Binding SelectedBreakdownMicronutrients}"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Always"
                    Margin="20,0,20,20"
                    VerticalOptions="Fill">
                    <CollectionView.Header>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,2,0,10" ColumnSpacing="12">
                            <Label
                                Text="Micronutrients"
                                Style="{StaticResource SectionTitle}"
                                FontSize="16"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Daily targets"
                                Style="{StaticResource CaptionLabel}"
                                VerticalOptions="Center" />
                        </Grid>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="nutritionModels:DailyMicronutrientItem">
                            <Border
                                Style="{StaticResource ModalListItem}"
                                Padding="16,14"
                                Margin="0,0,0,8">

                                <Grid
                                    RowDefinitions="Auto, 10, Auto"
                                    ColumnDefinitions="34, *, Auto"
                                    ColumnSpacing="10">
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.RowSpan="3"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        StrokeShape="RoundRectangle 17"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                        VerticalOptions="Center">
                                        <Path
                                            Data="{Binding IconPathData, Converter={StaticResource StringToGeometryConverter}}"
                                            Style="{StaticResource NutritionLineIcon}"
                                            Stroke="{StaticResource Primary}"
                                            WidthRequest="17"
                                            HeightRequest="17"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <Grid
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        RowDefinitions="Auto, Auto"
                                        RowSpacing="2">
                                        <Label
                                            Grid.Row="0"
                                            Text="{Binding Group}"
                                            Style="{StaticResource EyebrowLabel}"
                                            FontSize="9"
                                            CharacterSpacing="1.1" />
                                        <Label
                                            Grid.Row="1"
                                            Text="{Binding Name}"
                                            Style="{StaticResource CardTitle}"
                                            FontSize="15" />
                                    </Grid>

                                    <HorizontalStackLayout
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Spacing="3"
                                        VerticalOptions="Center">
                                        <Label
                                            Text="{Binding AmountText}"
                                            Style="{StaticResource AccentLabel}"
                                            FontSize="13" />
                                        <Label
                                            Text="{Binding GoalText}"
                                            Style="{StaticResource CaptionLabel}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <ProgressBar
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Progress="{Binding Progress}"
                                        ProgressColor="{StaticResource Primary}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                                        HeightRequest="6"
                                        VerticalOptions="Center">
                                        <ProgressBar.Triggers>
                                            <DataTrigger
                                                TargetType="ProgressBar"
                                                Binding="{Binding IsGoalHit}"
                                                Value="True">
                                                <Setter
                                                    Property="ProgressColor"
                                                    Value="{AppThemeBinding Light={StaticResource ReadinessHighLight}, Dark={StaticResource ReadinessHighDark}}" />
                                            </DataTrigger>
                                        </ProgressBar.Triggers>
                                    </ProgressBar>

                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Text="{Binding ProgressText}"
                                        Style="{StaticResource CaptionLabel}"
                                        WidthRequest="44"
                                        HorizontalTextAlignment="End"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</sharedControls:AnimatedModalView>
