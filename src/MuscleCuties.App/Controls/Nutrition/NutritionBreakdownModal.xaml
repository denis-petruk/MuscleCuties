<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MuscleCuties.App.Controls.Nutrition.NutritionBreakdownModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MuscleCuties.App.Controls"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.Core.Models.UI.Nutrition;assembly=MuscleCuties.Core"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Nutrition;assembly=MuscleCuties.Core"
    x:DataType="vm:NutritionViewModel"
    IsVisible="{Binding IsBreakdownModalVisible}">

    <Grid
        BackgroundColor="#802B1D24"
        Padding="20,56,20,36">
        <Border
            Style="{StaticResource CardPrimary}"
            Padding="0"
            Margin="0"
            MaximumHeightRequest="720"
            VerticalOptions="Center">

            <Grid RowDefinitions="Auto, Auto, *">
                <VerticalStackLayout
                    Grid.Row="0"
                    Padding="20,18,20,14"
                    Spacing="12">

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Border
                                BackgroundColor="{StaticResource Secondary}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                Padding="12,4"
                                HorizontalOptions="Start">
                                <Label
                                    Text="BREAKDOWN"
                                    Style="{StaticResource EyebrowLabel}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Border>

                            <Label
                                Text="{Binding SelectedBreakdownTitle}"
                                Style="{StaticResource SubHeadline}"
                                FontSize="24" />

                            <Label
                                Text="{Binding SelectedBreakdownSubtitle}"
                                Style="{StaticResource MutedLabel}" />

                            <Label
                                Text="{Binding SelectedBreakdownNutrientSummaryText}"
                                Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            WidthRequest="42"
                            HeightRequest="42"
                            StrokeShape="RoundRectangle 21"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                            StrokeThickness="0"
                            VerticalOptions="Start">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseMicronutrientsModalCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M6 6L18 18M18 6L6 18"
                                Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                StrokeThickness="2.2"
                                StrokeLineCap="Round"
                                Aspect="Uniform"
                                WidthRequest="18"
                                HeightRequest="18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <BoxView />
                </VerticalStackLayout>

                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="132, *"
                    ColumnSpacing="16"
                    Padding="20,0,20,16">

                    <controls:MacroPieChart
                        Grid.Column="0"
                        ProteinValue="{Binding SelectedBreakdownProteinCalories}"
                        CarbsValue="{Binding SelectedBreakdownCarbsCalories}"
                        FatsValue="{Binding SelectedBreakdownFatsCalories}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="10"
                        VerticalOptions="Center">
                        <Label
                            Text="{Binding SelectedBreakdownCaloriesText}"
                            Style="{StaticResource AccentLabel}"
                            FontSize="22" />
                        <Label
                            Text="{Binding SelectedBreakdownMacrosText}"
                            Style="{StaticResource CaptionLabel}" />
                        <Label
                            Text="{Binding SelectedBreakdownFiberText}"
                            Style="{StaticResource CaptionLabel}" />

                        <VerticalStackLayout
                            Spacing="7"
                            BindableLayout.ItemsSource="{Binding SelectedBreakdownMacroItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="nutritionModels:MacroBreakdownItem">
                                    <Grid ColumnDefinitions="64, *, Auto" ColumnSpacing="8">
                                        <Label
                                            Text="{Binding Name}"
                                            Style="{StaticResource CaptionLabel}"
                                            VerticalOptions="Center" />
                                        <ProgressBar
                                            Grid.Column="1"
                                            Progress="{Binding Progress}"
                                            ProgressColor="{Binding Color}"
                                            BackgroundColor="{StaticResource Gray300}"
                                            HeightRequest="5"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding AmountText}"
                                            Style="{StaticResource CaptionLabel}"
                                            WidthRequest="52"
                                            HorizontalTextAlignment="End" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding SelectedBreakdownMicronutrients}"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Always"
                    Margin="20,0,20,20">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="nutritionModels:DailyMicronutrientItem">
                            <Border
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0"
                                Padding="16,14"
                                Margin="0,0,0,10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">
                                <Border.Shadow>
                                    <Shadow Brush="#2B1D24" Offset="0,3" Radius="12" Opacity="0.06" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                Text="{Binding Group}"
                                                Style="{StaticResource EyebrowLabel}"
                                                FontSize="9"
                                                CharacterSpacing="1.1" />
                                            <Label
                                                Text="{Binding Name}"
                                                Style="{StaticResource CardTitle}"
                                                FontSize="15" />
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout
                                            Grid.Column="1"
                                            Spacing="3"
                                            VerticalOptions="Center">
                                            <Label
                                                Text="{Binding AmountText}"
                                                Style="{StaticResource AccentLabel}"
                                                FontSize="13" />
                                            <Label
                                                Text="{Binding GoalText}"
                                                Style="{StaticResource CaptionLabel}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                        <ProgressBar
                                            Progress="{Binding Progress}"
                                            ProgressColor="{StaticResource Primary}"
                                            BackgroundColor="{StaticResource Gray300}"
                                            HeightRequest="6"
                                            VerticalOptions="Center">
                                            <ProgressBar.Triggers>
                                                <DataTrigger
                                                    TargetType="ProgressBar"
                                                    Binding="{Binding IsGoalHit}"
                                                    Value="True">
                                                    <Setter
                                                        Property="ProgressColor"
                                                        Value="{AppThemeBinding Light={StaticResource ReadinessHighLight}, Dark={StaticResource ReadinessHighDark}}" />
                                                </DataTrigger>
                                            </ProgressBar.Triggers>
                                        </ProgressBar>

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding ProgressText}"
                                            Style="{StaticResource CaptionLabel}"
                                            WidthRequest="44"
                                            HorizontalTextAlignment="End"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentView>
