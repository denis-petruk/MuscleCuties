<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Dashboard.DashboardNutritionCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Dashboard;assembly=MuscleCuties.Core"
    x:DataType="vm:DashboardViewModel">

    <Border Style="{StaticResource CardPrimary}" SemanticProperties.Description="Today's nutrition balance. Tap to view details.">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenNutritionCommand}" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
            <!-- Row 0: section header -->
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="Today's nutrition" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="View all"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Row 1: calorie icon + consumed value (left) + goal (right) -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="5" VerticalOptions="Center">
                    <Image
                        Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                        Aspect="AspectFit"
                        WidthRequest="18"
                        HeightRequest="18"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        Text="{Binding CaloriesConsumed}"
                        TextColor="{StaticResource Primary}"
                        FontSize="16"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />
                </Grid>
                <Label
                    Grid.Column="1"
                    Text="{Binding CaloriesGoal}"
                    Style="{StaticResource CaptionLabel}"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Row 2: calorie progress bar -->
            <ProgressBar
                Grid.Row="2"
                Progress="{Binding CaloriesProgress}"
                ProgressColor="{StaticResource Primary}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                HeightRequest="8"
                Margin="0,-8,0,0" />

            <!-- Row 3: macro progress grid -->
            <sharedControls:MacroProgressGrid
                Grid.Row="3"
                ProteinText="{Binding ProteinText}"
                ProteinProgress="{Binding ProteinProgress}"
                CarbsText="{Binding CarbsText}"
                CarbsProgress="{Binding CarbsProgress}"
                FatsText="{Binding FatsText}"
                FatsProgress="{Binding FatsProgress}" />
        </Grid>
    </Border>
</ContentView>
