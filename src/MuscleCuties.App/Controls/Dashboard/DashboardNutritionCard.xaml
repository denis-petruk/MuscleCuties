<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Dashboard.DashboardNutritionCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Dashboard;assembly=MuscleCuties.Core"
    x:DataType="vm:DashboardViewModel">

    <Border Style="{StaticResource CardPrimary}" SemanticProperties.Description="Today's nutrition balance. Tap to view details.">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenNutritionCommand}" />
        </Border.GestureRecognizers>

        <VerticalStackLayout Spacing="14">
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="Today's nutrition" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="View all"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                    <sharedControls:ThemeAwareImage
                        LightSource="icon_fire.png"
                        DarkSource="icon_fire_dark.png"
                        Aspect="AspectFit"
                        WidthRequest="18"
                        HeightRequest="18"
                        VerticalOptions="Center" />
                    <Label
                        Text="{Binding CaloriesConsumed}"
                        TextColor="{StaticResource Primary}"
                        FontSize="16"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label
                    Grid.Column="1"
                    Text="{Binding CaloriesGoal}"
                    Style="{StaticResource CaptionLabel}"
                    VerticalOptions="Center" />
            </Grid>
            <ProgressBar
                Progress="{Binding CaloriesProgress}"
                ProgressColor="{StaticResource Primary}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                HeightRequest="8"
                Margin="0,-8,0,0" />

            <sharedControls:MacroProgressGrid
                ProteinText="{Binding ProteinText}"
                ProteinProgress="{Binding ProteinProgress}"
                CarbsText="{Binding CarbsText}"
                CarbsProgress="{Binding CarbsProgress}"
                FatsText="{Binding FatsText}"
                FatsProgress="{Binding FatsProgress}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
