<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Dashboard.DashboardPhaseCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Dashboard;assembly=MuscleCuties.Core"
    x:DataType="vm:DashboardViewModel">

    <Border
        BackgroundColor="{Binding PhaseCardBackgroundColor}"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 16"
        Padding="20"
        SemanticProperties.Description="{Binding PhaseCardTitle, StringFormat='Current cycle phase: {0}. Tap to view cycle details.'}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenCycleCommand}" />
        </Border.GestureRecognizers>

        <VerticalStackLayout Spacing="12">
            <HorizontalStackLayout Spacing="8">
                <sharedControls:PhaseVisualView
                    Source="{Binding PhaseIllustrationSource}"
                    WidthRequest="18"
                    HeightRequest="18"
                    VerticalOptions="Center" />
                <Label
                    Text="{Binding PhaseStatusText}"
                    Style="{StaticResource FormFieldLabel}"
                    TextColor="{Binding PhaseCardTextColor}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label
                Text="{Binding PhaseCardTitle}"
                Style="{StaticResource SectionTitle}"
                TextColor="{Binding PhaseCardTextColor}"
                FontSize="24"
                LineBreakMode="WordWrap" />
            <Label
                Text="{Binding PhaseShortAdvice}"
                TextColor="{Binding PhaseCardTextColor}"
                FontSize="15"
                LineBreakMode="WordWrap"
                Margin="0,-6,0,0" />

            <Grid
                RowDefinitions="Auto, 8"
                ColumnDefinitions="*, *, *, *"
                ColumnSpacing="4"
                    RowSpacing="8">
                <Label
                    Text="Menstrual"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{AppThemeBinding Light={StaticResource CyclePhaseMenstrualTextLight}, Dark={StaticResource CyclePhaseMenstrualTextDark}}"
                    FontSize="9" />
                <Label
                    Grid.Column="1"
                    Text="Follicular"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{AppThemeBinding Light={StaticResource CyclePhaseFollicularTextLight}, Dark={StaticResource CyclePhaseFollicularTextDark}}"
                    FontSize="9" />
                <Label
                    Grid.Column="2"
                    Text="Ovulatory"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{AppThemeBinding Light={StaticResource CyclePhaseOvulatoryTextLight}, Dark={StaticResource CyclePhaseOvulatoryTextDark}}"
                    FontSize="9" />
                <Label
                    Grid.Column="3"
                    Text="Luteal"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{AppThemeBinding Light={StaticResource CyclePhaseLutealTextLight}, Dark={StaticResource CyclePhaseLutealTextDark}}"
                    FontSize="9"
                    HorizontalTextAlignment="End" />

                <BoxView
                    Grid.Row="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CyclePhaseMenstrualTextLight}, Dark={StaticResource CyclePhaseMenstrualTextDark}}"
                    CornerRadius="4"
                    HeightRequest="8" />
                <BoxView
                    Grid.Row="1"
                    Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CyclePhaseFollicularTextLight}, Dark={StaticResource CyclePhaseFollicularTextDark}}"
                    CornerRadius="4"
                    HeightRequest="8" />
                <BoxView
                    Grid.Row="1"
                    Grid.Column="2"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CyclePhaseOvulatoryTextLight}, Dark={StaticResource CyclePhaseOvulatoryTextDark}}"
                    CornerRadius="4"
                    HeightRequest="8" />
                <BoxView
                    Grid.Row="1"
                    Grid.Column="3"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CyclePhaseLutealTextLight}, Dark={StaticResource CyclePhaseLutealTextDark}}"
                    CornerRadius="4"
                    HeightRequest="8" />
                <Border
                    Grid.Row="1"
                    Grid.Column="{Binding CurrentPhaseColumn}"
                    WidthRequest="18"
                    HeightRequest="18"
                    StrokeShape="RoundRectangle 9"
                    BackgroundColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    Stroke="{Binding PhaseCardBackgroundColor}"
                    StrokeThickness="2"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*, Auto, *, Auto, *" RowDefinitions="Auto, Auto" RowSpacing="2" Padding="0,12,0,0">
                <BoxView
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="5"
                    HeightRequest="1"
                    BackgroundColor="{Binding PhaseCardDividerColor}"
                    Opacity="0.55"
                    VerticalOptions="Start" />

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="{Binding PhaseTimeLeftValue}"
                    Style="{StaticResource SectionTitle}"
                    TextColor="{Binding PhaseCardTextColor}"
                    FontSize="18" />
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="{Binding PhaseTimeLeftLabel}"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{Binding PhaseCardTextColor}"
                    FontSize="9" />

                <BoxView
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    WidthRequest="1"
                    HeightRequest="38"
                    BackgroundColor="{Binding PhaseCardDividerColor}"
                    Opacity="0.65"
                    VerticalOptions="End" />

                <Label
                    Grid.Row="0"
                    Grid.Column="2"
                    Text="{Binding NextPeriodValue}"
                    Style="{StaticResource SectionTitle}"
                    TextColor="{Binding PhaseCardTextColor}"
                    FontSize="18"
                    Margin="12,0,0,0" />
                <Label
                    Grid.Row="1"
                    Grid.Column="2"
                    Text="Next period"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{Binding PhaseCardTextColor}"
                    FontSize="9"
                    Margin="12,0,0,0" />

                <BoxView
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="3"
                    WidthRequest="1"
                    HeightRequest="38"
                    BackgroundColor="{Binding PhaseCardDividerColor}"
                    Opacity="0.65"
                    VerticalOptions="End" />

                <Label
                    Grid.Row="0"
                    Grid.Column="4"
                    Text="{Binding LoadAdjustmentText}"
                    Style="{StaticResource SectionTitle}"
                    TextColor="{Binding PhaseCardTextColor}"
                    FontSize="18"
                    Margin="12,0,0,0" />
                <Label
                    Grid.Row="1"
                    Grid.Column="4"
                    Text="Load"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{Binding PhaseCardTextColor}"
                    FontSize="9"
                    Margin="12,0,0,0" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
