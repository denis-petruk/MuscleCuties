<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Dashboard.DashboardWorkoutCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Dashboard;assembly=MuscleCuties.Core"
    xmlns:workoutModels="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core"
    x:DataType="vm:DashboardViewModel">

    <Border
        Style="{StaticResource CardPrimary}"
        SemanticProperties.Description="{Binding WorkoutTitle, StringFormat='Today\&#x27;s workout: {0}. Tap to start.'}">
        <VerticalStackLayout Spacing="12">

            <!-- The status leads; activity types remain available as quiet context. -->
            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <Label
                    Text="{Binding WorkoutBadgeText}"
                    TextColor="{StaticResource Primary}"
                    FontSize="14"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />

                <FlexLayout Grid.Row="1" Wrap="Wrap" Direction="Row"
                            BindableLayout.ItemsSource="{Binding WorkoutActivitySections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="workoutModels:WorkoutActivitySection">
                            <Border
                                StrokeShape="RoundRectangle 999"
                                StrokeThickness="0"
                                Padding="8,3"
                                Margin="0,0,6,4"
                                BackgroundColor="{Binding Background}">
                                <Label
                                    Text="{Binding Title}"
                                    TextColor="{Binding TextColor}"
                                    FontSize="12"
                                    VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </Grid>

            <!-- Title + subtitle -->
            <Label
                Text="{Binding WorkoutTitle}"
                Style="{StaticResource SectionTitle}"
                FontSize="20"
                LineBreakMode="WordWrap" />

            <Label
                Text="{Binding WorkoutSubtitle}"
                Style="{StaticResource MutedLabel}"
                FontSize="14"
                LineBreakMode="WordWrap"
                Margin="0,-6,0,0" />

            <!-- Compact summary instead of repeating the card's icon language. -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,4,0,0">
                <Label
                    Text="{Binding WorkoutDurationText}"
                    FontSize="14"
                    Style="{StaticResource MutedLabel}"
                    VerticalOptions="Center" />

                <Label Grid.Column="1" Text="·"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                    FontSize="14" VerticalOptions="Center" />

                <Label
                    Grid.Column="2"
                    Text="{Binding WorkoutExercisesCount, StringFormat='{0} exercises'}"
                    FontSize="14"
                    Style="{StaticResource MutedLabel}"
                    VerticalOptions="Center" />

                <Label Grid.Column="3" Text="·"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                    FontSize="14" VerticalOptions="Center" />

                <Label Grid.Column="4"
                    Text="{Binding WorkoutIntensity}"
                    FontSize="14"
                    Style="{StaticResource MutedLabel}"
                    VerticalOptions="Center" />
            </Grid>

            <!-- CTA button -->
            <Border
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14"
                HeightRequest="52"
                MinimumHeightRequest="52"
                Margin="0,2,0,0"
                SemanticProperties.Description="Start workout">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenWorkoutCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Path
                        Data="M8 5v14l11-7z"
                        Fill="{StaticResource White}"
                        Aspect="Uniform"
                        WidthRequest="16"
                        HeightRequest="16"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        Text="Start workout"
                        TextColor="{StaticResource White}"
                        FontSize="16"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </Border>
</ContentView>
