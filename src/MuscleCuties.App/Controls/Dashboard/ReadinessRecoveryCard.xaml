<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Dashboard.ReadinessRecoveryCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Dashboard;assembly=MuscleCuties.Core"
    x:DataType="{x:Type vm:DashboardViewModel}">

    <Border
        Style="{StaticResource CardPrimary}"
        StrokeThickness="1"
        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
        SemanticProperties.Description="Readiness and recovery guidance is pending review. Tap to check in.">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenDailyCheckInCommand}" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="Readiness and recovery" Style="{StaticResource SectionTitle}" FontSize="17" />
                <Label
                    Grid.Column="1"
                    Text="Check in"
                    TextColor="{StaticResource Primary}"
                    FontSize="14"
                    VerticalOptions="Center"
                    IsVisible="{Binding NeedsDailyCheckIn}" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasApprovedScorePolicy}">
                <Label Text="{Binding CompositeScore}" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
                <Label Grid.Column="1" Text="Daily balance / 100" Style="{StaticResource MutedLabel}"
                       FontSize="13" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="Average of both scores" Style="{StaticResource CaptionLabel}"
                       FontSize="11" VerticalOptions="Center" />
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" ColumnSpacing="14" IsVisible="{Binding HasApprovedScorePolicy}">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto" RowSpacing="4"
                      SemanticProperties.Description="{Binding ReadinessScore, StringFormat='Readiness score: {0}'}">
                    <Grid ColumnDefinitions="36,Auto" ColumnSpacing="8">
                        <Border Style="{StaticResource ReadinessScoreBadge}">
                            <Path
                                Style="{StaticResource ReadinessScoreIcon}"
                                Data="M13 2L4 14h7l-1 8 10-12h-7l1-8z"
                                Stroke="{Binding ReadinessScore, Converter={StaticResource ScoreToColorConverter}}" />
                        </Border>
                        <Label
                            Grid.Column="1"
                            Style="{StaticResource ReadinessScoreValue}"
                            Text="{Binding ReadinessScore}"
                            TextColor="{Binding ReadinessScore, Converter={StaticResource ScoreToColorConverter}}" />
                    </Grid>
                    <Label Grid.Row="1" Text="Readiness" Style="{StaticResource ReadinessScoreMetricTitle}" />
                    <Label Grid.Row="2" Text="{Binding ReadinessLabel}" Style="{StaticResource CaptionLabel}"
                           FontSize="13" LineBreakMode="WordWrap" />
                </Grid>

                <BoxView Grid.Column="1" WidthRequest="1" Margin="0,2"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}" />

                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto" RowSpacing="4"
                      SemanticProperties.Description="{Binding RecoveryScore, StringFormat='Recovery score: {0}'}">
                    <Grid ColumnDefinitions="36,Auto" ColumnSpacing="8">
                        <Border Style="{StaticResource ReadinessScoreBadge}">
                            <Path
                                Style="{StaticResource ReadinessScoreIcon}"
                                Data="M12 21s-8-4.5-8-10a4.5 4.5 0 0 1 8-2.7 4.5 4.5 0 0 1 8 2.7c0 5.5-8 10-8 10z"
                                Stroke="{Binding RecoveryScore, Converter={StaticResource ScoreToColorConverter}}" />
                        </Border>
                        <Label
                            Grid.Column="1"
                            Style="{StaticResource ReadinessScoreValue}"
                            Text="{Binding RecoveryScore}"
                            TextColor="{Binding RecoveryScore, Converter={StaticResource ScoreToColorConverter}}" />
                    </Grid>
                    <Label Grid.Row="1" Text="Recovery" Style="{StaticResource ReadinessScoreMetricTitle}" />
                    <Label Grid.Row="2" Text="{Binding RecoveryLabel}" Style="{StaticResource CaptionLabel}"
                           FontSize="13" LineBreakMode="WordWrap" />
                </Grid>
            </Grid>
            <Label Grid.Row="3" Text="{Binding ScoreSourceLabel}"
                   Style="{StaticResource CaptionLabel}" FontSize="12" LineBreakMode="WordWrap" />
        </Grid>
    </Border>
</ContentView>
