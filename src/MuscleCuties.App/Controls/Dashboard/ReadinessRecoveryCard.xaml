<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Dashboard.ReadinessRecoveryCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Dashboard;assembly=MuscleCuties.Core"
    x:DataType="vm:DashboardViewModel">

    <Border
        Style="{StaticResource CardPrimary}"
        SemanticProperties.Description="Readiness and recovery scores. Tap to check in.">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenDailyCheckInCommand}" />
        </Border.GestureRecognizers>
        <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
            <!-- Row 0: section header -->
            <Grid ColumnDefinitions="*, Auto">
                <Label
                    Text="Readiness and recovery"
                    Style="{StaticResource SectionTitle}"
                    FontSize="17" />
                <Label
                    Grid.Column="1"
                    Text="Check in"
                    Style="{StaticResource CaptionLabel}"
                    TextColor="{StaticResource Primary}"
                    FontSize="14"
                    VerticalOptions="Center"
                    IsVisible="{Binding NeedsDailyCheckIn}" />
            </Grid>

            <!-- Keep both scores scannable without decorative rings or duplicate labels. -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="16">

                <!-- Readiness column -->
                <Grid
                    Grid.Column="0"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="2"
                    SemanticProperties.Description="{Binding ReadinessScore, StringFormat='Readiness score: {0}'}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label
                            Text="{Binding ReadinessScore}"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{Binding ReadinessScore, Converter={StaticResource ScoreToColorConverter}}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="Readiness"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            VerticalOptions="Center" />
                    </Grid>
                    <Label
                        Grid.Row="1"
                        Text="{Binding ReadinessLabel}"
                        Style="{StaticResource CaptionLabel}"
                        FontSize="14"
                        LineBreakMode="WordWrap" />
                </Grid>

                <!-- Recovery column -->
                <Grid
                    Grid.Column="1"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="2"
                    SemanticProperties.Description="{Binding RecoveryScore, StringFormat='Recovery score: {0}'}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label
                            Text="{Binding RecoveryScore}"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{Binding RecoveryScore, Converter={StaticResource ScoreToColorConverter}}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="Recovery"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            VerticalOptions="Center" />
                    </Grid>
                    <Label
                        Grid.Row="1"
                        Text="{Binding RecoveryLabel}"
                        Style="{StaticResource CaptionLabel}"
                        FontSize="14"
                        LineBreakMode="WordWrap" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ContentView>
