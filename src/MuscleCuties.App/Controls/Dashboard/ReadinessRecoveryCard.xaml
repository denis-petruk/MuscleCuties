<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Dashboard.ReadinessRecoveryCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Dashboard;assembly=MuscleCuties.Core"
    x:DataType="vm:DashboardViewModel">

    <Border Style="{StaticResource CardPrimary}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenDailyCheckInCommand}" />
        </Border.GestureRecognizers>
        <Grid RowDefinitions="Auto, Auto" RowSpacing="16">
            <!-- Row 0: section header -->
            <Grid ColumnDefinitions="*, Auto">
                <Label
                    Text="Readiness and recovery"
                    Style="{StaticResource SectionTitle}" />
                <Label
                    Grid.Column="1"
                    Text="Tap to check in"
                    Style="{StaticResource CaptionLabel}"
                    FontAttributes="Italic"
                    VerticalOptions="Center"
                    IsVisible="{Binding NeedsDailyCheckIn}" />
            </Grid>

            <!-- Row 1: score columns -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="16">

                <!-- Readiness column: circle + title + subtitle in a 3-row Grid -->
                <Grid
                    Grid.Column="0"
                    RowDefinitions="88, Auto, Auto"
                    RowSpacing="10"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{Binding ReadinessScore, StringFormat='Readiness score: {0}'}">
                    <!-- Row 0: circle gauge -->
                    <Grid WidthRequest="88" HeightRequest="88" HorizontalOptions="Center">
                        <Border
                            StrokeShape="Ellipse"
                            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                            StrokeThickness="7"
                            BackgroundColor="Transparent"
                            WidthRequest="88"
                            HeightRequest="88" />
                        <Border
                            StrokeShape="Ellipse"
                            Stroke="{Binding ReadinessScore, Converter={StaticResource ScoreToColorConverter}}"
                            StrokeThickness="7"
                            BackgroundColor="Transparent"
                            WidthRequest="88"
                            HeightRequest="88" />
                        <!-- Score value + label centered inside circle -->
                        <Grid VerticalOptions="Center" HorizontalOptions="Center" RowDefinitions="Auto,Auto" RowSpacing="0">
                            <Label
                                Text="{Binding ReadinessScore}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="{Binding ReadinessScore, Converter={StaticResource ScoreToColorConverter}}"
                                HorizontalOptions="Center" />
                            <Label
                                Grid.Row="1"
                                Text="Ready"
                                FontSize="10"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                HorizontalOptions="Center" />
                        </Grid>
                    </Grid>
                    <!-- Row 1: heading -->
                    <Label
                        Grid.Row="1"
                        Text="Readiness"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        HorizontalOptions="Center" />
                    <!-- Row 2: caption -->
                    <Label
                        Grid.Row="2"
                        Text="{Binding ReadinessLabel}"
                        Style="{StaticResource CaptionLabel}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Margin="0,-8,0,0" />
                </Grid>

                <!-- Recovery column: circle + title + subtitle in a 3-row Grid -->
                <Grid
                    Grid.Column="1"
                    RowDefinitions="88, Auto, Auto"
                    RowSpacing="10"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{Binding RecoveryScore, StringFormat='Recovery score: {0}'}">
                    <!-- Row 0: circle gauge -->
                    <Grid WidthRequest="88" HeightRequest="88" HorizontalOptions="Center">
                        <Border
                            StrokeShape="Ellipse"
                            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                            StrokeThickness="7"
                            BackgroundColor="Transparent"
                            WidthRequest="88"
                            HeightRequest="88" />
                        <Border
                            StrokeShape="Ellipse"
                            Stroke="{Binding RecoveryScore, Converter={StaticResource ScoreToColorConverter}}"
                            StrokeThickness="7"
                            BackgroundColor="Transparent"
                            WidthRequest="88"
                            HeightRequest="88" />
                        <!-- Score value + label centered inside circle -->
                        <Grid VerticalOptions="Center" HorizontalOptions="Center" RowDefinitions="Auto,Auto" RowSpacing="0">
                            <Label
                                Text="{Binding RecoveryScore}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="{Binding RecoveryScore, Converter={StaticResource ScoreToColorConverter}}"
                                HorizontalOptions="Center" />
                            <Label
                                Grid.Row="1"
                                Text="Recovery"
                                FontSize="10"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                HorizontalOptions="Center" />
                        </Grid>
                    </Grid>
                    <!-- Row 1: heading -->
                    <Label
                        Grid.Row="1"
                        Text="Recovery"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        HorizontalOptions="Center" />
                    <!-- Row 2: caption -->
                    <Label
                        Grid.Row="2"
                        Text="{Binding RecoveryLabel}"
                        Style="{StaticResource CaptionLabel}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Margin="0,-8,0,0" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ContentView>
