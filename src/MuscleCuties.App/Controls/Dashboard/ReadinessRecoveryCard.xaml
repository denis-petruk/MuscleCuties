<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MuscleCuties.App.Controls.Dashboard.ReadinessRecoveryCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Dashboard;assembly=MuscleCuties.Core"
    x:DataType="vm:DashboardViewModel">

    <Border Style="{StaticResource CardPrimary}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenDailyCheckInCommand}" />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="16">
            <Grid ColumnDefinitions="*, Auto">
                <Label
                    Text="Readiness and recovery"
                    Style="{StaticResource SectionTitle}" />
                <Label
                    Grid.Column="1"
                    Text="Tap to check in"
                    Style="{StaticResource CaptionLabel}"
                    FontAttributes="Italic"
                    VerticalOptions="Center"
                    IsVisible="{Binding NeedsDailyCheckIn}" />
            </Grid>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                <VerticalStackLayout
                    Grid.Column="0"
                    HorizontalOptions="Center"
                    Spacing="10"
                    SemanticProperties.Description="{Binding ReadinessScore, StringFormat='Readiness score: {0}'}">
                    <Grid
                        WidthRequest="88"
                        HeightRequest="88"
                        HorizontalOptions="Center">
                        <Border
                            StrokeShape="Ellipse"
                            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                            StrokeThickness="7"
                            BackgroundColor="Transparent"
                            WidthRequest="88"
                            HeightRequest="88" />
                        <Border
                            StrokeShape="Ellipse"
                            Stroke="{Binding ReadinessScore, Converter={StaticResource ScoreToColorConverter}}"
                            StrokeThickness="7"
                            BackgroundColor="Transparent"
                            WidthRequest="88"
                            HeightRequest="88" />
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <Label
                                Text="{Binding ReadinessScore}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="{Binding ReadinessScore, Converter={StaticResource ScoreToColorConverter}}"
                                HorizontalOptions="Center" />
                            <Label
                                Text="Ready"
                                FontSize="10"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label
                        Text="Readiness"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        HorizontalOptions="Center" />
                    <Label
                        Text="{Binding ReadinessLabel}"
                        Style="{StaticResource CaptionLabel}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Margin="0,-8,0,0" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    Spacing="10"
                    SemanticProperties.Description="{Binding RecoveryScore, StringFormat='Recovery score: {0}'}">
                    <Grid
                        WidthRequest="88"
                        HeightRequest="88"
                        HorizontalOptions="Center">
                        <Border
                            StrokeShape="Ellipse"
                            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                            StrokeThickness="7"
                            BackgroundColor="Transparent"
                            WidthRequest="88"
                            HeightRequest="88" />
                        <Border
                            StrokeShape="Ellipse"
                            Stroke="{Binding RecoveryScore, Converter={StaticResource ScoreToColorConverter}}"
                            StrokeThickness="7"
                            BackgroundColor="Transparent"
                            WidthRequest="88"
                            HeightRequest="88" />
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <Label
                                Text="{Binding RecoveryScore}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="{Binding RecoveryScore, Converter={StaticResource ScoreToColorConverter}}"
                                HorizontalOptions="Center" />
                            <Label
                                Text="Recovery"
                                FontSize="10"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label
                        Text="Recovery"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        HorizontalOptions="Center" />
                    <Label
                        Text="{Binding RecoveryLabel}"
                        Style="{StaticResource CaptionLabel}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Margin="0,-8,0,0" />
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
