<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>MuscleCuties.App</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>

        <MauiVersion>10.0.20</MauiVersion>

        <ApplicationTitle>MuscleCuties</ApplicationTitle>
        <ApplicationId>com.musclecuties.app</ApplicationId>
        <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
        <EnableAppleSignInEntitlements>false</EnableAppleSignInEntitlements>
        <EnableAppleHealthEntitlements>false</EnableAppleHealthEntitlements>
        <!-- MauiXamlInflator SourceGen disabled: causes SIGSEGV in CA::Layer::layout_is_active
             during Shell structural navigation (ShellContent → TabBar) on iOS. Re-enable when
             dotnet/maui resolves SourceGen compatibility with Shell TabBar transitions. -->
        <!--<MauiXamlInflator>SourceGen</MauiXamlInflator>-->

        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
        <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(CodesignProvision)' != '' and '$(EnableAppleSignInEntitlements)' == 'true'">
        <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(CodesignProvision)' != '' and '$(EnableAppleSignInEntitlements)' != 'true' and '$(EnableAppleHealthEntitlements)' == 'true'">
        <CodesignEntitlements>Platforms/iOS/HealthEntitlements.plist</CodesignEntitlements>
    </PropertyGroup>

    <!-- Windows Release: R2R eliminates JIT startup cost for the managed host. Partial trimming
         removes dead code without breaking EF Core reflection. Verify in Release on the target
         Windows version before shipping. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>

    <!-- Android Release: R2R pre-jits managed code at publish time, reducing JIT warm-up on
         the first run. Partial trimming retains EF Core reflection roots. The linker removes
         debug scaffolding and unused SDK code; full link-mode is unsafe with EF Core + SQLite.
         Verify on a physical Android device in Release before shipping. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>

    <!-- macOS Catalyst Release: AOT speeds cold launch; partial trimming avoids EF Core
         reflection breakage. Verify on a physical Mac in Release before shipping. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <RunAOTCompilation>true</RunAOTCompilation>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
    </PropertyGroup>

    <!-- iOS Release: AOT compile assemblies, with an interpreter available for dynamic
         reflection stubs created by framework code. Keep partial trimming for EF Core. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <RunAOTCompilation>true</RunAOTCompilation>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <MtouchInterpreter>-all</MtouchInterpreter>
        <AotCompileMaxDegreeOfParallelism>2</AotCompileMaxDegreeOfParallelism>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <BuildIpa>false</BuildIpa>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and ('$(RuntimeIdentifier)' == 'iossimulator-arm64' or '$(RuntimeIdentifier)' == 'iossimulator-x64')">
        <CodesignKey>-</CodesignKey>
        <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon
            Include="Resources\AppIcon\appicon.png"
            Color="#FFF8FB"
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'"/>
        <MauiSplashScreen
            Include="Resources\Splash\splash.png"
            Color="#FFF8FB"
            BaseSize="320,180"
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'maccatalyst'"/>
        <MauiImage Include="Resources\Images\*"/>
        <MauiImage Update="Resources\Images\musclecuties_logo_light.png" Resize="True" BaseSize="360,200"/>
        <MauiImage Update="Resources\Images\musclecuties_logo_dark.png" Resize="True" BaseSize="360,200"/>
        <MauiImage Update="Resources\Images\musclecuties_logo_light_transparent.png" Resize="True" BaseSize="360,200"/>
        <MauiImage Update="Resources\Images\musclecuties_logo_dark_transparent.png" Resize="True" BaseSize="360,200"/>
        <MauiImage Update="Resources\Images\icon_fire.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\icon_fire_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\icon_muscle.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\icon_muscle_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\phase_menstrual.svg" Resize="True" BaseSize="96,96"/>
        <MauiImage Update="Resources\Images\phase_follicular.svg" Resize="True" BaseSize="96,96"/>
        <MauiImage Update="Resources\Images\phase_ovulatory.svg" Resize="True" BaseSize="96,96"/>
        <MauiImage Update="Resources\Images\phase_luteal.svg" Resize="True" BaseSize="96,96"/>
        <MauiImage Update="Resources\Images\tab_today.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_today_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_cycle.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_cycle_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_train.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_train_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_nutrition.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_nutrition_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_you.svg" Resize="True" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\tab_you_dark.svg" Resize="True" BaseSize="24,24"/>
        <MauiFont Include="Resources\Fonts\*.ttf"/>
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <ImageAsset Include="Assets.xcassets\**\*.*"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AathifMahir.Maui.MauiIcons.Fluent" Version="6.0.0"/>
        <PackageReference Include="CommunityToolkit.Maui" Version="13.0.0"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0"/>
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MuscleCuties.Core\MuscleCuties.Core.csproj"/>
    </ItemGroup>

</Project>
