<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Cycle.CyclePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cycleControls="clr-namespace:MuscleCuties.App.Controls.Cycle"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Cycle;assembly=MuscleCuties.Core"
    x:DataType="vm:CycleViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <Grid
                Padding="20,40,20,32"
                RowDefinitions="Auto, Auto, Auto"
                RowSpacing="16"
                HorizontalOptions="Fill"
                MaximumWidthRequest="640">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <Grid RowDefinitions="Auto, Auto" RowSpacing="4" VerticalOptions="Center">
                        <Label
                            Text="{Binding CurrentMonthLabel}"
                            Style="{StaticResource SubHeadline}" />
                        <Label Grid.Row="1" Text="Your cycle" Style="{StaticResource MutedLabel}" />
                    </Grid>

                    <Border
                        Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Cycle settings">
                        <Path
                            Data="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                            Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            StrokeThickness="1.5"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Aspect="Uniform"
                            WidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <cycleControls:CycleCalendarCard Grid.Row="1" />
                <toolkit:LazyView
                    x:Name="PhaseGuideLazy"
                    Grid.Row="2"
                    x:TypeArguments="cycleControls:CyclePhaseGuideList" />
            </Grid>
        </ScrollView>

        <toolkit:LazyView
            x:TypeArguments="cycleControls:CycleDatePhaseModal"
            IsVisible="{Binding IsDatePhaseModalVisible}" />
        <toolkit:LazyView
            x:TypeArguments="cycleControls:CycleWarningPopup"
            IsVisible="{Binding IsCycleWarningPopupVisible}" />
        <sharedControls:PageLoadingOverlay />
    </Grid>
</ContentPage>
