<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MuscleCuties.App.Pages.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboardControls="clr-namespace:MuscleCuties.App.Controls.Dashboard"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Dashboard;assembly=MuscleCuties.Core"
    xmlns:workoutControls="clr-namespace:MuscleCuties.App.Controls.Workout"
    x:DataType="vm:DashboardViewModel"
    Shell.NavBarIsVisible="False">

    <RefreshView
        Command="{Binding RefreshCommand}"
        IsRefreshing="{Binding IsRefreshing}"
        RefreshColor="{StaticResource Primary}">
        <ScrollView>
            <VerticalStackLayout Padding="20,56,20,32" Spacing="14">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label
                            Text="{Binding DashboardPhaseHeaderText}"
                            Style="{StaticResource EyebrowLabel}"
                            CharacterSpacing="1.2" />
                        <Label
                            Text="{Binding Greetings}"
                            Style="{StaticResource SubHeadline}" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeThickness="0">
                        <Path
                            Data="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9 M13.7 21a2 2 0 0 1-3.4 0"
                            Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            StrokeThickness="1.75"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Aspect="Uniform"
                            WidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                    <Border
                        Grid.Column="0"
                        Style="{StaticResource WorkoutPill}"
                        Padding="10,8">
                        <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Image
                                Source="icon_muscle.png"
                                Aspect="AspectFit"
                                WidthRequest="22"
                                HeightRequest="22"
                                VerticalOptions="Center" />
                            <Label
                                Text="{Binding WorkoutStreakText}"
                                Style="{StaticResource WorkoutPillText}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource WorkoutPill}"
                        Padding="10,8">
                        <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                            <sharedControls:FitnessIconView
                                Icon="Fire"
                                IconColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource SecondaryDarkText}}"
                                WidthRequest="22"
                                HeightRequest="22"
                                VerticalOptions="Center" />
                            <Label
                                Text="{Binding NutritionStreakText}"
                                Style="{StaticResource WorkoutPillText}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <dashboardControls:DashboardPhaseCard />

                <workoutControls:FeaturedWorkoutCard
                    BadgeText="{Binding WorkoutBadgeText}"
                    WorkoutTitle="{Binding WorkoutTitle}"
                    Subtitle="{Binding WorkoutSubtitle}"
                    DurationText="{Binding WorkoutDurationText}"
                    ExercisesCount="{Binding WorkoutExercisesCount}"
                    Intensity="{Binding WorkoutIntensity}"
                    ActionText="{Binding WorkoutActionText}"
                    AccentColor="{Binding WorkoutActivityBackground}"
                    AccentTextColor="{Binding WorkoutActivityTextColor}"
                    StartCommand="{Binding OpenWorkoutCommand}" />

                <dashboardControls:ReadinessRecoveryCard />
                <dashboardControls:DashboardNutritionCard />
                <dashboardControls:DashboardTargetsCard />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
