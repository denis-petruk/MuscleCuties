<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Dashboard.DashboardPage"
    x:Name="DashboardRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboardControls="clr-namespace:MuscleCuties.App.Controls.Dashboard"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:injuryControls="clr-namespace:MuscleCuties.App.Controls.Injury"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Dashboard;assembly=MuscleCuties.Core"
    x:DataType="vm:DashboardViewModel"
    Loaded="OnDashboardLoaded"
    Shell.NavBarIsVisible="False">

    <Grid>
        <RefreshView
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}"
            RefreshColor="{StaticResource Primary}">
            <ScrollView>
                <Grid
                    Padding="16,40,16,32"
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="640"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="16">

                    <!-- Row 0: Greeting header -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="2"
                          SemanticProperties.Description="{Binding Greetings}">
                        <Label
                            Text="{Binding Greetings}"
                            Style="{StaticResource SubHeadline}"
                            FontSize="24" />
                        <Label
                            Grid.Row="1"
                            Text="{Binding DashboardPhaseHeaderText}"
                            Style="{StaticResource MutedLabel}"
                            FontSize="14" />

                        <Border
                            Grid.Column="1"
                            Grid.RowSpan="2"
                            WidthRequest="48"
                            HeightRequest="48"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeThickness="0"
                            SemanticProperties.Description="Open injury log">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenInjuryModalCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Path
                                    Data="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9 M13.7 21a2 2 0 0 1-3.4 0"
                                    Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    StrokeThickness="1.75"
                                    StrokeLineCap="Round"
                                    StrokeLineJoin="Round"
                                    Aspect="Uniform"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Margin="0,7,7,0"
                                    Color="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                                    HorizontalOptions="End" VerticalOptions="Start" IsVisible="{Binding HasActiveInjuries}"
                                    InputTransparent="True" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 1: Readiness informs the workout decision -->
                    <toolkit:LazyView
                        x:Name="ReadinessLazy"
                        Grid.Row="1"
                        x:TypeArguments="dashboardControls:ReadinessRecoveryCard" />

                    <!-- Row 2: Primary action -->
                    <toolkit:LazyView
                        x:Name="WorkoutCardLazy"
                        Grid.Row="2"
                        x:TypeArguments="dashboardControls:DashboardWorkoutCard" />

                    <!-- Row 3: Nutrition -->
                    <toolkit:LazyView
                        x:Name="NutritionLazy"
                        Grid.Row="3"
                        x:TypeArguments="dashboardControls:DashboardNutritionCard" />

                    <!-- Row 4: Streaks are supporting context, not separate cards -->
                    <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="16" Padding="4,0">
                        <Label
                            Text="{Binding WorkoutStreakText}"
                            Style="{StaticResource MutedLabel}"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            SemanticProperties.Description="{Binding WorkoutStreakText, StringFormat='Workout streak: {0}'}" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding NutritionStreakText}"
                            Style="{StaticResource MutedLabel}"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            HorizontalTextAlignment="End"
                            SemanticProperties.Description="{Binding NutritionStreakText, StringFormat='Nutrition streak: {0}'}" />
                    </Grid>

                    <!-- Row 5: Cycle phase -->
                    <toolkit:LazyView
                        x:Name="PhaseCardLazy"
                        Grid.Row="5"
                        x:TypeArguments="dashboardControls:DashboardPhaseCard" />

                    <!-- Row 6: Daily targets -->
                    <toolkit:LazyView
                        x:Name="TargetsLazy"
                        Grid.Row="6"
                        x:TypeArguments="dashboardControls:DashboardTargetsCard" />

                    <!-- Row 7: Calendar -->
                    <toolkit:LazyView
                        x:Name="CalendarCardLazy"
                        Grid.Row="7"
                        x:TypeArguments="dashboardControls:DashboardCalendarCard" />
                </Grid>
            </ScrollView>
        </RefreshView>

        <sharedControls:PageLoadingOverlay />
        <toolkit:LazyView
            x:Name="InjuryModalLazy"
            x:TypeArguments="injuryControls:InjuryLogModal"
            InputTransparent="{Binding IsInjuryModalVisible, Converter={StaticResource InvertedBoolConverter}}" />
    </Grid>
</ContentPage>
