<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Dashboard.DailyCheckInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Dashboard;assembly=MuscleCuties.Core"
    x:DataType="vm:DailyCheckInViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="CheckInChoice" TargetType="Button">
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}" />
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
            <Setter Property="BorderColor"
                    Value="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*, Auto">

        <!-- Check-in -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="20,40,20,24"
                Spacing="16"
                HorizontalOptions="Fill"
                MaximumWidthRequest="640">

                <!-- Header -->
                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="Daily check-in"
                        Style="{StaticResource SubHeadline}"
                        FontSize="24" />
                    <Label
                        Text="How are you feeling today?"
                        Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
                </VerticalStackLayout>

                <!-- Sleep -->
                <Border Style="{StaticResource CardPrimary}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label
                                Grid.Column="0"
                                Text="Sleep last night"
                                Style="{StaticResource CardTitle}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding SleepDisplay}"
                                Style="{StaticResource AccentLabel}"
                                FontSize="18"
                                VerticalOptions="Center" />
                        </Grid>
                        <Slider
                            Minimum="0"
                            Maximum="14"
                            Value="{Binding SleepHours}"
                            MinimumTrackColor="{StaticResource Primary}"
                            MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                            ThumbColor="{StaticResource Primary}"
                            SemanticProperties.Description="{Binding SleepDisplay, StringFormat='Sleep last night: {0}'}"
                            SemanticProperties.Hint="Drag to set hours of sleep, 0 to 14" />
                        <Grid ColumnDefinitions="*, *">
                            <Label
                                Grid.Column="0"
                                Text="0h"
                                Style="{StaticResource CaptionLabel}"
                                HorizontalOptions="Start" />
                            <Label
                                Grid.Column="1"
                                Text="14h"
                                Style="{StaticResource CaptionLabel}"
                                HorizontalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Energy -->
                <Border Style="{StaticResource CardPrimary}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Energy" Style="{StaticResource CardTitle}" />
                            <Label Grid.Column="1" Text="{Binding EnergyDisplay}"
                                   Style="{StaticResource AccentLabel}" FontSize="18" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                            <Button x:Name="EnergyChip1" Style="{StaticResource CheckInChoice}" Grid.Column="0" Text="1"
                                    CommandParameter="1" Clicked="OnEnergyClicked"
                                    MinimumHeightRequest="48" Padding="0" FontSize="16" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="Energy 1 of 5"
                                    SemanticProperties.Hint="Very low energy" />
                            <Button x:Name="EnergyChip2" Style="{StaticResource CheckInChoice}" Grid.Column="1" Text="2"
                                    CommandParameter="2" Clicked="OnEnergyClicked"
                                    MinimumHeightRequest="48" Padding="0" FontSize="16" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="Energy 2 of 5"
                                    SemanticProperties.Hint="Low energy" />
                            <Button x:Name="EnergyChip3" Style="{StaticResource CheckInChoice}" Grid.Column="2" Text="3"
                                    CommandParameter="3" Clicked="OnEnergyClicked"
                                    MinimumHeightRequest="48" Padding="0" FontSize="16" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="Energy 3 of 5"
                                    SemanticProperties.Hint="Moderate energy" />
                            <Button x:Name="EnergyChip4" Style="{StaticResource CheckInChoice}" Grid.Column="3" Text="4"
                                    CommandParameter="4" Clicked="OnEnergyClicked"
                                    MinimumHeightRequest="48" Padding="0" FontSize="16" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="Energy 4 of 5"
                                    SemanticProperties.Hint="High energy" />
                            <Button x:Name="EnergyChip5" Style="{StaticResource CheckInChoice}" Grid.Column="4" Text="5"
                                    CommandParameter="5" Clicked="OnEnergyClicked"
                                    MinimumHeightRequest="48" Padding="0" FontSize="16" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="Energy 5 of 5"
                                    SemanticProperties.Hint="Very high energy" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*">
                            <Label Text="Very low" Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1" Text="Very high" Style="{StaticResource CaptionLabel}"
                                   HorizontalTextAlignment="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Pain -->
                <Border Style="{StaticResource CardPrimary}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Pain" Style="{StaticResource CardTitle}" />
                            <Label Grid.Column="1" Text="{Binding PainDisplay}"
                                   Style="{StaticResource AccentLabel}" FontSize="18" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <Button x:Name="PainChip0" Style="{StaticResource CheckInChoice}" Grid.Row="0" Grid.Column="0" Text="None"
                                    CommandParameter="0" Clicked="OnPainClicked"
                                    MinimumHeightRequest="48" Padding="4,0" FontSize="14" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="Pain: None"
                                    SemanticProperties.Hint="No pain reported" />
                            <Button x:Name="PainChip1" Style="{StaticResource CheckInChoice}" Grid.Row="0" Grid.Column="1" Text="Mild"
                                    CommandParameter="1" Clicked="OnPainClicked"
                                    MinimumHeightRequest="48" Padding="4,0" FontSize="14" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="Pain: Mild"
                                    SemanticProperties.Hint="Mild discomfort" />
                            <Button x:Name="PainChip2" Style="{StaticResource CheckInChoice}" Grid.Row="1" Grid.Column="0" Text="Moderate"
                                    CommandParameter="2" Clicked="OnPainClicked"
                                    MinimumHeightRequest="48" Padding="4,0" FontSize="14" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="Pain: Moderate"
                                    SemanticProperties.Hint="Moderate pain, may affect workout" />
                            <Button x:Name="PainChip3" Style="{StaticResource CheckInChoice}" Grid.Row="1" Grid.Column="1" Text="Severe"
                                    CommandParameter="3" Clicked="OnPainClicked"
                                    MinimumHeightRequest="48" Padding="4,0" FontSize="14" FontAttributes="Bold"
                                    CornerRadius="12" BorderWidth="1"
                                    SemanticProperties.Description="Pain: Severe"
                                    SemanticProperties.Hint="Severe pain, rest recommended" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Bloating -->
                <Border Style="{StaticResource CardPrimary}">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label
                            Grid.Column="0"
                            Text="Bloating"
                            Style="{StaticResource CardTitle}"
                            VerticalOptions="Center" />
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding HasBloating}"
                            OnColor="{StaticResource Primary}"
                            ThumbColor="{StaticResource White}"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Bloating today"
                            SemanticProperties.Hint="Toggle on if you are experiencing bloating" />
                    </Grid>
                </Border>

                <!-- Body weight -->
                <Border Style="{StaticResource CardPrimary}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <Label Text="Body weight (optional)" Style="{StaticResource CardTitle}" />
                            <Label Grid.Column="1" Text="&#x1F512; Private"
                                   Style="{StaticResource CaptionLabel}"
                                   VerticalOptions="Center"
                                   SemanticProperties.Description="This data stays private on your device" />
                        </Grid>
                        <Label Text="Stored only on this device -- never shared"
                               Style="{StaticResource CaptionLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry
                                x:Name="WeightEntry"
                                Placeholder="kg"
                                Text="{Binding BodyWeight}"
                                Keyboard="Numeric"
                                ReturnType="Done"
                                ReturnCommand="{Binding SubmitCommand}"
                                SemanticProperties.Description="Optional body weight in kilograms"
                                SemanticProperties.Hint="Leave empty to skip weight entry" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Result -->
                <Border
                    Style="{StaticResource CardPrimary}"
                    IsVisible="{Binding IsCompleted}">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label
                            Text="Readiness"
                            Style="{StaticResource SectionTitle}"
                            HorizontalOptions="Center" />
                        <Label
                            Text="{Binding ReadinessScoreText}"
                            FontFamily="Inter"
                            FontSize="52"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="{Binding ReadinessTierText}"
                            Style="{StaticResource SectionTitle}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="{Binding SessionSummaryText}"
                            Style="{StaticResource MutedLabel}"
                            IsVisible="{Binding HasSessionSummary}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Actions -->
        <Grid
            Grid.Row="1"
            RowDefinitions="Auto,Auto,Auto"
            Padding="20,12,20,36"
            IsVisible="{Binding IsCompleted, Converter={StaticResource InvertedBoolConverter}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
            <BoxView HeightRequest="1" Margin="0,0,0,12" />
            <VerticalStackLayout Grid.Row="1" Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   SemanticProperties.Description="Saving your check-in" />
                <Button Text="Submit" Command="{Binding SubmitCommand}"
                        SemanticProperties.Hint="Submit your daily check-in" />
            </VerticalStackLayout>
            <Button
                Grid.Row="2"
                Text="Skip for now"
                Style="{StaticResource ButtonLink}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                Command="{Binding SkipCommand}"
                SemanticProperties.Hint="Skip today's check-in" />
        </Grid>

    </Grid>

</ContentPage>
