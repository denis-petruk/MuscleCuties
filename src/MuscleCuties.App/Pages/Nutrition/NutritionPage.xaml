<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Nutrition.NutritionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nutritionControls="clr-namespace:MuscleCuties.App.Controls.Nutrition"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Nutrition;assembly=MuscleCuties.Core"
    x:DataType="vm:NutritionViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout
                Padding="20,56,20,32"
                Spacing="14"
                HorizontalOptions="Fill"
                MaximumWidthRequest="640">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label
                            Text="{Binding CurrentPhaseName, StringFormat='{0} phase'}"
                            Style="{StaticResource EyebrowLabel}"
                            CharacterSpacing="1.2" />
                        <Label
                            Text="Nutrition"
                            Style="{StaticResource SubHeadline}" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Add meal">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleAddFoodPanelCommand}" />
                        </Border.GestureRecognizers>
                        <Path
                            Data="M12 5v14M5 12h14"
                            Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            StrokeThickness="2.2"
                            StrokeLineCap="Round"
                            Aspect="Uniform"
                            WidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <nutritionControls:NutritionPhaseFocusCard />
                <nutritionControls:NutritionBalanceCard />

                <Button
                    Text="Log a meal"
                    Command="{Binding ToggleAddFoodPanelCommand}"
                    IsVisible="{Binding IsAddFoodPanelVisible, Converter={StaticResource InvertedBoolConverter}}"
                    CornerRadius="16"
                    HeightRequest="48"
                    FontAttributes="Bold"
                    Margin="0,4" />

                <nutritionControls:AddMealPanel />
                <nutritionControls:MealsList />
            </VerticalStackLayout>
        </ScrollView>

        <nutritionControls:FoodSearchModal />
        <nutritionControls:NutritionBreakdownModal />
        <nutritionControls:MealSuggestionModal />
        <sharedControls:PhaseSaluteOverlay
            x:Name="SaluteOverlay"
            IconSource="{Binding CelebrationIconSource}" />
        <sharedControls:PageLoadingOverlay />
    </Grid>
</ContentPage>
