<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Nutrition.NutritionPage"
    x:Name="NutritionRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nutritionControls="clr-namespace:MuscleCuties.App.Controls.Nutrition"
    xmlns:nutritionModels="clr-namespace:MuscleCuties.Core.Models.UI.Nutrition;assembly=MuscleCuties.Core"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Nutrition;assembly=MuscleCuties.Core"
    x:DataType="vm:NutritionViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <CollectionView
            ItemsSource="{Binding Meals}"
            MaximumWidthRequest="680"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Padding="20,40,20,16" Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                        <Label Text="Nutrition" Style="{StaticResource SubHeadline}" VerticalOptions="Center" />
                        <Label
                            Grid.Row="1"
                            Text="{Binding CurrentPhaseName, StringFormat='{0} phase'}"
                            Style="{StaticResource MutedLabel}" />

                        <Border
                            Grid.Column="1"
                            Grid.RowSpan="2"
                            WidthRequest="44"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Add meal">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleAddFoodPanelCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M12 5v14M5 12h14"
                                Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                StrokeThickness="2.2"
                                StrokeLineCap="Round"
                                Aspect="Uniform"
                                WidthRequest="18"
                                HeightRequest="18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <toolkit:LazyView
                        x:Name="PhaseFocusLazy"
                        x:TypeArguments="nutritionControls:NutritionPhaseFocusCard" />
                    <toolkit:LazyView
                        x:Name="BalanceCardLazy"
                        x:TypeArguments="nutritionControls:NutritionBalanceCard" />

                    <Button
                        Text="Log a meal"
                        Command="{Binding ToggleAddFoodPanelCommand}"
                        IsVisible="{Binding IsAddFoodPanelVisible, Converter={StaticResource InvertedBoolConverter}}"
                        MinimumHeightRequest="52"
                        FontAttributes="Bold"
                        Margin="0,4" />

                    <Border
                        Padding="12,8"
                        MinimumHeightRequest="44"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        SemanticProperties.Description="Suggest a meal">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSuggestMealCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path
                                Data="M9 18h6M10 22h4M8.5 14.5A6 6 0 1 1 15.5 14.5C14.5 15.3 14 16 14 18h-4c0-2-.5-2.7-1.5-3.5Z"
                                Style="{StaticResource NutritionLineIcon}"
                                Stroke="{StaticResource Primary}"
                                WidthRequest="20"
                                HeightRequest="20" />
                            <Label
                                Text="Suggest a meal"
                                Style="{StaticResource AccentLabel}"
                                FontSize="14"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <toolkit:LazyView
                        x:Name="MealEditor"
                        x:TypeArguments="nutritionControls:AddMealPanel"
                        IsVisible="{Binding IsAddFoodPanelVisible}" />

                    <sharedControls:IconSectionHeader
                        Text="Meals"
                        IconGlyph="BowlChopsticks24"
                        Margin="4,6,4,0" />

                    <Border
                        Style="{StaticResource CardPrimary}"
                        Padding="16"
                        IsVisible="{Binding HasNoMeals}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border
                                WidthRequest="42"
                                HeightRequest="42"
                                StrokeShape="RoundRectangle 21"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Path
                                    Data="M3 2v7c0 1.1.9 2 2 2h2c1.1 0 2-.9 2-2V2M6 2v20M15 2v8h4M19 2v20"
                                    Style="{StaticResource NutritionLineIcon}"
                                    WidthRequest="20"
                                    HeightRequest="20" />
                            </Border>
                            <Label
                                Grid.Column="1"
                                Text="Log your first meal"
                                Style="{StaticResource CardTitle}"
                                FontSize="15"
                                VerticalOptions="Center" />
                            <Button
                                Grid.Column="2"
                                Text="Log Meal"
                                Command="{Binding OpenAddFoodPanelCommand}"
                                WidthRequest="124"
                                MinimumHeightRequest="48"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="nutritionModels:MealItem">
                    <Border
                        Style="{StaticResource CardPrimary}"
                        Margin="20,0"
                        Padding="12,14"
                        SemanticProperties.Description="{Binding Name, StringFormat='Meal: {0}. Tap to view breakdown.'}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.OpenMealBreakdownCommand, Source={x:Reference NutritionRoot}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border
                                WidthRequest="52"
                                HeightRequest="44"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource AccentSurfaceDark}}"
                                StrokeThickness="0">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Path
                                        Data="{Binding MealTypeIconData, Converter={StaticResource StringToGeometryConverter}}"
                                        Stroke="{StaticResource Primary}"
                                        StrokeThickness="1.5"
                                        StrokeLineCap="Round"
                                        StrokeLineJoin="Round"
                                        Aspect="Uniform"
                                        WidthRequest="16"
                                        HeightRequest="16"
                                        HorizontalOptions="Center" />
                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding Time}"
                                        TextColor="{StaticResource Primary}"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center" />
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="2" VerticalOptions="Center">
                                <Label
                                    Text="{Binding MealType}"
                                    TextColor="{StaticResource Primary}"
                                    FontSize="10"
                                    FontAttributes="Bold" />
                                <Label
                                    Grid.Row="1"
                                    Text="{Binding Name}"
                                    Style="{StaticResource CardTitle}"
                                    FontSize="15"
                                    MaxLines="1"
                                    LineBreakMode="TailTruncation" />
                                <Label
                                    Grid.Row="2"
                                    Text="{Binding MacrosSummaryText}"
                                    Style="{StaticResource CaptionLabel}"
                                    MaxLines="1"
                                    LineBreakMode="TailTruncation" />
                            </Grid>

                            <Grid
                                Grid.Column="2"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="2"
                                VerticalOptions="Center"
                                HorizontalOptions="End">
                                <HorizontalStackLayout Spacing="4" HorizontalOptions="End">
                                    <Image
                                        Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                                        Aspect="AspectFit"
                                        WidthRequest="13"
                                        HeightRequest="13"
                                        VerticalOptions="Center" />
                                    <Label
                                        Text="{Binding CaloriesText}"
                                        Style="{StaticResource CaptionLabel}"
                                        HorizontalTextAlignment="End"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Image
                                    Grid.Row="1"
                                    Source="{Binding Source='ChevronRight24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                    WidthRequest="16"
                                    HeightRequest="16"
                                    Aspect="AspectFit"
                                    HorizontalOptions="End" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Grid HeightRequest="32" />
            </CollectionView.Footer>
        </CollectionView>

        <toolkit:LazyView
            x:Name="FoodSearch"
            x:TypeArguments="nutritionControls:FoodSearchModal"
            InputTransparent="{Binding IsFoodSearchModalVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView
            x:Name="Breakdown"
            x:TypeArguments="nutritionControls:NutritionBreakdownModal"
            InputTransparent="{Binding IsBreakdownModalVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView
            x:Name="Suggestions"
            x:TypeArguments="nutritionControls:MealSuggestionModal"
            InputTransparent="{Binding IsSuggestionModalVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView
            x:Name="MealDetail"
            x:TypeArguments="nutritionControls:MealDetailModal"
            InputTransparent="{Binding IsMealDetailVisible, Converter={StaticResource InvertedBoolConverter}}" />
        <toolkit:LazyView
            x:Name="SaluteOverlay"
            x:TypeArguments="sharedControls:PhaseSaluteOverlay"
            InputTransparent="True" />
        <sharedControls:PageLoadingOverlay />
    </Grid>
</ContentPage>
