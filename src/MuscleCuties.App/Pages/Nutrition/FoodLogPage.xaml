<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Nutrition.FoodLogPage"
    x:Name="FoodLogRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtos="clr-namespace:MuscleCuties.Core.Models.Nutrition;assembly=MuscleCuties.Core"
    xmlns:nutritionControls="clr-namespace:MuscleCuties.App.Controls.Nutrition"
    xmlns:uiModels="clr-namespace:MuscleCuties.Core.Models.UI.Nutrition;assembly=MuscleCuties.Core"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Nutrition;assembly=MuscleCuties.Core"
    x:DataType="vm:FoodLogViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">

        <!-- Top Navigation Bar -->
        <Grid
            Grid.Row="0"
            Padding="16,44,16,12"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="10"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

            <Border
                Style="{StaticResource CircleIconButton}"
                SemanticProperties.Description="Back">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                </Border.GestureRecognizers>
                <Path
                    Data="M15 19l-7-7 7-7"
                    Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    StrokeThickness="2"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Aspect="Uniform"
                    WidthRequest="14"
                    HeightRequest="14"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Label
                Grid.Column="1"
                Text="Daily Food Log"
                Style="{StaticResource SubHeadline}"
                FontSize="20"
                VerticalOptions="Center" />

            <Button
                Grid.Column="2"
                Text="Today"
                Command="{Binding JumpToTodayCommand}"
                HeightRequest="36"
                Padding="12,0"
                CornerRadius="18"
                FontSize="13"
                FontAttributes="Bold"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}"
                BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                BorderWidth="1"
                VerticalOptions="Center"
                IsVisible="{Binding IsSelectedDateToday, Converter={StaticResource InvertedBoolConverter}}" />

            <Border
                Grid.Column="3"
                Style="{StaticResource CircleIconButton}"
                SemanticProperties.Description="Open date picker">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleDatePickerCommand}" />
                </Border.GestureRecognizers>
                <Path
                    Data="M19 4H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V6a2 2 0 00-2-2zM16 2v4M8 2v4M3 10h18"
                    Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Aspect="Uniform"
                    WidthRequest="16"
                    HeightRequest="16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Main Virtualized Scroll Container (CollectionView, zero nested ScrollViews) -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding MealSections}"
            ItemSizingStrategy="MeasureFirstItem"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Spacing="16" Padding="16,8,16,14">

                    <Button Text="Retry loading this day" Command="{Binding RetryLoadCommand}"
                            IsVisible="{Binding IsLoadError}" MinimumHeightRequest="44" />
                    <!-- Horizontal Rolling Date Strip Header -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="8" RowSpacing="8" VerticalOptions="Center">
                        <Border
                            Style="{StaticResource CircleIconButton}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PreviousDayCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M15 19l-7-7 7-7"
                                Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                StrokeThickness="2"
                                Aspect="Uniform"
                                WidthRequest="12"
                                HeightRequest="12"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label Grid.Column="1" Text="{Binding FormattedSelectedDate}"
                               FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />

                        <CollectionView
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            ItemsSource="{Binding DateStripDays}"
                            ItemSizingStrategy="MeasureFirstItem"
                            HeightRequest="68"
                            SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="uiModels:DateStripDayItem">
                                    <Border
                                        WidthRequest="52"
                                        HeightRequest="64"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="1"
                                        Stroke="{Binding IsSelected, Converter={StaticResource BoolToSelectionStrokeConverter}, FallbackValue=Transparent}"
                                        BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToSelectionBgConverter}, FallbackValue=Transparent}"
                                        Padding="4,6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectDateCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2" VerticalOptions="Center" HorizontalOptions="Center">
                                            <Label
                                                Grid.Row="0"
                                                Text="{Binding DayName}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            <Label
                                                Grid.Row="1"
                                                Text="{Binding DayNumber}"
                                                FontSize="17"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <BoxView
                                                Grid.Row="2"
                                                WidthRequest="4"
                                                HeightRequest="4"
                                                CornerRadius="2"
                                                HorizontalOptions="Center"
                                                Color="{StaticResource Primary}"
                                                IsVisible="{Binding IsToday}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Border
                            Grid.Column="2"
                            Style="{StaticResource CircleIconButton}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NextDayCommand}" />
                            </Border.GestureRecognizers>
                            <Path
                                Data="M9 5l7 7-7 7"
                                Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                StrokeThickness="2"
                                Aspect="Uniform"
                                WidthRequest="12"
                                HeightRequest="12"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Native Date Picker Trigger (Hidden unless toggled) -->
                    <Border
                        IsVisible="{Binding IsDatePickerOpen}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                        StrokeThickness="1"
                        Padding="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <DatePicker
                                Date="{Binding PickerDate}"
                                Format="yyyy-MM-dd"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <Button
                                Grid.Column="1"
                                Text="Go"
                                Command="{Binding DatePickerSelectedCommand}"
                                CommandParameter="{Binding PickerDate}"
                                HeightRequest="36"
                                Padding="14,0"
                                CornerRadius="8"
                                FontSize="13"
                                FontAttributes="Bold" />
                        </Grid>
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource Primary}" HeightRequest="24" />

                    <!-- Selected Day Headline & Macro Vectors Card -->
                    <Border
                        StrokeShape="RoundRectangle 18"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                        StrokeThickness="1"
                        Padding="18,16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                                    <Label
                                        Grid.Row="0"
                                        Text="{Binding FormattedSelectedDate}"
                                        Style="{StaticResource SubHeadline}"
                                        FontSize="18" />
                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding CalorieRemainingText}"
                                        Style="{StaticResource MutedLabel}"
                                        FontSize="13" />
                                </Grid>

                                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label
                                        Text="{Binding TotalCalories, StringFormat='{0:F0}'}"
                                        FontSize="24"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        Text="{Binding TargetCalories, StringFormat='/ {0:F0} kcal'}"
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        VerticalOptions="End"
                                        Margin="0,0,0,3" />
                                </HorizontalStackLayout>
                            </Grid>

                            <!-- Pure Vector Calorie Bar -->
                            <Grid Grid.Row="1" HeightRequest="8">
                                <Border
                                    StrokeShape="RoundRectangle 4"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                    HorizontalOptions="Fill" />
                                <ProgressBar
                                    Progress="{Binding CalorieProgressRatio}"
                                    ProgressColor="{StaticResource Primary}"
                                    HorizontalOptions="Fill" />
                            </Grid>

                            <!-- Macronutrient Split Bars -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="14" Margin="0,4,0,0">
                                <!-- Protein -->
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Protein" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding TotalProtein, StringFormat='{0:F0}g'}" FontSize="12"
                                           FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Progress="{Binding ProteinProgressRatio}" ProgressColor="{StaticResource PrimaryDark}" HeightRequest="4" />
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding TargetProtein, StringFormat='Target: {0:F0}g'}" FontSize="10"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>

                                <!-- Carbs -->
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Carbs" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding TotalCarbs, StringFormat='{0:F0}g'}" FontSize="12"
                                           FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource WarningAccentLight}, Dark={StaticResource WarningAccentDark}}" />
                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Progress="{Binding CarbsProgressRatio}"
                                                 ProgressColor="{AppThemeBinding Light={StaticResource WarningAccentLight}, Dark={StaticResource WarningAccentDark}}"
                                                 HeightRequest="4" />
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding TargetCarbs, StringFormat='Target: {0:F0}g'}" FontSize="10"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>

                                <!-- Fat -->
                                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Fat" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding TotalFat, StringFormat='{0:F0}g'}" FontSize="12"
                                           FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Progress="{Binding FatProgressRatio}"
                                                 ProgressColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}"
                                                 HeightRequest="4" />
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding TargetFat, StringFormat='Target: {0:F0}g'}" FontSize="10"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>
                            </Grid>

                            <!-- Water Tracker Row -->
                            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0" VerticalOptions="Center">
                                <Label Text="💧 Water" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding WaterIntakeMl, StringFormat='{0:N0} ml'}" FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="2" Text="-250ml" Command="{Binding RemoveWaterCommand}"
                                        CommandParameter="{x:Int32 250}" HeightRequest="30" Padding="8,0" FontSize="11"
                                        CornerRadius="6"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Button Grid.Column="3" Text="+250ml" Command="{Binding AddWaterCommand}"
                                        CommandParameter="{x:Int32 250}" HeightRequest="30" Padding="8,0" FontSize="11"
                                        CornerRadius="6"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}" />
                            </Grid>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Meal Section ItemTemplate (Breakfast, Lunch, Dinner, Snacks) -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="uiModels:MealSectionUiGroup">
                    <Border
                        Margin="16,0"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                        StrokeThickness="1"
                        Padding="14,12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <!-- Section Header Row -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                                    <Label
                                        Grid.Row="0"
                                        Text="{Binding Title}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding SummaryText}"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>

                                <Border
                                    Grid.Column="1"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    StrokeShape="RoundRectangle 22"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="Add food to meal">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding OpenAddFoodCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                            CommandParameter="{Binding MealType}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="+" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}"
                                           HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-2,0,0" />
                                 </Border>

                                <Border
                                    Grid.Column="2"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding ToggleMealSectionCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="{Binding IsExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Border>
                            </Grid>

                            <!-- Items in Meal -->
                            <VerticalStackLayout
                                Grid.Row="1"
                                IsVisible="{Binding IsExpanded}"
                                Spacing="6"
                                Margin="0,4,0,0"
                                BindableLayout.ItemsSource="{Binding Items}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:FoodItemEntryDto">
                                        <Border
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                            StrokeThickness="1"
                                            Padding="10,8"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource InputSurface}, Dark={StaticResource InputSurfaceDark}}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenEditFoodCommand, Source={RelativeSource AncestorType={x:Type vm:FoodLogViewModel}}, x:DataType=vm:FoodLogViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                                                <Label
                                                    Text="{Binding Name}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                <Label
                                                    Grid.Row="1"
                                                    Text="{Binding ServingsCount, StringFormat='{0:F1} serv'}"
                                                    FontSize="12"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding Calories, StringFormat='{0:F0} kcal'}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    HorizontalTextAlignment="End"
                                                    TextColor="{StaticResource PrimaryDark}" />
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Text="{Binding Protein, StringFormat='{0:F0}g P'}"
                                                    FontSize="11"
                                                    HorizontalTextAlignment="End"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Empty State for Section -->
                            <Label
                                Grid.Row="2"
                                IsVisible="{Binding HasItems, Converter={StaticResource InvertedBoolConverter}}"
                                Text="No foods logged yet. Tap + to add."
                                FontSize="12"
                                FontAttributes="Italic"
                                Margin="4,2"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Grid HeightRequest="40" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Inline Tap-To-Edit Modal Sheet (Optimistic UI) -->
        <Grid
            Grid.RowSpan="2"
            IsVisible="{Binding IsEditModalVisible}"
            BackgroundColor="{AppThemeBinding Light=#60000000, Dark=#80000000}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseEditModalCommand}" />
            </Grid.GestureRecognizers>

            <Border
                VerticalOptions="Center"
                HorizontalOptions="Center"
                MaximumWidthRequest="460"
                Margin="20"
                StrokeShape="RoundRectangle 20"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                StrokeThickness="1"
                Padding="20"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer /> <!-- Absorb tap inside dialog -->
                </Border.GestureRecognizers>

                <ScrollView MaximumHeightRequest="500">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="{Binding IsEditingExisting, Converter={StaticResource BoolToEditTitleConverter}}"
                            Style="{StaticResource SubHeadline}"
                            FontSize="18"
                            VerticalOptions="Center" />
                        <Button
                            Grid.Column="1"
                            Text="✕"
                            Command="{Binding CloseEditModalCommand}"
                            HeightRequest="32"
                            WidthRequest="32"
                            Padding="0"
                            CornerRadius="16"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>

                    <!-- Fast logging: local history first, then an explicit catalog lookup. -->
                    <Label Text="{Binding StatusMessage}" IsVisible="{Binding IsStatusVisible}" FontSize="14" />
                    <ActivityIndicator IsRunning="{Binding IsWriting}" IsVisible="{Binding IsWriting}" />
                    <ActivityIndicator IsRunning="{Binding IsLoadingFastLogging}" IsVisible="{Binding IsLoadingFastLogging}" />
                    <VerticalStackLayout IsVisible="{Binding IsFastLoggingVisible}" Spacing="12"
                        IsEnabled="{Binding IsWriting, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="Recent ingredients · this meal" FontSize="13" FontAttributes="Bold" />
                        <Label Text="Nothing logged in this meal over the last 14 days."
                               FontSize="12" IsVisible="{Binding HasRecentIngredients, Converter={StaticResource InvertedBoolConverter}}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentIngredients}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dtos:QuickFoodItemDto">
                                    <nutritionControls:QuickFoodItemRow />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="Recent accepted suggestions" FontSize="13" FontAttributes="Bold" />
                        <Label Text="No eligible accepted suggestions in the last 30 days. When phase is unknown, all phases are shown."
                               FontSize="12" IsVisible="{Binding HasRecentSuggestions, Converter={StaticResource InvertedBoolConverter}}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentSuggestions}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                 <DataTemplate x:DataType="dtos:QuickFoodItemDto">
                                     <nutritionControls:QuickFoodItemRow />
                                 </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="Search foods" FontSize="13" FontAttributes="Bold" />
                        <Entry Text="{Binding FoodSearchQuery}" Placeholder="Search foods on this device"
                               ReturnType="Search" FontSize="14" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Search device" Command="{Binding SearchFoodCommand}" FontSize="12"
                                    HeightRequest="44" CornerRadius="9" />
                            <Button Grid.Column="1" Text="Search USDA" Command="{Binding SearchUsdaCommand}"
                                    FontSize="12" HeightRequest="44" CornerRadius="9"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </Grid>
                        <ActivityIndicator IsRunning="{Binding IsSearchingFood}" IsVisible="{Binding IsSearchingFood}" />
                        <Label Text="{Binding FoodSearchStatus}" FontSize="11" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding FoodSearchResults}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dtos:QuickFoodItemDto">
                                    <nutritionControls:QuickFoodItemRow />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button Text="Add food manually" Command="{Binding UseManualFoodCommand}"
                                HeightRequest="40" CornerRadius="9"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource White}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsManualEditorVisible}" Spacing="12"
                        IsEnabled="{Binding IsWriting, Converter={StaticResource InvertedBoolConverter}}">

                    <Label Text="Category" FontSize="14" />
                    <Picker ItemsSource="{Binding MealCategories}" SelectedItem="{Binding EditingMealType}" />
                    <VerticalStackLayout IsVisible="{Binding IsGroupedEditor}" Spacing="8">
                        <Label Text="Ingredients · grams" FontSize="14" FontAttributes="Bold" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding EditingIngredients}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="uiModels:HistoryIngredientEditor">
                                    <Grid ColumnDefinitions="*,100" ColumnSpacing="12">
                                        <Label Text="{Binding Name}" VerticalOptions="Center" FontSize="14" />
                                        <Entry Grid.Column="1" Text="{Binding Grams}" Keyboard="Numeric" MinimumHeightRequest="44"
                                               SemanticProperties.Description="Ingredient portion in grams" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Grid IsVisible="{Binding IsPlainFoodEditor}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="4">
                        <!-- Food Name -->
                        <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Food Name" FontSize="12" FontAttributes="Bold" />
                        <Entry
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Text="{Binding EditingItemName}"
                            Placeholder="e.g. Greek Yogurt 0%"
                            SemanticProperties.Description="Food item name"
                            FontSize="14"
                            HeightRequest="42"
                            Margin="0,0,0,8" />

                        <!-- Servings & Portion Size -->
                        <Label Grid.Row="2" Grid.Column="0" Text="Servings" FontSize="12" FontAttributes="Bold" />
                        <Label Grid.Row="2" Grid.Column="1" Text="Portion Size" FontSize="12" FontAttributes="Bold" />
                        <Entry
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="{Binding EditingServingsCount}"
                            Placeholder="1"
                            SemanticProperties.Description="Servings count"
                            Keyboard="Numeric"
                            FontSize="14"
                            HeightRequest="42"
                            Margin="0,0,0,8" />
                        <Entry
                            Grid.Row="3"
                            Grid.Column="1"
                            Text="{Binding EditingServingSize}"
                            Placeholder="100"
                            SemanticProperties.Description="Portion size"
                            Keyboard="Numeric"
                            FontSize="14"
                            HeightRequest="42"
                            Margin="0,0,0,8" />

                        <!-- Calories & Protein -->
                        <Label Grid.Row="4" Grid.Column="0" Text="Calories (kcal)" FontSize="12" FontAttributes="Bold" />
                        <Label Grid.Row="4" Grid.Column="1" Text="Protein (g)" FontSize="12" FontAttributes="Bold" />
                        <Entry
                            Grid.Row="5"
                            Grid.Column="0"
                            Text="{Binding EditingCalories}"
                            Placeholder="0"
                            SemanticProperties.Description="Calories in kilocalories"
                            Keyboard="Numeric"
                            FontSize="14"
                            HeightRequest="42"
                            Margin="0,0,0,8" />
                        <Entry
                            Grid.Row="5"
                            Grid.Column="1"
                            Text="{Binding EditingProtein}"
                            Placeholder="0"
                            SemanticProperties.Description="Protein in grams"
                            Keyboard="Numeric"
                            FontSize="14"
                            HeightRequest="42"
                            Margin="0,0,0,8" />

                        <!-- Carbs & Fat -->
                        <Label Grid.Row="6" Grid.Column="0" Text="Carbs (g)" FontSize="12" FontAttributes="Bold" />
                        <Label Grid.Row="6" Grid.Column="1" Text="Fat (g)" FontSize="12" FontAttributes="Bold" />
                        <Entry
                            Grid.Row="7"
                            Grid.Column="0"
                            Text="{Binding EditingCarbs}"
                            Placeholder="0"
                            SemanticProperties.Description="Carbohydrates in grams"
                            Keyboard="Numeric"
                            FontSize="14"
                            HeightRequest="42" />
                        <Entry
                            Grid.Row="7"
                            Grid.Column="1"
                            Text="{Binding EditingFat}"
                            Placeholder="0"
                            SemanticProperties.Description="Fat in grams"
                            Keyboard="Numeric"
                            FontSize="14"
                            HeightRequest="42" />
                    </Grid>
                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button
                            Text="Save"
                            Command="{Binding SaveFoodItemCommand}"
                            HeightRequest="44"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}" />

                        <Button
                            Grid.Column="1"
                            Text="Delete"
                            Command="{Binding DeleteFoodItemCommand}"
                            HeightRequest="44"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                            TextColor="{StaticResource White}"
                            IsVisible="{Binding IsEditingExisting}" />

                        <Button
                            Grid.Column="1"
                            Text="Cancel"
                            Command="{Binding CloseEditModalCommand}"
                            HeightRequest="44"
                            CornerRadius="10"
                            BackgroundColor="Transparent"
                            BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                            BorderWidth="1"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            IsVisible="{Binding IsEditingExisting, Converter={StaticResource InvertedBoolConverter}}" />
                    </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <Border
            Grid.RowSpan="2"
            HorizontalOptions="Center"
            Margin="20,0,20,30"
            IsVisible="{Binding IsStatusVisible}"
            StrokeShape="RoundRectangle 12"
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}"
            Padding="16,10"
            InputTransparent="True">
            <Label
                Text="{Binding StatusMessage}"
                FontSize="13"
                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
        </Border>

    </Grid>
</ContentPage>
