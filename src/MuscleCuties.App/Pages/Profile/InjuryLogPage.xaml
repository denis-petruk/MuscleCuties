<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Profile.InjuryLogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    xmlns:ui="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core"
    x:DataType="vm:InjuryLogViewModel"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="20,52,20,12"
            Spacing="2">

            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8">
                <Button
                    Text="&#x2039;"
                    Style="{StaticResource ButtonLink}"
                    FontSize="28"
                    Padding="0"
                    Command="{Binding NavigateBackCommand}" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label
                        Text="Injury Log"
                        Style="{StaticResource SubHeadline}" />
                    <Label
                        Text="Track injuries and see blocked exercises"
                        Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="2"
                    Text="Add"
                    Style="{StaticResource ButtonLink}"
                    Command="{Binding ToggleAddFormCommand}"
                    VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="20,8,20,32"
                Spacing="14"
                HorizontalOptions="Fill"
                MaximumWidthRequest="640">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Margin="0,24"
                    SemanticProperties.Description="Loading injury log" />

                <!-- Add injury -->
                <Border
                    Style="{StaticResource CardPrimary}"
                    IsVisible="{Binding ShowAddForm}">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="New Injury"
                            Style="{StaticResource CardTitle}" />

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Body site" Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Picker
                                    ItemsSource="{Binding AvailableSites}"
                                    SelectedItem="{Binding SelectedSite}"
                                    Title="Select body site" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Status" Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Picker
                                    ItemsSource="{Binding AvailableStatuses}"
                                    SelectedItem="{Binding SelectedStatus}"
                                    Title="Select status" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <Label
                                Grid.Column="0"
                                Text="Pain level"
                                Style="{StaticResource CaptionLabel}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding NewPainLevel}"
                                Style="{StaticResource AccentLabel}"
                                VerticalOptions="Center" />
                        </Grid>
                        <Slider
                            Minimum="0"
                            Maximum="3"
                            Value="{Binding NewPainLevel}"
                            MinimumTrackColor="{StaticResource Primary}"
                            MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray800}}"
                            ThumbColor="{StaticResource Primary}"
                            SemanticProperties.Description="Pain level slider" />

                        <Button
                            Text="Save injury"
                            Command="{Binding AddInjuryCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Active injuries -->
                <Label
                    Text="ACTIVE INJURIES"
                    Style="{StaticResource EyebrowLabel}"
                    CharacterSpacing="1.2"
                    Margin="4,8,4,0" />

                <CollectionView
                    ItemsSource="{Binding Injuries}"
                    ItemSizingStrategy="MeasureFirstItem">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label
                            Text="No injuries logged."
                            Style="{StaticResource MutedLabel}"
                            HorizontalOptions="Center"
                            Margin="0,12" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="ui:InjuryLogItem">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem
                                            Text="Delete"
                                            BackgroundColor="{StaticResource ErrorLight}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InjuryLogViewModel}}, Path=DeleteInjuryCommand}"
                                            CommandParameter="{Binding Id}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border
                                    Style="{StaticResource CardPrimary}"
                                    Padding="16,14"
                                    StrokeThickness="0">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label
                                                Text="{Binding SiteName}"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Label
                                                Style="{StaticResource CaptionLabel}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding StatusName}" />
                                                        <Span Text=" - Pain " />
                                                        <Span Text="{Binding Pain}" />
                                                        <Span Text="/3" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label
                                                Text="{Binding SinceText, StringFormat='Since {0}'}"
                                                Style="{StaticResource MutedLabel}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            Style="{StaticResource AccentLabel}"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Text" Value="Active" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="Cleared" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Blocked exercises -->
                <Border
                    Style="{StaticResource CardPrimary}"
                    IsVisible="{Binding HasBlockedExercises}">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="BLOCKED EXERCISES"
                            Style="{StaticResource EyebrowLabel}"
                            CharacterSpacing="1.2" />
                        <CollectionView
                            ItemsSource="{Binding BlockedExerciseNames}"
                            ItemSizingStrategy="MeasureFirstItem">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label
                                        Text="{Binding .}"
                                        Style="{StaticResource MutedLabel}"
                                        Margin="8,2" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Recommended rehab -->
                <Border
                    Style="{StaticResource CardPrimary}"
                    IsVisible="{Binding HasRehabExercises}">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="RECOMMENDED REHAB"
                            Style="{StaticResource EyebrowLabel}"
                            CharacterSpacing="1.2" />
                        <CollectionView
                            ItemsSource="{Binding RehabExerciseNames}"
                            ItemSizingStrategy="MeasureFirstItem">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label
                                        Text="{Binding .}"
                                        Style="{StaticResource AccentLabel}"
                                        Margin="8,2" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Blocked cardio -->
                <Border
                    Style="{StaticResource CardPrimary}"
                    IsVisible="{Binding HasBlockedCardio}">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="BLOCKED CARDIO"
                            Style="{StaticResource EyebrowLabel}"
                            CharacterSpacing="1.2" />
                        <CollectionView
                            ItemsSource="{Binding BlockedCardioNames}"
                            ItemSizingStrategy="MeasureFirstItem">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label
                                        Text="{Binding .}"
                                        Style="{StaticResource MutedLabel}"
                                        Margin="8,2" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
