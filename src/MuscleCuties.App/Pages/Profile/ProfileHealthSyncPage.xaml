<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Profile.ProfileHealthSyncPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    x:DataType="{x:Type vm:ProfileHealthSyncViewModel}"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid
            Padding="20,40,20,32"
            RowSpacing="16"
            HorizontalOptions="Fill"
            MaximumWidthRequest="640"
            RowDefinitions="Auto,Auto,Auto,Auto">
            <sharedControls:PageHeader
                Grid.Row="0"
                Title="Health data"
                Subtitle="Steps, sleep, readiness, and recovery"
                BackCommand="{Binding BackCommand}" />

            <Border
                Grid.Row="1"
                Style="{StaticResource CardPrimary}"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <sharedControls:ThemeAwareBrandLogoImage
                        WidthRequest="78"
                        HeightRequest="44"
                        VerticalOptions="Center" />
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="7">
                        <Label Text="Make planning less blind" Style="{StaticResource SectionTitle}" />
                        <Label
                            Grid.Row="1"
                            Text="Health import is unavailable in this release. Daily check-ins and your other records still support local readiness estimates."
                            Style="{StaticResource BodyLabel}" />
                    </Grid>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Style="{StaticResource CardPrimary}"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                    <sharedControls:IconSectionHeader Grid.Row="0" Text="Current status" IconGlyph="HeartPulse32" />
                    <Label Grid.Row="1" Text="{Binding StatusText}" Style="{StaticResource CardTitle}" />
                    <Button Grid.Row="2" Text="{Binding ConnectionBadgeText}" Command="{Binding ConnectCommand}"
                            IsVisible="{Binding IsAppleHealthAvailable}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            SemanticProperties.Description="Connect or refresh Apple Health" />
                    <Label Grid.Row="3" Text="{Binding LastSyncedText}" Style="{StaticResource CaptionLabel}" />

                    <Border
                        Grid.Row="4"
                        Style="{StaticResource ReadinessStatusTile}">
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                            <Image
                                Source="{Binding Source='BatteryCharge24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                WidthRequest="22"
                                HeightRequest="22"
                                Aspect="AspectFit"
                                VerticalOptions="Center" />
                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2" VerticalOptions="Center">
                                <Label Text="Today's readiness" Style="{StaticResource FormFieldLabel}" />
                                <Label Grid.Row="1" Text="{Binding ReadinessExplanationText}" Style="{StaticResource CaptionLabel}" />
                            </Grid>
                            <Label
                                Grid.Column="2"
                                Text="{Binding ReadinessScoreText}"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{Binding ReadinessScore, Converter={StaticResource ScoreToColorConverter}}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Label Text="Calories" Style="{StaticResource FormFieldLabel}" />
                        <Label Grid.Column="1" Text="Today's plan" Style="{StaticResource FormFieldLabel}" />
                    </Grid>
                </Grid>
            </Border>

            <Label
                Grid.Row="3"
                Text="{Binding StatusMessage}"
                Style="{StaticResource CaptionLabel}"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />
        </Grid>
    </ScrollView>
</ContentPage>
