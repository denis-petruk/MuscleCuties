<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Profile.ProfileHealthSyncPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    x:DataType="vm:ProfileHealthSyncViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,40,20,32"
            Spacing="16"
            HorizontalOptions="Fill"
            MaximumWidthRequest="640">
            <sharedControls:PageHeader
                Title="Health sync"
                Subtitle="Steps, sleep, readiness, and recovery"
                BackCommand="{Binding BackCommand}" />

            <Border
                Style="{StaticResource CardPrimary}"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <sharedControls:ThemeAwareBrandLogoImage
                        WidthRequest="78"
                        HeightRequest="44"
                        VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="7">
                        <Label Text="Make planning less blind" Style="{StaticResource SectionTitle}" />
                        <Label
                            Text="Health sync is paused while native providers are being isolated. No Apple Health, Health Connect, or Whoop data is read in this build."
                            Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <sharedControls:IconSectionHeader Text="Current status" IconGlyph="HeartPulse32" />
                    <Label Text="{Binding StatusText}" Style="{StaticResource CardTitle}" />
                    <Label Text="{Binding LastSyncedText}" Style="{StaticResource CaptionLabel}" />

                    <Border
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12">
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                            <Image
                                Source="{Binding Source='BatteryCharge24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                WidthRequest="22"
                                HeightRequest="22"
                                Aspect="AspectFit"
                                VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Today's readiness" Style="{StaticResource FormFieldLabel}" />
                                <Label Text="{Binding ReadinessExplanationText}" Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                Text="{Binding ReadinessScoreText}"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{Binding ReadinessScore, Converter={StaticResource ScoreToColorConverter}}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Calories" Style="{StaticResource FormFieldLabel}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Today's plan" Style="{StaticResource FormFieldLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- TODO(health-sync): Restore provider connection controls after native-provider diagnostics are complete. -->

            <Label
                Text="{Binding StatusMessage}"
                Style="{StaticResource CaptionLabel}"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
