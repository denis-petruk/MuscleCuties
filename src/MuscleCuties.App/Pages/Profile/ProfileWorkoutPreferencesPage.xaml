<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MuscleCuties.App.Pages.Profile.ProfileWorkoutPreferencesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    xmlns:workoutControls="clr-namespace:MuscleCuties.App.Controls.Workout"
    x:DataType="vm:ProfileWorkoutPreferencesViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,52,20,32" Spacing="16">
            <Grid ColumnDefinitions="44,*" ColumnSpacing="8">
                <Button
                    Text="‹"
                    Style="{StaticResource ButtonLink}"
                    FontSize="28"
                    Padding="0"
                    Command="{Binding BackCommand}" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Activity Preferences" Style="{StaticResource SubHeadline}" />
                    <Label Text="Choose what your weekly plan can use" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <sharedControls:IconSectionHeader Text="ACTIVITY PREFERENCES" IconGlyph="Dumbbell24" />
                    <Label
                        Text="Strength anchors the plan. Cardio only appears when you choose it. Yoga stays as the recovery fallback."
                        Style="{StaticResource MutedLabel}" />
                    <workoutControls:WorkoutActivityPreferencePicker
                        ActivityGroups="{Binding GroupedWorkoutActivityOptions}"
                        ToggleActivityCommand="{Binding ToggleWorkoutActivityCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardPrimary}" IsVisible="{Binding IsStrengthStyleVisible}">
                <VerticalStackLayout Spacing="12">
                    <sharedControls:IconSectionHeader Text="STRENGTH STYLE" IconGlyph="Flash24" />
                    <Label
                        Text="Pick how strength sessions should feel when your phase and energy make room for it."
                        Style="{StaticResource MutedLabel}" />
                    <workoutControls:StrengthTrainingStylePicker
                        SelectStyleCommand="{Binding SelectStrengthTrainingStyleCommand}" />
                </VerticalStackLayout>
            </Border>

            <Label
                Text="{Binding StatusMessage}"
                Style="{StaticResource AccentLabel}"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Button
                Text="Save workout preferences"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
