<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Profile.ProfileWorkoutPreferencesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    xmlns:workoutControls="clr-namespace:MuscleCuties.App.Controls.Workout"
    x:DataType="vm:ProfileWorkoutPreferencesViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,40,20,32"
            Spacing="16"
            HorizontalOptions="Fill"
            MaximumWidthRequest="640">
            <sharedControls:PageHeader
                Title="Activity preferences"
                BackCommand="{Binding BackCommand}" />

            <Border
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource Primary}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource ActivitySelectedSurfaceLight}, Dark={StaticResource CardSurfaceDark}}"
                Padding="14,10"
                SemanticProperties.Description="At least one strength activity is required for your plan.">
                <Label
                    Text="At least one strength activity is required for your plan."
                    FontFamily="Inter"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource ActivitySelectedStrokeLight}, Dark={StaticResource SecondaryDarkText}}" />
            </Border>

            <workoutControls:WorkoutActivityPreferencePicker
                ActivityGroups="{Binding GroupedWorkoutActivityOptions}"
                ToggleActivityCommand="{Binding ToggleWorkoutActivityCommand}" />

            <sharedControls:IconSectionHeader Text="Strength style" IconGlyph="Flash24" IsVisible="{Binding IsStrengthStyleVisible}" />
            <workoutControls:StrengthTrainingStylePicker
                ItemsSource="{Binding StrengthTrainingStyleOptions}"
                SelectStyleCommand="{Binding SelectStrengthTrainingStyleCommand}"
                IsVisible="{Binding IsStrengthStyleVisible}" />

            <Label
                Text="{Binding StatusMessage}"
                Style="{StaticResource AccentLabel}"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Button
                Text="Save workout preferences"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                SemanticProperties.Description="Saving preferences" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
