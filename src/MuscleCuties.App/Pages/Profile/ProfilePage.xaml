<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MuscleCuties.App.Pages.Profile.ProfilePage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:profileModels="clr-namespace:MuscleCuties.Core.Models.UI.Profile;assembly=MuscleCuties.Core"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    x:DataType="vm:ProfileViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,56,20,32" Spacing="14">

            <!-- ── Header ──────────────────────────────────────────── -->
            <Label
                Text="You"
                Style="{StaticResource SubHeadline}" />

            <!-- ── Profile card ────────────────────────────────────── -->
            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                        <Border
                            Grid.Column="0"
                            WidthRequest="62"
                            HeightRequest="62"
                            StrokeShape="RoundRectangle 31"
                            BackgroundColor="{StaticResource AccentSurface}"
                            StrokeThickness="0">
                            <Label
                                Text="{Binding UserInitial}"
                                FontSize="26"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Primary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label
                                Text="{Binding UserName}"
                                Style="{StaticResource SectionTitle}"
                                FontSize="20" />
                            <Label
                                Text="{Binding MemberSince}"
                                Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">

                        <Border
                            Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Padding="12,10">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label
                                    Text="{Binding SessionCount}"
                                    Style="{StaticResource SubHeadline}"
                                    FontSize="22"
                                    HorizontalOptions="Center" />
                                <Label
                                    Text="Sessions"
                                    Style="{StaticResource CaptionLabel}"
                                    HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Padding="12,10">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label
                                    Text="{Binding CycleDays}"
                                    Style="{StaticResource SubHeadline}"
                                    FontSize="22"
                                    HorizontalOptions="Center" />
                                <Label
                                    Text="Day cycle"
                                    Style="{StaticResource CaptionLabel}"
                                    HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Padding="12,10">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label
                                    Text="{Binding PhasesTracked}"
                                    Style="{StaticResource SubHeadline}"
                                    FontSize="22"
                                    HorizontalOptions="Center" />
                                <Label
                                    Text="Phases"
                                    Style="{StaticResource CaptionLabel}"
                                    HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ── Preferences section ─────────────────────────────── -->
            <Label
                Text="PREFERENCES"
                Style="{StaticResource EyebrowLabel}"
                CharacterSpacing="1.2"
                Margin="4,6,4,0" />

            <Border Style="{StaticResource CardPrimary}" Padding="4">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Preferences}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="profileModels:PreferenceItem">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*, Auto" Padding="12,14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.OpenPreferenceCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout Spacing="3">
                                        <Label
                                            Text="{Binding Title}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label
                                            Text="{Binding Subtitle}"
                                            Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="1"
                                        Text="›"
                                        FontSize="22"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray500}}"
                                        VerticalOptions="Center" />
                                </Grid>
                                <BoxView Margin="16,0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <Button
                Text="Log out"
                Clicked="OnLogoutClicked"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                TextColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
