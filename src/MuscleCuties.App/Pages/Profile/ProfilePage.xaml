<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Profile.ProfilePage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:profileModels="clr-namespace:MuscleCuties.Core.Models.UI.Profile;assembly=MuscleCuties.Core"
    xmlns:profileControls="clr-namespace:MuscleCuties.App.Controls.Profile"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    x:DataType="vm:ProfileViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <CollectionView
            ItemsSource="{Binding Preferences}"
            MaximumWidthRequest="640"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Padding="20,40,20,8" Spacing="16">
                    <Label Text="You" Style="{StaticResource SubHeadline}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border
                            WidthRequest="62"
                            HeightRequest="62"
                            StrokeShape="RoundRectangle 31"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                            Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                            StrokeThickness="1"
                            SemanticProperties.Description="Change profile photo">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProfileImageTapped" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Image
                                    Source="{Binding ProfileImageSource}"
                                    IsVisible="{Binding HasProfileImage}"
                                    Aspect="AspectFill"
                                    WidthRequest="62"
                                    HeightRequest="62" />
                                <Image
                                    IsVisible="{Binding HasNoProfileImage}"
                                    Source="{AppThemeBinding Light=musclecuties_logo_light_transparent.png, Dark=musclecuties_logo_dark_transparent.png}"
                                    Aspect="AspectFill"
                                    WidthRequest="62"
                                    HeightRequest="62" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="3" VerticalOptions="Center">
                            <Label Text="{Binding UserName}" Style="{StaticResource SectionTitle}" FontSize="20" />
                            <Label Grid.Row="1" Text="{Binding MemberSince}" Style="{StaticResource CaptionLabel}" FontSize="14" />
                        </Grid>
                    </Grid>

                    <!-- Activity summary tiles -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                            StrokeThickness="1"
                            Padding="8,12"
                            MinimumHeightRequest="80"
                            SemanticProperties.Description="{Binding WorkoutStreakDays, StringFormat='Workout session streak: {0} days'}">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Image
                                        Source="{AppThemeBinding Light=icon_muscle.png, Dark=icon_muscle_dark.png}"
                                        Aspect="AspectFit"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        VerticalOptions="Center" />
                                    <Label
                                        Text="{Binding WorkoutStreakDays}"
                                        Style="{StaticResource SubHeadline}"
                                        FontSize="22"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="Session streak"
                                    Style="{StaticResource CaptionLabel}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                            StrokeThickness="1"
                            Padding="8,12"
                            MinimumHeightRequest="80"
                            SemanticProperties.Description="{Binding NutritionStreakDays, StringFormat='Nutrition log streak: {0} days'}">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Image
                                        Source="{AppThemeBinding Light=icon_fire.png, Dark=icon_fire_dark.png}"
                                        Aspect="AspectFit"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        VerticalOptions="Center" />
                                    <Label
                                        Text="{Binding NutritionStreakDays}"
                                        Style="{StaticResource SubHeadline}"
                                        FontSize="22"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="Log streak"
                                    Style="{StaticResource CaptionLabel}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                            StrokeThickness="1"
                            Padding="8,12"
                            MinimumHeightRequest="80"
                            SemanticProperties.Description="{Binding CyclesTracked, StringFormat='Cycles logged: {0}'}">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Image
                                        Source="{AppThemeBinding Light=tab_cycle.png, Dark=tab_cycle_dark.png}"
                                        Aspect="AspectFit"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        VerticalOptions="Center" />
                                    <Label
                                        Text="{Binding CyclesTracked}"
                                        Style="{StaticResource SubHeadline}"
                                        FontSize="22"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="Cycles logged"
                                    Style="{StaticResource CaptionLabel}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="Settings" Style="{StaticResource SectionTitle}" Margin="2,8,2,0" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="profileModels:PreferenceItem">
                    <Border Style="{StaticResource CardPrimary}" Margin="20,0" Padding="14,16"
                            MinimumHeightRequest="60">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding OpenPreferenceCommand, Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, x:DataType=vm:ProfileViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12">
                            <Image
                                Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                WidthRequest="20"
                                HeightRequest="20"
                                Aspect="AspectFit"
                                VerticalOptions="Center" />
                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="4">
                                <Label
                                    Text="{Binding Title}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label
                                    Grid.Row="1"
                                    Text="{Binding Subtitle}"
                                    Style="{StaticResource CaptionLabel}"
                                    FontSize="14" />
                            </Grid>
                            <Image
                                Grid.Column="2"
                                Source="{Binding Source='ChevronRight24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                WidthRequest="18"
                                HeightRequest="18"
                                Aspect="AspectFit"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Padding="20,12,20,32" Spacing="12">
                    <Label
                        Text="All health and fitness data is stored locally on this device."
                        Style="{StaticResource CaptionLabel}"
                        FontSize="14"
                        HorizontalTextAlignment="Center" />
                    <Button
                        Text="Log out"
                        Clicked="OnLogoutClicked"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>

        <sharedControls:PageLoadingOverlay />
        <toolkit:LazyView
            x:Name="CropModalLazy"
            x:TypeArguments="profileControls:ProfileImageCropModal"
            InputTransparent="True" />
    </Grid>
</ContentPage>
