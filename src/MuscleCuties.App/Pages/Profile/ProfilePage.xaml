<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Profile.ProfilePage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:profileModels="clr-namespace:MuscleCuties.Core.Models.UI.Profile;assembly=MuscleCuties.Core"
    xmlns:profileControls="clr-namespace:MuscleCuties.App.Controls.Profile"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    x:DataType="vm:ProfileViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout
            Padding="20,56,20,32"
            Spacing="14"
            HorizontalOptions="Fill"
            MaximumWidthRequest="640">

            <Label
                Text="You"
                Style="{StaticResource SubHeadline}" />

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                        <Border
                            Grid.Column="0"
                            WidthRequest="62"
                            HeightRequest="62"
                            StrokeShape="RoundRectangle 31"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                            StrokeThickness="0"
                            SemanticProperties.Description="Change profile photo">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProfileImageTapped" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Image
                                    Source="{Binding ProfileImageSource}"
                                    IsVisible="{Binding HasProfileImage}"
                                    Aspect="AspectFill"
                                    WidthRequest="62"
                                    HeightRequest="62"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                                <Image
                                    IsVisible="{Binding HasNoProfileImage}"
                                    Source="{AppThemeBinding Light=musclecuties_logo_light_transparent.png, Dark=musclecuties_logo_dark_transparent.png}"
                                    Aspect="AspectFill"
                                    WidthRequest="62"
                                    HeightRequest="62"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label
                                Text="{Binding UserName}"
                                Style="{StaticResource SectionTitle}"
                                FontSize="20" />
                            <Label
                                Text="{Binding MemberSince}"
                                Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">

                        <Border
                            Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Padding="8,10"
                            MinimumHeightRequest="76"
                            SemanticProperties.Description="{Binding WorkoutStreakDays, StringFormat='Workout session streak: {0} days'}">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="1">
                                    <sharedControls:ThemeAwareImage
                                        LightSource="icon_muscle.png"
                                        DarkSource="icon_muscle_dark.png"
                                        Aspect="AspectFit"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        VerticalOptions="Center" />
                                    <Label
                                        Text="{Binding WorkoutStreakDays}"
                                        Style="{StaticResource SubHeadline}"
                                        FontSize="22"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="Session streak"
                                    Style="{StaticResource CaptionLabel}"
                                    FontSize="9"
                                    HorizontalTextAlignment="Center"
                                    HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Padding="8,10"
                            MinimumHeightRequest="76"
                            SemanticProperties.Description="{Binding NutritionStreakDays, StringFormat='Nutrition log streak: {0} days'}">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="1">
                                    <sharedControls:ThemeAwareImage
                                        LightSource="icon_fire.png"
                                        DarkSource="icon_fire_dark.png"
                                        Aspect="AspectFit"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        VerticalOptions="Center" />
                                    <Label
                                        Text="{Binding NutritionStreakDays}"
                                        Style="{StaticResource SubHeadline}"
                                        FontSize="22"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="Log streak"
                                    Style="{StaticResource CaptionLabel}"
                                    FontSize="9"
                                    HorizontalTextAlignment="Center"
                                    HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Padding="8,10"
                            MinimumHeightRequest="76"
                            SemanticProperties.Description="{Binding CyclesTracked, StringFormat='Cycles logged: {0}'}">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="1">
                                    <sharedControls:ThemeAwareImage
                                        LightSource="tab_cycle.png"
                                        DarkSource="tab_cycle_dark.png"
                                        Aspect="AspectFit"
                                        WidthRequest="26"
                                        HeightRequest="26"
                                        VerticalOptions="Center" />
                                    <Label
                                        Text="{Binding CyclesTracked}"
                                        Style="{StaticResource SubHeadline}"
                                        FontSize="22"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="Cycles logged"
                                    Style="{StaticResource CaptionLabel}"
                                    FontSize="9"
                                    HorizontalTextAlignment="Center"
                                    HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Label
                Text="PREFERENCES"
                Style="{StaticResource EyebrowLabel}"
                CharacterSpacing="1.2"
                Margin="4,6,4,0" />

            <Border Style="{StaticResource CardPrimary}" Padding="4">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Preferences}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="profileModels:PreferenceItem">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="10" Padding="12,14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.OpenPreferenceCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Image
                                        Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        Aspect="AspectFit"
                                        VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label
                                            Text="{Binding Title}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label
                                            Text="{Binding Subtitle}"
                                            Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                    <Image
                                        Grid.Column="2"
                                        Source="{Binding Source='ChevronRight24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        Aspect="AspectFit"
                                        VerticalOptions="Center" />
                                </Grid>
                                <BoxView Margin="16,0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <Button
                Text="Log out"
                Clicked="OnLogoutClicked"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                TextColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>
        <sharedControls:PageLoadingOverlay />
        <profileControls:ProfileImageCropModal x:Name="CropModal" />
    </Grid>

</ContentPage>
