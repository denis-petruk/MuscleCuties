<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MuscleCuties.App.Pages.Profile.ProfilePrivacyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,52,20,32" Spacing="16">
            <Grid ColumnDefinitions="44,*" ColumnSpacing="8">
                <Button
                    Text="‹"
                    Style="{StaticResource ButtonLink}"
                    FontSize="28"
                    Padding="0"
                    Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Privacy" Style="{StaticResource SubHeadline}" />
                    <Label Text="Private beta data and wellness boundaries" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Grid>

            <Border
                Style="{StaticResource CardPrimary}"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="10">
                        <Image
                            Source="{Binding Source='ShieldCheckmark24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                            WidthRequest="24"
                            HeightRequest="24"
                            Aspect="AspectFit"
                            HorizontalOptions="Start" />
                        <Label Text="Your beta data stays private." Style="{StaticResource SectionTitle}" />
                        <Label
                            Text="Planning help, not medical advice. Your tester notes and app data are not sold, advertised with, or shared beyond the handsome, jacked developer."
                            Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                    <sharedControls:ThemeAwareBrandLogoImage
                        Grid.Column="1"
                        WidthRequest="82"
                        HeightRequest="48"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <sharedControls:IconSectionHeader Text="DATA BOUNDARIES" IconGlyph="ShieldLock24" />
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <Grid ColumnDefinitions="94,*" ColumnSpacing="10">
                            <Label Text="Profile" Style="{StaticResource FormFieldLabel}" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Stored locally for account, settings, and planning."
                                Style="{StaticResource CaptionLabel}"
                                VerticalOptions="Center" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="94,*" ColumnSpacing="10">
                            <Label Text="Health" Style="{StaticResource FormFieldLabel}" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Weekly averages only when you connect a provider."
                                Style="{StaticResource CaptionLabel}"
                                VerticalOptions="Center" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="94,*" ColumnSpacing="10">
                            <Label Text="Feedback" Style="{StaticResource FormFieldLabel}" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Sent by email only when you choose to send it."
                                Style="{StaticResource CaptionLabel}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <Grid ColumnDefinitions="36,*,28" ColumnSpacing="12">
                    <Border
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        StrokeShape="Ellipse"
                        WidthRequest="32"
                        HeightRequest="32"
                        VerticalOptions="Start">
                        <Label
                            Text="1"
                            Style="{StaticResource FormFieldLabel}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Not Medical Direction" Style="{StaticResource CardTitle}" />
                        <Label
                            Text="The app does not diagnose, treat, prevent, or replace advice from a licensed clinician."
                            Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>

                    <Image
                        Grid.Column="2"
                        Source="{Binding Source='Stethoscope24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                        WidthRequest="24"
                        HeightRequest="24"
                        Aspect="AspectFit"
                        VerticalOptions="Start" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <Grid ColumnDefinitions="36,*,28" ColumnSpacing="12">
                    <Border
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        StrokeShape="Ellipse"
                        WidthRequest="32"
                        HeightRequest="32"
                        VerticalOptions="Start">
                        <Label
                            Text="2"
                            Style="{StaticResource FormFieldLabel}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Private Beta" Style="{StaticResource CardTitle}" />
                        <Label
                            Text="Tester information is not sold, shared with advertisers, or passed to outside teams. Feedback is private to the handsome, jacked developer."
                            Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>

                    <Image
                        Grid.Column="2"
                        Source="{Binding Source='ShieldLock24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                        WidthRequest="24"
                        HeightRequest="24"
                        Aspect="AspectFit"
                        VerticalOptions="Start" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <Grid ColumnDefinitions="36,*,28" ColumnSpacing="12">
                    <Border
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        StrokeShape="Ellipse"
                        WidthRequest="32"
                        HeightRequest="32"
                        VerticalOptions="Start">
                        <Label
                            Text="3"
                            Style="{StaticResource FormFieldLabel}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="What Can Be Stored" Style="{StaticResource CardTitle}" />
                        <Label
                            Text="The app may store your profile, cycle records, nutrition logs, workout plans, settings, and feedback you choose to send."
                            Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>

                    <Image
                        Grid.Column="2"
                        Source="{Binding Source='HomeDatabase24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                        WidthRequest="24"
                        HeightRequest="24"
                        Aspect="AspectFit"
                        VerticalOptions="Start" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <Grid ColumnDefinitions="36,*,28" ColumnSpacing="12">
                    <Border
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        StrokeShape="Ellipse"
                        WidthRequest="32"
                        HeightRequest="32"
                        VerticalOptions="Start">
                        <Label
                            Text="4"
                            Style="{StaticResource FormFieldLabel}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Health Sync" Style="{StaticResource CardTitle}" />
                        <Label
                            Text="If you connect Apple Health, Health Connect, or Whoop, MuscleCuties uses weekly summaries for planning. Readiness is calculated on your device from these weekly averages and is not shared with wearable providers."
                            Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>

                    <Image
                        Grid.Column="2"
                        Source="{Binding Source='DocumentHeartPulse24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                        WidthRequest="24"
                        HeightRequest="24"
                        Aspect="AspectFit"
                        VerticalOptions="Start" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <sharedControls:IconSectionHeader Text="YOUR CONTROL" IconGlyph="ShieldTask24" />
                    <Label Text="You can edit your app information from Profile." Style="{StaticResource CardTitle}" />
                    <BoxView />
                    <Label
                        Text="You can stop health sharing in Apple Health, Health Connect, or Whoop at any time. For beta data questions, removal requests, or privacy concerns, use Feedback. It opens a private email for the handsome, jacked developer."
                        Style="{StaticResource BodyLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <sharedControls:IconSectionHeader Text="CARE NOTE" IconGlyph="ShieldError24" />
                    <Label
                        Text="Cycle and nutrition patterns can be useful signals. Unusual pain, bleeding, fainting, severe fatigue, or sudden health changes should be discussed with a qualified medical professional."
                        Style="{StaticResource BodyLabel}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
