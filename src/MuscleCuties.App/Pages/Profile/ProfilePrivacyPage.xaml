<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Profile.ProfilePrivacyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MuscleCuties.App.Pages.Profile"
    x:DataType="local:ProfilePrivacyPage"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,32" Spacing="22" MaximumWidthRequest="640">
            <Grid ColumnDefinitions="44,*" ColumnSpacing="8">
                <ImageButton Source="nav_back.png" BackgroundColor="Transparent"
                             WidthRequest="44" HeightRequest="44" MinimumWidthRequest="44" MinimumHeightRequest="44"
                             Padding="10"
                             Clicked="OnBackClicked" SemanticProperties.Description="Back to Profile" />
                <Label Grid.Column="1" Text="Privacy" Style="{StaticResource SubHeadline}"
                       VerticalOptions="Center" />
            </Grid>

            <Border Padding="20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}"
                    Stroke="Transparent" StrokeThickness="0"
                    StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="*,96" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="Your health records stay on this device."
                               Style="{StaticResource SectionTitle}" FontSize="22" />
                        <Label Text="Cycle, workout, nutrition and injury records power your plans locally."
                               Style="{StaticResource BodyLabel}" FontSize="14" />
                    </VerticalStackLayout>
                    <Image Grid.Column="1" Source="privacy_device.png"
                           WidthRequest="96" HeightRequest="108" Aspect="AspectFit"
                           SemanticProperties.Description="Device with a protected health record" />
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="12">
                <Label Text="Data boundaries" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource CardPrimary}" Padding="16,4">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="28,*" ColumnSpacing="12" Padding="0,14">
                            <Image Source="{Binding Source='Food24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                   WidthRequest="24" HeightRequest="24" Aspect="AspectFit" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Food search" Style="{StaticResource CardTitle}" FontSize="16" />
                                <Label Text="Only recognized, generic food names may reach USDA FoodData Central. Your logs are not included."
                                       Style="{StaticResource BodyLabel}" FontSize="14" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}" />
                        <Grid ColumnDefinitions="28,*" ColumnSpacing="12" Padding="0,14">
                            <Image Source="{Binding Source='ChatSettings24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                   WidthRequest="24" HeightRequest="24" Aspect="AspectFit" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Feedback" Style="{StaticResource CardTitle}" FontSize="16" />
                                <Label Text="Your profile name is included in the email draft. Reply email and attachments are optional."
                                       Style="{StaticResource BodyLabel}" FontSize="14" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}" />
                        <Grid ColumnDefinitions="28,*" ColumnSpacing="12" Padding="0,14">
                            <Image Source="{Binding Source='DocumentHeartPulse24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                   WidthRequest="24" HeightRequest="24" Aspect="AspectFit" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Health connections" Style="{StaticResource CardTitle}" FontSize="16" />
                                <Label Text="Apple Health, Health Connect and Whoop are disconnected in this build. No provider data is read."
                                       Style="{StaticResource BodyLabel}" FontSize="14" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="You are in control" Style="{StaticResource SectionTitle}" />
                <Label Text="Edit your details in Profile. For privacy questions or removal requests, open a feedback email."
                       Style="{StaticResource BodyLabel}" FontSize="14" />
                <Button Text="Open feedback" Style="{StaticResource ButtonSecondary}"
                        Clicked="OnFeedbackClicked" HorizontalOptions="Start" MinimumHeightRequest="44" />
            </VerticalStackLayout>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurfaceLight}, Dark={StaticResource WarningSurfaceDark}}"
                    Padding="16" Stroke="Transparent" StrokeThickness="0"
                    StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                    <Image Source="{Binding Source='ShieldError24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                           WidthRequest="24" HeightRequest="24" Aspect="AspectFit" VerticalOptions="Start" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Wellness guidance" Style="{StaticResource CardTitle}" FontSize="16" />
                        <Label Text="The app does not diagnose or treat conditions. Ask a clinician about unusual pain, bleeding, fainting or sudden changes."
                               Style="{StaticResource BodyLabel}" FontSize="14" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
