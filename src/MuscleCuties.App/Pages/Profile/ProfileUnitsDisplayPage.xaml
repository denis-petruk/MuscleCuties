<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Profile.ProfileUnitsDisplayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    x:DataType="vm:ProfileUnitsDisplayViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,52,20,32"
            Spacing="16"
            HorizontalOptions="Fill"
            MaximumWidthRequest="640">
            <Grid ColumnDefinitions="44,*" ColumnSpacing="8">
                <Button
                    Text="‹"
                    Style="{StaticResource ButtonLink}"
                    FontSize="28"
                    Padding="0"
                    Command="{Binding BackCommand}" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Units &amp; Display" Style="{StaticResource SubHeadline}" />
                    <Label Text="Set the default measuring system for the app" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="14">
                    <sharedControls:IconSectionHeader Text="DEFAULT SYSTEM" IconGlyph="ChatSettings24" />
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding UnitSystemText}" Style="{StaticResource CardTitle}" />
                            <Label Text="Metric uses kg, g, cm, and km. Imperial uses lb, oz, in, and mi."
                                   Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border
                                Padding="12,10"
                                MinimumHeightRequest="52"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                SemanticProperties.Description="Select Imperial units">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectImperialUnitsCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding UseImperialSystem}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label
                                    Text="Imperial"
                                    Style="{StaticResource BodyLabel}"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding UseImperialSystem}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Padding="12,10"
                                MinimumHeightRequest="52"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                SemanticProperties.Description="Select Metric units">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectMetricUnitsCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding UseMetricSystem}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label
                                    Text="Metric"
                                    Style="{StaticResource BodyLabel}"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding UseMetricSystem}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <sharedControls:IconSectionHeader Text="UNIT DEFAULTS" IconGlyph="TargetEdit24" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                            <Label Text="Body weight" Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Placeholder="kg or lb" Text="{Binding BodyWeightUnit}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                            <Label Text="Food mass" Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Placeholder="g or oz" Text="{Binding FoodMassUnit}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
                            <Label Text="Height" Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Placeholder="cm or in" Text="{Binding HeightUnit}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5">
                            <Label Text="Distance" Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Placeholder="km or mi" Text="{Binding DistanceUnit}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5">
                            <Label Text="Energy" Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Placeholder="kcal" Text="{Binding EnergyUnit}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label
                Text="{Binding StatusMessage}"
                Style="{StaticResource CaptionLabel}"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Button Text="Save units" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>