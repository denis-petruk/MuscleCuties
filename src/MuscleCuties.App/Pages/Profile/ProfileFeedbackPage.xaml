<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MuscleCuties.App.Pages.Profile.ProfileFeedbackPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    x:DataType="vm:ProfileFeedbackViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,52,20,32" Spacing="16">
            <Grid ColumnDefinitions="44,*" ColumnSpacing="8">
                <Button
                    Text="‹"
                    Style="{StaticResource ButtonLink}"
                    FontSize="28"
                    Padding="0"
                    Command="{Binding BackCommand}" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Feedback" Style="{StaticResource SubHeadline}" />
                    <Label Text="Private beta notes for the handsome, jacked developer" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Grid>

            <Border
                Style="{StaticResource CardPrimary}"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource CardSurfaceDark}}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="8">
                        <sharedControls:IconSectionHeader Text="SEND THE GOOD STUFF" IconGlyph="ChatBubblesQuestion24" />
                        <Label Text="Talk to the handsome, jacked developer" Style="{StaticResource SectionTitle}" />
                        <Label
                            Text="Bug, style issue, tiny annoyance, huge idea: write it here and attach context when useful."
                            Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                    <sharedControls:ThemeAwareBrandLogoImage
                        Grid.Column="1"
                        WidthRequest="82"
                        HeightRequest="48"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <sharedControls:IconSectionHeader Text="SORT IT" IconGlyph="ChatBubblesQuestion24" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Topic" Style="{StaticResource FormFieldLabel}" />
                            <Label Text="What part of the app this note is about." Style="{StaticResource FormFieldHint}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Picker
                                    Title="Topic"
                                    ItemsSource="{Binding TopicOptions}"
                                    ItemDisplayBinding="{Binding Label}"
                                    SelectedItem="{Binding SelectedTopicOption}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Priority" Style="{StaticResource FormFieldLabel}" />
                            <Label Text="How urgent or important it feels to you." Style="{StaticResource FormFieldHint}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Picker
                                    Title="Priority"
                                    ItemsSource="{Binding PriorityOptions}"
                                    ItemDisplayBinding="{Binding Label}"
                                    SelectedItem="{Binding SelectedPriorityOption}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="5">
                        <Grid ColumnDefinitions="18,*" ColumnSpacing="6">
                            <Image
                                Source="{Binding Source='Target24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                WidthRequest="15"
                                HeightRequest="15"
                                Aspect="AspectFit"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Screen or feature"
                                Style="{StaticResource FormFieldLabel}"
                                VerticalOptions="Center" />
                        </Grid>
                        <Label Text="Helps point the feedback to the exact place in the app." Style="{StaticResource FormFieldHint}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry
                                Placeholder="Example: Nutrition page"
                                Text="{Binding ScreenName}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <sharedControls:IconSectionHeader Text="REACH YOU BACK" IconGlyph="PersonChat24" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Include contact email" Style="{StaticResource CardTitle}" />
                            <Label Text="Turn it off for anonymous-ish feedback text." Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding IncludeContactEmail}"
                            OnColor="{StaticResource Primary}"
                            ThumbColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray200}}"
                            VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout
                        Spacing="5"
                        IsVisible="{Binding IncludeContactEmail}">
                        <Label Text="Reply email" Style="{StaticResource FormFieldLabel}" />
                        <Label Text="Only used if a follow-up would help understand your note." Style="{StaticResource FormFieldHint}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Placeholder="Contact email" Text="{Binding ContactEmail}" Keyboard="Email" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <sharedControls:IconSectionHeader Text="WHAT HAPPENED" IconGlyph="Comment24" />
                        <Label Grid.Column="1" Text="{Binding FeedbackCountText}" Style="{StaticResource CaptionLabel}" />
                    </Grid>
                    <Label
                        Text="Describe the bug, slow spot, confusing wording, or design detail you noticed."
                        Style="{StaticResource FormFieldHint}" />
                    <Border Style="{StaticResource InputContainer}" MinimumHeightRequest="146">
                        <Editor
                            Placeholder="Tell me what you noticed. What felt off, broken, slow, ugly, confusing?"
                            Text="{Binding FeedbackText}"
                            AutoSize="TextChanges" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <sharedControls:IconSectionHeader Text="WHAT WOULD MAKE IT BETTER" IconGlyph="SparkleCircle24" />
                    <Label
                        Text="Share the version you wish existed, even if it is rough."
                        Style="{StaticResource FormFieldHint}" />
                    <Border Style="{StaticResource InputContainer}" MinimumHeightRequest="146">
                        <Editor
                            Placeholder="Suggest the fix, better wording, missing control, or the version you wish existed."
                            Text="{Binding AdjustmentText}"
                            AutoSize="TextChanges" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <sharedControls:IconSectionHeader Text="ATTACH CONTEXT" IconGlyph="LinkSquare24" />
                            <Label Text="Screenshot, PDF, text, or log file under 10 MB." Style="{StaticResource FormFieldHint}" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Text="Attach"
                            Padding="14,8"
                            Clicked="OnAttachFileClicked" />
                    </Grid>

                    <Border
                        IsVisible="{Binding HasAttachment}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        Padding="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding AttachmentName}" Style="{StaticResource CardTitle}" FontSize="14" />
                                <Label Text="Ready to include with the email." Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                Text="Remove"
                                Style="{StaticResource ButtonLink}"
                                Command="{Binding RemoveAttachmentCommand}" />
                        </Grid>
                    </Border>

                    <Label
                        Text="{Binding AttachmentStatus}"
                        Style="{StaticResource CaptionLabel}"
                        IsVisible="{Binding AttachmentStatus, Converter={StaticResource StringToBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <Label
                Text="{Binding StatusMessage}"
                Style="{StaticResource CaptionLabel}"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Button
                Text="Send feedback"
                Command="{Binding SendFeedbackCommand}"
                IsEnabled="{Binding IsReadyToSend}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
