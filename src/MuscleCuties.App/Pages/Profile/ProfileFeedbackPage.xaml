<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Profile.ProfileFeedbackPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:commonModels="clr-namespace:MuscleCuties.Core.Models.UI.Common;assembly=MuscleCuties.Core"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    x:DataType="vm:ProfileFeedbackViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,32" Spacing="16" MaximumWidthRequest="640">
            <sharedControls:PageHeader Title="Feedback" BackCommand="{Binding BackCommand}" />

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,56" ColumnSpacing="12">
                        <Label Text="Describe the issue or idea" Style="{StaticResource SectionTitle}"
                               VerticalOptions="Center" />
                        <Image Grid.Column="1" Source="feedback_note.png" WidthRequest="56" HeightRequest="56"
                               Aspect="AspectFit" SemanticProperties.Description="Feedback note" />
                    </Grid>
                    <Border Style="{StaticResource InputContainer}" MinimumHeightRequest="150">
                        <Editor Placeholder="What happened, or what would you add?"
                                Text="{Binding FeedbackText}" AutoSize="TextChanges"
                                SemanticProperties.Description="Your feedback" />
                    </Border>
                    <Label Text="Suggested fix (optional)" Style="{StaticResource FormFieldLabel}" />
                    <Border Style="{StaticResource InputContainer}" MinimumHeightRequest="88">
                        <Editor Placeholder="What would work better?"
                                Text="{Binding AdjustmentText}" AutoSize="TextChanges"
                                SemanticProperties.Description="Suggested change" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardPrimary}">
                <VerticalStackLayout Spacing="12">
                    <sharedControls:IconSectionHeader Text="Details" IconGlyph="Target24" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Topic" Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Picker Title="Topic" ItemsSource="{Binding TopicOptions}"
                                        ItemDisplayBinding="{Binding Label, x:DataType=commonModels:ILabeledOption}"
                                        SelectedItem="{Binding SelectedTopicOption}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Priority" Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Picker Title="Priority" ItemsSource="{Binding PriorityOptions}"
                                        ItemDisplayBinding="{Binding Label, x:DataType=commonModels:ILabeledOption}"
                                        SelectedItem="{Binding SelectedPriorityOption}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Screen (optional)" Style="{StaticResource FormFieldLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Placeholder="e.g. Nutrition" Text="{Binding ScreenName}" />
                        </Border>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <Label Text="Include reply email" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IncludeContactEmail}"
                                OnColor="{StaticResource Primary}"
                                ThumbColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray200}}"
                                VerticalOptions="Center"
                                SemanticProperties.Description="Include contact email for a reply" />
                    </Grid>
                    <Border Style="{StaticResource InputContainer}" IsVisible="{Binding IncludeContactEmail}">
                        <Entry Placeholder="Reply email" Text="{Binding ContactEmail}" Keyboard="Email"
                               SemanticProperties.Description="Reply email" />
                    </Border>
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <sharedControls:IconSectionHeader Text="Attachment" IconGlyph="LinkSquare24" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Add file" Style="{StaticResource ButtonSecondary}"
                                Clicked="OnAttachFileClicked" MinimumHeightRequest="44" />
                    </Grid>
                    <Grid IsVisible="{Binding HasAttachment}" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding AttachmentName}" Style="{StaticResource MutedLabel}"
                               LineBreakMode="MiddleTruncation" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Remove" Style="{StaticResource ButtonLink}"
                                Command="{Binding RemoveAttachmentCommand}" />
                    </Grid>
                    <Label Text="{Binding AttachmentStatus}" Style="{StaticResource CaptionLabel}"
                           IsVisible="{Binding AttachmentStatus, Converter={StaticResource StringToBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}" Style="{StaticResource CaptionLabel}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />
            <Button Text="Open email draft" Command="{Binding SendFeedbackCommand}"
                    IsEnabled="{Binding IsReadyToSend}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
