<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Startup.AppStartupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MuscleCuties.App.Pages.Startup"
    x:DataType="local:AppStartupPage"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False">

    <Grid
        x:Name="StartupRoot"
        Padding="28"
        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
        <VerticalStackLayout
            Spacing="18"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            MaximumWidthRequest="400">
            <Image
                x:Name="StartupLogo"
                Source="{AppThemeBinding Light=musclecuties_logo_light_transparent.png, Dark=musclecuties_logo_dark_transparent.png}"
                Aspect="AspectFit"
                WidthRequest="220"
                HeightRequest="124"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                SemanticProperties.Description="MuscleCuties logo" />
            <ActivityIndicator
                x:Name="StartupActivityIndicator"
                IsRunning="True"
                HorizontalOptions="Center"
                SemanticProperties.Description="Loading application" />
            <Label
                x:Name="StartupStatusLabel"
                Text="Getting things ready..."
                Style="{StaticResource MutedLabel}"
                HorizontalTextAlignment="Center"
                SemanticProperties.Description="Loading status" />
            <Label
                x:Name="StartupErrorLabel"
                IsVisible="False"
                Style="{StaticResource ErrorLabel}"
                HorizontalTextAlignment="Center"
                Text="Unable to open your data securely. Please try again."
                SemanticProperties.Description="Error: Unable to open your data securely"
                SemanticProperties.HeadingLevel="Level2" />
            <Button
                x:Name="RetryButton"
                IsVisible="False"
                Text="Try again"
                Clicked="OnRetryClicked"
                MinimumHeightRequest="52"
                MinimumWidthRequest="44"
                SemanticProperties.Description="Retry loading the app"
                SemanticProperties.Hint="Double tap to retry loading the app" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
