<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MuscleCuties.App.Pages.Startup.AppStartupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False">

    <Grid
        x:Name="StartupRoot"
        Padding="28"
        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
        <VerticalStackLayout
            Spacing="18"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Image
                x:Name="StartupLogo"
                Source="{AppThemeBinding Light=musclecuties_logo_light_transparent.png, Dark=musclecuties_logo_dark_transparent.png}"
                Aspect="AspectFit"
                WidthRequest="220"
                HeightRequest="124"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                SemanticProperties.Description="MuscleCuties logo" />
            <ActivityIndicator
                IsRunning="True"
                HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
