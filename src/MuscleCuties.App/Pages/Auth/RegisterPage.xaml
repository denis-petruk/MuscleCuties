<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Auth.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Auth;assembly=MuscleCuties.Core"
    x:DataType="vm:RegisterViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,36,24,32"
            Spacing="0"
            HorizontalOptions="Fill"
            MaximumWidthRequest="520">

            <sharedControls:ThemeAwareBrandLogoImage
                WidthRequest="132"
                HeightRequest="72"
                HorizontalOptions="Center"
                Aspect="AspectFit"
                SemanticProperties.Description="MuscleCuties logo" />

            <Label
                Text="Create your account"
                Style="{StaticResource Headline}"
                Margin="0,20,0,8"
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                Text="One profile, shaped around you."
                Style="{StaticResource MutedLabel}"
                Margin="0,0,0,28" />

            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Email" Style="{StaticResource FormFieldLabel}" />
                    <Border Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="RegisterEmail"
                            AutomationId="RegisterEmail"
                            Placeholder="name@example.com"
                            Text="{Binding Email}"
                            Keyboard="Email"
                            ReturnType="Next"
                            Completed="OnEmailCompleted"
                            SemanticProperties.Description="Email address"
                            SemanticProperties.Hint="Enter your email, then press next to set your password" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Password" Style="{StaticResource FormFieldLabel}" />
                    <Border Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="RegisterPassword"
                            AutomationId="RegisterPassword"
                            Placeholder="8+ · upper/lower · number · symbol"
                            Text="{Binding Password}"
                            IsPassword="True"
                            ReturnType="Next"
                            Completed="OnPasswordCompleted"
                            SemanticProperties.Description="Create password"
                            SemanticProperties.Hint="Use at least 8 characters with uppercase and lowercase letters, a number, and a symbol. Do not use spaces. Press next to confirm your password." />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Confirm password" Style="{StaticResource FormFieldLabel}" />
                    <Border Style="{StaticResource InputContainer}">
                        <Entry
                            x:Name="RegisterConfirmPassword"
                            AutomationId="RegisterConfirmPassword"
                            Placeholder="Repeat password"
                            Text="{Binding ConfirmPassword}"
                            IsPassword="True"
                            ReturnType="Done"
                            ReturnCommand="{Binding RegisterCommand}"
                            SemanticProperties.Description="Confirm password"
                            SemanticProperties.Hint="Re-enter your password, then press done to create your account" />
                    </Border>
                </VerticalStackLayout>

                <Label
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorLabel}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                    SemanticProperties.Description="{Binding ErrorMessage}"
                    SemanticProperties.HeadingLevel="Level3" />

                <Button
                    Text="Create account"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    MinimumHeightRequest="52"
                    SemanticProperties.Description="Create your account" />

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="Creating account, please wait" />

                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,2">
                    <BoxView VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="or" Style="{StaticResource CaptionLabel}" />
                    <BoxView Grid.Column="2" VerticalOptions="Center" />
                </Grid>

                <Button
                    Text="{Binding PlatformRegisterButtonText}"
                    Command="{Binding SignInWithPlatformCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                    BorderColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    BorderWidth="1"
                    MinimumHeightRequest="52"
                    SemanticProperties.Description="{Binding PlatformRegisterButtonText}" />
            </VerticalStackLayout>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="4"
                Margin="0,24,0,0"
                MinimumHeightRequest="44"
                MinimumWidthRequest="44"
                SemanticProperties.Description="Return to login"
                SemanticProperties.Hint="Double tap to go back to the login page">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="Already have an account?" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                <Label Text="Log in" Style="{StaticResource AccentLabel}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
