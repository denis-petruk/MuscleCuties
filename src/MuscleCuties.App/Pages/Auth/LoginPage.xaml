<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Auth.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Auth;assembly=MuscleCuties.Core"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,44,24,32"
            Spacing="0"
            HorizontalOptions="Fill"
            MaximumWidthRequest="520">

            <sharedControls:ThemeAwareBrandLogoImage
                WidthRequest="148"
                HeightRequest="82"
                HorizontalOptions="Center"
                Aspect="AspectFit"
                SemanticProperties.Description="MuscleCuties" />

            <Label Text="Welcome back" Style="{StaticResource Headline}" Margin="0,24,0,8" />
            <Label
                Text="Your plan is ready when you are."
                Style="{StaticResource MutedLabel}"
                Margin="0,0,0,32" />

            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Email" Style="{StaticResource FormFieldLabel}" />
                    <Border Style="{StaticResource InputContainer}">
                        <Entry
                            AutomationId="LoginEmail"
                            Placeholder="name@example.com"
                            Text="{Binding Email}"
                            Keyboard="Email"
                            ReturnType="Next"
                            SemanticProperties.Description="Email address" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Password" Style="{StaticResource FormFieldLabel}" />
                    <Border Style="{StaticResource InputContainer}">
                        <Entry
                            AutomationId="LoginPassword"
                            Placeholder="Password"
                            Text="{Binding Password}"
                            IsPassword="True"
                            ReturnType="Done"
                            ReturnCommand="{Binding LoginCommand}"
                            SemanticProperties.Description="Password" />
                    </Border>
                </VerticalStackLayout>

                <Label
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorLabel}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                <Button
                    Text="Log in"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,2">
                    <BoxView VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="or" Style="{StaticResource CaptionLabel}" />
                    <BoxView Grid.Column="2" VerticalOptions="Center" />
                </Grid>

                <Button
                    Text="{Binding PlatformLoginButtonText}"
                    Command="{Binding SignInWithPlatformCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                    BorderColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    BorderWidth="1" />

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="Signing in" />
            </VerticalStackLayout>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="4"
                Margin="0,24,0,0"
                MinimumHeightRequest="44"
                SemanticProperties.Description="Create an account">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="New to MuscleCuties?" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                <Label Text="Create account" Style="{StaticResource AccentLabel}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
