<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.ViewModels.Auth"
    x:Class="MuscleCuties.App.Pages.Auth.LoginPage"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="28,48,28,32"
            Spacing="0"
            VerticalOptions="Center">

            <Label
                Text="Welcome Back"
                Style="{StaticResource Headline}"
                HorizontalOptions="Center"
                Margin="0,0,0,6" />

            <Label
                Text="Log in to continue your journey"
                Style="{StaticResource MutedLabel}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,32" />

            <Border Style="{StaticResource CardPrimary}" Padding="24">
                <VerticalStackLayout Spacing="14">

                    <Border Style="{StaticResource InputContainer}">
                        <Entry
                            Placeholder="Email"
                            Text="{Binding Email}"
                            Keyboard="Email"
                            ReturnType="Next" />
                    </Border>

                    <Border Style="{StaticResource InputContainer}">
                        <Entry
                            Placeholder="Password"
                            Text="{Binding Password}"
                            IsPassword="True"
                            ReturnType="Done"
                            ReturnCommand="{Binding LoginCommand}" />
                    </Border>

                    <Label
                        Text="{Binding ErrorMessage}"
                        Style="{StaticResource ErrorLabel}"
                        IsVisible="{Binding ErrorMessage,
                                    Converter={StaticResource StringToBoolConverter}}" />

                    <Button
                        Text="Log In"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        Margin="0,6,0,0" />

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

            <Button
                Text="Don't have an account? Sign up"
                Style="{StaticResource ButtonLink}"
                Command="{Binding GoToRegisterCommand}"

                Margin="0,12,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
