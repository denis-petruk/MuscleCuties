<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:quizModels="clr-namespace:MuscleCuties.Core.Models.UI.Quiz;assembly=MuscleCuties.Core"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Quiz;assembly=MuscleCuties.Core"
    x:Class="MuscleCuties.App.Pages.Onboarding.QuizPage"
    x:DataType="vm:QuizViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False">

    <Grid>
        <Grid
            Padding="24"
            IsVisible="{Binding IsPreparingDashboard}"
            ZIndex="10"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
            <VerticalStackLayout
                Spacing="16"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Image
                    Source="{AppThemeBinding Light=musclecuties_logo_light_transparent.png, Dark=musclecuties_logo_dark_transparent.png}"
                    Aspect="AspectFit"
                    WidthRequest="152"
                    HeightRequest="84"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="MuscleCuties logo" />
                <ActivityIndicator
                    Color="{StaticResource Primary}"
                    IsRunning="{Binding IsPreparingDashboard}"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="Syncing your data" />
                <Label
                    Text="Syncing your data"
                    Style="{StaticResource MutedLabel}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid
            Padding="24"
            IsVisible="{Binding IsLoadingVisible}">
            <VerticalStackLayout
                Spacing="10"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <ActivityIndicator
                    Color="{StaticResource Primary}"
                    IsRunning="{Binding IsLoadingVisible}"
                    SemanticProperties.Description="Loading questions" />
                <Label
                    Text="Getting questions ready"
                    Style="{StaticResource MutedLabel}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid
            Padding="28"
            IsVisible="{Binding IsEmptyStateVisible}">
            <VerticalStackLayout
                Spacing="12"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Label
                    Text="{Binding QuestionsStateTitle}"
                    Style="{StaticResource SectionTitle}"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="{Binding QuestionsStateMessage}"
                    Style="{StaticResource MutedLabel}"
                    HorizontalTextAlignment="Center" />
                <Button
                    Text="Try again"
                    Command="{Binding RetryLoadQuestionsCommand}"
                    IsVisible="{Binding CanRetryQuestionsLoad}"
                    Margin="0,8,0,0"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid
            RowDefinitions="Auto,*,Auto"
            IsVisible="{Binding IsLayoutVisible}">

            <VerticalStackLayout
                Grid.Row="0"
                Padding="24,40,24,20"
                Spacing="20"
                MaximumWidthRequest="640"
                HorizontalOptions="Fill">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <ProgressBar
                        Grid.Column="0"
                        Progress="{Binding ProgressValue}"
                        ProgressColor="{StaticResource Primary}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        HeightRequest="5"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        Text="{Binding ProgressText}"
                        Style="{StaticResource AccentLabel}"
                        VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="40,*" ColumnSpacing="12">
                    <Border
                        WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        VerticalOptions="Start">
                        <Image
                            Source="{Binding CurrentQuestionIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                            WidthRequest="20"
                            HeightRequest="20"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <Label
                        Grid.Column="1"
                        Text="{Binding CurrentQuestionText}"
                        Style="{StaticResource SubHeadline}"
                        VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <ScrollView Grid.Row="1" Padding="24,0" MaximumWidthRequest="640" HorizontalOptions="Fill">
                <VerticalStackLayout
                    Padding="0,4,0,20"
                    Spacing="10"
                    BindableLayout.ItemsSource="{Binding CurrentAnswers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="quizModels:SelectableQuizAnswer">
                            <Border
                                Padding="16,14"
                                StrokeShape="RoundRectangle 14"
                                Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                                StrokeThickness="1"
                                MinimumHeightRequest="64"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                SemanticProperties.Description="{Binding Answer.Text}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAnswerTapped" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger
                                        TargetType="Border"
                                        Binding="{Binding IsSelected}"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Grid ColumnDefinitions="36,*,24" ColumnSpacing="12">
                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                        VerticalOptions="Center">
                                        <Image
                                            Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            Aspect="AspectFit"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Answer.Text}"
                                        Style="{StaticResource AccentLabel}"
                                        VerticalOptions="Center" />

                                    <Border
                                        Grid.Column="2"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        StrokeShape="RoundRectangle 11"
                                        VerticalOptions="Center">
                                        <Border.Triggers>
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding IsSelected}"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding IsSelected}"
                                                Value="False">
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <BoxView
                                            WidthRequest="8"
                                            HeightRequest="8"
                                            CornerRadius="4"
                                            Color="{StaticResource White}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsSelected}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <Grid
                Grid.Row="2"
                Padding="24,16,24,32"
                MaximumWidthRequest="640"
                HorizontalOptions="Fill"
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12">

                <Label
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorLabel}"
                    IsVisible="{Binding HasError}"
                    Margin="0,0,0,10" />

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1"
                    IsVisible="{Binding IsFirstQuestion, Converter={StaticResource InvertedBoolConverter}}"
                    WidthRequest="56"
                    HeightRequest="56"
                    Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Image
                        Source="{Binding Source='ChevronLeft24', Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                        WidthRequest="20"
                        HeightRequest="20"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding NextButtonText}"
                    Clicked="OnNextClicked"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    MinimumHeightRequest="56" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
