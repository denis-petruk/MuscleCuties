<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:quizModels="clr-namespace:MuscleCuties.Core.Models.UI.Quiz;assembly=MuscleCuties.Core"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Quiz;assembly=MuscleCuties.Core"
    x:Class="MuscleCuties.App.Pages.Onboarding.QuizPage"
    x:DataType="vm:QuizViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Dashboard prep overlay -->
        <Grid
            Padding="24"
            IsVisible="{Binding IsPreparingDashboard}"
            ZIndex="10"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
            <VerticalStackLayout
                Spacing="16"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Image
                    Source="{AppThemeBinding Light=musclecuties_logo_light_transparent.png, Dark=musclecuties_logo_dark_transparent.png}"
                    Aspect="AspectFit"
                    WidthRequest="152"
                    HeightRequest="84"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="MuscleCuties logo" />
                <ActivityIndicator
                    Color="{StaticResource Primary}"
                    IsRunning="{Binding IsPreparingDashboard}"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="Syncing your data" />
                <Label
                    Text="Syncing your data..."
                    Style="{StaticResource MutedLabel}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Loading state -->
        <Grid
            Padding="24"
            IsVisible="{Binding IsLoadingVisible}">
            <VerticalStackLayout
                Spacing="10"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <ActivityIndicator
                    Color="{StaticResource Primary}"
                    IsRunning="{Binding IsLoadingVisible}"
                    SemanticProperties.Description="Loading questions" />
                <Label
                    Text="Getting questions ready..."
                    Style="{StaticResource MutedLabel}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Empty / error state -->
        <Grid
            Padding="28"
            IsVisible="{Binding IsEmptyStateVisible}">
            <VerticalStackLayout
                Spacing="12"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="400">
                <Label
                    Text="{Binding QuestionsStateTitle}"
                    Style="{StaticResource SectionTitle}"
                    HorizontalTextAlignment="Center"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Text="{Binding QuestionsStateMessage}"
                    Style="{StaticResource MutedLabel}"
                    HorizontalTextAlignment="Center"
                    SemanticProperties.Description="{Binding QuestionsStateMessage}" />
                <Button
                    Text="Try again"
                    Command="{Binding RetryLoadQuestionsCommand}"
                    IsVisible="{Binding CanRetryQuestionsLoad}"
                    Margin="0,8,0,0"
                    HorizontalOptions="Center"
                    MinimumHeightRequest="52"
                    MinimumWidthRequest="120"
                    SemanticProperties.Description="Retry loading questions"
                    SemanticProperties.Hint="Double tap to reload the quiz questions" />
            </VerticalStackLayout>
        </Grid>

        <!-- Main quiz layout -->
        <Grid
            RowDefinitions="Auto,*,Auto"
            IsVisible="{Binding IsLayoutVisible}">

            <VerticalStackLayout
                Grid.Row="0"
                Padding="24,32,24,16"
                Spacing="16"
                MaximumWidthRequest="640"
                HorizontalOptions="Fill">

                <!-- Step indicator + progress bar -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Step 2 of 2"
                        Style="{StaticResource EyebrowLabel}"
                        SemanticProperties.Description="Step 2 of 2: Personalized questions" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <ProgressBar
                            Grid.Column="0"
                            Progress="{Binding ProgressValue}"
                            ProgressColor="{StaticResource Primary}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                            HeightRequest="6"
                            VerticalOptions="Center"
                            SemanticProperties.Description="{Binding ProgressText, StringFormat='Quiz progress: {0}'}" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding ProgressText}"
                            Style="{StaticResource AccentLabel}"
                            VerticalOptions="Center"
                            SemanticProperties.Description="{Binding ProgressText, StringFormat='Question {0}'}" />
                    </Grid>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="40,*" ColumnSpacing="12">
                    <Border
                        WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        VerticalOptions="Start">
                        <Image
                            Source="{Binding CurrentQuestionIconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                            WidthRequest="20"
                            HeightRequest="20"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <Label
                        Grid.Column="1"
                        Text="{Binding CurrentQuestionText}"
                        Style="{StaticResource SubHeadline}"
                        VerticalOptions="Center"
                        SemanticProperties.HeadingLevel="Level1" />
                </Grid>
            </VerticalStackLayout>

            <!-- Standard answer list -->
            <ScrollView
                Grid.Row="1"
                Padding="24,0"
                MaximumWidthRequest="640"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsStandardAnswerListVisible}">
                <VerticalStackLayout
                    Padding="0,4,0,20"
                    Spacing="10"
                    BindableLayout.ItemsSource="{Binding CurrentAnswers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="quizModels:SelectableQuizAnswer">
                            <Border
                                Padding="16,14"
                                StrokeShape="RoundRectangle 14"
                                Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                                StrokeThickness="1"
                                MinimumHeightRequest="64"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                SemanticProperties.Description="{Binding Answer.Text}"
                                SemanticProperties.Hint="Double tap to select this answer">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAnswerTapped" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger
                                        TargetType="Border"
                                        Binding="{Binding IsSelected}"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Grid ColumnDefinitions="36,*,24" ColumnSpacing="12">
                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurface}, Dark={StaticResource Gray900}}"
                                        VerticalOptions="Center">
                                        <Image
                                            Source="{Binding IconGlyph, Converter={StaticResource StringToFluentIconImageSourceConverter}}"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            Aspect="AspectFit"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Answer.Text}"
                                        Style="{StaticResource AccentLabel}"
                                        VerticalOptions="Center" />

                                    <Border
                                        Grid.Column="2"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        StrokeShape="RoundRectangle 11"
                                        VerticalOptions="Center">
                                        <Border.Triggers>
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding IsSelected}"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding IsSelected}"
                                                Value="False">
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <BoxView
                                            WidthRequest="8"
                                            HeightRequest="8"
                                            CornerRadius="4"
                                            Color="{StaticResource White}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsSelected}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Phase pair sliders -->
            <ScrollView
                Grid.Row="1"
                Padding="24,4,24,20"
                MaximumWidthRequest="640"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsCurrentQuestionPhasePair}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label
                            Text="Discomfort"
                            Style="{StaticResource CardTitle}"
                            SemanticProperties.HeadingLevel="Level2" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding PainSliderLabel}"
                            Style="{StaticResource AccentLabel}" />
                    </Grid>
                    <Slider
                        Grid.Row="1"
                        Minimum="1"
                        Maximum="5"
                        Value="{Binding PainSliderValue, Mode=TwoWay}"
                        MinimumTrackColor="{StaticResource Primary}"
                        MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        ThumbColor="{StaticResource Primary}"
                        MinimumHeightRequest="44"
                        SemanticProperties.Description="{Binding PainSliderLabel, StringFormat='Discomfort level: {0}'}"
                        SemanticProperties.Hint="1 is severe, 5 is none. Drag to set your usual discomfort." />
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                        <Label Text="Severe" Style="{StaticResource CaptionLabel}" FontSize="13" />
                        <Label Grid.Column="2" Text="None" Style="{StaticResource CaptionLabel}" FontSize="13" HorizontalTextAlignment="End" />
                    </Grid>

                    <BoxView
                        Grid.Row="3"
                        HeightRequest="1"
                        Margin="0,12,0,0"
                        Color="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}" />

                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label
                            Text="Training energy"
                            Style="{StaticResource CardTitle}"
                            SemanticProperties.HeadingLevel="Level2" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding EnergySliderLabel}"
                            Style="{StaticResource AccentLabel}" />
                    </Grid>
                    <Slider
                        Grid.Row="5"
                        Minimum="1"
                        Maximum="5"
                        Value="{Binding EnergySliderValue, Mode=TwoWay}"
                        MinimumTrackColor="{StaticResource Primary}"
                        MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        ThumbColor="{StaticResource Primary}"
                        MinimumHeightRequest="44"
                        SemanticProperties.Description="{Binding EnergySliderLabel, StringFormat='Training energy level: {0}'}"
                        SemanticProperties.Hint="1 is very low, 5 is peak. Drag to set your usual energy." />
                    <Grid Grid.Row="6" ColumnDefinitions="Auto,*,Auto">
                        <Label Text="Very low" Style="{StaticResource CaptionLabel}" FontSize="13" />
                        <Label Grid.Column="2" Text="Peak" Style="{StaticResource CaptionLabel}" FontSize="13" HorizontalTextAlignment="End" />
                    </Grid>
                </Grid>
            </ScrollView>

            <!-- Bottom navigation bar -->
            <Grid
                Grid.Row="2"
                Padding="24,16,24,32"
                MaximumWidthRequest="640"
                HorizontalOptions="Fill"
                RowDefinitions="Auto,Auto,Auto"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12">

                <Label
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorLabel}"
                    IsVisible="{Binding HasError}"
                    Margin="0,0,0,10"
                    SemanticProperties.Description="{Binding ErrorMessage}"
                    SemanticProperties.HeadingLevel="Level3" />

                <ActivityIndicator
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    HorizontalOptions="Center"
                    Margin="0,0,0,10"
                    SemanticProperties.Description="Processing, please wait" />

                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1"
                    IsVisible="{Binding IsFirstQuestion, Converter={StaticResource InvertedBoolConverter}}"
                    WidthRequest="56"
                    HeightRequest="56"
                    MinimumWidthRequest="44"
                    MinimumHeightRequest="44"
                    Padding="0"
                    SemanticProperties.Description="Go to previous question"
                    SemanticProperties.Hint="Double tap to go back">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Path
                        Data="M15 19l-7-7 7-7"
                        Stroke="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        StrokeThickness="2"
                        StrokeLineCap="Round"
                        StrokeLineJoin="Round"
                        WidthRequest="20"
                        HeightRequest="20"
                        Aspect="Uniform"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Button
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding NextButtonText}"
                    Clicked="OnNextClicked"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    MinimumHeightRequest="56"
                    SemanticProperties.Description="{Binding NextButtonText}"
                    SemanticProperties.Hint="Double tap to advance to the next question or finish the quiz" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
