<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="QuizPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:quizModels="clr-namespace:MuscleCuties.Core.Models.UI.Quiz;assembly=MuscleCuties.Core"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Quiz;assembly=MuscleCuties.Core"
    x:Class="MuscleCuties.App.Pages.Onboarding.QuizPage"
    x:DataType="vm:QuizViewModel"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ── Row 0 · Progress + Question header ──────────────────── -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="28,56,28,20"
            Spacing="16">

            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <ProgressBar
                    Grid.Column="0"
                    Progress="{Binding ProgressValue}"
                    ProgressColor="{StaticResource Primary}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                    HeightRequest="6"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="{Binding ProgressText}"
                    Style="{StaticResource AccentLabel}"
                    VerticalOptions="Center" />
            </Grid>

            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Padding="12,4"
                HorizontalOptions="Start"
                IsVisible="{Binding HasQuestion}">
                <Label
                    Text="Onboarding Quiz"
                    Style="{StaticResource EyebrowLabel}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                Dark={StaticResource TextPrimaryDark}}" />
            </Border>

            <Label
                Text="{Binding CurrentQuestionText}"
                Style="{StaticResource SubHeadline}"
                IsVisible="{Binding HasQuestion}" />

        </VerticalStackLayout>

        <!-- ── Row 1 · Answers / States ─────────────────────────────── -->
        <Grid Grid.Row="1" Padding="28,0">

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <VerticalStackLayout
                IsVisible="{Binding HasNoQuestions}"
                Spacing="8"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Label
                    Text="No questions available yet"
                    Style="{StaticResource SectionTitle}"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="We are working on a better quiz experience."
                    Style="{StaticResource MutedLabel}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <ScrollView IsVisible="{Binding HasQuestion}">
                <VerticalStackLayout
                    Spacing="12"
                    BindableLayout.ItemsSource="{Binding CurrentAnswers}">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="quizModels:SelectableQuizAnswer">

                            <Border
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0"
                                Padding="20,16"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface},
                                                                  Dark={StaticResource CardSurfaceDark}}">

                                <Border.Shadow>
                                    <Shadow Brush="#2B1D24" Offset="0,3" Radius="12" Opacity="0.07" />
                                </Border.Shadow>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference QuizPageRoot}, Path=BindingContext.SelectAnswerCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Border.Triggers>
                                    <DataTrigger
                                        TargetType="Border"
                                        Binding="{Binding IsSelected}"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">

                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding Answer.Text}"
                                        Style="{StaticResource AccentLabel}"
                                        VerticalOptions="Center" />

                                    <Border
                                        Grid.Column="1"
                                        WidthRequest="26"
                                        HeightRequest="26"
                                        StrokeShape="RoundRectangle 13"
                                        VerticalOptions="Center">

                                        <Border.Triggers>
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding IsSelected}"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding IsSelected}"
                                                Value="False">
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Label
                                            Text="✓"
                                            Style="{StaticResource CaptionLabel}"
                                            TextColor="{StaticResource White}"
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsSelected}" />
                                    </Border>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

        </Grid>

        <!-- ── Row 2 · Back + Next actions ──────────────────────────── -->
        <Grid
            Grid.Row="2"
            RowDefinitions="Auto, Auto"
            ColumnDefinitions="Auto, *"
            ColumnSpacing="12"
            Padding="28,16,28,48"
            IsVisible="{Binding HasQuestion}">

            <Label
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Text="{Binding ErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                IsVisible="{Binding HasError}"
                Margin="0,0,0,10" />

            <Border
                Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource CardSecondary}"
                IsVisible="{Binding IsFirstQuestion, Converter={StaticResource InvertedBoolConverter}}"
                WidthRequest="56"
                HeightRequest="56"
                Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Border.GestureRecognizers>
                <Label
                    Text="←"
                    Style="{StaticResource AccentLabel}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Button
                Grid.Row="1"
                Grid.Column="1"
                Text="{Binding NextButtonText}"
                Command="{Binding NextCommand}"
                HeightRequest="56"
                CornerRadius="18" />

        </Grid>

    </Grid>
</ContentPage>
