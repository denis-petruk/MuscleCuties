<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:workoutControls="clr-namespace:MuscleCuties.App.Controls.Workout"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    x:Class="MuscleCuties.App.Pages.Onboarding.ProfileSetupPage"
    x:DataType="vm:ProfileSetupViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,24,24,36"
            Spacing="20"
            HorizontalOptions="Fill"
            MaximumWidthRequest="640">

            <!-- Step indicator -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label
                    Text="Step 1 of 2"
                    Style="{StaticResource EyebrowLabel}"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Step 1 of 2: Profile setup" />
                <sharedControls:ThemeAwareBrandLogoImage
                    Grid.Column="1"
                    WidthRequest="80"
                    HeightRequest="44"
                    Aspect="AspectFit"
                    SemanticProperties.Description="MuscleCuties logo" />
            </Grid>

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Tell us about yourself"
                    Style="{StaticResource Headline}"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Text="This shapes your first training and nutrition plan."
                    Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <Border
                    WidthRequest="80"
                    HeightRequest="80"
                    StrokeShape="RoundRectangle 40"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                    Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                    StrokeThickness="1"
                    SemanticProperties.Description="Profile photo, optional. Double tap to change.">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileImageTapped" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Image Source="{Binding ProfileImageSource}" IsVisible="{Binding HasProfileImage}" Aspect="AspectFill" />
                        <Image
                            IsVisible="{Binding HasNoProfileImage}"
                            Source="{AppThemeBinding Light=musclecuties_logo_light_transparent.png, Dark=musclecuties_logo_dark_transparent.png}"
                            Aspect="AspectFit"
                            Margin="8" />
                    </Grid>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Profile photo" Style="{StaticResource CardTitle}" />
                        <Label Text="(optional)" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button
                        Text="Choose from Photos"
                        Style="{StaticResource ButtonLink}"
                        Padding="0"
                        HorizontalOptions="Start"
                        MinimumHeightRequest="44"
                        MinimumWidthRequest="44"
                        Clicked="OnProfileImageButtonClicked"
                        SemanticProperties.Description="Choose a profile photo from Photos, optional" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="12">
                <Label
                    Text="Personal details"
                    Style="{StaticResource SectionTitle}"
                    SemanticProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource FormSection}">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="Display name" Style="{StaticResource FormFieldLabel}" />
                                <Label Text="(optional)" Style="{StaticResource CaptionLabel}" />
                            </HorizontalStackLayout>
                            <Border Style="{StaticResource InputContainer}">
                                <Entry
                                    AutomationId="ProfileSetupNameEntry"
                                    Placeholder="Your name"
                                    Text="{Binding Name}"
                                    MaxLength="50"
                                    ReturnType="Done"
                                    SemanticProperties.Description="Display name, optional"
                                    SemanticProperties.Hint="This field is optional. Enter a display name if you like." />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Birthday" Style="{StaticResource FormFieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <DatePicker
                                    AutomationId="ProfileSetupBirthDatePicker"
                                    Date="{Binding BirthDate}"
                                    MinimumDate="{Binding MinBirthDate}"
                                    MaximumDate="{Binding MaxBirthDate}"
                                    Format="MMMM dd, yyyy"
                                    SemanticProperties.Description="Birthday"
                                    SemanticProperties.Hint="Select your date of birth" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Units" Style="{StaticResource FormFieldLabel}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Border
                                    Padding="12"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    MinimumHeightRequest="48"
                                    SemanticProperties.Description="Imperial units"
                                    SemanticProperties.Hint="Double tap to select imperial units (feet, pounds)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectImperialUnitsCommand}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding UseImperialSystem}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding UseImperialSystem}" Value="False">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="Imperial" Style="{StaticResource BodyLabel}" FontAttributes="Bold" HorizontalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding UseImperialSystem}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="12"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    MinimumHeightRequest="48"
                                    SemanticProperties.Description="Metric units"
                                    SemanticProperties.Hint="Double tap to select metric units (centimeters, kilograms)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectMetricUnitsCommand}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding UseMetricSystem}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding UseMetricSystem}" Value="False">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="Metric" Style="{StaticResource BodyLabel}" FontAttributes="Bold" HorizontalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding UseMetricSystem}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6" IsVisible="{Binding UseMetricSystem}">
                            <Label Text="Height" Style="{StaticResource FormFieldLabel}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Border Style="{StaticResource InputContainer}">
                                    <Picker
                                        AutomationId="ProfileSetupMetricHeightPicker"
                                        Title="Select height"
                                        ItemsSource="{Binding MetricHeightOptions}"
                                        SelectedItem="{Binding SelectedHeightCm}"
                                        SemanticProperties.Description="Height in centimeters" />
                                </Border>
                                <Label Grid.Column="1" Text="cm" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6" IsVisible="{Binding UseMetricSystem, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="Height" Style="{StaticResource FormFieldLabel}" />
                            <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8">
                                <Border Style="{StaticResource InputContainer}">
                                    <Picker
                                        AutomationId="ProfileSetupFeetPicker"
                                        Title="Feet"
                                        ItemsSource="{Binding FeetOptions}"
                                        SelectedItem="{Binding SelectedFeet}"
                                        SemanticProperties.Description="Height in feet" />
                                </Border>
                                <Label Grid.Column="1" Text="ft" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                <Border Grid.Column="2" Style="{StaticResource InputContainer}">
                                    <Picker
                                        AutomationId="ProfileSetupInchesPicker"
                                        Title="Inches"
                                        ItemsSource="{Binding InchesOptions}"
                                        SelectedItem="{Binding SelectedInches}"
                                        SemanticProperties.Description="Height in inches" />
                                </Border>
                                <Label Grid.Column="3" Text="in" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Weight" Style="{StaticResource FormFieldLabel}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Border Style="{StaticResource InputContainer}" IsVisible="{Binding UseMetricSystem}">
                                    <Picker
                                        AutomationId="ProfileSetupMetricWeightPicker"
                                        Title="Select weight"
                                        ItemsSource="{Binding MetricWeightOptions}"
                                        SelectedItem="{Binding SelectedWeightKg}"
                                        SemanticProperties.Description="Weight in kilograms" />
                                </Border>
                                <Border Style="{StaticResource InputContainer}" IsVisible="{Binding UseMetricSystem, Converter={StaticResource InvertedBoolConverter}}">
                                    <Picker
                                        AutomationId="ProfileSetupImperialWeightPicker"
                                        Title="Select weight"
                                        ItemsSource="{Binding ImperialWeightOptions}"
                                        SelectedItem="{Binding SelectedWeightLbs}"
                                        SemanticProperties.Description="Weight in pounds" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding WeightUnit}" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- TODO(health-sync): Re-enable Apple Health and Whoop during the native-provider pass. -->

            <VerticalStackLayout Spacing="12">
                <Label
                    Text="Choose your activity"
                    Style="{StaticResource SectionTitle}"
                    SemanticProperties.HeadingLevel="Level2" />
                <Label
                    Text="Pick at least one strength activity."
                    Style="{StaticResource CaptionLabel}"
                    Margin="0,-6,0,0" />
                <workoutControls:WorkoutActivityPreferencePicker
                    ActivityGroups="{Binding GroupedWorkoutActivityOptions}"
                    ToggleActivityCommand="{Binding ToggleWorkoutActivityCommand}" />
            </VerticalStackLayout>

            <Label
                Text="{Binding ErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                SemanticProperties.Description="{Binding ErrorMessage}"
                SemanticProperties.HeadingLevel="Level3" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                SemanticProperties.Description="Saving profile, please wait" />

            <Button
                Text="Continue"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                Clicked="OnContinueClicked"
                MinimumHeightRequest="52"
                SemanticProperties.Description="Continue to personalized questions"
                SemanticProperties.Hint="Double tap to save your profile and proceed to step 2" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
