<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:workoutControls="clr-namespace:MuscleCuties.App.Controls.Workout"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    x:Class="MuscleCuties.App.Pages.Onboarding.ProfileSetupPage"
    x:DataType="vm:ProfileSetupViewModel"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout
            Padding="28,48,28,32"
            Spacing="0"
            VerticalOptions="Fill"
            HorizontalOptions="Fill"
            MaximumWidthRequest="640">

            <sharedControls:ThemeAwareBrandLogoImage
                Style="{StaticResource BrandLogoImage}"
                SemanticProperties.Description="MuscleCuties logo"
                Margin="0,0,0,22" />

            <Label
                Text="Tell us about yourself"
                Style="{StaticResource Headline}"
                HorizontalOptions="Center"
                Margin="0,0,0,6" />

            <Label
                Text="Build your first plan"
                Style="{StaticResource MutedLabel}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,32" />

            <Border Style="{StaticResource CardPrimary}" Padding="24">
                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border
                            WidthRequest="72"
                            HeightRequest="72"
                            StrokeShape="RoundRectangle 36"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProfileImageTapped" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Image
                                    Source="{Binding ProfileImageSource}"
                                    IsVisible="{Binding HasProfileImage}"
                                    Aspect="AspectFill"
                                    WidthRequest="72"
                                    HeightRequest="72"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                                <Image
                                    IsVisible="{Binding HasNoProfileImage}"
                                    Source="{AppThemeBinding Light=musclecuties_logo_light_transparent.png, Dark=musclecuties_logo_dark_transparent.png}"
                                    Aspect="AspectFill"
                                    WidthRequest="72"
                                    HeightRequest="72"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="Profile photo" Style="{StaticResource FormFieldLabel}" />
                            <Button
                                Text="Choose photo"
                                Style="{StaticResource ButtonLink}"
                                Padding="0"
                                HorizontalOptions="Start"
                                Clicked="OnProfileImageButtonClicked" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Display name" Style="{StaticResource FormFieldLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry
                                AutomationId="ProfileSetupNameEntry"
                                Placeholder="Your name"
                                Text="{Binding Name}"
                                MaxLength="50"
                                ReturnType="Next" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Birthday" Style="{StaticResource FormFieldLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <DatePicker
                                AutomationId="ProfileSetupBirthDatePicker"
                                Date="{Binding BirthDate}"
                                MinimumDate="{Binding MinBirthDate}"
                                MaximumDate="{Binding MaxBirthDate}"
                                Format="MMMM dd, yyyy" />
                        </Border>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource CardSecondary}" Padding="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Unit system" Style="{StaticResource FormFieldLabel}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Border
                                    Padding="12,10"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource Gray900}}"
                                    Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectImperialUnitsCommand}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding UseImperialSystem}"
                                                     Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label
                                        Text="Imperial"
                                        Style="{StaticResource BodyLabel}"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding UseImperialSystem}"
                                                         Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="12,10"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource Gray900}}"
                                    Stroke="{AppThemeBinding Light={StaticResource InputStroke}, Dark={StaticResource InputStrokeDark}}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectMetricUnitsCommand}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding UseMetricSystem}"
                                                     Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label
                                        Text="Metric"
                                        Style="{StaticResource BodyLabel}"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding UseMetricSystem}"
                                                         Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout
                        Spacing="5"
                        IsVisible="{Binding UseMetricSystem}">
                        <Label Text="Height" Style="{StaticResource FormFieldLabel}" />
                        <Grid
                            ColumnDefinitions="*, Auto"
                            ColumnSpacing="10">
                            <Border Grid.Column="0" Style="{StaticResource InputContainer}">
                                <Picker
                                    AutomationId="ProfileSetupMetricHeightPicker"
                                    Title="Select height"
                                    ItemsSource="{Binding MetricHeightOptions}"
                                    SelectedItem="{Binding SelectedHeightCm}" />
                            </Border>
                            <Label
                                Grid.Column="1"
                                Text="cm"
                                Style="{StaticResource MutedLabel}"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Spacing="5"
                        IsVisible="{Binding UseMetricSystem,
                                   Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="Height" Style="{StaticResource FormFieldLabel}" />
                        <Grid
                            ColumnDefinitions="*, Auto, *, Auto"
                            ColumnSpacing="8">
                            <Border Grid.Column="0" Style="{StaticResource InputContainer}">
                                <Picker
                                    AutomationId="ProfileSetupFeetPicker"
                                    Title="Feet"
                                    ItemsSource="{Binding FeetOptions}"
                                    SelectedItem="{Binding SelectedFeet}" />
                            </Border>
                            <Label
                                Grid.Column="1"
                                Text="ft"
                                Style="{StaticResource MutedLabel}"
                                VerticalOptions="Center" />
                            <Border Grid.Column="2" Style="{StaticResource InputContainer}">
                                <Picker
                                    AutomationId="ProfileSetupInchesPicker"
                                    Title="Inches"
                                    ItemsSource="{Binding InchesOptions}"
                                    SelectedItem="{Binding SelectedInches}" />
                            </Border>
                            <Label
                                Grid.Column="3"
                                Text="in"
                                Style="{StaticResource MutedLabel}"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Weight" Style="{StaticResource FormFieldLabel}" />
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">

                            <Border
                                Grid.Column="0"
                                Style="{StaticResource InputContainer}"
                                IsVisible="{Binding UseMetricSystem}">
                                <Picker
                                    AutomationId="ProfileSetupMetricWeightPicker"
                                    Title="Select weight"
                                    ItemsSource="{Binding MetricWeightOptions}"
                                    SelectedItem="{Binding SelectedWeightKg}" />
                            </Border>

                            <Border
                                Grid.Column="0"
                                Style="{StaticResource InputContainer}"
                                IsVisible="{Binding UseMetricSystem,
                                           Converter={StaticResource InvertedBoolConverter}}">
                                <Picker
                                    AutomationId="ProfileSetupImperialWeightPicker"
                                    Title="Select weight"
                                    ItemsSource="{Binding ImperialWeightOptions}"
                                    SelectedItem="{Binding SelectedWeightLbs}" />
                            </Border>

                            <Label
                                Grid.Column="1"
                                Text="{Binding WeightUnit}"
                                Style="{StaticResource MutedLabel}"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Primary fitness goal" Style="{StaticResource FormFieldLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Picker
                                AutomationId="ProfileSetupGoalPicker"
                                Title="Choose goal"
                                ItemsSource="{Binding GoalOptions}"
                                ItemDisplayBinding="{Binding Label}"
                                SelectedItem="{Binding SelectedGoalOption}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- TODO(health-sync): Re-enable Apple Health and Whoop during the native-provider pass. -->

                    <Border Style="{StaticResource CardSecondary}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <sharedControls:IconSectionHeader
                                Text="ACTIVITY PREFERENCES"
                                IconGlyph="Dumbbell24" />
                            <workoutControls:WorkoutActivityPreferencePicker
                                ActivityGroups="{Binding GroupedWorkoutActivityOptions}"
                                ToggleActivityCommand="{Binding ToggleWorkoutActivityCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Style="{StaticResource CardSecondary}"
                        Padding="14"
                        IsVisible="{Binding IsStrengthStyleVisible}">
                        <VerticalStackLayout Spacing="10">
                            <sharedControls:IconSectionHeader
                                Text="STRENGTH STYLE"
                                IconGlyph="Flash24" />
                            <workoutControls:StrengthTrainingStylePicker
                                SelectStyleCommand="{Binding SelectStrengthTrainingStyleCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label
                        Text="{Binding ErrorMessage}"
                        Style="{StaticResource ErrorLabel}"
                        IsVisible="{Binding ErrorMessage,
                                   Converter={StaticResource StringToBoolConverter}}" />

                    <Button
                        Text="Continue"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        Clicked="OnContinueClicked"
                        Margin="0,6,0,0" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
