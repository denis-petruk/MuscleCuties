<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:workoutControls="clr-namespace:MuscleCuties.App.Controls.Workout"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Profile;assembly=MuscleCuties.Core"
    x:Class="MuscleCuties.App.Pages.Onboarding.ProfileSetupPage"
    x:DataType="vm:ProfileSetupViewModel"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout
            Padding="28,48,28,32"
            Spacing="0"
            VerticalOptions="Fill">

            <sharedControls:ThemeAwareBrandLogoImage
                Style="{StaticResource BrandLogoImage}"
                SemanticProperties.Description="MuscleCuties logo"
                Margin="0,0,0,22" />

            <Label
                Text="Tell us about yourself"
                Style="{StaticResource Headline}"
                HorizontalOptions="Center"
                Margin="0,0,0,6" />

            <Label
                Text="This helps us personalize your plan"
                Style="{StaticResource MutedLabel}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,32" />

            <Border Style="{StaticResource CardPrimary}" Padding="24">
                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border
                            WidthRequest="72"
                            HeightRequest="72"
                            StrokeShape="RoundRectangle 36"
                            BackgroundColor="{StaticResource AccentSurface}"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProfileImageTapped" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Image
                                    Source="{Binding ProfileImageSource}"
                                    IsVisible="{Binding HasProfileImage}"
                                    Aspect="AspectFill"
                                    WidthRequest="72"
                                    HeightRequest="72"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                                <sharedControls:ThemeAwareBrandLogoImage
                                    IsVisible="{Binding HasNoProfileImage}"
                                    WidthRequest="58"
                                    HeightRequest="40"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="Profile photo" Style="{StaticResource FormFieldLabel}" />
                            <Label Text="Optional. Used on your profile and personal dashboard." Style="{StaticResource FormFieldHint}" />
                            <Button
                                Text="Choose photo"
                                Style="{StaticResource ButtonLink}"
                                Padding="0"
                                HorizontalOptions="Start"
                                Clicked="OnProfileImageButtonClicked" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Display name" Style="{StaticResource FormFieldLabel}" />
                        <Label Text="Used for greetings and your profile." Style="{StaticResource FormFieldHint}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry
                                Placeholder="Your name"
                                Text="{Binding Name}"
                                MaxLength="50"
                                ReturnType="Next" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Birthday" Style="{StaticResource FormFieldLabel}" />
                        <Label Text="Helps personalize age-based plan estimates." Style="{StaticResource FormFieldHint}" />
                        <Border Style="{StaticResource InputContainer}">
                            <DatePicker
                                Date="{Binding BirthDate}"
                                MinimumDate="{Binding MinBirthDate}"
                                MaximumDate="{Binding MaxBirthDate}"
                                Format="MMMM dd, yyyy" />
                        </Border>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource CardSecondary}" Padding="12,10">
                        <VerticalStackLayout Spacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Unit system" Style="{StaticResource FormFieldLabel}" />
                                <Label Text="Sets whether the app starts with kg and cm or lb and inches." Style="{StaticResource FormFieldHint}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                                <Label
                                    Text="Imperial"
                                    Style="{StaticResource BodyLabel}"
                                    VerticalOptions="Center" />
                                <Switch
                                    IsToggled="{Binding UseMetricSystem}"
                                    OnColor="{StaticResource Primary}"
                                    ThumbColor="{AppThemeBinding Light={StaticResource White},
                                                                 Dark={StaticResource Gray200}}" />
                                <Label
                                    Text="Metric"
                                    Style="{StaticResource BodyLabel}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout
                        Spacing="5"
                        IsVisible="{Binding UseMetricSystem}">
                        <Label Text="Height" Style="{StaticResource FormFieldLabel}" />
                        <Label Text="Your current height, used for plan estimates." Style="{StaticResource FormFieldHint}" />
                        <Grid
                            ColumnDefinitions="*, Auto"
                            ColumnSpacing="10">
                            <Border Grid.Column="0" Style="{StaticResource InputContainer}">
                                <Picker
                                    Title="Select height"
                                    ItemsSource="{Binding MetricHeightOptions}"
                                    SelectedItem="{Binding SelectedHeightCm}" />
                            </Border>
                            <Label
                                Grid.Column="1"
                                Text="cm"
                                Style="{StaticResource MutedLabel}"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Spacing="5"
                        IsVisible="{Binding UseMetricSystem,
                                   Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="Height" Style="{StaticResource FormFieldLabel}" />
                        <Label Text="Feet and inches for your current height." Style="{StaticResource FormFieldHint}" />
                        <Grid
                            ColumnDefinitions="*, Auto, *, Auto"
                            ColumnSpacing="8">
                            <Border Grid.Column="0" Style="{StaticResource InputContainer}">
                                <Picker
                                    Title="Feet"
                                    ItemsSource="{Binding FeetOptions}"
                                    SelectedItem="{Binding SelectedFeet}" />
                            </Border>
                            <Label
                                Grid.Column="1"
                                Text="ft"
                                Style="{StaticResource MutedLabel}"
                                VerticalOptions="Center" />
                            <Border Grid.Column="2" Style="{StaticResource InputContainer}">
                                <Picker
                                    Title="Inches"
                                    ItemsSource="{Binding InchesOptions}"
                                    SelectedItem="{Binding SelectedInches}" />
                            </Border>
                            <Label
                                Grid.Column="3"
                                Text="in"
                                Style="{StaticResource MutedLabel}"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Weight" Style="{StaticResource FormFieldLabel}" />
                        <Label Text="Your current body weight for nutrition and workout planning." Style="{StaticResource FormFieldHint}" />
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">

                            <Border
                                Grid.Column="0"
                                Style="{StaticResource InputContainer}"
                                IsVisible="{Binding UseMetricSystem}">
                                <Picker
                                    Title="Select weight"
                                    ItemsSource="{Binding MetricWeightOptions}"
                                    SelectedItem="{Binding SelectedWeightKg}" />
                            </Border>

                            <Border
                                Grid.Column="0"
                                Style="{StaticResource InputContainer}"
                                IsVisible="{Binding UseMetricSystem,
                                           Converter={StaticResource InvertedBoolConverter}}">
                                <Picker
                                    Title="Select weight"
                                    ItemsSource="{Binding ImperialWeightOptions}"
                                    SelectedItem="{Binding SelectedWeightLbs}" />
                            </Border>

                            <Label
                                Grid.Column="1"
                                Text="{Binding WeightUnit}"
                                Style="{StaticResource MutedLabel}"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Primary fitness goal" Style="{StaticResource FormFieldLabel}" />
                        <Label Text="Sets the direction for calories, workouts, and progress targets." Style="{StaticResource FormFieldHint}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Picker
                                Title="Choose goal"
                                ItemsSource="{Binding GoalOptions}"
                                ItemDisplayBinding="{Binding Label}"
                                SelectedItem="{Binding SelectedGoalOption}" />
                        </Border>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource CardSecondary}" Padding="14">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="HEALTH SYNC" Style="{StaticResource EyebrowLabel}" />
                                    <Label Text="Optional weekly steps and sleep for smarter calories, readiness, and recovery." Style="{StaticResource FormFieldHint}" />
                                </VerticalStackLayout>
                                <Border
                                    Grid.Column="1"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource Gray900}}"
                                    Padding="10,6"
                                    VerticalOptions="Start">
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                        <BoxView
                                            WidthRequest="7"
                                            HeightRequest="7"
                                            CornerRadius="3.5"
                                            BackgroundColor="{StaticResource Primary}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="Status"
                                            Style="{StaticResource CaptionLabel}"
                                            FontSize="11" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource Gray900}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="12,10">
                                <Label Text="{Binding HealthSyncStatusText}" Style="{StaticResource CardTitle}" FontSize="14" />
                            </Border>

                            <VerticalStackLayout Spacing="8">
                                <Border
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                    Padding="12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ConnectAppleHealthCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                                        <Border
                                            WidthRequest="38"
                                            HeightRequest="38"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{StaticResource White}">
                                            <Image Source="health_apple.png" Aspect="AspectFit" Margin="4" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="Apple Health" Style="{StaticResource CardTitle}" />
                                            <Label Text="Steps and sleep from iPhone." Style="{StaticResource CaptionLabel}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="›" FontSize="22" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <Border
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                    Padding="12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ConnectWhoopCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                                            <Image Source="health_whoop.png" Aspect="AspectFit" Margin="1" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="Whoop" Style="{StaticResource CardTitle}" />
                                            <Label Text="Direct recovery and sleep sync." Style="{StaticResource CaptionLabel}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="›" FontSize="22" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <Label
                                Text="{Binding HealthSyncMessage}"
                                Style="{StaticResource CaptionLabel}"
                                IsVisible="{Binding HealthSyncMessage, Converter={StaticResource StringToBoolConverter}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardSecondary}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                Text="WORKOUT PREFERENCES"
                                Style="{StaticResource EyebrowLabel}" />
                            <Label
                                Text="Pick the activities you want plans to include later."
                                Style="{StaticResource FormFieldHint}" />
                            <workoutControls:WorkoutActivityPreferencePicker />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Style="{StaticResource CardSecondary}"
                        Padding="14"
                        IsVisible="{Binding IsStrengthStyleVisible}">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                Text="STRENGTH STYLE"
                                Style="{StaticResource EyebrowLabel}" />
                            <Label
                                Text="Choose the version of strength training your plan should prefer when your phase is ready for it."
                                Style="{StaticResource FormFieldHint}" />
                            <workoutControls:StrengthTrainingStylePicker />
                        </VerticalStackLayout>
                    </Border>

                    <Label
                        Text="{Binding ErrorMessage}"
                        Style="{StaticResource ErrorLabel}"
                        IsVisible="{Binding ErrorMessage,
                                   Converter={StaticResource StringToBoolConverter}}" />

                    <Button
                        Text="Continue"
                        Command="{Binding ContinueCommand}"
                        Margin="0,6,0,0" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
