<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MuscleCuties.App.Pages.Workout.WorkoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels;assembly=MuscleCuties.Core"
    x:DataType="vm:WorkoutViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20,56,20,32" Spacing="14">

                <!-- ── Header ──────────────────────────────────────────── -->
                <VerticalStackLayout Spacing="2">
                    <Label
                        Text="{Binding CurrentPhaseName, StringFormat='{0} plan'}"
                        Style="{StaticResource EyebrowLabel}"
                        CharacterSpacing="1.2" />
                    <Label
                        Text="{Binding WeekTitle}"
                        Style="{StaticResource SubHeadline}" />
                </VerticalStackLayout>

                <!-- ══ TODAY CARD ══════════════════════════════════════════ -->

                <!-- ── Active workout day ─────────────────────────────── -->
                <Border
                    Style="{StaticResource CardPrimary}"
                    IsVisible="{Binding IsActiveDay}">
                    <VerticalStackLayout Spacing="12">

                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label
                                Text="TODAY"
                                Style="{StaticResource EyebrowLabel}"
                                CharacterSpacing="1.2"
                                Opacity="0.6" />
                            <Border
                                StrokeShape="RoundRectangle 999"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource Primary}"
                                Padding="10,4">
                                <Label
                                    Text="{Binding TodayIntensity}"
                                    TextColor="{StaticResource White}"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    CharacterSpacing="0.8" />
                            </Border>
                        </HorizontalStackLayout>

                        <Label
                            Text="{Binding TodayTitle}"
                            Style="{StaticResource SectionTitle}"
                            FontSize="22" />
                        <Label
                            Text="{Binding TodayBodyCopy}"
                            Style="{StaticResource MutedLabel}"
                            FontSize="13" />

                        <!-- Exercise list -->
                        <CollectionView
                            ItemsSource="{Binding TodaysExercises}"
                            Margin="0,4,0,0">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExerciseDetailItem">
                                    <Grid
                                        ColumnDefinitions="*, Auto"
                                        Padding="0,8,0,8">
                                        <BoxView
                                            Grid.ColumnSpan="2"
                                            HeightRequest="1"
                                            VerticalOptions="End"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                Text="{Binding Name}"
                                                FontSize="15"
                                                FontAttributes="Bold" />
                                            <Label
                                                Text="{Binding MuscleGroup}"
                                                Style="{StaticResource CaptionLabel}"
                                                FontSize="12" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding SetRepText}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Primary}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Start + Swap -->
                        <Grid ColumnDefinitions="*, 12, Auto" Margin="0,4,0,0">
                            <Button
                                Grid.Column="0"
                                Text="Start Workout"
                                Command="{Binding StartWorkoutCommand}" />
                            <Button
                                Grid.Column="2"
                                Text="Swap"
                                Command="{Binding ShowSwapCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                WidthRequest="80" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Active recovery day ─────────────────────────────── -->
                <Border
                    Style="{StaticResource CardPrimary}"
                    IsVisible="{Binding IsActiveRecovery}">
                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="TODAY · ACTIVE RECOVERY"
                            Style="{StaticResource EyebrowLabel}"
                            CharacterSpacing="1.2"
                            Opacity="0.6" />
                        <Label
                            Text="{Binding TodayTitle}"
                            Style="{StaticResource SectionTitle}"
                            FontSize="22" />
                        <Label
                            Text="{Binding TodayBodyCopy}"
                            Style="{StaticResource MutedLabel}"
                            FontSize="13" />

                        <CollectionView ItemsSource="{Binding TodaysExercises}" Margin="0,4,0,0">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExerciseDetailItem">
                                    <Grid ColumnDefinitions="*, Auto" Padding="0,8,0,8">
                                        <BoxView
                                            Grid.ColumnSpan="2"
                                            HeightRequest="1"
                                            VerticalOptions="End"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="15"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding SetRepText}"
                                            FontSize="14"
                                            TextColor="{StaticResource Primary}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button
                            Text="Start Recovery Session"
                            Command="{Binding StartWorkoutCommand}"
                            Margin="0,4,0,0" />

                    </VerticalStackLayout>
                </Border>

                <!-- ── Passive recovery / no workout day ──────────────── -->
                <Border
                    Style="{StaticResource CardPrimary}"
                    IsVisible="{Binding IsPassiveRecovery}">
                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="TODAY · REST DAY"
                            Style="{StaticResource EyebrowLabel}"
                            CharacterSpacing="1.2"
                            Opacity="0.6" />
                        <Label
                            Text="{Binding TodayTitle}"
                            Style="{StaticResource SectionTitle}"
                            FontSize="22" />
                        <Label
                            Text="{Binding TodayBodyCopy}"
                            Style="{StaticResource MutedLabel}"
                            FontSize="14"
                            LineBreakMode="WordWrap" />

                        <BoxView
                            HeightRequest="1"
                            Margin="0,4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    Text="NEXT ACTIVE DAY"
                                    Style="{StaticResource EyebrowLabel}"
                                    FontSize="9"
                                    CharacterSpacing="0.8"
                                    Opacity="0.6" />
                                <Label
                                    Text="{Binding NextActiveDayName}"
                                    FontSize="15"
                                    FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    Text="TIP"
                                    Style="{StaticResource EyebrowLabel}"
                                    FontSize="9"
                                    CharacterSpacing="0.8"
                                    Opacity="0.6" />
                                <Label
                                    Text="{Binding RestDayTip}"
                                    FontSize="12"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ══ WEEK PLAN ══════════════════════════════════════════ -->

                <Label
                    Text="THIS WEEK"
                    Style="{StaticResource EyebrowLabel}"
                    CharacterSpacing="1.2"
                    Margin="0,8,0,0" />

                <!-- Filter chips -->
                <CollectionView
                    ItemsSource="{Binding Filters}"
                    HeightRequest="44">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterChipItem">
                            <Border
                                StrokeShape="RoundRectangle 999"
                                StrokeThickness="0"
                                Padding="14,9">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectFilterCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="{Binding Label}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Workout list -->
                <CollectionView ItemsSource="{Binding Workouts}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkoutItem">
                            <Border Style="{StaticResource CardPrimary}" Margin="0,0,0,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="56"
                                        HeightRequest="56"
                                        StrokeShape="RoundRectangle 14"
                                        BackgroundColor="{Binding PhaseBackground}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                        <Image
                                            Source="tab_train.png"
                                            WidthRequest="26"
                                            HeightRequest="26"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Tag}"
                                            TextColor="{StaticResource Primary}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            CharacterSpacing="1.0" />
                                        <Label
                                            Text="{Binding Title}"
                                            Style="{StaticResource SectionTitle}"
                                            FontSize="18"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding Subtitle}"
                                            Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="2"
                                        Text="›"
                                        FontSize="24"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray500}}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══ SWAP SHEET (overlay) ══════════════════════════════════════ -->
        <Grid
            IsVisible="{Binding IsSwapSheetVisible}"
            BackgroundColor="#80000000"
            VerticalOptions="Fill">
            <Border
                VerticalOptions="End"
                StrokeShape="RoundRectangle 22,22,0,0"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PageBackgroundDark}}"
                Padding="20,24,20,40">
                <VerticalStackLayout Spacing="14">
                    <Label
                        Text="SWAP WORKOUT"
                        Style="{StaticResource EyebrowLabel}"
                        CharacterSpacing="1.2" />
                    <CollectionView ItemsSource="{Binding AlternativeWorkouts}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkoutItem">
                                <Border Style="{StaticResource CardPrimary}" Margin="0,0,0,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectAlternativeCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Tag}" TextColor="{StaticResource Primary}" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.0" />
                                            <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="16" />
                                            <Label Text="{Binding Subtitle}" Style="{StaticResource CaptionLabel}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray500}}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button
                        Text="Cancel"
                        Command="{Binding HideSwapCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
