<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Workout.WorkoutPage"
    x:Name="WorkoutRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Workout;assembly=MuscleCuties.Core"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:workoutControls="clr-namespace:MuscleCuties.App.Controls.Workout"
    xmlns:injuryControls="clr-namespace:MuscleCuties.App.Controls.Injury"
    xmlns:workoutModels="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core"
    x:DataType="vm:WorkoutViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <CollectionView ItemsSource="{Binding Workouts}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout
                    Padding="20,40,20,32"
                    Spacing="16"
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="640">

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" RowDefinitions="Auto, Auto" RowSpacing="2">
                        <Label
                            Grid.Row="0" Grid.Column="0"
                            Text="{Binding WeekTitle}"
                            Style="{StaticResource SubHeadline}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Row="1" Grid.Column="0"
                            Text="{Binding CurrentPhaseName, StringFormat='{0} plan'}"
                            Style="{StaticResource MutedLabel}"
                            VerticalOptions="Center" />

                        <Border
                            Grid.Column="1" Grid.RowSpan="2"
                            WidthRequest="48"
                            HeightRequest="48"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Open injury log"
                            SemanticProperties.Hint="{Binding InjuryBannerSummary}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenInjuryModalCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <mi:MauiIcon Icon="{mi:Fluent HeartPulse24}" IconSize="24"
                                             IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                             WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Margin="0,7,7,0"
                                         Color="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                                         HorizontalOptions="End" VerticalOptions="Start"
                                         IsVisible="{Binding HasActiveInjuries}"
                                         InputTransparent="True" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border StrokeShape="RoundRectangle 12" Padding="12,10" StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurfaceLight}, Dark={StaticResource WarningSurfaceDark}}"
                            IsVisible="{Binding HasActiveInjuries}"
                            SemanticProperties.Description="Injury adjustments active"
                            SemanticProperties.Hint="{Binding InjuryBannerSummary}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{Binding InjuryBannerSummary}" Style="{StaticResource BodyLabel}"
                                       FontSize="14" MaxLines="1" LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="Details" Style="{StaticResource ButtonLink}"
                                        Command="{Binding ToggleInjuryBannerCommand}"
                                        VerticalOptions="Center" HorizontalOptions="End" Padding="4,0"
                                        MinimumHeightRequest="36"
                                        SemanticProperties.Hint="Show or hide injury adjustments" />
                                <Button Grid.Column="2" Text="Log" Style="{StaticResource ButtonLink}"
                                        Command="{Binding NavigateToInjuryLogCommand}"
                                        VerticalOptions="Center" HorizontalOptions="End" Padding="4,0"
                                        MinimumHeightRequest="36"
                                        SemanticProperties.Hint="Open injury log" />
                            </Grid>

                            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsInjuryBannerExpanded}">
                                <!-- Blocked exercises -->
                                <VerticalStackLayout Spacing="2" IsVisible="{Binding HasBlockedExercises}">
                                    <Label Text="Blocked exercises" FontSize="14" FontAttributes="Bold"
                                           Style="{StaticResource MutedLabel}" />
                                    <VerticalStackLayout Spacing="1"
                                                         BindableLayout.ItemsSource="{Binding BlockedExerciseNames}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label Text="{Binding .}" FontSize="14"
                                                       Style="{StaticResource MutedLabel}" Margin="8,0,0,0" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Rehab recommendations -->
                                <VerticalStackLayout Spacing="2" IsVisible="{Binding HasRehabExercises}">
                                    <Label Text="Rehab recommendations" FontSize="14" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource SecondaryDarkText}}" />
                                    <VerticalStackLayout Spacing="1"
                                                         BindableLayout.ItemsSource="{Binding RehabExerciseNames}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label Text="{Binding .}" FontSize="14"
                                                       Style="{StaticResource AccentLabel}" Margin="8,0,0,0" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Blocked cardio -->
                                <VerticalStackLayout Spacing="2" IsVisible="{Binding HasBlockedCardio}">
                                    <Label Text="Blocked activities" FontSize="14" FontAttributes="Bold"
                                           Style="{StaticResource MutedLabel}" />
                                    <VerticalStackLayout Spacing="1"
                                                         BindableLayout.ItemsSource="{Binding BlockedCardioNames}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label Text="{Binding .}" FontSize="14"
                                                       Style="{StaticResource MutedLabel}" Margin="8,0,0,0" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <workoutControls:FeaturedWorkoutCard
                        BadgeText="{Binding FeaturedWorkoutBadgeText}"
                        WorkoutTitle="{Binding FeaturedWorkoutTitle}"
                        Subtitle="{Binding FeaturedWorkoutSubtitle}"
                        DurationText="{Binding FeaturedWorkoutDurationText}"
                        ExercisesCount="{Binding FeaturedWorkoutExercisesCount}"
                        Intensity="{Binding FeaturedWorkoutIntensity}"
                        ActionText="{Binding FeaturedWorkoutActionText}"
                        AccentColor="{Binding FeaturedWorkoutActivityBackground}"
                        AccentTextColor="{Binding FeaturedWorkoutActivityTextColor}"
                        ActivitySections="{Binding FeaturedWorkoutActivitySections}"
                        HasMultipleActivities="{Binding FeaturedWorkoutHasMultipleActivities}"
                        StartCommand="{Binding StartFeaturedWorkoutCommand}" />

                    <VerticalStackLayout Spacing="2" Margin="0,6,0,0">
                        <Label Text="Activity schedule" Style="{StaticResource SectionTitle}" />
                        <Label
                            Text="{Binding PlanSummaryText}"
                            Style="{StaticResource MutedLabel}"
                            FontSize="14" />
                    </VerticalStackLayout>

                    <FlexLayout
                        Direction="Row"
                        Wrap="NoWrap"
                        AlignItems="Stretch"
                        BindableLayout.ItemsSource="{Binding Filters}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="workoutModels:FilterChipItem">
                                <Border
                                    FlexLayout.Basis="25%"
                                    StrokeShape="RoundRectangle 999"
                                    StrokeThickness="0"
                                    Padding="6,9"
                                    Margin="2,0"
                                    MinimumHeightRequest="44"
                                    SemanticProperties.Description="{Binding Label}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="SemanticProperties.Hint" Value="Selected filter" />
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource ActionSurfaceDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}"
                                                     Value="False">
                                            <Setter Property="SemanticProperties.Hint" Value="Not selected" />
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectFilterCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="{Binding Label}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource TextPrimary}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}"
                                                         Value="False">
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Margin="0,24"
                        SemanticProperties.Description="Loading workouts" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Border
                    Style="{StaticResource CardPrimary}"
                    Padding="16"
                    Margin="20,0,20,32"
                    MaximumWidthRequest="640"
                    IsVisible="{Binding HasNoWorkouts}"
                    VerticalOptions="Start">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="{Binding EmptyWorkoutsTitle}"
                            Style="{StaticResource CardTitle}"
                            FontSize="17" />
                        <Label
                            Text="{Binding EmptyWorkoutsSubtitle}"
                            Style="{StaticResource MutedLabel}" />

                        <Button
                            Text="{Binding EmptyWorkoutsButtonText}"
                            Command="{Binding EmptyWorkoutsActionCommand}"
                            MinimumHeightRequest="48" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="workoutModels:WorkoutItem">
                    <workoutControls:WorkoutActivityCard
                        Margin="20,0,20,12"
                        MaximumWidthRequest="640"
                        OpenCommand="{Binding OpenWorkoutCommand, Source={RelativeSource AncestorType={x:Type vm:WorkoutViewModel}}, x:DataType=vm:WorkoutViewModel}"
                        CommandParameter="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <sharedControls:PageLoadingOverlay />
        <toolkit:LazyView
            x:Name="InjuryModalLazy"
            x:TypeArguments="injuryControls:InjuryLogModal"
            InputTransparent="{Binding IsInjuryModalVisible, Converter={StaticResource InvertedBoolConverter}}" />
    </Grid>

</ContentPage>
