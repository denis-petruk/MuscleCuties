<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MuscleCuties.App.Pages.Workout.WorkoutPage"
    x:Name="WorkoutRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Workout;assembly=MuscleCuties.Core"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:workoutControls="clr-namespace:MuscleCuties.App.Controls.Workout"
    xmlns:workoutModels="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core"
    x:DataType="vm:WorkoutViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,56,20,32" Spacing="14">

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label
                            Text="{Binding CurrentPhaseName, StringFormat='{0} plan'}"
                            Style="{StaticResource EyebrowLabel}"
                            CharacterSpacing="1.2" />
                        <Label
                            Text="{Binding WeekTitle}"
                            Style="{StaticResource SubHeadline}" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                        <sharedControls:ThemeAwareImage
                            LightSource="tab_train.png"
                            DarkSource="tab_train_dark.png"
                            WidthRequest="21"
                            HeightRequest="21"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <workoutControls:WorkoutPlanSummaryCard
                    PlanTitle="{Binding ActivePlanTitle}"
                    SummaryText="{Binding PlanSummaryText}" />

                <workoutControls:FeaturedWorkoutCard
                    BadgeText="{Binding FeaturedWorkoutBadgeText}"
                    WorkoutTitle="{Binding FeaturedWorkoutTitle}"
                    Subtitle="{Binding FeaturedWorkoutSubtitle}"
                    DurationText="{Binding FeaturedWorkoutDurationText}"
                    ExercisesCount="{Binding FeaturedWorkoutExercisesCount}"
                    Intensity="{Binding FeaturedWorkoutIntensity}"
                    StartCommand="{Binding StartFeaturedWorkoutCommand}" />

                <Grid
                    ColumnDefinitions="*, Auto"
                    ColumnSpacing="12"
                    Margin="0,6,0,0">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label
                            Text="ACTIVITY SCHEDULE"
                            Style="{StaticResource EyebrowLabel}"
                            CharacterSpacing="1.2" />
                        <Label
                            Text="{Binding PlanSummaryText}"
                            Style="{StaticResource MutedLabel}"
                            FontSize="13" />
                    </VerticalStackLayout>
                </Grid>

                <CollectionView
                    ItemsSource="{Binding Filters}"
                    HeightRequest="44">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="workoutModels:FilterChipItem">
                            <Border
                                StrokeShape="RoundRectangle 999"
                                StrokeThickness="0"
                                Padding="14,9">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference WorkoutRoot}, Path=BindingContext.SelectFilterCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="{Binding Label}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Margin="0,24" />

                <Grid MinimumHeightRequest="420">
                    <Border
                        Style="{StaticResource CardPrimary}"
                        Padding="16"
                        IsVisible="{Binding HasNoWorkouts}"
                        VerticalOptions="Start">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <Label
                                    Text="{Binding EmptyWorkoutsTitle}"
                                    Style="{StaticResource CardTitle}"
                                    FontSize="15" />
                                <Label
                                    Text="{Binding EmptyWorkoutsSubtitle}"
                                    Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="{Binding EmptyWorkoutsButtonText}"
                                Command="{Binding EmptyWorkoutsActionCommand}"
                                WidthRequest="118"
                                HeightRequest="48"
                                CornerRadius="16"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout
                        IsVisible="{Binding HasWorkouts}"
                        BindableLayout.ItemsSource="{Binding Workouts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="workoutModels:WorkoutItem">
                                <workoutControls:WorkoutActivityCard
                                    OpenCommand="{Binding Source={x:Reference WorkoutRoot}, Path=BindingContext.OpenWorkoutCommand}"
                                    CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <workoutControls:WorkoutSessionModal IsVisible="{Binding IsWorkoutModalVisible}" />
    </Grid>

</ContentPage>
