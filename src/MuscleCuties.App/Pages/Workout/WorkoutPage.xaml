<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MuscleCuties.App.Pages.Workout.WorkoutPage"
    x:Name="WorkoutRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels.Workout;assembly=MuscleCuties.Core"
    xmlns:sharedControls="clr-namespace:MuscleCuties.App.Controls.Shared"
    xmlns:workoutControls="clr-namespace:MuscleCuties.App.Controls.Workout"
    xmlns:injuryControls="clr-namespace:MuscleCuties.App.Controls.Injury"
    xmlns:workoutModels="clr-namespace:MuscleCuties.Core.Models.UI.Workout;assembly=MuscleCuties.Core"
    x:DataType="vm:WorkoutViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <CollectionView ItemsSource="{Binding Workouts}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout
                    Padding="20,40,20,32"
                    Spacing="16"
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="640">

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" RowDefinitions="Auto, Auto" RowSpacing="2">
                        <Label
                            Grid.Row="0" Grid.Column="0"
                            Text="{Binding WeekTitle}"
                            Style="{StaticResource SubHeadline}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Row="1" Grid.Column="0"
                            Text="{Binding CurrentPhaseName, StringFormat='{0} plan'}"
                            Style="{StaticResource MutedLabel}"
                            VerticalOptions="Center" />

                        <Border
                            Grid.Column="1" Grid.RowSpan="2"
                            WidthRequest="48"
                            HeightRequest="48"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Open injury log"
                            SemanticProperties.Hint="{Binding InjuryBannerSummary}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenInjuryModalCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <mi:MauiIcon Icon="{mi:Fluent HeartPulse24}" IconSize="24"
                                    IconColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Margin="0,7,7,0"
                                    Color="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                                    HorizontalOptions="End" VerticalOptions="Start" IsVisible="{Binding HasActiveInjuries}"
                                    InputTransparent="True" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Injury banner -->
                    <Border StrokeShape="RoundRectangle 12" Padding="14,12" StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurfaceLight}, Dark={StaticResource WarningSurfaceDark}}"
                            IsVisible="{Binding HasActiveInjuries}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding InjuryBannerSummary}" FontSize="13" LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Details" FontSize="12"
                                       TextColor="{StaticResource Primary}" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleInjuryBannerCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsInjuryBannerExpanded}">
                                <!-- Blocked exercises -->
                                <VerticalStackLayout Spacing="4" IsVisible="{Binding HasBlockedExercises}">
                                    <Label Text="Blocked exercises" FontSize="12" FontAttributes="Bold" Style="{StaticResource MutedLabel}" />
                                    <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding BlockedExerciseNames}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label Text="{Binding .}" FontSize="12" Style="{StaticResource MutedLabel}" Margin="8,0,0,0" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Rehab recommendations -->
                                <VerticalStackLayout Spacing="4" IsVisible="{Binding HasRehabExercises}">
                                    <Label Text="Rehab recommendations" FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />
                                    <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding RehabExerciseNames}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label Text="{Binding .}" FontSize="12" Style="{StaticResource AccentLabel}" Margin="8,0,0,0" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Blocked cardio -->
                                <VerticalStackLayout Spacing="4" IsVisible="{Binding HasBlockedCardio}">
                                    <Label Text="Blocked activities" FontSize="12" FontAttributes="Bold" Style="{StaticResource MutedLabel}" />
                                    <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding BlockedCardioNames}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label Text="{Binding .}" FontSize="12" Style="{StaticResource MutedLabel}" Margin="8,0,0,0" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Manage link -->
                                <Label Text="Manage injuries" FontSize="13" TextColor="{StaticResource Primary}" HorizontalOptions="End">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NavigateToInjuryLogCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <workoutControls:FeaturedWorkoutCard
                        BadgeText="{Binding FeaturedWorkoutBadgeText}"
                        WorkoutTitle="{Binding FeaturedWorkoutTitle}"
                        Subtitle="{Binding FeaturedWorkoutSubtitle}"
                        DurationText="{Binding FeaturedWorkoutDurationText}"
                        ExercisesCount="{Binding FeaturedWorkoutExercisesCount}"
                        Intensity="{Binding FeaturedWorkoutIntensity}"
                        ActionText="{Binding FeaturedWorkoutActionText}"
                        AccentColor="{Binding FeaturedWorkoutActivityBackground}"
                        AccentTextColor="{Binding FeaturedWorkoutActivityTextColor}"
                        ActivitySections="{Binding FeaturedWorkoutActivitySections}"
                        HasMultipleActivities="{Binding FeaturedWorkoutHasMultipleActivities}"
                        StartCommand="{Binding StartFeaturedWorkoutCommand}" />

                    <VerticalStackLayout Spacing="2" Margin="0,6,0,0">
                        <Label Text="Activity schedule" Style="{StaticResource SectionTitle}" />
                        <Label
                            Text="{Binding PlanSummaryText}"
                            Style="{StaticResource MutedLabel}"
                            FontSize="13" />
                    </VerticalStackLayout>

                    <FlexLayout
                        Direction="Row"
                        Wrap="NoWrap"
                        AlignItems="Stretch"
                        BindableLayout.ItemsSource="{Binding Filters}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="workoutModels:FilterChipItem">
                                <Grid FlexLayout.Basis="25%" Padding="4,0">
                                    <Border
                                        StrokeShape="RoundRectangle 999"
                                        StrokeThickness="0"
                                        Padding="8,9"
                                        MinimumHeightRequest="44">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="BackgroundColor"
                                                        Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardSurfaceDark}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference WorkoutRoot}, Path=BindingContext.SelectFilterCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label
                                            Text="{Binding Label}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="TextColor"
                                                            Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Margin="0,24"
                        SemanticProperties.Description="Loading workouts" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Border
                    Style="{StaticResource CardPrimary}"
                    Padding="16"
                    Margin="20,0,20,32"
                    MaximumWidthRequest="640"
                    IsVisible="{Binding HasNoWorkouts}"
                    VerticalOptions="Start">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="14" RowDefinitions="Auto, Auto" RowSpacing="4">
                        <Label
                            Grid.Row="0" Grid.Column="0"
                            Text="{Binding EmptyWorkoutsTitle}"
                            Style="{StaticResource CardTitle}"
                            FontSize="15"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Row="1" Grid.Column="0"
                            Text="{Binding EmptyWorkoutsSubtitle}"
                            Style="{StaticResource CaptionLabel}"
                            VerticalOptions="Center" />

                        <Button
                            Grid.Column="1" Grid.RowSpan="2"
                            Text="{Binding EmptyWorkoutsButtonText}"
                            Command="{Binding EmptyWorkoutsActionCommand}"
                            WidthRequest="118"
                            MinimumHeightRequest="48"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="workoutModels:WorkoutItem">
                    <workoutControls:WorkoutActivityCard
                        Margin="20,0,20,12"
                        MaximumWidthRequest="640"
                        OpenCommand="{Binding Source={x:Reference WorkoutRoot}, Path=BindingContext.OpenWorkoutCommand}"
                        CommandParameter="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <sharedControls:PageLoadingOverlay />
        <injuryControls:InjuryLogModal
            BindingContext="{Binding InjuryLogVm}"
            IsOpen="{Binding BindingContext.IsInjuryModalVisible, Source={x:Reference WorkoutRoot}}"
            CloseCommand="{Binding BindingContext.CloseInjuryModalCommand, Source={x:Reference WorkoutRoot}}" />
    </Grid>

</ContentPage>
