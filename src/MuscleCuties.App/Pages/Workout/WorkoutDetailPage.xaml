<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MuscleCuties.App.Pages.Workout.WorkoutDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MuscleCuties.Core.ViewModels;assembly=MuscleCuties.Core"
    x:DataType="vm:WorkoutDetailViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,56,20,32" Spacing="16">

            <!-- Back + Header -->
            <Grid ColumnDefinitions="Auto,*">
                <Button
                    Grid.Column="0"
                    Text="&#8592;"
                    FontSize="22"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    Clicked="OnBackClicked"
                    Padding="0"
                    WidthRequest="44" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label
                        Text="{Binding WorkoutTypeLabel}"
                        Style="{StaticResource EyebrowLabel}"
                        CharacterSpacing="1.2"
                        TextColor="{StaticResource Primary}" />
                    <Label
                        Text="{Binding WorkoutTitle}"
                        Style="{StaticResource SubHeadline}" />
                    <Label
                        Text="{Binding DurationText}"
                        Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Exercise list -->
            <CollectionView ItemsSource="{Binding Exercises}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExerciseItem">
                        <Border Style="{StaticResource CardPrimary}" Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding Name}"
                                        Style="{StaticResource SectionTitle}"
                                        FontSize="16" />
                                    <Border
                                        Grid.Column="1"
                                        BackgroundColor="{StaticResource Primary}"
                                        StrokeShape="RoundRectangle 999"
                                        StrokeThickness="0"
                                        Padding="8,4">
                                        <Label
                                            Text="{Binding MuscleLabel}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource White}" />
                                    </Border>
                                </Grid>
                                <Label
                                    Text="{Binding Description}"
                                    Style="{StaticResource CaptionLabel}"
                                    LineBreakMode="WordWrap" />
                                <Label
                                    Text="{Binding SetsRepsLabel}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Log completion button -->
            <Button
                Text="Done — Log Workout"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding LogCompletionCommand}"
                Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
