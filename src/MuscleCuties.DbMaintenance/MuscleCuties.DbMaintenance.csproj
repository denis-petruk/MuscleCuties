<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MuscleCuties.Infrastructure.PostgreSql/MuscleCuties.Infrastructure.PostgreSql.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shipped next to the binary so the trusted-root fallback resolves from any working directory. -->
    <None Include="../../certs/global-bundle.pem" Link="certs/global-bundle.pem"
          Condition="Exists('../../certs/global-bundle.pem')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
