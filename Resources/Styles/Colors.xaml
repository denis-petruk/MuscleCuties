<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ── Brand ──────────────────────────────────────────────── -->
    <Color x:Key="Primary">#C85A87</Color>
    <Color x:Key="PrimaryDark">#A6446D</Color>
    <Color x:Key="Secondary">#F8DFF1</Color>
    <Color x:Key="SecondaryDarkText">#F0B8CF</Color>
    <Color x:Key="Tertiary">#E8B4C8</Color>

    <!-- ── Page surfaces ──────────────────────────────────────── -->
    <Color x:Key="PageBackground">#FFF8FB</Color>
    <Color x:Key="PageBackgroundDark">#2B1D24</Color>

    <!-- ── Card surfaces ──────────────────────────────────────── -->
    <Color x:Key="CardSurface">#FFFFFF</Color>
    <Color x:Key="CardSurfaceDark">#3A2931</Color>

    <!-- ── Accent inner surface (chips, stat blocks) ──────────── -->
    <Color x:Key="AccentSurface">#FFF1F6</Color>
    <Color x:Key="AccentSurfaceDark">#3A2931</Color>

    <!-- ── Input surface (InputContainer background = Gray200) ── -->
    <Color x:Key="InputSurface">#F8EEF4</Color>

    <!-- ── Text ───────────────────────────────────────────────── -->
    <Color x:Key="TextPrimary">#2B1D24</Color>
    <Color x:Key="TextPrimaryDark">#F8EEF4</Color>
    <Color x:Key="TextSecondary">#8B6C79</Color>
    <Color x:Key="TextSecondaryDark">#AE8D9B</Color>
    <Color x:Key="TextAccent">#C85A87</Color>

    <!-- ── Base ───────────────────────────────────────────────── -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <!-- DeepMauve: deep warm mauve used for headlines and section titles -->
    <Color x:Key="DeepMauve">#5B4650</Color>

    <!-- ── Warm gray scale (rose-tinted) ──────────────────────── -->
    <Color x:Key="Gray100">#FFF8FB</Color>
    <Color x:Key="Gray200">#F8EEF4</Color>
    <Color x:Key="Gray300">#F0D8E2</Color>
    <Color x:Key="Gray400">#D7B8C5</Color>
    <Color x:Key="Gray500">#AE8D9B</Color>
    <Color x:Key="Gray600">#8B6C79</Color>
    <Color x:Key="Gray900">#4C3942</Color>
    <Color x:Key="Gray950">#2B1D24</Color>

    <!-- ── Error ──────────────────────────────────────────────── -->
    <Color x:Key="ErrorLight">#C0392B</Color>
    <Color x:Key="ErrorDark">#E57373</Color>

    <!-- ── Cycle phases -->
    <!-- Rest, renewal — warm rose  -->
    <Color x:Key="CyclePhaseMenstrualLight">#F9D6D8</Color>
    <Color x:Key="CyclePhaseMenstrualDark">#5A3840</Color>
    <!--  Energy, growth — sage green  -->
    <Color x:Key="CyclePhaseFollicularLight">#D6EED6</Color>
    <Color x:Key="CyclePhaseFollicularDark">#2E5230</Color>
    <!--  Peak, radiance — golden yellow  -->
    <Color x:Key="CyclePhaseOvulatoryLight">#FFF0C4</Color>
    <Color x:Key="CyclePhaseOvulatoryDark">#5A4A00</Color>
    <!--  Calm, reflection — soft violet  -->
    <Color x:Key="CyclePhaseLutealLight">#E8D8F5</Color>
    <Color x:Key="CyclePhaseLutealDark">#3E2A58</Color>
    <!--  Fallback — blush mauve  -->
    <Color x:Key="CyclePhaseDefaultLight">#F8DFF1</Color>
    <Color x:Key="CyclePhaseDefaultDark">#5A3C50</Color>

    <!-- Cycle phase text colors -->
    <Color x:Key="CyclePhaseMenstrualTextLight">#7A3A48</Color>
    <Color x:Key="CyclePhaseMenstrualTextDark">#F9D6D8</Color>
    <Color x:Key="CyclePhaseFollicularTextLight">#3A6B3A</Color>
    <Color x:Key="CyclePhaseFollicularTextDark">#D6EED6</Color>
    <Color x:Key="CyclePhaseOvulatoryTextLight">#7A6000</Color>
    <Color x:Key="CyclePhaseOvulatoryTextDark">#FFF0C4</Color>
    <Color x:Key="CyclePhaseLutealTextLight">#5A3B80</Color>
    <Color x:Key="CyclePhaseLutealTextDark">#E8D8F5</Color>

    <!-- ── Status (shared values for Readiness and Recovery) ───── -->
    <!-- Readiness/Recovery converters Colors -->
    <Color x:Key="ReadinessHighLight">#58A873</Color>
    <Color x:Key="ReadinessHighDark">#7FD197</Color>
    <Color x:Key="ReadinessMediumLight">#D9A441</Color>
    <Color x:Key="ReadinessMediumDark">#F0C15D</Color>
    <Color x:Key="ReadinessLowLight">#D16B6B</Color>
    <Color x:Key="ReadinessLowDark">#F08B8B</Color>

    <Color x:Key="RecoveryHighLight">#58A873</Color>
    <Color x:Key="RecoveryHighDark">#7FD197</Color>
    <Color x:Key="RecoveryMediumLight">#D9A441</Color>
    <Color x:Key="RecoveryMediumDark">#F0C15D</Color>
    <Color x:Key="RecoveryLowLight">#D16B6B</Color>
    <Color x:Key="RecoveryLowDark">#F08B8B</Color>

    <!-- ── Nutrition macros ────────────────────────────────────── -->
    <Color x:Key="WaterLight">#4F8FC8</Color>
    <Color x:Key="WaterDark">#7DB5E1</Color>
    <Color x:Key="ProteinLight">#A65AC8</Color>
    <Color x:Key="ProteinDark">#C792E6</Color>
    <Color x:Key="CarbsLight">#E3A13B</Color>
    <Color x:Key="CarbsDark">#F1C46E</Color>
    <Color x:Key="FatsLight">#6F8E4E</Color>
    <Color x:Key="FatsDark">#9DB878</Color>

    <!-- ── Brushes ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="PrimaryBrush"    Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush"  Color="{StaticResource Secondary}"/>

    <!-- Phase background brushes -->
    <SolidColorBrush x:Key="CyclePhaseMenstrualLightBrush"  Color="{StaticResource CyclePhaseMenstrualLight}"/>
    <SolidColorBrush x:Key="CyclePhaseMenstrualDarkBrush"   Color="{StaticResource CyclePhaseMenstrualDark}"/>
    <SolidColorBrush x:Key="CyclePhaseFollicularLightBrush" Color="{StaticResource CyclePhaseFollicularLight}"/>
    <SolidColorBrush x:Key="CyclePhaseFollicularDarkBrush"  Color="{StaticResource CyclePhaseFollicularDark}"/>
    <SolidColorBrush x:Key="CyclePhaseOvulatoryLightBrush"  Color="{StaticResource CyclePhaseOvulatoryLight}"/>
    <SolidColorBrush x:Key="CyclePhaseOvulatoryDarkBrush"   Color="{StaticResource CyclePhaseOvulatoryDark}"/>
    <SolidColorBrush x:Key="CyclePhaseLutealLightBrush"     Color="{StaticResource CyclePhaseLutealLight}"/>
    <SolidColorBrush x:Key="CyclePhaseLutealDarkBrush"      Color="{StaticResource CyclePhaseLutealDark}"/>
    <SolidColorBrush x:Key="CyclePhaseDefaultLightBrush"    Color="{StaticResource CyclePhaseDefaultLight}"/>
    <SolidColorBrush x:Key="CyclePhaseDefaultDarkBrush"     Color="{StaticResource CyclePhaseDefaultDark}"/>

    <!-- Phase text color brushes -->
    <SolidColorBrush x:Key="CyclePhaseMenstrualTextLightBrush"  Color="{StaticResource CyclePhaseMenstrualTextLight}"/>
    <SolidColorBrush x:Key="CyclePhaseMenstrualTextDarkBrush"   Color="{StaticResource CyclePhaseMenstrualTextDark}"/>
    <SolidColorBrush x:Key="CyclePhaseFollicularTextLightBrush" Color="{StaticResource CyclePhaseFollicularTextLight}"/>
    <SolidColorBrush x:Key="CyclePhaseFollicularTextDarkBrush"  Color="{StaticResource CyclePhaseFollicularTextDark}"/>
    <SolidColorBrush x:Key="CyclePhaseOvulatoryTextLightBrush"  Color="{StaticResource CyclePhaseOvulatoryTextLight}"/>
    <SolidColorBrush x:Key="CyclePhaseOvulatoryTextDarkBrush"   Color="{StaticResource CyclePhaseOvulatoryTextDark}"/>
    <SolidColorBrush x:Key="CyclePhaseLutealTextLightBrush"     Color="{StaticResource CyclePhaseLutealTextLight}"/>
    <SolidColorBrush x:Key="CyclePhaseLutealTextDarkBrush"      Color="{StaticResource CyclePhaseLutealTextDark}"/>

    <SolidColorBrush x:Key="ReadinessHighLightBrush"   Color="{StaticResource ReadinessHighLight}"/>
    <SolidColorBrush x:Key="ReadinessHighDarkBrush"    Color="{StaticResource ReadinessHighDark}"/>
    <SolidColorBrush x:Key="ReadinessMediumLightBrush" Color="{StaticResource ReadinessMediumLight}"/>
    <SolidColorBrush x:Key="ReadinessMediumDarkBrush"  Color="{StaticResource ReadinessMediumDark}"/>
    <SolidColorBrush x:Key="ReadinessLowLightBrush"    Color="{StaticResource ReadinessLowLight}"/>
    <SolidColorBrush x:Key="ReadinessLowDarkBrush"     Color="{StaticResource ReadinessLowDark}"/>

    <SolidColorBrush x:Key="RecoveryHighLightBrush"   Color="{StaticResource RecoveryHighLight}"/>
    <SolidColorBrush x:Key="RecoveryHighDarkBrush"    Color="{StaticResource RecoveryHighDark}"/>
    <SolidColorBrush x:Key="RecoveryMediumLightBrush" Color="{StaticResource RecoveryMediumLight}"/>
    <SolidColorBrush x:Key="RecoveryMediumDarkBrush"  Color="{StaticResource RecoveryMediumDark}"/>
    <SolidColorBrush x:Key="RecoveryLowLightBrush"    Color="{StaticResource RecoveryLowLight}"/>
    <SolidColorBrush x:Key="RecoveryLowDarkBrush"     Color="{StaticResource RecoveryLowDark}"/>

    <SolidColorBrush x:Key="WaterLightBrush"   Color="{StaticResource WaterLight}"/>
    <SolidColorBrush x:Key="WaterDarkBrush"    Color="{StaticResource WaterDark}"/>
    <SolidColorBrush x:Key="ProteinLightBrush" Color="{StaticResource ProteinLight}"/>
    <SolidColorBrush x:Key="ProteinDarkBrush"  Color="{StaticResource ProteinDark}"/>
    <SolidColorBrush x:Key="CarbsLightBrush"   Color="{StaticResource CarbsLight}"/>
    <SolidColorBrush x:Key="CarbsDarkBrush"    Color="{StaticResource CarbsDark}"/>
    <SolidColorBrush x:Key="FatsLightBrush"    Color="{StaticResource FatsLight}"/>
    <SolidColorBrush x:Key="FatsDarkBrush"     Color="{StaticResource FatsDark}"/>

</ResourceDictionary>
