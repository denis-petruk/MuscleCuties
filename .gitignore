# ---------------------------------------------------------------------------
# MuscleCuties — repository ignore rules
# ---------------------------------------------------------------------------

# Build output
bin/
obj/
/packages/
*.binlog

# Generated analysis output (local only; regenerate with the graph tool)
graphify-out/

# Local database-reset marker (development helper source stays versioned)
.temp-db-reset

# Local secrets, signing material and machine-specific settings
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
# Keep signing/private certificates local, but version the public RDS trust bundle.
/certs/*
!/certs/global-bundle.pem
/lambda-environment.json
/services/postgresql/docker-compose.yml
**/docker-compose.override.yml
appsettings.local.json
appsettings.*.local.json
*.p8
*.p12
*.pfx
*.key
*.mobileprovision
*.user

# Test results and coverage
[Tt]est[Rr]esults/
*.trx
*.log
*.coverage
*.coveragexml
coverage/
*.cobertura.xml
.dotCover/
_ReSharper*/
/artifacts/

# Shared development instructions, skills, reports, templates and run configurations
# are versioned by default, including AGENTS.md, DESIGN.md, PRODUCT.md,
# .agents/, .codex/, .impeccable/critique/ and .run/.
# Ignore only private imported context and per-machine agent state.
/.cloud-attachments/
**/.codex/hooks.json
**/.codex/auth.json
**/.codex/*.local.*
**/.codex/sessions/
**/.codex/cache/
**/.codex/logs/
**/*settings.local.json
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json

# Rider / Visual Studio
.idea/
.vs/
riderModule.iml
/_ReSharper.Caches/
*.sln.iml
*.suo

# Xcode and iOS build products
DerivedData/
xcuserdata/
*.xcarchive
*.ipa

# Cloudflare local state
.wrangler/

# Python helper bytecode
__pycache__/
*.pyc

# macOS
.DS_Store
._*
Thumbs.db

# Local, immutable implementation snapshots
.foundation-baselines/

# Local scratch
.scratch/

# Patch residue
*.orig
*.rej
*~

# CI/local tooling and artifacts
.tools/
test-results/
*.dSYM
