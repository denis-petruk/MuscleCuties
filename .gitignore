# ---------------------------------------------------------------------------
# MuscleCuties — repository ignore rules
# ---------------------------------------------------------------------------

# Build output
bin/
obj/
/packages/
*.binlog

# Generated analysis output (local only; regenerate with the graph tool)
graphify-out/

# Throwaway database-reset helper (see its README; delete it when finished)
temp-db-reset/
.temp-db-reset

# Local secrets, signing material and machine-specific settings
.env
.env.*
!.env.example
/certs/
/lambda-environment.json
/services/postgresql/docker-compose.yml
**/docker-compose.override.yml
appsettings.local.json
appsettings.*.local.json
*.p8
*.p12
*.pfx
*.mobileprovision
*.user

# Test results and coverage
[Tt]est[Rr]esults/
*.trx
*.log
*.coverage
*.coveragexml
coverage/
*.cobertura.xml
.dotCover/
_ReSharper*/
/artifacts/

# Local agent context and profiles stay outside Git
.agents/
.codex/
**/.codex/
.claude
.impeccable/
PRODUCT.md
DESIGN.md
CLAUDE.md

# Rider / Visual Studio
.idea/
.vs/
.run/
riderModule.iml
/_ReSharper.Caches/
*.sln.iml
*.suo

# Xcode and iOS build products
DerivedData/
xcuserdata/
*.xcarchive
*.ipa

# Cloudflare local state
.wrangler/

# Python helper bytecode
__pycache__/
*.pyc

# macOS
.DS_Store
._*
Thumbs.db

# Local, immutable implementation snapshots
.foundation-baselines/

# Patch residue
*.orig
*.rej
*~
