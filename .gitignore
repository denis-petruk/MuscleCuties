# ---------------------------------------------------------------------------
# MuscleCuties — public repository ignore rules
# ---------------------------------------------------------------------------

# Build output
bin/
obj/
/packages/
*.binlog

# Local database-reset marker
.temp-db-reset

# Local secrets, signing material, certificates, and machine-specific settings
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
/certs/*
!/certs/global-bundle.pem
/lambda-environment.json
/services/postgresql/docker-compose.yml
**/docker-compose.override.yml
appsettings.local.json
appsettings.*.local.json
**/secrets.json
*.p8
*.p12
*.pfx
*.key
*.pem
!/certs/global-bundle.pem
*.jks
*.keystore
*.mobileprovision
*.user
*.DotSettings.user

# Private / internal working docs (stored outside the public repository)
/STATUS.md
/ROADMAP.md
/PRODUCT.md
/DESIGN.md
/CONTEXT.md

# Test results, coverage, and local release artifacts
[Tt]est[Rr]esults/
*.trx
*.log
*.coverage
*.coveragexml
coverage/
*.cobertura.xml
.dotCover/
_ReSharper*/
/artifacts/
test-results/
*.dSYM

# Rider / Visual Studio
.idea/
.vs/
riderModule.iml
/_ReSharper.Caches/
*.sln.iml
*.suo

# Xcode and iOS build products
DerivedData/
xcuserdata/
*.xcarchive
*.ipa

# Cloudflare local state
.wrangler/

# Python helper bytecode
__pycache__/
*.pyc

# macOS
.DS_Store
._*
Thumbs.db

# Local scratch and patch residue
.foundation-baselines/
.scratch/
.tools/
.tool/
*.orig
*.rej
*~
