# ---------------------------------------------------------------------------
# MuscleCuties — repository ignore rules
# ---------------------------------------------------------------------------

# Build output
bin/
obj/
/packages/
*.binlog

# Local database-reset marker (development helper source stays versioned)
.temp-db-reset

# Local secrets, signing material and machine-specific settings
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
# Keep signing/private certificates local, but version the public RDS trust bundle.
/certs/*
!/certs/global-bundle.pem
/lambda-environment.json
/services/postgresql/docker-compose.yml
**/docker-compose.override.yml
appsettings.local.json
appsettings.*.local.json
*.p8
*.p12
*.pfx
*.key
*.mobileprovision
*.user

# Test results and coverage
[Tt]est[Rr]esults/
*.trx
*.log
*.coverage
*.coveragexml
coverage/
*.cobertura.xml
.dotCover/
_ReSharper*/
/artifacts/
test-results/
*.dSYM

# Rider / Visual Studio
.idea/
.vs/
riderModule.iml
/_ReSharper.Caches/
*.sln.iml
*.suo

# Xcode and iOS build products
DerivedData/
xcuserdata/
*.xcarchive
*.ipa

# Cloudflare local state
.wrangler/

# Python helper bytecode
__pycache__/
*.pyc

# macOS
.DS_Store
._*
Thumbs.db

# Local scratch and patch residue
.foundation-baselines/
.scratch/
.tools/
*.orig
*.rej
*~
