<Project>
    <Target Name="RemoveTraceFromReleaseConstants" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release'">
        <PropertyGroup>
            <DefineConstants>$([System.String]::Copy('$(DefineConstants)').Replace('TRACE;', '').Replace(';TRACE', '').Replace('TRACE', ''))</DefineConstants>
        </PropertyGroup>
    </Target>

    <Target Name="CopyTestDependencies" AfterTargets="Build" Condition="'$(IsTestProject)' == 'true'">
        <Copy SourceFiles="$(NuGetPackageRoot)microsoft.codecoverage/17.14.1/lib/net8.0/Microsoft.VisualStudio.CodeCoverage.Shim.dll"
              DestinationFolder="$(TargetDir)"
              SkipUnchangedFiles="true"
              Condition="Exists('$(NuGetPackageRoot)microsoft.codecoverage/17.14.1/lib/net8.0/Microsoft.VisualStudio.CodeCoverage.Shim.dll')" />
        <Copy SourceFiles="$(NuGetPackageRoot)amazon.lambda.apigatewayevents/3.0.1/lib/net10.0/Amazon.Lambda.APIGatewayEvents.dll"
              DestinationFolder="$(TargetDir)"
              SkipUnchangedFiles="true"
              Condition="Exists('$(NuGetPackageRoot)amazon.lambda.apigatewayevents/3.0.1/lib/net10.0/Amazon.Lambda.APIGatewayEvents.dll')" />
    </Target>
</Project>
